%% UML Aktivite (Activity) Diyagrami — Hurda altin alimi
%% Kaynak: SatisServisi.HurdaAlis + GiderPusulasiKapisi + MasakKapisi.
%% Hurda alimi, MASAK ve VUK yukumluluklerinin AYNI ANDA calistigi tek akistir.
flowchart TD
    A([Basla: hurda altin alimi]) --> B[/Gram, ayar, has gram fiyati gir/]
    B --> C[Has gram hesapla<br/>gram - tas x milyem / 1000]
    C --> D[Brut tutar = has gram x fiyat]

    D --> E{Satici kimligi<br/>girildi mi?}
    E -->|Hayir| E1[/HTTP 400<br/>Kimlik zorunlu/]
    E1 --> Z([Islem TAMAMLANMAZ])

    E -->|Evet| F{TCKN checksum<br/>gecerli mi?}
    F -->|Hayir| F1[/HTTP 400<br/>Gecersiz TCKN/]
    F1 --> Z

    F -->|Evet| G{Tutar >= 185.000 TL?}
    G -->|Evet| G1{MASAK kimlik<br/>bilgileri tam mi?}
    G1 -->|Hayir| G2[/HTTP 400<br/>MASAK kimlik tespiti eksik/]
    G2 --> Z
    G1 -->|Evet| H
    G -->|Hayir| H[Satici tipini belirle]

    H --> I{Satici tipi}
    I -->|Nihai tuketici| I1[Stopaj orani %0]
    I -->|Esnaf muaf| I2[Stopaj orani %2]
    I -->|Vergi mukellefi| I3[Gider pusulasi GEREKMEZ<br/>satici fatura keser]

    I1 --> J
    I2 --> J[Stopaj tutari = brut x oran]
    J --> K[NET ODENEN = brut - stopaj]

    K --> L[/TRANSACTION BASLAR/]
    L --> M[Hareket yaz: HURDA_ALIS]
    M --> N["Kasadan NET tutar cikar<br/>(brut degil - bu bir kez kirildi)"]
    N --> O[Stok artir]
    O --> P[Gider pusulasi olustur<br/>VUK md.234]
    P --> Q[TCKN sifrele AES-256-GCM<br/>+ HMAC hash sutunu]
    Q --> R[Duzenleme son tarihi = teslim + 7 gun]

    R --> S{Tutar >= 185.000 TL?}
    S -->|Evet| S1[MASAK kimlik tespiti kaydet<br/>saklama bitis = +8 yil]
    S1 --> T
    S -->|Hayir| T[/COMMIT/]

    I3 --> T

    T --> U[Denetim izi otomatik duser]
    U --> V([Islem tamam])

    classDef hata fill:#fde2e2,stroke:#c0392b,color:#000
    classDef kapi fill:#fdf0d5,stroke:#c9a227,color:#000
    classDef islem fill:#e8f0fa,stroke:#4a7ab5,color:#000
    class E1,F1,G2,Z hata
    class E,F,G,G1,S,I kapi
    class M,N,O,P,Q,R,S1,U islem
