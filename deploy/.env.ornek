# ═══════════════════════════════════════════════════════════════════════════
# KUYUMCU ERP — ÜRETİM ORTAM DEĞİŞKENLERİ ÖRNEĞİ (Paket T-1 + F-6)
#
# BU DOSYA ÖRNEKTİR; İÇİNDE GERÇEK SIR YOKTUR ve olmamalıdır.
# Gerçek dosyayı ELLE YAZMAYIN — `dotnet/kurulum.sh` (Linux) ya da
# `dotnet/kurulum.ps1` (Windows) üretir:
#     sudo ./dotnet/kurulum.sh --hedef /etc/kuyumcu/.env
# Betik kriptografik rastgele sır üretir, dosyayı chmod 600 + kuyumcu:kuyumcu
# yapar ve EKRANA SIR BASMAZ (yalnız "üretildi/var" der).
#
# Aşağıdaki DEGISTIR değerleriyle uygulama BİLEREK AÇILMAZ (fail-closed):
# Common/UretimAcilisDenetimi.cs.
# ═══════════════════════════════════════════════════════════════════════════

# ── Ortam: üretim biriminde Development YASAKTIR (FAIL-CLOSED 6) ────────────
ASPNETCORE_ENVIRONMENT=Production

# ── Veritabanı adı TEK KAYNAK ──────────────────────────────────────────────
# Compose, bağlantı dizgesi ve yedek betiği AYNI adı kullanır. Bağlantı
# dizgesindeki database= ile burası ayrışırsa uygulama açılmaz.
KUYUMCU_VT=kuyumcu_net

# ── Sırlar (hepsi kuruluma özgü üretilir) ──────────────────────────────────
# MySQL root/uygulama parolası. docker-compose.uretim.yml de bunu okur.
MYSQL_ROOT_PASSWORD=DEGISTIR-kurulum-betigi-uretecek

# ASP.NET bağlantı dizgesi (çift alt çizgi = ConnectionStrings:Kuyumcu)
ConnectionStrings__Kuyumcu=server=mysql;port=3306;database=kuyumcu_net;user=root;password=DEGISTIR-kurulum-betigi-uretecek

# JWT imzalama sırrı — en az 32 bayt, kuruluma özgü.
Jwt__Secret=DEGISTIR-en-az-32-karakter-uretim-secreti

# Alan şifreleme anahtarı (AES-GCM, 32 bayt base64) — MASAK/KVKK kimlik verisi.
# Bu anahtar KAYBOLURSA şifreli kimlik alanları geri okunamaz.
KUYUMCU_SIFRELEME_ANAHTARI=DEGISTIR-32-bayt-base64

# Yedek arşivi şifreleme anahtarı — alan şifreleme anahtarından AYRI olmalıdır
# (MÜHÜR 3, sır disiplini). Aynısı verilirse uygulama açılmaz.
Yedek__SifrelemeAnahtari=DEGISTIR-yedek-anahtari-ayri-olmali

# ── TLS beyanı (FAIL-CLOSED 4) ─────────────────────────────────────────────
# Ters vekil (nginx/IIS) TLS'i sonlandırıyorsa true bırakın.
# Kestrel doğrudan https dinleyecekse false yapıp ASPNETCORE_URLS'e https verin.
Uretim__TersVekilArkasinda=true
ASPNETCORE_URLS=http://127.0.0.1:5000
