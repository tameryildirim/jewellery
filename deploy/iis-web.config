<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kuyumcu ERP — IIS ters vekil yapılandırması (Windows VDS)
  Paket T-1 (+F-6), MÜHÜR 6.

  ROL (K7 — statik sunum tek yol): IIS YALNIZ ters vekil + TLS sonlandırıcıdır.
  Blazor WASM kabuğu da API sürecinden sunulur; bu dosya artık statik dosya
  sunmaz ve SPA geri dönüşü yapmaz (o iş Kestrel'de MapFallbackToFile'da).
  ⚠ ESKİ sürüm localhost:4000'e (kaldırılmış Node yığını) vekil ediyordu.

  GÜVENLİK BAŞLIKLARI (K5, K6 — tek kaynak Program.cs): X-Frame-Options,
  X-Content-Type-Options, CSP ve HSTS BU DOSYADA YOKTUR; Kestrel'den tek kopya
  gelir. customHeaders bloğu KASITLI olarak boştur — doldurmayın, çift kopya
  başlık üretir. (Eski sürüm SAMEORIGIN gönderiyordu; API DENY gönderir.)

  Kurulum yeri: IIS site kök dizini (bu dosya oraya web.config adıyla kopyalanır).
  Gereksinimler (sunucuda bir kez):
    1. IIS rolü + "URL Rewrite" modülü + "Application Request Routing" (ARR)
    2. ARR: Server Proxy Settings -> "Enable proxy" isaretli
    3. Site bağlamasında yalnız https:443 (80 için HttpRedirect kuralı aşağıda)
  Uygulamanın http://127.0.0.1:5000 üzerinde Windows servisi olarak çalıştığı
  varsayılır (deploy/kuyumcu-service-kur.ps1).
-->
<configuration>
  <system.webServer>

    <!-- FAIL-CLOSED: TLS'siz istek uygulamaya ulaşmaz, 301 ile https'e gider. -->
    <httpRedirect enabled="false" />

    <rewrite>
      <rules>
        <rule name="HttpsZorunlu" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Her istek uygulamaya: API, WASM kabuğu ve statikler tek hattan. -->
        <rule name="KuyumcuVekil" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- 8 MB: belge yükleme ucu (Kestrel RequestSizeLimit 8_000_000 ile aynı hizada) -->
        <requestLimits maxAllowedContentLength="8388608" />
      </requestFiltering>
    </security>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpProtocol>
      <customHeaders>
        <!-- KASITLI OLARAK BOŞ — K5/K6. Başlıklar Program.cs'ten gelir. -->
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
