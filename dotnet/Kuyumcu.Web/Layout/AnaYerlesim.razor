@inherits LayoutComponentBase
@inject OturumServisi Oturum
@inject NavigationManager Nav
@inject ApiIstemci Api
@inject DilServisi Dil
@inject ArayuzModuServisi Modu
@inject IJSRuntime JS
@inject IServiceProvider Hizmetler
@using Kuyumcu.Web.Bilesenler.Kabuk
@implements IDisposable

@if (GirisOncesiSayfada)
{
    @* PAKET S-3a — giriş sayfası da hata sınırıyla sarılır: deserialize
       hatası boş ekran değil, görünür bant üretir (kurul tur 3 engel 11). *@
    <KabukHatasi>@Body</KabukHatasi>
}
else if (!Oturum.GirisYapildi)
{
    @* Token yok → girişe yönlendirilir (OnInitialized) *@
}
else if (VitrinEkraninda)
{
    @* PAKET EKSIK-KUCUK (B2-10) — VİTRİN DÜKKÂN EKRANI TAM EKRANDIR (her şemada):
       kenar çubuğu/üst bar/üst menü çizilmez. /ekranlar'dan farkı: veri gösterir,
       bu yüzden YETKİ KAPISI da aynen sarar (kur modülü yoksa tek durum). *@
    <div class="uygulama-tam-ekran vitrin-tam-ekran" id="vitrin-tam-ekran-kabuk">
        <KabukHatasi><YetkiKapisi ProfilDenendi="@profilDenendi">@Body</YetkiKapisi></KabukHatasi>
    </div>
}
else
{
    @* ── PAKET YILDIZ-2 — "YILDIZ" KABUĞU (tek kabuk; tema temizliği 17.10) ────
       Sol menü YOK: üst 5 kelime menü (YildizUstMenu) + sağda kur/saat/kullanıcı.
       "Tüm ekranlar" tam ekran DEĞİLDİR; üst menünün altında çizilir.
       Eski kenar çubuklu kabuk (KenarCubugu) kaldırıldı. *@
    <CascadingValue Value="sekmeYuvasi" IsFixed="true">
    <div class="@($"uygulama yildiz-kabuk{(TamEkranRotasi(new Uri(Nav.Uri).AbsolutePath) ? " yildiz-tum-ekranlar" : "")}")" id="yildiz-kabuk">
        <div class="icerik-sutunu">
            <YildizUstMenu />
            <UstBar />
            <PwaBandi />   @* PAKET-44 Faz B: çevrimdışı / yeni sürüm bandı (giriş sayfasında bu dal çizilmez) *@
            <main class="ana-icerik">
                @if (Oturum.Kullanici?.SaltOkunur == true)
                {
                    @* D1-14: mali müşavir hesabı — her ekranda kayıt değiştirilemeyeceği söylenir (sunucu da reddeder). *@
                    <div class="bant bant-bilgi" id="salt-okunur-bant" role="status">@D1Sozlugu.Al(Dil.Dil).SaltOkunurBant</div>
                }
                <KabukHatasi><YetkiKapisi ProfilDenendi="@profilDenendi">@Body</YetkiKapisi></KabukHatasi>
            </main>
        </div>
    </div>
    </CascadingValue>
}

@code {
    private static KabukServisi Kabuk => KabukServisi.Ortak;

    private bool GirisSayfasinda =>
        new Uri(Nav.Uri).AbsolutePath.TrimEnd('/') is "/giris";

    /// <summary>
    /// PAKET AUTH-SIFIRLA: oturum İSTEMEYEN, kabuksuz çizilen giriş öncesi sayfalar.
    /// /sifre-sifirla oturumsuz açılır (girişe atılmaz) ve oturum açıkken de "/"a
    /// atılmaz (e-postadaki bağlantı her durumda çalışır).
    /// </summary>
    public static bool GirisOncesiRota(string mutlakYol) =>
        mutlakYol.TrimEnd('/') is "/giris" or "/sifre-sifirla"
        || mutlakYol.StartsWith("/fiyat/", StringComparison.Ordinal);   // Y-14: oturumsuz canlı fiyat ekranı

    private bool GirisOncesiSayfada => GirisOncesiRota(new Uri(Nav.Uri).AbsolutePath);

    /// <summary>
    /// S1-d: "Tüm ekranlar" rotası. Tema temizliği (17.10) sonrası tam ekran DEĞİLDİR
    /// (Yıldız kabuğu üst menünün altında çizer); kabuk kökü bu rotada
    /// <c>yildiz-tum-ekranlar</c> sınıfını taşır.
    /// </summary>
    public static bool TamEkranRotasi(string mutlakYol) =>
        mutlakYol.TrimEnd('/') is "/ekranlar";

    /// <summary>PAKET EKSIK-KUCUK (B2-10): kabuksuz çizilen vitrin dükkân ekranı.</summary>
    public static bool VitrinEkranRotasi(string mutlakYol) =>
        mutlakYol.TrimEnd('/') is "/vitrin/ekran";

    private bool VitrinEkraninda => VitrinEkranRotasi(new Uri(Nav.Uri).AbsolutePath);

    private GorunumServisi? kiraciGorunumu;
    private KullaniciGorunumServisi? benimGorunumu;

    protected override async Task OnInitializedAsync()
    {
        Oturum.Degisti += DurumaGoreYenile;
        Kabuk.Degisti += DurumaGoreYenile;
        Modu.Degisti += DurumaGoreYenile;
        // YILDIZ-2: şema değişince (Ayarlar › Görünüm) kabuk anında geçer.
        kiraciGorunumu = Hizmetler.GetService(typeof(GorunumServisi)) as GorunumServisi;
        benimGorunumu = Hizmetler.GetService(typeof(KullaniciGorunumServisi)) as KullaniciGorunumServisi;
        if (kiraciGorunumu is not null) kiraciGorunumu.Degisti += DurumaGoreYenile;
        if (benimGorunumu is not null) benimGorunumu.Degisti += DurumaGoreYenile;
        Nav.LocationChanged += (_, _) => KontrolEt();
        KontrolEt();

        // Profil persist edilmez — token varsa /auth/ben ile geri yükle
        if (Oturum.GirisYapildi && Oturum.Kullanici is null)
        {
            try
            {
                var ben = await Api.GetAsync("/auth/ben");
                Oturum.KullaniciAta(new OturumKullanici(
                    ben.GetProperty("id").GetString()!,
                    ben.GetProperty("ad").GetString()!,
                    ben.GetProperty("soyad").GetString()!,
                    ben.GetProperty("email").GetString()!,
                    ben.GetProperty("rol").GetString()!,
                    ben.TryGetProperty("subeId", out var s) ? s.GetString() : null,
                    // UX-3: etkin modu SUNUCU çözer. Alan yoksa (eski sunucu) tolere edilir
                    // ve bugünkü ekran (PROFESYONEL) korunur — çökme yok.
                    ben.TryGetProperty("arayuzModu", out var am) && am.ValueKind == JsonValueKind.String
                        ? am.GetString() : null,
                    ben.TryGetProperty("etkinArayuzModu", out var em) && em.ValueKind == JsonValueKind.String
                        ? em.GetString()! : "PROFESYONEL",
                    ben.TryGetProperty("saltOkunur", out var so) && so.ValueKind == JsonValueKind.True));
            }
            catch { /* 401 ise ApiIstemci zaten girişe yönlendirir */ }
        }
        // KESIF-P1 (#72): profil okuması DENENDİ — rol kapısı artık bekletmez.
        profilDenendi = true;
    }

    /// <summary>KESIF-P1: /auth/ben denendi mi (başarılı ya da değil)?</summary>
    private bool profilDenendi;

    private void KontrolEt()
    {
        if (!Oturum.GirisYapildi && !GirisOncesiSayfada)
            Nav.NavigateTo("/giris");
        else if (Oturum.GirisYapildi && GirisSayfasinda)
            Nav.NavigateTo("/");
    }

    /// <summary>T-K2: sayfaların üst bara sekme koyduğu yuva (UstBar + sayfa, cascade).</summary>
    private readonly UstBarSekmeYuvasi sekmeYuvasi = new();

    // ── html[data-mod] yazıcısı (UX-2 A2) ───────────────────────────────────
    // Mod SUNUCUDAN gelir (etkinArayuzModu); JS yalnız BEYAZ LİSTELİ değeri
    // yazar (js/tema.js → window.kuyumcuMod). Öznitelik yalnız ÖLÇÜ belirteci
    // değiştirir; yetkiye HİÇ dokunmaz.
    private string? yazilanMod;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var mod = Modu.BasitMi ? "basit" : "profesyonel";
        if (mod == yazilanMod) return;
        yazilanMod = mod;
        try { await JS.InvokeVoidAsync("kuyumcuMod.uygula", mod); }
        catch { /* betik yüklenmediyse ölçüler varsayılanda kalır */ }
    }

    private void DurumaGoreYenile() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Oturum.Degisti -= DurumaGoreYenile;
        Kabuk.Degisti -= DurumaGoreYenile;
        Modu.Degisti -= DurumaGoreYenile;
        if (kiraciGorunumu is not null) kiraciGorunumu.Degisti -= DurumaGoreYenile;
        if (benimGorunumu is not null) benimGorunumu.Degisti -= DurumaGoreYenile;
    }
}
