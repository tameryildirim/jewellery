@inject DilServisi Dil

@* ═════════════════════════════════════════════════════════════════════════════
   PAKET YILDIZ-5A — "YILDIZ" SAYIM (tuval Y_Sayim · BİREBİR · "özet" kalıbı).

   Solda üst satır + 40 px başlık + 104 px ince rakam ("11 / 13 ürün", ek soluk 52 px) +
   20 px cümle, altta tek beyaz hap "Sayımı bitir" + altı çizili "Barkod okut"; sağda alta
   yaslı fark listesi (Ürün · Kayıt · Sayılan · Fark) ve BAŞLANGIÇ · SAYAN · HAS FARKI satırı.
   Açık sayım yoksa aynı kalıp: tek cümle + "Sayım başlat"; sağda önceki sayımlar.

   ⚠ YALNIZ data-sema="yildiz". İSTEK ATMAZ: düğmeler ve satırlar sayfanın mevcut geri
     çağrılarıdır (Sayim.Yildiz.cs). Mevcut sayım kimlikleri (sy-*) özgün ekrandadır; bu
     bileşenin kimlikleri "yildiz-sayim-*".
   ═════════════════════════════════════════════════════════════════════════════ *@

<div class="@(B.AyrintiAcik ? "yz yz-sayim yz-liste--ayrinti" : "yz yz-sayim")" id="yildiz-sayim">
    @if (B.AyrintiAcik)
    {
        <div class="yz-liste-ana">
            <div class="yz-bas">
                <div class="yz-bas-sol">
                    <p class="yz-ust" id="yildiz-sayim-ust">@B.Ust</p>
                    <h1 class="yz-ince yz-h1" id="yildiz-sayim-baslik">@B.Baslik</h1>
                </div>
                <button type="button" class="yz-b2" id="yildiz-sayim-don" @onclick="B.AyrintiKapat">@YildizSayimSozlugu.SayimaDon(Dil.Dil)</button>
            </div>
        </div>
    }
    else
    {
    <div class="yz-sayim-ana">
        <section class="yz-sayim-sol">
            <div class="yz-sayim-ust">
                <p class="yz-ust" id="yildiz-sayim-ust">@B.Ust</p>
                <h1 class="yz-ince yz-sayim-h1" id="yildiz-sayim-baslik">@B.Baslik</h1>
                @if (B.Rakam is int rakam)
                {
                    <div class="yz-ince yz-sayi yz-sayim-rakam" id="yildiz-sayim-rakam">@rakam<span class="yz-s yz-sayim-rakam-ek"><span id="yildiz-sayim-rakam-ek">@B.RakamEki</span></span></div>
                }
                <p class="yz-s yz-sayim-cumle" id="yildiz-sayim-cumle">@B.Cumle</p>
                @if (B.OkutAcik && ChildContent is not null)
                {
                    @* YILDIZ-5A tur 2 (hakem KRİTİK): "Barkod okut" eski ekrana geçmez — sayfanın MEVCUT okutma alanları burada,
                       tuval .k kalıbında (.yz-duzen). *@
                    <div class="yz-duzen yz-sayim-okut" id="yildiz-sayim-okut">@ChildContent</div>
                }
                @B.Bantlar
            </div>
            <div class="yz-sayim-eylem">
                @if (B.B1Etiket is { } b1)
                {
                    <button type="button" class="yz-b1" id="yildiz-sayim-b1" disabled="@(B.B1Kilit is not null)" title="@B.B1Kilit"
                            aria-describedby="@(B.B1Kilit is null ? null : "yildiz-sayim-b1-kilit")" @onclick="B.B1Tikla">@b1</button>
                }
                @if (B.B2Etiket is { } b2)
                {
                    <button type="button" class="yz-b2" id="yildiz-sayim-b2" @onclick="B.B2Tikla">@b2</button>
                }
            </div>
            @if (B.B1Kilit is { } kilit)
            {
                <p class="yz-s yz-not" id="yildiz-sayim-b1-kilit">@kilit</p>
            }
        </section>
        <section class="yz-sayim-sag">
            @if (B.Yukleniyor && B.Satirlar.Count == 0)
            {
                <Yukleniyor />
            }
            else if (B.Satirlar.Count > 0)
            {
                <div class="@(B.Gecmis ? "yz-sayi yz-liste-tablo yz-sayim-gecmis" : "yz-sayi yz-liste-tablo")" id="yildiz-sayim-liste">
                    <div class="yz-sat yz-liste-sat yz-liste-sat--bas" aria-hidden="true">
                        @foreach (var c in B.Sutunlar)
                        {
                            <span class="@(c.Sag ? "yz-ust yz-liste-bas yz-sag" : "yz-ust yz-liste-bas")">@YildizListeBicim.Buyuk(c.Baslik, Dil.Dil)</span>
                        }
                    </div>
                    @foreach (var r in B.Satirlar)
                    {
                        <div class="@(r.Soluk ? "yz-sat yz-liste-sat yz-liste-sat--soluk" : "yz-sat yz-liste-sat")" id="@($"yildiz-sayim-{r.Id}")">
                            @for (var i = 0; i < r.Hucreler.Count; i++)
                            {
                                var h = r.Hucreler[i];
                                var sinif = YildizListe.HucreSinifi(h.Tur, i < B.Sutunlar.Count && B.Sutunlar[i].Sag);
                                if (i == 0 && r.Ac.HasDelegate)
                                {
                                    <button type="button" class="@(sinif + " yz-liste-ac")" id="@h.Id" aria-label="@r.AcEtiketi" @onclick="r.Ac">@h.Metin</button>
                                }
                                else
                                {
                                    <span class="@sinif" id="@h.Id">@YildizListe.IcMetin(h)</span>
                                }
                            }
                        </div>
                    }
                </div>
            }
            else if (B.BosMetni is { } bos)
            {
                <p class="yz-s yz-bos" id="yildiz-sayim-bos">@bos</p>
            }
            @* "+ N ürün daha" / "+ Tüm ayrıntılar" (tuval .ekle kalıbı) listenin altında, bilgi satırının üstünde:
               sağ sütun alta yaslı olduğundan bilgi satırı tuvaldeki yerinde kalır. *@
            @if (B.AyrintiAc.HasDelegate)
            {
                <button type="button" class="yz-ekle" id="yildiz-sayim-ayrinti" @onclick="B.AyrintiAc">
                    <svg width="16" height="16" viewBox="0 0 24 24" class="yz-ik" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"></path></svg>@(B.AyrintiEtiketi ?? YildizListeSozlugu.TumAyrintilar(Dil.Dil))
                </button>
            }
            @if (B.Bilgi.Count > 0)
            {
                <div class="yz-sayi yz-s yz-sayim-bilgi" id="yildiz-sayim-bilgi">
                    @foreach (var (etiket, deger) in B.Bilgi)
                    {
                        <span>@etiket <b>@deger</b></span>
                    }
                </div>
            }
        </section>
    </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public YildizSayimBaglami B { get; set; } = new();
    /// <summary>Sayfanın MEVCUT okutma alanları (aynı kimliklerle); yalnız B.OkutAcik iken çizilir.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
