@using Kuyumcu.Core.I18n
@using Kuyumcu.Core.Domain.Girdi
@using Microsoft.AspNetCore.SignalR.Client
@inject ApiIstemci Api
@inject DilServisi Dil
@inject OturumServisi Oturum
@inject NavigationManager Nav
@implements IAsyncDisposable
@inject NavigationManager Nav

@* ═══ M7a (kurucu 17.10) — "borcu vardır ama ekstra bir altın daha almıştır… borçtan düşülsün mü
   diye müşteri karar versin". Müşteriye bağlanmış, kararı verilmemiş gelen ödemeler kuyumcunun ÖNÜNE
   düşer; borç varsa uyarı. Liste boşsa hiçbir şey çizilmez (zorunlu önce). Yetkisiz rolde (403) gizli.
   17.10 (kısmi ödeme araştırması § 5): borçlu satışlar listelenir, gelen tutar TBK 102 sırasıyla ÖNERİ olarak
   dağıtılır (kullanıcı değiştirir), kalan açık kalır, fazla "müşterinin hesabında" kalır. SOR kararıdır:
   iki seçenek EŞİT ağırlıkta (ön seçim yok). Borçlu satış seçimi fatura KESMEZ (VUK 231/5). ═══ *@
@if (gorunur && (satirlar.Count > 0 || hata is not null || bilgi is not null))
{
    <section class="kart go-kutu" id="gelen-odeme-karari" aria-label="@GelenOdemeSozlugu.Baslik(Dil.Dil)">
        <div class="kart-govde form-dikey">
            <h2 class="go-baslik">@GelenOdemeSozlugu.Baslik(Dil.Dil)</h2>
            @if (hata is { } h) { <div class="bant bant-hata" role="alert" id="go-hata">@h</div> }
            @if (bilgi is { } b)
            {
                <div class="bant bant-basari" role="status" id="go-bilgi">
                    @b
                    @if (sonKararId is { } sk)
                    {
                        <button type="button" class="btn btn-ikincil btn-kucuk" id="go-geri-al" disabled="@calisiyor" @onclick="() => GeriAl(sk)">@GelenOdemeSozlugu.GeriAl(Dil.Dil)</button>
                    }
                </div>
            }
            @foreach (var s in satirlar)
            {
                var liste = s.BorcluSatislar ?? [];
                var secim = Secim(s);
                var dusulecek = liste.Where(x => secim.Secili.Contains(x.HareketId)).Sum(x => secim.Tutar.GetValueOrDefault(x.HareketId));
                <div class="go-satir" id="@($"go-{s.Id}")">
                    <div class="go-ust">
                        <strong>@GelenOdemeSozlugu.Geldi(s.CariAd ?? s.KarsiTarafAd ?? "—", Bicim.Tl(s.Tutar), Dil.Dil)</strong>
                        <span class="metin-soluk metin-kucuk">@Bicim.Gun(s.Tarih)</span>
                    </div>
                    @if (s.BorcTl > 0m)
                    {
                        <p class="go-uyari" id="@($"go-uyari-{s.Id}")" role="status">@GelenOdemeSozlugu.BorcuVar(Bicim.Tl(s.BorcTl), Dil.Dil)</p>
                    }
                    else
                    {
                        <p class="metin-soluk" id="@($"go-bilgi-{s.Id}")">@(s.AlacakTl > 0m ? GelenOdemeSozlugu.HesabindaVar(Bicim.Tl(s.AlacakTl), Dil.Dil) : GelenOdemeSozlugu.BorcuYok(Dil.Dil))</p>
                    }
                    @if (liste.Count > 0)
                    {
                        <ul class="liste-sade go-satislar" id="@($"go-satislar-{s.Id}")" aria-label="@GelenOdemeSozlugu.BorcluSatislar(Dil.Dil)">
                            @foreach (var x in liste)
                            {
                                var sec = secim.Secili.Contains(x.HareketId);
                                <li class="go-satis" id="@($"go-satis-{s.Id}-{x.HareketId}")">
                                    <div class="go-satis-sec">
                                        <Onay ElemanId="@($"go-sec-{s.Id}-{x.HareketId}")"
                                              Etiket="@($"{Bicim.Gun(x.Tarih)}{(x.FaturaNo is { } fno ? " · " + GelenOdemeSozlugu.FaturaNo(fno, Dil.Dil) : x.FisId is null ? "" : " · " + GelenOdemeSozlugu.Fis(Dil.Dil))} · {GelenOdemeSozlugu.Kalan(Bicim.Tl(x.KalanTl), Dil.Dil)}")"
                                              Deger="@sec" DegerChanged="@(v => Isaretle(s, x, v))" />
                                        @if (x.FaturaSuresiGecti) { <span class="rozet rozet-uyari" id="@($"go-fatura-gecti-{x.HareketId}")">@GelenOdemeSozlugu.FaturaGecti(Dil.Dil)</span> }
                                    </div>
                                    @if (sec && liste.Count > 1)   @* tek satışta tutar gelen paradır — kutu gereksiz (sade) *@
                                    {
                                        <Para ElemanId="@($"go-tutar-{s.Id}-{x.HareketId}")" Etiket="@GelenOdemeSozlugu.DusulecekTutar(Dil.Dil)" Zorunlu="true" Tur="TutarTuru.Pozitif" ParaBirimi="TRY"
                                              Deger="@secim.Tutar.GetValueOrDefault(x.HareketId)" DegerChanged="@(v => secim.Tutar[x.HareketId] = v ?? 0m)" />
                                    }
                                </li>
                            }
                        </ul>
                        <p class="metin-kucuk" id="@($"go-ozet-{s.Id}")">@GelenOdemeSozlugu.Dusulecek(Bicim.Tl(dusulecek), Bicim.Tl(Math.Max(0m, s.BorcTl - s.Tutar)), Dil.Dil)</p>
                    }
                    @if (s.Tutar > s.BorcTl && s.BorcTl > 0m)
                    {
                        <p class="metin-kucuk metin-soluk" id="@($"go-fazla-{s.Id}")">@GelenOdemeSozlugu.HesabindaKalacak(Bicim.Tl(s.Tutar - s.BorcTl), Dil.Dil)</p>
                    }
                    @if (s.HasBorcGram > 0m)
                    {
                        <p class="metin-kucuk metin-soluk" id="@($"go-has-{s.Id}")">@GelenOdemeSozlugu.AltinBorcu(Bicim.Has(s.HasBorcGram), Dil.Dil)</p>
                    }
                    <div class="satir">
                        <button type="button" class="btn btn-ikincil btn-kucuk" id="@($"go-borc-{s.Id}")" disabled="@calisiyor"
                                @onclick="() => Karar(s, KararBorc)">@(s.BorcTl > 0m ? GelenOdemeSozlugu.BorcundanDus(Dil.Dil) : GelenOdemeSozlugu.AlacakYaz(Dil.Dil))</button>
                        @* 17.10 havaleden satış: tezgâh bu havaleyle açılır, ürün seçilir, fatura kesilir (fiş arka planda). *@
                        <button type="button" class="btn btn-ikincil btn-kucuk" id="@($"go-sat-{s.Id}")" disabled="@calisiyor"
                                @onclick="@(() => Nav.NavigateTo($"/islemler?havale={s.Id}"))">@HavaleSozlugu.UrunSecSat(Dil.Dil)</button>
                        <button type="button" class="btn btn-ikincil btn-kucuk" id="@($"go-satis-{s.Id}")" disabled="@calisiyor"
                                @onclick="() => Karar(s, KararSatis)">@HavaleSozlugu.SatisGirildi(Dil.Dil)</button>
                    </div>
                </div>
            }
        </div>
    </section>
}

@code {
    private const string KararBorc = "BORC";
    private const string KararSatis = "SATIS";

    /// <summary>Karar verilince (sayfa bakiye/hareket listesini tazelesin diye).</summary>
    [Parameter] public EventCallback Degisti { get; set; }

    private sealed class SatisSecimi
    {
        public HashSet<string> Secili { get; } = [];
        public Dictionary<string, decimal> Tutar { get; } = [];
    }

    private List<GelenOdemeSatiri> satirlar = [];
    private readonly Dictionary<string, SatisSecimi> secimler = [];
    private bool gorunur = true, calisiyor;
    private string? hata, bilgi, sonKararId;

    protected override Task OnInitializedAsync() => Yenile();

    // ── M7: canlı yenileme — banka çekicisi yeni hareket yazınca /hubs/banka "BankaHareketGeldi" gönderir;
    //    kutu kendini ve sayfayı tazeler (müşteri: "düşer düşmez hemen şak ekranda"). Bağlantı kurulamazsa
    //    ekran bozulmaz: kutu sayfa açılışında ve her kararda yine tazelenir.
    private HubConnection? hub;
    private bool canliKapali;

    protected override async Task OnAfterRenderAsync(bool ilk)
    {
        if (!ilk || !gorunur || string.IsNullOrEmpty(Oturum.AccessToken)) return;
        try
        {
            hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/hubs/banka"), o => o.AccessTokenProvider = () => Task.FromResult<string?>(Oturum.AccessToken))
                .WithAutomaticReconnect()
                .Build();
            hub.On<int>("BankaHareketGeldi", _ => InvokeAsync(async () => { await Yenile(); await Degisti.InvokeAsync(); }));
            await hub.StartAsync();
        }
        catch (Exception) { canliKapali = true; }   // canlı kanal yoksa: açılış + karar tazelemesi sürer (liste KORUNUR)
    }

    public async ValueTask DisposeAsync()
    {
        if (hub is not null && !canliKapali) await hub.DisposeAsync();
    }

    /// <summary>Satırın seçimi; ilk kez görülüyorsa sunucunun TBK 102 önerisiyle dolar.</summary>
    private SatisSecimi Secim(GelenOdemeSatiri s)
    {
        if (secimler.TryGetValue(s.Id, out var v)) return v;
        v = new SatisSecimi();
        foreach (var x in s.BorcluSatislar ?? [])
            if (x.OneriTl > 0m) { v.Secili.Add(x.HareketId); v.Tutar[x.HareketId] = x.OneriTl; }
        return secimler[s.Id] = v;
    }

    private void Isaretle(GelenOdemeSatiri s, BorcluSatisSatiri x, bool sec)
    {
        var v = Secim(s);
        if (!sec) { v.Secili.Remove(x.HareketId); return; }
        v.Secili.Add(x.HareketId);
        var kullanilan = (s.BorcluSatislar ?? []).Where(y => y.HareketId != x.HareketId && v.Secili.Contains(y.HareketId))
            .Sum(y => v.Tutar.GetValueOrDefault(y.HareketId));
        v.Tutar[x.HareketId] = Math.Max(0m, Math.Min(x.KalanTl, s.Tutar - kullanilan));
    }

    /// <summary>Sayfa yeni dekont girince çağırır.</summary>
    public async Task Yenile()
    {
        if (!await Oturum.RaporRoluBekle()) { satirlar = []; return; }   // Görsel denetim 2: SAHIP/MUDUR/MUHASEBE ucu
        try
        {
            satirlar = await Api.TazeGetAsync<List<GelenOdemeSatiri>>("/bankalar/karar-bekleyen");
            hata = null;
            foreach (var k in secimler.Keys.Where(k => satirlar.All(s => s.Id != k)).ToList()) secimler.Remove(k);
        }
        catch (ApiHata ex) when (ex.StatusCode == 403) { gorunur = false; }
        catch (Exception ex) when (ex is ApiHata or JsonException) { hata = ex.Message; }   // P-11: liste KORUNUR
        StateHasChanged();
    }

    private async Task Karar(GelenOdemeSatiri s, string karar)
    {
        calisiyor = true; hata = bilgi = null; sonKararId = null;
        try
        {
            var v = Secim(s);
            var mahsuplar = karar == KararBorc
                ? (s.BorcluSatislar ?? []).Where(x => v.Secili.Contains(x.HareketId) && v.Tutar.GetValueOrDefault(x.HareketId) > 0m)
                    .Select(x => new { borcHareketId = x.HareketId, tutarTl = v.Tutar[x.HareketId] }).ToList()
                : null;
            var y = await Api.PostAsync<JsonElement>($"/bankalar/hareketler/{s.Id}/karar", new { karar, mahsuplar });
            bilgi = karar == KararBorc
                ? GelenOdemeSozlugu.Dusuldu(s.CariAd ?? "", Dil.Dil)
                : GelenOdemeSozlugu.SatisSayildi(Dil.Dil);
            // M8 kalanı: borcu tamamen kapanan satışın faturası ödendi sayıldı — kullanıcıya tek satırda.
            if (y.ValueKind == JsonValueKind.Object && y.TryGetProperty("odenenFaturalar", out var of) && of.ValueKind == JsonValueKind.Array && of.GetArrayLength() > 0)
                bilgi += " " + GelenOdemeSozlugu.FaturaOdendi(string.Join(", ", of.EnumerateArray().Select(e => e.GetString())), Dil.Dil);
            sonKararId = s.Id;
            secimler.Remove(s.Id);
            await Yenile();
            await Degisti.InvokeAsync();
        }
        catch (ApiHata ex) { hata = ex.Message; }
        finally { calisiyor = false; }
    }

    private async Task GeriAl(string id)
    {
        calisiyor = true; hata = null;
        try
        {
            await Api.PostAsync<JsonElement>($"/bankalar/hareketler/{id}/karar/geri-al");
            bilgi = GelenOdemeSozlugu.GeriAlindi(Dil.Dil);
            sonKararId = null;
            await Yenile();
            await Degisti.InvokeAsync();
        }
        catch (ApiHata ex) { hata = ex.Message; }
        finally { calisiyor = false; }
    }
}
