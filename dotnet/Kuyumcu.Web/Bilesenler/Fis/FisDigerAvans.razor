@using Kuyumcu.Core.I18n
@inject DilServisi Dil

@* ═══ PAKET S2-6 — KAPORA (avans, P-21 · Y-17) ═══
   Uçlar: GET /islemler/avans/{cariId} · POST /islemler/avans ·
          POST /islemler/avans/mahsup · POST /islemler/avans/iade (onay modalı).
   Kapora değişmez bir kasa kaydıdır → DegismezIpucu + doğru yol (geri öde).
   ⚠ İstek atmaz — niyet DigerIstek ile sayfaya gider. *@
<div class="form-dikey" id="avans-form">
    <Secici ElemanId="avans-cari" Etiket="@M.Musteri" Zorunlu="true" BosSecenekMetni="@Satis3Sozlugu.Al(Dil.Dil).MusteriSecin"
            Secenekler="@CariSecenekleri" Deger="@A.CariId" DegerChanged="CariDegisti"
            Hata="@(Hata(DigerEylemler.AvansAl, "cari") ?? Hata(DigerEylemler.AvansIade, "cari"))" />
    @if (A.CariId is not null && A.AcikAvans is { } acik)
    {
        <p id="avans-acik" role="status">
            <Rozet Renk="@(acik > 0 ? "mavi" : "gri")">@string.Format(M.AcikAvans, Bicim.Para(acik, "TRY"))</Rozet>
        </p>
    }
    <div class="form-izgara">
        <Para ElemanId="avans-tutar" Etiket="@M.Tutar" Zorunlu="true" EnAz="0.01m" ParaBirimi="TRY"
              Deger="@A.Tutar" DegerChanged="@(v => A.Tutar = v)" Hata="@Hata(DigerEylemler.AvansAl, "tutar")" />
        <Secici ElemanId="avans-odeme" Etiket="@M.OdemeSekli" Zorunlu="true"
                Secenekler="@OdemeSecenekleri" Deger="@A.OdemeTuru" DegerChanged="@(v => A.OdemeTuru = v ?? "NAKIT")" />
        @* SATIS-3 (ölçüm: PRO 1440 açılış 1,16 ekran): kasa aynı satırda — Tutar · Ödeme şekli · Kasa. *@
        <FisDigerKasa Durum="Durum" Baglam="Baglam" Onek="avans" Hata="@Hata(DigerEylemler.AvansAl, "kasa")" />
    </div>
    <details class="fis-diger-ayrinti" id="avans-ayrinti" open="@(!string.IsNullOrEmpty(A.Aciklama))">   @* SATIS-3: isteğe bağlı alanlar "+ Ayrıntı ekle" altında KATLI (kurucu 11:35) *@
        <summary id="avans-ayrinti-ac">@SatisSadeSozlugu.Al(Dil.Dil).DigerAyrintilar</summary>
        <Metin ElemanId="avans-aciklama" Etiket="@Dil.T.Ortak.Aciklama" EnFazla="@Kuyumcu.Core.Domain.Girdi.AlanSinirlari.IslemAciklama"
               Deger="@A.Aciklama" DegerChanged="@(v => A.Aciklama = v ?? "")" />
    </details>
    <FisDigerEylem Id="avans-al" Metin="@M.AvansAl" Mesgul="Durum.Mesgul" KurVar="Baglam.KurVar" Tikla="Al"
                   EkSebep="@NakitHaddiSebebi" Red="@AlRed"
                   Eksik="@FisDigerEylem.Etiketler(A.AlHatalari(M, Kasa), ("cari", M.Musteri), ("tutar", M.Tutar), ("kasa", M.Kasa))" />   @* t10 *@
    @* t3 hakemi: değişmezlik gerekçesi açılışta 3 satırlık kutu olarak DURMAZ — katlı "Bilgi" ipucunda (UX-S25 korunur). *@
    <details class="fis-bilgi" id="avans-degismez-bilgi"><summary class="metin-kucuk">@Satis3Sozlugu.Al(Dil.Dil).BilgiIpucu</summary>
    <DegismezIpucu Varlik="Avans" Gerekce="@M.AvansDegismez" AlternatifYol="@M.AvansDegismezYol" />
    </details>
</div>

<details class="katlanir fis-gecmis" id="avans-mahsup-gecmis">   @* SATIS-3: geçmiş/ikincil bölüm KAPALI katlanır (kurucu 25.09 "piyano gibi"); içerik DOM'da — id'ler aynı *@
<summary class="katlanir-baslik" id="avans-mahsup-gecmis-ac"><h3 id="avans-mahsup-baslik" class="katlanir-ad">@M.MahsupBaslik</h3></summary>
<div class="form-dikey" id="avans-mahsup-form">
    <p class="metin-soluk">@M.MahsupAciklama</p>
    @if (A.CariId is null)
    {
        <p class="metin-kucuk metin-amber" id="avans-mahsup-cari-yok" role="note">@M.MusteriSecin</p>
    }
    else if (MahsupSecenekleri.Count == 0)
    {
        <BosDurum Mesaj="@M.MahsupSatisYok" />
    }
    else
    {
        <Secici ElemanId="avans-mahsup-satis" Etiket="@M.MahsupSatis" Zorunlu="true"
                Secenekler="@MahsupSecenekleri" Deger="@A.MahsupSatisId" DegerChanged="@(v => A.MahsupSatisId = v)"
                Hata="@Hata(DigerEylemler.AvansMahsup, "satis")" />
        <Para ElemanId="avans-mahsup-tutar" Etiket="@M.Tutar" Zorunlu="true" EnAz="0.01m" ParaBirimi="TRY"
              Deger="@A.MahsupTutar" DegerChanged="@(v => A.MahsupTutar = v)" Hata="@Hata(DigerEylemler.AvansMahsup, "mahsup-tutar")" />
        <div class="satir">
            <button type="button" class="btn btn-ikincil" id="avans-mahsup" disabled="@(Durum.Mesgul || !Baglam.KurVar || A.AcikAvans is not > 0m)"
                    aria-describedby="@(A.AcikAvans is > 0m ? null : "avans-mahsup-kilit")"
                    @onclick="Mahsup">@M.MahsupKaydet</button>
        </div>
        @if (A.AcikAvans is not > 0m)
        {
            <p class="metin-kucuk metin-amber" id="avans-mahsup-kilit" role="note">@M.AvansYok</p>
        }
    }
</div>

</details>

<details class="katlanir fis-gecmis" id="avans-iade-gecmis">   @* SATIS-3: geçmiş/ikincil bölüm KAPALI katlanır (kurucu 25.09 "piyano gibi"); içerik DOM'da — id'ler aynı *@
<summary class="katlanir-baslik" id="avans-iade-gecmis-ac"><h3 id="avans-iade-baslik" class="katlanir-ad">@M.AvansIadeBaslik</h3></summary>
<div class="form-dikey" id="avans-iade-form">
    @if (!DigerYetki.SahipMudur(Baglam.Rol))
    {
        <p class="metin-kucuk metin-soluk" id="avans-iade-kilit" role="note">@M.YetkiSahipMudur</p>
    }
    <Para ElemanId="avans-iade-tutar" Etiket="@M.Tutar" Zorunlu="true" EnAz="0.01m" ParaBirimi="TRY"
          Deger="@A.IadeTutar" DegerChanged="@(v => A.IadeTutar = v)" Hata="@Hata(DigerEylemler.AvansIade, "iade-tutar")" />
    <GerekceAlani Id="avans-iade-gerekce" Etiket="@M.Gerekce" AsgariUzunluk="@AvansGirisi.IadeGerekceAsgari"
                  Deger="@A.IadeGerekce" DegerChanged="@(v => A.IadeGerekce = v)" />
    @if (Hata(DigerEylemler.AvansIade, "iade-gerekce") is { } gh)
    {
        <span class="hata-metni alan-hata" id="avans-iade-gerekce-hata" role="alert">@gh</span>
    }
    <div class="satir">
        <button type="button" class="btn btn-tehlike" id="avans-iade"
                disabled="@(Durum.Mesgul || !Baglam.KurVar || !DigerYetki.SahipMudur(Baglam.Rol))"
                aria-describedby="@(DigerYetki.SahipMudur(Baglam.Rol) ? null : "avans-iade-kilit")"
                @onclick="IadeOnayla">@M.AvansIadeKaydet</button>
    </div>
</div>

</details>

@code {
    [Parameter, EditorRequired] public DigerIslemDurumu Durum { get; set; } = new();
    [Parameter, EditorRequired] public DigerBaglam Baglam { get; set; } = new([], [], [], [], false, null);
    [Parameter] public EventCallback<DigerIstek> Istek { get; set; }

    private FisDigerMetinleri M => FisDigerSozlugu.Al(Dil.Dil);
    private AvansGirisi A => Durum.Avans;
    private string? Kasa => Durum.EtkinKasa(Baglam);

    /// <summary>t22: sunucunun bu düğmeye verdiği nakit reddi (kısa metin).</summary>
    private string? AlRed => Durum.Red is { } r && r.Eylem == DigerEylemler.AvansAl ? r.Metin : null;

    /// <summary>SATIS-3 t22 (tasarım hakemi YÜKSEK): Satış'taki nakit ön denetiminin aynısı — nakit kapora sunucunun haddini
    /// (Baglam.NakitHad, /tevsik/gunluk) AŞARSA düğme PASİF + kısa sebep. Kıyas sunucu gibi "&gt; had" (tam hadde nakit serbest);
    /// sayı istemciye gömülmez: had bilinmezse ön denetim yok, kapı sunucuda (reddi kısa metinle düğmenin yanında).</summary>
    private string? NakitHaddiSebebi =>
        A.OdemeTuru == "NAKIT" && Baglam.NakitHad is { } h && h > 0m && A.Tutar is { } t && t > h
            ? string.Format(Satis3Sozlugu.Al(Dil.Dil).DigerNakitHaddi, Bicim.Tl(h)) : null;

    private IReadOnlyList<SecenekOgesi> CariSecenekleri =>
        Baglam.Cariler.Where(c => !c.SistemCarisi).Select(c => new SecenekOgesi(c.Id, c.Ad)).ToList();

    /// <summary>Avans NAKIT/KART/HAVALE ile alınır (sunucu AvansAlDto; veresiye kapora olmaz).</summary>
    private IReadOnlyList<SecenekOgesi> OdemeSecenekleri =>
    [
        new("NAKIT", M.Nakit),
        new("KART", M.Kart),
        new("HAVALE", M.Havale),
    ];

    /// <summary>Seçili müşterinin son satışları (sayfanın zaten yüklediği liste — yeni istek yok).</summary>
    private IReadOnlyList<SecenekOgesi> MahsupSecenekleri =>
        Baglam.SonSatislar.Where(s => s.CariId == A.CariId)
            .Select(s => new SecenekOgesi(s.Id, $"{Bicim.TarihTam(s.Tarih)} · {s.UrunAdi ?? "—"} · {Bicim.Para(s.TlTutari, "TRY")}"))
            .ToList();

    private string? Hata(string eylem, string alan) =>
        Durum.Denenen.Contains(eylem) ? Hatalar(eylem).GetValueOrDefault(alan) : null;

    private Dictionary<string, string> Hatalar(string eylem) => eylem switch
    {
        DigerEylemler.AvansAl => A.AlHatalari(M, Kasa),
        DigerEylemler.AvansMahsup => A.MahsupHatalari(M),
        _ => A.IadeHatalari(M, Kasa),
    };

    private async Task CariDegisti(string? v)
    {
        A.CariId = v;
        A.AcikAvans = null;
        A.MahsupSatisId = null;
        if (v is not null) await Istek.InvokeAsync(new DigerIstek(DigerEylemler.AvansSorgula, v));
    }

    private async Task Al()
    {
        Durum.Denenen.Add(DigerEylemler.AvansAl);
        if (A.AlHatalari(M, Kasa).Count > 0) return;
        if (NakitHaddiSebebi is not null) return;   // t22: haddi aşan nakit kapora istek atmaz
        await Istek.InvokeAsync(new DigerIstek(DigerEylemler.AvansAl));
    }

    private async Task Mahsup()
    {
        Durum.Denenen.Add(DigerEylemler.AvansMahsup);
        if (A.MahsupHatalari(M).Count > 0) return;
        await Istek.InvokeAsync(new DigerIstek(DigerEylemler.AvansMahsup));
    }

    private async Task IadeOnayla()
    {
        Durum.Denenen.Add(DigerEylemler.AvansIade);
        if (A.IadeHatalari(M, Kasa).Count > 0) return;
        Durum.Onay = DigerEylemler.AvansIade;   // geri alınamaz: para kasadan çıkar → ortak onay
        await Istek.InvokeAsync(new DigerIstek(DigerEylemler.Ciz));
    }
}
