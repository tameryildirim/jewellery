    /// <summary>Giriş ekranı (ortada, 96 px) — tuval Giris4(a).</summary>
    public static readonly TasOlcusu GirisTasi = new("giris-amb-ti", new[] { new[] { "44.74", "2.37", "1.18", "0" }, new[] { "44.74", "2.37", "1.18", "0" }, new[] { "46.17", "2.37", "1.18", "0" }, new[] { "32.27", "2.37", "1.18", "0" }, new[] { "32.27", "2.37", "1.18", "0" }, new[] { "46.17", "2.37", "1.18", "0" }, new[] { "47.11", "2.37", "1.18", "0" }, new[] { "45.34", "2.37", "1.18", "0" }, new[] { "47.11", "2.37", "1.18", "0" }, new[] { "71.83", "2.37", "1.18", "0" }, new[] { "71.83", "2.37", "1.18", "0" }, new[] { "26.02", "2.37", "1.18", "1" }, new[] { "26.02", "2.37", "1.18", "1" }, new[] { "71.83", "2.37", "1.18", "1" }, new[] { "71.83", "2.37", "1.18", "1" }, new[] { "46.17", "2.37", "1.18", "0" }, new[] { "44.74", "2.37", "1.18", "0" }, new[] { "32.27", "2.37", "1.18", "0" }, new[] { "32.27", "2.37", "1.18", "0" }, new[] { "44.74", "2.37", "1.18", "0" }, new[] { "46.17", "2.37", "1.18", "0" }, new[] { "47.11", "2.37", "1.18", "0" }, new[] { "45.34", "2.37", "1.18", "0" }, new[] { "47.11", "2.37", "1.18", "0" }, new[] { "71.83", "2.37", "1.18", "0" }, new[] { "71.83", "2.37", "1.18", "0" }, new[] { "46.17", "2.37", "1.18", "0" }, new[] { "32.27", "2.37", "1.18", "0" }, new[] { "32.27", "2.37", "1.18", "0" }, new[] { "46.17", "2.37", "1.18", "0" }, new[] { "71.83", "2.37", "1.18", "0" }, new[] { "71.83", "2.37", "1.18", "0" }, new[] { "26.02", "2.37", "1.18", "0" }, new[] { "26.02", "2.37", "1.18", "0" }, new[] { "71.83", "2.37", "1.18", "0" }, new[] { "71.83", "2.37", "1.18", "0" }, new[] { "46.17", "2.37", "1.18", "0" }, new[] { "32.27", "2.37", "1.18", "0" }, new[] { "32.27", "2.37", "1.18", "0" }, new[] { "46.17", "2.37", "1.18", "0" }, new[] { "71.83", "2.37", "1.18", "0" }, new[] { "71.83", "2.37", "1.18", "0" } });


    /// <summary>
    /// KURUCU 14.10 — taş kurucunun pırlanta çiziminden 3B kurulur: her kenar ekrana bakan bir şerit (duruşta çizgi
    /// kalınlığı çizimdeki gibi eşit) + eğik kenarlara dik ikinci şerit (dönüşte çizgi incelmez). Önden izdüşüm = çizim.
    /// YILDIZ-AMBLEM-2 — tuvaldeki &lt;span class="amb-parla"&gt; bloğu (kabuk ve giriş AYNI çizim, yalnız ölçü
    /// farklı). Dış sarmalayıcı .amb-parla (süzgeç) → .amb-ik (perspektif kutusu) → gradyan tanımı + .tas3d
    /// (preserve-3d, dönen kutu) → 8 yüz. Taç yüzü kapalı üçgen (Z: ekvator çizgisi), pavyon açık "V".
    /// </summary>
    public static RenderFragment AmblemTasi(TasOlcusu o) =>
        @<span class="amb-parla" aria-hidden="true"><span class="amb-ik"><svg class="amb-tanim" width="0" height="0" aria-hidden="true" focusable="false"><defs><linearGradient id="@o.GradyanId" x1="0" y1="0" x2="1" y2="0"><stop class="amb-s-govde" offset="0"></stop><stop class="amb-s-orta" offset=".42"></stop><stop class="amb-s-parilti" offset=".5"></stop><stop class="amb-s-orta" offset=".58"></stop><stop class="amb-s-govde" offset="1"></stop><animateTransform attributeName="gradientTransform" type="translate" values="-1.2 0;-1.2 0;1.2 0;1.2 0" keyTimes="0;0.06;0.22;1" dur="11s" repeatCount="indefinite"></animateTransform></linearGradient></defs></svg><span class="tas3d">@for (var i = 0; i < o.Kenarlar.Length; i++)
        {
            var y = o.Kenarlar[i];
            <svg class="@(y[3] == "1" ? $"amb-yuz amb-cift amb-f{i}" : $"amb-yuz amb-f{i}")" width="@y[0]" height="@y[1]" viewBox="@($"0 0 {y[0]} {y[1]}")" aria-hidden="true" focusable="false"><rect width="@y[0]" height="@y[1]" rx="@y[2]" fill="@($"url(#{o.GradyanId})")"></rect></svg>
        }</span></span></span>;

    private bool menuAcik;
    private bool kullaniciAcik;
    private bool subeHatasi;

    private string MutlakYol => new Uri(Nav.Uri).AbsolutePath;

    private void MenuDegistir()
    {
        menuAcik = !menuAcik;
        if (menuAcik) kullaniciAcik = false;
    }

    private void KullaniciDegistir()
    {
        kullaniciAcik = !kullaniciAcik;
        if (kullaniciAcik) menuAcik = false;
    }

    private void SubeHatasiDegisti(bool var) => subeHatasi = var;

    // ── YILDIZ-4A: Basit/Profesyonel (UstBar.ModuDegistir ile AYNI akış; hata bantta) ──
    private bool modDegisiyor;
    private string? modHata;
    private Task ModuBasitYap() => ModuDegistir(ArayuzModuServisi.Basit);
    private Task ModuProYap() => ModuDegistir(ArayuzModuServisi.Profesyonel);
    private async Task ModuDegistir(string mod)
    {
        if (modDegisiyor || Modu.EtkinMod == mod) return;
        modDegisiyor = true;
        modHata = null;
        StateHasChanged();
        try { await Modu.DegistirAsync(mod); }
        catch (ApiHata ex) { modHata = ex.Message; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { modHata = ex.Message; }
        modDegisiyor = false;
        StateHasChanged();
    }

    private void Tus(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        menuAcik = false;
        kullaniciAcik = false;
    }

    private string KartAdi()
    {
        var k = Oturum.Kullanici;
        if (k is null) return "";
        // YILDIZ-AMBLEM-2 tur 2 (hakem KRİTİK: "HATİCE GÜLİZAR K." 1366/1280/1024/375'te şeridi taşırıyordu):
        // birden çok ön ad varsa yalnız İLKİ yazılır — tuval kalıbı "AD S." korunur ("HAKAN T." değişmez).
        var ilk = IlkAd(k.Ad);
        var ad = k.Soyad.Length > 0 ? $"{ilk} {k.Soyad[..1]}." : ilk;
        // YILDIZ-4A: tuval "HAKAN T." — büyük harf metnin kendisidir (CSS dönüşümü değil), dil kültürüyle.
        return ad.ToUpper(AdKulturu());
    }

    // ≤600 px'te düğme yalnız baş harfleri çizer (CSS ::before attr(data-bas)); metin düğümü aynen kalır
    // (erişilebilir ad ve "HAKAN T." sözleşmesi değişmez).
    private string BasHarfler()
    {
        var k = Oturum.Kullanici;
        if (k is null) return "";
        var ilk = IlkAd(k.Ad);
        var bas = (ilk.Length > 0 ? ilk[..1] : "") + (k.Soyad.Length > 0 ? k.Soyad[..1] : "");
        return bas.ToUpper(AdKulturu());
    }

    private static string IlkAd(string ad)
    {
        var parca = (ad ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parca.Length > 0 ? parca[0] : "";
    }

    private System.Globalization.CultureInfo AdKulturu() =>
        Dil.Dil == "en" ? System.Globalization.CultureInfo.InvariantCulture : System.Globalization.CultureInfo.GetCultureInfo("tr-TR");

    private async Task CikisYap()
    {
        await Oturum.CikisAsync();
        Nav.NavigateTo("/giris");
    }

    protected override void OnInitialized()
    {
        Dil.Degisti += Yenile;
        Oturum.Degisti += OturumDegisti;
        Yetki.Degisti += Yenile;
        Canli.Degisti += Yenile;
        Modu.Degisti += Yenile;
        Nav.LocationChanged += KonumDegisti;
        _ = Yetki.HazirlaAsync();
    }

    private async void OturumDegisti()
    {
        await Yetki.HazirlaAsync();
        Yenile();
    }

    private void KonumDegisti(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        menuAcik = false;
        kullaniciAcik = false;
        Yenile();
    }

    private void Yenile() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Dil.Degisti -= Yenile;
        Oturum.Degisti -= OturumDegisti;
        Yetki.Degisti -= Yenile;
        Canli.Degisti -= Yenile;
        Modu.Degisti -= Yenile;
        Nav.LocationChanged -= KonumDegisti;
    }
}
