    // PAKET GOC-A — tarih aralığı (TarihAralik geçersizse null bildirir; aralık bozuksa istek ATILMAZ).
    private DateOnly? AralikBas => bas is { } b ? DateOnly.FromDateTime(b) : null;
    private DateOnly? AralikBit => bit is { } b ? DateOnly.FromDateTime(b) : null;
    private string? AralikHatasi => TarihPenceresi.AralikDenetle(AralikBas, AralikBit) is { } h ? Kuyumcu.Core.I18n.GirdiSozlugu.Mesaj(h, Dil.Dil) : null;
    private async Task AralikBasDegisti(DateOnly? v)
    {
        bas = v?.ToDateTime(TimeOnly.MinValue);
        if (TarihPenceresi.AralikDenetle(AralikBas, AralikBit) is null) await Yukle();
    }
    private async Task AralikBitDegisti(DateOnly? v)
    {
        bit = v?.ToDateTime(TimeOnly.MinValue);
        if (TarihPenceresi.AralikDenetle(AralikBas, AralikBit) is null) await Yukle();
    }
    private Kuyumcu.Web.Servisler.PosTahsilatSayfasi? sayfa;
    private Kuyumcu.Web.Servisler.PosOneri? oneri;
    private Kuyumcu.Web.Servisler.PosTahsilatSatir? iptalAdayi;

    private string durum = "";
    private DateTime? bas;
    private DateTime? bit;
    private string bankaHareketId = "";
    private string iptalGerekce = "";

    private bool yukleniyor = true;
    /// <summary>Takvim + defter okundu mu? Okunamadıysa kartlar çizilmez (boş durum yalan söylemez).</summary>
    private bool veriGeldi;
    private bool kaydediliyor;
    private string? hata;
    private string? basari;

    private ZoIslemMetinleri ZO => ZoIslemSozlugu.Al(Dil.Dil);

    /// <summary>Oturumda şube yok (Hurda.razor ile aynı ölçü).</summary>
    private bool SubeYok => string.IsNullOrWhiteSpace(Oturum.Kullanici?.SubeId);
    /// <summary>Hurda ile aynı metin: SAHİP kendine atar, diğer roller sahibe başvurur.</summary>
    private string SubeYokMetni => Oturum.Kullanici?.Rol == "SAHIP"
        ? ZO.HurdaSubeYokSahip : SadeSozlugu.Al(Dil.Dil).HurdaSubeYok;

    private bool HareketVerildi => !kaydediliyor && bankaHareketId.Trim().Length > 0;

    /// <summary>Eşleştirme seçicisinin kaynağı: yalnız POS hesaplarındaki yatma adayları.</summary>
    private string AdayYolu => $"/pos/yatma-adaylari?dil={Dil.Dil}";

    /// <summary>UX-S30 — birincil eşleştir düğmesi neden kapalı? (null = açık)</summary>
    private string? EslestirKilit =>
        kaydediliyor ? null
        : bankaHareketId.Trim().Length == 0 ? ZO.PosOnceHareketSec
        : oneri is null ? ZO.PosOnceOneriGetir
        : secilenler.Count == 0 ? ZO.PosElleSecin
        : Fazla > 0m ? string.Format(ZO.PosElleFazla, Bicim.Para(Fazla, "TRY"))
        : null;

    /// <summary>Öneri yok ve henüz seçim yok: yol "pos-oneri-yok"ta TEK kez yazılı; kilit satırı tekrar etmez.</summary>
    private bool ElleBekliyor => oneri is { Bulundu: false } && secilenler.Count == 0;

    // ── ZO-ISLEM-A 28.09: elle eşleştirme ─────────────────────────────────
    /// <summary>Bekleyen / kısmi yatmış tahsilatlar (seçim listesi) — sunucudan.</summary>
    private List<Kuyumcu.Web.Servisler.PosTahsilatSatir> acikSatirlar = [];
    private bool acikSinirDegdi;
    private string? acikHata;
    /// <summary>İşaretli satırlar → eşleşecek tutar (satırın kalan tutarı ya da önerinin tutarı).</summary>
    private readonly Dictionary<string, decimal> secilenler = [];

    private decimal SecilenToplam => secilenler.Values.Sum();

    /// <summary>Seçilen toplam hareketin kalanını ne kadar aşıyor (bilinmiyorsa 0 — sunucu karar verir).</summary>
    private decimal Fazla =>
        oneri?.HareketKalan is { } hk && SecilenToplam > hk ? SecilenToplam - hk : 0m;

    private void ElleSec(Kuyumcu.Web.Servisler.PosTahsilatSatir t, bool secili)
    {
        // ZO-ISLEM-A 28.09 (doğrulayıcı DÜŞÜK): hareketin kalanı tahsilatın kalanından
        // küçükse satır KISMEN eşleşir (sunucu kısmi eşleştirmeyi destekler); eskiden yalnız
        // tam kalanla seçildiği için bu durumda ekrandan eşleştirme yapılamıyordu.
        if (secili)
        {
            decimal? bosta = oneri?.HareketKalan is { } hk ? hk - SecilenToplam : null;
            secilenler[t.Id] = bosta is { } b && b > 0m && b < t.KalanTutar ? b : t.KalanTutar;
        }
        else secilenler.Remove(t.Id);
    }

    private async Task AcikSatirlariYukle()
    {
        acikHata = null;
        try
        {
            var b = await PosApi.TahsilatlariGetir("BEKLIYOR", limit: 200);
            var k = await PosApi.TahsilatlariGetir("KISMI", limit: 200);
            // 29.09 (tasarım hakemi KRİTİK): yalnız parası seçilen hareketin hesabına yatan
            // cihazların tahsilatları (sunucu öneride döndürür; yoksa sunucu kapısı karar verir).
            var uygun = oneri?.UygunCihazlar;
            acikSatirlar = b.Kayitlar.Concat(k.Kayitlar)
                .Where(x => x.KalanTutar > 0m)
                .Where(x => uygun is null || uygun.Contains(x.PosCihazId))
                .DistinctBy(x => x.Id)
                .OrderBy(x => x.ValorTarihi).ThenBy(x => x.CihazAd, StringComparer.Ordinal)
                .ToList();
            acikSinirDegdi = b.SinirDegdi || k.SinirDegdi;
        }
        // UX-S28: hata "bekleyen yok"a çevrilmez.
        catch (ApiHata ex) { acikHata = ex.Message; acikSatirlar = []; }
    }

    /// <summary>ZO-ISLEM-A 28.09 — satırın tek eylemi (iptal) ortak menüye.</summary>
    /// 28.09 (7. doğrulama): eşleşmiş/kısmi satırda "Eşleşmeyi geri al" da menüdedir.
    private IReadOnlyList<SatirEylemleri.Eylem> IptalEylemi(Kuyumcu.Web.Servisler.PosTahsilatSatir t)
    {
        var liste = new List<SatirEylemleri.Eylem>();
        if (GeriAlinabilirMi(t))
            liste.Add(new SatirEylemleri.Eylem($"pos-t-geri-al-{t.Id}", ZO.PosGeriAl,
                EventCallback.Factory.Create(this, () => GeriAlAc(t)),
                kilitli: !GeriAlmaYetkisi, kilitNedeni: ZO.PosGeriAlYetki));
        liste.Add(new SatirEylemleri.Eylem($"pos-t-iptal-{t.Id}", Dil.T.Pos.Iptal,
            EventCallback.Factory.Create(this, () => IptalAc(t)),
            kilitli: t.Durum != "BEKLIYOR", kilitNedeni: IptalKilitNedeni(t)));
        return liste;
    }

    /// <summary>Bankaya (kısmen ya da tamamen) eşleşmiş, iptal edilmemiş satır.</summary>
    private static bool GeriAlinabilirMi(Kuyumcu.Web.Servisler.PosTahsilatSatir t) =>
        t.Durum != "IPTAL" && t.YatanTutar > 0m;

    /// <summary>Sunucu: POST /pos/eslesmeler/{id}/geri-al [RolGerekli("SAHIP","MUDUR")].</summary>
    private bool GeriAlmaYetkisi => Oturum.Kullanici?.Rol is "SAHIP" or "MUDUR";

    /// <summary>Sunucu: /pos/yatma-adaylari · /pos/oto-eslestir-onerisi · /pos/eslestir [RolGerekli("SAHIP","MUDUR","MUHASEBE")].</summary>
    // Rol bilinmiyorsa (oturum henüz yüklenmedi) kart gizlenmez: yetki kapısı SUNUCUDADIR (fail-closed);
    // ekran yalnız bilinen yetkisiz rolde ölü kartı göstermez.
    private bool EslestirmeYetkisi => Oturum.Kullanici?.Rol is null or "SAHIP" or "MUDUR" or "MUHASEBE";

    private string IptalKilitNedeni(Kuyumcu.Web.Servisler.PosTahsilatSatir t) =>
        GeriAlinabilirMi(t) ? ZO.PosIptalKilitEslesmis : ZO.PosIptalKilit;

    // ── 28.09 (7. doğrulama): eşleşmeyi geri alma ─────────────────────────
    private Kuyumcu.Web.Servisler.PosTahsilatSatir? geriAlAdayi;
    private List<Kuyumcu.Web.Servisler.PosEslesmeSatir> etkinEslesmeler = [];
    private bool geriAlYukleniyor;
    private string? geriAlHata;
    private string? geriAlEslesmeId;
    private string geriAlGerekce = "";

    private IReadOnlyList<SecenekOgesi> EslesmeSecenekleri =>
        etkinEslesmeler.Select(x => new SecenekOgesi(x.Id,
            $"{Gun(x.Olusturuldu)} · {Bicim.Para(x.EslesenTutar, geriAlAdayi?.ParaBirimi ?? "TRY")}",
            AltBilgi: x.Otomatik ? ZO.PosEslesmeOneriyle : ZO.PosEslesmeElle)).ToList();

    /// <summary>UX-S30 — geri alma düğmesi neden kapalı? (null = açık)</summary>
    private string? GeriAlKilit =>
        kaydediliyor || geriAlYukleniyor ? ZO.PosGeriAl
        : etkinEslesmeler.Count == 0 ? ZO.PosGeriAlYok
        : string.IsNullOrEmpty(geriAlEslesmeId) || etkinEslesmeler.All(x => x.Id != geriAlEslesmeId) ? ZO.PosGeriAlSecinKilit
        : geriAlGerekce.Trim().Length < 20 ? string.Format(ZO.PosGeriAlGerekceKisa, geriAlGerekce.Trim().Length)
        : null;

    private async Task GeriAlAc(Kuyumcu.Web.Servisler.PosTahsilatSatir t)
    {
        if (!GeriAlmaYetkisi) return;
        geriAlAdayi = t;
        geriAlGerekce = "";
        geriAlEslesmeId = null;
        geriAlHata = null;
        etkinEslesmeler = [];
        hata = null; basari = null;
        geriAlYukleniyor = true;
        try
        {
            var l = await PosApi.EslesmeleriGetir(t.Id);
            etkinEslesmeler = l.Kayitlar.Where(x => !x.GeriAlindi).ToList();
        }
        // UX-S28: hata "geri alınacak eşleşme yok"a çevrilmez.
        catch (ApiHata ex) { geriAlHata = ex.Message; }   // liste try öncesi boşaltıldı (P-11 sayacı)
        geriAlYukleniyor = false;
    }

    private void GeriAlKapat()
    {
        geriAlAdayi = null;
        etkinEslesmeler = [];
        geriAlHata = null;
    }

    private async Task GeriAlUygula()
    {
        if (geriAlAdayi is null || GeriAlKilit is not null) return;
        var secilen = etkinEslesmeler.First(x => x.Id == geriAlEslesmeId);
        kaydediliyor = true;
        geriAlHata = null;
        try
        {
            var s = await PosApi.EslesmeGeriAl(secilen.Id, geriAlGerekce.Trim());
            // UX-S27: sunucunun sonucu + geri alınan tutar banda yazılır.
            basari = string.Format(ZO.PosGeriAlSonuc, s.Mesaj ?? ZO.PosGeriAl,
                Bicim.Para(secilen.EslesenTutar, geriAlAdayi.ParaBirimi));
            GeriAlKapat();
            adayAnahtari++;          // KESIF-P1: aday listesi taze çekilsin (serbest kalan yatma görünür)
            await Yukle();
        }
        catch (ApiHata ex) { geriAlHata = ex.Message; }
        kaydediliyor = false;
    }

    /// <summary>KESIF-P1: eşleştirme seçicisinin kimliği — değişince seçici yeniden kurulur.</summary>
    private int adayAnahtari;

    private async Task DurumDegisti(string? v)
    {
        durum = v ?? "";
        await Yukle();
    }
    /// <summary>Birincil eşleştir düğmesi — tek tanım, tek yerde çizilir (öneri yokken üstte, varken listenin altında).</summary>
    private RenderFragment EslestirDugmesi => @<button @onclick="EslestirUygula" class="dugme dugme-birincil" id="pos-eslestir-uygula"
                            disabled="@(!EslestirilebilirMi)"
                            aria-disabled="@(EslestirilebilirMi ? "false" : "true")"
                            title="@(EslestirKilit ?? Dil.T.Pos.Eslestir)"
                            >@Dil.T.Pos.Eslestir</button>;

    private bool EslestirilebilirMi => HareketVerildi && oneri is not null && secilenler.Count > 0 && Fazla == 0m;
    private bool IptalEdilebilir => !kaydediliyor && iptalGerekce.Trim().Length >= 20;

    protected override async Task OnInitializedAsync()
    {
        Dil.Degisti += Yenile;
        await Yukle();
    }

    /// <summary>ZO-ISLEM-A — defter akordeonunun son durumu (filtre değişince korunur).</summary>
    private bool defterAcik;

    private async Task Yukle()
    {
        yukleniyor = true;
        hata = null;
        try
        {
            // ŞUBE-KAPSAM-B: valör takvimi ve defter seçili şubeye göre.
            await SubeliSorgu.HazirAsync(Oturum);
            var gorunen = SubeliSorgu.Sube(Oturum);
            takvim = await PosApi.ValorTakvimi(Gunluk(bas), Gunluk(bit), gorunen);
            sayfa = await PosApi.TahsilatlariGetir(
                string.IsNullOrEmpty(durum) ? null : durum, Gunluk(bas), Gunluk(bit), CihazId, subeId: gorunen);
            veriGeldi = true;
        }
        // UX-S28: hata "kayıt yok"a çevrilmez. 29.09 (tasarım hakemi YÜKSEK): şubesi atanmamış
        // oturumda küresel şube çözümleyicisinin 403'ü (iç terimli "şube bağlamı çözülemedi")
        // yerine Hurda ile AYNI sade cümle: tek kısa sebep + ne yapılacağı (UX-S30).
        catch (ApiHata ex)
        {
            veriGeldi = false;
            hata = SubeYok && ex.StatusCode == 403 ? SubeYokMetni : ex.Message;
        }
        yukleniyor = false;
    }

    private void IptalAc(Kuyumcu.Web.Servisler.PosTahsilatSatir t)
    {
        iptalAdayi = t;
        iptalGerekce = "";
        iptalHata = null;
        hata = null; basari = null;
    }

    /// <summary>İptal penceresindeki sunucu reddi (pencere içinde gösterilir).</summary>
    private string? iptalHata;

    private async Task IptalUygula()
    {
        if (iptalAdayi is null || !IptalEdilebilir) return;
        kaydediliyor = true;
        hata = null;
        iptalHata = null;
        try
        {
            var s = await PosApi.TahsilatIptal(iptalAdayi.Id, iptalGerekce.Trim());
            basari = s.Mesaj ?? Dil.T.Pos.Kaydedildi;
            iptalAdayi = null;
            await Yukle();
        }
        catch (ApiHata ex) { iptalHata = ex.Message; }   // pencere açık kalır, sebep pencerede
        kaydediliyor = false;
    }

    private void IptalKapat() { iptalAdayi = null; iptalHata = null; }

    /// <summary>
    /// PAKET P-15 (B-25): dekont seçici bir kayıt seçti/temizledi. Seçim
    /// değişince ESKİ ÖNERİ DÜŞER — başka dekontun önerisiyle eşleştirme
    /// yapılamamalıdır (UX-S24).
    /// </summary>
    private async Task BankaHareketSecildi(string? hareketId)
    {
        bankaHareketId = hareketId ?? "";
        oneri = null;
        secilenler.Clear();
        hata = null;
        // 29.09 (tasarım hakemi YÜKSEK): "Öneri getir" ara adımı seçimle birlikte OTOMATİK
        // çalışır; düğme yenilemek için durur (kimlik pos-oto-oneri DEĞİŞMEDİ).
        if (bankaHareketId.Trim().Length > 0) await OneriGetir();
    }

    private async Task OneriGetir()
    {
        if (!HareketVerildi) return;
        kaydediliyor = true;
        hata = null;
        secilenler.Clear();
        try
        {
            oneri = await PosApi.OtoOneri(bankaHareketId.Trim());
            foreach (var r in oneri.Kayitlar) secilenler[r.PosTahsilatId] = r.Tutar;
            await AcikSatirlariYukle();
        }
        catch (ApiHata ex) { hata = ex.Message; oneri = null; }
        kaydediliyor = false;
    }

    private async Task EslestirUygula()
    {
        if (!EslestirilebilirMi) return;
        kaydediliyor = true;
        hata = null;
        try
        {
            var s = await PosApi.Eslestir(bankaHareketId.Trim(),
                secilenler.Select(x => (object)new { posTahsilatId = x.Key, tutar = x.Value }).ToList());
            // UX-S27: sunucunun döndürdüğü sonuç banda YAZILIR.
            // 28.09 (7. doğrulama, DÜŞÜK): satır sayısı etiketli ("· 1 tahsilat").
            basari = string.Format(ZO.PosEslestiSonuc, s.Mesaj, Bicim.Para(s.EslesenToplam, "TRY"), s.SatirSayisi);
            // 29.09 (tasarım hakemi YÜKSEK): seçili yatma BAYAT "kalan"ıyla ekranda kalıp yeniden
            // eşleştirmeye çağırıyordu. Seçim temizlenir; yatmanın yeni kalanı banda yazılır
            // (kalan 0 → "tamamı eşleşti"; kalan varsa yeniden seçilince sunucudan TAZE gelir).
            decimal? yeniKalan = oneri?.HareketKalan is { } hk ? hk - s.EslesenToplam : null;
            if (yeniKalan is { } yk)
                basari += " · " + (yk <= 0m ? ZO.PosTamamiEslesti : string.Format(ZO.PosKalanVar, Bicim.Para(yk, "TRY")));
            oneri = null;
            secilenler.Clear();
            bankaHareketId = "";
            await Yukle();
        }
        catch (ApiHata ex) { hata = ex.Message; }
        kaydediliyor = false;
    }

    /// <summary>UX-S31: ham veritabanı kodu ekrana basılmaz, sözlükten çevrilir.</summary>
    private string DurumMetni(string d) => d switch
    {
        "BEKLIYOR" => Dil.T.Pos.DurumBekliyor,
        "KISMI"    => Dil.T.Pos.DurumKismi,
        "YATTI"    => Dil.T.Pos.DurumYatti,
        "IPTAL"    => Dil.T.Pos.DurumIptal,
        _          => d,
    };

    private static string DurumRenk(string d) => d switch
    {
        "YATTI" => "yesil", "KISMI" => "amber", "IPTAL" => "gri", _ => "mavi",
    };

    /// <summary>Tarih süzgeci sunucuya YEREL GÜN olarak gider (K5); InvariantCulture.</summary>
    private static string? Gunluk(DateTime? t) =>
        Bicim.Makine(t);

    private static string Gun(DateTime t) =>
        Bicim.Gun(t);

    private void Yenile() => InvokeAsync(StateHasChanged);
    public void Dispose() => Dil.Degisti -= Yenile;
}
