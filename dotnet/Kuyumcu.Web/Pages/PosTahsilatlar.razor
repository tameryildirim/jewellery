@page "/pos/tahsilatlar"
@using System.Globalization
@using Kuyumcu.Web.Bilesenler.Grid
@using Kuyumcu.Core.Domain.Girdi
@inject ApiIstemci Api
@inject Kuyumcu.Web.Servisler.PosServisi PosApi
@inject DilServisi Dil
@inject OturumServisi Oturum
@implements IDisposable

@* ═══════════════════════════════════════════════════════════════════════════
   POS ALACAK DEFTERİ + VALÖR TAKVİMİ — paket 31 Faz A/B

   ⚠ pos_tahsilatlari satırı DÜZENLENEMEZ (defter). Bu yüzden ekranda
     DegismezIpucu ile gerekçe VE doğru düzeltme yolu yazılıdır; ayrıca
     iptal (chargeback) yolu gerekçeli olarak AÇIKTIR — "sunucuda uç var,
     ekranda düğme yok" kabul edilmez (UX-S25).
   ⚠ Sayılar/tarihler InvariantCulture ile biçimlenir (§6 kültür tuzağı).
   ═══════════════════════════════════════════════════════════════════════════ *@

<PageTitle>@Marka.SayfaBasligi(MenuAdlari.Icin(Dil.T).PosAlacaklari.Ad)</PageTitle>

<ErrorBoundary>
    <ChildContent>
@* PAKET YILDIZ-5B: Yıldız şemasında (BASİT + PRO) ekran = tuval Y_POSalacaklari (BİREBİR); özgün ekran (süzgeç, valör
   takvimi, eşleştirme, defter) yalnız "Tüm ayrıntılar" görünümünde (data-yz-ozgun). İptal/geri al onayları ORTAK. *@
@if (YildizMi) { <Kuyumcu.Web.Bilesenler.Yildiz.YildizListe B="@YildizBaglami" /> }
@if (YildizOzgunCiz) {
<div data-yz-ozgun="@YildizOzgunIsaret" class="dikey-bosluk">
    @* ZO-ISLEM-A 28.09 (tasarım hakemi): başlık altı açıklama YOK — aynı cümle alttaki
       kilit kutusunda tekrarlanıyordu. Durum süzgeci 5 seçenek → ortak Form/Secim
       (radyo; açılır liste bir tıklama fazla ister ve seçenekleri gizler — K22). *@
    @* ZO-ISLEM-A 28.09 (2. hakem turu, UX-S31): başlık menü / üst bar adıyla AYNI
       (tek ad, tek kaynak — Hurda ile aynı desen); BASİT'te "hakediş" jargonu yok. *@
    <SayfaBasi Anahtar="pos-tahsilatlar" Baslik="@MenuAdlari.Icin(Dil.T).PosAlacaklari.Ad">
        <Filtreler>
            <Secim ElemanId="pos-t-durum"
                   Etiket="@Dil.T.Ortak.Durum"
                   Secenekler="@DurumSecenekleri"
                   Deger="@durum" DegerChanged="DurumDegisti" />
            @* PAKET GOC-A (envanter C · pos-t-bas/bit "ters aralık boş liste, hata söylenmez"): iki ayrı Tarih →
               iki ortak Tarih (Tur=Rapor penceresi) + K8e aralık kuralı bitişin altında (gerçek Chrome: TarihAralik süzgeç satırında iki satıra kırılıyordu). id'ler korunur: pos-t-bas · pos-t-bit.
               Sunucu da aynı kuralla 400 verir (PosServisi.TahsilatListele). Geçersiz aralıkta istek ATILMAZ. *@
<Tarih ElemanId="pos-t-bas" Etiket="@Dil.T.Ortak.Baslangic" Tur="TarihTuru.Rapor"
                   Deger="@AralikBas" DegerChanged="@AralikBasDegisti" />
            <Tarih ElemanId="pos-t-bit" Etiket="@Dil.T.Ortak.Bitis" Tur="TarihTuru.Rapor" Hata="@AralikHatasi"
                   Deger="@AralikBit" DegerChanged="@AralikBitDegisti" />
        </Filtreler>
        <Eylem>
            <a class="dugme dugme-ikincil" id="pos-cihazlara-git" href="/pos">@Dil.T.Pos.Baslik</a>
        </Eylem>
    </SayfaBasi>
    @* ŞUBE-KAPSAM-B: valör takvimi ve tahsilat defteri seçili şubeye göre. *@
    <GorunumRozeti Degisti="Yukle" />

    <HataBandi Mesaj="@hata" Id="pos-t-hata" />
    <BasariBandi Mesaj="@basari" Id="pos-t-basari" />

    @if (yukleniyor)
    {
        <Yukleniyor />
    }
    else if (veriGeldi)
    {
        @* 29.09 (tasarım hakemi YÜKSEK, UX-S28/UX-S30): veri okunamadıysa takvim "ödeme yok"
           demez, eşleştirme kartı ve arama kutusu çizilmez — sebep yalnız üstteki bantta,
           TEK kez yazılır (şubesiz oturumda sade cümle, bkz. Yukle). *@
        @* ── Valör takvimi (sunucuda toplanmış; satır listesi ÇEKİLMEZ) ────── *@
        <div class="kart">
            <div class="kart-baslik"><h3>@Dil.T.Pos.ValorTakvimi</h3></div>
            @if (takvim.Count == 0)
            {
                @* SADE-1 (göz #26): takvimin boş durumu defterinkiyle BİREBİR aynı metni
                   taşıyordu (iki kopya kutu). Takvim kendi sorusunu cevaplar. *@
                <div class="kart-govde" id="pos-t-takvim-bos"><BosDurum Mesaj="@SadeSozlugu.Al(Dil.Dil).PosTakvimBos" /></div>
            }
            else
            {
                @* ZO-ISLEM-A 28.09 (2. hakem turu): 1100 px altında satır KART olur (tarih ·
                   cihaz, altında büyük KALAN, sonra diğer tutarlar etiketiyle) — bankaya ne
                   kalacağı hiçbir genişlikte kesilmez. Hücre etiketi data-etiket'ten gelir. *@
                @* PAKET GOC-A — ORTAK IZGARA (grid:pos-tahsilatlar:pos-t-valor). Tablo id'si "pos-t-valor" korunur
                   (TabloId); zo-* kart sınıfları hücrelerde aynen (ZO-ISLEM-A kart düzeni). Takvim TAMDIR → yerel sıralama. *@
                <Izgara T="Kuyumcu.Web.Servisler.PosValorSatir" Ekran="pos-tahsilatlar" GridId="pos-t-valor-liste" TabloId="pos-t-valor"
                        Kolonlar="@ValorKolonlari" Ogeler="@IzgaraYerelSiralama.Uygula(takvim, valorSira, ValorKolonlari)"
                        TabloSinif="zo-baslik-tek-satir zo-valor-tablo" Baslik="@Dil.T.Pos.ValorTakvimi" YapiskanIlkSutun="false"
                        SiralamaDegisti="@ValorSiralandi" GecerliSiralama="@valorSira" TercihIstemcisi="@PtTercih" />
            }
        </div>

        @* ── Defter ─────────────────────────────────────────────────────────── *@
        @* SADE-1 (göz #26): defter kendi başlıklı kartında durur; boş durumu da kartın
           içindedir. UX-S28: istek düştüyse (sayfa null) boş durum ÇİZİLMEZ — bant yukarıda. *@
        @* ZO-ISLEM-A (kurucu 25.09 "geçmiş kayıtlar kapalı"): defter ortak Katlanir
           akordeonunda, KAPALI gelir. Kök kimlik (pos-t-defter-kart) korundu; başlık
           kimliği akordeon sözleşmesinden gelir (pos-t-defter-kart-ac). Açık/kapalı
           durumu filtre değişince (Yukle → yeniden çizim) KAYBOLMAZ. Rozet sayısı
           yalnız istek başarılıyken yazılır (UX-S28). *@
        <Katlanir Id="pos-t-defter-kart" Baslik="@SadeSozlugu.Al(Dil.Dil).PosDefterBaslik"
                  Sayi="@(sayfa?.ToplamSatir)" Sinif="zo-gecmis"
                  BaslangictaAcik="@defterAcik" Degisti="@(v => defterAcik = v)">
        @if (sayfa is { Kayitlar.Count: 0 })
        {
            <div class="kart-govde" id="pos-t-defter-bos"><BosDurum Mesaj="@Dil.T.Pos.KayitYok" /></div>
        }
        else if (sayfa is not null)
        {
                @* ZO-ISLEM-A 28.09 (4. doğrulama, tasarım hakemi KRİTİK): 1100 px altında her
                   tahsilat bir KART (tarih · cihaz, büyük KALAN, diğer tutarlar etiketiyle,
                   durum ve eylem en altta) — 375'te yalnız tarih + kesik cihaz görünüyordu. *@
                @* PAKET GOC-A — ORTAK IZGARA (grid:pos-tahsilatlar:pos-t-defter). Defter SUNUCUDA sayfalı → sıralama
                   düğmesi YOK (sayfa içi sıralama yanıltır; envanter § G1). Tablo id'si ve zo-k-* kart sınıfları korunur. *@
                <Izgara T="Kuyumcu.Web.Servisler.PosTahsilatSatir" Ekran="pos-tahsilatlar" GridId="pos-t-defter"
                        Kolonlar="@DefterKolonlari" Ogeler="@sayfa.Kayitlar"
                        TabloSinif="zo-baslik-tek-satir zo-kart-tablo" Baslik="@SadeSozlugu.Al(Dil.Dil).PosDefterBaslik"
                        YapiskanIlkSutun="false" TercihIstemcisi="@PtTercih" />
                @if (sayfa.SinirDegdi)
                {
                    @* UX-S29: sunucu sınırı SÖYLENİR, sessiz kırpma yok. *@
                    <div class="kart-govde">
                        <p class="metin-kucuk" id="pos-t-sinir">@Dil.T.Pos.SinirUyarisi</p>
                    </div>
                }
        }
        </Katlanir>

        @* ── Faz B: banka yatması eşleştirme ────────────────────────────────── *@
        @* 29.09 (tasarım hakemi YÜKSEK, aynı sınıf): eşleştirme uçları [RolGerekli("SAHIP","MUDUR",
           "MUHASEBE")] — yetkisiz rolde (TEZGAHTAR) kart çizilirse arama kutusu ham "gerekli rol"
           metniyle düşüyordu (canlıda 403 ölçüldü). Yetkisiz rol kartı hiç görmez. *@
        @if (EslestirmeYetkisi)
        {
        <div class="kart">
            <div class="kart-baslik"><h3>@Dil.T.Pos.Eslestir</h3></div>
            <div class="kart-govde form-grid-3 zo-pos-eslestir-izgara">
                @* ── PAKET P-15 (B-25) — ULID ELLE YAZMA KALKTI ──────────────
                   Banka dekontu artık karşı taraf adı / referans / açıklama
                   ile SUNUCUDA aranır; kullanıcı ULID değil ad + tarih + tutar
                   görür. Girdi kimliği `pos-eslestir-hareket` DEĞİŞMEDİ. *@
                @* 28.09 (tasarım hakemi): "Banka hareketi kimliği" teknik adı yerine
                   kullanıcının bildiği ad. Seçici yazdıkça arar (2 karakterden sonra). *@
                @* 29.09 (tasarım hakemi KRİTİK): seçici YALNIZ POS cihazlarının hesaplarına gelen,
                   müşteriye bağlanmamış ve kalanı olan hareketleri listeler; her sonuç hesap adını
                   ve kalan tutarı yazar (sunucu aynı kuralla eşleştirmeyi de reddeder). *@
                @* KESIF-P1 · TOPLU ZO-ISLEM-A [YÜKSEK]: "Eşleşmeyi geri al" sonrası serbest kalan
                   yatma listede görünmüyordu (seçici son listeyi önbellekte tutuyordu). Geri alma
                   başarılı olunca anahtar değişir → seçici yeniden kurulur, aday listesi TAZE çekilir.
                   Boş liste metni sorgudan bağımsız: "Eşleşmemiş banka yatması bulunamadı". *@
                <KayitSecici @key="adayAnahtari" Tur="@Kuyumcu.Contracts.Arama.AramaTurleri.BankaHareket"
                             AramaYolu="@AdayYolu"
                             Gozat="true"
                             ElemanId="pos-eslestir-hareket"
                             Etiket="@ZO.PosBankaYatan"
                             Deger="@bankaHareketId"
                             AraDugmesiYok="true"
                             BosMesaj="@KesifP1Sozlugu.Al(Dil.Dil).PosBankaYatmasiYok"
                             DegerChanged="BankaHareketSecildi" />
                <div class="alan">
                    <button @onclick="OneriGetir" class="dugme dugme-ikincil" id="pos-oto-oneri"
                            disabled="@(!HareketVerildi)"
                            aria-disabled="@(HareketVerildi ? "false" : "true")"
                            title="@(HareketVerildi ? Dil.T.Pos.OtoOneri : ZO.PosOnceHareketSec)"
                            >@Dil.T.Pos.OtoOneri</button>
                </div>
                @* 28.09 (7. doğrulama, DÜŞÜK): elle seçim listesi açıkken birincil düğme listenin
                   ve "Seçilen … · bankaya yatan …" özetinin ALTINDA durur (375'te işaretledikten
                   sonra yukarı kaydırmak gerekmesin). Kimlik tek yerde çizilir, DEĞİŞMEDİ. *@
                @if (oneri is null)
                {
                    <div class="alan">@EslestirDugmesi</div>
                }
            </div>
            @* 28.09 (tasarım hakemi, UX-S30): kilitli düğmelerin SEBEBİ görünür yazılır —
               "Öneri getir" boşken sessiz kalmaz. *@
            @if (EslestirKilit is { } ek && !ElleBekliyor && oneri is null)
            {
                <div class="kart-govde zo-kilit-sebep">
                    <p class="metin-kucuk metin-soluk" id="pos-eslestir-kilit">@ek</p>
                </div>
            }
            @if (oneri is { } o)
            {
                @* ZO-ISLEM-A 28.09 (tasarım hakemi KRİTİK): öneri bulunamayınca mesaj TEK kez
                   yazılır ve GERÇEK yolu söyler; aynı kartta bekleyen tahsilatlar işaretlenerek
                   ELLE eşleştirilir (sunucu /pos/eslestir "satirlar"ı zaten alıyordu). Öneri
                   bulunduysa önerilen satırlar işaretli gelir; kullanıcı düzeltebilir. *@
                <div class="kart-govde zo-pos-elle">
                    @if (!o.Bulundu)
                    {
                        <p class="metin-kucuk" id="pos-oneri-yok">@ZO.PosOneriYokElle</p>
                    }
                    else
                    {
                        <p class="metin-kucuk" id="pos-oneri-toplam">
                            @Dil.T.Pos.Net: @Bicim.Para(o.Toplam, "TRY") · @o.Kayitlar.Count
                        </p>
                    }
                    <fieldset class="zo-pos-elle-liste" id="pos-elle">
                        <legend class="metin-kucuk">@ZO.PosElleBaslik</legend>
                        @if (acikHata is { Length: > 0 } ah)
                        {
                            <HataBandi Mesaj="@ah" Id="pos-elle-hata" />
                        }
                        else if (acikSatirlar.Count == 0)
                        {
                            <p class="metin-kucuk metin-soluk" id="pos-elle-bos">@ZO.PosElleAcikYok</p>
                        }
                        else
                        {
                            @foreach (var t in acikSatirlar)
                            {
                                <Onay ElemanId="@($"pos-elle-{t.Id}")"
                                      Etiket="@($"{Gun(t.ValorTarihi)} · {t.CihazAd} · {Bicim.Para(t.KalanTutar, t.ParaBirimi)}")"
                                      Deger="@secilenler.ContainsKey(t.Id)"
                                      DegerChanged="@((bool v) => ElleSec(t, v))" />
                                @if (secilenler.TryGetValue(t.Id, out var st) && st < t.KalanTutar)
                                {
                                    <p class="metin-kucuk metin-soluk" id="@($"pos-elle-kismi-{t.Id}")">@string.Format(ZO.PosElleKismi, Bicim.Para(st, t.ParaBirimi))</p>
                                }
                            }
                            @if (acikSinirDegdi)
                            {
                                <p class="metin-kucuk" id="pos-elle-sinir">@Dil.T.Pos.SinirUyarisi</p>
                            }
                        }
                    </fieldset>
                    <p class="metin-kucuk" id="pos-elle-toplam">
                        @string.Format(ZO.PosElleSecilen, Bicim.Para(SecilenToplam, "TRY"),
                            o.HareketKalan is { } hk ? Bicim.Para(hk, "TRY") : "—")
                    </p>
                    @if (EslestirKilit is { } ek2 && !ElleBekliyor)
                    {
                        <p class="metin-kucuk metin-soluk" id="pos-eslestir-kilit">@ek2</p>
                    }
                    <div class="zo-pos-elle-eylem">@EslestirDugmesi</div>
                </div>
            }
        </div>
        }

        @* UX-S25: defter satırı neden düzenlenemez + doğru düzeltme yolu. *@
        @* 28.09 (tasarım hakemi): kutu TEK sade cümle ("uç", "≥ 20 karakter" ve
           "Düzeltme" tekrarı kalktı). *@
        <DegismezIpucu Varlik="PosTahsilat" Gerekce="@ZO.PosKilitNotu" />
    }
</div>
}

@* ── İptal (chargeback) onayı — geri alınamaz, önce onay ─────────────────── *@
<ModalPencere Acik="@(iptalAdayi is not null)" Baslik="@Dil.T.Pos.Iptal"
              Kapat="IptalKapat">
    <p id="pos-iptal-onay-metin">@Dil.T.Pos.IptalOnay</p>
    @* 29.09 (doğrulayıcı ORTA): sunucu reddi pencerenin İÇİNDE görünür — sayfa bandı perdenin
       arkasında kalıyordu (sessiz tıklama). Geri alma penceresiyle aynı kalıp. *@
    <HataBandi Mesaj="@iptalHata" Id="pos-iptal-hata" />
    <div class="alan">
        @* PAKET GOC-A: kural doğru (envanter TAM — K30 20–1000); ZO-ISLEM-A'nın alan altı cümlesi korunur, üst sınır
           sunucuyla AYNI sabitten (AlanSinirlari.GerekceEnCok). GerekceAlani'na taşınmadı: onaylı alan altı metni ve
           kilit satırı (tasarım hakemi 28.09) sayaçlı kalıpta kaybolurdu — sapma raporda. *@
        <CokSatir ElemanId="pos-iptal-gerekce" Etiket="@Dil.T.Pos.IptalGerekcesi" Zorunlu="true"
                  Satir="3" EnFazla="@AlanSinirlari.GerekceEnCok"
                  Deger="@iptalGerekce" DegerChanged="@(v => iptalGerekce = v ?? "")"
                  Hata="@(iptalGerekce.Trim().Length is > 0 and < AlanSinirlari.GerekceEnAz ? Dil.T.Pos.IptalGerekcesi : null)" />
    </div>
    @* ZO-ISLEM-A 28.09 (2. hakem turu): ortak onay düzeni (OnayKipi ile aynı) —
       solda "Vazgeç", sağda kırmızı eylem; vazgeç düğmesi "İptal" ADINI TAŞIMAZ
       (başlık ve eylem "Tahsilatı iptal et"). Kimlikler DEĞİŞMEDİ. *@
    <div class="satir">
        <button type="button" @onclick="IptalKapat" class="btn btn-ikincil esit-pay" id="pos-iptal-vazgec"
                >@ZO.Vazgec</button>
        <button type="button" @onclick="IptalUygula" class="btn btn-tehlike esit-pay" id="pos-iptal-onayla"
                disabled="@(!IptalEdilebilir)"
                aria-disabled="@(IptalEdilebilir ? "false" : "true")"
                title="@(IptalEdilebilir ? Dil.T.Pos.Iptal : Dil.T.Pos.IptalGerekcesi)"
                >@Dil.T.Pos.Iptal</button>
    </div>
</ModalPencere>

@* ── 28.09 (7. doğrulama, KRİTİK): eşleşmeyi geri alma onayı ────────────────
   Yanlış eşleştirme ekrandan düzeltilir (UX-S25; DoD EK 4 "yıkıcı eylem + geri
   dönüş yolu"): etkin eşleşmeler GET /pos/tahsilatlar/{id}/eslesmeler ile gelir,
   tek eşleşme varsa seçici çizilmez (UX-S22, Secim tek seçenek), gerekçe ≥ 20
   karakter, POST /pos/eslesmeler/{id}/geri-al. Kayıt SİLİNMEZ (append-only);
   geri dönüş yolu aynı ekranda yeniden eşleştirmedir. *@
<ModalPencere Acik="@(geriAlAdayi is not null)" Baslik="@ZO.PosGeriAl"
              Kapat="GeriAlKapat">
    <p id="pos-geri-al-metin">@ZO.PosGeriAlOnay</p>
    <HataBandi Mesaj="@geriAlHata" Id="pos-geri-al-hata" />
    @if (geriAlYukleniyor)
    {
        <Yukleniyor />
    }
    else if (geriAlHata is null && etkinEslesmeler.Count == 0)
    {
        <p class="metin-kucuk metin-soluk" id="pos-geri-al-bos">@ZO.PosGeriAlYok</p>
    }
    else if (etkinEslesmeler.Count > 0)
    {
        <div class="alan">
            <Secim ElemanId="pos-geri-al-secim" Etiket="@ZO.PosGeriAlSecim" Zorunlu="true"
                   Secenekler="@EslesmeSecenekleri"
                   Deger="@geriAlEslesmeId" DegerChanged="@(v => geriAlEslesmeId = v)" />
        </div>
        <div class="alan">
            <CokSatir ElemanId="pos-geri-al-gerekce" Etiket="@ZO.PosGeriAlGerekce" Zorunlu="true"
                      Satir="3" EnFazla="@AlanSinirlari.GerekceEnCok"
                      Deger="@geriAlGerekce" DegerChanged="@(v => geriAlGerekce = v ?? "")"
                      Hata="@(geriAlGerekce.Trim().Length is > 0 and < AlanSinirlari.GerekceEnAz ? string.Format(ZO.PosGeriAlGerekceKisa, geriAlGerekce.Trim().Length) : null)" />
        </div>
    }
    @* Kısa gerekçe alan altında zaten yazılı → sebep satırı aynı cümleyi TEKRARLAMAZ (10. tur gerçek tarayıcı). *@
    @if (GeriAlKilit is { } gk && !geriAlYukleniyor && etkinEslesmeler.Count > 0 && geriAlGerekce.Trim().Length is not (> 0 and < 20))
    {
        <p class="metin-kucuk metin-soluk" id="pos-geri-al-kilit">@gk</p>
    }
    <div class="satir zo-onay-dugmeler">
        <button type="button" @onclick="GeriAlKapat" class="btn btn-ikincil esit-pay" id="pos-geri-al-vazgec"
                >@ZO.Vazgec</button>
        <button type="button" @onclick="GeriAlUygula" class="btn btn-tehlike esit-pay" id="pos-geri-al-onayla"
                disabled="@(GeriAlKilit is not null)"
                aria-disabled="@(GeriAlKilit is null ? "false" : "true")"
                title="@(GeriAlKilit ?? ZO.PosGeriAl)"
                >@ZO.PosGeriAl</button>
    </div>
</ModalPencere>
    </ChildContent>
    <ErrorContent>
        <KabukHatasi />
    </ErrorContent>
</ErrorBoundary>

@code {
    // ── P-36c GÖÇ YARDIMCISI ────────────────────────────────────────────
    private IReadOnlyList<SecenekOgesi> DurumSecenekleri =>
    [
        new SecenekOgesi("", Dil.T.Pos.TumDurumlar),
        new SecenekOgesi("BEKLIYOR", Dil.T.Pos.DurumBekliyor),
