    private GorselSigmaMetinleri GS => GorselSigmaSozlugu.Al(Dil.Dil);

    /// <summary>Kasa kimliği → görünen gün sayısı. Yeni sorguda sıfırlanır.</summary>
    private readonly Dictionary<string, int> gorunenGun = new(StringComparer.Ordinal);

    private int GorunenSayi(KasaDefteriSatiri kasa) =>
        gorunenGun.TryGetValue(kasa.KasaId, out var n) ? n : GorselSigmaSozlugu.KasaIlkGun;

    /// <summary>En YENİ n gün, sunucunun sırası korunarak.</summary>
    internal IEnumerable<KasaGunu> GorunenGunler(KasaDefteriSatiri kasa)
    {
        var tum = kasa.Gunler ?? [];
        var n = GorunenSayi(kasa);
        if (tum.Count <= n) return tum;
        var enYeni = tum.Select(g => g.Tarih).OrderByDescending(t => t, StringComparer.Ordinal)
            .Take(n).ToHashSet(StringComparer.Ordinal);
        return tum.Where(g => enYeni.Contains(g.Tarih));
    }

    private int GizliGunSayisi(KasaDefteriSatiri kasa) =>
        Math.Max(0, (kasa.Gunler?.Count ?? 0) - GorunenSayi(kasa));

    private string GunBilgisi(KasaDefteriSatiri kasa) => GizliGunSayisi(kasa) > 0
        ? string.Format(GS.KasaGunBilgisi, GorunenSayi(kasa), kasa.Gunler?.Count ?? 0)
        : GS.KasaTumGunler + " · " + string.Format(GS.ToplamKayit, kasa.Gunler?.Count ?? 0);

    private void DahaFazlaGun(KasaDefteriSatiri kasa) =>
        gorunenGun[kasa.KasaId] = GorunenSayi(kasa) + GorselSigmaSozlugu.KasaIlkGun;

