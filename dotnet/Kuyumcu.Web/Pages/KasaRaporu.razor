    /// <summary>ZO-BELGE 29.09 (tasarım hakemi YÜKSEK): sunucunun gün anahtarı ("2026-09-23")
    /// ekrana HAM basılmaz — Bicim merkezinden yerel tarih ("23.09.2026"). Anahtar ayrıştırılamazsa
    /// uydurulmaz, olduğu gibi yazılır (Anayasa md.1). Karşılaştırmalar ham anahtarla sürer.</summary>
    internal string GunMetni(string? anahtar) =>
        DateOnly.TryParseExact(anahtar, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var g)
            ? Bicim.Gun(g)   // TOPLU-1 tur 2 (TARIH-TEK): takvim günü ÇEVRİLMEZ, tek kalıp dd.MM.yyyy
                             // (eski: Local'a damgalanıp saat dilimi çevriliyor, kültürün "d"si "1.10.2026" basıyordu).
            : anahtar ?? "—";

    private static string BugunAnahtar => Bicim.Makine(Bicim.IsletmeBugun);

    private async Task SayimAc(KasaDefteriSatiri kasa)
    {
        sayimHata = null;
        sayimForm.Temizle();
        sayimKasa = kasa;
        // Alan BOŞ (0) başlar: defter bakiyesiyle doldurulsaydı kullanıcı saymadan
        // kaydeder ve fark hiç görünmezdi (Kasalar.razor ile AYNI gerekçe).
        sayimTutar = null;
        sayimAciklama = null;
        sayimOnizleme = null;
        sayimOnizlemeHata = null;
        // UX-S28: hata "0 TL"ye çevrilmez — bant görünür, kayıt kilitli.
        try { sayimOnizleme = await Api.GetAsync<Kuyumcu.Contracts.Sayfalar.Kasalar.GunKapanisiOnizleme>($"/kasalar/{kasa.KasaId}/gun-kapanisi/onizleme"); }
        catch (ApiHata ex) { sayimOnizlemeHata = ex.Message; }
        catch (System.Text.Json.JsonException ex) { sayimOnizlemeHata = ex.Message; }   // okunamayan yanıt da "0 TL" sayılmaz
    }

    private async Task SayimKaydet()
    {
        if (sayimKasa is not { } sk) return;
        sayimHata = null;
        sayimForm.Temizle();
        // PARA-DEMO: nakit defteri bilinmeden sayım kaydedilmez (sessiz etkisizlik değil — bant yazılı).
        if (sayimOnizleme is null)
        {
            sayimHata = PD.OnizlemeKilit;
            return;
        }
        // Sessiz etkisizlik yasak: negatif/boş gönderim alan altı mesaj verir.
        // ZO-BELGE: alan artık BOŞ başlar (null); boş gönderim "0" sayılmaz —
        // sayılmamış kasa sıfır sayılmış gibi kapanmaz (Anayasa md.1).
        if (sayimTutar is not { } tutar)
        {
            sayimForm.Ekle("kr-sayim-tutar", ZB.KasaSayimZorunlu);
            return;
        }
        if (tutar < 0m)
        {
            sayimForm.Ekle("kr-sayim-tutar", Dil.T.RaporSeti.SayimNegatif);
            return;
        }
        // PAKET GOC-A: fark varken K30 gerekçe kuralı istekten ÖNCE (sunucu AYNI cümleyle reddeder).
        if (SayimFarkVar(sk) && SayimGerekceHatasi is { } gerekceHatasi)
        {
            sayimForm.Ekle("kr-sayim-aciklama", gerekceHatasi);
            return;
        }
        sayimKaydediliyor = true;
        try
        {
            // UX-S27: POST yanıtı OKUNUR ve sonucu banda yazılır.
            var yanitJson = await Api.PostAsync($"/kasalar/{sk.KasaId}/gun-kapanisi", new
            {
                sayilanNakit = tutar,
                aciklama = string.IsNullOrWhiteSpace(sayimAciklama) ? null : sayimAciklama.Trim(),
            });
            var fark = yanitJson.TryGetProperty("fark", out var fo) && fo.ValueKind
                is System.Text.Json.JsonValueKind.Number ? fo.GetDecimal() : (decimal?)null;
            basariMesaj = fark is { } fd
                ? string.Format(CultureInfo.InvariantCulture, Dil.T.RaporSeti.SayimKaydedildiFark,
                                Bicim.Para(fd, sk.ParaBirimi))
                : Dil.T.RaporSeti.SayimKaydedildi;
            basariJeton++;
            sayimKasa = null;
            await Yukle(ozetTazele: true);
        }
        catch (ApiHata ex)
        {
            sayimHata = FormDurumu.SunucuMesaji(ex, Dil);
            sayimForm.Sunucudan(ex, new Dictionary<string, string>
            {
                ["SayilanNakit"] = "kr-sayim-tutar",
                ["Aciklama"] = "kr-sayim-aciklama",
            });
        }
        finally { sayimKaydediliyor = false; }
    }

    /// <summary>UX-S31: ham durum kodu ekrana basılmaz, sözlükten çevrilir.</summary>
    private string DurumMetni(string? durum) => durum switch
    {
        "KAPALI" => Dil.T.RaporSeti.DurumKapali,
        "YENIDEN_ACILDI" => Dil.T.RaporSeti.DurumYenidenAcildi,
        _ => Dil.T.RaporSeti.DurumAcik,
    };

    private void Yenile() => InvokeAsync(StateHasChanged);
    public void Dispose() => Dil.Degisti -= Yenile;
