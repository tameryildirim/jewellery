            <button id="uy-kapatma-onayla" class="dugme dugme-birincil"
                    disabled="@(kaydediliyor)" @onclick="KapatmaOnayla">@Dil.T.Ortak.Kaydet</button>
        </div>
    </div>
</ModalPencere>
</CascadingValue>

@code {
    /// <summary>ORTAK-1 (KEŞİF #4): ortak geçersiz sayı kapısı — "1.500" gibi anlaşılamayan sayı varken ilgili formun Kaydet'i PASİF, gövdeye 0/eski değer GİTMEZ.</summary>
    private GecersizAlanKapisi? _sayiKapisi;
    private GecersizAlanKapisi sayiKapisi => _sayiKapisi ??= new(() => InvokeAsync(StateHasChanged));
    // ── P-36c GÖÇ YARDIMCILARI ──────────────────────────────────────────
    private IReadOnlyList<SecenekOgesi> SupheliDurumSecenekleri =>
    [
        new SecenekOgesi("ACIK", Dil.T.Uyum.DurumAcik),
        new SecenekOgesi("GONDERILDI", Dil.T.Uyum.DurumGonderildi),
        new SecenekOgesi("KAPATILDI", Dil.T.Uyum.DurumKapatildi),
    ];

    private IReadOnlyList<SecenekOgesi> RiskCariSecenekleri =>
        [.. riskCariler.Select(c => new SecenekOgesi(
            c.Id,
            c.RiskSeviye is null ? c.Ad : $"{c.Ad} · {Dil.T.Uyum.SeviyeAdi(c.RiskSeviye)}"))];

    private string RiskCariBosMetni => $"— {Dil.T.Uyum.RiskCariSec} —";

    // ── PAKET ORTAK-1 (G): risk sekmesi BASİT modda "cari" demez ─────────
    // Tam tur v3 (K8): BASİT modda "cari, cariler" 12 durumda görünüyordu.
    // Basit metin ORTAK-1 sözlüğünden (Sozlukler.OrtakGorunum.cs) okunur;
    // PROFESYONEL mod Dil.T.Uyum metnini (muhasebe dili) AYNEN korur.
    private RiskMetinleri RiskMetin => Dil.BasitMi
        ? new(OrtakGorunumSozlugu.Al(Dil.Dil))
        : new(Dil.T.Uyum);

    private readonly struct RiskMetinleri
    {
        public RiskMetinleri(OrtakGorunumMetinleri b)
        {
            PepSayisi = b.UyumPepSayisiBasit; Profilsiz = b.UyumProfilsizBasit;
            YuksekRiskliler = b.UyumYuksekRisklilerBasit; YuksekRiskliYok = b.UyumYuksekRiskliYokBasit;
            ProfilTarihceYok = b.UyumProfilTarihceYokBasit; RiskListeSiniri = b.UyumRiskListeSiniriBasit;
        }
        public RiskMetinleri(SozlukUyum p)
        {
            PepSayisi = p.PepSayisi; Profilsiz = p.Profilsiz;
            YuksekRiskliler = p.YuksekRiskliler; YuksekRiskliYok = p.YuksekRiskliYok;
            ProfilTarihceYok = p.ProfilTarihceYok; RiskListeSiniri = p.RiskListeSiniri;
        }
        public string PepSayisi { get; }
        public string Profilsiz { get; }
        public string YuksekRiskliler { get; }
        public string YuksekRiskliYok { get; }
        public string ProfilTarihceYok { get; }
        public string RiskListeSiniri { get; }
    }

    private enum Sekme { Tespit, Supheli, Saklama, Risk, Nakit }   // Nakit: PAKET YASAL-2 (TB-16)

    /// <summary>PAKET YASAL-2: "?sekme=" derin bağlantısı (Panel "nakit sınırı" satırı, bildirim rotası).</summary>
    [SupplyParameterFromQuery(Name = "sekme")] public string? SekmeSorgusu { get; set; }

    /// <summary>Sunucunun KapatDto kuralı (MinLength 20) ile aynı.</summary>
    private const int AsgariKapatma = 20;

    /// <summary>MASAK Rehber 2.0 §4.2.7 — sunucu da bu sınırı uygular.</summary>
    private const int AsgariGerekce = 300;

    private Sekme sekme = Sekme.Tespit;
    private bool yukleniyor = true;
    private bool kaydediliyor;
    private string? hata;
    private string? basari;

    private MasakOzet? ozet;
    // ── PAKET GOC-B — ortak ızgara kolonları (başlıklar sözlükten; anahtarlar kalıcı) ─────────────
    private IzgaraSiralama? tespitSira, supheliSira, tarihceSira, yuksekSira;
    private const int TespitSiniri = 100, SupheliSiniri = 500, TarihceSiniri = 10;
    private bool TespitTam => tespitler.Count < TespitSiniri;
    private bool SupheliTam => supheliler.Count < SupheliSiniri;
    private bool TarihceTam => (riskProfil?.Tarihce.Count ?? 0) < TarihceSiniri;
    private bool YuksekTam => riskOzet is null || riskOzet.YuksekRiskliler.Count < riskOzet.ListeSiniri;

    /// <summary>UX-S31: şüpheli bildirim durumunun sözlük adı (ham kod ekrana basılmaz).</summary>
    private string SupheliDurumAdi(string d) => d switch
    {
        "ACIK" => Dil.T.Uyum.DurumAcik, "GONDERILDI" => Dil.T.Uyum.DurumGonderildi, "KAPATILDI" => Dil.T.Uyum.DurumKapatildi, _ => d,
    };

    private IReadOnlyList<IzgaraKolonu<KimlikTespitSatir>> TespitKolonlari =>
    [
        new() { Anahtar = "tarih", Baslik = Dil.T.Uyum.Tarih, ZorunluGorunur = true, SunucuSiralamaAdi = TespitTam ? "tarih" : null,
                HucreSinif = _ => "hucre-tek-satir", Deger = t => t.Tarih, Hucre = t => @<text>@Zaman(t.Tarih)</text> },
        new() { Anahtar = "ad", Baslik = Dil.T.Uyum.AdSoyad, ZorunluGorunur = true, SunucuSiralamaAdi = TespitTam ? "ad" : null, Deger = t => t.AdSoyad },
        new() { Anahtar = "belge-turu", Baslik = Dil.T.Uyum.BelgeTuru, HucreSinif = _ => "metin-kucuk",
                Deger = t => Dil.T.SayfaDuzeltme.BelgeTuruAdi(t.BelgeTuru) },
        new() { Anahtar = "belge-no", Baslik = Dil.T.Uyum.BelgeNo, Deger = t => t.BelgeNo, Hucre = t => @<code>@t.BelgeNo</code> },
        new() { Anahtar = "tutar", Baslik = Dil.T.Uyum.IslemTutari, ZorunluGorunur = true, SunucuSiralamaAdi = TespitTam ? "tutar" : null,
                Tur = IzgaraHucreTuru.Para, ParaBirimi = _ => "TRY", BaslikSinif = "sayi", HucreSinif = _ => "sayi", Deger = t => t.IslemTutariTl },
        new() { Anahtar = "saklama", Baslik = Dil.T.Uyum.SaklamaBitis, HucreSinif = _ => "metin-kucuk",
