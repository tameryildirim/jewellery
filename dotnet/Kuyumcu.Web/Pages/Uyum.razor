    /// <summary>Şüpheli bildirim satır eylemleri (eski tablo hücresi birebir; id'ler korunur).</summary>
    private RenderFragment<SupheliSatir> SupheliEylemleri => s => @<text>@if (s.Durum == "ACIK")
        {
            @if (Oturum.Kullanici?.Rol is "SAHIP" or "MUDUR")
            {
                @* D1-18: MASAK Online formuna kopyalanacak alanlar (yazılım gönderemez — yol yok). *@
                <button id="@($"uy-hazirla-{s.Id}")" class="dugme dugme-kucuk dugme-ikincil" @onclick="() => sibHazirlikId = s.Id">@Kuyumcu.Core.I18n.D1Sozlugu.Al(Dil.Dil).SibHazirla</button>
            }
            <button id="@($"uy-gonderildi-{s.Id}")" class="dugme dugme-kucuk" @onclick="() => GonderimAc(s)">@Dil.T.Uyum.GonderildiIsaretle</button>
            <button id="@($"uy-kapat-{s.Id}")" class="dugme dugme-kucuk dugme-ikincil" @onclick="() => KapatmaAc(s)">@Dil.T.Uyum.Kapat</button>
        }
        else if (!string.IsNullOrEmpty(s.GonderimReferansi))
        {
            <span class="metin-kucuk metin-soluk">@s.GonderimReferansi</span>
        }
        @* PAKET P-13 · B-12: gönderilmiş bildirimin gerçek düzeltme yolu EK BEYANDIR. *@
        @if (s.Durum == "GONDERILDI" && s.DuzeltilenBildirimId is null)
        {
            <button id="@($"uy-ek-beyan-{s.Id}")" class="dugme dugme-kucuk" @onclick="() => EkBeyanAc(s)">@Dil.T.Uyum.EkBeyan</button>
        }
        @if (s.DuzeltilenBildirimId is not null)
        {
            <span class="rozet rozet-mavi" id="@($"uy-ek-beyan-rozet-{s.Id}")">@Dil.T.Uyum.EkBeyanRozet</span>
        }
        @* UX-S25: tutar/gerekçe sonradan DEĞİŞTİRİLEMEZ; gerekçe + duruma göre doğru düzeltme yolu. *@
        <DegismezIpucu Varlik="@($"MasakSupheliBildirim-{s.Id}")"
                       Gerekce="@Dil.T.Duzeltme.MasakGerekce"
                       AlternatifYol="@(s.Durum == "GONDERILDI" ? Dil.T.Uyum.GonderildiDuzeltmeYolu : Dil.T.SayfaDuzeltme.BildirimDuzeltmeYolu)" /></text>;

    private List<KimlikTespitSatir> tespitler = [];
    private List<SupheliSatir> supheliler = [];
    private SaklamaOnizleme? saklama;

    private KimlikTespitDetay? tespitDetay;
    private bool supheliFormAcik;
    private decimal? yeniTutar;
    private string? yeniHareketId;

    /// <summary>
    /// PAKET P-15 (B-25): defter satırı seçici bir kayıt seçti/temizledi.
    /// Alan İSTEĞE BAĞLIDIR; null = dayanak verilmedi (sunucu sözleşmesi aynı).
    /// </summary>
    private void HareketSecildi(string? hareketId) => yeniHareketId = hareketId;
    private string? yeniGerekce;
    private string supheliFiltre = "";
    private string araBelgeNo = "";
    private BelgeAramaSonucu? aramaSonucu;
    private SupheliSatir? gonderimHedef, kapatmaHedef;
    private bool gonderimAcik, kapatmaAcik, gonderimDenendi, kapatmaDenendi;
    private string? gonderimReferansi, kapatmaGerekcesi;
    private bool saklamaOnaylandi;

    // ── PAKET 40-A — risk sekmesi durumu ────────────────────────────────────
    /// <summary>Cari seçicisinin sunucu sınırı — ekranda YAZILIR (UX-S29).</summary>
    private const int RiskCariSiniri = 200;

    /// <summary>
    /// Elle ezme gerekçesinin asgarisi. Sunucu da AYNI sınırı uygular
    /// (MasakRiskAyarlari.ElleGerekceAsgari) ve son sözü o söyler; ekran yalnız
    /// kullanıcıyı boşa göndermez.
    /// </summary>
    private int RiskGerekceAsgari => riskProfil?.GerekceAsgari ?? 20;

    private RiskOzet? riskOzet;
    private List<RiskCariSecenek> riskCariler = [];
    private RiskProfilYaniti? riskProfil;
    private string riskCariId = "";
    private bool riskElleAcik;
    private string riskElleSeviye = "ORTA";
    private string? riskGerekce;
    private string? riskElleHata;

    private bool RiskElleGecerli => (riskGerekce?.Trim().Length ?? 0) >= RiskGerekceAsgari;

    private System.Globalization.CultureInfo Kultur => new(Dil.Locale);
    // P-36b: biçim TEK yerden — Servisler/Bicim.cs. Çıktı birebir aynı.
    private string Para(decimal d) => Bicim.BelgeParasi(d, Dil.Locale);
    private string Zaman(DateTime t) => Bicim.TarihSaat(t);

    private bool BildirimGecerli => !sayiKapisi.OnekleVar("sb-tutar") &&   // ORTAK-1
        yeniTutar is > 0 && (yeniGerekce?.Trim().Length ?? 0) >= AsgariGerekce;

    private static string Kisalt(string metin) =>
        metin.Length <= 60 ? metin : metin[..60] + "…";

    protected override void OnInitialized() => Dil.Degisti += Yenile;
    public void Dispose() => Dil.Degisti -= Yenile;
    private void Yenile() => InvokeAsync(StateHasChanged);

    protected override Task OnInitializedAsync()
    {
        // PAKET S1-i: ?sekme= derin bağlantısı (Sekmeler ile AYNI kaynak: URL).
        if ((SekmeSorgusu ?? DerinBaglanti.Oku(Nav.Uri, "sekme")) is { } k && UySekmeleri.Any(x => x.Kod == k)) sekme = Durum(k);
        return Yukle();
    }

    // ── PAKET S1-i — ortak Sekmeler ──
    private GorselSigmaMetinleri GS => GorselSigmaSozlugu.Al(Dil.Dil);

    private IReadOnlyList<SekmeTanimi> UySekmeleri =>
    [
        new("tespit", Dil.T.Uyum.KimlikTespitleri),
        new("supheli", Dil.T.Uyum.SupheliIslemler,
            ozet is { AcikBildirim: > 0 } ? ozet.AcikBildirim.ToString(System.Globalization.CultureInfo.InvariantCulture) : null, "amber"),
        // KESIF-P6 (#72 alt): saklama uçlarının HEPSİ [RolGerekli("SAHIP")] — MÜDÜR'e sekme çizilseydi
        // tıklanınca yalnız 403 bandı görürdü. Sekme yalnız SAHİP'te doğar; kapı yine sunucudadır.
        .. (SahipMi ? new SekmeTanimi[] { new("saklama", Dil.T.Uyum.SaklamaSuresi) } : []),
        new("risk", Dil.T.Uyum.RiskSekmesi,
            riskOzet is { Yuksek: > 0 } ? riskOzet.Yuksek.ToString(System.Globalization.CultureInfo.InvariantCulture) : null, "kirmizi"),
        new("nakit", TevsikTaksitSozlugu.Al(Dil.Dil).SekmeAdi),   // PAKET YASAL-2 (TB-16)
    ];

    /// <summary>KESIF-P6: saklama yönetimi yalnız SAHİP'in (sunucu kapısıyla aynı rol).</summary>
    private bool SahipMi => Oturum.Kullanici?.Rol == "SAHIP";
    private string? sibHazirlikId;   // D1-18
    /// <summary>D1-18 — bu yılın başından bugüne (işletme saati) uyum raporu.</summary>
    private static string UyumRaporuAdresi
    {
        get
        {
            var bugun = DateOnly.FromDateTime(Bicim.IsletmeZamani(DateTime.UtcNow));
            return $"/cikti/UYUM_RAPORU/{Bicim.Makine(new DateOnly(bugun.Year, 1, 1))}_{Bicim.Makine(bugun)}";
        }
    }

    private static Sekme Durum(string kod) => kod switch
    {
        "supheli" => Sekme.Supheli,
        "saklama" => Sekme.Saklama,
        "risk" => Sekme.Risk,
        "nakit" => Sekme.Nakit,
        _ => Sekme.Tespit,
    };

    private static string Kod(Sekme s) => s switch
    {
        Sekme.Supheli => "supheli",
        Sekme.Saklama => "saklama",
        Sekme.Risk => "risk",
        Sekme.Nakit => "nakit",
        _ => "tespit",
    };

    private Task UySekmeDegisti(string kod) => Durum(kod) == sekme ? Task.CompletedTask : SekmeSec(Durum(kod));

    /// <summary>Sayfa başındaki birincil eylem: şüpheli sekmesine geçer ve formu açar.</summary>
    private async Task YeniBildirimAc()
    {
        if (sekme != Sekme.Supheli)
        {
            await SekmeSec(Sekme.Supheli);
            // PAKET S1-i: seçili sekme URL'dedir — Sekmeler şeridi de şüpheliye geçer.
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("sekme", Kod(Sekme.Supheli)));
        }
        // P-13: yeni bildirim ek beyan DEĞİLDİR; önceki ek beyan hedefi temizlenir.
        ekBeyanHedef = null;
        yeniTutar = null; yeniHareketId = null; yeniGerekce = null;
        supheliFormAcik = true;
    }

    private async Task SekmeSec(Sekme s)
    {
        sekme = s;
        basari = null;
        await Yukle();
    }

    private async Task Yukle()
    {
        yukleniyor = true;
        hata = null;
        try
        {
            ozet = await Api.Ozet();
            switch (sekme)
            {
                case Sekme.Tespit:
                    tespitler = await Api.TespitleriGetir();
                    break;
                case Sekme.Supheli:
                    supheliler = await Api.SupheliGetir(
                        string.IsNullOrEmpty(supheliFiltre) ? null : supheliFiltre);
                    break;
                case Sekme.Saklama:
                    saklama = await Api.SaklamaOnizleme();
                    saklamaOnaylandi = false;
                    break;
                case Sekme.Risk:
                    // ⚠ ÖN YÜKLEME YASAK (Mehmet PLAN-2 + K40-3): burada YALNIZ
                    //   özet (kişisel veri yok) ve cari seçicisi çekilir. Tekil
                    //   /masak/risk/{cariId} ucu KULLANICI SEÇENE KADAR çağrılmaz.
                    riskOzet = await Api.RiskOzet();
                    riskCariler = await Api.RiskCarileri(RiskCariSiniri);
                    riskProfil = null;
                    riskCariId = "";
                    break;
            }
        }
        catch (Exception ex) { hata = ex.Message; }
        finally { yukleniyor = false; }
    }

    // ⚠ PREFETCH YASAK: bu metot YALNIZ kullanıcı tıklayınca çağrılır.
    // Tekil uç okuma izi düşürür (KVKK md.12).
    private async Task TespitAc(string id)
    {
        try { tespitDetay = await Api.TespitGetir(id); }
        catch (Exception ex) { hata = ex.Message; }
    }

    // ── PAKET 40-A — risk sekmesi eylemleri ─────────────────────────────────

    /// <summary>
    /// Seçicide cari değişti. ⚠ ÖN YÜKLEME YASAĞININ SINIRI BURASI: tekil uç
    /// yalnız KULLANICI seçtiği için çağrılır (KVKK md.12 okuma izi).
    /// </summary>
    private async Task RiskCariSecildi()
    {
        if (string.IsNullOrEmpty(riskCariId)) { riskProfil = null; return; }
        await RiskCariAc(riskCariId);
    }

    private async Task RiskCariAc(string cariId)
    {
        hata = null;
        try
        {
            riskCariId = cariId;
            riskProfil = await Api.RiskGetir(cariId);
        }
        // ⚠ UX-S28: hata "kayıt yok"a ÇEVRİLMEZ. Profil eldeki hâliyle kalır,
        //   sebep hata bandında görünür.
        catch (Exception ex) { hata = ex.Message; }
    }

    private async Task RiskHesapla()
    {
        if (string.IsNullOrEmpty(riskCariId)) return;
        hata = null; basari = null;
        kaydediliyor = true;
        try
        {
            // UX-S27: POST yanıtı OKUNUR ve sonucu banda yazılır.
            var sonuc = await Api.RiskHesapla(riskCariId);
            basari = string.Format(Dil.T.Uyum.RiskHesaplandi,
                Dil.T.Uyum.SeviyeAdi(sonuc.Profil.Seviye), sonuc.Profil.Puan);
            riskProfil = await Api.RiskGetir(riskCariId);
            riskOzet = await Api.RiskOzet();
        }
        catch (Exception ex) { hata = ex.Message; }
        finally { kaydediliyor = false; }
    }

    private void RiskElleAc()
    {
        riskElleHata = null;
        riskGerekce = "";
        riskElleSeviye = riskProfil?.Guncel?.Seviye ?? "ORTA";
        riskElleAcik = true;
    }

    private async Task RiskElleKaydet()
    {
        if (string.IsNullOrEmpty(riskCariId)) return;
        riskElleHata = null;
        if (!RiskElleGecerli)
        {
            riskElleHata = string.Format(Dil.T.Uyum.ElleGerekceEnAz,
                RiskGerekceAsgari, riskGerekce?.Trim().Length ?? 0);
            return;
        }
        kaydediliyor = true;
        try
        {
            var sonuc = await Api.RiskElle(riskCariId, riskElleSeviye, riskGerekce!.Trim());
            // İYİMSER KAYDETME YOK: çekmece ancak sunucu 200 dönünce kapanır.
            riskElleAcik = false;
            basari = string.Format(Dil.T.Uyum.RiskElleDegistirildi,
                Dil.T.Uyum.SeviyeAdi(sonuc.Profil.Seviye));
            riskProfil = await Api.RiskGetir(riskCariId);
            riskOzet = await Api.RiskOzet();
        }
        catch (Exception ex) { riskElleHata = ex.Message; }
        finally { kaydediliyor = false; }
    }

    private async Task Ara()
    {
        if (string.IsNullOrWhiteSpace(araBelgeNo)) { aramaSonucu = null; await Yukle(); return; }
        hata = null;
        try
        {
            // UX-4d madde 18: sonuç ARTIK sözleşmeye uygun okunuyor; 0 kayıtta
            // eski liste ekranda KALMAZ, boş durum çıkar (UX-S28).
            var sonuc = await Api.BelgeNoIleAra(araBelgeNo.Trim());
            aramaSonucu = sonuc;
            tespitler = sonuc.Kayitlar ?? [];
        }
        catch (Exception ex) { hata = ex.Message; }
    }

    /// <summary>
    /// PAKET P-13 (B-12): ek beyan AYNI formu kullanır (UX-S26 — oluşturma ve
    /// düzeltme formu tek alan kümesi). Asıl kaydın tutarı öneri olarak gelir;
    /// gerekçe BOŞ başlar, çünkü ek beyanın kendi özgün metni olmalıdır.
    /// </summary>
    private SupheliSatir? ekBeyanHedef;

    private void EkBeyanAc(SupheliSatir s)
    {
        hata = null;
        basari = null;
        ekBeyanHedef = s;
        yeniTutar = s.IslemTutariTl;
        yeniHareketId = s.HareketId;
        yeniGerekce = null;
        supheliFormAcik = true;
    }

    private async Task BildirimKaydet()
    {
        if (sayiKapisi.OnekleVar("sb-tutar")) return;   // ORTAK-1: POST YOK
        kaydediliyor = true;
        hata = null;
        try
        {
            var govde = new SupheliOlusturDto
            {
                IslemTutariTl = yeniTutar!.Value,
                HareketId = string.IsNullOrWhiteSpace(yeniHareketId) ? null : yeniHareketId.Trim(),
                Gerekce = yeniGerekce!.Trim(),
            };
            if (ekBeyanHedef is null) await Api.SupheliOlustur(govde);
            else await Api.EkBeyan(ekBeyanHedef.Id, govde);

            supheliFormAcik = false;
            yeniTutar = null; yeniHareketId = null; yeniGerekce = null;
            basari = ekBeyanHedef is null ? Dil.T.Uyum.BildirimOlusturuldu : Dil.T.Uyum.EkBeyanBasarili;
            ekBeyanHedef = null;
            await Yukle();
        }
        catch (Exception ex) { hata = ex.Message; }
        finally { kaydediliyor = false; }
    }

    private async Task GonderimAc(SupheliSatir s)
    {
        gonderimHedef = s;
        gonderimReferansi = null;
        gonderimDenendi = false;
        gonderimAcik = true;
        await Task.CompletedTask;
    }

    private async Task GonderimOnayla()
    {
        gonderimDenendi = true;
        if (gonderimHedef is null || string.IsNullOrWhiteSpace(gonderimReferansi)) return;
        kaydediliyor = true; hata = null;
        try
        {
            await Api.GonderildiIsaretle(gonderimHedef.Id, gonderimReferansi.Trim());
            basari = Dil.T.Uyum.GonderildiIsaretlendi;
            gonderimAcik = false;
            await Yukle();
        }
        catch (Exception ex) { hata = ex.Message; }
        finally { kaydediliyor = false; }
    }

    private async Task KapatmaAc(SupheliSatir s)
    {
        kapatmaHedef = s;
        kapatmaGerekcesi = null;
        kapatmaDenendi = false;
        kapatmaAcik = true;
        await Task.CompletedTask;
    }

    private async Task KapatmaOnayla()
    {
        kapatmaDenendi = true;
        if (kapatmaHedef is null || (kapatmaGerekcesi?.Trim().Length ?? 0) < AsgariKapatma) return;
        kaydediliyor = true; hata = null;
        try
        {
            await Api.Kapat(kapatmaHedef.Id, kapatmaGerekcesi!.Trim());
            basari = Dil.T.Uyum.BildirimKapatildi;
            kapatmaAcik = false;
            await Yukle();
        }
        catch (Exception ex) { hata = ex.Message; }
        finally { kaydediliyor = false; }
    }

    private async Task SaklamaCalistir()
    {
        kaydediliyor = true;
        hata = null;
        try
        {
            var sonuc = await Api.SaklamaUygula();
            basari = string.Format(Dil.T.Uyum.MaskelemeSonuc,
                sonuc.Maskelenen.KimlikTespiti, sonuc.Maskelenen.Beyan);
            await Yukle();
        }
        catch (Exception ex) { hata = ex.Message; }
        finally { kaydediliyor = false; }
    }

