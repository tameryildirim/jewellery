               @bind-Deger="gonderimReferansi"
               Hata="@(gonderimDenendi && string.IsNullOrWhiteSpace(gonderimReferansi) ? Dil.T.Uyum.ReferansZorunlu : null)"
               HataKimligi="uy-referans-hata" />
        <div class="dugme-satir">
            <button id="uy-gonderim-vazgec" class="dugme dugme-ikincil"
                    @onclick="@(() => gonderimAcik = false)"><Kuyumcu.Web.Bilesenler.Yildiz.YildizVazgec /></button>
            <button id="uy-gonderim-onayla" class="dugme dugme-birincil"
                    disabled="@(kaydediliyor)" @onclick="GonderimOnayla">@Dil.T.Ortak.Kaydet</button>
        </div>
    </div>
</ModalPencere>

<ModalPencere Acik="@kapatmaAcik" Baslik="@Dil.T.Uyum.KapatOnayBaslik"
              Kapat="@(() => { kapatmaAcik = false; return Task.CompletedTask; })">
    <div class="form-dikey">
        <p class="metin-kucuk metin-soluk">@Dil.T.Uyum.KapatOnayNotu</p>
        <div class="alan">
            @* SUNUM 14.10: çift etiket kaldırıldı (CokSatir kendi etiketini çizer). *@
            <CokSatir ElemanId="uy-kapatma-gerekce" Etiket="@Dil.T.Uyum.KapatmaGerekcesiSor" Zorunlu="true"
                      Satir="4" EnFazla="@AlanSinirlari.SupheliKapatma" @bind-Deger="kapatmaGerekcesi" />
            <span class="metin-kucuk @((kapatmaGerekcesi?.Trim().Length ?? 0) < AsgariKapatma ? "metin-kirmizi" : "")">
                @(kapatmaGerekcesi?.Trim().Length ?? 0) / @AsgariKapatma
            </span>
            @if (kapatmaDenendi && (kapatmaGerekcesi?.Trim().Length ?? 0) < AsgariKapatma)
            {
                <span id="uy-kapatma-hata" class="metin-kucuk metin-kirmizi">
