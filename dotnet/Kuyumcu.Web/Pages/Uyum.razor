                // DoD EK md.1: gerçek istek atar (GET /masak/risk/{cariId}).
                Hucre = x => @<button @onclick="() => RiskCariAc(x.CariId)" id="@($"uy-yuksek-ac-{x.CariId}")" class="dugme dugme-kucuk">@Dil.T.Uyum.Goruntule</button> },
