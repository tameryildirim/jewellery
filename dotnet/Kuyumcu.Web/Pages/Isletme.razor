    private void TaslagiSifirla()
    {
        taslakKurKaynagi = tenant?.KurKaynagi ?? "";
        taslakDoviz = kaynakYaniti?.DovizSecili ?? "";
        taslakHasFiyat = kaynakYaniti?.OzelMatrahSecili ?? "";
        taslakMaliyet = tenant?.MaliyetYontemi ?? "";
        if (tenant is not null) secilenArayuzModu = tenant.VarsayilanArayuzModu;
        taslakVezne = vezneZorunlu;
    }

    private void AyarOnayAc()
    {
        if (AyarDegisiklikleri.Count == 0 || SaltOkunur) return;
        ayarOnayHata = null;
        ayarOnayAcik = true;
    }

    /// <summary>Onay penceresinde Vazgeç: istek YOK, ekran ESKİ değerlere döner.</summary>
    private void AyarOnayVazgec() => AyarTaslakVazgec();

    /// <summary>
    /// Onaylanınca YALNIZ değişen ayar(lar) için mevcut yazma uçları çağrılır:
    /// tek değişiklik = tek PATCH. Sonuç bantta (UX-S27); hata pencerede kalır.
    /// </summary>
    private async Task AyarKaydetOnayli()
    {
        var degisenler = AyarDegisiklikleri;
        if (degisenler.Count == 0) { ayarOnayAcik = false; return; }
        ayarOnayHata = null;
        adminHata = null;
        kaydediliyor = true;
        var yazilan = new List<string>(4);
        try
        {
            foreach (var d in degisenler)
            {
                switch (d.Kod)
                {
                    case "maliyet": await MaliyetYontemiSecildi(new ChangeEventArgs { Value = taslakMaliyet }); break;
                    case "kur": await KurKaynagiSecildi(new ChangeEventArgs { Value = taslakKurKaynagi }); break;
                    case "doviz": await KaynakAyariYaz("/kur/doviz-kaynak", taslakDoviz); break;
                    case "matrah": await KaynakAyariYaz("/kur/ozel-matrah-kaynak", taslakHasFiyat); break;
                    case "mod": await ArayuzModuKaydet(); break;
                    case "vezne": await VezneDegistir(taslakVezne); break;
                }
                if (adminHata is not null) break;
                yazilan.Add(d.Ad);
            }
        }
        finally { kaydediliyor = false; }
        if (adminHata is not null)
        {
            ayarOnayHata = adminHata;          // hata pencerede görünür (UX-S28)
            return;
        }
        ayarOnayAcik = false;
        TaslagiSifirla();
        BasariGoster(string.Format(P1.AyarKaydedildi, string.Join(" · ", yazilan)));
    }

