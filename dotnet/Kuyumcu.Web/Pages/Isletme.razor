    /// <summary>Seçeneğin kısa durumu: seçilemez sebebi ya da (izinsiz · son çekim · son kapanış). Açıklama paragrafı yok.</summary>
    private string? Durum(Kuyumcu.Contracts.Sayfalar.Panel.KaynakSecenegiVeri s)
    {
        if (s.Engel is "ANAHTAR_YOK") return KK.AnahtarYok;
        if (s.Engel is not null) return KK.Kapali;
        var parca = new List<string>(3);
        if (s.Sozlesmesiz) parca.Add(KK.Sozlesmesiz);
        if (s.SonCekim is { } t) parca.Add(string.Format(KK.SonCekim, Bicim.IsletmeSaati(t)));
        if (s.SonKapanisGunu is { } g)
            parca.Add(string.Format(KK.SonKapanis, Bicim.Gun(g),
                s.SonKapanisFiyati is { } f ? Bicim.Tl(f) : "—"));
        else if (s.Kod is "BIST" or "ELLE" or "HAREM" or "ALTINKAYNAK" && kaynakYaniti?.OzelMatrahSecenekleri?.Contains(s) == true)
            parca.Add(KK.KapanisYok);
        return parca.Count == 0 ? null : string.Join(" · ", parca);
    }

    private string? SeciliDurum(List<Kuyumcu.Contracts.Sayfalar.Panel.KaynakSecenegiVeri>? liste, string? kod) =>
        liste?.FirstOrDefault(s => s.Kod == kod) is { } s ? Durum(s) : null;

    private IReadOnlyList<SecenekOgesi> DovizSecenekleri =>
        [.. (kaynakYaniti?.DovizSecenekleri ?? []).Select(s =>
            new SecenekOgesi(s.Kod, KurKaynakAdi.Ad(s.Kod, Dil.T), Durum(s), Pasif: s.Engel is not null))];

    private IReadOnlyList<SecenekOgesi> HasFiyatSecenekleri =>
        [.. (kaynakYaniti?.OzelMatrahSecenekleri ?? []).Select(s =>
            new SecenekOgesi(s.Kod, KurKaynakAdi.Ad(s.Kod, Dil.T), Durum(s), Pasif: s.Engel is not null))];

    /// <summary>Döviz / has fiyatı kaynağı yazma (PATCH, SAHİP/MÜDÜR) + durumu yeniden oku.</summary>
    private async Task KaynakAyariYaz(string uc, string kod)
    {
        if (string.IsNullOrWhiteSpace(kod)) return;
        adminHata = null;
        try
        {
            await Api.PatchAsync<object>(uc, new { kaynak = kod });
            await KurKaynaklariYukle();
        }
        catch (ApiHata ex) { adminHata = ex.Message; }
    }

    // ── gün kapanışı girişi (BIST bülteni ya da kendi değeri) ──
    private bool kapanisAcik;
    private DateOnly? kapanisGun;
    private decimal? kapanisDeger;
    private string kapanisBirim = "TL_GRAM";
    private string? kapanisNot;
    private string? kapanisHata;

    private static DateOnly KapanisBugun => Bicim.IsletmeGunu(DateTime.UtcNow);   // işletme günü (Europe/Istanbul)

    private IReadOnlyList<SecenekOgesi> KapanisBirimleri =>
    [
        new SecenekOgesi("TL_GRAM", KK.BirimGram),
        new SecenekOgesi("TL_KG", KK.BirimKg),
    ];

    private bool KapanisGecerli => kapanisGun is not null && kapanisDeger is > 0m;

    private void KapanisAc()
    {
        kapanisHata = null;
        kapanisDeger = null;
        kapanisNot = null;
        // Son işgünü önerisi: dün; hafta sonuysa cuma (tatil günü kuyumcu seçer).
        var g = KapanisBugun.AddDays(-1);
        while (g.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday) g = g.AddDays(-1);
        kapanisGun = g;
        kapanisBirim = kaynakYaniti?.OzelMatrahSecili == "BIST" ? "TL_KG" : "TL_GRAM";
        kapanisAcik = true;
    }

    private async Task KapanisKaydet()
    {
        if (!KapanisGecerli || kaynakYaniti?.OzelMatrahSecili is not ("BIST" or "ELLE") ) return;
        kapanisHata = null;
        kaydediliyor = true;
        try
        {
            await Api.PostAsync<object>("/kur/kapanis", new
            {
                kaynak = kaynakYaniti.OzelMatrahSecili,
                gun = Bicim.Makine(kapanisGun!.Value),
                deger = kapanisDeger,
                birim = kapanisBirim,
                dayanak = string.IsNullOrWhiteSpace(kapanisNot) ? null : kapanisNot.Trim(),
            });
            kapanisAcik = false;
            await KurKaynaklariYukle();
            BasariGoster(KK.KapanisKaydedildi);
        }
        catch (ApiHata ex) { kapanisHata = ex.Message; }
        finally { kaydediliyor = false; }
    }

    private async Task KurKaynagiSecildi(ChangeEventArgs e)
    {
        var kod = e.Value?.ToString() ?? "";
        if (tenant is null || string.IsNullOrWhiteSpace(kod) || kod == tenant.KurKaynagi) return;
        adminHata = null;
        kaydediliyor = true;
        try
        {
            // Yazma yolu MEVCUT uçtur (PATCH /kur/kaynak): ikinci bir yazma
            // yolu açılsaydı kaynak değişince kur yeniden çekilmezdi.
            await Api.PatchAsync<object>("/kur/kaynak", new { kaynak = kod });
            tenant = await Api.GetAsync<TenantVeri>("/admin/tenant");
            BasariGoster(Dil.T.Yonetim.Kaydedildi);
        }
        catch (ApiHata ex) { adminHata = ex.Message; }
        kaydediliyor = false;
    }

