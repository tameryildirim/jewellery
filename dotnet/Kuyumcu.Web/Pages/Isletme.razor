    // ── Şube ─────────────────────────────────────────────────────────────────

    private async Task SubeModalAc(string? id)
    {
        subeModalHata = null;
        sDuzenlenenId = id;
        sAd = "";
        sAdres = "";
        sTelefon = "";
        subeModalAcik = true;

        if (id is null) return;

        // Detay ucu tam kaydı verir; listedeki özetle kaydetmek adres/telefonu
        // silme riski taşır (cari ekranında bu hata bizzat yaşandı).
        subeDetayYukleniyor = true;
        try
        {
            var sb = await Api.GetAsync<SubeVeri>($"/subeler/{id}");
            sAd = sb.Ad;
            sAdres = sb.Adres ?? "";
            sTelefon = sb.Telefon ?? "";
        }
        catch (ApiHata ex) { subeModalHata = ex.Message; }
        subeDetayYukleniyor = false;
    }

    private async Task SubeKaydet()
    {
        if (!SubeGecerli || kaydediliyor) return;
        subeModalHata = null;
        kaydediliyor = true;
        var govde = new
        {
            ad = sAd.Trim(),
            adres = string.IsNullOrWhiteSpace(sAdres) ? null : sAdres.Trim(),
            telefon = string.IsNullOrWhiteSpace(sTelefon) ? null : sTelefon.Trim(),
        };
        try
        {
            if (sDuzenlenenId is null) await Api.PostAsync("/subeler", govde);
            else await Api.PatchAsync($"/subeler/{sDuzenlenenId}", govde);
            subeModalAcik = false;
            await SubeYukle();
            BasariGoster(Dil.T.Yonetim.Kaydedildi);
        }
        catch (ApiHata ex) { subeModalHata = ex.Message; }
        kaydediliyor = false;
    }

    /// <summary>UX-S25 — pasife almanın TERSİ; ayrı uç yok, aynı PATCH taşır.</summary>
    private async Task SubeAktifeAl(SubeVeri sb)
    {
        subeHata = null;
        kaydediliyor = true;
        try
        {
            // PATCH sözleşmesi: gönderilmeyen alan KORUNUR. Sunucu Ad'ı [Required]
            // istiyor, o yüzden mevcut ad AYNEN geri gönderilir (değişiklik değil).
            await Api.PatchAsync($"/subeler/{sb.Id}", new { ad = sb.Ad, aktif = true });
            await SubeYukle();
            BasariGoster(Dil.T.Kabuk.AktifeAlindi);
        }
        catch (ApiHata ex) { subeHata = ex.Message; }
        kaydediliyor = false;
    }

    private async Task SubePasifeAl()
    {
        pasifHata = null;
        kaydediliyor = true;
        try
        {
            await Api.DeleteAsync<object>($"/subeler/{pasifSube!.Id}");
            pasifSube = null;
            await SubeYukle();
            BasariGoster(Dil.T.Yonetim.Kaydedildi);
        }
        catch (ApiHata ex) { pasifHata = ex.Message; }
        kaydediliyor = false;
    }

    private void Yenile() => InvokeAsync(StateHasChanged);
    public void Dispose() => Dil.Degisti -= Yenile;
