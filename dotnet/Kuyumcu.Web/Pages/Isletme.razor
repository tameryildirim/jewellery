@page "/isletme"
@using Kuyumcu.Contracts.Sayfalar.Isletme
@using Kuyumcu.Core.Domain.Girdi
@using Kuyumcu.Web.Bilesenler.Grid
@inject ApiIstemci Api
@inject DilServisi Dil
@inject ArayuzModuServisi Modu
@implements IDisposable

@* ═══════════════════════════════════════════════════════════════════════════
   İŞLETME VE ŞUBELER

   TESPİT (2026-09-14): tenant bilgisi, plan değişikliği, AI anahtarı ve
   şubenin düzenle/detay/pasife al uçları sunucuda VARDI, ekranı YOKTU.
   Şube yalnız kayıt sırasında açılıyor, sonradan adı bile düzeltilemiyordu.

   Tüm uçlar sunucuda SAHIP rolüne kapalıdır; buradaki gizleme kolaylıktır,
   güvenlik kapısı değildir — son sözü sunucu söyler.
   ═══════════════════════════════════════════════════════════════════════════ *@

<PageTitle>@Marka.SayfaBasligi(Dil.T.Isletme.Baslik)</PageTitle>

<div class="dikey-bosluk">
    @* UX-1-C4 · K7 — tek başlık kabuğu + ekran başına TEK birincil eylem. *@
    <SayfaBasi Anahtar="isletme" Baslik="@Dil.T.Isletme.Baslik" Aciklama="@Dil.T.Yonetim.IsletmeSayfaAciklama">
        <Eylem>
            <button class="btn btn-birincil" id="i-kimlik-duzenle" disabled="@(tenant is null || SaltOkunur)" @onclick="KimlikAc">
                <Ikon Ad="@Ikonlar.Kalem" /> @Dil.T.Yonetim.KimlikDuzenle
            </button>
            @if (tenant is null)
            {
                @* KESIF-P1 (#72): okuma BAŞARISIZSA "Yükleniyor" yazılmaz (sonsuz bekleme
                   yalanı); kilit sebebi sunucunun hatasıdır. *@
                <span class="metin-soluk metin-kucuk" id="i-kimlik-duzenle-kilit">
                    @Dil.T.Yonetim.KilitSebebi: @(tenantHata ?? Dil.T.Ortak.Yukleniyor)
                </span>
            }
            else if (SaltOkunur)
            {
                @* UX-S30: kilitli düğme SEBEBİNİ söyler. *@
                <span class="metin-soluk metin-kucuk" id="i-yazma-kilidi">
                    @Dil.T.Yonetim.KilitSebebi: @Dil.T.Isletme.YazmaKapaliKilidi
                </span>
            }
        </Eylem>
    </SayfaBasi>
    @* ORTAK-1 hakem turu 29.09 (KRİTİK): BASİT'te üst bar + SayfaBasi açıklamasının altında ikinci
       büyük başlık ve ikinci açıklama vardı (üç başlık, iki açıklama). BASİT'te çizilmez; PRO aynen. *@
    @if (!Dil.BasitMi)
    {
        <div class="sayfa-baslik">
            <h1>@Dil.T.Isletme.Baslik</h1>
            <p class="metin-soluk" id="isletme-aciklama">@P1.IsletmeAciklama</p>
        </div>
    }

    <BasariBandi Mesaj="@basariMesaj" Jeton="@basariJeton" SureliMs="3000" Id="basari-bandi" />

    @* ── Deneme / salt-okunur bandı (paket F-2-min Faz A) ──
       Sunucu SON SÖZÜ söyler: saltOkunurMu ve kalanGun GET /admin/tenant'tan
       gelir, ekran hesaplamaz (UX-S21). AKTIF kiracıda band hiç çizilmez. *@
    @if (tenant is not null && tenant.Durum != "AKTIF")
    {
        <div class="kart" id="i-durum-bandi">
            <div class="kart-govde">
                <div class="satir-arasi">
                    <span class="metin-soluk">@Dil.T.Isletme.DurumBasligi</span>
                    <span id="i-durum-rozeti">
                        <Rozet Renk="@(tenant.SaltOkunurMu ? "kirmizi" : "amber")">
                            @(tenant.Durum == "SALT_OKUNUR"
                                ? Dil.T.Isletme.DurumSaltOkunur
                                : Dil.T.Isletme.DurumDeneme)
                        </Rozet>
                    </span>
                </div>
                @if (tenant.Durum == "DENEME" && tenant.KalanGun is int gun && gun > 0)
                {
                    <p id="i-kalan-gun"><strong>@gun</strong> @Dil.T.Isletme.KalanGun</p>
                }
                @if (tenant.SaltOkunurMu)
                {
                    <p id="i-deneme-bitti">
                        @(tenant.Durum == "DENEME" ? Dil.T.Isletme.DenemeBitti : "")
                        @Dil.T.Isletme.SaltOkunurUyari
                    </p>
                }
                <p class="metin-soluk metin-kucuk">@Dil.T.Isletme.SureUzatmaNotu</p>
                @* KVKK md.11-12 · VUK 253/256: veri REHİN ALINMAZ — dışa aktarım
                   salt-okunur kiracıda da açıktır ve bandın içinden erişilir. *@
                <a class="btn btn-ikincil btn-kucuk" id="i-disa-aktarim-bag" href="/veri-disa-aktarim">
                    <Ikon Ad="@Ikonlar.VeriDisaAktarim" /> @Dil.T.Isletme.VerileriDisaAktar
                </a>
            </div>
        </div>
    }

    @* ── PAKET S1-i — SEKMELER (kurucu 24.09: "tren gibi aşağıya doğru gidiyor").
       Tek büyük "İşletme bilgisi" kartı ile şubeler dört sekmeye ayrıldı: kimlik ·
       abonelik · ayarlar · şubeler. Hiçbir alan silinmedi, id'ler aynı. Kiracı
       yüklenemezse hata bandı sekmelerin ÜSTÜNDE tek yerde durur (UX-S28). *@
    @if (tenantHata is not null)
    {
        <div class="kart"><div class="kart-govde"><HataBandi Mesaj="@tenantHata" /></div></div>
    }
    else if (tenant is null)
    {
        <Yukleniyor />
    }
    <Sekmeler Onek="isl" Liste="@IsSekmeleri" Etiket="@GS.IsSerit">
        <Panel Context="isKod">
            @if (isKod == GorselSigmaSozlugu.IsSubeler)
            {
            @* ── Şubeler ── *@
            <div class="kart">
                <div class="kart-baslik satir-arasi">
                    <h2>@Dil.T.Isletme.Subeler</h2>
                    @* Ekran başına TEK birincil eylem (kimlik düzenle, sayfa başında): "+ Yeni Şube" ikincil. *@
                    <button class="btn btn-ikincil btn-kucuk" id="s-yeni-sube-ac" disabled="@SaltOkunur"
                            title="@(SaltOkunur ? Dil.T.Isletme.YazmaKapaliKilidi : null)"
                            @onclick="() => SubeModalAc(null)">
                        + @Dil.T.Isletme.YeniSube
                    </button>
                </div>
                <div class="kart-govde">
                    @if (subeYukleniyor)
                    {
                        <Yukleniyor />
                    }
                    else if (subeHata is not null)
                    {
                        <HataBandi Mesaj="@subeHata" />
                    }
                    else if (subeler.Count == 0)
                    {
                        <BosDurum Mesaj="@Dil.T.Isletme.SubeYok" />
                    }
                    else
                    {
                        @* PAKET GOC-D — ortak ızgara (grid:isletme:sube-liste): sütun sırası, göster/gizle, sıralama,
                           kullanıcıya+ekrana kalıcı, varsayılana dön. Kart kabı kimliği (isletme-sube-liste) ve satır
                           eylemleri (s-pasife-*, s-aktife-*) AYNEN. Şube listesi TAMDIR → yerel sıralama. *@
                        <Izgara T="SubeVeri" Ekran="isletme" GridId="sube-liste" KartListeId="isletme-sube-liste"
                                Kolonlar="@SubeKolonlari" Ogeler="@IzgaraYerelSiralama.Uygula(subeler, subeSira, SubeKolonlari)"
                                Baslik="@Dil.T.Isletme.Subeler"
                                SiralamaDegisti="@(x => subeSira = x)" GecerliSiralama="@subeSira" />
                        @if (AktifSubeSayisi <= 1)
                        {
                            <p class="metin-soluk metin-kucuk" id="s-son-sube-notu">@SonSubeMetni</p>
                        }
                        @* PAKET S-3b: aktifleştirme yolu AÇILDI (PATCH /subeler/{id} aktif=true),
                           bu yüzden buradaki "değişmez" ipucu KALDIRILDI — satırın kendisinde
                           gerçek düğme var (UX-S25: "sunucuda uç var, ekranda düğme yok" biter). *@
                    }
                </div>
            </div>
            }
            else if (tenant is not null)
            {
                <div class="kart">
                    @if (isKod == GorselSigmaSozlugu.IsKimlik)
                    {
                        <div class="kart-baslik"><h2>@Dil.T.Isletme.IsletmeBilgisi</h2></div>
                    }
                    <div class="kart-govde">
                        @if (isKod == GorselSigmaSozlugu.IsKimlik)
                        {
                            @* Kurul tur 2 KRİTİK + QA turu 1/2: işletme adı SALT METİNDİ, düzenleme
                               yolu yoktu. UX-1-B'nin açtığı PATCH /admin/tenant/kimlik ucuna bağlandı. *@
                            <dl class="form-dikey kimlik-listesi">
                                <div class="satir-arasi">
                                    <dt class="metin-soluk">@Dil.T.Isletme.IsletmeAdi</dt>
                                    <dd class="hucre-vurgu" id="ikimlik-ad-goster">@tenant.Ad</dd>
                                </div>
                                <div class="satir-arasi">
                                    <dt class="metin-soluk">@Dil.T.Yonetim.Adres</dt>
                                    <dd class="hucre-vurgu" id="ikimlik-adres-goster">@Bosluk(tenant.Adres)</dd>
                                </div>
                                <div class="satir-arasi">
                                    <dt class="metin-soluk">@Dil.T.Yonetim.Telefon</dt>
                                    <dd class="hucre-vurgu" id="ikimlik-telefon-goster">@Bosluk(tenant.Telefon)</dd>
                                </div>
                                <div class="satir-arasi">
                                    <dt class="metin-soluk">@Dil.T.Yonetim.VergiDairesi</dt>
                                    <dd class="hucre-vurgu" id="ikimlik-vergidairesi-goster">@Bosluk(tenant.VergiDairesi)</dd>
                                </div>
                                <div class="satir-arasi">
                                    <dt class="metin-soluk">@Dil.T.Yonetim.VergiNo</dt>
                                    <dd class="hucre-vurgu" id="ikimlik-vergino-goster">@Bosluk(tenant.VergiNo)</dd>
                                </div>
                            </dl>
                            <p class="metin-soluk metin-kucuk">@Dil.T.Yonetim.KimlikAciklama</p>
                        }
                        else if (isKod == GorselSigmaSozlugu.IsAbonelik)
                        {
                            @* ── PAKET P-27 (F-1 abonelik + F-3 plan kapısı) ──────────────
                               Plan artık "seç-kaydet" bir tercih DEĞİLDİR: abonelik hakkıdır.
                               Ekran hiçbir seviye/süre hesabı yapmaz (UX-S21) — yükseltmenin
                               kapalı olduğunu, indirilebilir planları ve kalan günü SUNUCU
                               söyler (GET /abonelik). *@
                            <div class="alan" id="i-abonelik-blok">
                                <h3 class="alt-baslik">@Dil.T.Isletme.AbonelikBasligi</h3>
                                <p class="metin-soluk metin-kucuk" id="i-abonelik-aciklama">@Dil.T.Isletme.AbonelikAciklama</p>

                                @if (abonelikHata is not null)
                                {
                                    @* UX-S28: hata "kayıt yok"a çevrilmez — boş durum DEĞİL, hata bandı. *@
                                    <HataBandi Mesaj="@abonelikHata" />
                                }
                                else if (abonelik is null)
                                {
                                    <Yukleniyor />
                                }
                                else
                                {
                                    @if (abonelik.SuresiDolduMu)
                                    {
                                        <HataBandi Mesaj="@Dil.T.Isletme.AbonelikSuresiDoldu" />
                                    }

                                    <dl class="form-dikey" id="i-abonelik-ozet">
                                        <div class="satir-arasi">
                                            <dt class="metin-soluk">@Dil.T.Isletme.Plan</dt>
                                            <dd class="hucre-vurgu" id="i-abonelik-plan">
                                                @DilEkranSozlugu.SunucuMetni(Dil.Dil, abonelik.PlanAdi)
                                                <Rozet Renk="mavi">@(abonelik.Donem is null
                                                    ? Dil.T.Isletme.AbonelikYok : Dil.T.Isletme.PlanKaynakRozeti)</Rozet>
                                            </dd>
                                        </div>
                                        <div class="satir-arasi">
                                            <dt class="metin-soluk">@Dil.T.Isletme.AbonelikBaslangic</dt>
                                            <dd id="i-abonelik-baslangic">
                                                @(abonelik.Donem is null ? "—" : Bicim.Tarih(abonelik.Donem.Baslangic, Dil.Locale))
                                            </dd>
                                        </div>
                                        <div class="satir-arasi">
                                            <dt class="metin-soluk">@Dil.T.Isletme.AbonelikBitis</dt>
                                            <dd id="i-abonelik-bitis">
                                                @(abonelik.Donem?.Bitis is null
                                                    ? Dil.T.Isletme.AbonelikSuresiz
                                                    : Bicim.Tarih(abonelik.Donem.Bitis.Value, Dil.Locale))
                                            </dd>
                                        </div>
                                        @if (abonelik.KalanGun is not null)
                                        {
                                            <div class="satir-arasi">
                                                <dt class="metin-soluk">@Dil.T.Isletme.AbonelikKalanGun</dt>
                                                @* UX-S33: bu kart üstteki dönem seçicisinden etkilenmez. *@
                                                <dd id="i-abonelik-kalan">
                                                    @abonelik.KalanGun
                                                    <span class="metin-soluk metin-kucuk">@Dil.T.Isletme.DonemdenBagimsiz</span>
                                                </dd>
                                            </div>
                                        }
                                    </dl>

                                    @if (IndirilebilirSecenekler.Count > 1)
                                    {
                                        <Secici ElemanId="i-plan"
                                                Etiket="@Dil.T.Isletme.Plan"
                                                Secenekler="@IndirilebilirSecenekler"
                                                @bind-Deger="secilenPlan"
                                                @bind-Deger:after="PlanIndirSor"
                                                Devredisi="@SaltOkunur"
                                                DevredisiSebebi="@SaltOkunurSebebi" />
                                    }
                                    else
                                    {
                                        @* UX-S25 / UX-S30: düğme çizip kilitlemek yerine NEDEN
                                           değiştirilemediği ve doğru yol yazılır. *@
                                        <DegismezIpucu Varlik="Abonelik"
                                                       Gerekce="@Dil.T.Isletme.PlanYukseltmeKapali"
                                                       AlternatifYol="@Dil.T.Isletme.PlanIndirmeYok" />
                                    }
                                    <p class="metin-soluk metin-kucuk" id="i-plan-yukseltme-notu">
                                        @(string.IsNullOrWhiteSpace(abonelik.YukseltmeKapaliSebebi)
                                            ? Dil.T.Isletme.PlanYukseltmeKapali
                                            : DilEkranSozlugu.SunucuMetni(Dil.Dil, abonelik.YukseltmeKapaliSebebi))
                                    </p>

                                    <h4 class="alt-baslik">@Dil.T.Isletme.AbonelikGecmisi</h4>
                                    @if (Gecmis.Count == 0)
                                    {
                                        <BosDurum Mesaj="@Dil.T.Isletme.AbonelikGecmisYok" />
                                    }
                                    else
                                    {
                                        <ul class="liste-sade" id="i-abonelik-gecmis">
                                            @foreach (var d in Gecmis)
                                            {
                                                <li>
                                                    <span class="hucre-vurgu">@d.PlanKodu</span>
                                                    <span class="metin-soluk">
                                                        @Bicim.Tarih(d.Baslangic, Dil.Locale) —
                                                        @(d.Bitis is null ? Dil.T.Isletme.AbonelikSuresiz : Bicim.Tarih(d.Bitis.Value, Dil.Locale))
                                                    </span>
                                                    <Rozet Renk="gri">@KaynakAdi(d.Kaynak)</Rozet>
                                                </li>
                                            }
                                        </ul>
                                        @* UX-S29: sunucu sınırı ekranda YAZILIR. *@
                                        <p class="metin-soluk metin-kucuk" id="i-abonelik-sinir">
                                            @Dil.T.Isletme.AbonelikSinirNotu
                                        </p>
                                    }
                                }
                            </div>

                            @* ── Plan indirme ONAYI (PAKET P-27) ─────────────────────
                               Onay YERİNDE alınır, ModalPencere ile DEĞİL: DoD EK md.2'ye
                               göre modal YALNIZ yıkıcı onaya ayrılmıştır ve plan indirme
                               hiçbir kaydı silmez/iptal etmez — hak kapsamını daraltır.
                               Yine de sessiz yazma YASAKTIR (UX-S27): seçim tek başına
                               yazmaz, kullanıcı açıkça onaylar. *@
                            @if (planOnayAcik)
                            {
                                <div class="kart-uyari" id="i-plan-onay">
                                    <p id="i-plan-onay-metin">@Dil.T.Isletme.PlanIndirOnay</p>
                                    <p class="metin-soluk metin-kucuk">@Dil.T.Isletme.PlanYukseltmeKapali</p>
                                    <div class="satir">
                                        @* ⚠ @onclick AYNI SATIRDA: denetim.sh "ölü düğme" sayacı
                                           satır bazlı tarar; sonraki satıra taşınan @onclick
                                           düğmeyi ölü gösterirdi. *@
                                        <button @onclick="PlanIndirVazgec" class="btn btn-ikincil esit-pay" id="i-plan-onay-vazgec">@Dil.T.Ortak.Iptal</button>
                                        <button @onclick="PlanKaydet" disabled="@kaydediliyor" class="btn btn-tehlike esit-pay" id="i-plan-onay-uygula">@Dil.T.Isletme.PlanDegistir</button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alan">
                                @* KESIF-P1 (#12): seçim YALNIZ taslağı değiştirir; kayıt aşağıdaki
                                   "Değişikliği kaydet" + onay penceresiyle olur. *@
                                <Secici ElemanId="i-varsayilan-arayuz-modu"
                                        Etiket="@Dil.T.Arayuz.VarsayilanBaslik"
                                        Secenekler="@ArayuzModuSecenekleri"
                                        @bind-Deger="secilenArayuzModu"
                                        Devredisi="@(SaltOkunur || kaydediliyor)"
                                        DevredisiSebebi="@SaltOkunurSebebi" />
                                <span class="metin-soluk metin-kucuk">@Dil.T.Arayuz.VarsayilanAciklama</span>
                            </div>

                            <div class="alan">
                                <Onay ElemanId="i-ai-etkin"
                                      Etiket="@($"{P1.AkilliOneriler} — {(tenant.AiEtkin ? Dil.T.Isletme.AiAcik : Dil.T.Isletme.AiKapali)}")"
                                      Deger="@tenant.AiEtkin" DegerChanged="@((bool v) => AiDegistir(v))"
                                      Devredisi="@SaltOkunur" DevredisiSebebi="@P1.IsletmeYalnizSahip"
                                      Ipucu="@Dil.T.Isletme.AiAciklama" />
                            </div>

                            @* Paket 19 Faz A — vezne ayrımı. Ayar kiraci_ayarlari tablosundadır
                               (tenants'a kolon EKLENMEDİ); PATCH /admin/vezne yalnız SAHİP. *@
                            <div class="alan">
                                <Onay ElemanId="i-vezne-zorunlu"
                                      Etiket="@($"{Dil.T.Vezne.AyrimZorunlu} — {(taslakVezne ? Dil.T.Vezne.AyrimAcik : Dil.T.Vezne.AyrimKapali)}")"
                                      Deger="@taslakVezne" DegerChanged="@((bool v) => VezneTaslak(v))"
                                      Devredisi="@(SaltOkunur || kaydediliyor || !vezneOkundu)" DevredisiSebebi="@P1.IsletmeYalnizSahip" />
                                @* Kimlik korundu (#i-vezne-aciklama). *@
                                <span class="metin-soluk metin-kucuk" id="i-vezne-aciklama">@P1.VezneAyrimAciklama</span>
                            </div>
                            @* PAKET YASAL-4 / Y4-C — KMTS takip kodu alanı (varsayılan KAPALI).
                               kiraci_ayarlari üzerinden; PUT /kmts/ayar yalnız SAHİP. *@
                            <div class="alan">
                                <Onay ElemanId="i-kmts-kullanimi"
                                      Etiket="@Y4I.KmtsAyarEtiket"
                                      Deger="@kmtsKullanimi" DegerChanged="@((bool v) => KmtsDegistir(v))"
                                      Devredisi="@(SaltOkunur || !kmtsOkundu)" DevredisiSebebi="@P1.IsletmeYalnizSahip" />
                                <span class="metin-soluk metin-kucuk" id="i-kmts-aciklama">@Y4I.KmtsAyarAciklama</span>
                                @* § 4.4: resmî biçim yazılınca mevcut kodlar taranır; uymayan varsa yalnız sayı + ürünlere bağlantı (silinmez). *@
                                @if (kmtsUymayan > 0)
                                {
                                    <a class="metin-kucuk" id="i-kmts-uymayan" href="/urunler">@string.Format(Y4I.KmtsUymayan, kmtsUymayan)</a>
                                }
                                <HataBandi Mesaj="@kmtsHata" Id="i-kmts-hata" />
                            </div>
                            @* M6 (müşteri 16.10: "fişe hiç gerek yok") — Tezgâh satış belgesi varsayılanı; PUT /satis-belge SAHİP/MÜDÜR. *@
                            <div class="alan">
                                <Onay ElemanId="i-satis-belge" Etiket="@SatisBelgeSozlugu.VarsayilanEtiket(Dil.Dil)"
                                      Deger="@(satisBelgeVarsayilan == "FATURA")" DegerChanged="@((bool v) => SatisBelgeDegistir(v))"
                                      Devredisi="@(SaltOkunur || !satisBelgeOkundu)" DevredisiSebebi="@P1.IsletmeYalnizSahip" />
                                <span class="metin-soluk metin-kucuk" id="i-satis-belge-aciklama">@SatisBelgeSozlugu.VarsayilanAciklama(Dil.Dil)</span>
                                <HataBandi Mesaj="@satisBelgeHata" Id="i-satis-belge-hata" />
                            </div>
                            @* D1-11 (18.10): kör sayım — gün sonunda beklenen nakit SAHİP dışına gösterilmez; PUT /kasalar/kor-sayim SAHİP/MÜDÜR. *@
                            <div class="alan">
                                <Onay ElemanId="i-kor-sayim" Etiket="@D1Sozlugu.Al(Dil.Dil).KorSayimEtiket"
                                      Deger="@korSayim" DegerChanged="@((bool v) => KorSayimDegistir(v))"
                                      Devredisi="@(SaltOkunur || !korSayimOkundu)" DevredisiSebebi="@P1.IsletmeYalnizSahip" />
                                <span class="metin-soluk metin-kucuk" id="i-kor-sayim-aciklama">@D1Sozlugu.Al(Dil.Dil).KorSayimAciklama</span>
                                <HataBandi Mesaj="@korSayimHata" Id="i-kor-sayim-hata" />
                            </div>
                            @* D1-05 (18.10): satış onayı kuralları + mesai — özet satırı, düzenleme çekmecede (SatisOnayAyarCekmecesi). *@
                            <div class="alan" id="i-satis-onayi">
                                <span class="alan-etiket">@D1Sozlugu.Al(Dil.Dil).OnayKurallari</span>
                                <span class="metin-kucuk" id="i-satis-onayi-ozet">@SatisOnayOzeti</span>
                                @if (!SaltOkunur)
                                {
                                    <button type="button" class="btn btn-ikincil btn-kucuk" id="i-satis-onayi-duzenle" @onclick="() => satisOnayCekmeceAcik = true">@D1Sozlugu.Al(Dil.Dil).OnayKurallariDuzenle</button>
                                }
                                <HataBandi Mesaj="@satisOnayHata" Id="i-satis-onayi-hata" />
                            </div>
                            <SatisOnayAyarCekmecesi Acik="satisOnayCekmeceAcik" Kapandi="() => satisOnayCekmeceAcik = false" Kaydedildi="SatisOnayKaydedildi" />
                            @* D2-12 (18.10): sadakat puanı — özet satırı, düzenleme çekmecede. *@
                            <div class="alan" id="i-sadakat">
                                <span class="alan-etiket">@D1Sozlugu.Al(Dil.Dil).SadakatAyari</span>
                                <span class="metin-kucuk" id="i-sadakat-ozet">@SadakatOzeti</span>
                                @if (!SaltOkunur)
                                {
                                    <button type="button" class="btn btn-ikincil btn-kucuk" id="i-sadakat-duzenle" @onclick="() => sadakatCekmeceAcik = true">@D1Sozlugu.Al(Dil.Dil).OnayKurallariDuzenle</button>
                                }
                            </div>
                            <SadakatAyarCekmecesi Acik="sadakatCekmeceAcik" Kapandi="() => sadakatCekmeceAcik = false" Kaydedildi="SadakatKaydedildi" />
                            @* ── PAKET P-13 · B-47 ────────────────────────────────────────
                               Kur kaynağı ve maliyet yöntemi SALT OKUNUR satırdı ve yanında
                               "bu ayar türetilir" gerekçesi yazıyordu. İkisi de doğru değildi:
                               kur kaynağının yazma ucu (PATCH /kur/kaynak) ZATEN vardı, maliyet
                               yönteminin ise HİÇBİR ucu yoktu — yani türetilmiyor, hiç
                               sorulmuyordu. İkisi de belirlenmemişken kilitli kalıyordu.
                               Artık: seçilir, kaynağı rozetle söylenir (UX-S21), boşken
                               sistem varsayılanının kullanıldığı yazılır. *@
                            <div class="alan">
                                <Secici ElemanId="i-kur-kaynagi"
                                        Etiket="@Dil.T.Yonetim.KurKaynagi"
                                        Secenekler="@KurKaynakSecenekleri"
                                        Deger="@taslakKurKaynagi"
                                        DegerChanged="@KurKaynagiSecildiDeger"
                                        Devredisi="@(SaltOkunur || kaydediliyor)"
                                        DevredisiSebebi="@SaltOkunurSebebi"
                                        BosSecenekMetni="@Dil.T.Yonetim.KurKaynagiSec" />
                                @if (string.IsNullOrWhiteSpace(tenant.KurKaynagi))
                                {
                                    <span class="rozet rozet-amber" id="i-kur-kaynagi-varsayilan">@Dil.T.Yonetim.AyarBelirlenmedi</span>
                                }
                                <span class="metin-soluk metin-kucuk" id="i-kur-kaynagi-not">@Dil.T.Yonetim.KurKaynagiNotu</span>
                                @if (SeciliDurum(kaynakYaniti?.AltinSecenekleri, tenant.KurKaynagi) is { } altinDurum)
                                {
                                    <span class="metin-soluk metin-kucuk" id="i-kur-kaynagi-durum">@altinDurum</span>
                                }
                            </div>
                            @* ── KUR KAYNAKLARI (kurucu 17.10) — döviz kaynağı altın kaynağından AYRI; faturada has
                               fiyatı (KDVK 23/e) kaynağı. Seçim TASLAKTIR (KESIF-P1 #12): kayıt aşağıdaki onayla.
                               Seçilemeyen seçenek listede SEBEBİYLE görünür (anahtar yok / izinsiz kaynak kapalı). *@
                            @if (kaynakYaniti?.DovizSecenekleri is { Count: > 0 })
                            {
                                <div class="alan">
                                    <Secici ElemanId="i-doviz-kaynagi" Etiket="@KK.DovizKaynagi"
                                            Secenekler="@DovizSecenekleri" Deger="@taslakDoviz" DegerChanged="@DovizSecildiDeger"
                                            Devredisi="@(SaltOkunur || kaydediliyor)" DevredisiSebebi="@SaltOkunurSebebi" />
                                    @if (SeciliDurum(kaynakYaniti.DovizSecenekleri, kaynakYaniti.DovizSecili) is { } dovizDurum)
                                    {
                                        <span class="metin-soluk metin-kucuk" id="i-doviz-kaynagi-durum">@dovizDurum</span>
                                    }
                                </div>
                            }
                            @if (kaynakYaniti?.OzelMatrahSecenekleri is { Count: > 0 })
                            {
                                <div class="alan">
                                    <Secici ElemanId="i-has-fiyat-kaynagi" Etiket="@KK.HasFiyatKaynagi"
                                            Secenekler="@HasFiyatSecenekleri" Deger="@taslakHasFiyat" DegerChanged="@HasFiyatSecildiDeger"
                                            Devredisi="@(SaltOkunur || kaydediliyor)" DevredisiSebebi="@SaltOkunurSebebi" />
                                    @* P-26 kuralı: has fiyatı (özel matrah) bilgisi gösteren ekran KAYNAĞINI da yazar — seçili kaynağın durumu. *@
                                    @if (SeciliDurum(kaynakYaniti.OzelMatrahSecenekleri, kaynakYaniti.OzelMatrahSecili) is { } ozelMatrahKaynakDurumu)
                                    {
                                        <span class="metin-soluk metin-kucuk" id="i-has-fiyat-durum">@ozelMatrahKaynakDurumu</span>
                                    }
                                    @if (kaynakYaniti.OzelMatrahSecili is "BIST" or "ELLE")
                                    {
                                        <button type="button" class="btn btn-ikincil btn-kucuk" id="i-kapanis-ac" disabled="@SaltOkunur" @onclick="KapanisAc">+ @KK.KapanisGir</button>
                                    }
                                </div>
                            }
                            <div class="alan">
                                <Secici ElemanId="i-maliyet-yontemi"
                                        Etiket="@Dil.T.Yonetim.MaliyetYontemi"
                                        Secenekler="@MaliyetYontemSecenekleri"
                                        Deger="@taslakMaliyet"
                                        DegerChanged="@MaliyetYontemiSecildiDeger"
                                        Devredisi="@(SaltOkunur || kaydediliyor)"
                                        DevredisiSebebi="@SaltOkunurSebebi"
                                        BosSecenekMetni="@Dil.T.Yonetim.MaliyetYontemiSec" />
                                @if (string.IsNullOrWhiteSpace(tenant.MaliyetYontemi))
                                {
                                    <span class="rozet rozet-amber" id="i-maliyet-yontemi-varsayilan">@Dil.T.Yonetim.AyarBelirlenmedi</span>
                                }
                                <span class="metin-soluk metin-kucuk" id="i-maliyet-yontemi-not">@Dil.T.Yonetim.MaliyetYontemiNotu</span>
                            </div>
                            @* ── KESIF-P1 (#12) — KRİTİK AYAR KAYDI ───────────────────────
                               Maliyet yöntemi, kur kaynağı, varsayılan ekran ve vezne ayrımı
                               seçildiği anda kaydediliyordu (odaktaki listede tekerlek bile
                               kiracının maliyet yöntemini değiştiriyordu). Artık seçim yalnız
                               TASLAKTIR; kayıt bu satırdaki düğme + ortak onay penceresiyle
                               (etki cümlesi) olur. Değişiklik yoksa satır ÇİZİLMEZ (ölü düğme yok). *@
                            @if (AyarDegisiklikleri.Count > 0)
                            {
                                <div class="kart-uyari" id="i-ayar-taslak">
                                    <p id="i-ayar-taslak-metin">@string.Format(P1.AyarDegisiklikVar, string.Join(" · ", AyarDegisiklikleri.Select(d => d.Ad)))</p>
                                    <div class="satir">
                                        <button type="button" @onclick="AyarTaslakVazgec" class="btn btn-ikincil" id="i-ayar-vazgec" disabled="@kaydediliyor">@P1.AyarVazgec</button>
                                        <button type="button" @onclick="AyarOnayAc" class="btn btn-ikincil" id="i-ayar-kaydet" disabled="@(kaydediliyor || SaltOkunur)">@P1.AyarKaydet</button>
                                    </div>
                                    @if (SaltOkunur)
                                    {
                                        <p class="metin-soluk metin-kucuk" id="i-ayar-kaydet-kilit">@SaltOkunurSebebi</p>
                                    }
                                </div>
                            }
                            <HataBandi Mesaj="@adminHata" />
                        }
                    </div>
                </div>
            }
        </Panel>
    </Sekmeler>
</div>

@* GIRDI-AILESI-2 tur 3 (doğrulayıcı KRİTİK): iki çekmecenin Telefon bileşeni kilidini ORTAK girdi kapısına
   bildirir; Kaydet kilidi ve sebebi bileşenin alan altı metninden gelir (sayfada ikinci telefon kuralı YOK). *@
<CascadingValue Value="girdiKapisi" IsFixed="true">
@* ── İşletme kimliği (çok alanlı düzenleme → ÇEKMECE, K6) ── *@
<Cekmece Acik="kimlikAcik" Varlik="isletme-kimlik" Baslik="@Dil.T.Yonetim.KimlikBaslik"
         Kaydediliyor="@kaydediliyor" KaydetAktif="@KimlikGecerli"
         KilitSebebi="@KimlikKilitSebebi"
         Kapat="KimlikKapat" Kaydet="KimlikKaydet">
    @* PİLOT GÖÇ (P-36b) — beş ham HTML girdisi ortak girdi ailesine devredildi.
       Eleman kimlikleri (#ikimlik-ad, -adres, -telefon, -vergidairesi,
       -vergino) ve hata kimlikleri (#ikimlik-*-hata) BİREBİR korundu; hata
       metinlerinin kaynağı değişmedi (Dil.T.Yonetim.*), yalnız ÇİZEN değişti. *@
    <div class="form-dikey">
        <Metin ElemanId="ikimlik-ad" Etiket="@Dil.T.Isletme.IsletmeAdi" Zorunlu="true"
               @bind-Deger="KAd" Hata="@AdMesaji" />
        @* PAKET Q10-3 (QA turu 10 KRİTİK): dört alan eskiden <ProAlan> içindeydi →
           BASİT modda çekmecede YALNIZ ad vardı ve adres/telefon/vergi dairesi/
           vergi no HİÇBİR YERDEN düzenlenemiyordu (UX-S25). Form 5 alan (≤ 8, UX-3);
           bunlar belgenin satıcı kimliğidir, her modda görünür. *@
        @* Q10-3 (doğrulayıcı bulgusu, DÜŞÜK): 500 karakterlik adres tek satırda kayıyor.
           CokSatir denendi ve gerçek tarayıcıda GERİ ALINDI: .girdi-cok-satir yazı
           ailesini devralmıyor (computed font-family: monospace) — düzeltmesi app.css /
           Bilesenler/Form (Q10-B şeridi) alanında; rapor § açık kalanlar. *@
        <Metin ElemanId="ikimlik-adres" Etiket="@Dil.T.Yonetim.Adres" EnFazla="@AlanSinirlari.Adres"
               @bind-Deger="KAdres" />
        @* QA turu 5 (YÜKSEK): "abc" kaydediliyordu; kural şube formuyla TEK kaynaktan. *@
        <Telefon ElemanId="ikimlik-telefon" Etiket="@Dil.T.Yonetim.Telefon"
                 @bind-Deger="KTelefon" />
        <Metin ElemanId="ikimlik-vergidairesi" Etiket="@Dil.T.Yonetim.VergiDairesi" EnFazla="@YonetimSinirlari.VergiDairesi"
               @bind-Deger="KVergiDairesi" />
        @* Q10-3 (gerçek tarayıcı): maxlength=11 12 haneli yapıştırmayı SESSİZCE 11'e
           kırpıyordu → başka bir numara kaydedilebiliyordu. Sınır 20: fazla hane
           kırpılmaz, alan altında "10/11 hane" mesajı çıkar (UX-S28 ruhu). *@
        @* PAKET GOC-D (envanter F2 · GIRDI_TUR_GENEL_BILESEN): genel Metin yerine anlamsal TcknVeyaVkn —
           rakam dışı tuş yazılmaz, yapıştırmada temizlenir, 10/11 hane dolunca TCKN-DOGRULAMA algoritması
           (KimlikNoDogrulayici — yeniden yazılmadı). Q10-3 "12 haneli yapıştırma sessizce 11'e kırpılır"
           kaygısı: bileşen 11 haneyi aşanı alan altında söyler ve Kaydet kilitlenir; sunucu VergiKimlik
           aynı hane/algoritma kuralıyla reddeder. Sayfanın eski VergiKimlik denetimi de kilitte kalır. *@
        <TcknVeyaVkn ElemanId="ikimlik-vergino" Etiket="@Dil.T.Yonetim.VergiNo"
                     @bind-Deger="KVergiNo" Ipucu="@IsletmeKimlikSozlugu.Al(Dil.Dil).VergiNoIpucu"
                     Hata="@VergiNoMesaji" />
        <p class="metin-soluk metin-kucuk" id="ikimlik-belge-notu">@IsletmeKimlikSozlugu.Al(Dil.Dil).BelgeNotu</p>
        <HataBandi Mesaj="@kimlikHata" Id="ikimlik-hata" />
    </div>
</Cekmece>

@* ── Şube ekle / düzenle (çok alanlı → ÇEKMECE, K6; iç alan id'leri AYNEN) ── *@
<Cekmece Acik="subeModalAcik" Varlik="sube"
         Baslik="@(sDuzenlenenId is null ? Dil.T.Isletme.YeniSube : Dil.T.Ortak.Duzenle)"
         Kaydediliyor="@kaydediliyor" KaydetAktif="@SubeGecerli" KilitSebebi="@SubeKilitSebebi"
         Kapat="() => subeModalAcik = false" Kaydet="SubeKaydet">
    @if (subeDetayYukleniyor)
    {
        <Yukleniyor />
    }
    else
    {
        <div class="form-dikey">
            <Metin ElemanId="s-ad" Etiket="@Dil.T.Isletme.SubeAdi" Zorunlu="true" EnFazla="@YonetimSinirlari.SubeAdi"
                   Deger="@sAd" DegerChanged="@(v => sAd = v ?? "")"
                   Hata="@(string.IsNullOrWhiteSpace(sAd) ? Dil.T.Yonetim.ZorunluAlan : null)"
                   HataKimligi="s-ad-hata" />
            <Metin ElemanId="s-adres" Etiket="@Dil.T.Isletme.Adres" EnFazla="@AlanSinirlari.Adres"
                   Deger="@sAdres" DegerChanged="@(v => sAdres = v ?? "")" />
            @* QA turu 1+2 (ORTA): "abc" 200 ile kabul ediliyordu. Sunucu kuralı
               UX-4d md.19 ile eklendi; ekran artık AYNI kuralı gösteriyor (UX-S31). *@
            <Telefon ElemanId="s-telefon" Etiket="@Dil.T.Isletme.Telefon"
                     Deger="@sTelefon" DegerChanged="@(v => sTelefon = v ?? "")"
                     HataKimligi="s-telefon-hata" />
            <HataBandi Mesaj="@subeModalHata" Id="s-hata" />
        </div>
    }
</Cekmece>
@* ── KUR KAYNAKLARI (17.10) — has fiyatı gün kapanışı (BIST bülteni ya da kendi değeri). POST /kur/kapanis SAHİP/MÜDÜR. ── *@
<Cekmece Acik="kapanisAcik" Varlik="kapanis" Baslik="@KK.KapanisGir"
         Kaydediliyor="@kaydediliyor" KaydetAktif="@KapanisGecerli" KilitSebebi="@(KapanisGecerli ? null : Dil.T.Yonetim.ZorunluAlan)"
         Kapat="() => kapanisAcik = false" Kaydet="KapanisKaydet">
    <div class="form-dikey">
        <Tarih ElemanId="k-gun" Etiket="@KK.Gun" Zorunlu="true" Deger="@kapanisGun" DegerChanged="@(v => kapanisGun = v)"
               EnGec="@KapanisBugun" Tur="TarihTuru.Islem" />
        <Para ElemanId="k-deger" Etiket="@KK.Kapanis" Zorunlu="true" Tur="TutarTuru.Pozitif"
              Deger="@kapanisDeger" DegerChanged="@(v => kapanisDeger = v)" />
        <Secici ElemanId="k-birim" Etiket="@KK.Birim" Secenekler="@KapanisBirimleri"
                Deger="@kapanisBirim" DegerChanged="@(v => kapanisBirim = v ?? "TL_GRAM")" />
        <Metin ElemanId="k-not" Etiket="@KK.Not" EnFazla="@AlanSinirlari.KapanisDayanakEnCok"
               Deger="@kapanisNot" DegerChanged="@(v => kapanisNot = v)" />
        <HataBandi Mesaj="@kapanisHata" Id="k-hata" />
    </div>
</Cekmece>
</CascadingValue>

@* ── Şube pasife alma onayı ── *@
@* KESIF-P1 (#12) — kritik ayar onayı: ORTAK onay penceresi (OnayKipi, ModalPencere'yi
   sarar; Pages/ ModalPencere sayacı artmaz). Etki cümlesi sunucuya gidecek değişikliği söyler. *@
<OnayKipi Acik="@ayarOnayAcik" Kimlik="i-ayar-onay" Eylem="@P1.AyarOnayBaslik"
          OnayMetni="@P1.AyarOnayDugme" VazgecMetni="@P1.AyarVazgec"
          Aciklama="@string.Join(" ", AyarDegisiklikleri.Select(d => d.Etki))"
          GeriDonusYolu="@P1.AyarOnayGeriDonus"
          Calisiyor="@kaydediliyor" Hata="@ayarOnayHata"
          Onayla="AyarKaydetOnayli" Vazgec="AyarOnayVazgec" />

<ModalPencere Acik="pasifSube is not null" Baslik="@SubePasifeAlMetni" Kapat="() => pasifSube = null">
    <div class="form-dikey">
        <p>@Dil.T.Isletme.PasifeAlOnay</p>
        <p class="hucre-vurgu">@pasifSube?.Ad</p>
        <HataBandi Mesaj="@pasifHata" />
        <div class="satir">
            <button class="btn btn-ikincil esit-pay" @onclick="() => pasifSube = null"><Kuyumcu.Web.Bilesenler.Yildiz.YildizVazgec /></button>
            <button class="btn btn-tehlike esit-pay" id="s-pasife-onayla" disabled="@kaydediliyor"
                    @onclick="SubePasifeAl">@SubePasifeAlMetni</button>
        </div>
    </div>
</ModalPencere>

@code {
    // ── PAKET S1-i — sekmeler ──
    private GorselSigmaMetinleri GS => GorselSigmaSozlugu.Al(Dil.Dil);

    private IReadOnlyList<SekmeTanimi> IsSekmeleri =>
    [
        new(GorselSigmaSozlugu.IsKimlik, GS.IsKimlik),
        new(GorselSigmaSozlugu.IsAbonelik, GS.IsAbonelik),
        new(GorselSigmaSozlugu.IsAyarlar, GS.IsAyarlar),
        new(GorselSigmaSozlugu.IsSubeler, GS.IsSubeler),
    ];


    private TenantVeri? tenant;
    private List<SubeVeri> subeler = [];

    // ── PAKET GOC-D — şube listesi ortak ızgarada (hücre içerikleri eski tablonun AYNISI) ──
    private IzgaraSiralama? subeSira;
    private IReadOnlyList<IzgaraKolonu<SubeVeri>> SubeKolonlari =>
    [
        new() { Anahtar = "ad", Baslik = Dil.T.Isletme.SubeAdi, ZorunluGorunur = true, SunucuSiralamaAdi = "ad",
                HucreSinif = _ => "hucre-vurgu", Deger = sb => sb.Ad },
        new() { Anahtar = "adres", Baslik = Dil.T.Isletme.Adres, SunucuSiralamaAdi = "adres",
                HucreSinif = _ => "metin-soluk", Deger = sb => string.IsNullOrEmpty(sb.Adres) ? null : sb.Adres },
        new() { Anahtar = "telefon", Baslik = Dil.T.Isletme.Telefon, SunucuSiralamaAdi = "telefon",
                HucreSinif = _ => "metin-soluk", Deger = sb => string.IsNullOrEmpty(sb.Telefon) ? null : sb.Telefon },
        new() { Anahtar = "durum", Baslik = Dil.T.Urun.Durum, ZorunluGorunur = true, SunucuSiralamaAdi = "durum",
                Deger = sb => sb.Aktif ? Dil.T.Ortak.Aktif : Dil.T.Ortak.Pasif,
                Hucre = sb => @<Rozet Renk="@(sb.Aktif ? "yesil" : "gri")">@(sb.Aktif ? Dil.T.Ortak.Aktif : Dil.T.Ortak.Pasif)</Rozet> },
        new() { Anahtar = "eylem", Baslik = Dil.T.Ortak.Eylemler, BaslikGizli = true, ZorunluGorunur = true, Tasinamaz = true,
                KartEtiketsiz = true, Tur = IzgaraHucreTuru.Eylem,
                Hucre = sb => @<div class="satir-eylemler">
                    <button class="btn btn-ikincil btn-kucuk" disabled="@SaltOkunur"
                            title="@(SaltOkunur ? Dil.T.Isletme.YazmaKapaliKilidi : null)"
                            @onclick="() => SubeModalAc(sb.Id)">
                        <Ikon Ad="@Ikonlar.Kalem" /> @Dil.T.Ortak.Duzenle
                    </button>
                    @if (sb.Aktif)
                    {
                        <button class="btn btn-tehlike btn-kucuk" id="@($"s-pasife-{sb.Id}")" disabled="@(AktifSubeSayisi <= 1 || SaltOkunur)"
                                title="@(SaltOkunur ? Dil.T.Isletme.YazmaKapaliKilidi : AktifSubeSayisi <= 1 ? SonSubeMetni : null)"
                                @onclick="() => pasifSube = sb">
                            @SubePasifeAlMetni
                        </button>
                    }
                    else
                    {
                        @* PAKET S-3b (kurul tur 3, YÜKSEK): pasif şube ARTIK geri açılabilir — PATCH aktif=true, ayrı uç yok. *@
                        <button class="btn btn-ikincil btn-kucuk" disabled="@(SaltOkunur || kaydediliyor)"
                                id="@($"s-aktife-{sb.Id}")"
                                title="@(SaltOkunur ? Dil.T.Isletme.YazmaKapaliKilidi : null)"
                                @onclick="() => SubeAktifeAl(sb)">
                            @Dil.T.Yonetim.SubeAktifeAl
                        </button>
                    }
                </div> },
    ];

    private bool subeYukleniyor = true, kaydediliyor, subeModalAcik, subeDetayYukleniyor;
    private string? tenantHata, adminHata, subeHata, subeModalHata, pasifHata;

    private string? basariMesaj;
    private int basariJeton;

    // ── işletme kimliği (çekmece) ──
    private bool kimlikAcik;
    private string? kimlikHata;
    private string kAd = "", kAdres = "", kTelefon = "", kVergiDairesi = "", kVergiNo = "";

    // Girdi ailesi `string?` taşır, sayfanın alanları `string` — köprü BURADA
    // kurulur ki sayfanın geri kalan mantığı (KimlikGecerli, KimlikKaydet,
