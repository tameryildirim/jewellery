    private void KimlikKapat() => kimlikAcik = false;

    /// <summary>
    /// PATCH /admin/tenant/kimlik — üç durumlu sözleşme: gövdede OLMAYAN alan
    /// korunur, null SİLER. Q10-3: beş alan HER MODDA çizildiği için gövde her
    /// modda beşini taşır (UX-S5 — çizilmeyen alan gövdeye konmaz — kuralı korunur:
    /// artık çizilmeyen kimlik alanı yoktur).
    /// </summary>
    private async Task KimlikKaydet()
    {
        if (tenant is null || !KimlikGecerli || kaydediliyor) return;
        kimlikHata = null;
        kaydediliyor = true;
        try
        {
            var govde = new
            {
                ad = kAd.Trim(),
                adres = Bos(kAdres),
                telefon = Bos(kTelefon),
                vergiDairesi = Bos(kVergiDairesi),
                vergiNo = Bos(kVergiNo),
            };
            tenant = await Api.PatchAsync<TenantVeri>("/admin/tenant/kimlik", govde);
            // İYİMSER KAYDETME YOK: çekmece ancak sunucu 200 döndükten sonra kapanır.
            kimlikAcik = false;
            BasariGoster(Dil.T.Yonetim.Kaydedildi);
        }
        catch (ApiHata ex) { kimlikHata = ex.Message; }
        kaydediliyor = false;
    }

    /// <summary>Boş dizge = "alanı sil" (açık null) — sunucu sözleşmesinin karşılığı.</summary>
    private static string? Bos(string d) => string.IsNullOrWhiteSpace(d) ? null : d.Trim();

    protected override async Task OnInitializedAsync()
    {
        Dil.Degisti += Yenile;
        await Task.WhenAll(
            TenantYukle(), SubeYukle(), VezneYukle(), KurKaynaklariYukle(), AbonelikYukle(), KmtsYukle(), SatisBelgeYukle(), KorSayimYukle(), SatisOnayYukle(), SadakatYukle());   // M6 · D1-11 · D1-05
    }

    // ── PAKET YASAL-4 / Y4-C — KMTS alanı ayarı ──────────────────────────────
    private Kuyumcu.Core.I18n.Yasal4Metinleri Y4I => Kuyumcu.Core.I18n.Yasal4Sozlugu.Al(Dil.Dil);
    private bool kmtsKullanimi, kmtsOkundu;
    private int kmtsUymayan;
    private string? kmtsHata;

    private async Task KmtsYukle()
    {
        kmtsHata = null;
        try
        {
            var a = await Api.GetAsync<System.Text.Json.JsonElement>("/kmts/ayar");
            kmtsKullanimi = a.ValueKind == System.Text.Json.JsonValueKind.Object
                            && a.TryGetProperty("acik", out var v) && v.ValueKind == System.Text.Json.JsonValueKind.True;
            kmtsUymayan = a.ValueKind == System.Text.Json.JsonValueKind.Object
                          && a.TryGetProperty("uymayanSayisi", out var u) && u.ValueKind == System.Text.Json.JsonValueKind.Number
                ? u.GetInt32() : 0;
            kmtsOkundu = true;
        }
        // UX-S28: okunamadıysa anahtar KİLİTLİ kalır ve sebebi bantta yazar.
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException)
        { kmtsHata = string.Format(Y4I.KmtsAyarHata, ex.Message); }
    }

    private async Task KmtsDegistir(bool acik)
    {
        kmtsHata = null;
        try
        {
            var a = await Api.PutAsync<System.Text.Json.JsonElement>("/kmts/ayar", new { acik });
            kmtsKullanimi = a.TryGetProperty("acik", out var v) && v.ValueKind == System.Text.Json.JsonValueKind.True;
            BasariGoster(kmtsKullanimi ? Y4I.KmtsAyarAcildi : Y4I.KmtsAyarKapatildi);
        }
        catch (ApiHata ex) { kmtsHata = ex.Message; }
    }

