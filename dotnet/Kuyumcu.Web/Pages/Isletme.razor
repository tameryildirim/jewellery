    private string MaliyetAdi(string? k) => string.IsNullOrWhiteSpace(k) ? P1.AyarBelirsiz
        : MaliyetYontemSecenekleri.FirstOrDefault(o => o.Deger == k)?.Ad ?? k;

    private string KurAdi(string? k) => string.IsNullOrWhiteSpace(k) ? P1.AyarBelirsiz : KurKaynakAdi.Ad(k, Dil.T);

    private string ModAdi(string? k) => ArayuzModuSecenekleri.FirstOrDefault(o => o.Deger == k)?.Ad ?? k ?? "";

    private string VezneAdi(bool v) => v ? Dil.T.Vezne.AyrimAcik : Dil.T.Vezne.AyrimKapali;

    /// <summary>Taslağın kayıtlı değerden farkları (kod, ad, etki cümlesi) — her biri tek PATCH.</summary>
    private List<(string Kod, string Ad, string Etki)> AyarDegisiklikleri
    {
        get
        {
            var l = new List<(string Kod, string Ad, string Etki)>(4);
            if (tenant is null) return l;
            if (taslakMaliyet.Length > 0 && taslakMaliyet != (tenant.MaliyetYontemi ?? ""))
                l.Add(("maliyet", Dil.T.Yonetim.MaliyetYontemi,
                    string.Format(P1.AyarMaliyetEtki, MaliyetAdi(tenant.MaliyetYontemi), MaliyetAdi(taslakMaliyet))));
            if (taslakKurKaynagi.Length > 0 && taslakKurKaynagi != (tenant.KurKaynagi ?? ""))
                l.Add(("kur", Dil.T.Yonetim.KurKaynagi,
                    string.Format(P1.AyarKurEtki, KurAdi(tenant.KurKaynagi), KurAdi(taslakKurKaynagi))));
            if (secilenArayuzModu != tenant.VarsayilanArayuzModu)
                l.Add(("mod", Dil.T.Arayuz.VarsayilanBaslik,
                    string.Format(P1.AyarModEtki, ModAdi(tenant.VarsayilanArayuzModu), ModAdi(secilenArayuzModu))));
            // KUR KAYNAKLARI (17.10): döviz kaynağı ve faturada has fiyatı — aynı taslak + onay akışı.
            if (kaynakYaniti is not null && taslakDoviz.Length > 0 && taslakDoviz != (kaynakYaniti.DovizSecili ?? ""))
                l.Add(("doviz", KK.DovizKaynagi,
                    string.Format(KK.DovizEtki, KurKaynakAdi.Ad(kaynakYaniti.DovizSecili, Dil.T), KurKaynakAdi.Ad(taslakDoviz, Dil.T))));
            if (kaynakYaniti is not null && taslakHasFiyat.Length > 0 && taslakHasFiyat != (kaynakYaniti.OzelMatrahSecili ?? ""))
                l.Add(("matrah", KK.HasFiyatKaynagi,
                    string.Format(KK.HasFiyatEtki, KurKaynakAdi.Ad(kaynakYaniti.OzelMatrahSecili, Dil.T), KurKaynakAdi.Ad(taslakHasFiyat, Dil.T))));
            if (vezneOkundu && taslakVezne != vezneZorunlu)
                l.Add(("vezne", Dil.T.Vezne.AyrimZorunlu,
                    string.Format(P1.AyarVezneEtki, VezneAdi(vezneZorunlu), VezneAdi(taslakVezne))));
            return l;
        }
    }

    /// <summary>Taslak kayıtlı değerlere döner — istek YOK.</summary>
    private void AyarTaslakVazgec()
    {
