    private void KimlikAc()
    {
        if (tenant is null) return;
        kimlikHata = null;
        kAd = tenant.Ad;
        kAdres = tenant.Adres ?? "";
        kTelefon = tenant.Telefon ?? "";
        kVergiDairesi = tenant.VergiDairesi ?? "";
