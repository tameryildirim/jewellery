    /// <summary>TOPLU-1 (UX-S22): tek aktif kategori varsa o; yoksa null (seçici görünür).</summary>
    private GiderKategoriVeri? TekKategori => AktifKategoriler.Take(2).Count() == 1 ? AktifKategoriler.First() : null;

    /// <summary>Gövdeye giden kategori: tek kategoride kendiliğinden, aksi hâlde kullanıcının seçimi.</summary>
    private string? SecilenKategoriId => TekKategori?.Id ?? giderKategoriId;


    // ── PAKET P-50: negatif kasadan çıkış yolu ─────────────────────────────
    /// <summary>Formda seçili (ya da tek olduğu için sabit) kasanın kaydı.</summary>
    private KasaSz.KasaVeri? SecilenKasa =>
        SecilenKasaId is { } id ? kasalar.FirstOrDefault(k => k.Id == id) : null;

    private static string BakiyeRenk(KasaSz.KasaVeri k) => k.Bakiye < 0m ? "kirmizi" : "gri";

    /// <summary>
    /// Sunucunun SON reddi (bayat bakiye: ekran yeterli sanırken kapı reddetti).
    /// Yalnız aynı kasa + aynı tutar ekrandayken gösterilir; kullanıcı kasayı ya
    /// da tutarı değiştirince kendiliğinden kalkar.
    /// </summary>
    private (string KasaId, decimal Tutar, string Metin)? sunucuYetersiz;

    /// <summary>
    /// Yetersiz bakiye bandının içeriği (kasa kimliği bağlantılar içindir). Yeni istemci
    /// tip AÇILMADI (denetim.sh SAYFA_RECORD tavanı) — değer demeti kullanılır.
    /// </summary>
    private (string KasaId, decimal Tutar, string Metin)? YetersizBandi
    {
        get
        {
            if (sunucuYetersiz is { } s && s.KasaId == SecilenKasaId && s.Tutar == giderTutar) return s;
            // PARA-DEMO-3 tur 2: kasada kart/havale payı varsa erken uyarı NAKİT cümlesiyle (toplam "kasada var" denmez).
            // TOPLU-6 (TOPLU-5 hakemi ORTA): kart/havale payı YALNIZ gerçekten fark yaratıyorsa (tutar kasa toplamına
            // sığıyor ama çekmecedeki nakde sığmıyor) söylenir; sığmıyorsa o pay yardım etmez → yalnız çıkış yolu.
            if (SecilenKasa is { } nk && SecilenAyrim is { } na && na.Kart + na.Havale > 0m && giderTutar is > 0m && giderTutar > na.Nakit)
                return (nk.Id, giderTutar.Value, giderTutar <= nk.Bakiye ? NakitBantMetni(T5, na.Kart, na.Havale, nk.ParaBirimi) : T6.GiderCikisYolu);
            if (SecilenKasa is { } k && giderTutar is > 0m && giderTutar > k.Bakiye)
                return (k.Id, giderTutar.Value, string.Format(Dil.T.Gider.YetersizBakiye, k.Ad,
                    Bicim.Para(k.Bakiye, k.ParaBirimi), Bicim.Para(giderTutar.Value, k.ParaBirimi)));
            return null;
        }
    }

