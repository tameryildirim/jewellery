                                       : tur == "BANKA" ? Dil.T.Gider.TurBanka : tur;

    // ── kilit sebepleri (UX-S30) ────────────────────────────────────────────
    private string? GiderKilidi => sayiKapisi.Sebep(Dil.Dil, "gd-tutar") ?? GiderKuralKilidi;   // ORTAK-1
    private string? GiderKuralKilidi =>
        AktifKategoriler.Any() is false ? Dil.T.Gider.KategoriYok
        : string.IsNullOrWhiteSpace(SecilenKasaId) ? Dil.T.Gider.KilitKasaSec
        : string.IsNullOrWhiteSpace(SecilenKategoriId) ? Dil.T.Gider.KilitKategoriSec
        : giderTutar is not > 0m ? Dil.T.Gider.KilitTutar
        // PAKET P-50: istemci ERKEN uyarır; tek gerçek sunucu kapısıdır (KasaBakiyeKapisi).
        // PARA-DEMO-3 tur 2 (doğrulayıcı DÜŞÜK, UX-S30): gider NAKİT çıkışıdır — kilit çekmecedeki nakde bağlı
        // (ekran zaten önce nakdi gösteriyor) ve toplam kilidinden ÖNCE gelir: tutar toplamı aşsa da sebep
        // "kasada X var" (kart/havale dahil) değil, çekmecedeki nakittir. Ayrım okunamazsa yalnız toplam kilidi.
        : SecilenKasa is { } nk && SecilenAyrim is { } na && giderTutar > na.Nakit
            // TOPLU-6 (TOPLU-5 hakemi ORTA "nakit aşımı mesajı yanıltıcı"): tek cümle, iki sayı — kural AYNI.
            ? string.Format(T6.GiderNakitYetmiyor, Bicim.Para(Math.Max(0m, na.Nakit), nk.ParaBirimi), Bicim.Para(giderTutar!.Value, nk.ParaBirimi))
        : SecilenKasa is { } sk && giderTutar > sk.Bakiye
            ? string.Format(Dil.T.Gider.KilitBakiyeYetersiz, Bicim.Para(sk.Bakiye, sk.ParaBirimi))
        : null;

