@page "/gider"
@using Kuyumcu.Contracts.Sayfalar.Gider
@using KasaSz = Kuyumcu.Contracts.Sayfalar.Kasalar
@using BankaSz = Kuyumcu.Contracts.Sayfalar.Banka
@using Kuyumcu.Web.Bilesenler.Grid
@using Kuyumcu.Core.Domain.Girdi
@inject ApiIstemci Api
@inject DilServisi Dil
@inject NavigationManager Nav
@inject ArayuzModuServisi Modu
@implements IDisposable

@* ═══════════════════════════════════════════════════════════════════════════
   PAKET P-19 (Y-11 · Y-12) — GİDER + VİRMAN

   İki kayıt ailesi, tek ekran; ikisi de "iki bacaklı atomik desen"in yüzüdür:
     • GİDER  : kasadan çıkan para + gider KATEGORİSİ → kâr-zararda ayrı satır.
     • VİRMAN : kasa/banka arası aktarım; İKİ bacak tek işlemde yazılır.

   UX sözleşmesi:
     S22 tek kasa/hesap varsa seçici gizlenir, değer salt okunur yazılır.
     S25 her kayıt ya düzeltilebilir ya gerekçesi yazılıdır (gider → STORNO).
     S27 her yazma başarı bandıyla biter, sunucunun döndürdüğü sonuç banda yazılır.
     S28 hata "kayıt yok"a çevrilmez: hata bandı ayrıdır, liste boşaltılmaz.
     S29 sunucu sınırı ekranda yazar.
     S30 kilitli düğmenin sebebi yanında yazar.
   ═══════════════════════════════════════════════════════════════════════════ *@

<PageTitle>@Marka.SayfaBasligi(Dil.T.Gider.Baslik)</PageTitle>
@* ORTAK-1 (KEŞİF #4): sayfadaki HER Sayi/Para/Gram kutusu ortak geçersiz sayı kapısına yazılır. *@
<CascadingValue Value="sayiKapisi" IsFixed="true">

@* PAKET YILDIZ-5B: Yıldız şemasında (BASİT + PRO) ekran = tuval Y_Gidervevirman (BİREBİR). Alanlar AŞAĞIDAKİ özgün gider
   formunun bileşenleridir (aynı kimlik, kapı ve kilit; özgün form bu görünümde çizilmediği için kimlik tek). Virman,
   geçmiş, kategoriler ve storno yalnız "Virman" / "Ayrıntı ekle" görünümünde (data-yz-ozgun). Öteki 8 şemada AYNEN. *@
    <Kuyumcu.Web.Bilesenler.Yildiz.YildizForm B="@YildizBaglami">
        @if (kasalar.Count > 1)
        {
            <div class="alan">
                <Secici ElemanId="gd-kasa" Etiket="@Dil.T.Gider.Kasa" Secenekler="@KasaSecenekleri"
                        @bind-Deger="giderKasaId" Hata="@giderForm.Mesaj("gd-kasa")" BosSecenekMetni="—" />
                <AlanHatasi Alan="gd-kasa" Durum="giderForm" />
                @if (GiderKilitAlani == "kasa") { @GiderKilitMesaji }
            </div>
        }
        else if (kasalar.Count == 1)
        {
            <SaltOkunur ElemanId="gd-kasa-sabit" Etiket="@Dil.T.Gider.Kasa" Deger="@kasalar[0].Ad" MakineDeger="@kasalar[0].Id" />
        }
        @if (TekKategori is null)
        {
            <div class="alan">
                <Secici ElemanId="gd-kategori" Etiket="@Dil.T.Gider.Kategori"
                        Secenekler="@(AktifKategoriler.Select(k => new SecenekOgesi(k.Id, k.Ad)).ToList())"
                        @bind-Deger="giderKategoriId" BosSecenekMetni="—" />
                <AlanHatasi Alan="gd-kategori" Durum="giderForm" />
                @if (GiderKilitAlani == "kategori") { @GiderKilitMesaji }
            </div>
        }
        <Para ElemanId="gd-tutar" Etiket="@Dil.T.Ortak.Tutar" Zorunlu="true" Tur="TutarTuru.Pozitif"
              @bind-Deger="giderTutar" Durum="giderForm" HataAlani="gd-tutar" />
        @if (GiderKilitAlani == "tutar") { @GiderKilitMesaji }
        <Metin ElemanId="gd-aciklama" Etiket="@YildizGiderSozlugu.NeIcin(Dil.Dil)" EnFazla="@AlanSinirlari.HareketAciklama"
               @bind-Deger="giderAciklama" />
    </Kuyumcu.Web.Bilesenler.Yildiz.YildizForm>
@if (YildizOzgunCiz) {
<div data-yz-ozgun="@YildizOzgunIsaret" class="dikey-bosluk">
    <SayfaBasi Anahtar="gider" AciklamaKatli="true" Baslik="@Dil.T.Gider.Baslik" Aciklama="@(Dil.BasitMi ? T6.SayfaAciklamaBasit : Dil.T.Gider.SayfaAciklama)" />

    @* PAKET S1-i: elle yazılmış tablist ORTAK Sekmeler bileşenine taşındı. id'ler
       aynı (#gd-sekme-giderler/-kategoriler/-virman); seçili sekme URL'dedir
       (?sekme=). Eski derin bağlar (/gider?sekme=virman, ?sekme=kategori) çalışır. *@

    <HataBandi Mesaj="@hata" Id="gd-hata" />
    <BasariBandi Mesaj="@basari" Id="gd-basari" Jeton="@basariJeton" />

    <Sekmeler Onek="gd" Liste="@GdSekmeleri" Etiket="@GS.GiderSerit">
        <Panel Context="gdKod">
    @if (Durum(gdKod) != sekme)
    {
        @* seçili olmayan panel boş — tek form/liste görünür *@
    }
    else if (yukleniyor)
    {
        <Yukleniyor />
    }
    else if (sekme == "GIDER")
    {
        <div class="kart">
            <div class="kart-baslik"><h3>@Dil.T.Gider.YeniGider</h3></div>
            @* PAKET P-50: EKSİ bakiyeli kasa seçiliyken formun ÜSTÜNDE kalıcı uyarı şeridi +
               kasa raporuna bağlantı. Kural sunucudadır (KasaBakiyeKapisi, P-44); ekran
               yalnız ERKEN söyler ve çıkış yolunu gösterir. *@
            @if (SecilenKasa is { } eksiKasa && eksiKasa.Bakiye < 0m)
            {
                <div class="bant bant-uyari" role="status" id="gd-eksi-kasa-uyari">
                    <span>@string.Format(Dil.BasitMi ? T6.EksiKasaUyariBasit : Dil.T.Gider.EksiKasaUyari, Bicim.Para(eksiKasa.Bakiye, eksiKasa.ParaBirimi))</span>
                    <a href="/raporlar/kasa" id="gd-eksi-kasa-rapor">@Dil.T.Gider.KasaRaporunaGit</a>
                </div>
            }
            <div class="form-dikey">
                @* UX-S22: tek kasa varsa seçici GİZLENİR, değer salt okunur satırdır. *@
                @if (kasalar.Count > 1)
                {
                    <div class="alan">
                        <Secici ElemanId="gd-kasa"
                                Etiket="@Dil.T.Gider.Kasa"
                                Secenekler="@KasaSecenekleri"
                                @bind-Deger="giderKasaId"
                                Hata="@giderForm.Mesaj("gd-kasa")"
                                BosSecenekMetni="—" />
                        <AlanHatasi Alan="gd-kasa" Durum="giderForm" />
                        @if (GiderKilitAlani == "kasa") { @GiderKilitMesaji }
                    </div>
                }
                else if (kasalar.Count == 1)
                {
                    <p class="metin-kucuk metin-soluk" id="gd-kasa-sabit">
                        @Dil.T.Gider.Kasa: @kasalar[0].Ad (@Bicim.ParaIsareti(kasalar[0].ParaBirimi))
                    </p>
                }
                @* PAKET P-50 / UX-S21: sistemin bildiği bakiye kullanıcıya SÖYLENİR (para
                   birimiyle, tr-TR biçiminde — UX-S32). Eksi bakiye kırmızı rozet taşır. *@
                @* PARA-DEMO-3 (hakem ORTA): gider nakit çıkışıdır — önce ÇEKMECEDEKİ NAKİT (sunucu: /kasalar/nakit-ayrimi,
                   Kasalar ve Panel ile aynı uç), toplam (kart/havale dahil) ikinci sırada. Ayrım okunamazsa toplam
                   "nakit" diye basılmaz: eski "Kasa bakiyesi" satırı + kısa hata. *@
                @if (SecilenKasa is { } nakitKasa && SecilenAyrim is { } ayr)
                {
                    <p class="metin-kucuk" id="gd-kasa-nakit">
                        @PD3.GiderNakit:
                        <Rozet Renk="@(ayr.Nakit < 0m ? "kirmizi" : "yesil")">@Bicim.Para(ayr.Nakit, nakitKasa.ParaBirimi)</Rozet>
                    </p>
                }
                else if (SecilenKasa is not null && nakitAyrimHata is { } nah)
                {
                    <p class="metin-kucuk metin-soluk" id="gd-kasa-ayrim-hata">@nah</p>
                }
                @* TOPLU-5 (hakem DÜŞÜK "asıl sayı en küçük yazı" + zorunlu önce): BASİT'te çekmecedeki nakit
                   görünürken toplam (kart/havale dahil) satırı çizilmez — gider nakitten ödenir; PRO'da AYNEN.
                   Ayrım okunamazsa toplam iki modda da görünür (bilgi kaybolmaz). *@
                @if (SecilenKasa is { } bakiyeKasa && !(Dil.BasitMi && SecilenAyrim is not null))
                {
                    <p class="metin-kucuk@(SecilenAyrim is null ? "" : " metin-soluk")" id="gd-kasa-bakiye">
                        @(SecilenAyrim is null ? Dil.T.Gider.KasaBakiyesi : PD3.GiderToplam):
                        <Rozet Renk="@BakiyeRenk(bakiyeKasa)">@Bicim.Para(bakiyeKasa.Bakiye, bakiyeKasa.ParaBirimi)</Rozet>
                        @if (bakiyeKasa.Bakiye < 0m)
                        {
                            <Rozet Renk="kirmizi">@Dil.T.Gider.KasaBakiyeEksi</Rozet>
                        }
                    </p>
                }

                @* TOPLU-1 (QA10, UX-S22): tek aktif kategori varsa seçici "—" ile açılıp kullanıcıdan seçim
                   istiyordu. Tek seçenekte seçici GİZLENİR: değer salt okunur satır, gövdeye kendiliğinden
                   girer (kasa satırıyla aynı kural). İkiden fazla kategoride seçici aynen. *@
                @if (TekKategori is { } tk)
                {
                    <SaltOkunur ElemanId="gd-kategori-sabit" Etiket="@Dil.T.Gider.Kategori" Deger="@tk.Ad"
                                KaynakRozeti="@Toplu1Sozlugu.Al(Dil.Dil).GiderTekKategoriKaynak" MakineDeger="@tk.Id" />
                }
                else
                {
                    <div class="alan">
                        <Secici ElemanId="gd-kategori"
                                Etiket="@Dil.T.Gider.Kategori"
                                Secenekler="@(AktifKategoriler.Select(k => new SecenekOgesi(k.Id, k.Ad)).ToList())"
                                @bind-Deger="giderKategoriId"
                                BosSecenekMetni="—" />
                        <AlanHatasi Alan="gd-kategori" Durum="giderForm" />
                        @if (GiderKilitAlani == "kategori") { @GiderKilitMesaji }
                    </div>
                }

                @* PAKET GOC-A (K9): Core tutar kuralı; sunucu AYNI kural (2'den fazla ondalık 400 — yuvarlama yok). *@
                <Para ElemanId="gd-tutar" Etiket="@Dil.T.Ortak.Tutar" Zorunlu="true" Tur="TutarTuru.Pozitif"
                      @bind-Deger="giderTutar" Durum="giderForm" HataAlani="gd-tutar" />
                @if (GiderKilitAlani == "tutar") { @GiderKilitMesaji }

                @* SON-KALANLAR (QA K16, "zorunlu önce"): isteğe bağlı açıklama "+ Not ekle" arkasında; yazılmışsa açık kalır. *@
                @if (giderNotAcik || !string.IsNullOrEmpty(giderAciklama))
                {
                <Metin ElemanId="gd-aciklama" Etiket="@Dil.T.Ortak.Aciklama" EnFazla="@AlanSinirlari.HareketAciklama"
                       @bind-Deger="giderAciklama" />
                }
                else
                {
                    <div class="satir" id="gd-istege-bagli">
                        <button type="button" class="dugme dugme-ikincil dugme-kucuk" id="gd-not-ekle" @onclick="() => giderNotAcik = true">@PD2G.NotEkle</button>
                    </div>
                }

                <div class="satir-arasi">
                    <button id="gd-kaydet" type="button" class="dugme dugme-birincil" disabled="@(GiderKilidi is not null || kaydediliyor)" @onclick="GiderKaydet">
                        @Dil.T.Gider.GiderKaydet
                    </button>
                    @* UX-S30: kilitli düğmenin sebebi YAZILIR — TOPLU-6 (TOPLU-5 hakemi DÜŞÜK "gerekçe uzakta ve 12 px"):
                       düğmenin yanında değil, eksik olan ALANIN altında 14 px alan mesajı (#gd-kaydet-kilit; GiderKilitAlani). *@
                </div>

                @* PAKET P-50: YETERSİZ BAKİYE BANDI — sunucunun ham metni ("-738298.80 TRY")
                   EKRANA BASILMAZ; biçimlendirilmiş cümle + iki ÇIKIŞ YOLU bağlantısı.
                   Sunucu reddi (bayat bakiye) ya da istemcinin erken uyarısı aynı bandı üretir. *@
                @if (YetersizBandi is { } yb)
                {
                    @* PARA-DEMO-3 tur 2 (tasarım hakemi KRİTİK): iki çıkış yolu metnin İÇİNDE alt çizgisiz, aynı renkte
                       bağlantıydı ("…eksiye düşemez. Kasaya giriş yap Virman yap" tek cümle gibi okunuyordu). Artık
                       metnin ALTINDA ayrı satırda, ikincil küçük düğme görünümünde (kimlikler aynı). *@
                    <div class="bant bant-hata" role="alert" id="gd-yetersiz">
                        <p id="gd-yetersiz-metin">@yb.Metin</p>
                        <div class="satir mt-1" id="gd-yetersiz-eylemler">
                            <a href="@GirisBaglantisi(yb.KasaId)" id="gd-yetersiz-giris" class="dugme dugme-ikincil dugme-kucuk">@Dil.T.Gider.KasayaGirisYap</a>
                            <a href="@VirmanBaglantisi(yb.KasaId)" id="gd-yetersiz-virman" class="dugme dugme-ikincil dugme-kucuk">@(Dil.BasitMi ? T6.VirmanYapBasit : Dil.T.Gider.VirmanYapBaglanti)</a>
                        </div>
                    </div>
                }
                @* Y-17 (20.10): son kaydedilen giderin fiş fotoğrafı — kapalı katlanır (zorunlu önce); belge deposu GIDER dalı. *@
                @if (sonGiderId is { } sgId)
                {
                    <Katlanir Id="gd-belge" Baslik="@GiderBelgeSozlugu.Ekle(Dil.Dil)">
                        <p class="metin-kucuk metin-soluk" id="gd-belge-aciklama">@GiderBelgeSozlugu.Aciklama(Dil.Dil)</p>
                        <BelgeYukleyici SahipTuru="GIDER" SahipId="@sgId" Turler="@(new[] { "FOTOGRAF", "EK" })" Onek="gd-belge" Kamera="true" Ikincil="true" />
                    </Katlanir>
                }
            </div>
        </div>

        @* SON-KALANLAR (QA K15/K17, kurucu kuralı "geçmiş kayıtlar katlanır"): geçmiş giderler KAPALI akordeon
           (ortak Bilesenler/Katlanir); ekran açılışta yalnız yapılacak işi (yeni gider) gösterir. Liste sayfa
           açılışında okunur (rozet sayısı gerçek); hata bandı akordeonun DIŞINDA (#gd-hata, UX-S28). Satır,
           düğme ve toplam kimlikleri DEĞİŞMEDİ. *@
        <Katlanir Id="gd-gecmis" Baslik="@Dil.T.Gider.SekmeGiderler" Sayi="@(veriGeldi ? giderler.Count : null)"
                  Sinif="zo-gecmis" BaslangictaAcik="@giderGecmisAcik" Degisti="@(v => giderGecmisAcik = v)">
            <p class="metin-kucuk metin-soluk" id="gd-toplam">
                @Dil.T.Gider.ToplamGider: @ToplamMetni
            </p>
            @* UX-S28: boş durum YALNIZ istek BAŞARILIYKEN çıkar. Hata varsa liste
               boşaltılmaz ve "kayıt yok" YAZILMAZ — hata bandı yukarıda durur. *@
            @if (giderler.Count == 0 && veriGeldi)
            {
                <BosDurum Mesaj="@Dil.T.Gider.GiderYok" />
            }
            else
            {
                @* PAKET GOC-A — ORTAK IZGARA (grid:gider:gd-gider). Liste sunucu sınırlı → sınıra değdiyse sıralama kapalı. *@
                <Izgara T="GiderSatiri" Ekran="gider" GridId="gd-gider" Kolonlar="@GiderKolonlari"
                        Ogeler="@IzgaraYerelSiralama.Uygula(giderler, giderDahaFazlasi ? null : giderSira, GiderKolonlari)"
                        Baslik="@Dil.T.Gider.SekmeGiderler" YapiskanIlkSutun="false"
                        SiralamaDegisti="@GiderSiralandi" GecerliSiralama="@giderSira" TercihIstemcisi="@GdTercih" />

                @if (giderDahaFazlasi)
                {
                    <p class="metin-kucuk metin-soluk" id="gd-sinir">@Dil.T.Gider.DahaFazlasiVar</p>
                }
            }
            @* UX-S25: gider tutarı yerinde düzeltilemez — GEREKÇESİ yazılıdır. TOPLU-5 (hakem DÜŞÜK "boş listede
               'Bu kayıt değiştirilemez' kutusu"): kutu yalnız listede KAYIT varken çizilir (düzeltilecek kayıt yokken
               "bu kayıt" yoktur). Metin ve id aynen. *@
            @if (giderler.Count > 0)
            {
                <DegismezIpucu Varlik="Gider" Gerekce="@(Dil.BasitMi ? StornoOnekiSozlugu.Al(Dil.Dil).GiderDegismezNotuBasit : Dil.T.Gider.GiderDegismezNotu)"
                               AlternatifYol="@Dil.T.Gider.Storno" />
            }
        </Katlanir>
    }
    else if (sekme == "KATEGORI")
    {
        <div class="kart">
            <div class="kart-baslik"><h3>@Dil.T.Gider.YeniKategori</h3></div>
            <div class="form-dikey">
                <Metin ElemanId="gd-kat-ad" Etiket="@Dil.T.Gider.KategoriAdi" Zorunlu="true" EnFazla="@AlanSinirlari.KategoriAdi"
                       @bind-Deger="yeniKategoriAd" Durum="kategoriForm" HataAlani="gd-kat-ad" />
                <Metin ElemanId="gd-kat-aciklama" Etiket="@Dil.T.Ortak.Aciklama" EnFazla="@AlanSinirlari.HareketAciklama"
                       @bind-Deger="yeniKategoriAciklama" />
                <div class="satir-arasi">
                    <button id="gd-kat-ekle" type="button" class="dugme dugme-birincil" disabled="@(KategoriKilidi is not null || kaydediliyor)" @onclick="KategoriEkle">
                        @Dil.T.Ortak.Ekle
                    </button>
                    @if (KategoriKilidi is { } ks)
                    {
                        <span class="metin-kucuk metin-soluk" id="gd-kat-ekle-kilit">@ks</span>
                    }
                </div>
            </div>
        </div>

        <div class="kart">
            <div class="kart-baslik"><h3>@Dil.T.Gider.SekmeKategoriler</h3></div>
            @if (kategoriler.Count == 0 && veriGeldi)
            {
                <BosDurum Mesaj="@Dil.T.Gider.KategoriYok" />
            }
            else
            {
                @* PAKET GOC-A — ORTAK IZGARA (grid:gider:gd-kategori). Kategori listesi TAMDIR → yerel sıralama. *@
                <Izgara T="GiderKategoriVeri" Ekran="gider" GridId="gd-kategori" Kolonlar="@KategoriKolonlari"
                        Ogeler="@IzgaraYerelSiralama.Uygula(kategoriler, kategoriSira, KategoriKolonlari)"
                        SatirSinif="@(k => k.Aktif ? null : "metin-soluk")"
                        Baslik="@Dil.T.Gider.SekmeKategoriler" YapiskanIlkSutun="false"
                        SiralamaDegisti="@KategoriSiralandi" GecerliSiralama="@kategoriSira" TercihIstemcisi="@GdTercih" />
                <p class="metin-kucuk metin-soluk" id="gd-kat-silinmez">@Dil.T.Gider.KategoriSilinmez</p>
            }
        </div>
    }
    else
    {
        <div class="kart">
            @* TOPLU-5 (hakem ORTA "Virman BASİT jargon"): BASİT'te başlık ve açıklama "bacak/ciro"suz; PRO AYNEN. *@
            @* TOPLU-6 (TOPLU-5 hakemi ORTA): açıklama satırı başlığın yanındaki ⓘ içinde (metin ve id AYNI). *@
            <div class="kart-baslik t4-ipucu-satir" id="gd-virman-baslik-satir">
                <h3>@(Dil.BasitMi ? T5.VirmanBaslikBasit : Dil.T.Gider.VirmanBaslik)</h3>
                <details class="zo-ipucu" id="gd-virman-ipucu">
                    <summary aria-label="@T6.VirmanAciklamaBilgi">i</summary>
                    <p id="gd-virman-aciklama">@(Dil.BasitMi ? T5.VirmanAciklamaBasit : Dil.T.Gider.VirmanAciklama)</p>
                </details>
            </div>
            @* TOPLU-6 (TOPLU-5 hakemi ORTA "aktarılacak hesap yoksa boş durum"): banka hesabı yoksa bunu söyler ve
               ekleme yoluna götürür; iki taraf bile yoksa form yerine boş durum (kasa ↔ kasa aktarımı, iki kasa
               varsa, AYNEN mümkün). Kural/uç DEĞİŞMEDİ. *@
            @if (veriGeldi && !Taraflar.Any(t => t.Tur == "BANKA") && Taraflar.Count >= 2)
            {
                <p class="bant t6-bant-bilgi" id="gd-v-banka-yok" role="status">
                    <span>@T6.VirmanBankaYok</span>
                    <a href="/banka" id="gd-v-banka-ekle">@T6.VirmanBankaEkle →</a>
                </p>
            }
            @if (veriGeldi && Taraflar.Count < 2)
            {
                <BosDurum Mesaj="@T6.VirmanHesapYok" />
                <p class="t6-bos-eylem"><a href="/banka" class="dugme dugme-ikincil" id="gd-v-hesap-yok-ekle">@T6.VirmanBankaEkle</a></p>
            }
            else
            {
            <div class="form-dikey">
                <div class="alan">
                    <Secici ElemanId="gd-v-kaynak"
                            Etiket="@Dil.T.Gider.Kaynak"
                            Secenekler="@(Taraflar.Select(t => new SecenekOgesi(Anahtar(t), Etiket(t))).ToList())"
                            @bind-Deger="virmanKaynak"
                            @bind-Deger:after="VirmanKaynakDegisti"
                            BosSecenekMetni="—" />
                    <AlanHatasi Alan="gd-v-kaynak" Durum="virmanForm" />
                    @if (VirmanKilitAlani == "kaynak") { @VirmanKilitMesaji }
                </div>
                @* PAKET PARA-DEMO tur 2: kasada kart/havale payı varsa aktarılan aracı sor (yoksa gizli). *@
                @if (virmanAyrimHata is not null)
                {
                    <HataBandi Mesaj="@string.Format(PdV.VirmanAyrimHata, virmanAyrimHata)" Id="gd-v-arac-hata" />
                }
                @if (VirmanAracGorunur)
                {
                    <div class="alan">
                        <Secici ElemanId="gd-v-arac"
                                Etiket="@PdV.VirmanAracEtiket"
                                Secenekler="@VirmanAracSecenekleri"
                                @bind-Deger="virmanArac" />
                        @* TOPLU-5: açıklama paragrafı ⓘ içinde (metin ve id aynen). *@
                        <div class="t4-ipucu-satir" id="gd-v-arac-ipucu-satir">
                            <details class="zo-ipucu" id="gd-v-arac-bilgi">
                                <summary aria-label="@T5.VirmanAracBilgi">i</summary>
                                <p id="gd-v-arac-ipucu">@PdV.VirmanAracIpucu</p>
                            </details>
                            <span class="metin-soluk">@T5.VirmanAracBilgi</span>
                        </div>
                    </div>
                }
                <div class="alan">
                    @* UX-S26: iki seçici TEK diziden üretilir. PARA-DEMO-2 (madde 10): ayrı <label for="gd-v-hedef"> kalktı —
                       Secici kendi etiketini ("Hedef") basıyordu, etiket iki kez görünüyordu. *@
                    <Secici ElemanId="gd-v-hedef"
                            Etiket="@Dil.T.Gider.VirmanHedef"
                            Secenekler="@TarafSecenekleri"
                            @bind-Deger="virmanHedef"
                            Hata="@virmanForm.Mesaj("gd-v-hedef")"
                            BosSecenekMetni="—" />
                    <AlanHatasi Alan="gd-v-hedef" Durum="virmanForm" />
                    @if (VirmanKilitAlani == "hedef") { @VirmanKilitMesaji }
                </div>
                <Para ElemanId="gd-v-tutar" Etiket="@Dil.T.Ortak.Tutar" Zorunlu="true" Tur="TutarTuru.Pozitif"
                      @bind-Deger="virmanTutar" Durum="virmanForm" HataAlani="gd-v-tutar" />
                @if (VirmanKilitAlani == "tutar") { @VirmanKilitMesaji }
                @* PAKET GOC-A (envanter C · gd-v-aciklama "ekran 500, sunucu 500 − kasa/hesap adları"): kasa bacağı varsa
                   açıklama "VİRMAN: kaynak → hedef · " etiketiyle birlikte 500'e sığmalı — kalan yer EKRANDA hesaplanır ve
                   maxlength + ipucu olarak yazılır (sunucu aynı hesabı yapıp kalan yeri söyler). *@
                <Metin ElemanId="gd-v-aciklama" Etiket="@Dil.T.Ortak.Aciklama" EnFazla="@VirmanAciklamaSiniri"
                       Ipucu="@(VirmanAciklamaSiniri < AlanSinirlari.HareketAciklama ? string.Format(GocASozlugu.Al(Dil.Dil).VirmanAciklamaKalan, VirmanAciklamaSiniri) : null)"
                       @bind-Deger="virmanAciklama" />
                <div class="satir-arasi">
                    <button id="gd-v-kaydet" type="button" class="dugme dugme-birincil" disabled="@(VirmanKilidi is not null || kaydediliyor)" @onclick="VirmanKaydet">
                        @(Dil.BasitMi ? T6.VirmanYapBasit : Dil.T.Gider.VirmanYap)
                    </button>
                    @* TOPLU-6: kilit gerekçesi ilgili alanın altında (#gd-v-kaydet-kilit; VirmanKilitAlani). *@
                </div>
                @* PARA-DEMO-3 tur 2 (tasarım hakemi KRİTİK): virman reddi sayfanın EN ÜSTÜNDEKİ #gd-hata'ya yazılıyordu
                   (1280'de y=−163, 375'te y=−409): "Virmanı kaydet"e basan kullanıcı hiçbir tepki görmüyordu. Ret ve
                   sonuç artık düğmenin HEMEN ALTINDA, formun içinde (DoD EK 3: sessiz etkisizlik yasak). *@
                <HataBandi Mesaj="@virmanHata" Id="gd-v-hata" />
                <BasariBandi Mesaj="@virmanSonuc" Id="gd-v-sonuc" Jeton="@basariJeton" />
            </div>
            }
        </div>

        @* SON-KALANLAR (QA K17): geçmiş para aktarımları KAPALI akordeon (kimlikler aynen). *@
        <Katlanir Id="gd-virman-gecmis" Baslik="@(Dil.BasitMi ? T6.VirmanListeBasit : Dil.T.Gider.SekmeVirman)" Sayi="@(veriGeldi ? virmanlar.Count : null)"
                  Sinif="zo-gecmis" BaslangictaAcik="@virmanGecmisAcik" Degisti="@(v => virmanGecmisAcik = v)">
            @if (virmanlar.Count == 0 && veriGeldi)
            {
                <BosDurum Mesaj="@(Dil.BasitMi ? T6.VirmanYokBasit : Dil.T.Gider.VirmanYok)" />
            }
            else
            {
                @* PAKET GOC-A — ORTAK IZGARA (grid:gider:gd-virman-liste — "gd-virman-ipucu" sayfa kimliğiyle çakışmasın). Liste sunucu sınırlı → sınıra değdiyse sıralama kapalı. *@
                <Izgara T="VirmanSatiri" Ekran="gider" GridId="gd-virman-liste" Kolonlar="@VirmanKolonlari"
                        Ogeler="@IzgaraYerelSiralama.Uygula(virmanlar, virmanDahaFazlasi ? null : virmanSira, VirmanKolonlari)"
                        Baslik="@Dil.T.Gider.SekmeVirman" YapiskanIlkSutun="false"
                        SiralamaDegisti="@VirmanSiralandi" GecerliSiralama="@virmanSira" TercihIstemcisi="@GdTercih" />
                @if (virmanDahaFazlasi)
                {
                    <p class="metin-kucuk metin-soluk" id="gd-v-sinir">@Dil.T.Gider.DahaFazlasiVar</p>
                }
            }
            @* TOPLU-5 (hakem ORTA "hizasız alt not"): not kartın iç dolgusuyla hizalı (t5-kart-not) ve yalnız
               listede kayıt varken; BASİT'te "bacak/storno"suz dil. *@
            @if (virmanlar.Count > 0)
            {
                <p class="metin-kucuk metin-soluk t5-kart-not" id="gd-v-iki-bacak">@(Dil.BasitMi ? T5.VirmanIkiBacakBasit : Dil.T.Gider.IkiBacakNotu)</p>
            }
        </Katlanir>
    }
        </Panel>
    </Sekmeler>
</div>
}

@* ── Kategori düzenleme ÇEKMECESİ (tek düzenleme kalıbı: çok alanlı → Cekmece) ── *@
@* Y-17 (20.10): geçmiş giderin fiş fotoğrafı çekmecesi (yalnız yükleme; kasa satırı değişmez). *@
<Cekmece Acik="belgeGider is not null" Varlik="gider-belge" Baslik="@GiderBelgeSozlugu.Baslik(Dil.Dil)" Kapat="() => belgeGider = null" KaydetGoster="false">
    @if (belgeGider is { } bg)
    {
        <p class="metin-kucuk metin-soluk" id="gd-belge-cekmece-ozet">@(bg.KategoriAdi ?? "—") · @Bicim.Para(Math.Abs(bg.Tutar), bg.ParaBirimi) · @Bicim.Tarih(bg.Tarih, Dil.Dil)</p>
        <BelgeYukleyici SahipTuru="GIDER" SahipId="@bg.Id" Turler="@(new[] { "FOTOGRAF", "EK" })" Onek="gd-belge-satir" Kamera="true" Ikincil="true" />
    }
</Cekmece>
<Cekmece Acik="duzenleKategori is not null" Varlik="gider-kategori" Baslik="@Dil.T.Gider.KategoriDuzenle"
         Kapat="() => duzenleKategori = null" Kaydet="KategoriGuncelle" Kaydediliyor="@kaydediliyor"
         KaydetAktif="@(!kaydediliyor)">
    <div class="form-dikey">
        <Metin ElemanId="gd-kd-ad" Etiket="@Dil.T.Gider.KategoriAdi" Zorunlu="true" EnFazla="@AlanSinirlari.KategoriAdi"
               @bind-Deger="duzenleAd" Durum="duzenleForm" HataAlani="gd-kd-ad" />
        <Metin ElemanId="gd-kd-aciklama" Etiket="@Dil.T.Ortak.Aciklama" EnFazla="@AlanSinirlari.HareketAciklama"
               @bind-Deger="duzenleAciklama" />
        <p class="metin-kucuk metin-soluk" id="gd-kd-pasif-notu">@Dil.T.Gider.KategoriPasifNotu</p>
        <HataBandi Mesaj="@cekmeceHata" Id="gd-kd-hata" />
    </div>
</Cekmece>

@* ── Yıkıcı eylem ONAYI (ModalPencere YALNIZ burada: storno) ── *@
<ModalPencere Acik="@(stornoGider is not null || stornoVirman is not null)"
              Baslik="@Dil.T.Gider.Storno" Kapat="StornoKapat">
    <div class="form-dikey">
        <p id="gd-storno-onay">@(stornoVirman is not null ? (Dil.BasitMi ? T6.VirmanStornoOnayBasit : Dil.T.Gider.VirmanStornoOnay) : Dil.T.Gider.StornoOnay)</p>
        <CokSatir ElemanId="gd-storno-gerekce" Etiket="@Dil.T.Gider.StornoGerekcesi" Zorunlu="true"
                  Satir="3" EnFazla="@AlanSinirlari.GerekceEnCok"
                  @bind-Deger="stornoGerekce" Durum="stornoForm" HataAlani="gd-storno-gerekce" />
        <HataBandi Mesaj="@modalHata" Id="gd-storno-hata" />
        <div class="satir-arasi">
            <button id="gd-storno-vazgec" type="button" class="dugme dugme-ikincil" @onclick="StornoKapat">
                <Kuyumcu.Web.Bilesenler.Yildiz.YildizVazgec />
            </button>
            <button id="gd-storno-onayla" type="button" class="dugme dugme-tehlike" disabled="@(StornoKilidi is not null || kaydediliyor)" @onclick="StornoOnayla">
                @Dil.T.Gider.Storno
            </button>
            @if (StornoKilidi is { } ss)
            {
                <span class="metin-kucuk metin-soluk" id="gd-storno-kilit">@ss</span>
            }
        </div>
    </div>
</ModalPencere>
</CascadingValue>

@code {
    /// <summary>ORTAK-1 (KEŞİF #4): ortak geçersiz sayı kapısı — "1.500" gibi anlaşılamayan sayı varken ilgili formun Kaydet'i PASİF, gövdeye 0/eski değer GİTMEZ.</summary>
    private GecersizAlanKapisi? _sayiKapisi;
    private GecersizAlanKapisi sayiKapisi => _sayiKapisi ??= new(() => InvokeAsync(StateHasChanged));
    // ── P-36c GÖÇ YARDIMCILARI ──────────────────────────────────────────
    /// <summary>
    /// PAKET P-50 / UX-S21: seçicideki her kasa GÜNCEL bakiyesini para birimiyle
    /// (tr-TR biçimi, Bicim.Para) taşır — kullanıcı eksi kasayı seçmeden görür.
    /// </summary>
    /// <summary>
    /// TOPLU-5 (hakem YÜKSEK "kasa seçicisi kasa TOPLAMINI gösteriyor"): gider nakit çıkışıdır — seçenekte
    /// ÇEKMECEDEKİ NAKİT yazar (sunucu /kasalar/nakit-ayrimi; Kasalar ve Panel ile aynı uç). Ayrım okunamazsa
    /// bakiye kaybolmaz (P-50: seçmeden görülür) ama "toplam" diye ETİKETLENİR — nakit sanılmaz. Seçilen kimlik AYNEN.
    /// </summary>
    private IReadOnlyList<SecenekOgesi> KasaSecenekleri =>
        [.. kasalar.Select(k => new SecenekOgesi(k.Id, KasaSecenekMetni(k)))];

    private string KasaSecenekMetni(KasaSz.KasaVeri k)
    {
        var ad = $"{k.Ad} ({Bicim.ParaIsareti(k.ParaBirimi)})";
        return nakitAyrimHata is null && nakitAyrimlari.TryGetValue(k.Id, out var a)
            ? string.Format(T5.GiderKasaNakitSecenek, ad, Bicim.Para(a.Nakit, k.ParaBirimi))
            : string.Format(T5.GiderKasaToplamSecenek, ad, Bicim.Para(k.Bakiye, k.ParaBirimi));
    }

    /// <summary>TOPLU-5 metinleri (Sozlukler.Toplu5.cs).</summary>
    private Toplu5Metinleri T5 => Toplu5Sozlugu.Al(Dil.Dil);

    /// <summary>
    /// TOPLU-5 (hakem ORTA "nakit aşımında aynı bilgi iki kez; 'havale (0 ₺)' gereksiz"): istemcinin ERKEN
    /// uyarısı yalnız kilidin söylemediğini söyler — kasadaki kart/havale payı çekmecede değildir. Sayılar
    /// (nakit X var) Kaydet kilidinde zaten yazılı; SIFIR kalem yazılmaz. Sunucu reddi metni DEĞİŞMEDİ.
    /// </summary>
    public static string NakitBantMetni(Toplu5Metinleri t5, decimal kart, decimal havale, string paraBirimi)
    {
        var parca = new List<string>(2);
        if (kart > 0m) parca.Add(string.Format(t5.GiderKartPayi, Bicim.Para(kart, paraBirimi)));
        if (havale > 0m) parca.Add(string.Format(t5.GiderHavalePayi, Bicim.Para(havale, paraBirimi)));
        return string.Format(t5.GiderNakitBant, string.Join(", ", parca));
    }

    private IReadOnlyList<SecenekOgesi> TarafSecenekleri =>
        [.. Taraflar.Select(t => new SecenekOgesi(Anahtar(t), Etiket(t)))];

    // ── durum ───────────────────────────────────────────────────────────────
    private string sekme = "GIDER";

    /// <summary>
    /// PAKET P-19 (Y-11) — sapma S1 kapanışı: kasa/banka ekranındaki virman
    /// bacağı satırı buraya DERİN BAĞ ile gelir (/gider?sekme=virman) ve
    /// Virman sekmesi doğrudan açılır. Bilinmeyen değer sessizce yok sayılır,
    /// varsayılan sekme (GIDER) korunur — kullanıcı boş ekranla karşılaşmaz.
    /// </summary>
    [SupplyParameterFromQuery(Name = "sekme")]
    public string? SekmeSorgu { get; set; }
    private bool yukleniyor = true;
    /// <summary>UX-S28: yalnız BAŞARILI bir yükleme sonrası true. Boş durumun ön koşulu.</summary>
    private bool veriGeldi;
    private bool kaydediliyor;
    private string? hata;
    private string? basari;
    private string? sonGiderId;        // Y-17: son kaydedilen giderin fotoğrafı için
    private GiderSatiri? belgeGider;   // Y-17: satırdan açılan belge çekmecesi
    private int basariJeton;
    private string? modalHata;
    private string? cekmeceHata;

    private List<GiderKategoriVeri> kategoriler = [];

    // ── PAKET GOC-A — virman açıklamasının kalan yeri (sunucu VirmanServisi ile AYNI hesap) ──────
    private int VirmanAciklamaSiniri
    {
        get
        {
            var k = Taraflar.FirstOrDefault(t => Anahtar(t) == virmanKaynak);
            var h = Taraflar.FirstOrDefault(t => Anahtar(t) == virmanHedef);
            if (k is null || h is null || (k.Tur != "KASA" && h.Tur != "KASA")) return AlanSinirlari.HareketAciklama;
            return Math.Max(0, AlanSinirlari.HareketAciklama - $"VİRMAN: {k.Ad} → {h.Ad} · ".Length);
        }
    }

    // ── PAKET GOC-A — ORTAK IZGARA (grid:gider:*) ──────────────────────────────
    private IzgaraTercihIstemcisi? gdTercih;
    private IzgaraTercihIstemcisi GdTercih => gdTercih ??= new IzgaraTercihIstemcisi(Api);
    private IzgaraSiralama? giderSira, kategoriSira, virmanSira;
    private void GiderSiralandi(IzgaraSiralama? s) => giderSira = s;
    private void KategoriSiralandi(IzgaraSiralama? s) => kategoriSira = s;
    private void VirmanSiralandi(IzgaraSiralama? s) => virmanSira = s;
    private string? GiderSiraAdi(string ad) => giderDahaFazlasi ? null : ad;
    private string? VirmanSiraAdi(string ad) => virmanDahaFazlasi ? null : ad;

    private IReadOnlyList<IzgaraKolonu<GiderSatiri>> GiderKolonlari =>
    [
        new() { Anahtar = "tarih", Baslik = Dil.T.Ortak.Tarih, ZorunluGorunur = true, SunucuSiralamaAdi = GiderSiraAdi("tarih"),
                HucreSinif = _ => "metin-kucuk", Deger = g => g.Tarih, Hucre = g => @<text>@Bicim.Tarih(g.Tarih, Dil.Dil)</text> },
        // ORTAK-1 (A): kısa ad/açıklama iki satıra kırılmaz (hucre-ad); tablo kendi kabında kayar.
        new() { Anahtar = "kategori", Baslik = Dil.T.Gider.Kategori, SunucuSiralamaAdi = GiderSiraAdi("kategori"),
                HucreSinif = _ => "hucre-ad", Deger = g => g.KategoriAdi ?? "—" },
        new() { Anahtar = "kasa", Baslik = Dil.T.Gider.Kasa, SunucuSiralamaAdi = GiderSiraAdi("kasa"),
                HucreSinif = _ => "metin-kucuk hucre-ad", Deger = g => g.KasaAdi ?? "—" },
        new() { Anahtar = "aciklama", Baslik = Dil.T.Ortak.Aciklama, HucreSinif = _ => "metin-kucuk hucre-ad",
                Deger = g => StornoOnekiSozlugu.Goster(g.Aciklama, Dil.Dil, Dil.BasitMi) ?? "—" },
        new() { Anahtar = "tutar", Baslik = Dil.T.Ortak.Tutar, ZorunluGorunur = true, SunucuSiralamaAdi = GiderSiraAdi("tutar"),
                Tur = IzgaraHucreTuru.Para, ParaBirimi = g => g.ParaBirimi, BaslikSinif = "sayi", HucreSinif = _ => "sayi", Deger = g => g.Tutar },
        new() { Anahtar = "eylem", Baslik = Dil.T.Ortak.Eylemler, ZorunluGorunur = true, Tasinamaz = true, KartEtiketsiz = true,
                Tur = IzgaraHucreTuru.Eylem,
                Hucre = g => @<text>@if (g.StornoSatiri)
                {
                    <Rozet>@Dil.T.Gider.StornoSatiri</Rozet>
                }
                else if (g.Stornolandi)
                {
                    @* Q10-1 (D10): basit modda "Stornolandı" yerine "Geri alındı". *@
                    <Rozet>@(Dil.BasitMi ? KatalogSozlugu.Al(Dil.Dil).GeriAlindi : Dil.T.Gider.Stornolandi)</Rozet>
                }
                else
                {
                    <button id="@($"gd-storno-{g.Id}")" type="button" class="dugme dugme-ikincil dugme-kucuk" @onclick="() => StornoAc(g)">@Dil.T.Gider.Storno</button>
                    <button id="@($"gd-belge-{g.Id}")" type="button" class="dugme dugme-ikincil dugme-kucuk" @onclick="() => belgeGider = g">@GiderBelgeSozlugu.Belge(Dil.Dil)</button>   @* Y-17 *@
                }</text> },
    ];

    private IReadOnlyList<IzgaraKolonu<GiderKategoriVeri>> KategoriKolonlari =>
    [
        new() { Anahtar = "ad", Baslik = Dil.T.Gider.KategoriAdi, ZorunluGorunur = true, SunucuSiralamaAdi = "ad",
                HucreSinif = _ => "hucre-ad", Deger = k => k.Ad,
                Hucre = k => @<text>@k.Ad @if (!k.Aktif) {<Rozet>@Dil.T.Ortak.Pasif</Rozet>}</text> },
        new() { Anahtar = "aciklama", Baslik = Dil.T.Ortak.Aciklama, HucreSinif = _ => "metin-kucuk", Deger = k => k.Aciklama ?? "—" },
        // UX-S23: sayı gösteren yer o kayıtlara GİDEN bağlantıdır.
        new() { Anahtar = "adet", Baslik = Dil.T.Gider.KullanimAdedi, SunucuSiralamaAdi = "adet", BaslikSinif = "sayi", HucreSinif = _ => "sayi",
                Deger = k => k.GiderAdedi,
                Hucre = k => @<button id="@($"gd-kat-adet-{k.Id}")" type="button" class="dugme dugme-ikincil dugme-kucuk" @onclick="() => KategoriyeGit(k.Id)">@k.GiderAdedi</button> },
        new() { Anahtar = "toplam", Baslik = Dil.T.Gider.KategoriToplami, SunucuSiralamaAdi = "toplam", Tur = IzgaraHucreTuru.Para,
                ParaBirimi = _ => ParaBirimi, BaslikSinif = "sayi", HucreSinif = _ => "sayi", Deger = k => k.GiderToplamTl },
        new() { Anahtar = "eylem", Baslik = Dil.T.Ortak.Eylemler, ZorunluGorunur = true, Tasinamaz = true, KartEtiketsiz = true,
                Tur = IzgaraHucreTuru.Eylem,
                Hucre = k => @<text><button id="@($"gd-kat-duzenle-{k.Id}")" type="button" class="dugme dugme-ikincil dugme-kucuk" @onclick="() => KategoriDuzenleAc(k)">@Dil.T.Ortak.Duzenle</button>
                    <button id="@($"gd-kat-durum-{k.Id}")" type="button" class="dugme dugme-ikincil dugme-kucuk" @onclick="() => KategoriDurumDegistir(k)">@(k.Aktif ? Dil.T.Gider.KategoriPasifeAl : Dil.T.Gider.KategoriAktifeAl)</button></text> },
    ];

    private IReadOnlyList<IzgaraKolonu<VirmanSatiri>> VirmanKolonlari =>
    [
        new() { Anahtar = "tarih", Baslik = Dil.T.Ortak.Tarih, ZorunluGorunur = true, SunucuSiralamaAdi = VirmanSiraAdi("tarih"),
                HucreSinif = _ => "metin-kucuk", Deger = v => v.Tarih, Hucre = v => @<text>@Bicim.Tarih(v.Tarih, Dil.Dil)</text> },
        new() { Anahtar = "kaynak", Baslik = Dil.T.Gider.Kaynak, Deger = v => $"{TurAdi(v.KaynakTur)} · {v.KaynakAdi ?? "—"}" },
        new() { Anahtar = "hedef", Baslik = Dil.T.Gider.Hedef, Deger = v => $"{TurAdi(v.HedefTur)} · {v.HedefAdi ?? "—"}" },
        new() { Anahtar = "tutar", Baslik = Dil.T.Ortak.Tutar, ZorunluGorunur = true, SunucuSiralamaAdi = VirmanSiraAdi("tutar"),
                Tur = IzgaraHucreTuru.Para, ParaBirimi = v => v.ParaBirimi, BaslikSinif = "sayi", HucreSinif = _ => "sayi", Deger = v => v.Tutar },
        new() { Anahtar = "eylem", Baslik = Dil.T.Ortak.Eylemler, ZorunluGorunur = true, Tasinamaz = true, KartEtiketsiz = true,
                Tur = IzgaraHucreTuru.Eylem,
                Hucre = v => @<text>@if (v.StornoSatiri)
                {
                    <Rozet>@Dil.T.Gider.StornoSatiri</Rozet>
                }
                else
                {
                    <button id="@($"gd-v-storno-{v.CikisBacakId}")" type="button" class="dugme dugme-ikincil dugme-kucuk" @onclick="() => VirmanStornoAc(v)">@Dil.T.Gider.Storno</button>
                }</text> },
    ];
    private List<GiderSatiri> giderler = [];
    private List<GiderToplamVeri>? giderToplamlari = [];
    private bool giderDahaFazlasi;
    private List<VirmanSatiri> virmanlar = [];
