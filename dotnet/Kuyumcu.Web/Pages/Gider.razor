    /// <summary>
    /// SAPMA (rapor § sapmalar): triyaj "/kasalar?virman={id}" dedi; /kasalar
    /// sayfasında virman formu YOKTUR (P-19: virman bu sayfanın sekmesidir ve
    /// Kasalar.razor zaten /gider?sekme=virman bağlantısı verir). Ölü bağlantı
    /// yerine bu kasayı HEDEF seçili açan virman sekmesine gidilir.
    /// </summary>
    private static string VirmanBaglantisi(string kasaId) =>
        $"/gider?sekme=virman&hedef={Uri.EscapeDataString(kasaId)}";

    /// <summary>
    /// Sunucunun P-44 kapı mesajı (KasaBakiyeKapisi.Mesaj). PARA-DEMO-3: ret gövdesi makine kodu taşır
    /// (KASA_BAKIYE_YETERSIZ); sayılar TEK ayrıştırıcıdan (KasaBakiyeMesaji — yeni tr-TR ve eski invariant
    /// biçim) okunur. Ekrana ham hâli BASILMAZ.
    /// </summary>
    private static bool YetersizBakiyeReddi(ApiHata e) =>
        e.StatusCode == 400 && (e.Kod is "KASA_BAKIYE_YETERSIZ" or "KASA_NAKIT_YETERSIZ"   // tur 2: nakit reddi de formdaki banda
            || e.Message.Contains("bakiyesi yetersiz", StringComparison.Ordinal));

    private string YetersizMetni(ApiHata e) =>
        KasaBakiyeMesaji.Bicimle(e.Message, Dil, SecilenAyrim)
        // Kalıp tutmazsa ham metin YİNE basılmaz: sayısız genel cümle.
        ?? Dil.T.Gider.YetersizBakiyeGenel;

    // ── PARA-DEMO-3: çekmecedeki nakit (gider nakit çıkışıdır) ──────────────
    private Kuyumcu.Core.I18n.ParaDemo3Metinleri PD3 => Kuyumcu.Core.I18n.ParaDemo3Sozlugu.Al(Dil.Dil);
    private Dictionary<string, KasaSz.KasaNakitAyrimiOzeti> nakitAyrimlari = [];
    private string? nakitAyrimHata;
    private KasaSz.KasaNakitAyrimiOzeti? SecilenAyrim =>
        nakitAyrimHata is null && SecilenKasaId is { } id && nakitAyrimlari.TryGetValue(id, out var a) ? a : null;

    /// <summary>Zenginleştirme: okunamazsa form DURUR, toplam "nakit" diye basılmaz, kısa hata görünür (UX-S28).</summary>
    private async Task NakitAyrimiYukle()
    {
        nakitAyrimHata = null;
        try
        {
            nakitAyrimlari = (await Api.GetAsync<List<KasaSz.KasaNakitAyrimiOzeti>>("/kasalar/nakit-ayrimi") ?? [])
                .Where(a => !string.IsNullOrEmpty(a.KasaId)).GroupBy(a => a.KasaId).ToDictionary(g => g.Key, g => g.First());
        }
        // UX-S28 / P-11: son bilinen ayrım SİLİNMEZ; hata varken nakit satırı çizilmez (bayat sayı "nakit" diye basılmaz).
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException) { nakitAyrimHata = string.Format(PD3.GiderAyrimYok, ex.Message); }
    }

    private string? KategoriKilidi =>
        (yeniKategoriAd ?? "").Trim().Length < 2 ? Dil.T.Gider.KategoriAdi : null;

    private string? VirmanKilidi => sayiKapisi.Sebep(Dil.Dil, "gd-v-") ?? VirmanKuralKilidi;   // ORTAK-1
    private string? VirmanKuralKilidi =>
        string.IsNullOrWhiteSpace(virmanKaynak) ? Dil.T.Gider.KilitKaynakSec
        : string.IsNullOrWhiteSpace(virmanHedef) ? Dil.T.Gider.KilitHedefSec
        : virmanKaynak == virmanHedef ? Dil.T.Gider.KilitAyniTaraf
        : virmanTutar is not > 0m ? Dil.T.Gider.KilitTutar
        : VirmanAracKilidi;

    private string? StornoKilidi =>
        (stornoGerekce ?? "").Trim().Length < 20 ? Dil.T.Gider.KilitGerekce : null;

    // ── yükleme ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // PAKET Q10-1: basit/profesyonel geçişinde gövde metni (Geri alındı ↔ STORNO,
        // değişmezlik notu) sayfa yenilenmeden güncellenir — tarayıcıda ölçüldü:
        // abonelik yokken mod düğmesine basınca tablo eski modda kalıyordu.
        Dil.Degisti += Yenile;
        Modu.Degisti += Yenile;
        await Yukle();
    }

    private void Yenile() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Dil.Degisti -= Yenile;
        Modu.Degisti -= Yenile;
    }

    /// <summary>
    /// PAKET P-50 — yetersiz bakiye bandının "Virman yap" bağlantısı bu sayfaya
    /// (/gider?sekme=virman&amp;hedef={kasaId}) döner: virman HEDEFİ o kasa seçili açılır.
    /// </summary>
    [SupplyParameterFromQuery(Name = "hedef")]
    public string? HedefSorgu { get; set; }

    /// <summary>Son uygulanan sorgu imzası — aynı sorgu kullanıcının sekme seçimini EZMEZ.</summary>
    private string? uygulananSorgu;

    /// <summary>
    /// PAKET P-19 derin bağ sekmesi (yalnız TANINAN değer uygulanır) — P-50'de
    /// OnInitializedAsync'ten buraya taşındı: bant bağlantısı AYNI sayfaya
    /// (yalnız sorgu değişerek) döndüğünde Blazor bileşeni yeniden kurmaz,
    /// yalnız parametreleri yeniler.
    /// </summary>
    protected override void OnParametersSet()
    {
        var imza = $"{SekmeSorgu}|{HedefSorgu}";
        if (imza == uygulananSorgu) return;
        uygulananSorgu = imza;
        if (string.Equals(SekmeSorgu, "virman", StringComparison.OrdinalIgnoreCase))
        {
            sekme = "VIRMAN";
            if (!string.IsNullOrWhiteSpace(HedefSorgu)) virmanHedef = $"KASA:{HedefSorgu}";
        }
        else if (string.Equals(SekmeSorgu, "kategori", StringComparison.OrdinalIgnoreCase)
                 || string.Equals(SekmeSorgu, "kategoriler", StringComparison.OrdinalIgnoreCase))
        {
            sekme = "KATEGORI";
            // PAKET S1-i: Sekmeler bileşeni URL'deki kodu okur ("kategoriler");
            // eski kısa bağ aynı sekmeye yönlendirilir (tarihe yeni kayıt açmadan).
            if (!string.Equals(SekmeSorgu, "kategoriler", StringComparison.Ordinal))
                Nav.NavigateTo(Nav.GetUriWithQueryParameter("sekme", "kategoriler"), replace: true);
        }
        else if (string.Equals(SekmeSorgu, "giderler", StringComparison.OrdinalIgnoreCase)) sekme = "GIDER";
    }

    // ── PAKET S1-i — ortak Sekmeler ──
    private GorselSigmaMetinleri GS => GorselSigmaSozlugu.Al(Dil.Dil);

    /// <summary>Sekme kodları = eski id sonekleri (#gd-sekme-&lt;kod&gt;).</summary>
    private IReadOnlyList<SekmeTanimi> GdSekmeleri =>
    [
        new("giderler", Dil.T.Gider.SekmeGiderler),
        new("kategoriler", Dil.T.Gider.SekmeKategoriler),
        // TOPLU-6 (TOPLU-5 hakemi ORTA): BASİT'te "Para aktarımı" adı HER YERDE (sekme dahil); kod/id AYNI.
        new("virman", Dil.BasitMi ? T6.VirmanSekmeBasit : Dil.T.Gider.SekmeVirman),
    ];

    private static string Durum(string kod) => kod switch
    {
        "kategoriler" => "KATEGORI",
        "virman" => "VIRMAN",
        _ => "GIDER",
    };

    // ⚠ TEK KAYNAK: sekme tıklaması URL'ye ?sekme= yazar; sayfa durumu yalnız
    //   SupplyParameterFromQuery → OnParametersSet yolundan izler (ikinci bir
    //   SeciliDegisti yolu AÇILMAZ — mutasyon MS1i-10 iki yolun birbirini
    //   örttüğünü gösterdi).

    private async Task Yukle()
    {
        yukleniyor = true;
        hata = null;
        veriGeldi = false;
        try
        {
            // ⚠ UX-S28: hata "kayıt yok"a ÇEVRİLMEZ. İstek patlarsa listeler
            //   BOŞALTILMAZ; hata bandı gösterilir ve ekrandaki veri kalır.
            var katYanit = await Api.GetAsync<GiderKategoriYaniti>("/gider-kategorileri");
            kategoriler = katYanit.Kategoriler ?? [];

            var giderYanit = await Api.GetAsync<GiderYaniti>("/giderler?limit=100");
            giderler = giderYanit.Satirlar ?? [];
            giderToplamlari = giderYanit.Toplamlar;
            giderDahaFazlasi = giderYanit.DahaFazlasiVar;

            var virmanYanit = await Api.GetAsync<VirmanYaniti>("/virman?limit=50");
            virmanlar = virmanYanit.Satirlar ?? [];
            virmanDahaFazlasi = virmanYanit.DahaFazlasiVar;

            kasalar = await Api.GetAsync<List<KasaSz.KasaVeri>>("/kasalar");
            await NakitAyrimiYukle();
            hesaplar = (await Api.GetAsync<BankaSz.HesapYaniti>("/bankalar")).Hesaplar ?? [];
            veriGeldi = true;
        }
        catch (ApiHata e) { hata = FormDurumu.SunucuMesaji(e, Dil); }
        finally { yukleniyor = false; }
    }

    // ── gider ───────────────────────────────────────────────────────────────
    private async Task GiderKaydet()
    {
        if (sayiKapisi.OnekleVar("gd-tutar")) return;   // ORTAK-1: POST YOK
        giderForm.Temizle();
        var kasaId = SecilenKasaId;
        giderForm.Zorunlu("gd-kasa", kasaId, Dil);
        var kategoriId = SecilenKategoriId;
        giderForm.Zorunlu("gd-kategori", kategoriId, Dil);
        giderForm.Pozitif("gd-tutar", giderTutar, Dil);
        if (!giderForm.Gecerli) return;

        kaydediliyor = true; hata = null;
        try
        {
            var s = await Api.PostAsync<GiderSonucu>("/giderler", new
            {
                kasaId,
                giderKategoriId = kategoriId,
                tutar = giderTutar!.Value,
                aciklama = giderAciklama,
            });
            // UX-S27: sunucunun DÖNDÜRDÜĞÜ sonuç banda yazılır (yeni bakiye dâhil).
            basari = $"{Dil.T.Gider.GiderKaydedildi}: {s.KategoriAdi} · "
                   + $"{Bicim.Para(s.Tutar, s.ParaBirimi)} · {s.KasaAdi} → {Bicim.Para(s.KasaBakiyesi, s.ParaBirimi)}";
            basariJeton++;
            giderTutar = null; giderAciklama = null; giderNotAcik = false;
            sonGiderId = s.Id;   // Y-17
            await Yukle();
        }
        catch (ApiHata e) when (YetersizBakiyeReddi(e))
        {
            // PAKET P-50: ham sunucu metni ("-738298.80 TRY") hata bandına YAZILMAZ;
            // biçimlendirilmiş bant + iki çıkış yolu. Ekrandaki bakiye bayatmış —
            // kasa listesi tazelenir ki rozet gerçeği söylesin.
            sunucuYetersiz = (kasaId!, giderTutar!.Value, YetersizMetni(e));
            try { kasalar = await Api.GetAsync<List<KasaSz.KasaVeri>>("/kasalar"); await NakitAyrimiYukle(); }
            catch (ApiHata e2) { hata = FormDurumu.SunucuMesaji(e2, Dil); }
        }
        catch (ApiHata e) { giderForm.Sunucudan(e); hata = KasaBakiyeMesaji.Bicimle(e.Message, Dil) ?? FormDurumu.SunucuMesaji(e, Dil); }   // PARA-DEMO-3: nakit reddi de sözlükten
        finally { kaydediliyor = false; }
    }

    // ── kategori ────────────────────────────────────────────────────────────
    private async Task KategoriEkle()
    {
        kategoriForm.Temizle();
        kategoriForm.EnAzKarakter("gd-kat-ad", yeniKategoriAd, 2, Dil);
        if (!kategoriForm.Gecerli) return;

        kaydediliyor = true; hata = null;
        try
        {
            var k = await Api.PostAsync<GiderKategoriVeri>("/gider-kategorileri", new
            {
                ad = yeniKategoriAd!.Trim(),
                aciklama = yeniKategoriAciklama,
            });
            basari = $"{Dil.T.Gider.KategoriKaydedildi}: {k.Ad}";
            basariJeton++;
            yeniKategoriAd = null; yeniKategoriAciklama = null;
            await Yukle();
        }
        catch (ApiHata e) { kategoriForm.Sunucudan(e); hata = FormDurumu.SunucuMesaji(e, Dil); }
        finally { kaydediliyor = false; }
    }

    private void KategoriDuzenleAc(GiderKategoriVeri k)
    {
        duzenleKategori = k;
        duzenleAd = k.Ad;
        duzenleAciklama = k.Aciklama;
        duzenleForm.Temizle();
        cekmeceHata = null;
    }

    private async Task KategoriGuncelle()
    {
        if (duzenleKategori is not { } k) return;
        duzenleForm.Temizle();
        duzenleForm.EnAzKarakter("gd-kd-ad", duzenleAd, 2, Dil);
        if (!duzenleForm.Gecerli) return;

        kaydediliyor = true; cekmeceHata = null;
        try
        {
            // PATCH: yalnız GÖNDERİLEN alanlar değişir; "aktif" gönderilmez,
            // korunur (durum değişimi ayrı düğmenin işidir).
            var y = await Api.PatchAsync<GiderKategoriVeri>($"/gider-kategorileri/{k.Id}", new
            {
                ad = duzenleAd!.Trim(),
                aciklama = duzenleAciklama,
            });
            basari = $"{Dil.T.Gider.KategoriGuncellendi}: {y.Ad}";
            basariJeton++;
            duzenleKategori = null;
            await Yukle();
        }
        catch (ApiHata e) { duzenleForm.Sunucudan(e); cekmeceHata = FormDurumu.SunucuMesaji(e, Dil); }
        finally { kaydediliyor = false; }
    }

    private async Task KategoriDurumDegistir(GiderKategoriVeri k)
    {
        kaydediliyor = true; hata = null;
        try
        {
            if (k.Aktif)
                await Api.DeleteAsync<GiderKategoriVeri>($"/gider-kategorileri/{k.Id}");
            else
                await Api.PatchAsync<GiderKategoriVeri>($"/gider-kategorileri/{k.Id}", new { aktif = true });

            basari = k.Aktif ? Dil.T.Gider.KategoriPasifeAl : Dil.T.Gider.KategoriAktifeAl;
            basariJeton++;
            await Yukle();
        }
        catch (ApiHata e) { hata = FormDurumu.SunucuMesaji(e, Dil); }
        finally { kaydediliyor = false; }
    }

    /// <summary>UX-S23: adet rozeti o kategorinin gider satırlarına GÖTÜRÜR.</summary>
    private void KategoriyeGit(string kategoriId)
    {
        giderKategoriId = kategoriId;
        sekme = "GIDER";
        // PAKET S1-i: seçili sekme URL'dedir — Sekmeler'in göstereceği sekme de değişir.
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("sekme", "giderler"));
    }

    // ── virman ──────────────────────────────────────────────────────────────
    private async Task VirmanKaydet()
    {
        if (sayiKapisi.OnekleVar("gd-v-")) return;   // ORTAK-1: POST YOK
        virmanForm.Temizle();
        virmanForm.Zorunlu("gd-v-kaynak", virmanKaynak, Dil);
        virmanForm.Zorunlu("gd-v-hedef", virmanHedef, Dil);
        virmanForm.Pozitif("gd-v-tutar", virmanTutar, Dil);
        if (virmanKaynak is not null && virmanKaynak == virmanHedef)
            virmanForm.Ekle("gd-v-hedef", Dil.T.Gider.KilitAyniTaraf);
        if (!virmanForm.Gecerli) return;

        var (kTur, kId) = Coz(virmanKaynak!);
        var (hTur, hId) = Coz(virmanHedef!);

        kaydediliyor = true; hata = null; virmanHata = null; virmanSonuc = null;
        try
        {
            var s = await Api.PostAsync<VirmanSonucu>("/virman", new
            {
                kaynakTur = kTur, kaynakId = kId,
                hedefTur = hTur, hedefId = hId,
                tutar = virmanTutar!.Value,
                aciklama = virmanAciklama,
                kasaAraci = VirmanAracGonder,   // PARA-DEMO tur 2 (null = nakit)
            });
            basari = $"{(Dil.BasitMi ? T6.VirmanKaydedildiBasit : Dil.T.Gider.VirmanKaydedildi)}: {s.KaynakAdi} → {s.HedefAdi} · "
                   + Bicim.Para(s.Tutar, s.ParaBirimi)
                   + (s.SubelerArasi ? $" ({Dil.T.Gider.SubelerArasi})" : "");
            virmanSonuc = basari;   // tur 2: sonuç düğmenin altında da görünür (UX-S27)
            basariJeton++;
            virmanTutar = null; virmanAciklama = null;
            await Yukle();
            await VirmanKaynakDegisti();   // kalan kart/havale payı yeniden okunur
        }
        // PARA-DEMO-3: kasa kapısı reddi tr-TR. Tur 2: ret formun İÇİNDE (#gd-v-hata); nakit kaynağında kart/havale payı
        // varsa toplam reddi nakit cümlesiyle yazılır.
        catch (ApiHata e)
        {
            virmanForm.Sunucudan(e);
            var kaynakAyrim = kTur == "KASA" && VirmanAracGonder is null && nakitAyrimlari.TryGetValue(kId, out var va) ? va : null;
            virmanHata = KasaBakiyeMesaji.Bicimle(e.Message, Dil, kaynakAyrim) ?? FormDurumu.SunucuMesaji(e, Dil);
        }

        finally { kaydediliyor = false; }
    }

    private static (string Tur, string Id) Coz(string anahtar)
    {
        var i = anahtar.IndexOf(':');
        return i < 0 ? (anahtar, "") : (anahtar[..i], anahtar[(i + 1)..]);
    }

    // ── storno (yıkıcı eylem: onay modalı + gerekçe) ────────────────────────
    private void StornoAc(GiderSatiri g)
    {
        stornoGider = g; stornoVirman = null;
        stornoGerekce = null; stornoForm.Temizle(); modalHata = null;
    }

    private void VirmanStornoAc(VirmanSatiri v)
    {
        stornoVirman = v; stornoGider = null;
        stornoGerekce = null; stornoForm.Temizle(); modalHata = null;
    }

    private void StornoKapat()
    {
        stornoGider = null; stornoVirman = null; stornoGerekce = null; modalHata = null;
    }

    private async Task StornoOnayla()
    {
        stornoForm.Temizle();
        stornoForm.EnAzKarakter("gd-storno-gerekce", stornoGerekce, 20, Dil);
        if (!stornoForm.Gecerli) return;

        kaydediliyor = true; modalHata = null;
        try
        {
            if (stornoVirman is { } v)
            {
                var s = await Api.PostAsync<VirmanStornoSonucu>(
                    $"/virman/{v.CikisBacakId}/storno", new { gerekce = stornoGerekce!.Trim() });
                // QA10-KRITIK: BASİT modda "storno" jargonu bantta YOK (rozetle aynı "geri alındı" dili).
                // TOPLU-6 t2: BASİT bant "virman" da demez (ekranın BASİT adı "para aktarımı").
                basari = Dil.BasitMi
                    ? T6.VirmanStornoYapildiBasit
                    : $"{Dil.T.Gider.VirmanStornoYapildi} · {string.Format(QA10Sozlugu.Al(Dil.Dil).VirmanBacakSayisi, s.BacakSayisi)}";
            }
            else if (stornoGider is { } g)
            {
                await Api.PostAsync<System.Text.Json.JsonElement>(
                    $"/kasalar/{g.KasaId}/hareket/{g.Id}/storno", new { gerekce = stornoGerekce!.Trim() });
                basari = Dil.BasitMi ? QA10Sozlugu.Al(Dil.Dil).GiderGeriAlindiBasit : Dil.T.Gider.StornoYapildi;
            }
            basariJeton++;
            StornoKapat();
            await Yukle();
        }
        catch (ApiHata e) { stornoForm.Sunucudan(e); modalHata = FormDurumu.SunucuMesaji(e, Dil); }
        finally { kaydediliyor = false; }
    }
}
