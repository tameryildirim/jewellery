    /// <summary>
    /// UX-S32: tutar para birimiyle taşınır. Tek kasa varsa onunki, birden çok
    /// kasa varsa SEÇİLEN kasanınki; hiç kasa yoksa "TRY" VARSAYILMAZ — ilk
    /// kasanın para birimi yoksa boş geçilir ve toplam kartı bunu söyler.
    /// </summary>
    private string ParaBirimi =>
        (giderKasaId is { } id ? kasalar.FirstOrDefault(k => k.Id == id)?.ParaBirimi : null)
        ?? kasalar.FirstOrDefault()?.ParaBirimi
        ?? "";

    /// <summary>
    /// PAKET Q10-1 (QA turu 10, KRİTİK): "Toplam gider" İSTEMCİDE HESAPLANMAZ.
    /// Eski satır <c>StornoSatiri ? -Tutar : Tutar</c> idi; sunucu storno satırını
    /// ZATEN eksi döndürdüğü için eksi × eksi = artı oluyor, 125,50 + storno
    /// 251,00 görünüyordu. Toplam artık sunucudan gelir (UX-S21): işaretli, satır
    /// sınırından (limit 100) bağımsız ve para birimi başına ayrı (UX-S32).
    /// Sunucu toplam döndürmediyse (null) rakam UYDURULMAZ, "—" yazılır.
    /// </summary>
    private string ToplamMetni =>
        giderToplamlari is null ? "—"
        : giderToplamlari.Count == 0 ? Bicim.Para(0m, ParaBirimi)
        : string.Join(" · ", giderToplamlari.Select(t => Bicim.Para(t.Tutar, t.ParaBirimi)));

    /// <summary>Virman seçicilerinin TEK dizisi (UX-S26).</summary>
