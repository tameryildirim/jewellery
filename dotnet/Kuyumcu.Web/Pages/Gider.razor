         .. hesaplar.Where(h => h.Aktif).Select(h => new VirmanTarafSecenegi("BANKA", h.Id, h.HesapAdi, h.ParaBirimi, h.Bakiye))];

    private static string Anahtar(VirmanTarafSecenegi t) => $"{t.Tur}:{t.Id}";
    private string Etiket(VirmanTarafSecenegi t) => $"{TurAdi(t.Tur)} · {t.Ad} ({Bicim.ParaIsareti(t.ParaBirimi)})";
