    /// KENDİ kuru (tutar değişmeden kaydedilen düzenleme kuru kaybetmesin).
    /// </summary>
    private string? EtkinKurId =>
        string.IsNullOrWhiteSpace(kurId) ? kart?.KurSnapshotId : kurId;

