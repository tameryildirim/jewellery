    {
        dCariId = string.IsNullOrWhiteSpace(v) ? null : v;
        cariHatasi = null;
        baslikHatasi = null;
    }

    private void SubeSecildi(string? v)
    {
        dSubeId = string.IsNullOrWhiteSpace(v) ? null : v;
        baslikHatasi = null;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Tur 2 (doğrulayıcı bulgusu): rota başka siparişe geçince önceki siparişin kapora
        // çekmecesi ve geri verme penceresi açık kalmaz; form alanları da taşınmaz.
        if (kart is not null && kart.Id != Id) KaporaFormlariniSifirla();
        if (kart is not null && kart.Id != Id) await Yukle();
    }

    private async Task Yukle()
    {
        yukleniyor = true;
        hata = null;
        try
        {
            kart = await Api.GetAsync<Kart>($"/siparisler/{Id}");
        }
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException)
        {
            // UX-S28: hata boş duruma çevrilmez.
            hata = ex.Message;
        }
        yukleniyor = false;
    }

    private void DuzenlemeyiAc()
    {
        if (kart is not { } s) return;
        duzenleAcik = true;
        kalemHatasi = null;
        // P-51: başlık alanları KAYITTAN doldurulur (UX-S21 — sistemin bildiği
        // değer kullanıcıdan yeniden istenmez).
        dTur = s.Tur;
        dCariId = s.CariId;
        dUstaId = s.UstaCariId;
        ustaHatasi = null;
        dSubeId = s.SubeId ?? (subeler.Count == 1 ? subeler[0].Id : null);
        cariHatasi = null;
        baslikHatasi = null;
        dGun = Bicim.Makine(s.SozVerilenGun);
        kayitliGun = s.SozVerilenGun;
        dAciklama = s.Aciklama ?? "";
        // P-52 · UX-S21: tahmini tutar KAYITTAN gelir; kullanıcıdan yeniden istenmez.
        dTahminiTutar = s.TahminiTutarTl;
        tahminiHatasi = null;
        dKalemler = s.KalemlerL.Count == 0
            ? [new FormKalemi()]
            : [.. s.KalemlerL.Select(k => new FormKalemi
            {
                Id = k.Id,
                UrunId = k.UrunId,
                UrunAd = k.UrunAd,
                // ⚠ Ürün bağlı kalemde ürün adı SERBEST TANIMA ÇEVRİLMEZ; tanım
                //   yalnız gerçekten serbest yazılan metindir (S-3a).
                Tanim = k.Tanim,
                AyarId = k.AyarId,
                Gram = k.GramAgirlik is { } g ? Bicim.Girdi(g) : "",
                Adet = Bicim.Girdi(k.Adet),
            })];
    }

