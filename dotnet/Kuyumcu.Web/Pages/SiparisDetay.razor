        try
        {
            subeler = await Api.GetAsync<List<SubeSecenegi>>("/subeler");
        }
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException)
        {
            hata = ex.Message;   // UX-S28: hata boş duruma çevrilmez.
        }
        await CarileriYukle();
        await UrunleriYukle();
        await KuruYukle();
    }

    // P-52: ürün listesi ve kur anlık görüntüsü SAYFA AÇILIŞINDA çekilir —
    // düzenleme açılınca boş seçici çıkmaz (P-51'de alınan ders).
    private async Task UrunleriYukle()
    {
        try
        {
            urunler = await Api.GetAsync<List<Kuyumcu.Contracts.Sayfalar.Siparisler.UrunSatiri>>(
                $"/urunler?aktif=true&limit={UrunSiniri}");
        }
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException)
        {
            hata = ex.Message;   // UX-S28: hata boş duruma ÇEVRİLMEZ.
        }
    }

    private async Task KuruYukle()
    {
        try
        {
            var k = await Api.GetAsync<Kuyumcu.Contracts.Sayfalar.Siparisler.KurSatiri>("/kur/guncel");
            kurId = string.IsNullOrWhiteSpace(k.Id) ? null : k.Id;
        }
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException)
        {
            hata = ex.Message;
        }
    }

