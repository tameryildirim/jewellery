    // ── PAKET GOC-C: söz günü penceresi (sunucu SiparisServisi.SozGunuDogrula ile aynı kural) ──
    private DateOnly? kayitliGun;
    private static DateOnly IsletmeBugunu => DateOnly.FromDateTime(Bicim.IsletmeBugun);
    /// <summary>En erken: bugün; kayıtlı gün geçmişteyse o gün (değişmeyen gün sunucuda da sınanmaz).</summary>
    private DateOnly SozEnErken => kayitliGun is { } k && k < IsletmeBugunu ? k : IsletmeBugunu;
    private DateOnly SozEnGec
    {
        get
        {
            var g = IsletmeBugunu.AddYears(AlanSinirlari.SiparisSozEnCokYil);
            return kayitliGun is { } k && k > g ? k : g;
        }
    }

    private void GunDegisti(DateOnly? g) =>
        dGun = g is { } d ? Kuyumcu.Web.Servisler.Bicim.Makine(d) : null;

    private void TanimDegisti(int sira, string? deger)
    {
        dKalemler[sira].Tanim = deger;
        kalemHatasi = null;
    }

    private void AdetDegisti(int sira, decimal? deger) =>
        dKalemler[sira].Adet = deger is { } d ? Bicim.Girdi(d) : "1";

    // ── PAKET P-52 ──────────────────────────────────────────────────────────
    private void UrunSecildi(int sira, string? deger)
    {
        var k = dKalemler[sira];
        k.UrunId = string.IsNullOrWhiteSpace(deger) ? null : deger;
        if (k.UrunId is null)
        {
            // Ürün bağı KALDIRILDI: ad da düşer, yoksa ekran olmayan bir ürünü
            // gösterir (Anayasa md.1 — ekran uydurmaz). Ayar/gram KORUNUR:
            // kullanıcının girdiği değer sessizce silinmez.
            k.UrunAd = null;
        }
        else if (urunler.FirstOrDefault(x => x.Id == k.UrunId) is { } u)
        {
            // UX-S21: sistemin bildiği alan türetilir (oluşturma formuyla AYNI).
            k.UrunAd = u.Ad;
            k.AyarId = u.AyarId;
            k.Gram = Bicim.Girdi(u.GramAgirlik);
        }
        kalemHatasi = null;
    }

    private void TahminiDegisti(decimal? deger)
    {
        dTahminiTutar = deger;
        tahminiHatasi = null;
    }

    private void AyarDegisti(int sira, string? deger) =>
        dKalemler[sira].AyarId = string.IsNullOrWhiteSpace(deger)
            ? null : deger.Trim().ToUpperInvariant();

    private void GramDegisti(int sira, decimal? deger) =>
        dKalemler[sira].Gram = deger is { } d ? Bicim.Girdi(d) : "";

    private void KalemEkle() => dKalemler.Add(new FormKalemi());

    private void KalemSil(int sira)
    {
        if (dKalemler.Count <= 1) return;
        dKalemler.RemoveAt(sira);
    }

    private async Task Kaydet()
    {
        if (kart is not { } s || kaydediliyor || sayiKapisi.OnekleVar("sipd-d-")) return;   // ORTAK-1: PATCH YOK
        // S-3a: ürün bağlı kalemde tanım BOŞ olabilir — geçerlilik ölçütü
        // "ürün var ya da tanım var" (sunucu KalemKur ile aynı kural).
        var gecerli = dKalemler
            .Where(k => !string.IsNullOrWhiteSpace(k.UrunId) || !string.IsNullOrWhiteSpace(k.Tanim))
            .ToList();
        if (gecerli.Count == 0)
        {
            kalemHatasi = Dil.T.Siparis.KalemGerekli;
            return;
        }

        // P-51 · DoD EK md.3: geçersiz gönderimde alan altı Türkçe mesaj —
        // sessiz etkisizlik YASAK.
        if (string.IsNullOrWhiteSpace(dCariId))
        {
            cariHatasi = Dil.T.Siparis.CariGerekli;
            return;
        }
        // B1-5 · DoD EK md.3: dış atölye işinde usta boş gönderilmez (sunucu da reddeder).
        if (dTur == "ATOLYE_SIPARISI" && string.IsNullOrWhiteSpace(dUstaId))
        {
            ustaHatasi = EB1.UstaSecin;
            return;
        }

        // P-52 · DoD EK md.3 + UX-S30: tahmini tutar verildiyse kur anlık görüntüsü
        // ZORUNLUDUR (sunucu TahminDogrula ile aynı kural). Kur yoksa istek HİÇ
        // GİTMEZ; sebep alanın altında Türkçe yazar — sessiz etkisizlik YASAK.
        if (dTahminiTutar is not null && !KurVar)
        {
            tahminiHatasi = Dil.T.Siparis.KurYok;
            return;
        }

        kaydediliyor = true;
        hata = null;
        baslikHatasi = null;
        try
        {
            // PATCH sözleşmesi: GÖNDERİLEN alan değişir, gönderilmeyen KORUNUR,
            // null gönderilen SİLİNİR. İyimser kilit damgası her zaman gider.
            var cevap = await Api.PatchAsync($"/siparisler/{s.Id}", new
            {
                guncellendi = s.Guncellendi,
                // P-51 — başlık kimliği. Şube TEK ise sunucuya gönderilmez:
                // değeri oturum/kayıt taşır, ekran ikinci bir gerçek uydurmaz (UX-S22).
                tur = dTur,
                cariId = dCariId,
                // B1-5: usta türle BİRLİKTE gider; usta tutmayan türde null (bağ silinir — PATCH null = sil).
                ustaCariId = UstaUygun(dTur) ? dUstaId : null,
                subeId = subeler.Count > 1 ? dSubeId : s.SubeId,
                sozVerilenGun = dGun,
                aciklama = string.IsNullOrWhiteSpace(dAciklama) ? null : dAciklama,
                // P-52: tutar ve kur BİRLİKTE gider. Tutar silindiyse kur da
                // silinir — "hangi kurdan söz verildi" sorusu tutarsız kalmaz.
                tahminiTutarTl = dTahminiTutar,
                kurSnapshotId = dTahminiTutar is null ? null : EtkinKurId,
                // S-3a: kalem TAM alan kümesiyle gider. `id` verildiği için
                // sunucu kalemi GÜNCELLER (kimlik kararlı); gönderilmeyen alan
                // korunur, burada hepsi açıkça gönderilir → sessiz veri kaybı yok.
                kalemler = gecerli.Select(k => new
                {
                    id = string.IsNullOrWhiteSpace(k.Id) ? null : k.Id,
                    urunId = string.IsNullOrWhiteSpace(k.UrunId) ? null : k.UrunId,
                    tanim = string.IsNullOrWhiteSpace(k.Tanim) ? null : k.Tanim,
                    ayarId = string.IsNullOrWhiteSpace(k.AyarId) ? null : k.AyarId,
                    // P-78: kalem metinleri ekranda tr-TR tutulur (Bicim.Girdi) ve
                    // TEK MERKEZDE çözülür; eski Invariant ayrıştırma "1,5"i 15 okuyordu.
                    gramAgirlik = FormAlani.Ondalik(k.Gram),
                    adet = FormAlani.Ondalik(k.Adet) ?? 1m,
                }),
            });
            _ = cevap;   // UX-S27: yanıt okunur; kart aşağıda yeniden yüklenir.
            basari = Dil.T.Siparis.Guncellendi;
            basariJeton++;
            duzenleAcik = false;
            await Yukle();
        }
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException)
        {
            // UX-S28/UX-S30: sunucunun AÇIK gerekçesi hem bantta hem başlık
            // alanlarının altında okunur; form KAPANMAZ, girilen değer kaybolmaz.
            hata = ex.Message;
            baslikHatasi = ex.Message;
        }
        kaydediliyor = false;
    }

    // ── QA turu 5 (YÜKSEK): durum geçişi onay kipi ──────────────────────────
    private string? gecisHedefi;
    private string gecisGerekce = "";

    /// <summary>Gerekçe gerekli mi? SUNUCU söyler (gerekceIsteyenGecisler) — ekran tahmin etmez.</summary>
    private bool GecisGerekceGerekli =>
        gecisHedefi is { } h && kart is { } k && k.GerekceIsteyenGecislerL.Contains(h);

    private bool GecisOnayVerilebilir =>
        !GecisGerekceGerekli
        || (kart is { } k && gecisGerekce.Trim().Length >= k.GerekceAsgari);

    private void GecisIste(string hedef)
    {
        gecisGerekce = "";
        gecisHedefi = hedef;
    }

    private async Task GecisOnayla()
    {
        if (gecisHedefi is not { } hedef || !GecisOnayVerilebilir) return;
        var gerekce = GecisGerekceGerekli ? gecisGerekce.Trim() : null;
        gecisHedefi = null;
        await Gecis(hedef, gerekce);
    }

    private void IptalModaliAc()
    {
        iptalGerekce = "";
        gecisHedefi = "IPTAL";
    }

    private void ModaliKapat() => gecisHedefi = null;

    /// <summary>Onay kipinin başlığı — yıkıcı iptal ile olağan geçiş ayrı adlandırılır.</summary>
    private string OnayBasligi =>
        gecisHedefi == "IPTAL" ? Dil.T.Siparis.IptalBaslik : Dil.T.Siparis.GecisOnayBaslik;

    private async Task IptalOnayla()
    {
        if (!GerekceGecerli) return;   // düğme zaten disabled; ikinci kapı
        gecisHedefi = null;
        await Gecis("IPTAL", iptalGerekce.Trim());
    }

    private async Task Gecis(string yeniDurum, string? gerekce)
    {
        if (kart is not { } s || gecisYapiliyor) return;
        gecisYapiliyor = true;
        hata = null;
        try
        {
            var cevap = await Api.PostAsync($"/siparisler/{s.Id}/gecis", new
            {
                yeniDurum,
                gerekce,
                guncellendi = s.Guncellendi,   // iyimser kilit
            });
            var durum = cevap.TryGetProperty("durum", out var d) &&
                        d.ValueKind == System.Text.Json.JsonValueKind.String ? d.GetString() : null;
            basari = durum is null
                ? Dil.T.Siparis.GecisYapildi
                : $"{Dil.T.Siparis.GecisYapildi}: {DurumMetni(durum)}";
            basariJeton++;
            await Yukle();
        }
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException) { hata = ex.Message; }
        gecisYapiliyor = false;
    }

    // ── PAKET Q9-3 — başlık düzenlemesinin GÖRÜNÜR sonucu ────────────────────
    private SiparisBaslikMetinleri B => SiparisBaslikSozlugu.Al(Dil.Dil);

    /// <summary>
    /// Müşteri listesinin yükleme sınırı — Secici'nin yerel kip tavanıyla AYNI
    /// (daha fazlası yerel aramayla taşınmaz). UX-S29: ekranda sayıyla yazar.
    /// </summary>
    private const int CariSiniri = Kuyumcu.Web.Bilesenler.Secici.YerelTavan;

    /// <summary>
    /// Sunucunun başlık düzeltmesine yazdığı iz öneki
    /// (SiparisServisi.BaslikDuzenlendiNotu ile AYNI dizge — Web, Api'ye başvurmaz).
    /// </summary>
    private const string BaslikOneki = "BASLIK_DUZENLENDI: ";

    private string SubeAdi(string? id)
    {
        if (string.IsNullOrWhiteSpace(id) || id == "—") return B.SubeYok;
        return subeler.FirstOrDefault(x => x.Id == id)?.Ad ?? B.KayitListedeYok;
    }

    private string CariAdi(string? id)
    {
        if (string.IsNullOrWhiteSpace(id) || id == "—") return "—";
        if (cariler.FirstOrDefault(x => x.Id == id) is { } c) return c.Ad;
        if (kart is { } k && k.CariId == id && !string.IsNullOrWhiteSpace(k.CariAd)) return k.CariAd!;
        return B.KayitListedeYok;
    }

    private string? CariTurMetni(string? t) => t switch
    {
        "MUSTERI" => B.Musteri,
        "TEDARIKCI" => B.Tedarikci,
        "HER_IKISI" => B.HerIkisi,
        "ATOLYE" => B.Atolye,
        "SARRAF" => B.Sarraf,
        _ => null,   // bilinmeyen kod ekrana ÇIPLAK basılmaz (UX-S31)
    };

    /// <summary>
    /// Q9-3 · UX-S31 + B-25: başlık düzeltme izi sunucuda denetim için KİMLİKLE
    /// saklanır ("cari 01M… → 01M… · tür TAMIR → …"); ekran onu ada ve sözlük
    /// metnine çevirir. Tanınmayan parça olduğu gibi kalır (veri gizlenmez).
    /// </summary>
    private string GerekceMetni(string gerekce)
    {
        if (!gerekce.StartsWith(BaslikOneki, StringComparison.Ordinal)) return gerekce;
        var cikti = new List<string>();
        foreach (var parca in gerekce[BaslikOneki.Length..].Split(" · "))
        {
            var bosluk = parca.IndexOf(' ');
            var ok = parca.IndexOf(" → ", StringComparison.Ordinal);
            if (bosluk < 0 || ok < bosluk)
            {
                cikti.Add(parca);
                continue;
            }
            var alan = parca[..bosluk];
            var eski = parca[(bosluk + 1)..ok];
            var yeni = parca[(ok + 3)..];
            cikti.Add(alan switch
            {
                "cari" => $"{Dil.T.Siparis.Cari}: {CariAdi(eski)} → {CariAdi(yeni)}",
                "tür" => $"{Dil.T.Siparis.Tur}: {TurMetni(eski)} → {TurMetni(yeni)}",
                "şube" => $"{Dil.T.Siparis.Sube}: {SubeAdi(eski)} → {SubeAdi(yeni)}",
                _ => parca,
            });
        }
        return $"{B.BaslikDuzenlendi} — {string.Join(" · ", cikti)}";
    }

    private string TurMetni(string t) => t switch
    {
        "MUSTERI_SIPARISI" => Dil.T.Siparis.TurMusteri,
        "ATOLYE_SIPARISI" => Dil.T.Siparis.TurAtolye,
        "TAMIR" => Dil.T.Siparis.TurTamir,
        _ => t,
    };

    // KESIF-P6 tur 2: ekranda tek birincil — izinli İLERİ geçişlerin ilki (İPTAL ve geri dönüş hariç).
    private static string? IlkIleriGecis(Kart s) =>
        s.IzinliGecislerL.FirstOrDefault(h => h != "IPTAL" && !s.GeriYonluGecislerL.Contains(h));

    // Düğme EYLEM dilindedir; sözlükte karşılığı olmayan hedef durum adıyla yazılır (uydurma yok).
    private string GecisEtiketi(string h) => KesifP6Sozlugu.GecisEylemi(h, Dil.Dil) ?? DurumMetni(h);

    private string DurumMetni(string d) => d switch
    {
        "TASLAK" => Dil.T.Siparis.DurumTaslak,
        "ONAYLANDI" => Dil.T.Siparis.DurumOnaylandi,
        "ATOLYEDE" => Dil.T.Siparis.DurumAtolyede,
        "HAZIR" => Dil.T.Siparis.DurumHazir,
        "TESLIM_EDILDI" => Dil.T.Siparis.DurumTeslimEdildi,
        "IPTAL" => Dil.T.Siparis.DurumIptal,
        _ => d,
    };

    private static string DurumRengi(string d) => d switch
    {
        "TASLAK" => "gri",
        "ONAYLANDI" => "mavi",
        "ATOLYEDE" => "amber",
        "HAZIR" => "yesil",
        "TESLIM_EDILDI" => "yesil",
        _ => "kirmizi",
    };

    private void Yenile() => InvokeAsync(StateHasChanged);
    public void Dispose() => Dil.Degisti -= Yenile;
}
