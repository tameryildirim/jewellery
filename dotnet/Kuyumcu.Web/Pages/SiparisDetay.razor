    private List<SecenekOgesi> SubeSecenekleri =>
        [.. subeler.Select(sb => new SecenekOgesi(sb.Id, sb.Ad))];

    /// <summary>
    /// UX-S29 + boş liste yasağı: arama ilk 50 cariyi getirir; siparişin KENDİ
    /// carisi o 50'nin içinde olmasa bile seçenekten DÜŞMEZ — aksi hâlde kaydet
    /// basıldığında cari sessizce başkasına kayardı.
    /// </summary>
    private List<SecenekOgesi> CariSecenekleri
    {
        get
        {
            var liste = cariler.Select(c => new SecenekOgesi(c.Id, c.Ad, CariTurMetni(c.Tur))).ToList();
            if (kart is { } s && !string.IsNullOrWhiteSpace(s.CariId)
                && !liste.Any(o => o.Deger == s.CariId))
            {
                liste.Insert(0, new SecenekOgesi(s.CariId!, s.CariAd ?? s.CariId!));
            }
            return liste;
        }
    }

    /// <summary>
    /// P-52 · UX-S29 + boş liste yasağı: ürün listesi ilk <see cref="UrunSiniri"/>
    /// kaydı getirir; kalemin KENDİ ürünü o listede olmasa bile seçenekten
    /// DÜŞMEZ — aksi hâlde kaydet basıldığında ürün bağı sessizce kaybolurdu.
    /// </summary>
    private List<SecenekOgesi> UrunSecenekleri(int sira)
    {
        var liste = urunler.Select(u => new SecenekOgesi(u.Id, u.Ad)).ToList();
        var k = dKalemler[sira];
        if (!string.IsNullOrWhiteSpace(k.UrunId) && !liste.Any(o => o.Deger == k.UrunId))
            liste.Insert(0, new SecenekOgesi(k.UrunId!, k.UrunAd ?? k.UrunId!));
        return liste;
    }

    private Kart? kart;
    private bool yukleniyor = true, kaydediliyor, gecisYapiliyor, duzenleAcik;
    private string? hata, basari, kalemHatasi;
    private int basariJeton;
    private string? dGun;
    private string dAciklama = "";
    private string iptalGerekce = "";
    private List<FormKalemi> dKalemler = [new()];

    private bool IptalEdebilir => Oturum.Kullanici?.Rol is "SAHIP" or "MUDUR";
    private bool GerekceGecerli => iptalGerekce.Trim().Length >= (kart?.GerekceAsgari ?? 10);   // PAKET GOC-C: sunucu sabiti

    protected override async Task OnInitializedAsync()
