        Dil.Degisti += Yenile;
        await Yukle();
        // P-51: seçenekler SAYFA AÇILIŞINDA çekilir (Faturalar ekranındaki
        // "düzenleme açılınca boş liste" hatası TEKRARLANMAZ).
        await SeceneklerYukle();
    }

