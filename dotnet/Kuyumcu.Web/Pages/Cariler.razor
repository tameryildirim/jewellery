    private async Task DovizVeresiyeAc(CariVeri c)
    {
        islemHata = null; form.Temizle();
        dvParaBirimi = DovizBirimleri.FirstOrDefault(pb => DovizKuru(pb) is not null) ?? "USD";
        dvTutar = 0m; dvAciklama = ""; dvDokunuldu = false;
        await KurYukle();
        await PM.Ac(c.Id);   // YASAL-KAPI-2
        dovizVeresiyeCari = c;
    }

