    // ── Düzenleme ────────────────────────────────────────────────────────────

    // ── PAKET 40-A — PEP beyanı düzenleme durumu ────────────────────────────
    private bool duzPepBeyani;
    private string duzPepGorev = "";
    private DateTime? duzPepBeyanTarihi;
    private bool yuklenenPepBeyani;
    private string yuklenenPepGorev = "";

    /// <summary>Beyan işaretliyse görev ZORUNLU — sunucu da 400 döner.</summary>
    private bool PepGecerli => !duzPepBeyani || !string.IsNullOrWhiteSpace(duzPepGorev);

    /// <summary>Risk rozetinin rengi — ham kod ekrana basılmaz (UX-S31).</summary>
    private static string RiskRengi(string seviye) => seviye switch
    {
        "YUKSEK" => "kirmizi",
        "ORTA" => "amber",
        _ => "mavi",
    };

    // ── T-M1 doğrulayıcı KRİTİK (yarış): panel önceki müşterinin alanlarıyla açılıp
    //   Kaydet'e izin veriyordu → B'nin kartı A'nın verisiyle PATCH'leniyordu.
    //   Kural: (1) açılışta TÜM duz* alanları sıfırlanır; (2) GET /cari/{id} dönene
    //   dek alanlar ve Kaydet KİLİTLİ (sebep: "yükleniyor"); (3) yanıt YALNIZ hâlâ
    //   aynı açılıştaysa uygulanır (açılış sayacı + Id); (4) GET başarısızsa kilit
    //   kalkmaz — boş/eksik alanla PATCH katlı alanları SİLERDİ.
    private bool duzYuklendi;
    private int duzAcilis;

    /// <summary>Kart sunucudan gelmeden alanlar ve Kaydet kilitli.</summary>
    private bool DuzKilitli => duzenleCari is not null && !duzYuklendi;

    // KESIF-P2 (TOPLU ORTAK-1 DÜŞÜK): kilit sebebi alanın GÖRÜNEN etiketini söyler
    // (BASİT'te "Ad soyad"; eskiden "Ad / Firma Adı" yazıyordu) ve alan altında da mesaj çıkar.
    private string DuzAdEtiketi => Sade ? T.AdSoyad : Dil.T.Cari.AdFirma;

    private string DuzKilitSebebi =>
        DuzKilitli ? (duzHata is null ? T.KartYukleniyor : T.KartYuklenemedi)
        : !PepGecerli ? Dil.T.Cari.PepGorevZorunlu
        : UyrukGecersiz(duzUyruk, yuklenenUyruk) ? P2.UyrukKodGecersiz
        : DuzAdEtiketi;

    private void DuzAlanlariSifirla()
    {
        duzAd = ""; duzTur = "MUSTERI"; duzTelefon = ""; duzTelefonKayitli = null; duzEmail = "";
        duzVergiNo = ""; duzAdres = "";
        duzKimlikTuru = ""; duzUnvan = ""; duzDogumTarihi = null; duzUyruk = "";
        duzIskonto = null; duzSegment = ""; duzHesapKodu = "";
        duzKrediLimiti = null; duzVadeGun = null; duzFiyatListesiId = "";
        duzVadeKesirli = null; sayiKapisi.Bildir("duz-vade-tam", "", false);
        duzUyrukDiger = false; yuklenenUyruk = null;
        duzNotlar = "";
        duzPepBeyani = false; duzPepGorev = ""; duzPepBeyanTarihi = null;
        yuklenenPepBeyani = false; yuklenenPepGorev = "";
    }

    private async Task DuzenleAc(CariVeri c)
    {
        duzHata = null;
        form.Temizle();
        duzDahaFazla = false;   // S3-2: basit modda çekmece KATLI açılır
        DuzAlanlariSifirla();
        duzYuklendi = false;
        duzenleCari = c;
        var acilis = ++duzAcilis;
        bool Guncel() => acilis == duzAcilis && duzenleCari?.Id == c.Id;
        // T-M1: panelin dibindeki "Son değişiklik" satırı (yalnız BASİT'te çizilir).
        // Kartla PARALEL çekilir (kilit penceresini uzatmaz); sonucu Guncel() ile yazılır.
        var sonDegisiklik = SonDegisiklikYukle(c, Guncel);
        // Liste yalnız özet taşır (vergi no, adres yok) — kartın tamamı çekilir,
        // yoksa kaydet dediğinde görünmeyen alanlar SİLİNİRDİ.
        try
        {
            var tam = await Api.GetAsync<CariDetayVeri>($"/cari/{c.Id}");
            if (!Guncel()) { await sonDegisiklik; return; }   // panel kapandı ya da başka kart açıldı
            duzAd = tam.Ad; duzTur = tam.Tur;
            duzTelefon = TelefonBicimi.Girdi(tam.Telefon); duzTelefonKayitli = tam.Telefon; duzEmail = tam.Email ?? "";
            duzVergiNo = tam.VergiNo ?? ""; duzAdres = tam.Adres ?? "";
            // ── PAKET P-16 (Y-27) ──
            duzKimlikTuru = tam.KimlikTuru ?? ""; duzUnvan = tam.Unvan ?? "";
            duzDogumTarihi = tam.DogumTarihi; duzUyruk = tam.Uyruk ?? ""; yuklenenUyruk = tam.Uyruk;
            duzIskonto = tam.IskontoYuzde; duzSegment = tam.Segment ?? "";
            duzHesapKodu = tam.HesapKodu ?? "";
            duzKrediLimiti = tam.KrediLimitiTl; duzVadeGun = tam.VarsayilanVadeGun;
            duzFiyatListesiId = tam.FiyatListesiId ?? "";
            duzNotlar = tam.Notlar ?? "";
            duzPepBeyani = tam.PepBeyani; duzPepGorev = tam.PepGorev ?? "";
            duzPepBeyanTarihi = tam.PepBeyanTarihi;
            yuklenenPepBeyani = tam.PepBeyani; yuklenenPepGorev = tam.PepGorev ?? "";
            duzYuklendi = true;
            // Liste seçenekleri modal açılırken çekilir. Bu seçici İSTEĞE BAĞLIDIR: sunucu
            // hatası ya da bozuk yanıt (JSON) ne olursa olsun düzenleme modalı ÇÖKMEZ —
            // yalnız seçici boş kalır ve hata bandında sebep görünür. Aksi halde fiyat
            // listesi ucu erişilemezken hiçbir cari düzenlenemezdi.
            try { fiyatListeleri = (await Api.GetAsync<List<FiyatListesiOzet>>("/fiyat/listeler")).Where(f => f.Aktif).ToList(); }
            catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException) { fiyatListeleri = []; if (Guncel()) duzHata = ex.Message; }
        }
        catch (ApiHata ex) { if (Guncel()) duzHata = ex.Message; }
        await sonDegisiklik;
    }

    private async Task CariGuncelle()
    {
        if (sayiKapisi.OnekleVar("duz-")) return;   // ORTAK-1: PATCH YOK
        // T-M1 yarış kilidi: kart sunucudan gelmeden (ya da gelemediyse) PATCH ATILMAZ.
        if (duzenleCari is null || !duzYuklendi) return;
        var hedefId = duzenleCari.Id;
        duzHata = null;
        form.Temizle();
        form.Zorunlu("duz-ad", duzAd, Dil);
        form.Eposta("duz-eposta", duzEmail, Dil);
        form.Telefon("duz-telefon", duzTelefon, Dil);
        form.NegatifDegil("duz-limit", duzKrediLimiti, Dil);
        // PAKET P-16 (Y-27): TCKN 11 / VKN 10 hane — ALAN ALTINDA.
        KimlikDogrula("duz-vergino", duzVergiNo, duzKimlikTuru);
        if (UyrukGecersiz(duzUyruk, yuklenenUyruk)) { duzUyrukDiger = true; form.Ekle("duz-uyruk-kod", P2.UyrukKodGecersiz); }
        if (duzIskonto is < 0m or > 100m) form.Ekle("duz-iskonto", Dil.T.Cari.IskontoYuzdeIpucu);
        if (!form.Gecerli)
        {
            // S3-2: yüklenen eski bir değer (ör. 9 haneli vergi no) katlı alanda
            // hatalıysa grup AÇILIR; kullanıcı neden kaydedemediğini GÖRÜR.
            if (GizliAlandaHataVar(form, DuzGorunurAlanlar)) duzDahaFazla = true;
            duzHata = Dil.T.Kabuk.FormEksik;
            await OdakIlkHataya();
            return;
        }
        kaydediliyor = true;
        try
        {
            await Api.PatchAsync($"/cari/{hedefId}", new
            {
                ad = duzAd.Trim(),
                tur = duzTur,
                telefon = DuzTelefonGovdesi(),
                email = BosIseNull(duzEmail),
                vergiNo = BosIseNull(duzVergiNo),
                adres = BosIseNull(duzAdres),
                krediLimitiTl = duzKrediLimiti,
                varsayilanVadeGun = duzVadeGun,
                fiyatListesiId = string.IsNullOrEmpty(duzFiyatListesiId) ? null : duzFiyatListesiId,
                // Üç durumlu sözleşme (CariGuncelleDto.NotlarVerildi): alan GÖNDERİLDİĞİ
                // için boş değer "sil" demektir — ekran notu gösterdiğine göre
                // kullanıcının silme kararını da taşımak zorundadır.
                notlar = BosIseNull(duzNotlar),
                // ═══ PAKET P-16 (Y-27) ═══ Ekran bu alanları GÖSTERDİĞİ için
                // "boşalttım" kararını da taşır: boş = SİL (PATCH sözleşmesi).
                unvan = BosIseNull(duzUnvan),
                kimlikTuru = BosIseNull(duzKimlikTuru),
                dogumTarihi = duzDogumTarihi,
                uyruk = BosIseNull(duzUyruk),
                iskontoYuzde = duzIskonto,
                segment = BosIseNull(duzSegment),
                hesapKodu = BosIseNull(duzHesapKodu),
            });

            // ⚠ PEP AYRI UÇTAN gider (PATCH /cari/{id}/pep). Sebebi kurul engel 4:
            //   pep alanlarını CariGuncelleDto gövdesine koyup tam gövde yazan bir
            //   uç, istemci bir alanı göndermediğinde onu SESSİZCE SIFIRLARDI.
            //   İkinci istek yalnız beyan GERÇEKTEN değiştiyse atılır.
            if (duzPepBeyani != yuklenenPepBeyani
                || (duzPepGorev?.Trim() ?? "") != yuklenenPepGorev)
            {
                await Api.PatchAsync($"/cari/{hedefId}/pep", new
                {
                    pepBeyani = duzPepBeyani,
                    pepGorev = duzPepBeyani ? duzPepGorev?.Trim() : null,
                });
            }

            duzenleCari = null;
            Basarili(Dil.T.Kabuk.Kaydedildi);
            await Yukle();
        }
        catch (ApiHata ex)
        {
            form.Sunucudan(ex, DuzEsleme);
            if (GizliAlandaHataVar(form, DuzGorunurAlanlar)) duzDahaFazla = true;
            duzHata = FormDurumu.SunucuMesaji(ex, Dil);
            await OdakIlkHataya();
        }
        kaydediliyor = false;
    }

    // ── Aktif/pasif geçişi (UX-S25: her pasifleştirmenin GERİ DÖNÜŞÜ vardır) ──

    /// <summary>
    /// QA turu 2 KRİTİK: "pasife alma geri alınamıyor". Sunucudaki
    /// PATCH /cari/{id} {aktif:true} ucu vardı, ekranda düğmesi yoktu.
    /// ⚠ Yalnız `aktif` gönderilir: PATCH sözleşmesi "gövdede yoksa koru"
    ///   olduğu için diğer alanlara dokunulmaz.
    /// </summary>
    private async Task AktifeAl(CariVeri c)
    {
        duzHata = null;
        listeHata = null;
        kaydediliyor = true;
        try
        {
            await Api.PatchAsync<object>($"/cari/{c.Id}", new { aktif = true });
            Basarili(Dil.T.Kabuk.AktifeAlindi);
            await Yukle();
        }
        catch (ApiHata ex) { listeHata = FormDurumu.SunucuMesaji(ex, Dil); }
        kaydediliyor = false;
    }

    /// <summary>
    /// Tek alanlı düzeltme — satır içi (K6). Telefon biçimi sunucudakiyle AYNI
    /// kuralla (Iletisim.TelefonGecerli) ön kontrolden geçer; son sözü sunucu söyler.
    /// </summary>
    private async Task TelefonKaydet(CariVeri c, string yeniDeger)
    {
        var alan = $"si-telefon-{c.Id}";
        form.Temizle();
        listeHata = null;
        if (!form.Telefon(alan, yeniDeger, Dil)) return;

        satirKaydedilen = c.Id;
        try
        {
            await Api.PatchAsync<object>($"/cari/{c.Id}",
                new { telefon = TelefonBicimi.Sunucuya(yeniDeger) });
            Basarili(Dil.T.Kabuk.Kaydedildi);
            await Yukle();
        }
        catch (ApiHata ex)
        {
            form.Ekle(alan, FormDurumu.SunucuMesaji(ex, Dil));
            listeHata = FormDurumu.SunucuMesaji(ex, Dil);
        }
        satirKaydedilen = null;
    }

    /// <summary>Tahsilat kaydetme kilidinin SEBEBİ — yoksa null (UX-S30).</summary>
    private string? TahsilatKilidi =>
        // Tur 5: boş tutar bir KİLİT değildir — Kaydet açıktır, deneme alanın altında tek cümle yazar (ThTutarHatasi).
        // SON-KALANLAR tur 2 (doğrulayıcı DÜŞÜK, kasaSecinKez=2): seçicinin yer tutucusu zaten "Kasa seçin..."
        // der; altlıktaki kilit sebebi AYNI cümleyi tekrar etmez, ne yapılacağını söyler.
        thTutar > 0 && string.IsNullOrEmpty(thKasaId) ? SonKalanlarSozlugu.Al(Dil.Dil).TahsilatKasaKilit
        // Tur 2 (hakem [KRİTİK]): nakit sınırı aşımı bir "eksik" değildir — sebebi
        // tutar alanının ALTINDA kırmızı yazılır (ThNakitSinirHatasi); burada tekrar yok.
        // YASAL-KAPI-2: MASAK kimlik formu eksikse sebep (eşik sayısı form başlığında, burada tekrar yok).
        // YASAL-KAPI-3: nakit sınırı aşılmışken form çizilmez → "kimlik bilgilerini doldurun" DENMEZ (sebep alan altında).
        : ThNakitSinirAsildi ? null
        : PM.KilitSebebi(Dil.Dil);

    /// <summary>PARA-DEMO-2 tur 5 — Kaydet denendi mi (boş tutar hatası yalnız denemeden sonra görünür).</summary>
    private bool thDenendi;
    private bool ThBos => thTutar <= 0 && thHas <= 0;
    /// <summary>Tutar alanının altındaki TEK hata: boş deneme → "Tutar ya da altın girin."; yoksa nakit sınırı.</summary>
    private string? ThTutarHatasi => thTutarSunucuHata ?? (thDenendi && ThBos ? PD2.TutarYaDaAltin : ThNakitSinirHatasi);

    /// <summary>Nakit sınırı aşıldıysa tutar alanının altındaki kırmızı hata (DoD EK md.3).</summary>
    /// YASAL-KAPI-3: büyük işlemin taksiti (TB-15) önce; yoksa günlük nakit hakkı / sunucu reddi izi (CariNakitSiniri).
    private string? ThNakitSinirHatasi => !ThNakitSinirAsildi ? null
        : ThTaksitNakitAsildi ? string.Format(TT.TahsilatNakitSinirAsildi, Bicim.Para(thTaksit!.NakitAlinabilir ?? 0m, "TRY"))
        : NS.Hata(thOdeme == "NAKIT", thTutar, tahsilatCari?.Id, Dil.Dil, TT.TahsilatNakitSinirAsildi);

    // ── PAKET YASAL-2 (TB-15) — büyük satışın taksiti ────────────────────────
    private TevsikTaksitMetinleri TT => TevsikTaksitSozlugu.Al(Dil.Dil);
    private Kuyumcu.Contracts.Sayfalar.NakitSiniri.TaksitOnizlemeVeri? thTaksit;
    private string? thTaksitHata;

    /// <summary>Sunucu: bu borçtan hiç nakit alınamaz (ilk açık parti büyük işlemden).</summary>
    private bool ThNakitKapali => thTaksit is { KuralDevrede: true, NakitAlinabilir: <= 0m };

    /// <summary>Nakit seçili ve tutar sunucunun söylediği sınırı aşıyor (UX-S30 kilidi).</summary>
    private bool ThNakitSinirAsildi => ThTaksitNakitAsildi || ThGunlukNakitAsildi;   // YASAL-KAPI-3: + günlük nakit hakkı
    private bool ThTaksitNakitAsildi =>
        thOdeme == "NAKIT" && thTaksit is { KuralDevrede: true, NakitAlinabilir: { } n } && thTutar > n;

    /// <summary>
    /// Ödeme türü seçenekleri (tek kaynak dizi). Nakit kapalıysa NAKİT listede
    /// GÖRÜNÜR ama SEÇİLEMEZ ve nedenini alt satırında söyler (tur 2: gizlemek yerine
    /// "devre dışı + neden" — şartname § 4.1).
    /// </summary>
    private IReadOnlyList<SecenekOgesi> TahsilatOdemeSecenekleri =>
        [new SecenekOgesi("NAKIT", Dil.T.Cari.Nakit, ThNakitKapali ? TT.NakitPasifSebep : NS.NakitKapali ? Y3.NakitBugunPasif : null,
            Pasif: ThNakitKapali || NS.NakitKapali),   // YASAL-KAPI-3: bugünkü nakit hakkı 0 → seçilemez
         new SecenekOgesi("KART", Dil.T.Cari.Kart), new SecenekOgesi("HAVALE", Dil.T.Cari.Havale)];

    /// <summary>Tahsilat açılırken taksit önizlemesi (hata yutulmaz — UX-S28).</summary>
    private async Task TaksitOnizlemeYukle(string cariId)
    {
        thTaksit = null; thTaksitHata = null;
        // YASAL-KAPI-3: aynı yanıtın günlük nakit hakkı da tutulur (CariNakitSiniri) — tek soru, iki kural.
        var (gunluk, hata) = await TevsikGunlukSor(cariId);
        // Tur 2 (gerçek tarayıcı bulgusu): pencere bu arada BAŞKA cari için açıldıysa
        // geç gelen yanıt o carinin kutusuna yazılmaz.
        if (tahsilatCari?.Id != cariId) return;
        thTaksitHata = hata;
        thTaksit = gunluk?.Taksit;
        NS.Yukle(gunluk);
        if ((ThNakitKapali || NS.NakitKapali) && thOdeme == "NAKIT") thOdeme = "KART";
    }

    private bool pasifOnayAcik;
    private CariBagliKayit? pasifBagli;
    private bool pasifBagliYukleniyor;

    /// <summary>
    /// P-38 · B-39 — pasife alınacak cari. Artık çekmeceden BAĞIMSIZDIR:
    /// liste satırından da, çekmeceden de aynı onay modalı açılır.
    /// </summary>
    private CariVeri? pasifAday;

    /// <summary>
    /// PAKET P-13 (B-39): onay penceresi açılırken bağlı kayıt sayıları okunur.
    /// İstek patlarsa pencere yine açılır ama sayı UYDURULMAZ; hata bandı çıkar
    /// (Anayasa md.1 · UX-S28).
    /// </summary>
    private async Task PasifOnayAc(CariVeri? cari)
    {
        if (cari is null) return;
        pasifAday = cari;
        duzHata = null;
        listeHata = null;
        pasifBagli = null;
        pasifOnayAcik = true;
        pasifBagliYukleniyor = true;
        try { pasifBagli = await Api.GetAsync<CariBagliKayit>($"/cari/{cari.Id}/bagli-kayitlar"); }
        catch (ApiHata ex) { duzHata = FormDurumu.SunucuMesaji(ex, Dil); }
        pasifBagliYukleniyor = false;
    }

    private async Task CariPasifeAl()
    {
        if (pasifAday is null) return;
        duzHata = null;
        kaydediliyor = true;
        try
        {
            // Sunucu SİLMEZ, pasife alır — hareket geçmişi korunur.
            await Api.DeleteAsync<object>($"/cari/{pasifAday.Id}");
            pasifOnayAcik = false;
            // Çekmece yalnız AYNI cari açıksa kapanır (listeden pasife alınan
            // başka bir cari, açık çekmeceyi kapatmaz).
            if (duzenleCari is not null && duzenleCari.Id == pasifAday.Id) duzenleCari = null;
            pasifAday = null;
            Basarili(Dil.T.Cari.PasifeAlOnay);
            await Yukle();
        }
        catch (ApiHata ex) { duzHata = FormDurumu.SunucuMesaji(ex, Dil); }
        kaydediliyor = false;
    }

    // ── Tahsilat / veresiye ──────────────────────────────────────────────────

    /// <summary>
    /// Düzeltme fişi yalnız SAHIP · MUDUR · MUHASEBE rollerine ÇİZİLİR (KenarCubugu deseni).
    /// ⚠ Bu bir KAPI DEĞİL, ikinci kapıdır: sunucudaki [RolGerekli] kaldırılmadan durur.
    /// </summary>
    private bool DuzeltmeGorebilir => Oturum.Kullanici?.Rol is "SAHIP" or "MUDUR" or "MUHASEBE";

    private void DuzeltmeAc(CariVeri c) { islemHata = null; duzeltmeCari = c; dzTl = 0; dzHas = 0; dzGerekce = ""; }

    private async Task DuzeltmeGonder()
    {
        if (duzeltmeCari is null || sayiKapisi.OnekleVar("dz-")) return;   // ORTAK-1: POST YOK
        kaydediliyor = true; islemHata = null;
        try
        {
            await Api.PostAsync($"/cari/{duzeltmeCari.Id}/duzeltme", new { tlDelta = dzTl, hasDelta = dzHas, gerekce = dzGerekce.Trim(), kurSnapshotId = await GuncelKurId() });
            duzeltmeCari = null;
            await Yukle();
        }
        catch (ApiHata ex) { islemHata = ex.Message; }
        kaydediliyor = false;
    }

    private async Task TahsilatAc(CariVeri c)
    {
        islemHata = null; tahsilatCari = c; thTutarSunucuHata = null; thHasSunucuHata = null;
        thTutar = 0m; thHas = 0m; thOdeme = "NAKIT"; thAciklama = ""; thKasaId = ""; thHasAcik = false; thNotAcik = false; thDenendi = false;
        // Tur 2 (gerçek tarayıcı bulgusu): önceki carinin nakit sınırı kutusu, kasalar
        // yüklenirken YENİ carinin penceresinde görünüyordu → ilk çizimden önce temizlenir.
        thTaksit = null; thTaksitHata = null;
        NS.Ac();             // YASAL-KAPI-3: önceki formun nakit sınırı izi kalmaz
        await PM.Ac(c.Id);   // YASAL-KAPI-2: önceki formun beyanı/izi kalmaz
        await KasalariYukle();
        // UX-S22 — tek TL kasası varsa sorulmaz, atanır.
        if (TahsilatKasaTek) thKasaId = TahsilatKasalari[0].Id;
        await TaksitOnizlemeYukle(c.Id);   // PAKET YASAL-2 (TB-15)
    }

    private async Task KasalariYukle()
    {
        try { kasalar = (await Api.GetAsync<List<KasaOzet>>("/kasalar")).Where(k => k.Aktif).ToList(); }
        catch (ApiHata ex) { kasalar = []; islemHata = ex.Message; }
    }

    private async Task TahsilatKaydet()
    {
        if (tahsilatCari is null || sayiKapisi.OnekleVar("th-")) return;   // ORTAK-1: POST YOK
        thDenendi = true;
        if (ThBos) return;   // PARA-DEMO-2 tur 5: POST YOK — alanın altında "Tutar ya da altın girin."
        islemHata = null; thTutarSunucuHata = null; thHasSunucuHata = null;
        kaydediliyor = true;
        try
        {
            await Api.PostAsync($"/cari/{tahsilatCari.Id}/tahsilat", new
            {
                tlTutari = thTutar > 0 ? thTutar : (decimal?)null,
                hasGrami = thHas > 0 ? thHas : (decimal?)null,
                odemeTuru = thOdeme,
                // TL tutarı varsa sunucu kasayı ZORUNLU tutar (UX-4b madde 9).
                kasaId = thTutar > 0 ? BosIseNull(thKasaId) : null,
                aciklama = BosIseNull(thAciklama),
                kurSnapshotId = await GuncelKurId(),
                masak = PM.Govde,   // YASAL-KAPI-2: yalnız kapı açıkken (eşik altında gövdede beyan yok)
            });
            var tahsilEdilenId = tahsilatCari.Id;
            tahsilatCari = null;
            await Yukle();
            // PARA-DEMO (UX-S27): kayıt sonucu görünür — TL borç ve altın hesabı AYRI yazılır.
            if (CariListesi.FirstOrDefault(c => c.Id == tahsilEdilenId) is { } sonra)
                Basarili(string.Format(PD.TahsilatKaydedildi, Bicim.Para(sonra.TlBakiye, "TRY"), HasBicim(sonra.HasGramBakiye)));
        }
        // YASAL-KAPI-2: MASAK reddi ham metinle basılmaz — kimlik alanları açılır (ParaMasakKapisi).
        catch (ApiHata ex) when (ParaMasakKapisi.MasakReddi(ex)) { await PM.Reddet(ex, Dil.Dil); }
        // YASAL-KAPI-3: nakit sınırı reddi bantta değil tutar alanının altında; ödeme türü/tutar değişince kalkar (iz).
        catch (ApiHata ex) when (CariNakitSiniri.NakitReddi(ex) && thOdeme == "NAKIT") { NS.Reddet(ex, thTutar, tahsilatCari?.Id); }
        // SON-KALANLAR (hasım DÜŞÜK, Pk1440__21): alan anahtarlı red (tlTutari / hasGrami) kutunun ALTINDA ve
        // kutu kırmızı; bantta tekrar yok. Alan dışı ya da çizili olmayan alanın reddi bantta kalır (UX-S28).
        catch (ApiHata ex)
        {
            var tl = ex.Alanlar.FirstOrDefault(a => string.Equals(a.Key, "tlTutari", StringComparison.OrdinalIgnoreCase)).Value;
            var has = ex.Alanlar.FirstOrDefault(a => string.Equals(a.Key, "hasGrami", StringComparison.OrdinalIgnoreCase)).Value;
            var hasCizili = thHasAcik || thHas > 0m;
            thTutarSunucuHata = tl is { Length: > 0 } ? string.Join(" ", tl) : null;
            thHasSunucuHata = hasCizili && has is { Length: > 0 } ? string.Join(" ", has) : null;
            var esleme = new Dictionary<string, string> { ["tlTutari"] = "th-tutar" };
            if (hasCizili) esleme["hasGrami"] = "th-has";
            islemHata = FormDurumu.BantMesaji(ex, Dil, esleme);
        }
        kaydediliyor = false;
    }

    /// <summary>SON-KALANLAR — sunucunun tutar/altın alanı reddi (alan altında); kullanıcı yazınca silinir.</summary>
    private string? thTutarSunucuHata, thHasSunucuHata;
    private async Task ThTutarDegisti(decimal? v) { thTutar = v ?? 0m; thTutarSunucuHata = null; await PM.Tazele(thTutar, tahsilatCari?.Id); }
    private void ThHasDegisti(decimal? v) { thHas = v ?? 0m; thHasSunucuHata = null; }

    private ParaDemoMetinleri PD => ParaDemoSozlugu.Al(Dil.Dil);

    /// <summary>
    /// PARA-DEMO (madde 5) — satır başına yürüyen TL bakiye (satırdan SONRAKİ bakiye).
    /// Liste en yeniden eskiye; en yeni satırın sonrası = sunucunun kayıtlı TL bakiyesi,
    /// her eski satır = sonraki − o satırın etkisi. Etkisi bilinmeyen satırdan eskisi null ("—"),
    /// uydurulmaz (Anayasa md.1).
    /// </summary>
    private ParaDemo2Metinleri PD2 => ParaDemo2Sozlugu.Al(Dil.Dil);
    /// <summary>PARA-DEMO-2 (madde 7): "+ Altınla öde" / "+ Not ekle" açıldı mı (pencere her açılışta kapalı).</summary>
    private bool thHasAcik, thNotAcik;
    /// <summary>PARA-DEMO-2 (madde 6): hurda alış ekranının bu moddaki GERÇEK adı (BASİT karo "Alış · eski altın").</summary>
    private string HurdaAlisAdi => Sade ? SatisTuvalSozlugu.Al(Dil.Dil).KaroAlisEskiAltin : Dil.T.Islem.HurdaAlis;
    /// <summary>PARA-DEMO-2 (madde 7): tahsilat penceresinde güncel borç satırı.</summary>
    private string ThGuncelBorc => (tahsilatCari?.TlBakiye ?? 0m) switch
    {
        > 0m => string.Format(PD2.GuncelBorc, Bicim.Para(tahsilatCari!.TlBakiye, "TRY")),
        < 0m => string.Format(PD2.GuncelAlacak, Bicim.Para(-tahsilatCari!.TlBakiye, "TRY")),
        _ => PD2.BorcYok,
    };

    /// <summary>PARA-DEMO-2 (madde 9): satırın has bakiyesine etkisi var mı (emanet hariç).</summary>
    private static bool HasEtkili(EkstreHareket h) => !h.Emanet && h.HasBakiyesineGirer && SatirEtkisi(h) != 0m;

    /// <summary>
    /// PARA-DEMO-2 (madde 1): ekstre satırının ödeme adı — gerçek karmada "Karma ödeme" değil bacak
    /// türleri ("Kart + Havale", sunucu odemeAraclari); bilinmeyen kod uydurulmaz.
    /// </summary>
    private string? EkstreOdemeAdi(EkstreHareket h) =>
        h.OdemeTuru == "KARMA" && h.OdemeAraclari is { Count: > 0 } araclar
            // PARA-DEMO-3 tur 2: karma adı gün sonuyla TEK üreticiden (ParaDemo3Sozlugu.OdemeAdi).
            ? Kuyumcu.Core.I18n.ParaDemo3Sozlugu.OdemeAdi(h.OdemeTuru, araclar, Dil.Dil)
            : PD.OdemeAdi(h.Tur, h.TlTutari, h.HasGrami, h.OdemeTuru);

    /// <summary>PARA-DEMO-2 (madde 9): yürüyen HAS bakiyesi — en yeni satır = üstteki emanetsiz has, eskisi = sonraki − etki.</summary>
    private Dictionary<string, decimal> YuruyenHasBakiyeler()
    {
        var sonuc = new Dictionary<string, decimal>();
        var sonra = DetayHas;
        foreach (var h in DetayHareketler)
        {
            sonuc[h.Id] = sonra;
            sonra -= HasEtkili(h) ? SatirEtkisi(h) : 0m;
        }
        return sonuc;
    }

    private Dictionary<string, decimal?> YuruyenBakiyeler()
    {
        var sonuc = new Dictionary<string, decimal?>();
        decimal? sonra = DetayTl;
        foreach (var h in DetayHareketler)
        {
            sonuc[h.Id] = sonra;
            sonra = sonra is { } s && h.CariTlEtkisi is { } e ? s - e : null;
        }
        return sonuc;
    }

    private async Task VeresiyeAc(CariVeri c)
    {
        islemHata = null; veresiyeCari = c;
        vrTutar = 0m; vrHas = 0m; vrAciklama = "";
        await PM.Ac(c.Id);   // YASAL-KAPI-2
    }

    private async Task VeresiyeKaydet()
    {
        if (veresiyeCari is null || sayiKapisi.OnekleVar("vr-")) return;   // ORTAK-1: POST YOK
        islemHata = null;
        kaydediliyor = true;
        try
        {
            await Api.PostAsync($"/cari/{veresiyeCari.Id}/veresiye", new
            {
                tlTutari = vrTutar,
                hasGrami = vrHas > 0 ? vrHas : (decimal?)null,
                aciklama = BosIseNull(vrAciklama),
                kurSnapshotId = await GuncelKurId(),
                masak = PM.Govde,   // YASAL-KAPI-2
            });
            veresiyeCari = null;
            await Yukle();
        }
        catch (ApiHata ex) when (ParaMasakKapisi.MasakReddi(ex)) { await PM.Reddet(ex, Dil.Dil); }
        catch (ApiHata ex) { islemHata = ex.Message; }
        kaydediliyor = false;
    }

    /// <summary>
    /// İşlemin bağlanacağı kur fotoğrafı. Sunucu bunu ZORUNLU tutar: her hareket
    /// o anki kura bağlıdır, sonradan yeniden fiyatlanamaz.
    /// </summary>
    private async Task<string> GuncelKurId()
    {
        var kur = await Api.GetAsync<KurVeri>("/kur/guncel");
        return kur.Id;
    }


    private static string? BosIseNull(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private void Yenile() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Dil.Degisti -= Yenile;
        Modu.Degisti -= ModDegisti;
    }
}
