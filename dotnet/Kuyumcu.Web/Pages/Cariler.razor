    /// <summary>Sıfırdan farklı döviz bakiyeleri — gürültü yok (rozet yalnız dolu olana).</summary>
    private static List<(string ParaBirimi, decimal Tutar)> DovizRozetleri(CariVeri c)
    {
        var liste = new List<(string, decimal)>();
        if (c.UsdBakiye != 0m) liste.Add(("USD", c.UsdBakiye));
        if (c.EurBakiye != 0m) liste.Add(("EUR", c.EurBakiye));
        if (c.GbpBakiye != 0m) liste.Add(("GBP", c.GbpBakiye));
        return liste;
    }

    private List<(string ParaBirimi, decimal Tutar)> DetayDoviz
    {
        get
        {
            var b = ekstre?.Bakiye;
            var liste = new List<(string, decimal)>();
            var usd = b?.UsdBakiye ?? detayCari?.UsdBakiye ?? 0m;
            var eur = b?.EurBakiye ?? detayCari?.EurBakiye ?? 0m;
            var gbp = b?.GbpBakiye ?? detayCari?.GbpBakiye ?? 0m;
            if (usd != 0m) liste.Add(("USD", usd));
            if (eur != 0m) liste.Add(("EUR", eur));
            if (gbp != 0m) liste.Add(("GBP", gbp));
            return liste;
        }
    }

