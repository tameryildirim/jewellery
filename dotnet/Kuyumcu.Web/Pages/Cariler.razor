@page "/cariler"
@using Kuyumcu.Contracts.Sayfalar.Cariler
@using Kuyumcu.Core.Domain.Girdi
@inject ApiIstemci Api
@inject DilServisi Dil
@inject OturumServisi Oturum
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ArayuzModuServisi Modu
@implements IDisposable

@* Kaynak: apps/web/src/pages/CariPage.tsx — Kasalar.razor desenini izler. *@

<PageTitle>@Marka.SayfaBasligi(Dil.T.Cari.Baslik)</PageTitle>
@* ORTAK-1 (KEŞİF #4): sayfadaki HER Sayi/Para/Gram kutusu ortak geçersiz sayı kapısına yazılır. *@
<CascadingValue Value="sayiKapisi" IsFixed="true">

@* ═══ PAKET T-M1 — MÜŞTERİLER TUVALE (tuval/project/Musteriler.dc.html, BASİT) ═══
   Sarmalayıcı yalnız ÇİZİM sınıfı taşır; PROFESYONEL yüzde sınıf yoktur ve DOM
   bugünküdür. Panel açıkken (BASİT, ≥ 1024 px) liste panelin SOLUNDA kalır:
   tuvalde panelin altında kalan sütunlar (Has, eylemler) gizlenir, hiçbir yazı
   panelin altına girmez (sikisma-olc K9). *@
<div class="musteri-sayfa @(Sade ? "musteri-sade" : null) @(Sade && duzenleCari is not null ? "musteri-sade--panel-acik" : null)">
@* PAKET YILDIZ-4B: liste = tuval Musteri4/Musteri4a (YildizMusteriler), BASİT + PRO. Tema temizliği (17.10): eski özgün liste kaldırıldı.
   SAYFA_BASI_MUAFIYETI: ortak şerit (SayfaBasi) yalnız eski özgün listede çiziliyordu; tuval Musteri4 kendi başlığını
   (YildizMusteriler #yildiz-musteri-baslik, tek h1) ve arama/segment/yeni müşteri satırını taşır — ikinci başlık şeridi tuvalle çelişir. *@
 <Kuyumcu.Web.Bilesenler.Yildiz.YildizMusteriler B="@YildizBaglami" /> 
</div>

@* ── Yeni cari modalı ── *@
<ModalPencere Acik="yeniModalAcik" Baslik="@Dil.T.Cari.YeniCari" Kapat="() => yeniModalAcik = false">
    <div class="form-dikey">
        @* PAKET GOC-B (C satır 28, K19/K20): ekran 300 / sunucu 200 uyuşmuyordu; "12345" ad olarak geçiyordu →
           ortak Unvan (en az 2, bir harf; çift boşluk teke), sınır kolonla TEK sabit. *@
        <Unvan ElemanId="cari-ad" Etiket="@Dil.T.Cari.AdFirma" Zorunlu="true" EnFazla="@AlanSinirlari.CariAd"
               Deger="@yeniAd" DegerChanged="@(v => yeniAd = v ?? "")"
               Durum="form" HataAlani="cari-ad" />
        @* PAKET S3-2 — basit modda görünen: ad, telefon, not (taslak n3); gerisi
           "Daha fazla ▾" ile açılır. Profesyonel modda DOM BİREBİR bugünküdür. *@
        @if (YeniTumAlanlar)
        {
        <div class="alan">
            @* UX-S26: seçenekler TEK diziden üretilir — iki modalda iki farklı
               küme olamaz. Sunucu (CariOlusturDto.Tur regex'i) beşini de kabul eder. *@
            <Secici ElemanId="cari-tur"
                    Etiket="@Dil.T.Cari.Tur"
                    Secenekler="@CariTurSecenekleri"
                    @bind-Deger="yeniTur" />
        </div>
        }
        <TelefonBicimli ElemanId="cari-telefon" Etiket="@Dil.T.Cari.Telefon"
                 Deger="@yeniTelefon" DegerChanged="@(v => yeniTelefon = v ?? "")"
                 Durum="form" HataAlani="cari-telefon" />
        @if (YeniTumAlanlar)
        {
        <Eposta ElemanId="cari-eposta" Etiket="@Dil.T.Auth.Eposta" EnFazla="@AlanSinirlari.Eposta"
                Deger="@yeniEmail" DegerChanged="@(v => yeniEmail = v ?? "")"
                Durum="form" HataAlani="cari-eposta" />
        @* ═══ PAKET P-16 (Y-27) — KİMLİK / KYC ALANLARI ══════════════════════
           UX-S26: sunucunun OLUŞTURMADA kabul ettiği alanlar düzenlemeye ertelenmez.
           UX-S24: kimlik TÜRÜ seçilince hane kuralı değişir ve alan altında yazar. *@
        @* PAKET GOC-B (envanter F1): genel Metin → TcknVeyaVkn (rakam dışı yazılamaz, 10/11 hane dolunca algoritma);
           kimlik TÜRÜ seçiliyse hane kuralı ayrıca alan altında (TcknAnindaHata, UX-S24). *@
        <TcknVeyaVkn ElemanId="cari-vergino" Etiket="@Dil.T.Cari.VergiNo"
               Deger="@yeniVergiNo" DegerChanged="@(v => yeniVergiNo = v ?? "")" Hata="@TcknAnindaHata(yeniVergiNo, yeniKimlikTuru)"
               Durum="form" HataAlani="cari-vergino"
               Ipucu="@KimlikHaneIpucu(yeniKimlikTuru)" />
        <fieldset class="form-grid-2 form-satiri" id="cari-p16">
            <legend>@Dil.T.Cari.KimlikBolumu</legend>
            <div class="alan">
                <Secici ElemanId="cari-kimlik-turu"
                        Etiket="@Dil.T.Cari.KimlikTuru"
                        Secenekler="@(KimlikTurleri.Select(t => new SecenekOgesi(t.Deger, t.Etiket)).ToList())"
                        @bind-Deger="yeniKimlikTuru"
                        BosSecenekMetni="@Dil.T.Cari.KimlikTuruBelirtilmedi" />
            </div>
            <Unvan ElemanId="cari-unvan" Etiket="@Dil.T.Cari.Unvan" EnFazla="@AlanSinirlari.CariUnvan"
                   Deger="@yeniUnvan" DegerChanged="@(v => yeniUnvan = v ?? "")"
                   Ipucu="@Dil.T.Cari.UnvanIpucu" />
            @* PAKET GOC-B (envanter #2) K8f (tur 2): gelecek / 120 yıldan eski yazılamaz; 18 yaş altı ENGEL DEĞİL, yalnız uyarı — sunucu aynı kural. *@
            <Tarih ElemanId="cari-dogum" Etiket="@Dil.T.Cari.DogumTarihi" Tur="TarihTuru.KisiDogum"
                   Ipucu="@DogumUyari(yeniDogumTarihi)" @bind-Deger="yeniDogumTarihi" />
            @* KESIF-P2 (#22): MASAK formuyla AYNI ülke seçicisi (UlkeListesi, ISO alpha-3).
               Hücre yalnız seçiciyi taşır (ızgara hizası K7); "Diğer ülke" kod kutusu KENDİ hücresidir. *@
            <div class="alan" id="cari-uyruk-alan">
                <Secici ElemanId="cari-uyruk" Etiket="@Dil.T.Cari.Uyruk"
                        Secenekler="@UlkeSecenekleri" BosSecenekMetni="@P2.UyrukSecin"
                        Deger="@UyrukSecimi(yeniUyruk, yeniUyrukDiger)" DegerChanged="YeniUyrukSecildi" />
            </div>
            @if (UyrukDigerMi(yeniUyruk, yeniUyrukDiger))
            {
                <Metin ElemanId="cari-uyruk-kod" Etiket="@P2.UyrukKod" Ipucu="@P2.UyrukKodIpucu" EnFazla="@AlanSinirlari.UyrukKod"
                       Hata="@(UyrukKodHatasi(yeniUyruk, null))"
                       Deger="@yeniUyruk" DegerChanged="@(v => yeniUyruk = (v ?? "").Trim().ToUpperInvariant())" />
            }
            @* PAKET GOC-B (C satır 73, K15): Yuzde — 0–100, en çok 2 ondalık Kaydet'ten ÖNCE alan altında (eskiden yalnız sunucu). *@
            <Yuzde ElemanId="cari-iskonto" Etiket="@Dil.T.Cari.IskontoYuzde"
                  @bind-Deger="yeniIskonto" Birim="%"
                  Durum="form" HataAlani="cari-iskonto"
                  Ipucu="@Dil.T.Cari.IskontoYuzdeIpucu" />
            <div class="alan">
                <Secici ElemanId="cari-segment"
                        Etiket="@Dil.T.Cari.Segment"
                        Secenekler="@(Segmentler.Select(_o => new SecenekOgesi(_o.Item1, _o.Item2)).ToList())"
                        @bind-Deger="yeniSegment"
                        BosSecenekMetni="@Dil.T.Cari.SegmentSecilmedi" />
            </div>
            @* PAKET P-26 (Y-37) · UX-S26 — sunucunun OLUŞTURMADA kabul ettiği
               hesap kodu "sonra düzenlemeden gir" diye ertelenmez. *@
            <Metin ElemanId="cari-hesap-kodu" Etiket="@Dil.T.Cari.HesapKodu" EnFazla="@AlanSinirlari.HesapKodu"
                   Deger="@yeniHesapKodu" DegerChanged="@(v => yeniHesapKodu = v ?? "")"
                   Ipucu="@Dil.T.Cari.HesapKoduIpucu" />
        </fieldset>
        @* PAKET GOC-B (C satır 32): 500 karakterlik adres tek satır Metin'deydi → CokSatir; sınır kolonla TEK sabit.
           K21 "en az 10 karakter" TEYİTSİZ iş kuralı → uygulanmadı (bugünkü davranış). *@
        <CokSatir ElemanId="cari-adres" Etiket="@Dil.T.Cari.Adres" Satir="2" EnFazla="@AlanSinirlari.Adres"
                  Deger="@yeniAdres" DegerChanged="@(v => yeniAdres = v ?? "")" />
        @* UX-S26 — sunucunun OLUŞTURMADA kabul ettiği alanlar "sonra düzenlemeden
           gir" diye ertelenmez: kredi limiti, varsayılan vade ve fiyat listesi
           CariOlusturDto'da başından beri vardı, bu modalda YOKTU. *@
        <div class="form-grid-2 form-satiri">
            <Para ElemanId="cari-limit" Etiket="@Dil.T.Cari.KrediLimiti" Tur="TutarTuru.SifirOlabilir" ParaBirimi="TRY"
                  @bind-Deger="yeniKrediLimiti" Durum="form" HataAlani="cari-limit" />
            <Sayi ElemanId="cari-vade" Etiket="@Dil.T.Vade.VarsayilanVadeGun" EnAz="0" EnCok="3650"
                  Deger="@(yeniVadeKesirli ?? (yeniVadeGun is { } _g ? (decimal?)_g : null))"
                  Hata="@(yeniVadeKesirli is not null ? P2.VadeTamSayi : null)"
                  DegerChanged="YeniVadeDegisti" />
        </div>
        <div class="alan">
            <Secici ElemanId="cari-fiyat-listesi"
                    Etiket="@Dil.T.Fiyat.FiyatListesi"
                    Secenekler="@FiyatListesiSecenekleri"
                    @bind-Deger="yeniFiyatListesiId"
                    BosSecenekMetni="@VarsayilanListeMetni" />
        </div>
        }
        @* PAKET P-10 (Y-3): CariOlusturDto.Notlar sunucuda vardı, formda YOKTU. *@
        <CokSatir ElemanId="cari-notlar" Etiket="@Dil.T.Cari.Notlar" Satir="2" EnFazla="@AlanSinirlari.CariNot"
                  Deger="@yeniNotlar" DegerChanged="@(v => yeniNotlar = v ?? "")"
                  Ipucu="@Dil.T.Cari.NotlarIpucu" />
        @if (Modu.BasitMi)
        {
            <button @onclick="() => yeniDahaFazla = !yeniDahaFazla" type="button" class="dugme dugme-ikincil dugme-kucuk form-daha-fazla" id="cari-daha-fazla"
                    aria-expanded="@(yeniDahaFazla ? "true" : "false")">
                @* T-M1: tuval "Daha fazla (adres, TC, e-posta, limit)" + sağda ok; ok ince
                   çizgili Ikon (emoji/glif değil), açıkken CSS ile yukarı döner. *@
                <span>@(yeniDahaFazla ? M.DahaAz : $"{M.DahaFazla} ({M.DahaFazlaIcerik})")</span>
                <Ikon Ad="@Ikonlar.KatlamaAcik" Sinif="@(yeniDahaFazla ? "katla-ok katla-ok--acik" : "katla-ok")" />
            </button>
        }
        <HataBandi Mesaj="@modalHata" />

        <div class="satir">
            <button id="cari-yeni-vazgec" class="btn btn-ikincil" style="flex:1" @onclick="() => yeniModalAcik = false">@Vazgec</button>
            @* DoD EK md.3 / UX-S30: düğme artık boş adda KİLİTLENMEZ — tıklanır ve
               alan altında Türkçe mesaj çıkar. Sessiz etkisizlik de, sebebi
               yazmayan kilit de yasak. *@
            <button id="cari-kaydet" class="btn btn-birincil" style="flex:1" disabled="@(kaydediliyor || sayiKapisi.OnekleVar("cari-") || TcknAnindaHata(yeniVergiNo, yeniKimlikTuru) is not null)"
                    @onclick="CariOlustur">@Dil.T.Ortak.Kaydet</button>
        </div>
        @* ORTAK-1 (KEŞİF #4): Kaydet'in "sayı anlaşılamadı" kilit sebebi (UX-S30) düğmenin hemen altında. *@
        <SayiKapisiSebebi Kapi="sayiKapisi" Onek="cari-" ElemanId="cari-sayi-kilit" />
        @if (TcknAnindaHata(yeniVergiNo, yeniKimlikTuru) is { } tcknKilit) { <p class="metin-kucuk metin-amber" id="cari-tckn-kilit" role="status">@tcknKilit</p> }
    </div>
</ModalPencere>

@* ── Cari düzenleme ÇEKMECESİ (DoD EK md.2 — TEK DÜZENLEME KALIBI) ──
   Çok alanlı düzenleme ModalPencere'den Cekmece'ye taşındı; ModalPencere
   bundan sonra yalnız YIKICI ONAY için kullanılır (denetim.sh sayacı düşer).
   ⚠ İÇTEKİ ALAN id'leri AYNEN korundu (#duz-ad, #duz-tur, …) — K4 sözleşmesi.
   ⚠ İYİMSER KAYDETME YOK: çekmece kendini kapatmaz; sunucu 200 dönünce
     CariGuncelle `duzenleCari = null` yapar. *@
@* T-M1: sarmalayıcı yalnız BASİT (tuval) çizim sınıfı taşır; Cekmece ortak
   bileşendir ve DEĞİŞMEDİ. BASİT'te başlık müşterinin adıdır (tuval "Hasan Kaya"). *@
<div class="musteri-panel-kap @(Sade ? "musteri-panel-kap--sade" : null)">
<Cekmece Acik="@(duzenleCari is not null)" Varlik="cari" IptalMetni="@Vazgec"
         Baslik="@(Sade && duzenleCari is not null ? duzenleCari.Ad : Dil.T.Cari.CariDuzenle)"
         Kapat="() => duzenleCari = null" Kaydet="CariGuncelle"
         Kaydediliyor="@kaydediliyor"
         KaydetAktif="@(!DuzKilitli && !string.IsNullOrWhiteSpace(duzAd) && PepGecerli && !sayiKapisi.OnekleVar("duz-") && !UyrukGecersiz(duzUyruk, yuklenenUyruk) && TcknAnindaHata(duzVergiNo, duzKimlikTuru) is null)"
         KilitSebebi="@(sayiKapisi.Sebep(Dil.Dil, "duz-") ?? TcknAnindaHata(duzVergiNo, duzKimlikTuru) ?? DuzKilitSebebi)">
    <div class="form-dikey @(Sade ? "musteri-panel-form" : null)">
        @if (duzenleCari is { } ykart) { <Kuyumcu.Web.Bilesenler.Yildiz.YildizKartEylemleri Eylemler="@YildizKartEylemleri(ykart)" /> }   @* YILDIZ-4B: tuval "kart açılır: tahsilat, ekstre, düzenleme" — listede satır eylemi yok, yollar kartta *@
        @* T-M1 — tuval uyarı bandı: vadesi geçmiş borç varsa panelin başında KIRMIZI
           bant ve para alma yolu. "Tahsilat" gerçek düğmedir (tahsilat penceresini
           açar) — tuvalde "listedeki" düğmeye yönlendiriyordu; panel listeyi
           örttüğü için yol panelin İÇİNDE verilir (özellik silinmez, UX-S25). *@
        @if (Sade && duzenleCari is not null && GecikmeGun(duzenleCari) is > 0 and var gg)
        {
            <div class="musteri-panel-uyari" id="cari-panel-uyari" role="status">
                @* Tırnaklar düğmenin DIŞINDA, sözlükte (TR tuval metni; EN tırnaksız). Boşluk sözlükte. *@
                @string.Format(T.VadeUyariOnce, gg)<button type="button" class="musteri-baglanti musteri-baglanti--tehlike" id="cari-panel-tahsilat" @onclick="PaneldenTahsilat">@T.TahsilatDugmesi</button>@T.VadeUyariSonra
            </div>
        }
        @* PAKET GOC-B (C satır 34): ortak Unvan, sınır kolonla TEK sabit. *@
        <Unvan ElemanId="duz-ad" Yukleniyor="@DuzKilitli" Etiket="@DuzAdEtiketi" Zorunlu="true" EnFazla="@AlanSinirlari.CariAd"
               Hata="@(!DuzKilitli && duzenleCari is not null && string.IsNullOrWhiteSpace(duzAd) ? string.Format(P2.AdZorunlu, DuzAdEtiketi) : null)"
               Deger="@duzAd" DegerChanged="@(v => duzAd = v ?? "")"
               Durum="form" HataAlani="duz-ad" />
        @* KESIF-P2 (#22 · ekip kararı 4): eşlenemeyen eski uyruk kodu UYDURULMAZ — kart açılınca
           (katlı alanlar kapalıyken de) görünür uyarı; değer değişmedikçe kart kaydedilebilir. *@
        @if (DuzUyrukDuzeltilmeli)
        {
            <p class="metin-kucuk" id="duz-uyruk-duzeltin" role="status">
                <Rozet Renk="sari">@P2.UyrukDuzeltin</Rozet>
                <span class="metin-soluk" id="duz-uyruk-duzeltin-aciklama">@string.Format(P2.UyrukDuzeltinAciklama, yuklenenUyruk)</span>
            </p>
        }
        @* PAKET S3-2 — basit modda görünen: ad, telefon, not (+ PEP beyanı VARSA);
           gerisi "Daha fazla ▾". Katlı alanların DEĞERİ yüklenmiştir ve PATCH ile
           AYNEN geri gider — gizlemek silmek DEĞİLDİR. *@
        @if (DuzTumAlanlar)
        {
        <div class="alan">
            <Secici ElemanId="duz-tur" Devredisi="@DuzKilitli"
                    Etiket="@Dil.T.Cari.Tur"
                    Secenekler="@(CariTurleri.Select(_o => new SecenekOgesi(_o.Item1, _o.Item2)).ToList())"
                    @bind-Deger="duzTur" />
        </div>
        }
        @* T-M1: BASİT'te (katlıyken) telefon tek başına TAM genişlik (tuval); biçim ipucu
           tuvalde yok → BASİT'te çizilmez, sunucu hatası yine alanın altına düşer. *@
        <div class="@(DuzTumAlanlar ? "form-grid-2 form-satiri" : "form-tek")">
            <TelefonBicimli ElemanId="duz-telefon" Yukleniyor="@DuzKilitli" Etiket="@Dil.T.Cari.Telefon"
                     Deger="@duzTelefon" DegerChanged="@(v => duzTelefon = v ?? "")"
                     Ipucu="@(Sade ? "" : null)"
                     Durum="form" HataAlani="duz-telefon" />
            @if (DuzTumAlanlar)
            {
            <Eposta ElemanId="duz-eposta" Yukleniyor="@DuzKilitli" Etiket="@Dil.T.Auth.Eposta" EnFazla="@AlanSinirlari.Eposta"
                    Deger="@duzEmail" DegerChanged="@(v => duzEmail = v ?? "")"
                    Durum="form" HataAlani="duz-eposta" />
            }
        </div>
        @if (DuzTumAlanlar)
        {
        @* ═══ PAKET P-16 (Y-27) — OLUŞTURMA FORMUYLA AYNI KÜME (UX-S26) ══════
           Seçenek listeleri (KimlikTurleri, Segmentler) TEK diziden üretilir. *@
        <TcknVeyaVkn ElemanId="duz-vergino" Yukleniyor="@DuzKilitli" Etiket="@Dil.T.Cari.VergiNo"
               Deger="@duzVergiNo" DegerChanged="@(v => duzVergiNo = v ?? "")" Hata="@TcknAnindaHata(duzVergiNo, duzKimlikTuru)"
               Durum="form" HataAlani="duz-vergino"
               Ipucu="@KimlikHaneIpucu(duzKimlikTuru)" />
        @* KESIF-P2 tur 2 (#20, hakem): "(isteğe bağlı)" satırı olan ve olmayan etiketler aynı üst çizgide —
           ortak `.form-satiri` kuralı (app.css (3) ORTAK FORM SATIRI) etiketi rayın üstüne yaslar. Kutu hizası
           (K7) zaten 0'dı; ölçer etiket METNİNİ ölçmediği için 1440 PRO'da ~13 px metin kayması görünmemişti. *@
        <fieldset class="form-grid-2 form-satiri" id="duz-p16">
            <legend>@Dil.T.Cari.KimlikBolumu</legend>
            <div class="alan">
                <Secici ElemanId="duz-kimlik-turu" Devredisi="@DuzKilitli"
                        Etiket="@Dil.T.Cari.KimlikTuru"
                        Secenekler="@(KimlikTurleri.Select(t => new SecenekOgesi(t.Deger, t.Etiket)).ToList())"
                        @bind-Deger="duzKimlikTuru"
                        BosSecenekMetni="@Dil.T.Cari.KimlikTuruBelirtilmedi" />
            </div>
            <Unvan ElemanId="duz-unvan" Yukleniyor="@DuzKilitli" Etiket="@Dil.T.Cari.Unvan" EnFazla="@AlanSinirlari.CariUnvan"
                   Deger="@duzUnvan" DegerChanged="@(v => duzUnvan = v ?? "")"
                   Ipucu="@Dil.T.Cari.UnvanIpucu" />
            <Tarih ElemanId="duz-dogum" Yukleniyor="@DuzKilitli" Etiket="@Dil.T.Cari.DogumTarihi" Tur="TarihTuru.KisiDogum"
                   Ipucu="@DogumUyari(duzDogumTarihi)" @bind-Deger="duzDogumTarihi" />
            @* KESIF-P2 (#22): MASAK formuyla AYNI ülke seçicisi. Hücre yalnız seçiciyi taşır
               (ızgara hizası K7); eşlenemeyen eski kodun rozeti çekmecenin BAŞINDA (#duz-uyruk-duzeltin). *@
            <div class="alan" id="duz-uyruk-alan">
                <Secici ElemanId="duz-uyruk" Devredisi="@DuzKilitli" Etiket="@Dil.T.Cari.Uyruk"
                        Secenekler="@UlkeSecenekleri" BosSecenekMetni="@P2.UyrukSecin"
                        Deger="@UyrukSecimi(duzUyruk, duzUyrukDiger)" DegerChanged="DuzUyrukSecildi" />
            </div>
            @if (UyrukDigerMi(duzUyruk, duzUyrukDiger))
            {
                <Metin ElemanId="duz-uyruk-kod" Yukleniyor="@DuzKilitli" Etiket="@P2.UyrukKod" Ipucu="@P2.UyrukKodIpucu" EnFazla="@AlanSinirlari.UyrukKod"
                       Hata="@(UyrukKodHatasi(duzUyruk, yuklenenUyruk))"
                       Deger="@duzUyruk" DegerChanged="@(v => duzUyruk = (v ?? "").Trim().ToUpperInvariant())" />
            }
            <Yuzde ElemanId="duz-iskonto" Yukleniyor="@DuzKilitli" Etiket="@Dil.T.Cari.IskontoYuzde"
                  @bind-Deger="duzIskonto" Birim="%"
                  Durum="form" HataAlani="duz-iskonto"
                  Ipucu="@Dil.T.Cari.IskontoYuzdeIpucu" />
            <div class="alan">
                <Secici ElemanId="duz-segment" Devredisi="@DuzKilitli"
                        Etiket="@Dil.T.Cari.Segment"
                        Secenekler="@(Segmentler.Select(_o => new SecenekOgesi(_o.Item1, _o.Item2)).ToList())"
                        @bind-Deger="duzSegment"
                        BosSecenekMetni="@Dil.T.Cari.SegmentSecilmedi" />
            </div>
            @* P-26 (Y-37): oluşturma formuyla AYNI alan kümesi.
               KESIF-P2 (#20 · K7): hesap kodu Segment hücresinin İÇİNDEYDİ — o hücre iki alan
               boyunda olduğundan ızgara satırı uzuyor, "Standart iskonto" etiketi kutusundan
               kopuyordu. Oluşturma formundaki gibi KENDİ hücresinde. *@
            <Metin ElemanId="duz-hesap-kodu" Yukleniyor="@DuzKilitli" Etiket="@Dil.T.Cari.HesapKodu" EnFazla="@AlanSinirlari.HesapKodu"
                   Deger="@duzHesapKodu" DegerChanged="@(v => duzHesapKodu = v ?? "")"
                   Ipucu="@Dil.T.Cari.HesapKoduIpucu" />
        </fieldset>
        <CokSatir ElemanId="duz-adres" Yukleniyor="@DuzKilitli" Etiket="@Dil.T.Cari.Adres" Satir="2" EnFazla="@AlanSinirlari.Adres"
                  Deger="@duzAdres" DegerChanged="@(v => duzAdres = v ?? "")" />
        }
        <CokSatir ElemanId="duz-notlar" Yukleniyor="@DuzKilitli" Etiket="@(Sade ? T.Not : Dil.T.Cari.Notlar)" Satir="@(Sade ? 1 : 2)" EnFazla="@AlanSinirlari.CariNot"
                  Deger="@duzNotlar" DegerChanged="@(v => duzNotlar = v ?? "")"
                  Ipucu="@(Sade ? null : Dil.T.Cari.NotlarIpucu)" />
        @if (DuzTumAlanlar)
        {
        @* Kredi limiti sunucuda BAŞINDAN BERİ kontrol ediliyordu ama hiçbir
           ekranda girilemiyordu — yalnız API'den set edilebilen bir kuraldı.
           Vade ile birlikte buraya açıldı. *@
        <div class="form-grid-2 form-satiri">
            <Para ElemanId="duz-limit" Yukleniyor="@DuzKilitli" Etiket="@Dil.T.Cari.KrediLimiti" Tur="TutarTuru.SifirOlabilir" ParaBirimi="TRY"
                  @bind-Deger="duzKrediLimiti" Durum="form" HataAlani="duz-limit" />
            <Sayi ElemanId="duz-vade" Yukleniyor="@DuzKilitli" Etiket="@Dil.T.Vade.VarsayilanVadeGun" EnAz="0" EnCok="3650"
                  Deger="@(duzVadeKesirli ?? (duzVadeGun is { } _g2 ? (decimal?)_g2 : null))"
                  Hata="@(duzVadeKesirli is not null ? P2.VadeTamSayi : null)"
                  DegerChanged="DuzVadeDegisti" />
        </div>
        @* Fiyat listesi: boş = kiracının varsayılan listesi. Toptancıya "Toptan" listesi
           atanır; POS o cari seçilince otomatik o listeden teklif alır. *@
        <div class="alan">
            <Secici ElemanId="duz-fiyat-listesi" Devredisi="@DuzKilitli"
                    Etiket="@Dil.T.Fiyat.FiyatListesi"
                    Secenekler="@FiyatListesiSecenekleri"
                    @bind-Deger="duzFiyatListesiId"
                    BosSecenekMetni="@VarsayilanListeMetni" />
        </div>
        }
        @* PEP beyanı işaretli bir kartta basit modda da GÖRÜNÜR: beyan bir uyum
           bilgisidir, katlanıp unutulmaz (plan § 3/6 — basit mod yasal hiçbir şeyi saklamaz). *@
        @if (DuzTumAlanlar || yuklenenPepBeyani || duzPepBeyani)
        {
        @* ── PAKET 40-A — PEP BEYANI ─────────────────────────────────────
           ⚠ Bu bir BEYANDIR, tespit değildir. Beyan işaretliyken görev boşsa
             Kaydet KİLİTLİDİR ve sebebi çekmecenin alt çubuğunda yazar (UX-S30).
           ⚠ disabled="@(false)" TUZAĞI: `disabled="false"` DİZGEDİR ve düğmeyi
             KİLİTLER; kilit Cekmece'nin KaydetAktif bayrağıyla yönetilir. *@
        <Onay ElemanId="duz-pep" Yukleniyor="@DuzKilitli" Etiket="@Dil.T.Cari.PepBeyani"
              @bind-Deger="duzPepBeyani" Ipucu="@Dil.T.Cari.PepNotu" />
        @* UX-S24: bağımlı alanın bağını EKRAN kurar — kutu işaretlenince
           görev alanı açılır; işaretli değilse istenmez. *@
        @if (duzPepBeyani)
        {
            <div class="alan">
                <Metin ElemanId="duz-pep-gorev" Yukleniyor="@DuzKilitli" Etiket="@Dil.T.Cari.PepGorev" Zorunlu="true"
                       Deger="@duzPepGorev" DegerChanged="@(v => duzPepGorev = v ?? "")" />
                @if (!PepGecerli)
                {
                    <span id="duz-pep-hata" class="metin-kucuk metin-kirmizi" role="alert">
                        @Dil.T.Cari.PepGorevZorunlu
                    </span>
                }
                @if (duzPepBeyanTarihi is { } pbt)
                {
                    @* UX-S21: sunucunun bildiği alan kullanıcıdan istenmez —
                       beyan tarihi sunucuda damgalanır, burada yalnız gösterilir. *@
                    <span id="duz-pep-tarih" class="metin-kucuk metin-soluk">
                        @Dil.T.Cari.PepBeyanTarihi: @Bicim.TarihSaat(pbt)
                    </span>
                }
            </div>
        }
        }
        @if (Modu.BasitMi)
        {
            <button @onclick="() => duzDahaFazla = !duzDahaFazla" type="button" class="dugme dugme-ikincil dugme-kucuk form-daha-fazla" id="duz-daha-fazla"
                    aria-expanded="@(duzDahaFazla ? "true" : "false")">
                @* T-M1: tuval "Daha fazla (adres, TC, e-posta, limit)" + sağda ok; ok ince
                   çizgili Ikon (emoji/glif değil), açıkken CSS ile yukarı döner. *@
                <span>@(duzDahaFazla ? M.DahaAz : $"{M.DahaFazla} ({M.DahaFazlaIcerik})")</span>
                <Ikon Ad="@Ikonlar.KatlamaAcik" Sinif="@(duzDahaFazla ? "katla-ok katla-ok--acik" : "katla-ok")" />
            </button>
        }
        <HataBandi Mesaj="@duzHata" />
        @* T-M1: tuvalin panelinde "kaldır" düğmesi YOK → BASİT'te "Daha fazla" açılınca
           görünür (SİLİNMEDİ), etiketi jargonsuz "Kullanımdan kaldır"; id ve onay
           modalı AYNEN. PRO'da bugünkü gibi hep görünür. *@
        @if (DuzTumAlanlar)
        {
        <div class="satir">
            @* UX-4d madde 13: pasife alma ONAYSIZ çalışıyordu (üründe onay var,
               caride yok). Ortak onay modalına bağlandı (DoD EK md.4).
               Geri dönüş yolu listedeki "Aktife al" düğmesidir (UX-S25). *@
            @if (duzenleCari?.SistemCarisi == true)
            {
                @* PAKET B-3 (D2 · K4) — sunucu DELETE/PATCH aktif:false için 400 döner;
                   ekran düğme yerine değişmezlik gerekçesini ve doğru yolu yazar. *@
                <DegismezIpucu Varlik="SistemCarisi"
                               Gerekce="@PesinMetin.DegismezGerekce"
                               AlternatifYol="@PesinMetin.DegismezYol" />
            }
            else if (duzenleCari?.Aktif != false)   @* tema temizliği 17.10 bulgusu: pasif kartta "Pasife al" çizilmez (geri yol "Aktife al") *@
            {
                <button id="c-pasife-al" class="btn btn-tehlike"
                        @onclick="() => PasifOnayAc(duzenleCari)">@(Sade ? T.KullanimdanKaldir : Dil.T.Cari.PasifeAl)</button>
            }
        </div>
        }
        @if (duzenleCari is { SistemCarisi: false } ibanCari) { <CariIbanListesi CariId="@ibanCari.Id" /> }   @* M7a (17.10): müşterinin IBAN listesi *@
        @* T-M1 — tuval: panelin dibinde "Son değişiklik: Ayşe Y., dün 16:20 · Kim ne yaptı".
           Zaman listedeki `guncellendi` alanından; KİM bilgisi yalnız SAHİP'te denetim
           kaydından okunur (uç SAHİP'e açık — diğer rollerde yalnız zaman yazılır,
           ad UYDURULMAZ). "Kim ne yaptı" bağlantısı da yalnız SAHİP'te çizilir. *@
        @if (Sade && duzenleCari is not null && SonDegisiklikMetni is { } sdm)
        {
            <p class="musteri-son-degisiklik" id="cari-son-degisiklik">
                <span id="cari-son-degisiklik-metin">@sdm</span>
                @if (SahipMi)
                {
                    <span aria-hidden="true"> · </span>
                    <a href="/denetim-izi" id="cari-kim-ne-yapti">@T.KimNeYapti</a>
                }
                @if (sonDegisiklikHata is { Length: > 0 } sdh)
                {
                    @* UX-S28: kim bilgisi okunamadıysa sebep YAZILIR (sessiz yutma yok). *@
                    <span class="metin-kirmizi" id="cari-son-degisiklik-hata" role="alert"> · @sdh</span>
                }
            </p>
        }
        @* Kaydet/İptal çekmecenin ALT ÇUBUĞUNDADIR (#cekmece-cari-kaydet /
           #cekmece-cari-iptal); ikinci bir kaydet düğmesi çizilmez. *@
    </div>
</Cekmece>
</div>

@* ── UX-4d madde 13: pasife alma onay modalı (yıkıcı eylem) ── *@
<ModalPencere Acik="pasifOnayAcik" Baslik="@($"{(Sade ? T.KullanimdanKaldir : Dil.T.Cari.PasifeAl)}{(pasifAday is null ? "" : $" — {pasifAday.Ad}")}")"
              Kapat="() => pasifOnayAcik = false">
    <div class="form-dikey">
        @* P-38 · B-39: onay HANGİ cariyi kapattığını adıyla söyler (listeden de açılabildiği için). *@
        <p id="c-pasif-onay-metin">@Dil.T.Cari.PasifeAlOnay</p>
        @* ── PAKET P-13 · B-39 — BAĞLI KAYIT SAYISI (UX-S23) ─────────────────
           Pasife alma ENGELLENMEZ (borçlu müşterinin kartı da kapatılabilir);
           ama kaç hareketi ve ne kadar bakiyesi olan kartı kapattığı
           kullanıcıya ONAYDAN ÖNCE gösterilir. Sayı yoksa "yok" denmez:
           istek sürüyorsa bunu söyler (UX-S28 — hata boş duruma çevrilmez). *@
        @if (pasifBagli is not null)
        {
            <p class="metin-kucuk metin-soluk" id="c-pasif-bagli">
                @string.Format(Dil.T.Cari.PasifeAlBagli,
                    pasifBagli.HareketSayisi,
                    Bicim.Tl(pasifBagli.TlBakiye),
                    HasBicim(pasifBagli.HasGramBakiye))
            </p>
        }
        else if (pasifBagliYukleniyor)
        {
            <p class="metin-kucuk metin-soluk" id="c-pasif-bagli-yukleniyor">@Dil.T.Cari.PasifeAlBagliYukleniyor</p>
        }
        <HataBandi Mesaj="@duzHata" />
        <div class="satir">
            <button id="c-pasif-onayla" class="btn btn-tehlike" disabled="@kaydediliyor"
                    @onclick="CariPasifeAl">@(Sade ? T.KullanimdanKaldir : Dil.T.Cari.PasifeAl)</button>
            <button id="c-pasif-vazgec" class="btn btn-ikincil" style="flex:1"
                    @onclick="() => pasifOnayAcik = false">@Vazgec</button>
        </div>
    </div>
</ModalPencere>

@* ── Düzeltme fişi modalı (paket 33) — gerekçe zorunlu, geri alınamaz ── *@
<ModalPencere Acik="duzeltmeCari is not null" Baslik="@($"{DuzeltmeAdi} — {duzeltmeCari?.Ad}")" Kapat="() => duzeltmeCari = null">
    <div class="form-dikey">
        @* KESIF-P2 tur 3 (hakem KRİTİK, karar 2): bant metni ham kod ("CARI_DUZELTME") taşımaz;
           "Pozitif = borç artar" yerine her alanın altında sade yön ifadesi. Has kutusu 4 ondalık,
           birimi "has" (karar 5 — "g" yalnız ağırlık). *@
        <div class="uyari-kutu" id="dz-uyari"><p><Ikon Ad="@Ikonlar.Uyari" /> @P2.DuzeltmeUyari</p></div>
        <div class="form-grid-2 form-satiri">
            <Para ElemanId="dz-tl" Etiket="@Dil.T.Cari.TlDelta" Ipucu="@P2.DuzeltmeYon"
                  Deger="@dzTl" DegerChanged="@(v => dzTl = v ?? 0m)" />
            <Sayi ElemanId="dz-has" Etiket="@P2.DuzeltmeHasEtiket" Birim="@P2.BirimHas" EnCokOndalik="4"
                  Ipucu="@P2.DuzeltmeYon"
                  Deger="@dzHas" DegerChanged="@(v => dzHas = v ?? 0m)" />
        </div>
        @* KESIF-P2 (#21 alt madde): aynı pencerede iki sayaç ("0 / 500" + "0/20") vardı —
           tek sayaç: yazılan karakter ve asgari 20 (CokSatir'in kendi sayacı kapalı). *@
        <CokSatir ElemanId="dz-gerekce" Etiket="@Dil.T.Cari.Gerekce" Zorunlu="true" Satir="3" SayacGoster="false"
                  Deger="@dzGerekce" DegerChanged="@(v => dzGerekce = v ?? "")"
                  Ipucu="@string.Format(P2.GerekceSayac, dzGerekce.Trim().Length, 20)" />
        <HataBandi Mesaj="@islemHata" />
        <SayiKapisiSebebi Kapi="sayiKapisi" Onek="dz-" ElemanId="dz-sayi-kilit" />
        <div class="satir">
            <button class="btn btn-ikincil" style="flex:1" @onclick="() => duzeltmeCari = null">@Vazgec</button>
            <button class="btn btn-birincil" style="flex:1" id="dz-kaydet"
                    disabled="@(kaydediliyor || sayiKapisi.OnekleVar("dz-") || dzGerekce.Trim().Length < 20 || (dzTl == 0 && dzHas == 0))"
                    @onclick="DuzeltmeGonder">@Dil.T.Ortak.Kaydet</button>
        </div>
    </div>
</ModalPencere>

@* ── Tahsilat ÇEKMECESİ — kuyumcunun günlük işi ──
   SON-KALANLAR (hasım ORTA, DoD EK md.2 tek düzenleme kalıbı): çok alanlı form ModalPencere değil
   Cekmece; İptal → Kaydet altlıkta (döviz tahsilatla AYNI düzen). Kimlikler (#th-kaydet,
   #th-kaydet-kilit, #th-*) AYNEN. Kilit sebebi TEK yerde: altlıktaki #th-kaydet-kilit. *@
<Cekmece Acik="@(tahsilatCari is not null)" Varlik="tahsilat" IptalMetni="@Vazgec"
         Baslik="@($"{Dil.T.Cari.Tahsilat} — {tahsilatCari?.Ad}")"
         Kapat="() => tahsilatCari = null" Kaydet="TahsilatKaydet" Kaydediliyor="@kaydediliyor"
         KaydetAktif="@(!(sayiKapisi.OnekleVar("th-") || (thTutar > 0 && string.IsNullOrEmpty(thKasaId)) || ThNakitSinirAsildi || PM.KilitSebebi(Dil.Dil) is not null))"
         KilitSebebi="@TahsilatKilidi" KaydetMetni="@Dil.T.Ortak.Kaydet"
         KaydetElemanId="th-kaydet" KilitElemanId="th-kaydet-kilit">
    <div class="form-dikey">
        @* PAKET PARA-DEMO (madde 2): "Borcu azaltır" yalnız PARA için doğruydu; altın TL borcunu
           düşürmez, müşterinin altın hesabına yazılır (sunucu TahsilatGirHareket: iki ayrı bacak). *@
        @* PARA-DEMO-2 (madde 7): müşterinin GÜNCEL borcu başlığın altında hep görünür. *@
        <p class="hucre-vurgu" id="th-guncel">@ThGuncelBorc@if (tahsilatCari is { HasGramBakiye: not 0m } thc) {<span class="metin-soluk hucre-tek-satir" id="th-guncel-altin"> · @string.Format(PD2.GuncelAltin, HasBicim(thc.HasGramBakiye))</span>}</p>
        @* YASAL-KAPI-3 (sade ve şık, "ilk ekranda tüm zorunlular"): kimlik formu açıkken açıklama satırı çizilmez. *@
        @if (!ThMasakCizilir)
        {
            <p class="metin-soluk metin-kucuk" id="th-ipucu">@PD.TahsilatIpucu</p>
        }
        @* SON-KALANLAR (hasım DÜŞÜK, B1440__21): tutar kutusu TAM GENİŞLİK (iki sütunlu ızgarada dev tutar
           kesiliyordu); ödeme türü altında. *@
            @* PARA-DEMO-2 tur 5 (doğrulayıcı YÜKSEK): Tutar BOŞ gelir (0 değil); altın açık değilken
               zorunludur ("isteğe bağlı" yazmaz). Kural TEK cümle (ThTutarHatasi) ve yalnız ilk Kaydet
               denemesinden sonra görünür — pencere açılır açılmaz kırmızı yazı yok. *@
            @* YASAL-KAPI-3: ödeme türü değişince nakit sınırı cümlesi ve sunucunun eski reddi yeniden değerlendirilir
               (ThOdemeDegisti). Tutar kutusu TAM GENİŞLİK kalır (SON-KALANLAR kararı, SKC01). *@
            <Para ElemanId="th-tutar" Etiket="@Dil.T.Cari.TlTutar" EnAz="0" Zorunlu="@(!(thHasAcik || thHas > 0m))"
                  Deger="@(thTutar > 0m ? thTutar : null)" DegerChanged="@ThTutarDegisti"
                  Hata="@ThTutarHatasi" />
            <div class="alan">
                <Secici ElemanId="th-odeme"
                        Etiket="@Dil.T.Cari.OdemeTuru"
                        Secenekler="@TahsilatOdemeSecenekleri"
                        Deger="@thOdeme" DegerChanged="@((string? v) => ThOdemeDegisti(v))" />
            </div>
        @* PAKET YASAL-2 (TB-15): büyük satıştan kalan borçta "Nakit" SUNUCUNUN
           söylediğine göre kapanır (GET /tevsik/gunluk → taksit); ekran tahmin etmez. *@
        @if (thTaksit is { KuralDevrede: true } tk)
        {
            <div class="uyari-kutu nakit-siniri @(ThNakitSinirAsildi ? "uyari-kirmizi" : null)" id="th-taksit" role="status">
                <p id="th-taksit-cumle">@(ThNakitKapali
                    ? string.Format(TT.TahsilatNakitKapali, Bicim.Para(tk.BuyukIslemHaddi ?? 0m, "TRY"))
                    : string.Format(TT.TahsilatNakitSinirli, Bicim.Para(tk.NakitAlinabilir ?? 0m, "TRY")))</p>
                <details class="nakit-siniri-neden" id="th-taksit-neden" title="@TT.Dayanak">
                    <summary>@TT.NedenBaslik</summary>
                    <p class="metin-kucuk">@TT.NedenMetin</p>
                </details>
            </div>
        }
        <HataBandi Mesaj="@thTaksitHata" Id="th-taksit-hata" />
        @* PAKET YASAL-KAPI-2 (tasarım hakemi KRİTİK): eşik üstünde (ya da bugünkü toplamla / sunucu reddiyle) ORTAK
           MasakFormu açılır — tezgâhtar çıkışsız kalmaz. Tutar inince form ve ret cümlesi kalkar (ParaMasakKapisi). *@
        @* YASAL-KAPI-3: nakit sınırı aşılmışken form doldurtulmaz (önce ödeme türü); PRO kural satırı yok (eşik başlıkta, tek kez). *@
        @if (ThMasakCizilir)
        {
            <div class="zo-masak-dikey" id="th-masak">
                <MasakFormu Model="PM.Model" Tutar="PM.Tutar" Esik="PM.Esik!" Sade="@Sade" Gereksinim="PM.Gereksinim!" Degisti="MasakAlaniDegisti" KuralGizli="true" />
            </div>
        }
        <HataBandi Mesaj="@(ThNakitSinirAsildi ? null : PM.RedBandi)" Id="th-masak-ret" />
        @* PARA-DEMO-2 (madde 7): isteğe bağlı altınla ödeme "+ Altınla öde" arkasında (zorunlu önce);
           silinince "0,000 g" artığı kalmaz (0 → boş kutu). *@
        @if (thHasAcik || thHas > 0m)
        {
        @* PAKET GOC-B (C satır 68, K11): has gram 6 ondalık — Gram (3 ondalık) yerine ortak Has; eksi yazılamaz. *@
        <Has ElemanId="th-has" Etiket="@PD.HasGramEtiket" EnCokOndalik="6"
              Deger="@(thHas > 0m ? thHas : null)" DegerChanged="@ThHasDegisti"
              Ipucu="@PD.HasGramIpucu" Hata="@thHasSunucuHata" />
        }
        @* PARA-DEMO (madde 2, ekip kararı B) + PARA-DEMO-2 (madde 6): TL borçlu müşteride altın girilince TEK cümle,
           büyük harf yok; ekrandaki GERÇEK düğme adı ve oraya tek dokunuşla giden bağlantı. *@
        @if (thHas > 0m && (tahsilatCari?.TlBakiye ?? 0m) > 0m)
        {
            <div class="uyari-kutu" id="th-has-uyari" role="status">
                <p>@string.Format(PD2.HasTlBorcUyari, Bicim.Para(tahsilatCari!.TlBakiye, "TRY"), HurdaAlisAdi)</p>
                <a class="metin-kucuk" href="/islemler?tur=HURDA_ALIS" id="th-has-yol">@string.Format(PD2.HasYolBaglanti, HurdaAlisAdi)</a>
            </div>
        }
        @* UX-4b madde 9 — KASA BACAĞI. Sunucu TL tutarı varsa kasa ZORUNLU tutar
           (satıştaki kuralın aynısı). UX-S22: tek TL kasası varsa seçici kilitli
           ve otomatik doludur. Yalnız has gram tahsilatında kasa istenmez. *@
        @if (thTutar > 0)
        {
            <div class="alan">
                <Secici ElemanId="th-kasa"
                        Etiket="@Dil.T.Islem.Kasa"
                        Secenekler="@TahsilatKasaSecenekleri"
                        @bind-Deger="thKasaId"
                        Devredisi="@TahsilatKasaTek"
                        BosSecenekMetni="@Dil.T.Islem.KasaSecin" />
                @if (TahsilatKasaTek)
                {
                    @* PARA-DEMO-2 (madde 7): kasa mesajı TEK satır (kilit sebebi + "otomatik" notu ikisi birden yazılmaz). *@
                    <span id="th-kasa-tek" class="metin-soluk metin-kucuk">@string.Format(PD2.KasaTekSatir, TahsilatKasalari[0].Ad)</span>
                }
            </div>
        }
        @if (thNotAcik || !string.IsNullOrEmpty(thAciklama))
        {
        <Metin ElemanId="th-aciklama" Etiket="@Dil.T.Ortak.Aciklama" EnFazla="@AlanSinirlari.HareketAciklama"
               Deger="@thAciklama" DegerChanged="@(v => thAciklama = v ?? "")" />
        }
        @* PARA-DEMO-2 (madde 7): isteğe bağlılar kapalı gelir; tek dokunuşla açılır. *@
        @if (!(thHasAcik || thHas > 0m) || !(thNotAcik || !string.IsNullOrEmpty(thAciklama)))
        {
            <div class="satir" id="th-istege-bagli">
                @if (!(thHasAcik || thHas > 0m))
                {
                    <button type="button" class="btn btn-ikincil btn-kucuk" id="th-has-ekle" @onclick="() => thHasAcik = true">@PD2.AltinlaOdeEkle</button>
                }
                @if (!(thNotAcik || !string.IsNullOrEmpty(thAciklama)))
                {
                    <button type="button" class="btn btn-ikincil btn-kucuk" id="th-not-ekle" @onclick="() => thNotAcik = true">@PD2.NotEkle</button>
                }
            </div>
        }
        <HataBandi Mesaj="@islemHata" />
        <SayiKapisiSebebi Kapi="sayiKapisi" Onek="th-" ElemanId="th-sayi-kilit" />
        @* UX-S30 (P-13): kilitli düğmenin sebebi altlıkta TEK kez (#th-kaydet-kilit, Cekmece). *@
    </div>
</Cekmece>

@* ── Veresiye modalı ── *@
<ModalPencere Acik="veresiyeCari is not null" Baslik="@($"{Dil.T.Cari.Veresiye} — {veresiyeCari?.Ad}")" Kapat="() => veresiyeCari = null">
    <div class="form-dikey">
        <p class="metin-soluk metin-kucuk">@Dil.T.Cari.VeresiyeIpucu</p>
        <Para ElemanId="vr-tutar" Etiket="@Dil.T.Cari.TlTutar" EnAz="0"
              Deger="@vrTutar" DegerChanged="@VrTutarDegisti" />
        @* PAKET GOC-B (C satır 69, K11): ortak Has; 0 = boş kutu (has verilmedi), eksi yazılamaz. *@
        <Has ElemanId="vr-has" Etiket="@Dil.T.Cari.HasGramVerilen" EnCokOndalik="6"
             Deger="@(vrHas > 0m ? vrHas : null)" DegerChanged="@(v => vrHas = v ?? 0m)" />
        <Metin ElemanId="vr-aciklama" Etiket="@Dil.T.Ortak.Aciklama" EnFazla="@AlanSinirlari.HareketAciklama"
               Deger="@vrAciklama" DegerChanged="@(v => vrAciklama = v ?? "")" />
        <HataBandi Mesaj="@islemHata" />
        <SayiKapisiSebebi Kapi="sayiKapisi" Onek="vr-" ElemanId="vr-sayi-kilit" />
        @* PAKET YASAL-KAPI-2: veresiye de MASAK kapısına tabidir (sunucu VeresiyeGir) — aynı ortak form ve aynı iz kuralı. *@
        @if (PM.FormCizilir)
        {
            <div class="zo-masak-dikey" id="vr-masak">
                <MasakFormu Model="PM.Model" Tutar="PM.Tutar" Esik="PM.Esik!" Sade="@Sade" Gereksinim="PM.Gereksinim!" Degisti="MasakAlaniDegisti" KuralGizli="true" />
            </div>
        }
        <HataBandi Mesaj="@PM.RedBandi" Id="vr-masak-ret" />
        @if (VeresiyeKilidi is { } vrKilit)
        {
            <span class="metin-kucuk islem-kaydet-kilit" id="vr-kaydet-kilit" role="status">@vrKilit</span>
        }
        <div class="satir">
            <button class="btn btn-ikincil" style="flex:1" @onclick="() => veresiyeCari = null">@Vazgec</button>
            <button class="btn btn-birincil" style="flex:1" id="vr-kaydet"
                    disabled="@(kaydediliyor || sayiKapisi.OnekleVar("vr-") || vrTutar <= 0 || PM.KilitSebebi(Dil.Dil) is not null)"
                    @onclick="VeresiyeKaydet">@Dil.T.Ortak.Kaydet</button>
        </div>
    </div>
</ModalPencere>

@* ═══ PAKET 27 — DÖVİZ VERESİYE ÇEKMECESİ ═══════════════════════════════════
   Tek düzenleme kalıbı (MÜHÜR 2 DoD/2): çok alanlı form = Cekmece.
   TL karşılığı SALT OKUNUR — sunucu hesaplar, istemci gönderemez (UX-S21). *@
@* TOPLU-5 (hakem ORTA "/cariler iki farklı çekmece kalıbı"): döviz çekmeceleri müşteri düzenleme çekmecesiyle
   AYNI tuval kalıbında (440 px, aynı dolgu/başlık/etiket/alt şerit — toplu5.css .t5-cekmece-kap). Cekmece ortak
   bileşendir ve DEĞİŞMEDİ; sarmalayıcı yalnız çizim sınıfı taşır. *@
@* D1-09: hesap dönüştürme çekmecesi (ayrı bileşen). *@
<div class="musteri-panel-kap t5-cekmece-kap">
<HesapDonusturCekmecesi Cari="donusturCari" Kapandi="() => donusturCari = null" Kaydedildi="HesapDonusturuldu" />
<OdemePlaniCekmecesi Cari="odemePlaniCari" Yonetebilir="@DuzeltmeGorebilir" Kapandi="async () => { odemePlaniCari = null; await Yukle(); }" />
</div>
<div class="musteri-panel-kap t5-cekmece-kap">
<Cekmece Acik="@(dovizVeresiyeCari is not null)" Varlik="doviz-veresiye" IptalMetni="@Vazgec"
         Baslik="@($"{DovizVeresiyeAdi} — {dovizVeresiyeCari?.Ad}")"
         Kapat="DovizVeresiyeKapat" Kaydet="DovizVeresiyeKaydet"
         Kaydediliyor="@kaydediliyor"
         KaydetAktif="@(dvTutar > 0m && DovizKuru(dvParaBirimi) is not null && !sayiKapisi.OnekleVar("dv-") && PM.KilitSebebi(Dil.Dil) is null)"
         KilitSebebi="@(sayiKapisi.Sebep(Dil.Dil, "dv-") ?? (dvTutar > 0m && DovizKuru(dvParaBirimi) is not null ? PM.KilitSebebi(Dil.Dil) : null) ?? DovizKilitSebebi(dvParaBirimi, dvTutar))">
    <div class="form-dikey">
        @* K27-C — kullanıcı "fişte dövizle sattım, cariye USD kalsın" bekliyor
           olabilir; Faz A bunu VERMİYOR ve bunu SAKLAMIYOR.
           TOPLU-2 tur 2 (tasarım hakemi KRİTİK): BASİT'te açıklama notu YOK — form
           yalnız zorunluyu gösterir (kurucu temel kuralı); PRO'da notlar SADE dille
           (Toplu2Sozlugu; "bu sürümde YOKTUR" ekrana basılmaz). Gerçek SAKLANMAZ:
           PRO'da yazılıdır. *@
        @if (!Sade)
        {
            @* TOPLU-5 (hakem ORTA "PRO Döviz Veresiye 3 satır açıklama"): üç 12 px paragraf TEK ⓘ içinde
               (metinler ve id'ler AYNEN; açılışta kapalı). *@
            <div class="t4-ipucu-satir" id="dv-bilgi-satir">
                <details class="zo-ipucu" id="dv-bilgi">
                    <summary aria-label="@T5.DovizBilgi">i</summary>
                    <div class="t4-ipucu-govde">
                        <p>@Dil.T.Cari.VeresiyeIpucu</p>
                        <p id="dv-fis-bacagi-not">@Toplu2Sozlugu.Al(Dil.Dil).DovizFisBacagiNot</p>
                        <p id="dv-vadesiz-not">@Toplu2Sozlugu.Al(Dil.Dil).DovizVadeNot</p>
                    </div>
                </details>
                <span class="metin-soluk" id="dv-bilgi-etiket">@T5.DovizBilgi</span>
            </div>
        }
        <div class="alan">
            <Secici ElemanId="dv-para-birimi"
                    Etiket="@Dil.T.Cari.ParaBirimi"
                    Secenekler="@(DovizBirimleri.Select(pb => new SecenekOgesi(pb, pb)).ToList())"
                    @bind-Deger="dvParaBirimi"
                    @bind-Deger:after="DvMasakTazele" />
            <AlanHatasi Alan="dv-para-birimi" Durum="form" />
        </div>
        @* TOPLU-2 tur 2 (K18): tutar olmadan Kaydet KİLİTLİDİR → alan ZORUNLUDUR; "isteğe bağlı" yazmaz. *@
        <Para ElemanId="dv-tutar" Etiket="@DovizTutarEtiketi(dvParaBirimi)" EnAz="0" Zorunlu="true"
              ParaBirimi="@dvParaBirimi"
              Deger="@DvKutuDegeri" DegerChanged="@DvTutarDegisti"
              Durum="form" HataAlani="dv-tutar" />
        @* TOPLU-5 (hakem ORTA "boş tutar alan altı mesajı"): kullanıcı tutarı silince/0 bırakınca alanın
           ALTINDA Türkçe mesaj (DoD EK 3: sessiz etkisizlik yok); Kaydet kilidi ve sebebi aynen. *@
        @if (dvDokunuldu && dvTutar <= 0m && form.Mesaj("dv-tutar") is null)
        {
            <span class="hata-metni alan-hata" id="dv-tutar-bos" role="alert">@T5.DovizTutarBos</span>
        }
        @* UX-S21 — sistemin bildiği alan kullanıcıdan istenmez: TL karşılığı
           kurdan türetilir, rozetle nereden geldiği söylenir, YAZILAMAZ. *@
        @* TOPLU-5: etiket "TL karşılığı" (eski "bilgi amaçlı — sunucu hesaplar" teknik eki kalktı; nereden
           geldiğini "Kurdan geldi" rozeti söyler — UX-S21). Değer ve hesap AYNEN. *@
        <SaltOkunur ElemanId="dv-tl-karsilik" Etiket="@T5.DovizTlKarsiligi"
                    Deger="@TlKarsiligiMetni(dvParaBirimi, dvTutar)"
                    BosMetin="@Dil.T.Ortak.DegerYok" KaynakRozeti="@Dil.T.Islem.KurdanGeldi" />
        <Metin ElemanId="dv-aciklama" Etiket="@Dil.T.Ortak.Aciklama" EnFazla="@AlanSinirlari.HareketAciklama"
               Deger="@dvAciklama" DegerChanged="@(v => dvAciklama = v ?? "")" />
        @* PAKET YASAL-KAPI-2: MASAK eşiği TL karşılığıyla işler (sunucu DovizVeresiyeGir) — ortak form ve iz kuralı. *@
        @if (PM.FormCizilir)
        {
            <div class="zo-masak-dikey" id="dv-masak">
                <MasakFormu Model="PM.Model" Tutar="PM.Tutar" Esik="PM.Esik!" Sade="@Sade" Gereksinim="PM.Gereksinim!" Degisti="MasakAlaniDegisti" KuralGizli="true" />
            </div>
        }
        <HataBandi Mesaj="@PM.RedBandi" Id="dv-masak-ret" />
        <HataBandi Mesaj="@islemHata" />
    </div>
</Cekmece>

@* ═══ PAKET 27 — DÖVİZ TAHSİLAT ÇEKMECESİ ══════════════════════════════════ *@
<Cekmece Acik="@(dovizTahsilatCari is not null)" Varlik="doviz-tahsilat" IptalMetni="@Vazgec"
         Baslik="@($"{DovizTahsilatAdi} — {dovizTahsilatCari?.Ad}")"
         Kapat="DovizTahsilatKapat" Kaydet="DovizTahsilatKaydet"
         Kaydediliyor="@kaydediliyor"
         KaydetAktif="@(dtTutar > 0m && DovizKuru(dtParaBirimi) is not null && !string.IsNullOrEmpty(dtKasaId) && !sayiKapisi.OnekleVar("dt-") && !DtNakitAsildi && PM.KilitSebebi(Dil.Dil) is null)"
         KilitSebebi="@(sayiKapisi.Sebep(Dil.Dil, "dt-") ?? (DtNakitAsildi ? null : dtTutar > 0m && DovizKuru(dtParaBirimi) is not null && !string.IsNullOrEmpty(dtKasaId) ? PM.KilitSebebi(Dil.Dil) : null) ?? (DtNakitAsildi ? null : DovizKilitSebebi(dtParaBirimi, dtTutar, dtKasaId)))">
    <div class="form-dikey">
        @if (!Sade)
        {
            <p class="metin-soluk metin-kucuk">@Dil.T.Cari.TahsilatIpucu</p>
        }
        <div class="alan">
            @* UX-S24 — bağımlı alanın bağını EKRAN kurar: para birimi değişince
               kasa listesi yenilenir ve tek kasa varsa kendiliğinden seçilir. *@
            <Secici ElemanId="dt-para-birimi"
                    Etiket="@Dil.T.Kasa.Doviz"
                    Secenekler="@DovizSecenekleri"
                    @bind-Deger="dtParaBirimi"
                    @bind-Deger:after="DtBirimDegisti" />
        </div>
        @* K6 — efektif YALNIZ o para birimindeki kasaya girer; sunucu
           KasaDogrula(beklenenParaBirimi) ile reddeder. Ekran imkânsız
           seçeneği hiç göstermez; UX-S22: tek kasa varsa seçici GİZLENİR. *@
        @if (DovizKasalari.Count == 0)
        {
            @* TOPLU-2 tur 2: "kasa yok" formun ortasında büyük boş-durum kutusu DEĞİL, kasa satırının
               kendisidir (para biriminin hemen altında; Kaydet kilidi "Kasa" der — UX-S30). *@
            <SaltOkunur ElemanId="dt-kasa-yok" Etiket="@Dil.T.Kasa.Baslik" Deger="@null"
                        BosMetin="@string.Format(KatalogSozlugu.Al(Dil.Dil).DovizKasasiYok, Bicim.ParaIsareti(dtParaBirimi))" />
        }
        else if (DovizKasalari.Count == 1)
        {
            <SaltOkunur ElemanId="dt-kasa-tek" Etiket="@Dil.T.Kasa.Baslik"
                        Deger="@DovizKasalari[0].Ad" BosMetin="@Dil.T.Ortak.DegerYok"
                        KaynakRozeti="@Dil.T.Islem.TekKasaOtomatik" />
        }
        else
        {
            <div class="alan">
                <Secici ElemanId="dt-kasa"
                        Etiket="@Dil.T.Kasa.Baslik"
                        Secenekler="@(DovizKasalari.Select(k => new SecenekOgesi(k.Id, k.Ad)).ToList())"
                        @bind-Deger="dtKasaId" />
                <AlanHatasi Alan="dt-kasa" Durum="form" />
            </div>
        }
        <Para ElemanId="dt-tutar" Etiket="@DovizTutarEtiketi(dtParaBirimi)" EnAz="0" Zorunlu="true"
              ParaBirimi="@dtParaBirimi"
              Deger="@dtTutar" DegerChanged="@DtTutarDegisti"
              Hata="@DtNakitHatasi" Durum="form" HataAlani="dt-tutar" />
        <SaltOkunur ElemanId="dt-tl-karsilik" Etiket="@T5.DovizTlKarsiligi"
                    Deger="@TlKarsiligiMetni(dtParaBirimi, dtTutar)"
                    BosMetin="@Dil.T.Ortak.DegerYok" KaynakRozeti="@Dil.T.Islem.KurdanGeldi" />
        <Metin ElemanId="dt-aciklama" Etiket="@Dil.T.Ortak.Aciklama" EnFazla="@AlanSinirlari.HareketAciklama"
               Deger="@dtAciklama" DegerChanged="@(v => dtAciklama = v ?? "")" />
        @if (DtMasakCizilir)
        {
            <div class="zo-masak-dikey" id="dt-masak">
                <MasakFormu Model="PM.Model" Tutar="PM.Tutar" Esik="PM.Esik!" Sade="@Sade" Gereksinim="PM.Gereksinim!" Degisti="MasakAlaniDegisti" KuralGizli="true" />
            </div>
        }
        <HataBandi Mesaj="@(DtNakitAsildi ? null : PM.RedBandi)" Id="dt-masak-ret" />
        <HataBandi Mesaj="@islemHata" />
    </div>
</Cekmece>
</div>

@* ── Cari detay modalı (başlığından tutup taşınabilir) ──
   KESIF-P2 (#8 + KATMAN-1b ORTA "Cari detay penceresi"):
   • Hareket başlığı ham kod DEĞİL: KatalogSozlugu.HareketTuru(…, basit) (UX-S31).
   • Has sütunu satırın DEFTER has'ı değil, müşterinin altın hesabına ETKİSİdir
     (sunucu cariHasEtkisi); satırlar + sayfa dışı etki = üstteki Has Gram bakiyesi.
   • Emanet satırı rozetle; altın dışı emanet "bakiyeye girmez" rozetiyle, toplama katılmaz.
     Kural tablonun altında BİR KEZ, kapalı katlanır ipucunda (ekip kararı 3).
   • İki bakiye kartı aynı StatKart bileşeni (üst kenar hizalı); boş döviz kutusu
     ÇİZİLMEZ (zorunlu önce kuralı) — döviz bakiyesi varsa kart görünür. *@
<ModalPencere Acik="detayCari is not null" Baslik="@(detayCari?.Ad ?? Dil.T.Cari.CariDetay)" Kapat="DetayKapat" Suruklenebilir="true">
    @if (detayCari is not null)
    {
        <div class="form-dikey" id="cari-detay">
            @* stat-izgara: kartlar eşit boyda, üst kenar hizalı (form-grid-2 alt hizalıyordu — ölçüldü 22 px). *@
            <div class="stat-izgara" id="cari-detay-bakiyeler">
                <StatKart Renk="@YonRengi(DetayTl)"
                          Etiket="@Dil.T.Cari.TlBakiye" Deger="@Bicim.Tl(DetayTl)"
                          Alt="@YonMetni(DetayTl)" />
                @* KESIF-P2 tur 3 (karar 3): altın bakiyesi EMANETSİZ; yön kelimesi TL ile aynı.
                   Emanet ayrı "Emanette" kutusunda — bakiyeye girmez. *@
                <StatKart Renk="@YonRengi(DetayHas, 4)" Etiket="@P2.AltinBakiye" Deger="@HasBicim(DetayHas)"
                          Alt="@YonMetni(DetayHas, 4)" />
                @if (DetayEmanette != 0m)
                {
                    <StatKart Etiket="@P2.Emanette" Deger="@DetayEmanetteDeger" Alt="@P2.EmanetteAlt" />
                }
            </div>

            @* ── TOPLU-1 (CARI-BAKIYE 01.10, YÜKSEK): BAKİYE UYUŞMAZLIĞI — TEK uyarı, bakiyenin YANINDA ──
               Eskiden altın ve TL için iki ayrı bant aynı teknik cümleyi tekrarlıyor ve hareket listesinin
               EN ALTINDA kalıyordu. Şimdi: kayıtlı bakiye işlemlerle tutmuyorsa (has farkı ≠ 0 ya da TL farkı
               > 1 kuruş; null = ölçülemez → yok) bakiye kutularının hemen altında BİR bant. BASİT yüz
               (tezgâhtar) teknik ayrıntı görmez: "kontrol edilmeli, yöneticinize haber verin". PRO yüz farkları
               tek cümlede yazar (#cari-detay-uyusmazlik-has / -tl). Sunucu farkı günlüğe ayrıca yazar. *@
            @if (UyusmazlikVar)
            {
                <div class="bant bant-uyari" role="status" id="cari-detay-uyusmazlik">
                    @if (Sade)
                    {
                        @T1.UyusmazlikBasit
                    }
                    else
                    {
                        @UyusmazlikProMetni()
                    }
                </div>
            }

            @* ── ÜÇÜNCÜ BAKİYE: DÖVİZ (paket 27) — TL/has ile TOPLANMAZ ── *@
            @if (DetayDoviz.Count > 0)
            {
                <div class="kart">
                    <div class="kart-govde">
                        <p class="metin-soluk metin-kucuk">@Dil.T.Cari.DovizBakiye</p>
                        <span class="satir" id="cari-detay-doviz">
                            @foreach (var (pb, tutar) in DetayDoviz)
                            {
                                <Rozet Renk="@(tutar < 0 ? "kirmizi" : "yesil")">@Bicim.Para(tutar, pb)</Rozet>
                            }
                        </span>
                        <p class="metin-soluk metin-kucuk" id="cari-detay-doviz-not">@Dil.T.Cari.DovizVadesizUyari</p>
                    </div>
                </div>
            }

            <HataBandi Mesaj="@detayHata" />

            @* PAKET EKSIK-B1-YAZDIR (B1-3): cari ekstresi A4 belgesi BU ekrandan açılır — iki modda da
               (eskiden adres elle yazılarak açılıyordu). Belge salt okunurdur; kâğıdı tarayıcı basar. *@
            <div class="satir yazdirma-gizle">
                <NavLink id="cari-detay-ekstre-yazdir" class="btn btn-ikincil btn-kucuk"
                         href="@($"/cikti/{Kuyumcu.Contracts.Cikti.BelgeTurleri.CariEkstre}/{detayCari.Id}")">@EB1.EkstreYazdir</NavLink>
                @if (!detayCari.SistemCarisi)
                {
                    @* D1-10 (18.10): cari hesap mutabakat formu — bugünkü bakiyeler + "mutabıkız / değiliz" + imza. *@
                    <NavLink id="cari-detay-mutabakat" class="btn btn-ikincil btn-kucuk"
                             href="@($"/cikti/{Kuyumcu.Contracts.Cikti.BelgeTurleri.CariMutabakat}/{detayCari.Id}?donus=/cariler")">@D1Sozlugu.Al(Dil.Dil).MutabakatYazdir</NavLink>
                }
            </div>
            @if (!detayCari.SistemCarisi) { <KvkkCariBolumu CariId="@detayCari.Id" /> }   @* D1-19 KVKK *@

            <div>
                <h3 class="metin-soluk metin-kucuk mb-1">@P2.HareketlerBaslik</h3>
                @if (ekstreYukleniyor)
                {
                    <Yukleniyor />
                }
                else if (detayHata is not null)
                {
                    @* UX-S28: hata "kayıt yok"a çevrilmez — bant yukarıda, boş durum çizilmez. *@
                }
                else if (DetayHareketler.Count == 0)
                {
                    <BosDurum Mesaj="@Dil.T.Cari.HareketYok" />
                }
                else
                {
                    @* 375 px'te de has sütunu GÖRÜNÜR kalsın diye tablo değil satır listesi (ölçüldü:
                       tabloda has sütunu dar ekranda yatay kaydırmanın arkasında kalıyordu). *@
                    <div id="cari-detay-hareketler">
                        <div class="satir-arasi liste-satiri metin-soluk metin-kucuk" id="cari-detay-baslik-satiri">
                            <span>@P2.SutunIslem</span>
                            <span class="sayi">@P2.SutunTutar · @P2.SutunHasEtkisi · @PD.EkstreSutunBakiye</span>
                        </div>
                        @* PAKET PARA-DEMO (madde 5): satır tutarı = cari TL bakiyesine ETKİSİ (sunucu cariTlEtkisi,
