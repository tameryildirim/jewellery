    private async Task DovizVeresiyeKaydet()
    {
        if (dovizVeresiyeCari is null || sayiKapisi.OnekleVar("dv-")) return;   // ORTAK-1: POST YOK
        islemHata = null;
        // SESSİZ ETKİSİZLİK YASAĞI: eksikse istek atılmaz, sebebi alan altında yazar.
        form.Temizle();
        if (dvTutar <= 0m) form.Ekle("dv-tutar", Dil.T.Kabuk.FormEksik);
        if (DovizKuru(dvParaBirimi) is null) form.Ekle("dv-para-birimi", Dil.T.Cari.KurYokDovizYapilamaz);
        if (!form.Gecerli) { islemHata = Dil.T.Kabuk.FormEksik; await OdakIlkHataya(); return; }

        kaydediliyor = true;
        try
        {
            // ⚠ TL karşılığı GÖNDERİLMEZ — sunucu kendi kuruyla hesaplar.
            await Api.PostAsync($"/cari/{dovizVeresiyeCari.Id}/doviz-veresiye", new
            {
                paraBirimi = dvParaBirimi,
                tutar = dvTutar,
                aciklama = BosIseNull(dvAciklama),
                kurSnapshotId = guncelKur!.Id,
                masak = PM.Govde,   // YASAL-KAPI-2
            });
            dovizVeresiyeCari = null;
            Basarili(Dil.T.Kabuk.Kaydedildi);   // UX-S27: sonuç GÖRÜNÜR
            await Yukle();
        }
        catch (ApiHata ex) when (ParaMasakKapisi.MasakReddi(ex)) { await PM.Reddet(ex, Dil.Dil); }
        catch (ApiHata ex) { islemHata = ex.Message; }
        kaydediliyor = false;
    }

    private async Task DovizTahsilatAc(CariVeri c)
    {
        islemHata = null; form.Temizle();
        dtParaBirimi = DovizBirimleri.FirstOrDefault(pb => DovizKuru(pb) is not null) ?? "USD";
        dtTutar = 0m; dtAciklama = ""; dtKasaId = "";
        await KurYukle();
        await KasalariYukle();
        DovizKasaSec();
        NS.Ac();             // YASAL-KAPI-3: efektif tahsilat da nakit sınırına tabi (sunucu: TL karşılığı)
        await PM.Ac(c.Id);   // YASAL-KAPI-2
        dovizTahsilatCari = c;
        var (gunluk, hata) = await TevsikGunlukSor(c.Id);
        if (dovizTahsilatCari?.Id == c.Id) { NS.Yukle(gunluk); if (hata is not null) islemHata = hata; }   // UX-S28: yutulmaz
    }

    /// <summary>UX-S22 — tek kasa varsa sorulmaz, atanır; para birimi değişince yeniden.</summary>
    private void DovizKasaSec()
    {
        var uygun = DovizKasalari;
        dtKasaId = uygun.Count == 1 ? uygun[0].Id
                 : uygun.Any(k => k.Id == dtKasaId) ? dtKasaId : "";
        StateHasChanged();
    }

    private void DovizTahsilatKapat() => dovizTahsilatCari = null;

    private async Task DovizTahsilatKaydet()
    {
        if (dovizTahsilatCari is null || sayiKapisi.OnekleVar("dt-")) return;   // ORTAK-1: POST YOK
        islemHata = null;
        form.Temizle();
        if (dtTutar <= 0m) form.Ekle("dt-tutar", Dil.T.Kabuk.FormEksik);
        if (DovizKuru(dtParaBirimi) is null) form.Ekle("dt-para-birimi", Dil.T.Cari.KurYokDovizYapilamaz);
        if (string.IsNullOrEmpty(dtKasaId)) form.Ekle("dt-kasa", Dil.T.Kasa.Baslik);
        if (!form.Gecerli) { islemHata = Dil.T.Kabuk.FormEksik; await OdakIlkHataya(); return; }

        kaydediliyor = true;
        try
        {
            await Api.PostAsync($"/cari/{dovizTahsilatCari.Id}/doviz-tahsilat", new
            {
                paraBirimi = dtParaBirimi,
                tutar = dtTutar,
                kasaId = dtKasaId,
                aciklama = BosIseNull(dtAciklama),
                kurSnapshotId = guncelKur!.Id,
                masak = PM.Govde,   // YASAL-KAPI-2
            });
            dovizTahsilatCari = null;
            Basarili(Dil.T.Kabuk.Kaydedildi);
            await Yukle();
        }
        catch (ApiHata ex) when (ParaMasakKapisi.MasakReddi(ex)) { await PM.Reddet(ex, Dil.Dil); }
        catch (ApiHata ex) when (CariNakitSiniri.NakitReddi(ex)) { NS.Reddet(ex, DtOlcuTl, dovizTahsilatCari?.Id); }   // YASAL-KAPI-3: alan altında
        catch (ApiHata ex) { islemHata = ex.Message; }
        kaydediliyor = false;
    }
