    // ── "Son değişiklik: Ayşe Y., dün 16:20 · Kim ne yaptı" ──
    private DateTime? sonDegisiklikZaman;
    private string? sonDegisiklikKim;
    // T-M1 doğrulayıcı DÜŞÜK: kişi bilgisi (SAHİP · /denetim) gelene dek ad yerine yer tutucu.
    private bool sonDegisiklikKisiBekleniyor;
    private string? sonDegisiklikHata;
    private static readonly string[] YazmaEylemleri = ["EKLEME", "GUNCELLEME", "SILME"];

    /// <summary>Sunucu UTC yazar (Kind belirsiz serileşir) → yerel saate.</summary>
    public static DateTime Yerel(DateTime t) =>
        Bicim.IsletmeZamani(t);   // TOPLU-1 TARIH-TEK: işletme saati (Europe/Istanbul)

    /// <summary>"Ayşe Yılmaz" → "Ayşe Y." (tuval). Tek kelime ya da "sistem" AYNEN.</summary>
    public static string KisaAd(string ad)
    {
        var p = ad.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length < 2 ? ad.Trim() : $"{string.Join(' ', p[..^1])} {char.ToUpper(p[^1][0], System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))}.";
    }

    public static string ZamanMetni(DateTime yerel, DateTime simdi, MusteriTuvalMetinleri t, string dil)
    {
        var saat = Bicim.Saat(yerel);
        if (yerel.Date == simdi.Date) return string.Format(t.Bugun, saat);
        if (yerel.Date == simdi.Date.AddDays(-1)) return string.Format(t.Dun, saat);
        return $"{Bicim.GunBicim(yerel, "d", System.Globalization.CultureInfo.GetCultureInfo(dil == "en" ? "en-GB" : "tr-TR"))} {saat}";
    }

    private string? SonDegisiklikMetni
    {
        get
        {
            if (sonDegisiklikZaman is not { } z) return null;
            var zaman = ZamanMetni(Yerel(z), DateTime.Now, T, Dil.Dil);
            if (sonDegisiklikKisiBekleniyor) return string.Format(T.SonDegisiklikKimli, T.KisiAliniyor, zaman);
            return sonDegisiklikKim is { Length: > 0 } kim
                ? string.Format(T.SonDegisiklikKimli, KisaAd(kim), zaman)
                : string.Format(T.SonDegisiklik, zaman);
        }
    }

    private async Task SonDegisiklikYukle(CariVeri c, Func<bool> guncel)
    {
        sonDegisiklikZaman = c.Guncellendi;
        sonDegisiklikKim = null;
        sonDegisiklikHata = null;
        sonDegisiklikKisiBekleniyor = false;
        // Denetim izi YALNIZ SAHİP'e açık (DenetimController sınıf düzeyi RolGerekli).
        if (!Sade || !SahipMi) return;
        sonDegisiklikKisiBekleniyor = true;
        try
        {
            var s = await Api.GetAsync<Kuyumcu.Contracts.Sayfalar.DenetimIzi.Sayfa>(
                $"/denetim?varlikTuru=Cari&varlikId={Uri.EscapeDataString(c.Id)}&limit=20");
            var son = (s.Kayitlar ?? []).Where(k => YazmaEylemleri.Contains(k.Eylem))
                .OrderByDescending(k => k.Tarih).FirstOrDefault();
            if (!guncel()) return;   // başka açılışa ait yanıt: dokunma
            if (son is not null)
            {
                sonDegisiklikKim = son.Kullanici;
                sonDegisiklikZaman = son.Tarih;
            }
            sonDegisiklikKisiBekleniyor = false;
        }
        catch (ApiHata ex) when (ex.StatusCode == 403) { if (guncel()) sonDegisiklikKisiBekleniyor = false; /* rol değişmiş olabilir: yalnız zaman yazılır */ }
        catch (Exception ex) when (ex is ApiHata or JsonException) { if (guncel()) { sonDegisiklikKisiBekleniyor = false; sonDegisiklikHata = ex.Message; } }
    }

