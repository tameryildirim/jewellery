                HucreSinif = c => c.TlBakiye < 0 ? "hucre-vurgu sayi musteri-sutun-borc metin-kirmizi" : "hucre-vurgu sayi musteri-sutun-borc",
                HucreTikla = EventCallback.Factory.Create<CariVeri>(this, SatirTikla),
                Hucre = c => b => CariHucreTl(b, c),
            });
            liste.Add(new()
            {
                Anahtar = "has", Baslik = Sade ? T.SutunHas : Dil.T.Cari.HasGram,
                BaslikSinif = "musteri-sutun-ek", Tur = Kuyumcu.Web.Bilesenler.Grid.IzgaraHucreTuru.Has,
                HucreSinif = c => c.HasGramBakiye < 0 ? "hucre-vurgu sayi musteri-sutun-ek metin-kirmizi" : "hucre-vurgu sayi musteri-sutun-ek",
                Hucre = c => b => CariHucreHas(b, c),
            });
            if (DovizSutunu)
                liste.Add(new()
                {
                    Anahtar = "doviz", Baslik = Dil.T.Cari.DovizBakiye, BaslikSinif = "musteri-sutun-ek",
                    Tur = Kuyumcu.Web.Bilesenler.Grid.IzgaraHucreTuru.Para,
                    HucreSinif = _ => "hucre-vurgu sayi musteri-sutun-ek",
                    Hucre = c => b => CariHucreDoviz(b, c),
