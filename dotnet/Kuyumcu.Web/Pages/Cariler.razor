    // ═══ KESIF-P2 (#22) — UYRUK: MASAK formuyla tek standart (UlkeListesi, ISO alpha-3) ═══
    private bool yeniUyrukDiger, duzUyrukDiger;
    /// <summary>Düzenleme açılırken sunucudan gelen değer (eşlenemeyen eski kod AYNEN korunur).</summary>
    private string? yuklenenUyruk;

    private IReadOnlyList<SecenekOgesi> UlkeSecenekleri =>
        UlkeListesi.Tumu.Select(u => new SecenekOgesi(u.Kod, Dil.Dil == "en" ? u.En : u.Tr))
            .Append(new SecenekOgesi(UlkeListesi.Diger, P2.UyrukDiger))
            .ToList();

    private static bool UyrukDigerMi(string deger, bool diger) =>
        diger || (!string.IsNullOrWhiteSpace(deger) && !UlkeListesi.Listede(deger));

    private static string? UyrukSecimi(string deger, bool diger) =>
        UyrukDigerMi(deger, diger) ? UlkeListesi.Diger : (string.IsNullOrWhiteSpace(deger) ? null : deger);

    /// <summary>Kod kutusunun alan altı hatası. Değişmeyen eski değer hata DEĞİL (rozet söyler).</summary>
    private string? UyrukKodHatasi(string deger, string? yuklenen) =>
        UyrukGecersiz(deger, yuklenen) ? P2.UyrukKodGecersiz : null;

    /// <summary>Gönderilirse sunucunun 400 vereceği değer mi? (3 harf + ISO; değişmeyen eski değer serbest)</summary>
    private static bool UyrukGecersiz(string deger, string? yuklenen)
    {
        if (string.IsNullOrWhiteSpace(deger)) return false;
        var v = deger.Trim().ToUpperInvariant();
        if (yuklenen is not null && v == yuklenen.Trim().ToUpperInvariant()) return false;
        return v.Length != 3 || !UlkeListesi.KodGecerli(v);
    }

    /// <summary>Kayıttaki değer tanınmayan (eşlenemeyen eski) kod ve kullanıcı henüz değiştirmedi.</summary>
    private bool DuzUyrukDuzeltilmeli =>
        !string.IsNullOrWhiteSpace(yuklenenUyruk)
        && (yuklenenUyruk!.Trim().Length != 3 || !UlkeListesi.KodGecerli(yuklenenUyruk))
        && string.Equals(duzUyruk.Trim(), yuklenenUyruk.Trim(), StringComparison.OrdinalIgnoreCase);

    private void YeniUyrukSecildi(string? v) => UyrukSec(v, ref yeniUyruk, ref yeniUyrukDiger);
    private void DuzUyrukSecildi(string? v) => UyrukSec(v, ref duzUyruk, ref duzUyrukDiger);

    private static void UyrukSec(string? v, ref string deger, ref bool diger)
    {
        if (v == UlkeListesi.Diger)
        {
            diger = true;
            // Listedeki bir ülkeden "Diğer"e geçilince eski kod gövdede KALMAZ (MasakFormu ile aynı).
            if (UlkeListesi.Listede(deger)) deger = "";
        }
        else
        {
            diger = false;
            deger = v ?? "";
        }
    }

