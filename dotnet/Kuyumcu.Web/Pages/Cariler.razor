    private GecersizAlanKapisi sayiKapisi => _sayiKapisi ??= new(() => InvokeAsync(StateHasChanged));

    // ═══ PAKET S3-2 — MÜŞTERİLER: LİSTE + ÇEKMECE (plan § 6 S-3, taslak Musteriler.dc.html) ═══
    // ⚠ Mod YETKİ DEĞİLDİR (plan § 3/6): yalnız ÇİZİM kararı. Sunucu kapıları aynen.
