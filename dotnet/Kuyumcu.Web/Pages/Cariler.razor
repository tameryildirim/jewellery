            if (DurumSutunu)
                liste.Add(new()
                {
                    Anahtar = "durum", Baslik = Dil.T.Urun.Durum, Tur = Kuyumcu.Web.Bilesenler.Grid.IzgaraHucreTuru.Rozet,
                    Hucre = c => b => CariHucreDurum(b, c),
                });
            liste.Add(new()
            {
                Anahtar = "eylem", Baslik = Dil.T.Ortak.Eylemler, BaslikGizli = true, BaslikSinif = "musteri-sutun-ek",
                ZorunluGorunur = true, Tasinamaz = true, KartEtiketsiz = true,
                Tur = Kuyumcu.Web.Bilesenler.Grid.IzgaraHucreTuru.Eylem,
                HucreSinif = _ => "musteri-sutun-ek",
                Hucre = c => b => CariHucreEylem(b, c),
            });
            return liste;
        }
