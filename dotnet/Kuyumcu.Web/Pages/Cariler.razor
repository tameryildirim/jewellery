    private string DovizTutarEtiketi(string paraBirimi) => string.Format(Toplu2Sozlugu.Al(Dil.Dil).DovizTutar, paraBirimi);

    private string DovizKilitSebebi(string paraBirimi, decimal tutar, string? kasaId = null)
    {
        if (DovizKuru(paraBirimi) is null) return Dil.T.Cari.KurYokDovizYapilamaz;
        if (tutar <= 0m) return DovizTutarEtiketi(paraBirimi);
        if (kasaId is not null && string.IsNullOrEmpty(kasaId)) return Dil.T.Kasa.Baslik;
        return Dil.T.Ortak.Kaydet;
    }

    /// <summary>
    /// Kur fotoğrafını çeker. ⚠ UX-S28: hata "kayıt yok"a ÇEVRİLMEZ — istek
