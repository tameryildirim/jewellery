    private IReadOnlyList<Kuyumcu.Web.Bilesenler.Grid.IzgaraKolonu<CariVeri>> CariKolonlari
    {
        get
        {
            var liste = new List<Kuyumcu.Web.Bilesenler.Grid.IzgaraKolonu<CariVeri>>
            {
                new()
                {
