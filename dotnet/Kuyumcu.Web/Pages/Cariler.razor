    // ── PAKET P-15 (B-29) — derin bağlantı durumu ───────────────────────────
    /// <summary>Süzgeç adres çubuğundan mı geldi? (rozet + temizleme yolu)</summary>
    private bool suzgecBaglantidan;
    /// <summary>Bağlantının işaret ettiği cari; liste yüklendikten sonra açılır.</summary>
    private string? baglantiCariId;
    /// <summary>SUNUM 14.10: bağlantı "islem=tahsilat" taşıyorsa kart yerine o müşterinin tahsilat penceresi açılır (Bugün → "Tahsil et").</summary>
    private bool baglantiTahsilat;

    /// <summary>
    /// Sorgu dizesindeki süzgeçleri KUTULARA yazar. Tanınmayan değer SESSİZCE
    /// yok sayılmaz — kutu boş kalır ve rozet de çıkmaz, kullanıcı süzgecin
    /// uygulanmadığını görür (Anayasa md.1).
    /// </summary>
    private void SorgudanSuzgecOku()
    {
        var suzgecler = DerinBaglanti.Suzgecler(Nav.Uri);
        if (suzgecler.Count == 0) return;

        if (suzgecler.TryGetValue("q", out var q))
        {
            arama = q;
            suzgecBaglantidan = true;
        }
        if (suzgecler.TryGetValue("tur", out var tur)
            && CariTurleri.Any(t => t.Deger == tur))
        {
            turFiltre = tur;
            suzgecBaglantidan = true;
        }
        if (suzgecler.TryGetValue("aktif", out var aktif) && bool.TryParse(aktif, out var a))
        {
            pasifleriGoster = !a;
            suzgecBaglantidan = true;
        }
        if (suzgecler.TryGetValue("cariId", out var id))
        {
            baglantiCariId = id;
            suzgecBaglantidan = true;
            baglantiTahsilat = suzgecler.TryGetValue("islem", out var islem) && islem == "tahsilat";
        }
    }

    /// <summary>
    /// Bağlantıdan gelen cariyi açar. Liste süzgecinin dışında kaldıysa
    /// SESSİZCE bırakılmaz: adı sunucudan okunur, arama kutusuna yazılır ve
    /// liste yeniden çekilir (süzgeç KUTUDA görünür — UX-S24/B-29).
    /// </summary>
    private async Task BaglantiCarisiniAc()
    {
        if (baglantiCariId is not { Length: > 0 } id) return;
        var hedef = CariListesi.FirstOrDefault(c => c.Id == id);
        if (hedef is null)
        {
            try
            {
                var detay = await Api.GetAsync<CariDetayVeri>($"/cari/{id}");
                arama = detay.Ad;
                pasifleriGoster = true;
                await Yukle();
                hedef = CariListesi.FirstOrDefault(c => c.Id == id);
            }
            catch (Exception ex) when (ex is ApiHata or JsonException)
            {
                // UX-S28: hata "kayıt yok"a çevrilmez; sebebi görünür.
                listeHata = ex.Message;
                return;
            }
        }
        if (hedef is not null) { if (baglantiTahsilat) await TahsilatAc(hedef); else await DetayAc(hedef); }
    }

    /// <summary>Bağlantıdan gelen süzgeci kaldırır — geri dönüş yolu (UX-S25).</summary>
    private async Task BaglantiSuzgeciniTemizle()
    {
        arama = "";
        turFiltre = "";
        pasifleriGoster = false;
        baglantiCariId = null;
        baglantiTahsilat = false;
        suzgecBaglantidan = false;
        await Yukle();
    }

    protected override async Task OnInitializedAsync()
    {
        Dil.Degisti += Yenile;
        Modu.Degisti += ModDegisti;
        SorgudanSuzgecOku();
        // GRID-1 tur 2: kayıtlı sıralama İLK liste isteğinden önce okunur (tek istek, sırasız anlık görüntü yok).
        cariSiralama = await CariTercih.KayitliSiralamaAsync("cariler", "cari-liste", CariKolonlari);
        await Yukle();
        await BaglantiCarisiniAc();
        // Döviz düğmelerinin kilidi kura bağlıdır (UX-S30); kur ilk yüklemede
        // çekilir ki düğme "sebepsiz kapalı" görünmesin.
        await KurYukle();
    }

    private static string TurRengi(string tur) => tur switch
    {
        "MUSTERI" => "mavi",
        "TEDARIKCI" => "amber",
        _ => "yesil",
    };

    private async Task Yukle()
    {
        yukleniyor = true;
        listeHata = null;
        try
        {
            var sorgu = new List<string> { $"limit={Sinir}" };
            if (!string.IsNullOrWhiteSpace(arama))
                sorgu.Add($"q={Uri.EscapeDataString(arama.Trim())}");
            if (!string.IsNullOrEmpty(turFiltre))
                sorgu.Add($"tur={turFiltre}");
            // Varsayılan AKTİF: pasife alınan cari listede "aktif gibi" duramaz
            // (QA turu 2 KRİTİK). Uç `aktif` süzgecini zaten destekliyordu.
            if (!pasifleriGoster) sorgu.Add("aktif=true");
            // PAKET GRID-1: ızgaranın sıralaması SUNUCUDA uygulanır (sınırlı listede
            // istemci sıralaması yalnız gelen 100 kaydı sıralar ve yanıltır).
            if (cariSiralama is not null) sorgu.Add(cariSiralama.Sorgu);
            CariListesi = await Api.GetAsync<List<CariVeri>>($"/cari?{string.Join("&", sorgu)}");
            // T-M1: "Vade geçti" rozeti ve panel bandı — yalnız BASİT yüz çizer.
            vadeIstendi = true; await VadeYukle();
        }
        catch (ApiHata ex)
        {
            // PAKET ISTEK-1 (UX-S28): hata listeyi BOŞALTMAZ — son başarılı
            // liste ekranda kalır, üstteki #hata-bandi sebebi söyler.
            listeHata = ex.Message;
        }
        yukleniyor = false;
    }

