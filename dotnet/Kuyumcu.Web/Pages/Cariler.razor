    // P-DIL-BORC-KASA tur 2: tek işaret kuralı (BorcDiliSozlugu.Yon) — yön gösterilen hassasiyetten (TL 2, has 4).
    private string? YonMetni(decimal n, int hane = 2) => BorcDiliSozlugu.Yon(n, hane) is var y && y == 1 ? P2.YonBizeBorclu : y == -1 ? P2.YonBizBorcluyuz : null;
    private static string YonRengi(decimal n, int hane = 2) => BorcDiliSozlugu.Yon(n, hane) is var y && y == -1 ? "kirmizi" : y == 1 ? "yesil" : "";

    /// <summary>
    /// KESIF-P2 tur 3 — karar 5 (BICIM-TEK, cari kısmı): bu sayfadaki HER has tek biçimleyiciden geçer:
    /// binlik gruplu, 4 ondalık, tam sıfırda "0 has", eksi işareti U+2212 (Bicim.Tl ile aynı), birim
    /// "has". ⚠ Ortak Bicim.Has (P-57: gruplamasız, "0,0000 has", ASCII tire) P2 dosya alanı dışında
    /// ve başka ekranların testlerine bağlı — global geçiş sahibine (P7/P8) bildirildi; o gün bu
    /// yardımcı Bicim.Has'a yönlenir.
    /// </summary>
    public static string HasBicim(decimal n)
    {
        var y = decimal.Round(n, 4, MidpointRounding.AwayFromZero);
        // PAKET DIL-EKRAN: birim etkin dilden (TR "has", EN "fine") — sayı biçimi tr-TR sabit kalır.
        var birim = Kuyumcu.Core.I18n.DilEkranSozlugu.HasBirimi(Bicim.Dil);
        if (y == 0m) return $"0\u00a0{birim}";
        var govde = Math.Abs(y).ToString("N4", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
        return y < 0 ? $"\u2212{govde}\u00a0{birim}" : $"{govde}\u00a0{birim}";
    }

