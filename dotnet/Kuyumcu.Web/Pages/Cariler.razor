    private bool HasUyusmazligi => ekstre is { BakiyeUyusmazligiHas: not 0m };
    private bool TlUyusmazligi => ekstre is { BakiyeUyusmazligiTl: { } f } && Math.Abs(f) > 0.01m;
    private bool UyusmazlikVar => HasUyusmazligi || TlUyusmazligi;

    /// <summary>PRO cümlesi: kalıp HTML'e kodlanır, farklar kimlikli span olarak yerleşir.</summary>
