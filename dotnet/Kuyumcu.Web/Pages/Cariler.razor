    private int? GecikmeGun(CariVeri c) => gecikmeler.TryGetValue(c.Id, out var g) ? g : null;

    private async Task VadeYukle()
    {
        try
        {
            var y = await Api.GetAsync<Kuyumcu.Contracts.Sayfalar.VadeTakibi.Yanit>("/raporlar/vade-takibi");
            gecikmeler = (y.Cariler ?? []).GroupBy(v => v.CariId)
                .ToDictionary(g => g.Key, g => g.Max(v => v.EnEskiGecikmeGun));
            yildizKalanlar = YildizKalanlariHesapla(y.Cariler);   // YILDIZ-4B: vadeye kalan gün (aynı yanıt, yeni istek YOK)
        }
        catch (ApiHata ex) when (ex.StatusCode == 403) { gecikmeler = []; }
        catch (Exception ex) when (ex is ApiHata or JsonException) { gecikmeler = []; listeHata ??= ex.Message; }
    }

