    // Sıra = ekran sırası: ilk 2 satırda görünür, gerisi "⋯" penceresinde.
    private EventCallback Cb(Func<Task> f) => EventCallback.Factory.Create(this, f);
    private EventCallback Cb(Action f) => EventCallback.Factory.Create(this, f);

    /// <summary>P-DIL-BORC-KASA (O21): BASİT modda "Düzeltme Fişi" yerine düz karşılık.</summary>
    private string DuzeltmeAdi => Sade ? BorcDiliSozlugu.BakiyeDuzelt(Dil.Dil) : Dil.T.Cari.Duzeltme;

    // ── D1-09 hesap dönüştürme ──
    private CariVeri? donusturCari;
    private CariVeri? odemePlaniCari;   // D1-06
    private async Task HesapDonusturuldu() { donusturCari = null; Basarili(D1Sozlugu.Al(Dil.Dil).HdKaydedildi); await Yukle(); }
    private string DovizTahsilatAdi => Sade ? BorcDiliSozlugu.DovizleTahsilat(Dil.Dil) : Dil.T.Cari.DovizTahsilat;
    private string DovizVeresiyeAdi => Sade ? BorcDiliSozlugu.DovizleVeresiye(Dil.Dil) : Dil.T.Cari.DovizVeresiye;

    private IReadOnlyList<SatirEylemleri.Eylem> CariEylemleri(CariVeri c)
    {
        var pasif = !c.Aktif && !c.SistemCarisi;
        // T-M1: BASİT yüzde satır düğmeleri tuvaldeki gibi YALNIZ yazılıdır.
        // KESIF-P2 (KIYAS UX-5): PRO'daki 6 emoji de kalktı (ikon kuralı: ince çizgi ya da hiç;
        // SatirEylemleri.Eylem.Ikon metin taşır — çizgi ikon tipi UX-5-GENIS'in işi).
        var tahsilat = new SatirEylemleri.Eylem($"c-tahsilat-{c.Id}", Dil.T.Cari.Tahsilat, Cb(() => TahsilatAc(c)));
        var l = new List<SatirEylemleri.Eylem>();
        // QA turu 2 KRİTİK: pasife almanın GERİ DÖNÜŞ YOLU (UX-S25) — pasif satırda birinci eylem.
        if (pasif)
            l.Add(new($"c-aktife-al-{c.Id}", Dil.T.Kabuk.AktifeAl, Cb(() => AktifeAl(c)),
                      kilitli: kaydediliyor, kilitNedeni: Dil.T.Kabuk.Kaydediliyor));
        else
            l.Add(tahsilat);
        l.Add(new($"c-duzenle-{c.Id}", Dil.T.Ortak.Duzenle, Cb(() => DuzenleAc(c))));
        // Pasif satırda tahsilat yolu KAYBOLMAZ: "⋯" penceresinde.
        if (pasif) l.Add(tahsilat);
        l.Add(new($"c-detay-{c.Id}", Dil.T.Ortak.Detay, Cb(() => DetayAc(c))));
        l.Add(new($"c-veresiye-{c.Id}", Dil.T.Cari.Veresiye, Cb(() => VeresiyeAc(c))));
        // Elle bakiye müdahalesi TEZGÂHTAR'a GÖSTERİLMEZ (ekip oyu Q3); API de [RolGerekli] ile kapalı.
        if (DuzeltmeGorebilir)
            l.Add(new($"c-duzeltme-{c.Id}", DuzeltmeAdi, Cb(() => DuzeltmeAc(c)),
                      ariaEtiket: $"{c.Ad} — {DuzeltmeAdi}"));
        // D1-09: hesap dönüştürme — düzeltmeyle AYNI rol kapısı (API de SAHİP/MÜDÜR/MUHASEBE).
        if (DuzeltmeGorebilir && !c.SistemCarisi)
            l.Add(new($"c-hesap-donustur-{c.Id}", D1Sozlugu.Al(Dil.Dil).HesapDonustur, Cb(() => donusturCari = c)));
        if (!c.SistemCarisi)   // D1-06: herkes görür; plan açma/kaldırma çekmecede rol kapısıyla
            l.Add(new($"c-odeme-plani-{c.Id}", D1Sozlugu.Al(Dil.Dil).OdemePlani, Cb(() => odemePlaniCari = c)));
        // Paket 27 — döviz defteri; UX-S30: kur yoksa KİLİTLİ ve sebebi yazılı (MenuEk).
        l.Add(new($"c-doviz-tahsilat-{c.Id}", DovizTahsilatAdi, Cb(() => DovizTahsilatAc(c)),
                  kilitli: !DovizYapilabilir, kilitNedeni: Dil.T.Cari.KurYokDovizYapilamaz));
        if (DuzeltmeGorebilir)
            l.Add(new($"c-doviz-veresiye-{c.Id}", DovizVeresiyeAdi, Cb(() => DovizVeresiyeAc(c)),
                      kilitli: !DovizYapilabilir, kilitNedeni: Dil.T.Cari.KurYokDovizYapilamaz));
        // P-38 · B-39 — yıkıcı eylem onay modalından geçer; geri dönüş pasif satırdaki "Aktife al".
        if (c.Aktif && !c.SistemCarisi)
            l.Add(new($"c-pasife-al-{c.Id}", Sade ? T.KullanimdanKaldir : Dil.T.Cari.PasifeAl, Cb(() => PasifOnayAc(c)),
                      tehlike: true, kilitli: kaydediliyor, kilitNedeni: Dil.T.Kabuk.Kaydediliyor,
                      ariaEtiket: $"{c.Ad} — {(Sade ? T.KullanimdanKaldir : Dil.T.Cari.PasifeAl)}"));
        return l;
    }

