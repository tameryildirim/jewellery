                           ödeme türü ve yürüyen bakiye (önceki + satır). Etkisi bilinmeyen satırdan eskisi "—". *@
                        @{ var yuruyen = YuruyenBakiyeler(); var yuruyenHas = YuruyenHasBakiyeler(); }
                        @foreach (var h in DetayHareketler)
                        {
                            <div class="satir-arasi liste-satiri" id="@($"cari-detay-satir-{h.Id}")">
                                <div class="esnek">
                                    @* TOPLU-1 (CARI-BAKIYE 01.10, YÜKSEK): iptal (storno) satırı kaynağın tür adını ("Veresiye")
                                       aynen taşıyordu — iptal olduğu yazmıyordu. Artık "Veresiye iptali" (BASİT) /
                                       "Veresiye · storno" (PRO); kaynak sunucunun stornoKaynakId'si. *@
                                    <span class="hucre-vurgu" id="@($"cari-detay-tur-{h.Id}")" title="@(Sade ? null : h.Tur)">@SatirTurAdi(h)</span>
                                    @if (EkstreOdemeAdi(h) is { } odemeAdi)
                                    {
                                        <span class="metin-soluk hucre-tek-satir" id="@($"cari-detay-odeme-{h.Id}")"> · @odemeAdi</span>
                                    }
                                    @if (h.Emanet)
                                    {
                                        @* Karar 3: HER emanet satırı "Emanet — bakiyeye girmez"; has'ı toplama katılmaz. *@
                                        <span id="@($"cari-detay-emanet-{h.Id}")">
                                            <Rozet Renk="gri">@P2.EmanetBakiyeyeGirmez</Rozet>
                                        </span>
                                    }
                                    @* Açıklama kendi satırında: satır içi "— açıklama" 375 px'te tireden kırılıyordu (K3, ölçüldü). *@
                                    @if (!string.IsNullOrEmpty(h.Aciklama))
                                    {
                                        <p class="metin-soluk metin-kucuk" id="@($"cari-detay-aciklama-{h.Id}")">@SatirAciklamasi(h)</p>
                                    }
                                    <p class="metin-soluk metin-kucuk">@Bicim.Tarih(h.Olusturuldu, Dil.Locale)</p>
                                </div>
                                <div class="sayi">
                                    @if (h.CariTlEtkisi is { } tlEtki && tlEtki != 0m)
                                    {
                                        <p id="@($"cari-detay-tl-{h.Id}")">@Bicim.Tl(tlEtki)</p>
                                    }
                                    else if (h.CariTlEtkisi is not null && h.TlTutari != 0m)
                                    {
                                        <p class="metin-soluk metin-kucuk" id="@($"cari-detay-tl-{h.Id}")">@string.Format(PD.EkstrePesinOdendi, Bicim.Tl(h.TlTutari))</p>
                                    }
                                    else if (h.TlTutari != 0m)
                                    {
                                        <p id="@($"cari-detay-tl-{h.Id}")">@Bicim.Tl(h.TlTutari)</p>
                                    }
                                    @* PARA-DEMO-2 (madde 9): has etkisi olmayan satırda boş işaret ("—") basılmaz. *@
                                    @if (HasEtkili(h))
                                    {
                                        <p class="metin-amber" id="@($"cari-detay-has-{h.Id}")">@HasBicim(SatirEtkisi(h))</p>
                                    }
                                    @if (h.Emanet && h.EmanetHas != 0m)
                                    {
                                        <p class="metin-soluk metin-kucuk" id="@($"cari-detay-emanet-has-{h.Id}")">@string.Format(P2.EmanetSatir, HasBicim(h.EmanetHas))</p>
                                    }
                                    @* PARA-DEMO-2 (madde 9): has satırında bakiye has bakiyesini de yazar. *@
                                    <p class="metin-soluk metin-kucuk" id="@($"cari-detay-bakiye-{h.Id}")">@(HasEtkili(h) ? string.Format(PD2.EkstreHasBakiye, yuruyen.TryGetValue(h.Id, out var ybh) && ybh is { } ybhd ? Bicim.Tl(ybhd) : "—", HasBicim(yuruyenHas.GetValueOrDefault(h.Id))) : yuruyen.TryGetValue(h.Id, out var yb) && yb is { } ybd ? string.Format(PD.EkstreBakiyeSonra, Bicim.Tl(ybd)) : PD.EkstreBakiyeBilinmiyor)</p>
                                </div>
                            </div>
                        }
                    </div>
                    @* TOPLU-1: bakiye uyuşmazlığı bandı buradan (tablonun altından) bakiye kutularının HEMEN ALTINA taşındı
                       ve iki bant tek uyarıda birleşti — bkz. #cari-detay-uyusmazlik. *@
                    @if (ekstre is { SayfaDisiHasEtkisi: not 0m } ek)
                    {
                        <p class="metin-soluk metin-kucuk" id="cari-detay-sayfa-disi">@string.Format(P2.SayfaDisiEtki, HasBicim(ek.SayfaDisiHasEtkisi))</p>
                    }
                    @if (ekstre is { DahaFazlaVar: true } ek2)
                    {
                        <p class="metin-soluk metin-kucuk" id="cari-detay-daha-fazla">@string.Format(P2.DahaFazlaVar, ek2.Limit)</p>
                    }
                    <Katlanir Id="cari-detay-kural" Baslik="@P2.HasEtkisiKuralOzet">
                        <p class="metin-kucuk" id="cari-detay-kural-metin">@P2.HasEtkisiKural</p>
                    </Katlanir>
                }
            </div>
        </div>
    }
</ModalPencere>
