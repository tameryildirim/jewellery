    private async Task CariOlustur()
    {
        if (sayiKapisi.OnekleVar("cari-")) return;   // ORTAK-1: POST YOK (düğme de pasif, sebep yazılı)
        modalHata = null;
        // SESSİZ ETKİSİZLİK YASAĞI (C0-d): eksik alan varsa istek ATILMAZ ama
        // kullanıcı NEDEN olmadığını alanın altında görür ve odak oraya gider.
        form.Temizle();
        form.Zorunlu("cari-ad", yeniAd, Dil);
        form.Eposta("cari-eposta", yeniEmail, Dil);
        form.Telefon("cari-telefon", yeniTelefon, Dil);
        form.NegatifDegil("cari-limit", yeniKrediLimiti, Dil);
        // PAKET P-16 (Y-27): TCKN 11 / VKN 10 hane — ALAN ALTINDA.
        KimlikDogrula("cari-vergino", yeniVergiNo, yeniKimlikTuru);
        // KESIF-P2 (#22): sunucunun 400 vereceği uyruk POST'a gitmez; alan altında yazar.
        if (UyrukGecersiz(yeniUyruk, null)) { yeniUyrukDiger = true; form.Ekle("cari-uyruk-kod", P2.UyrukKodGecersiz); }
        if (yeniIskonto is < 0m or > 100m) form.Ekle("cari-iskonto", Dil.T.Cari.IskontoYuzdeIpucu);
        if (!form.Gecerli)
        {
            // S3-2: hata katlı bir alandaysa grup AÇILIR — alan altı mesaj görünmeli.
            if (GizliAlandaHataVar(form, YeniGorunurAlanlar)) yeniDahaFazla = true;
            modalHata = Dil.T.Kabuk.FormEksik;
            await OdakIlkHataya();
            return;
        }
        kaydediliyor = true;
        try
        {
            await Api.PostAsync("/cari", new
            {
                ad = yeniAd.Trim(),
                tur = yeniTur,
                telefon = TelefonBicimi.Sunucuya(yeniTelefon),
                email = BosIseNull(yeniEmail),
                vergiNo = BosIseNull(yeniVergiNo),
                adres = BosIseNull(yeniAdres),
                krediLimitiTl = yeniKrediLimiti,
                varsayilanVadeGun = yeniVadeGun,
                fiyatListesiId = string.IsNullOrEmpty(yeniFiyatListesiId) ? null : yeniFiyatListesiId,
                notlar = BosIseNull(yeniNotlar),
                // ═══ PAKET P-16 (Y-27) ═══
                unvan = BosIseNull(yeniUnvan),
                kimlikTuru = BosIseNull(yeniKimlikTuru),
                dogumTarihi = yeniDogumTarihi,
                uyruk = BosIseNull(yeniUyruk),
                iskontoYuzde = yeniIskonto,
                segment = BosIseNull(yeniSegment),
                hesapKodu = BosIseNull(yeniHesapKodu),
            });
            yeniModalAcik = false;
            Basarili(Dil.T.Kabuk.Kaydedildi);   // UX-S27: sonuç GÖRÜNÜR
            await Yukle();
        }
        catch (ApiHata ex)
        {
            form.Sunucudan(ex, YeniEsleme);
            if (GizliAlandaHataVar(form, YeniGorunurAlanlar)) yeniDahaFazla = true;
            modalHata = FormDurumu.SunucuMesaji(ex, Dil);
            await OdakIlkHataya();
        }
        kaydediliyor = false;
    }

