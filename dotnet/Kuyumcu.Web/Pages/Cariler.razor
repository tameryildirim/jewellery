                    Hucre = c => b => CariHucreTelefonSade(b, c),
                }
                : new()
                {
                    Anahtar = "telefon", Baslik = Dil.T.Cari.Telefon, SunucuSiralamaAdi = "telefon",
                    HucreSinif = _ => "hucre-tek-satir",
                    HucreOznitelikleri = new Dictionary<string, object> { ["data-duzenlenebilir"] = "true" },
                    Hucre = c => b => CariHucreTelefonPro(b, c),
