    private string TlKarsiligiMetni(string paraBirimi, decimal tutar)
    {
        if (DovizKuru(paraBirimi) is not { } kur) return Dil.T.Cari.KurYokDovizYapilamaz;
        return Bicim.Tl(Math.Round(tutar * kur, 2, MidpointRounding.AwayFromZero));
