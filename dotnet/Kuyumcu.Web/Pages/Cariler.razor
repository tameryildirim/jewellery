            liste.Add(new()
            {
                Anahtar = "tl-bakiye", Baslik = Sade ? P2.SutunBakiye : Dil.T.Cari.TlBakiye,
                BaslikSinif = "musteri-sutun-borc", ZorunluGorunur = true, SunucuSiralamaAdi = "tl-bakiye",
