    {
        if (mfaCalisiyor || string.IsNullOrWhiteSpace(mfaKod)) return;
        mfaHata = null;
        mfaCalisiyor = true;
        try
        {
            var y = await Api.PostAsync("/auth/mfa/dogrula", new { kod = mfaKod.Trim() });
            kurtarmaKodlari = y.TryGetProperty("kurtarmaKodlari", out var kl) && kl.ValueKind == JsonValueKind.Array
                ? [.. kl.EnumerateArray().Select(e => e.GetString() ?? "")]
                : [];
            // Giz artık gerekmiyor — bellekten düşür.
            gizBase32 = null;
            otpauthUri = null;
            gizGorunur = false;
            mfaKod = "";
        }
        catch (ApiHata ex) { mfaHata = ex.Message; }
        mfaCalisiyor = false;
