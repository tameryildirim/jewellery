    private async Task Sifirla()
    {
        if (mfaCalisiyor) return;
        mfaHata = null;
        mfaCalisiyor = true;
        try
        {
            await Api.PostAsync("/auth/mfa/sifirla", new { });
            gizBase32 = null; otpauthUri = null; kurtarmaKodlari = null; kurulumAcik = false;
            await MfaDurumYukle();
            genelBasari = Dil.T.Yonetim.MfaSifirlandi;
            genelJeton++;
        }
        catch (ApiHata ex) { mfaHata = ex.Message; }
        mfaCalisiyor = false;
