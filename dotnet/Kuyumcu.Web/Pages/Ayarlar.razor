    private async Task MfaDurumYukle()
    {
        mfaYukleniyor = true;
        mfaHata = null;
        try
        {
            var d = await Api.GetAsync<JsonElement>("/auth/mfa/durum");
            mfaDurum = d.TryGetProperty("durum", out var du) && du.ValueKind == JsonValueKind.String
                ? du.GetString() : null;
            mfaKalanKod = d.TryGetProperty("kalanKurtarmaKodu", out var kk) && kk.ValueKind == JsonValueKind.Number
                ? kk.GetInt32() : 0;
            mfaKilitli = d.TryGetProperty("kilitli", out var kl) && kl.ValueKind == JsonValueKind.True;
        }
        // UX-S28: hata "kayıt yok"a çevrilmez; bant ayrıdır.
        catch (Exception ex) when (ex is ApiHata or JsonException) { mfaHata = ex.Message; }
        mfaYukleniyor = false;
    }

    private async Task Kur()
    {
        if (mfaCalisiyor) return;
        mfaHata = null;
        mfaCalisiyor = true;
        try
        {
            var y = await Api.PostAsync("/auth/mfa/kur", new { });
            gizBase32 = y.GetProperty("gizBase32").GetString();
            otpauthUri = y.TryGetProperty("otpauthUri", out var o) ? o.GetString() : null;
            gizGorunur = false;
            kurtarmaKodlari = null;
            kurtarmaOnaylandi = false;
            mfaKod = "";
            kurulumAcik = true;
        }
        catch (ApiHata ex) { mfaHata = ex.Message; }
        mfaCalisiyor = false;
