    private bool ProfilAdBos => string.IsNullOrWhiteSpace(pAd) || string.IsNullOrWhiteSpace(pSoyad);
    private bool ProfilEpostaHatali => pEmail.Length > 0 && !EpostaGecerli(pEmail);
    private bool ProfilGecerli => !ProfilAdBos && EpostaGecerli(pEmail);

    private void ProfilAc()
