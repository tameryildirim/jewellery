    {
        yenileHata = null;
        yenileKod = "";
        yenileAcik = true;
    }

    private async Task KurtarmaYenile()
    {
        if (mfaCalisiyor || string.IsNullOrWhiteSpace(yenileKod)) return;
        yenileHata = null;
        mfaCalisiyor = true;
        try
        {
            var y = await Api.PostAsync("/auth/mfa/kurtarma-yenile", new { kod = yenileKod.Trim() });
            kurtarmaKodlari = y.TryGetProperty("kurtarmaKodlari", out var kl) && kl.ValueKind == JsonValueKind.Array
                ? [.. kl.EnumerateArray().Select(e => e.GetString() ?? "")]
                : [];
            kurtarmaOnaylandi = false;
            kurulumAcik = true;      // kodlar aynı kartta bir kez gösterilir
            yenileAcik = false;
            yenileKod = "";
            await MfaDurumYukle();
        }
        catch (ApiHata ex) { yenileHata = ex.Message; }
        mfaCalisiyor = false;
    }

    // ⚠ Razor özniteliğinde bloklu lambda derlenmez — adlandırılmış metot (UX-S19).
    private Task ModDevral() => ModSec(null);
    private Task ModBasit() => ModSec(ArayuzModuServisi.Basit);
    private Task ModProfesyonel() => ModSec(ArayuzModuServisi.Profesyonel);

    private async Task ModSec(string? mod)
    {
        if (kaydediliyorMod) return;
        kaydediliyorMod = true;
        modHata = null;
        try
        {
            await Modu.DegistirAsync(mod);
            BasariGoster(Dil.T.Yonetim.Kaydedildi);   // QA turu 2: sessizce kaydediliyordu
        }
        catch (ApiHata ex) { modHata = ex.Message; }
        kaydediliyorMod = false;
    }

    private bool Eslesmiyor => yeniSifre != yeniSifreTekrar && yeniSifreTekrar.Length > 0;
    private bool SifreAlanlariDolu =>
        mevcutSifre.Length > 0 && yeniSifre.Length > 0 && yeniSifreTekrar.Length > 0;
    private string AdSoyad => $"{Oturum.Kullanici?.Ad ?? ""} {Oturum.Kullanici?.Soyad ?? ""}".Trim();

    protected override async Task OnInitializedAsync()
    {
        EskiSekmeyiYonlendir();
        // Sayfa içi gezinmede (aynı bileşen, yalnız ?sekme= değişir) de yönlendir —
        // canlı ölçüm: /ayarlar?sekme=dukkan → ?sekme=hesap ilk sekmeye düşüyordu.
        Nav.LocationChanged += KonumDegisti;
        if (Sp.GetService<YetkiServisi>() is { } yetki) yetki.Degisti += Yenile;
        Dil.Degisti += Yenile;
        Oturum.Degisti += Yenile;
        Modu.Degisti += Yenile;
        BenimGorunum.Degisti += Yenile;
        Gorunum.Degisti += Yenile;
        await BenimGorunum.YukleAsync();
        await MfaDurumYukle();
        await KunyeYukle();
        if (SahipMi) await DestekYukle();
    }

    // ── Destek paketi (PAKET P-31 · R-5 · T-4b) ──────────────────────────────
    private DestekMetinleri DM => DestekSozlugu.Al(Dil.Dil);
    private const string DestekVarsayilanKonu = "HATA";
    private Kuyumcu.Core.Sozlesmeler.DestekPaketiGecmisi? destekGecmis;
    private bool destekYukleniyor;
    private string destekKonu = DestekVarsayilanKonu;
    private string destekGerekce = "";
    private string destekHataKodu = "";
    private bool destekOnay;
    private bool destekCalisiyor;
    private string? destekBasari;
    private int destekJeton;
    private string? destekHata;
    private string? destekHataKimligi;

    /// <summary>Seçenekler SUNUCUNUN beyaz listesinden, adları sözlükten (UX-S31).</summary>
    private IReadOnlyList<SecenekOgesi> DestekKonuSecenekleri =>
        (destekGecmis?.Konular ?? [])
            .Select(k => new SecenekOgesi(k, DestekSozlugu.KonuAdi(k, Dil.Dil)))
            .ToList();

    private List<Kuyumcu.Core.Sozlesmeler.DestekPaketiGecmisSatiri> DestekKayitlari =>
        destekGecmis?.Kayitlar ?? [];

    // PAKET GOC-D — destek paketi geçmişi ortak ızgarada. Sınıra değen listede sıralama düğmesi çıkmaz.
    private IzgaraSiralama? destekSira;
    private bool DestekTam => destekGecmis is { DahaFazlasiVar: false };
    private IReadOnlyList<IzgaraKolonu<Kuyumcu.Core.Sozlesmeler.DestekPaketiGecmisSatiri>> DestekKolonlari =>
    [
        new() { Anahtar = "tarih", Baslik = DM.SutunTarih, ZorunluGorunur = true, SunucuSiralamaAdi = DestekTam ? "tarih" : null,
                HucreSinif = _ => "metin-kucuk", Deger = g => g.Tarih, Hucre = g => @<text>@Bicim.TarihSaat(g.Tarih)</text> },
        new() { Anahtar = "paket", Baslik = DM.SutunPaketKodu, ZorunluGorunur = true, SunucuSiralamaAdi = DestekTam ? "paket" : null,
                Deger = g => g.PaketKodu, Hucre = g => @<code>@g.PaketKodu</code> },
        new() { Anahtar = "konu", Baslik = DM.SutunKonu, SunucuSiralamaAdi = DestekTam ? "konu" : null,
                HucreSinif = _ => "metin-kucuk", Deger = g => DestekSozlugu.KonuAdi(g.Konu, Dil.Dil) },
    ];

    private int DestekGerekceUzunlugu => destekGerekce.Trim().Length;
    private int DestekAsgari => destekGecmis?.AsgariGerekce is > 0 and var a ? a : 20;

    private bool DestekHataKoduGecersiz =>
        !string.IsNullOrWhiteSpace(destekHataKodu)
        && !Kuyumcu.Core.Sozlesmeler.HataKodu.GecerliMi(destekHataKodu);

    private bool DestekGonderilebilir =>
        destekGecmis is { KanalAcik: true } && !destekCalisiyor
        && DestekGerekceUzunlugu >= DestekAsgari && !DestekHataKoduGecersiz;

    /// <summary>UX-S30: kilitli düğmenin eksik koşulu yazılır.</summary>
    private string DestekKilitSebebi =>
        destekGecmis is not { KanalAcik: true } ? DM.KilitKanal
        : destekCalisiyor ? DM.KilitCalisiyor
        : DestekHataKoduGecersiz ? DM.HataKoduGecersiz
        : string.Format(DM.KilitGerekce, DestekAsgari, DestekGerekceUzunlugu);

    private async Task DestekYukle()
    {
        destekYukleniyor = true;
        destekHata = null;
        destekHataKimligi = null;
        try
        {
            var y = await Api.GetAsync<Kuyumcu.Core.Sozlesmeler.DestekPaketiGecmisi>("/destek/paket/gecmis");
            // Eksik liste alanı "kayıt yok" değil "alan gelmedi"dir; çizim
            // çökmesin diye boş listeye normalize edilir (sayım sunucudan).
            destekGecmis = y is null ? null : y with { Kayitlar = y.Kayitlar ?? [], Konular = y.Konular ?? [] };
            if (destekGecmis is null) destekHata = DM.Yuklenemedi;
        }
        catch (ApiHata ex)
        {
            // UX-S28: eldeki geçmiş BOŞALTILMAZ; hata ayrı bantta.
            destekHata = string.IsNullOrWhiteSpace(ex.Message) ? DM.Yuklenemedi : ex.Message;
            destekHataKimligi = ex.IstekKimligi;
        }
        destekYukleniyor = false;
    }

    private void DestekOnayAc()
    {
        if (!DestekGonderilebilir) return;
        destekBasari = null;
        destekOnay = true;
    }

    private void DestekOnayKapat() => destekOnay = false;

    private async Task DestekOlustur()
    {
        if (!DestekGonderilebilir) return;
        destekCalisiyor = true;
        destekHata = null;
        destekHataKimligi = null;
        try
        {
            var (veri, dosyaAdi) = await Api.PostBaytAsync("/destek/paket",
                new Kuyumcu.Core.Sozlesmeler.DestekPaketiIstegi(
                    destekGerekce.Trim(), destekKonu,
                    string.IsNullOrWhiteSpace(destekHataKodu) ? null : destekHataKodu.Trim()));
            var ad = dosyaAdi ?? "destek-paketi.json";
            try
            {
                await Js.InvokeVoidAsync("kuyumcuIndir", ad, Convert.ToBase64String(veri), "application/json");
            }
            catch (JSException)
            {
                // İndirme tetiklenemese de paket üretildi ve kaydı düştü;
                // sonuç yine banda yazılır (UX-S27).
            }
            destekBasari = string.Format(DM.Basari, ad);
            destekJeton++;
            destekGerekce = "";
            destekHataKodu = "";
            destekOnay = false;
            await DestekYukle();
        }
        catch (ApiHata ex)
        {
            destekHata = ex.Message;
            destekHataKimligi = ex.IstekKimligi;
        }
        destekCalisiyor = false;
    }

    // ── Sistem künyesi (paket T-4a) ──────────────────────────────────────────
    private SurumKunyesi? kunye;
    private SurumAyrintisi? ayrinti;
    private bool kunyeYukleniyor = true;
    private bool ayrintiYukleniyor;
    private string? kunyeHata;
    private string? kunyeHataKimligi;
    private bool? kunyeKopyalandi;

    private bool SahipMi => Oturum.Kullanici?.Rol == "SAHIP";

    private string OrtamMetni => kunye?.Ortam == "Production"
        ? Dil.T.Kunye.OrtamUretim
        : Dil.T.Kunye.OrtamGelistirme;

    private string DerlemeKaynagiMetni => kunye?.DerlemeZamaniKaynagi == "damga"
        ? Dil.T.Kunye.DerlemeKaynagiDamga
        : Dil.T.Kunye.DerlemeKaynagiDosya;

    private string TekSatirKunye => kunye is null ? "" : SurumServisi.TekSatir(kunye, Dil.Dil);

    private async Task KunyeYukle()
    {
        kunyeYukleniyor = true;
        kunyeHata = null;
        kunyeHataKimligi = null;
        try
        {
            kunye = await Surum.Yukle();
        }
        catch (ApiHata ex)
        {
            // UX-S28: künye okunamadı diye kart "boş" gösterilmez; hata yazılır.
            kunye = null;
            kunyeHata = string.IsNullOrWhiteSpace(ex.Message) ? Dil.T.Kunye.Yuklenemedi : ex.Message;
            kunyeHataKimligi = ex.IstekKimligi;
        }
        kunyeYukleniyor = false;
    }

    private async Task AyrintiYukle()
    {
        if (ayrintiYukleniyor) return;
        ayrintiYukleniyor = true;
        kunyeHata = null;
        kunyeHataKimligi = null;
        try
        {
            ayrinti = await Surum.Ayrinti();
        }
        catch (ApiHata ex)
        {
            ayrinti = null;
            kunyeHata = string.IsNullOrWhiteSpace(ex.Message) ? Dil.T.Kunye.Yuklenemedi : ex.Message;
            kunyeHataKimligi = ex.IstekKimligi;
        }
        ayrintiYukleniyor = false;
    }

    private async Task KunyeKopyala()
    {
        if (kunye is null) return;
        try
        {
            kunyeKopyalandi = await Js.InvokeAsync<bool>("kuyumcuPanoyaKopyala", TekSatirKunye);
        }
        catch
        {
            // Pano yoksa düğme sessizce ölmez: künye satırı zaten salt okunur
            // bir alanda seçilebilir duruyor.
            kunyeKopyalandi = false;
        }
    }

    private async Task SifreGuncelle()
    {
        if (kaydediliyor || Eslesmiyor
            || string.IsNullOrEmpty(mevcutSifre) || string.IsNullOrEmpty(yeniSifre) || string.IsNullOrEmpty(yeniSifreTekrar))
            return;

        hata = null;
        basarili = false;
        kaydediliyor = true;
        try
        {
            await Api.PatchAsync<JsonElement>("/kullanicilar/ben/sifre", new { mevcutSifre, yeniSifre, yeniSifreTekrar });
            mevcutSifre = yeniSifre = yeniSifreTekrar = "";
            basarili = true;
            basariJeton++;
            kaydediliyor = false;
        }
        catch (ApiHata ex)
        {
            hata = string.IsNullOrWhiteSpace(ex.Message) ? Dil.T.Ayarlar.SifreDegistirilemedi : ex.Message;
            kaydediliyor = false;
        }
    }

    private void Yenile() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Dil.Degisti -= Yenile;
        Oturum.Degisti -= Yenile;
        Modu.Degisti -= Yenile;
        BenimGorunum.Degisti -= Yenile;
        Gorunum.Degisti -= Yenile;
        Nav.LocationChanged -= KonumDegisti;
        if (Sp.GetService<YetkiServisi>() is { } yetki) yetki.Degisti -= Yenile;
    }
}
