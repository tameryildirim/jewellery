    private async Task FisAc()
    {
        if (kaydediliyor) return;
        formKalemHatasi = null;
        // P-78: belirsiz/geçersiz sayı SESSİZCE 0/1 sayılıp gönderilmez.
        if (IlkSayiHatasi(FormKalemli
                ? kalemler.SelectMany(k => new[] { k.Adet, k.BirimFiyat, k.Iscilik })
                : [fTutar]) is { } sayiMesaji)
        {
            formKalemHatasi = sayiMesaji;
            return;
        }

        // PAKET GOC-A (envanter açık #6 — "Vezne'de fiyatı ya da adedi 0 olan kalem UYARISIZ fişten atılıyor"):
        // ürün seçilmiş ama adedi/fiyatı eksik ya da geçersiz satır, yanında geçerli satır olsa bile ARTIK
        // ATILMAZ — satır numarasıyla söylenir ve POST yapılmaz. Tamamen boş satır (ürün yok, değer yok) yok sayılır.
        if (FormKalemli && KalemSatirHatasi(kalemler) is { } satirHatasi)
        {
            formKalemHatasi = satirHatasi;
            return;
        }
        var gecerli = kalemler
            .Where(k => !string.IsNullOrWhiteSpace(k.UrunId)
                     && (Sayi(k.Adet) ?? 0m) > 0m && (Sayi(k.BirimFiyat) ?? 0m) > 0m)
            .ToList();
        if (FormKalemli && gecerli.Count == 0)
        {
            // Sessiz etkisizlik YASAK: alan altı Türkçe mesaj.
            // Q10-5 (QA 10 · ORTA "negatif birim fiyatta yanlış mesaj"): ürünü
            // seçilmiş ama adedi/fiyatı sıfır ya da eksi olan satır varsa sebep
            // "kalem yok" DEĞİLDİR — doğru sebep söylenir.
            formKalemHatasi = kalemler.Any(k => !string.IsNullOrWhiteSpace(k.UrunId))
                ? Q105Sozlugu.Al(Dil.Dil).VezneKalemSayiHatasi
                : Dil.T.Vezne.KalemGerekli;
            return;
        }
        // P-23c: kalemsiz türde tutar ve cari ZORUNLU; eksikse alan altı mesaj.
        if (!FormKalemli && (Sayi(fTutar) ?? 0m) <= 0m)
        {
            formKalemHatasi = Dil.T.Vezne.TutarGerekli;
            return;
        }
        if (!FormKalemli && string.IsNullOrWhiteSpace(fCariId))
        {
            formKalemHatasi = Dil.T.Vezne.CariGerekli;
            return;
        }

        kaydediliyor = true;
        hata = null;
        try
        {
            var cevap = FormKalemli
                ? await Api.PostAsync("/vezne/fisler", new
                {
                    fisTuru = fFisTuru,
                    cariId = fCariId,
                    kurSnapshotId = kurId,
                    aciklama = string.IsNullOrWhiteSpace(fAciklama) ? null : fAciklama,
                    kalemler = gecerli.Select(k => new
                    {
                        urunId = k.UrunId,
                        adet = Sayi(k.Adet) ?? 1m,
                        birimFiyatTl = Sayi(k.BirimFiyat) ?? 0m,
                        iscilikTl = Sayi(k.Iscilik) ?? 0m,
                    }),
                })
                // Kalemsiz türde 'kalemler' GÖNDERİLMEZ (sunucu reddeder) ve
                // 'tutarTl' gönderilir — istemci ile sunucu sözleşmesi birebir.
                : await Api.PostAsync("/vezne/fisler", new
                {
                    fisTuru = fFisTuru,
                    cariId = fCariId,
                    kurSnapshotId = kurId,
                    aciklama = string.IsNullOrWhiteSpace(fAciklama) ? null : fAciklama,
                    tutarTl = Sayi(fTutar) ?? 0m,
                });
            // UX-S27: POST yanıtı OKUNUR.
            BasariGoster(Dil.T.Vezne.Olusturuldu, cevap);
            formAcik = false;
            kalemler = [new FormKalemi()];
            fTutar = "";
            fAciklama = "";
            await Yukle();
        }
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException) { hata = ex.Message; }
        kaydediliyor = false;
    }

