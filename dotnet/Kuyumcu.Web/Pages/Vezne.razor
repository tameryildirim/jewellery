    private async Task DuzenlemeKaydet()
    {
        if (kaydediliyor || cekmeceFisId is null) return;
        hata = null;
        // P-78: belirsiz/geçersiz sayı SESSİZCE 0/1 sayılıp gönderilmez.
        if (IlkSayiHatasi(DuzenlemeKalemli
                ? dKalemler.SelectMany(k => new[] { k.Adet, k.BirimFiyat, k.Iscilik })
                : [dTutar]) is { } sayiMesaji)
        {
            hata = sayiMesaji;
            return;
        }
        // PAKET GOC-A (envanter C · vz-d-fiyat "fiyatı silinen/eksi yazılan kalem UYARISIZ fişten silinir — küme sil+yaz"):
        // eksik/geçersiz satır artık düşürülmez; satır numarasıyla söylenir, PATCH yapılmaz.
        if (DuzenlemeKalemli && KalemSatirHatasi(dKalemler) is { } satirHatasi)
        {
            hata = satirHatasi;
            return;
        }
        kaydediliyor = true;
        try
        {
            var gecerli = dKalemler
                .Where(k => !string.IsNullOrWhiteSpace(k.UrunId) && (Sayi(k.BirimFiyat) ?? 0m) > 0m)
                .ToList();
            // PATCH sözleşmesi: gövdede YOKSA KORU. Kalemsiz fişte 'kalemler'
            // hiç gönderilmez (sunucu reddeder), kalemli fişte 'tutarTl'
            // gönderilmez — iki form aynı uca farklı ama TAM gövdeyle gider.
            var cevap = DuzenlemeKalemli
                ? await Api.PatchAsync($"/vezne/fisler/{cekmeceFisId}", new
                {
                    cariId = dCariId,
                    aciklama = string.IsNullOrWhiteSpace(dAciklama) ? null : dAciklama,
                    guncellendi = dDamga,
                    kalemler = gecerli.Select(k => new
                    {
                        urunId = k.UrunId,
                        adet = Sayi(k.Adet) ?? 1m,
                        birimFiyatTl = Sayi(k.BirimFiyat) ?? 0m,
                        iscilikTl = Sayi(k.Iscilik) ?? 0m,
                    }),
                })
                : await Api.PatchAsync($"/vezne/fisler/{cekmeceFisId}", new
                {
                    cariId = dCariId,
                    aciklama = string.IsNullOrWhiteSpace(dAciklama) ? null : dAciklama,
                    guncellendi = dDamga,
                    tutarTl = Sayi(dTutar) ?? 0m,
                });
            BasariGoster(Dil.T.Vezne.Guncellendi, cevap);
            cekmeceAcik = false;
            cekmeceFisId = null;
            await Yukle();
        }
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException) { hata = ex.Message; }
        kaydediliyor = false;
    }

