    // ── Ortak ───────────────────────────────────────────────────────────────

    /// <summary>UX-S27: sunucunun döndürdüğü sonuç başarı bandına YAZILIR.</summary>
    private void BasariGoster(string mesaj, System.Text.Json.JsonElement cevap,
        string alan = "id", string? etiket = null)
    {
        var ek = cevap.ValueKind == System.Text.Json.JsonValueKind.Object
                 && cevap.TryGetProperty(alan, out var o)
                 && o.ValueKind == System.Text.Json.JsonValueKind.String
            ? $" ({etiket ?? alan}: {o.GetString()})"
            : "";
        basari = mesaj + ek;
        basariJeton++;
    }

    // P-78: kullanıcı metni tr-TR TEK MERKEZDE çözülür ("1,5" = 1,5 · "45.000" = 45000).
    // Eski Invariant ayrıştırma "1,5"i 15, "45.000"i 45 okuyordu.
    private static decimal? Sayi(string? metin) => FormAlani.Ondalik(metin);

    /// <summary>TOPLU-1: Para girdisinin değeri kalem durumuna (metin) geri yazılır — ölçek KORUNUR
    /// ("1500,50" → 1500.50; Girdi kalıbı sondaki sıfırı atardı). Boş/geçersiz = "" (kalem hatası bunu yakalar).</summary>
    private static string ParaMetni(decimal? d) =>
        d is { } x ? x.ToString(System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) : "";

    /// <summary>P-78 — alan altı mesaj: boş/geçerli ise null; belirsiz/geçersiz ise Türkçe sebep.</summary>
    private string? SayiHatasi(string? metin) => FormAlani.SayiCoz(metin).Mesaj(Dil.Dil);

    /// <summary>P-78 — gönderimden önce: çözülemeyen ilk sayı alanının mesajı (sessiz 0/1 YASAK).</summary>
    private string? IlkSayiHatasi(IEnumerable<string?> metinler) =>
        metinler.Select(SayiHatasi).FirstOrDefault(m => m is not null);

