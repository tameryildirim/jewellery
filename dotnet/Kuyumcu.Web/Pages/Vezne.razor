    private void AdetDegisti(int sira, string? deger) { kalemler[sira].Adet = deger ?? ""; formKalemHatasi = null; }
    private void FiyatDegisti(int sira, string? deger) { kalemler[sira].BirimFiyat = deger ?? ""; formKalemHatasi = null; }
