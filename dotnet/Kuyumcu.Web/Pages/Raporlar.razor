    private (decimal Nakit, decimal KartHavale)? BugunAyrim(string paraBirimi) =>
        bugunAyrim is null ? null
        : (bugunAyrim.Where(a => a.ParaBirimi == paraBirimi).Sum(a => a.Nakit),
           bugunAyrim.Where(a => a.ParaBirimi == paraBirimi).Sum(a => a.Kart + a.Havale));
    private async Task BugunAyrimYukle()
    {
        try
        {
            await SubeliSorgu.HazirAsync(Oturum);
            bugunAyrim = await Api.GetAsync<List<Kuyumcu.Contracts.Sayfalar.Kasalar.KasaNakitAyrimiOzeti>>(SubeliSorgu.Ekle("/kasalar/nakit-ayrimi", Oturum));
        }
        catch (ApiHata ex) when (ex.StatusCode == 403) { _ = ex; }   // kasa yetkisi yok: alt satır çizilmez (kart yine durur); veri SİLİNMEZ
        catch (Exception ex) when (ex is ApiHata or JsonException) { bugunAyrimHata = ex.Message; }
        catch (Exception ex) when (AgHatasi(ex)) { bugunAyrimHata = ZB.BaglantiHatasi; }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// TOPLU-5 — BASİT gün sonu kırılımının parçaları: "Tahsilat X:" + SIFIR OLMAYAN kalemler (nakit · kart ·
    /// havale · diğer). Hepsi doluysa metin PARA-DEMO-2 TahsilatTekSatir kalıbıyla birebir aynıdır (PD2E_4; eski yöntem kaldırıldı); tutar/hesap DEĞİŞMEZ.
    /// </summary>
    private List<(string Ayrac, string Metin)> TahsilatParcalari(MutabakatTahsilat t)
    {
        var kalem = new List<string>(4);
        if (t.Nakit != 0m) kalem.Add(string.Format(T5.KirilimNakit, Bicim.TlKurus(t.Nakit)));
        if (t.Kart != 0m) kalem.Add(string.Format(T5.KirilimKart, Bicim.TlKurus(t.Kart)));
        if (t.Havale != 0m) kalem.Add(string.Format(T5.KirilimHavale, Bicim.TlKurus(t.Havale)));
        if (t.Diger != 0m) kalem.Add(string.Format(T5.KirilimDiger, Bicim.TlKurus(t.Diger)));
        var l = new List<(string, string)> { ("", $"{T5.GunSonuTahsilat} {Bicim.TlKurus(t.Toplam)}{(kalem.Count > 0 ? ":" : "")}") };
        for (var i = 0; i < kalem.Count; i++) l.Add((i == 0 ? " " : " · ", kalem[i]));
        // PAKET RAPOR-3 tur 2 (UX-S32): dövizli kasa girişi TL toplamına girmez — para birimiyle ayrı parça.
        foreach (var d in t.DovizGiris ?? [])
            l.Add((" · ", string.Format(KR.DovizGirisKisa, Bicim.BelgePara(d.Tutar, d.ParaBirimi))));
        return l;
    }

