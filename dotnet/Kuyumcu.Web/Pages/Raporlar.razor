            new("faturasiz", Dil.T.Mutabakat.Faturasiz, AdetTutar(m.Satis.FaturasizSayisi, m.Satis.FaturasizTl), m.Satis.FaturasizSayisi > 0 ? "satir-amber" : null),
            new("hurda", Dil.T.Mutabakat.Hurda, AdetTutar(m.Hurda.Sayisi, m.Hurda.OdenenTl), null),
            new("pusula", Dil.T.Mutabakat.Pusula, string.Format(DG.AdetTutar, m.Hurda.PusulaSayisi, Dil.T.Mutabakat.Stopaj + " " + Bicim.TlKurus(m.Hurda.StopajToplamTl)), null),
        };
