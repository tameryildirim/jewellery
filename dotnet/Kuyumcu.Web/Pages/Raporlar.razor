            l.Add(new("belgesiz", Dil.T.Mutabakat.BelgesizHurda, m.Hurda.BelgesizSayisi.ToString(CultureInfo.InvariantCulture), "satir-kirmizi"));
        if (m.FaturaEslesme is { } fe)
        {
            l.Add(new("bagli", Dil.T.SayfaDuzeltme.BagliFaturalar, AdetTutar(fe.BagliSayisi, fe.BagliTl), null));
            l.Add(new("bagsiz", DG.BagsizFaturaListe, AdetTutar(fe.BagimsizSayisi, fe.BagimsizTl), fe.BagimsizSayisi > 0 ? "satir-amber" : null));
        }
        return l;
