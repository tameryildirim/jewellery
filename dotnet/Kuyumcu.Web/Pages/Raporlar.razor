@page "/raporlar"
@using Kuyumcu.Core.Sozlesmeler
@using System.Globalization
@using Kuyumcu.Contracts.Sayfalar.Raporlar
@using Kuyumcu.Core.Domain.Girdi
@using Kuyumcu.Web.Bilesenler.Grid
@inject ApiIstemci Api
@inject UyumServisi Uyum
@inject NavigationManager Nav
@inject DilServisi Dil
@inject RaporServisi RaporSetiServisi
@inject ArayuzModuServisi Mod
@inject OturumServisi Oturum
@using PanelSz = Kuyumcu.Contracts.Sayfalar.Panel
@using BildirimSz = Kuyumcu.Contracts.Sayfalar.Bildirimler
@implements IDisposable

@* Kaynak: apps/web/src/pages/RaporPage.tsx — aylık özet + günlük satış/alış grafiği,
   stok dağılımı pastası, cari yaşlandırma ve stok değeri tabloları.
   Veri (Nest şekilleri, rapor.service.ts):
   • GET /raporlar/aylik?yil=&ay=  → { satis:{sayisi,toplamTl,toplamHas}, alis:{...}, karTl, gunler? }
   • GET /raporlar/cari-yaslandirma → { yaslananCariler:[{cariAd,tlBakiye,dilim,...}], ozetTl }
   • GET /raporlar/stok-degeri      → { urunler:[{ad,ayarId,adet,toplamHas,...}], toplamHas } *@

<PageTitle>@Marka.SayfaBasligi(Dil.T.Rapor.Baslik)</PageTitle>

<div class="dikey-bosluk">
@* ═══ PAKET S3-4 — İKİ YÜZ, TEK GÖVDE (PLAN § 5, S-3 "Raporlar (basit)") ═══
   BASİT  → "Bugün" tek sayfa: sattım · aldım · altın pozisyonu · kasa ·
            bekleyen iş · gün sonu (FARK VAR ise düzeltme yoluna bağlantı).
   PROFESYONEL → aşağıdaki rapor merkezi ve bütün kartlar AYNEN (DOM id'leri
            DEĞİŞMEDİ; yalnız #raporlar-pro sarmalayıcısı EKLENDİ).
   Özellik silinmez: basit modda gizlenen kartlar "pro" durumundadır ve
   ekrandaki not + Görünüm bağlantısı bunu söyler. Mod YETKİ DEĞİLDİR. *@
@if (Mod.BasitMi)
{
    @BugunYuzu
}
else
{
<div class="dikey-bosluk" id="raporlar-pro">
    @* UX-1-C3: sayfa başı — dönem seçicisi araç çubuğu yuvasına taşındı,
       seçicilerin kendi DOM'u ve aria etiketleri DEĞİŞMEDİ. *@
    @* ZO-BELGE 29.09 devam 9 (tasarım hakemi k3 KRİTİK · K17 "açıklama metni satırı 0"): başlık altındaki
       açıklama satırı kaldırıldı — tuvalde (Profesyonel.png) başlık tek başına durur. *@
    <SayfaBasi Anahtar="raporlar" Baslik="@Dil.T.Rapor.Baslik">
        <Filtreler>
            @* ZO-BELGE (1440 ölçümü: yerel <select> 2 adet): Yıl/Ay ortak Secici'ye geçti —
               açılır liste tema belirteçleriyle çizilir (kurucu 12:20 "native select"). *@
            <Secici ElemanId="rp-yil" Etiket="@ZB.RaporYil" Secenekler="@YilSecenekleri"
                    Deger="@yil.ToString(CultureInfo.InvariantCulture)" DegerChanged="YilDegisti" />
            <Secici ElemanId="rp-ay" Etiket="@ZB.RaporAy" Secenekler="@AySecenekleri"
                    Deger="@ay.ToString(CultureInfo.InvariantCulture)" DegerChanged="AyDegisti" />
        </Filtreler>
        <Eylem>
            @* Tek birincil eylem: kârın TEK yetkili kaynağı olan ekran. *@
            <button class="dugme dugme-birincil dugme-kucuk" id="rp-kar-zarar"
                    @onclick="@(() => Nav.NavigateTo("/raporlar/kar-zarar"))">
                @KR.KarZararDugme@* RAPOR-3: menüdeki yazımla aynı ("Kâr-zarar") *@
            </button>
        </Eylem>
    </SayfaBasi>
    @* ŞUBE-KAPSAM-B: aylık, satış kırılımı, stok değeri ve reyon stoku seçili şubeye göre. *@
    <GorunumRozeti Degisti="GorunumDegisti" />

    <HataBandi Mesaj="@hata" />

    @* ── PAKET KAT-1 (kurucu 24.09: "tren gibi aşağı gidiyor, tab tab ayır") ──
       Profesyonel yüz 8 bölümle 7,1 ekran boyundaydı (1280 px, ölçüldü). Bölümler
       ALTI sekmeye TAŞINDI; hiçbiri silinmedi, id'ler aynı (S1-h Sekmeler: tüm
       paneller çizilir, seçili olmayan `hidden`). Rapor merkezinden gelen
       "/raporlar" kartı ilgili sekmeyi açar (KartRotasi). *@
    <Sekmeler Onek="rp" Liste="@RpSekmeleri" Etiket="@KT.RaporSekmeSerit">
        <Panel Context="rpKod">
            @if (rpKod == "ozet")
            {
            @* ═══ PAKET 34 Faz A — RAPOR MERKEZİ ═══════════════════════════════════
               19'a giden rapor setinin TEK sayım kaynağı sunucudaki katalogtur; bu
               ızgara onu çizer. Menüye altı yeni bağlantı eklemek REDDEDİLDİ.
               ⚠ Mehmet K34-5: yetkisiz rapor GİZLENİR, "yetkin yok" rozetiyle
                 gösterilmez (rol matrisi sızıntısı); sunucu son sözü söyler ve
                 katalog zaten yalnız erişilebilen rolleri görene döner. *@
            @* ── Aylık özetler ── *@
            @if (aylikYukleniyor)
            {
                <Yukleniyor />
            }
            else
            {
                @* ═══ UX-4d devri (madde 12 + 21) — EKRAN TARAFI ═══════════════════
                   Sunucu üç yeni alanı döndürüyordu, ekran çizmiyordu; QA turu 2'nin
                   gördüğü üç çelişki (aylık has < günlük has, aynı ay iki farklı kâr,
                   veresiye kartta yok) bu yüzden ekranda sürüyordu.
                     • karTl artık TEK kaynaktan (KarZararServisi) gelir ve kaynağı
                       rozetle yazılır; hesaplanamadıysa rakam UYDURULMAZ.
                     • "satış − alış" ayrı bir kart olarak ve KENDİ ADIYLA gösterilir.
                     • net has, dönemin TÜM hareketlerinin has toplamıdır; etiketi ve
                       formülü ekranda yazar (stok hası DEĞİLDİR).
                   ══════════════════════════════════════════════════════════════════ *@
                @* ZO-BELGE 29.09 devam 6 (tasarım hakemi YÜKSEK): "Kâr (satış − alış)" ile "Bu bir KÂR
                   değildir" kartları yan yana AYNI rakamı gösteriyordu. Artık: Kâr TEK kaynaktan
                   (KarZararServisi) ve tek adla ("Kâr"); satış − alış farkı kârla AYNIYSA ayrı kart
                   çizilmez (ipucu bunu söyler), FARKLIYSA kendi adıyla ayrı kartta kalır. Paragraf
                   açıklamalar (i) ipucunda — kart boyları eşit (zo-stat-izgara). *@
                <div class="stat-izgara zo-stat-izgara" id="rp-ozet-kartlar">
                    <StatKart Renk="yesil" Etiket="@Dil.T.Rapor.AylikSatis" Deger="@Bicim.TlKurus(AylikSatisGosterTl)" Alt="@AylikIadeAlt" />
                    <StatKart Etiket="@Dil.T.Rapor.AylikAlis" Deger="@Bicim.TlKurus(AlisTl)" />
                    @* PAKET KAR-RAPOR: maliyeti bilinmeyen satış kâra girmez; hiçbiri bilinmiyorsa
                       kâr "Hesaplanamadı" yazar — satış tutarı kâr diye BASILMAZ (fail-closed). *@
                    @IpucuKart("rp-kar", ZB.RaporKar, KarTl is { } k ? Bicim.TlKurus(k) : (KarEksikSatis + KarEksikIade > 0 ? KR.KarHesaplanamadi : "—"),
                        KarTl is null ? "" : KarTl >= 0 ? "yesil" : "kirmizi",
                        KarFarklaAyni ? $"{KarKaynagiMetni}. {ZB.RaporKarAyni}" : KarKaynagiMetni,
                        KarKismi ? KR.KarKismiNotu : null)
                    @if (!KarFarklaAyni)
                    {
                        @* PAKET RAPOR-4 (YÜKSEK): fark NET satıştan (Panel "Günün nakit akışı" ile tek tanım); alt satır formülü yazar. *@
                        @IpucuKart("rp-fark", Dil.T.SayfaDuzeltme.SatisAlisFarki, Bicim.TlKurus(SatisAlisFarki), "",
                            KR.NakitFarkiAciklama, KR.NakitFarkiAlt)
                    }
                    @* P-69: altın dışı maden varken kart "Has (altın)" der — sayı yalnız altındır. *@
                    @IpucuKart("rp-nethas", NetHasEtiketi, Bicim.Has(NetHas), "mavi", Dil.T.SayfaDuzeltme.NetHasAciklama)
                    @* PAKET RAPOR-3 (hasım VERİ): tahsilat Gün sonu ile AYNI tanım (açılış devri + virman girmez) — ⓘ söyler. *@
                    @IpucuKart("rp-tahsilat", Dil.T.SayfaDuzeltme.TahsilatToplam, Bicim.TlKurus(TahsilatTl), "", KR.TahsilatKapsamIpucu)
                    <StatKart Renk="@(VeresiyeTl > 0 ? "amber" : null)"
                              Etiket="@Dil.T.SayfaDuzeltme.Veresiye" Deger="@Bicim.TlKurus(VeresiyeTl)" />
                </div>
                @* PAKET KAR-RAPOR (UX-S23): maliyeti eksik satışlar AYRI satırda, adet + tutar;
                   sayı kâr-zarar ekranına giden bağlantıdır. *@
                @* MADEN-2 (hasım DÜŞÜK): maliyeti eksik İADE de bantta anılır ("2 satış ve 1 iade");
                   iade varken net tutar eksiye dönebildiği için tutar yalnız iadesiz durumda yazılır. *@
                @if (KarEksikSatis > 0 || KarEksikIade > 0)
                {
                    <p class="uyari-metni metin-kucuk" id="rp-kar-eksik">
                        <span id="rp-kar-eksik-metin">@(KarEksikIade == 0
                            ? string.Format(KR.MaliyetiEksikSatir, KarEksikSatis, Bicim.TlKurus(aylik?.MaliyetiEksikTutarTl ?? 0m))
                            : string.Format(KR.MaliyetiEksikGenel, KarRaporSozlugu.EksikSayi(KR, KarEksikSatis, KarEksikIade)))</span>
                        <span class="metin-soluk" aria-hidden="true"> · </span>
                        <a href="/raporlar/kar-zarar" id="rp-kar-eksik-git">@KR.MaliyetiEksikDetay →</a>
                    </p>
                }
            }

            @* ZO-BELGE (27.09, 1440 ölçümü: Özet sekmesi 1,86 ekran): rapor merkezi
               ızgarası (16 düğme, 484 px) KAPALI "Tüm raporlar" katlanırına taşındı —
               raporların hepsi menüde ve sekmelerde de var; katlanır başlığı SAYIYI
               yazar (sessiz gizleme yok). Hata varsa katlanır AÇIK doğar (UX-S28).
               İç kimlik #rapor-merkezi ve rm-* düğme id'leri AYNI. *@
            <Katlanir Id="rp-tum-raporlar" Baslik="@ZB.RaporTumRaporlar" Sayi="@(katalogHatasi is null ? katalog.Count : null)"
                      BaslangictaAcik="@(katalogHatasi is not null)" @key="@(katalogHatasi is null ? "rm" : "rm-hata")"
                      Sinif="zo-rapor-merkezi">
            <div id="rapor-merkezi">
                <HataBandi Mesaj="@katalogHatasi" Id="rapor-merkezi-hata" />
                @if (katalog.Count == 0 && katalogHatasi is null)
                {
                    <BosDurum Mesaj="@Dil.T.RaporSeti.BosDurum" />
                }
                else
                {
                    @foreach (var grup in katalog.GroupBy(r => r.Grup))
                    {
                        <div class="zo-rm-grup">
                            <h4 class="zo-rm-grup-ad">@Dil.T.RaporSeti.Grup(grup.Key)</h4>
                            <div class="zo-rm-dugmeler">
                                @foreach (var kart in grup)
                                {
                                    @* DoD: her düğme GERÇEK bir rotaya gider. *@
                                    <button @onclick="@(() => Nav.NavigateTo(KartRotasi(kart.Kod, kart.Rota)))"
                                            class="dugme dugme-ikincil dugme-kucuk" id="@($"rm-{kart.Kod.ToLowerInvariant()}")">
                                        @KatalogDugmeAdi(kart.Kod)
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
            </Katlanir>

            @* ── PAKET G-5 (B-4 devri) — SATIŞLAR NEYLE ÖDENDİ ─────────────────────────
                 Kaynak: GET /raporlar/odeme-araci → satisKirilimi (fişin ödeme kalemleri).
                 Eski altın (ALTIN bacağı) kasaya girmez; ayrı satırda "Eski altın
                 (mahsup)" adıyla görünür ve "Kasaya giren" kartına KATILMAZ. Bütün
                 toplamlar SUNUCUDAN gelir (UX-S21); ham araç kodu basılmaz (UX-S31).
                 Hata boş duruma çevrilmez (UX-S28). ── *@
            @* ZO-BELGE (27.09): kırılım KAPALI katlanırda (kök id sk-kart AYNI); başlık
               fiş sayısını yazar. Hata varsa katlanır AÇIK doğar — hata kapalı kartın
               arkasına saklanmaz (UX-S28). *@
            <Katlanir Id="sk-kart" Baslik="@SK.Baslik" Sayi="@(skHata is null && satisKirilimi is { } skS ? skS.FisAdet : null)"
                      BaslangictaAcik="@(skHata is not null)" @key="@(skHata is null ? "sk" : "sk-hata")"
                      Sinif="zo-sk">
                <div class="zo-katlanir-ic">
                    <p class="metin-soluk metin-kucuk">@SK.Aciklama <span class="rozet rozet-gri" id="sk-kaynak">@SK.SunucuHesabi</span></p>
                    <HataBandi Mesaj="@skHata" />
                    @if (skYukleniyor)
                    {
                        <Yukleniyor />
                    }
                    else if (skHata is null && satisKirilimi is { } sk)
                    {
                        @if ((sk.Satirlar?.Count ?? 0) == 0)
                        {
                            <BosDurum Mesaj="@SK.SatisYok" />
                        }
                        else
                        {
                            <div class="stat-izgara" id="sk-ozet">
                                <StatKart Renk="yesil" Etiket="@SK.BrutSatis" Deger="@Bicim.BelgePara(sk.BrutSatisTl, "TRY")"
                                          Alt="@SK.BrutSatisAlt" />
                                <StatKart Etiket="@SK.KasayaGiren" Deger="@Bicim.BelgePara(sk.KasayaGirenTl, "TRY")"
                                          Alt="@SK.KasayaGirenAlt" />
                                @if (sk.MahsupAltinTl > 0m)
                                {
                                    <StatKart Renk="amber" Etiket="@SK.EskiAltinMahsup"
                                              Deger="@Bicim.BelgePara(sk.MahsupAltinTl, "TRY")" Alt="@SK.EskiAltinNotu" />
                                }
                            </div>
                            @* PAKET GOC-D — ortak ızgara (grid:raporlar:sk-tablo): tablo ve satır id'leri (sk-satir-*) AYNI.
                               Toplam satırı (eski tfoot) ızgaranın hemen altında AYNI kimlikle (#sk-toplam): ortak ızgarada
                               alt toplam şablonu yok; sıralama tercihi toplam satırını yerinden oynatmasın diye ayrı. *@
                            <Izgara T="SatisKirilimiSatiri" Ekran="raporlar" GridId="sk-tablo" TabloId="sk-tablo"
                                    Kolonlar="@SkKolonlari" Ogeler="@IzgaraYerelSiralama.Uygula(sk.Satirlar!, skSira, SkKolonlari)"
                                    SatirId="@(x => $"sk-satir-{x.Arac.ToLowerInvariant()}")" Baslik="@SK.Arac"
                                    SiralamaDegisti="@(x => skSira = x)" GecerliSiralama="@skSira" />
                            <p class="satir-arasi izgara-alt-toplam" id="sk-alt-toplam">
                                <span class="hucre-vurgu">@SK.BrutSatis</span>
                                <span><span class="sayi hucre-vurgu" id="sk-toplam">@Bicim.BelgePara(sk.KirilimToplamTl, "TRY")</span>
                                    <span class="metin-soluk metin-kucuk"> · @SK.FisSayisi: <span class="sayi" id="sk-toplam-fis">@sk.FisAdet</span></span></span>
                            </p>
                            @if (sk.KalemsizFisAdet > 0)
                            {
                                <p class="metin-soluk metin-kucuk" id="sk-kayitsiz">@string.Format(SK.KayitsizNotu, sk.KalemsizFisAdet)</p>
                            }
                            @if (sk.FarkTl != 0m)
                            {
                                <div class="bant bant-uyari" role="status" id="sk-fark">
                                    @string.Format(SK.FarkUyari, Bicim.BelgePara(sk.FarkTl, "TRY"))
                                </div>
                            }
                        }
                    }
                </div>
            </Katlanir>

            @* ── PAKET 20 — MADEN DAĞILIMI ────────────────────────────────────────────
                 Yukarıdaki "net has" ALTIN has gramıdır. Dönemde başka maden de
                 hareket gördüyse bu tablo onları AYRI satırlarda gösterir ve uyarı
                 ekranda GÖRÜNÜR olur (K20-3 · UX-S31). ── *@
            @if (MadenDagilimi.Count > 0)
            {
                @* ZO-BELGE (27.09): maden tablosu KAPALI katlanırda (kök id AYNI); başlık
                   maden sayısını yazar. "Has (altın)" kartının etiketi zaten yalnız altın
                   saydığını söyler; ayrıntı ve uyarı katlanır açılınca aynen görünür. *@
                <Katlanir Id="rapor-maden-dagilimi" Baslik="@Dil.T.Urun.MadenDagilimi" Sayi="@MadenDagilimi.Count"
                          Sinif="zo-maden">
                    @* PAKET GOC-D — ortak ızgara (grid:raporlar:rapor-maden); has başlığının id'si AYNI. *@
                    <Izgara T="Kuyumcu.Core.Sozlesmeler.MadenDagilimSatiri" Ekran="raporlar" GridId="rapor-maden"
                            Kolonlar="@MadenKolonlari" Ogeler="@IzgaraYerelSiralama.Uygula(MadenDagilimi, madenSira, MadenKolonlari)"
                            Baslik="@Dil.T.Urun.MadenDagilimi"
                            SiralamaDegisti="@(x => madenSira = x)" GecerliSiralama="@madenSira" />
                    <p class="metin-soluk metin-kucuk" id="rapor-maden-uyari">
                        @* P-69: sunucunun uyarısı ham alan adı (`toplamHas`) taşır ve yalnız
                           Türkçedir (UX-S31); ekran aynı anlamı sözlükten, iki dilde basar. *@
                        @H.MadenUyarisi
                    </p>
                </Katlanir>
            }
            }
            else if (rpKod == "grafik")
            {
            @* ── Grafikler: günlük çubuk + stok pastası ── *@
            @if (CubukNoktalari.Count > 0 || StokPasta.Count > 0)
            {
                <div class="zo-rp-grafik">
                    @if (CubukNoktalari.Count > 0)
                    {
                        <div class="kart zo-rp-grafik-kart">
                            <div class="kart-baslik">
                                <h2>@Dil.T.Rapor.GunlukSatisAlis</h2>
                            </div>
                            <div class="kart-govde">
                                @* PAKET RAPOR-4 (tasarım YÜKSEK): tarih ekseni eziliyordu, değer ekseni ve renk açıklaması yoktu →
                                   solda değer ekseni (tutar), altta seyrek tarih ekseni, altta Satış/Alış lejantı. *@
                                <CubukGrafik Noktalar="CubukNoktalari" Aciklama="@Dil.T.Rapor.GunlukSatisAlis"
                                             Seri1Adi="@GrafikSatisLejanti" Seri2Adi="@KR.GrafikAlis"
                                             DegerEkseni="@Bicim.Tl" EksenOnEki="rp-grafik" />
                            </div>
                        </div>
                    }
                    @if (StokPasta.Count > 0)
                    {
                        <div class="kart zo-rp-grafik-kart">
                            <div class="kart-baslik">
                                <h2>@Dil.T.Rapor.StokDagilimi</h2>
                            </div>
                            <div class="kart-govde">
                                <PastaGrafik Noktalar="StokPasta" Aciklama="@Dil.T.Rapor.StokDagilimi" />
                            </div>
                        </div>
                    }
                </div>
            }
            }
            else if (rpKod == "cari")
            {
            @* ŞUBE-KAPSAM-B tur 2: cari yaşlandırma şubeye BÖLÜNMEZ (müşteri hesabı kiracı
               geneli) — sayfa rozeti şube derken sekme bunu kendisi söyler. *@
            <GorunumRozeti KiraciGeneli="true" Id="yas-kapsam-rozeti" />
            @* ── Cari yaşlandırma ──
               P-47 (tur 8 triyajı, KRİTİK): has bakiyesi bu tabloda HİÇ görünmüyordu —
               TL'si 0 olan cari "0,00 ₺" satırı olarak okunuyor, 16,946 g alacak
               saklanıyordu. Has kolonu AYRI durur, TL'ye ÇEVRİLMEZ, TL toplamına KARIŞMAZ. *@
            @if (GorunenYaslananlar.Count > 0)
            {
                <div class="kart" id="yas-kart">
                    <div class="kart-baslik">
                        <h2>@Dil.T.Rapor.CariYaslandirma</h2>
                    </div>
                    @if (yaslandirmaDahaFazlasiVar)
                    {
                        <p class="uyari-metni" id="yas-sinir">@string.Format(Dil.T.Rapor.YasSinirUyari, yaslananlar.Count, yaslandirmaToplamSatir)</p>
                    }
                    @* TOPLU-3 (RAPOR-YASLANDIRMA tasarım hakemi YÜKSEK/ORTA) — YALNIZ GÖRÜNÜM; rapor hesabı,
                       dilim ve toplam kuralları DEĞİŞMEDİ (Dilim/DilimToplami/YasTlToplami aynı):
                       • sıfır hücre "—" (CSS ::before); sayı metni "0 ₺" ekran okuyucu için DOM'da kalır (yas-deger);
                       • sayı sütunlarına ≥ 16 px yatay dolgu (toplu3.css);
                       • "Tarihsiz" açıklaması tablo altı paragrafı DEĞİL, başlığın yanında dokunmatikte açılan (i);
                       • döviz özeti tablo altı paragrafı DEĞİL, tfoot satırı + yönlü rozet ("Bize borçlu 120,00 £");
                       • ≤ 640 px: satır kartı (ad + yalnız dolu dilim + toplam) — data-etiket hücre adını yazar. *@
                    <KartListe Id="yas" Baslik="@Dil.T.Rapor.CariYaslandirma" Sinif="yas-kartliste">
                        <table class="veri-tablosu @(YasHasVar ? null : "yas-has-bos")" id="yas-tablo">
                            <thead>
                                <tr>
                                    <th scope="col">@Dil.T.Rapor.CariBasligi</th>
                                    <th scope="col" class="sayi">@Dil.T.Rapor.Gun_0_30</th>
                                    <th scope="col" class="sayi">@Dil.T.Rapor.Gun_31_60</th>
                                    <th scope="col" class="sayi">@Dil.T.Rapor.Gun_61_90</th>
                                    <th scope="col" class="sayi">@Dil.T.Rapor.Gun_90_plus</th>
                                    @* RAPOR-YASLANDIRMA: açılış devri ayrı dilim — yalnız böyle satır varsa (zorunlu önce). *@
                                    @if (YasBelirsizVar)
                                    {
                                        <th scope="col" class="sayi yas-belirsiz-th">
                                            <span id="yas-belirsiz-baslik" title="@RY.BelirsizIpucu">@RY.BelirsizBaslik</span>
                                            <details class="zo-ipucu yas-ipucu" id="yas-belirsiz-ipucu">
                                                <summary aria-label="@($"{T3.YasIpucuAc}: {RY.BelirsizBaslik}")">i</summary>
                                                <p id="yas-belirsiz-notu">@RY.BelirsizNotu</p>
                                            </details>
                                        </th>
                                    }
                                    <th scope="col" class="sayi">@Dil.T.Rapor.YasToplamTl</th>
                                    <th scope="col" class="sayi" id="yas-has-baslik">@Dil.T.Rapor.YasHasBakiye</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var y in GorunenYaslananlar)
                                {
                                    <tr class="@(YalnizHasBakiyesi(y) ? "satir-vurgu" : null)" id="@($"yas-satir-{y.CariId}")">
                                        <td class="hucre-vurgu yas-ad">
                                            @y.CariAd
                                            @if (YalnizHasBakiyesi(y))
                                            {
                                                <Rozet Renk="amber">@Dil.T.Rapor.YasHasBakiyeVar</Rozet>
                                            }
                                            @if (y.Dilim == "BELIRSIZ" && y.BelirsizNedeni == "ACILIS")
                                            {
                                                <span class="yas-acilis" id="@($"yas-acilis-{y.CariId}")" title="@RY.AcilisIpucu"><Rozet Renk="gri">@RY.AcilisRozet</Rozet></span>
                                            }
                                            else if (y.Dilim == "BELIRSIZ")
                                            {
                                                <span class="yas-acilis" id="@($"yas-tarihyok-{y.CariId}")" title="@RY.TarihYokIpucu"><Rozet Renk="gri">@RY.TarihYokRozet</Rozet></span>
                                            }
                                            else if (y.AcilisDahil)
                                            {
                                                <span class="yas-acilis" id="@($"yas-acilis-{y.CariId}")" title="@RY.AcilisDahilIpucu"><Rozet Renk="amber">@RY.AcilisDahilRozet</Rozet></span>
                                            }
                                            @* Faz A: döviz borcunun vadesi YOK — gizlemek yerine SÖYLENİR. TOPLU-3: rozet YÖN taşır. *@
                                            @if (y.DovizBakiyesiVar)
                                            {
                                                <span class="yas-doviz" id="@($"yas-doviz-{y.CariId}")" title="@RY.DovizSatirIpucu"><Rozet Renk="amber">@DovizYonMetni(y.DovizBakiyeleri, T3)</Rozet></span>
                                            }
                                        </td>
                                        @YasTlHucre("yas-0-30", Dil.T.Rapor.Gun_0_30, Dilim(y, "0-30"))
                                        @YasTlHucre("yas-31-60", Dil.T.Rapor.Gun_31_60, Dilim(y, "31-60"))
                                        @YasTlHucre("yas-61-90", Dil.T.Rapor.Gun_61_90, Dilim(y, "61-90"))
                                        @YasTlHucre("yas-90-usta", Dil.T.Rapor.Gun_90_plus, Dilim(y, "90+"))
                                        @if (YasBelirsizVar)
                                        {
                                            @YasTlHucre("yas-belirsiz", RY.BelirsizBaslik, Dilim(y, "BELIRSIZ"))
                                        }
                                        @YasTlHucre("hucre-vurgu yas-toplam-tl", Dil.T.Rapor.YasToplamTl, y.TlBakiye)
                                        @* İşaret kuralı TL ile aynı (Cariler.razor): artı = cari bize borçlu. *@
                                        <td class="sayi hucre-vurgu yas-has @(y.HasGramBakiye < 0 ? "metin-kirmizi" : null) @(y.HasGramBakiye == 0m ? "yas-sifir" : null)"
                                            data-etiket="@Dil.T.Rapor.YasHasBakiye"><span class="yas-deger">@Bicim.Has(y.HasGramBakiye)</span></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr id="yas-alt-toplam">
                                    <th scope="row">@Dil.T.Rapor.YasListelenenToplam</th>
                                    @YasTlHucre("yas-0-30", Dil.T.Rapor.Gun_0_30, DilimToplami("0-30"))
                                    @YasTlHucre("yas-31-60", Dil.T.Rapor.Gun_31_60, DilimToplami("31-60"))
                                    @YasTlHucre("yas-61-90", Dil.T.Rapor.Gun_61_90, DilimToplami("61-90"))
                                    @YasTlHucre("yas-90-usta", Dil.T.Rapor.Gun_90_plus, DilimToplami("90+"))
                                    @if (YasBelirsizVar)
                                    {
                                        @YasTlHucre("yas-belirsiz", RY.BelirsizBaslik, DilimToplami("BELIRSIZ"), "yas-toplam-belirsiz")
                                    }
                                    @YasTlHucre("hucre-vurgu", Dil.T.Rapor.YasToplamTl, YasTlToplami, "yas-toplam-tl")
                                    <td class="sayi hucre-vurgu @(YasHasToplami == 0m ? "yas-sifir" : null)" id="yas-toplam-has"
                                        data-etiket="@Dil.T.Rapor.YasHasBakiye"><span class="yas-deger">@Bicim.Has(YasHasToplami)</span></td>
                                </tr>
                                @if (YasDovizOzeti.Count > 0)
                                {
                                    @* Döviz özeti tablonun SON satırıdır (paragraf değil); tutar yönüyle yazılır,
                                       açıklama (i) içinde — ipucu yalnız title'da kalmaz (dokunmatik). *@
                                    <tr id="yas-doviz-ozet" class="yas-doviz-satir">
                                        <th scope="row">
                                            <span>@T3.YasDovizOzetKisa</span>
                                            <details class="zo-ipucu yas-ipucu" id="yas-doviz-ipucu">
                                                <summary aria-label="@($"{T3.YasIpucuAc}: {T3.YasDovizOzetKisa}")">i</summary>
                                                <p>@RY.DovizSatirIpucu</p>
                                            </details>
                                        </th>
                                        <td class="yas-doviz-ozet-hucre" colspan="@(YasKolonSayisi - 1)">
                                            @foreach (var kv in YasDovizOzeti)
                                            {
                                                <Rozet Renk="amber">@DovizYonMetni(new Dictionary<string, decimal> { [kv.Key] = kv.Value }, T3)</Rozet>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tfoot>
                        </table>
                    </KartListe>
                    @* TOPLU-4 (TOPLU-3 hakem ORTA): tablo altı açıklama PARAGRAFI kalktı — has notu tek kısa satır + ⓘ
                       (metin ve id AYNI; has sütunu boşken satır yine gizlenir, toplu3.css T3-…). *@
                    <div class="metin-soluk yas-not t4-ipucu-satir" id="yas-has-not-satir">
                        <span>@Toplu4Sozlugu.Al(Dil.Dil).YasHasNotKisa</span>
                        <details class="zo-ipucu" id="yas-has-ipucu">
                            <summary aria-label="@($"{T3.YasIpucuAc}: {Toplu4Sozlugu.Al(Dil.Dil).YasHasNotKisa}")">i</summary>
                            <p id="yas-has-notu">@Dil.T.Rapor.YasHasNotu</p>
                        </details>
                    </div>
                </div>
            }
            }
            else if (rpKod == "stok")
            {
            @* ── Stok değeri ── *@
            @if (stokUrunleri.Count > 0)
            {
                <div class="kart">
                    <div class="kart-baslik">
                        <h2>@Dil.T.Rapor.StokDegeri</h2>
                    </div>
                    @* RAPOR-GORUNUM (375 ölçümü: değer sütunu ekran dışındaydı): dar ekranda satır KART YIĞINI
                       (ortak q10-yigin kalıbı; her değerin solunda data-etiket başlığı). Sıra: madene göre (altın önce),
                       maden içinde miktara göre — altın has ile gümüş gramı tek sayı gibi sıralanmaz. *@
                    @* PAKET GOC-D — ortak ızgara (grid:raporlar:rapor-stok): tablo id'si, sınıfları ve has başlığının id'si AYNI.
                       Altın / diğer maden toplamları (eski tfoot) ızgaranın altında AYNI kimliklerle — her maden kendi
                       biriminde, altın has'a karışmaz (MADEN-2); sıralama tercihi toplamları yerinden oynatmaz. *@
                    <Izgara T="StokUrun" Ekran="raporlar" GridId="rapor-stok" TabloId="rapor-stok-tablo" TabloSinif="q10-yigin rg-rapor-tablo"
                            Kolonlar="@StokKolonlari" Ogeler="@IzgaraYerelSiralama.Uygula([.. StokSatirlari], stokSira, StokKolonlari)"
                            Baslik="@Dil.T.Rapor.StokDegeri"
                            SiralamaDegisti="@(x => stokSira = x)" GecerliSiralama="@stokSira" />
                    @if (stokUrunleri.Any(u => MadenAltinMi(u.Maden)) || StokDigerMadenToplamlari.Count > 0)
                    {
                        <div class="izgara-alt-toplam" id="rapor-stok-toplamlar">
                            @if (stokUrunleri.Any(u => MadenAltinMi(u.Maden)))
                            {
                                <p class="satir-arasi" id="rapor-stok-altin-toplam">
                                    <span class="izgara-alt-toplam-ad">@KR.StokAltinHas</span>
                                    <span class="sayi hucre-vurgu izgara-alt-toplam-deger">@Bicim.Has(stokToplamHas)</span>
                                </p>
                            }
                            @foreach (var md in StokDigerMadenToplamlari)
                            {
                                <p class="satir-arasi" id="@($"rapor-stok-toplam-{md.Maden.ToLowerInvariant()}")">
                                    <span class="izgara-alt-toplam-ad">@string.Format(KR.StokMadenToplam, KurKaynakAdi.MadenAdi(md.Maden, md.MadenAdi) ?? md.Maden)</span>
                                    <span class="sayi hucre-vurgu izgara-alt-toplam-deger">@MadenTamMiktari(md.Maden, md.ToplamGram, md.FizikselGram)</span>
                                </p>
                            }
                        </div>
                    }
                </div>
            }

            @* ── REYON STOK RAPORU (PAKET 25) ───────────────────────────────────────
               Madenler AYRI toplanır (StokDegeri'nin 2026-09-14 kararı) ve ATANMAMIŞ
               mal ayrı bir kartta gösterilir — gizlenmez. *@
            <div class="kart" id="reyon-stok-kart">
                <div class="kart-baslik satir-arasi">
                    <h2>@Dil.T.Yerlesim.ReyonStokRaporu</h2>
                </div>
                <div class="kart-govde">
                    @* ZO-BELGE 28.09 (375 ölçümü: bu karttaki iki yerel <select> aynı ekrandaki
                       Yıl/Ay Secici'sinden farklı çiziliyordu) → ortak Secici, id'ler aynı.
                       UX-S22: tek şubede şube seçicisi, reyon yokken reyon seçicisi çizilmez
                       ("Tümü" ile tek seçenek aynı cevaptır). *@
                    @* ŞUBE-KAPSAM-B tur 3 (doğrulayıcı YÜKSEK): bu kartın kendi şube kutusu
                       sayfa rozetinden BAŞKA bir şubeye çevrildiyse kart kendi rozetini
                       taşır — tablonun gerçekten süzüldüğü şubeyi yazar (ikili kaynak yok). *@
                    @if (RsSubeFarkli)
                    {
                        <GorunumRozeti Id="rs-kapsam-rozeti" SuzgecKullan="true" SuzgecSubeId="@rsSubeId" />
                    }
                    @if (rsSubeler.Count > 1 || RsReyonSecenekleri.Count > 0)
                    {
                        <div class="form-grid-2">
                            @if (rsSubeler.Count > 1)
                            {
                                <Secici ElemanId="rs-sube" Etiket="@Dil.T.UrunAgaci.Sube" Secenekler="@RsSubeSecenekleri"
                                        BosSecenekMetni="@Dil.T.Ortak.Tumu" Deger="@rsSubeId" DegerChanged="RsSubeDegisti" />
                            }
                            @if (RsReyonSecenekleri.Count > 0)
                            {
                                <Secici ElemanId="rs-reyon" Etiket="@Dil.T.Yerlesim.Reyon" Secenekler="@RsReyonSecenekleri"
                                        BosSecenekMetni="@Dil.T.Ortak.Tumu" Deger="@rsReyonId" DegerChanged="RsReyonDegisti" />
                            }
                        </div>
                    }

                    @if (rsHata is not null)
                    {
                        <HataBandi Mesaj="@rsHata" Id="reyon-stok-hata" />
                    }
                    else if (reyonStok is null)
                    {
                        <Yukleniyor />
                    }
                    else if ((reyonStok.Reyonlar?.Count ?? 0) == 0 && (reyonStok.Atanmamis?.Count ?? 0) == 0)
                    {
                        <div id="reyon-stok-bos"><BosDurum Mesaj="@ZB.ReyonStokBos" /></div>
                    }
                    else
                    {
                        @* PAKET RAPOR-2 (K17): not ekranda düz satırdı → ⓘ arkasında (metin ve id AYNI). *@
                        <div class="metin-soluk t4-ipucu-satir" id="reyon-stok-not-satir">
                            <span>@KR.NasilHesaplanirAc</span>
                            <details class="zo-ipucu" id="reyon-stok-not-ipucu">
                                <summary aria-label="@KR.NasilHesaplanirAc">i</summary>
                                <p id="reyon-stok-maden-notu">@Dil.T.Yerlesim.MadenAyriToplanir</p>
                            </details>
                        </div>
                        @* PAKET GOC-D — ortak ızgara (grid:raporlar:reyon-stok): tablo id'si, sınıfları, has başlığının id'si ve
                           atanmamış satırların kimliği (rs-atanmamis-*) AYNI. Atanmamış mal gizlenmez — reyon satırlarının ardında. *@
                        <Izgara T="ReyonStokIzgaraSatiri" Ekran="raporlar" GridId="reyon-stok" TabloId="reyon-stok-tablo" TabloSinif="q10-yigin rg-rapor-tablo"
                                Kolonlar="@ReyonKolonlari" Ogeler="@IzgaraYerelSiralama.Uygula(ReyonSatirlari(reyonStok), reyonSira, ReyonKolonlari)"
                                SatirId="@(r => r.Atanmamis ? $"rs-atanmamis-{r.SubeId}" : null)"
                                SatirSinif="@(r => r.Atanmamis ? "hucre-vurgu" : null)"
                                Baslik="@Dil.T.Yerlesim.ReyonStokRaporu"
                                SiralamaDegisti="@(x => reyonSira = x)" GecerliSiralama="@reyonSira" />
                        @* ZO-BELGE 28.09: sunucunun "uyari" alanı geliştirici notudur (JSON alan adları,
                           ters tırnak) — ekrana basılmaz; kullanıcıya karşılığı yukarıdaki
                           reyon-stok-maden-notu ("madenler ayrı toplanır") her zaman görünür. *@
                    }
                </div>
            </div>
            }
            else if (rpKod == "yaslandirma")
            {
            @* ── R15 STOK YAŞLANDIRMA / DEVİR HIZI (PAKET P-25 · Y-16) ──────────────
               16. rapor. Rapor Merkezi kartı buraya getirir (katalog rotası "/raporlar").
               ⚠ UX-S33: bu kart üstteki YIL/AY seçicisinden BAĞIMSIZDIR — "bugün
                 itibarıyla rafta ne var" sorusunu sorar; alt metni bunu YAZAR.
               ⚠ UX-S28: hata boş duruma çevrilmez, ayrı bantta görünür.
               ⚠ UX-S29: ölü stok listesi sunucu sınırını ve daraltma yolunu yazar. *@
            <div class="kart" id="stok-yaslandirma-kart">
                <div class="kart-baslik satir-arasi">
                    <h2>@Dil.T.RaporSeti.AdStokYaslandirma</h2>
                </div>
                <div class="kart-govde">
                    @* PAKET RAPOR-2 (tasarım DÜŞÜK, K17): açıklama ekranda düz satır olarak duruyordu → ⓘ arkasında
                       (metin ve id AYNI). Kurucu temel kuralı: isteğe bağlı eşik alanları açılışta KAPALI katlanır. *@
                    <div class="metin-soluk t4-ipucu-satir" id="sy-nasil-satir">
                        <span>@KR.NasilHesaplanirAc</span>
                        <details class="zo-ipucu" id="sy-nasil-ipucu">
                            <summary aria-label="@KR.NasilHesaplanirAc">i</summary>
                            <p id="sy-aciklama">@Dil.T.RaporSeti.YaslandirmaAciklama</p>
                            @* PAKET RAPOR-4 (K17, tasarım DÜŞÜK): UX-S33 notu başlığın sağında duruyordu → ⓘ içinde (id AYNI). *@
                            <p class="metin-kucuk metin-soluk" id="sy-donem-bagimsiz">@Dil.T.RaporSeti.DonemBagimsiz</p>
                        </details>
                    </div>

                    @* P-36 HAM_INPUT kapısı: ham girdi etiketi YAZILMAZ, ortak girdi ailesi
                       (Bilesenler/Form/Sayi.razor) kullanılır. *@
                    <details class="sade-ayrinti" id="sy-ayarlar">
                        <summary class="sade-ayrinti-ozet" id="sy-ayarlar-ozet">@KR.EsikAyarlariAc</summary>
                        <div class="form-grid-2">
                            <Sayi ElemanId="sy-esik" Etiket="@Dil.T.RaporSeti.OluEsik" EnAz="1" EnCok="3650"
                                  Deger="@((decimal?)syEsikGun)"
                                  DegerChanged="@(v => EsikDegisti(v))" />
                            <Sayi ElemanId="sy-pencere" Etiket="@Dil.T.RaporSeti.DevirPenceresi" EnAz="1" EnCok="3650"
                                  Deger="@((decimal?)syPencereGun)"
                                  DegerChanged="@(v => PencereDegisti(v))" />
                        </div>
                    </details>

                    <HataBandi Mesaj="@syHata" Id="sy-hata" />

                    @if (syHata is not null)
                    {
                        @* UX-S28: hata varken "kayıt yok" YAZILMAZ. *@
                    }
                    else if (yaslandirma is null)
                    {
                        <Yukleniyor />
                    }
                    else if (yaslandirma.ToplamAdet == 0m && yaslandirma.YasiBilinmeyenAdet == 0m)
                    {
                        <BosDurum Mesaj="@Dil.T.RaporSeti.BosDurum" />
                    }
                    else
                    {
                        <div class="stat-izgara">
                            @foreach (var kv in yaslandirma.Kovalar ?? [])
                            {
                                @* KAR-RAPOR-2 (hasım YÜKSEK): kova değeri YALNIZ ALTIN hasıdır (sunucu artık
                                   gümüş gramını katmıyor); diğer madenler kartın alt satırında AYRI yazılır,
                                   "has toplamına katılmaz" notuyla — altta duran sy-uyari-maden metniyle tutarlı. *@
                                <StatKart Etiket="@Dil.T.RaporSeti.Kova(kv.Kod)"
                                          Deger="@Bicim.Has(kv.HasGram)"
                                          Alt="@KovaAlt(kv)" />
                            }
                            @if (yaslandirma.YasiBilinmeyenAdet > 0m)
                            {
                                @* Anayasa md.1: bilinmeyen sıfıra çevrilmez, AYRI kart. *@
                                <StatKart Renk="kirmizi" Etiket="@Dil.T.RaporSeti.YasiBilinmeyen"
                                          Deger="@Bicim.Miktar(yaslandirma.YasiBilinmeyenAdet, null)"
                                          Alt="@Dil.T.RaporSeti.YasiBilinmeyenAciklama" />
                            }
                        </div>

                        @* MADEN-2 (tasarım DÜŞÜK): kova sırası ile devir sırası birbirine değiyordu → üst boşluk (mevcut .mt-2). *@
                        @* PAKET RAPOR-2 (tasarım DÜŞÜK): 6 ölçüm 5+1 dizilip "Rafta kalan adet" tek başına kalıyordu →
                           geniş ekranda 3+3 (Kâr-zarar #kz-tl-kpi ile aynı kural, rapor-gorunum.css). *@
                        <div class="stat-izgara mt-2" id="sy-devir-izgara">
                            @* MADEN-AYRIMI (hasım DÜŞÜK): formül satırı kartın altında açıktı → ızgaranın altında ⓘ arkasında. *@
                            @* RAPOR-GORUNUM (veri c): "Ortalama raf ömrü 310,9 gün" yanında "tüm stok 0-30 gün" çelişki gibi
                               okunuyordu. 310,9 = kalan ÷ (tüketilen ÷ pencere): bugünkü satış hızıyla malın kaç günde
                               BİTECEĞİNİN TAHMİNİ (ileriye bakar); kovalar malın BUGÜNKÜ yaşı (geriye bakar). Kart doğru
                               adını taşır ("Tahmini satış süresi") ve yanına malın GERÇEK ortalama yaşı gelir (kovalarla
                               aynı partilerden, sunucu ortalamaYasGun). Ondalık tek kural: oranlar 2 hane, gün tam sayı. *@
                            <StatKart Renk="mavi" Etiket="@Dil.T.RaporSeti.DevirHizi"
                                      Deger="@(yaslandirma.Devir?.DevirHizi is { } dh ? Oran(dh) : Dil.T.RaporSeti.Hesaplanamadi)" />
                            <StatKart Etiket="@Dil.T.RaporSeti.YillikTahmini"
                                      Deger="@(yaslandirma.Devir?.YillikTahmini is { } yt ? Oran(yt) : Dil.T.RaporSeti.Hesaplanamadi)" />
                            <StatKart Etiket="@KR.OrtalamaYasGun"
                                      Deger="@(yaslandirma.Devir?.OrtalamaYasGun is { } oy ? GunSayi(oy) : Dil.T.RaporSeti.Hesaplanamadi)" />
                            <StatKart Etiket="@KR.TahminiSatisSuresi"
                                      Deger="@((yaslandirma.Devir?.TahminiSatisSuresiGun ?? yaslandirma.Devir?.OrtalamaRafOmruGun) is { } ro ? GunSayi(ro) : Dil.T.RaporSeti.Hesaplanamadi)" />
                            <StatKart Etiket="@Dil.T.RaporSeti.TuketilenAdet"
                                      Deger="@Bicim.Miktar(yaslandirma.Devir?.TuketilenAdet ?? 0m, null)" />
                            <StatKart Etiket="@Dil.T.RaporSeti.KalanAdet"
                                      Deger="@Bicim.Miktar(yaslandirma.Devir?.KalanAdet ?? 0m, null)" />
                        </div>
                        <div class="metin-soluk t4-ipucu-satir" id="sy-devir-tanim-satir">
                            <span>@KR.DevirNasilHesaplanir</span>
                            <details class="zo-ipucu" id="sy-devir-ipucu">
                                <summary aria-label="@KR.DevirNasilHesaplanir">i</summary>
                                <p id="sy-devir-tanim">@Dil.T.RaporSeti.DevirTanimi</p>
                                @* PAKET RAPOR-3 (K17): Ortalama yaş / Tahmini satış süresi kart altı cümleleri buraya taşındı. *@
                                <p id="sy-ortalama-yas-not">@KR.OrtalamaYasGun: @KR.OrtalamaYasAlt</p>
                                <p id="sy-tahmini-sure-not">@KR.TahminiSatisSuresi: @KR.TahminiSatisSuresiAlt</p>
                                @* PAKET RAPOR-2 (K17): madenler / devir notları ekranda düz satırdı → aynı ⓘ içinde (metin ve id AYNI). *@
                                @if ((yaslandirma.MadenDagilimi?.Count ?? 0) > 1)
                                {
                                    <p id="sy-uyari-maden">@KR.StokCokluMaden</p>
                                }
                                @if (yaslandirma.Devir is { DevirHizi: null })
                                {
                                    <p id="sy-uyari-devir">@KR.StokDevirYok</p>
                                }
                            </details>
                        </div>

                        <h4 class="metin-kucuk" id="sy-olu-baslik">@Dil.T.RaporSeti.OluStok</h4>
                        @if ((yaslandirma.OluStok?.Urunler?.Count ?? 0) == 0)
                        {
                            @* MADEN-2 (tasarım DÜŞÜK): başlık "dönemden bağımsız" derken "Bu dönemde kayıt yok" çelişiyordu. *@
                            <div id="sy-olu-bos"><BosDurum Mesaj="@string.Format(KR.OluStokYok, syEsikGun)" /></div>
                        }
                        else
                        {
                            @* PAKET GOC-D — ortak ızgara (grid:raporlar:sy-olu); tablo id'si ve sınıfları AYNI. Sunucu sınırına
                               değdiyse (DahaFazlasiVar) sıralama KAPALI — yalnız görünen kısmı sıralamak yanıltır (UX-S29). *@
                            <Izgara T="OluStokSatiriDto" Ekran="raporlar" GridId="sy-olu" TabloId="sy-olu-tablo" TabloSinif="q10-yigin rg-rapor-tablo"
                                    Kolonlar="@OluKolonlari" Ogeler="@IzgaraYerelSiralama.Uygula(yaslandirma.OluStok!.Urunler!, oluSira, OluKolonlari)"
                                    Baslik="@Dil.T.RaporSeti.OluStok"
                                    SiralamaDegisti="@(x => oluSira = x)" GecerliSiralama="@oluSira" />
                            @if (yaslandirma.OluStok!.DahaFazlasiVar)
                            {
                                @* UX-S29: sessiz kırpma yok — sınır ve daraltma yolu yazılır. *@
                                <p class="metin-kucuk metin-soluk" id="sy-sinir-uyarisi">
                                    @Dil.T.RaporSeti.SinirUyarisi
                                </p>
                            }
                        }

                        @* PAKET KAR-RAPOR (TOPLU-4 hakemi): sunucunun "uyarilar" metni geliştirici
                           notudur (ters tırnaklı JSON alan adları: altinHasGram, madenDagilimi) —
                           ekrana BASILMAZ. Aynı koşullar veriden okunur, sözlükten sade metin yazılır;
                           yaşı bilinmeyen adet zaten yukarıda ayrı kırmızı kartta. *@
                        @* PAKET RAPOR-2: sy-uyari-maden / sy-uyari-devir yukarıdaki "Devir nasıl hesaplanır" ⓘ içine taşındı. *@
                    }
                </div>
            </div>
            }
            else if (rpKod == "gunsonu")
            {
            @* ── GÜN SONU POS–FATURA MUTABAKATI ─────────────────────────────────────
               PLAN-2 Adım 1: bu uç yazılmıştı ama ekranı yoktu; yalnız curl ile
               erişilebiliyordu. KDV beyanı için gün sonu karşılaştırması. *@
            <h2>@Dil.T.Mutabakat.Baslik</h2>
            <div class="kart">
                <div class="kart-govde form-grid-3">
                    @* PAKET GOC-D (HAM_TARIH_GIRDISI): ortak Tarih (Tur=Rapor: gg.aa.yyyy, 2000..gelecek yıl; 3000 yılı
                       yazılamaz) — id AYNI (#mut-tarih). Sunucu aynı pencereyle 400 döner (RaporGunuDogrula). *@
                    <Tarih ElemanId="mut-tarih" Etiket="@Dil.T.Mutabakat.Gun" Tur="TarihTuru.Rapor"
                           Deger="@DateOnly.FromDateTime(mutabakatGunu)" DegerChanged="@MutabakatGunuDegisti" />
                </div>
            </div>

            @if (mutabakat is { } m)
            {
                @* DEGISIM-GUNSONU (hakem YÜKSEK "12.485 − 0 ≠ 27.389"): kartlar sunucunun FARK tanımı sırasıyla —
                   Satış toplamı − Satış faturası (farka giren) = <farkın adı>; tahsilat kartı farkın yanından ayrıldı (sonda).
                   Hesap SUNUCUDA (m.Fark); burada yalnız ad ve sıra (Raporlar.GunSonu.cs). *@
                <div class="stat-izgara" id="mut-kartlar">
                    @* PAKET RAPOR-4 (tasarım DÜŞÜK): PRO kartı da brüt olduğunu söyler (BASİT'le aynı kapsam notu). *@
                    <StatKart Etiket="@DG.SatisToplami" Deger="@Bicim.TlKurus(m.Satis.ToplamTl)" Alt="@($"({KR.GunSonuIadeDusulmeden})")" />
                    <StatKart Etiket="@Dil.T.Mutabakat.SatisFaturasi" Deger="@Bicim.TlKurus(FarkaGirenFatura(m))" />
                    <StatKart Etiket="@(m.Fark == 0 ? Dil.T.Mutabakat.Fark : FarkEtiketi(m, DG))" Deger="@Bicim.TlKurus(FarkGosterimi(m))"
                              Renk="@(m.Fark == 0 ? "yesil" : "kirmizi")" />
                    @* TOPLU-5 (hakem DÜŞÜK "'FARK VAR' büyük harf"): durum değeri cümle düzeninde (Toplu5Sozlugu). *@
                    @* PAKET RAPOR-4 (tasarım DÜŞÜK): "Fark var" neyin farkı olduğunu söylemiyordu → BASİT'teki gibi somut
                       ("8 satışın faturası yok"); faturasız satış yoksa (fark bağsız faturadan) eski metin kalır. *@
                    <StatKart Etiket="@Dil.T.Mutabakat.Durum"
                              Deger="@(m.Mutabik ? T5.GunSonuTutuyor : m.Satis.FaturasizSayisi > 0 ? string.Format(DG.FaturasizAdet, m.Satis.FaturasizSayisi) : T5.GunSonuFarkVar)"
                              Renk="@(m.Mutabik ? "yesil" : "kirmizi")" />
                    @* PARA-DEMO md.1: alt kalemler toplamı = toplam · DEGISIM-GUNSONU: sıfır kalem yazılmaz.
                       RAPOR-4 (tasarım DÜŞÜK): döküm satır sonunda "·" ile sarkıyordu → her kalem AYRI satırda (rapor-gorunum.css). *@
                    <StatKart Etiket="@Dil.T.Mutabakat.Tahsilat" Deger="@Bicim.TlKurus(m.Tahsilat.Toplam)"
                              Alt="@(TahsilatAltMetni(m.Tahsilat, Dil.Dil)?.Replace(" · ", "\n"))" />
                </div>

                @* UX-4d md.11: FARK'ın TANIMI ekranda yazar; "26.500 nereden geldi"
                   sorusu cevapsız kalmaz. *@
                @* TOPLU-5 (hakem DÜŞÜK "formül satırı"): tanım açık paragraf değil, "Nasıl hesaplanır?" ⓘ içinde
                   (BASİT kartla aynı ad; metin ve id AYNEN, DOM'da kalır). *@
                <div class="t4-ipucu-satir" id="mut-fark-tanimi-satir">
                    <details class="zo-ipucu" id="mut-fark-bilgi">
                        <summary aria-label="@ZB.GunSonuHesapBaslik">i</summary>
                        <p id="mut-fark-tanimi">@(m.FaturaEslesme?.FarkTanimi is { } ft ? DilEkranSozlugu.SunucuMetni(Dil.Dil, ft) : Dil.T.SayfaDuzeltme.FarkTanimi)</p>
                    </details>
                    <span class="metin-soluk">@ZB.GunSonuHesapBaslik</span>
                </div>

                @* PARA-DEMO-2 (madde 5): toplam tahsilata GİRMEYEN kasa girişleri ayrı satırda; tanım katlanırda. *@
                @* Tur 4: tanım metni sözlükten (TR+EN), katlanır her zaman; ayrı satırlar kartı yalnız tutar varsa (kart-govde dolgusuyla). *@
                @if (m.Tahsilat.VirmanGiris != 0m || m.Tahsilat.AcilisDevri != 0m || m.Tahsilat.DovizGiris is { Count: > 0 })
                {
                    <div class="kart" id="mut-tahsilat-disi">
                        <div class="kart-govde">
                            @if (m.Tahsilat.VirmanGiris != 0m)
                            {
                                <p class="satir-arasi metin-kucuk" id="mut-virman-giris"><span>@PD2.VirmanGirisSatiri</span><span class="sayi">@Bicim.TlKurus(m.Tahsilat.VirmanGiris)</span></p>
                            }
                            @if (m.Tahsilat.AcilisDevri != 0m)
                            {
                                <p class="satir-arasi metin-kucuk" id="mut-acilis-devri"><span>@PD2.AcilisDevriSatiri</span><span class="sayi">@Bicim.TlKurus(m.Tahsilat.AcilisDevri)</span></p>
                            }
                            @* PAKET RAPOR-3 tur 2 (UX-S32): dövizli kasa girişi TL toplamına girmez; para birimiyle ayrı satır. *@
                            @foreach (var d in m.Tahsilat.DovizGiris ?? [])
                            {
                                <p class="satir-arasi metin-kucuk" id="mut-doviz-giris-@d.ParaBirimi"><span>@string.Format(KR.DovizKasaGirisi, d.ParaBirimi)</span><span class="sayi">@Bicim.BelgePara(d.Tutar, d.ParaBirimi)</span></p>
                            }
                        </div>
                    </div>
                }
                <Katlanir Id="mut-tahsilat-tanim" Baslik="@PD2.TahsilatTanimBaslik"><p class="metin-kucuk metin-soluk" id="mut-tahsilat-tanim-metin">@PD2.TahsilatTanimMetni</p></Katlanir>
                @* PAKET KAR-RAPOR (PARA-DEMO-2 hakemi): uyarılar ayrı ayrı sarı kutu değil, TEK kutuda. *@
                @if (GunSonuUyarilari(m) is { Count: > 0 } mutUyarilar)   @* DEGISIM-2: bağsız fatura TEK adla, aynı tutarın ikinci uyarısı yok (Raporlar.GunSonu.cs) *@
                {
                    <div class="uyari-kutu" id="mut-uyarilar">
                        @if (mutUyarilar.Count > 1)
                        {
                            <p class="metin-kucuk" id="mut-uyarilar-baslik"><strong>@KR.GunSonuUyarilarBaslik</strong></p>
                        }
                        @foreach (var u in mutUyarilar)
                        {
                            <p>⚠ @u</p>
                        }
                    </div>
                }

                <div class="kart">
                    @* PAKET GOC-D — ortak ızgara (grid:raporlar:mut-ozet): tablo id'si ve satır sınıfları (satir-amber,
                       satir-kirmizi) AYNI. Özet kalemlerinin SIRASI anlamlıdır (satış → faturalı → faturasız …) →
                       sıralama düğmesi YOK. *@
                    <Izgara T="MutOzetSatiri" Ekran="raporlar" GridId="mut-ozet" TabloId="mut-ozet-tablo"
                            Kolonlar="@MutOzetKolonlari" Ogeler="@MutOzetSatirlari(m)" Baslik="@Dil.T.Mutabakat.Baslik"
                            SatirSinif="@(x => x.Sinif)" />
                </div>

                @* UX-S23: sayı gösteren yer o kayıtlara götürür — bağsız faturalar
                   tek tek listelenir (fatura no ile), "fark neden var" görünür olur. *@
                @if (m.FaturaEslesme?.BagimsizFaturalar is { Count: > 0 } bagsiz)
                {
                    <div class="kart" id="mut-bagsiz-faturalar">
                        <div class="kart-baslik"><h3>@DG.BagsizFaturaListe</h3></div>   @* DEGISIM-2: TEK ad "Satışa bağlanmamış fatura" (BASİT kartla aynı) *@
                        @* PAKET GOC-D — ortak ızgara (grid:raporlar:mut-bagsiz). Liste TAMDIR (günün bağsız faturaları). *@
                        <Izgara T="BagimsizFatura" Ekran="raporlar" GridId="mut-bagsiz" Kolonlar="@BagsizKolonlari"
                                Ogeler="@IzgaraYerelSiralama.Uygula(bagsiz, bagsizSira, BagsizKolonlari)" Baslik="@DG.BagsizFaturaListe"
                                SiralamaDegisti="@(x => bagsizSira = x)" GecerliSiralama="@bagsizSira" />
                    </div>
                }

                @if (m.FaturasizIslemler.Count > 0)
                {
                    <div class="kart">
                        <div class="kart-baslik"><h3>@Dil.T.Mutabakat.FaturasizListe</h3></div>
                        @* PAKET GOC-D — ortak ızgara (grid:raporlar:mut-faturasiz); tablo id'si AYNI. Ham ödeme kodu görünmez
                           (KatalogSozlugu/ParaDemo3 adı; ham kod title'da). Liste TAMDIR (günün faturasız işlemleri). *@
                        <Izgara T="FaturasizIslem" Ekran="raporlar" GridId="mut-faturasiz" TabloId="mut-faturasiz-tablo"
                                Kolonlar="@FaturasizKolonlari" Ogeler="@IzgaraYerelSiralama.Uygula(m.FaturasizIslemler, faturasizSira, FaturasizKolonlari)"
                                Baslik="@Dil.T.Mutabakat.FaturasizListe"
                                SiralamaDegisti="@(x => faturasizSira = x)" GecerliSiralama="@faturasizSira" />
                    </div>
                }
            }
            }
        </Panel>
    </Sekmeler>

</div>
}

    @* UX-S25: raporda veri girişi yoktur; rakamlar türetilir. Düzenle düğmesi
       çizilmez, gerekçe ve doğru düzeltme yolu yazılır.
       PAKET ZO-BELGE (kurucu 25.09: "değiştirilemez" kutusu açılışta YOK): BASİT
       "Bugün" yüzünde çizilmez — orada ne tablo ne düzenlenebilir görünen alan var;
       düzeltme yolu Gün sonu kartının FARK bağlantısında. Profesyonel yüzde durur. *@
    @if (!Mod.BasitMi)
    {
        @* Profesyonel yüzde de açılışta değil: KAPALI "rakam yanlışsa" katlanırında
           (kurucu 25.09: "değiştirilemez" kutusu açılışta YOK; id AYNI). *@
        @* RAPOR-GORUNUM (tasarım ORTA): gerekçe "Bakiye … manuel düzeltme fişiyle" + alternatif yol "ters kayıtla"
           İKİ farklı yol söylüyordu ve rapor ekranında "bakiye" yersizdi → rapora özgü TEK cümle. *@
        <Katlanir Id="rp-duzeltme" Baslik="@ZB.RaporDuzeltmeBaslik" Sinif="zo-bilgi">
            <DegismezIpucu Varlik="Rapor" Gerekce="@KR.RaporTuretilmisGerekce" />
        </Katlanir>
    }
</div>

@code {
    // ── PAKET KAT-1 — profesyonel yüz sekmeleri (tren sayfa) ────────────────
    private KatalogMetinleri KT => KatalogSozlugu.Al(Dil.Dil);

    private IReadOnlyList<SekmeTanimi> RpSekmeleri =>
    [
        new("ozet", KT.RaporSekmeOzet),
        new("grafik", KT.RaporSekmeGrafik),
        new("cari", KT.RaporSekmeCari),
        new("stok", KT.RaporSekmeStok),
        new("yaslandirma", KT.RaporSekmeYaslandirma),
        new("gunsonu", KT.RaporSekmeGunSonu),
    ];

    /// <summary>
    /// Rapor merkezindeki "/raporlar" kartı bu sayfanın İLGİLİ sekmesini açar
    /// (sekmelerden önce aynı sayfada aşağı kaydırılarak bulunuyordu). Bilinmeyen
    /// kod ya da başka rota olduğu gibi gider (tahmin yok).
    /// </summary>
    public static string KartRotasi(string kod, string rota) => rota != "/raporlar" ? rota : kod switch
    {
        "R05" => "/raporlar?sekme=gunsonu",
        "R06" or "R20" => "/raporlar?sekme=stok",
        "R15" => "/raporlar?sekme=yaslandirma",
        "R03" => "/raporlar?sekme=cari",
        _ => rota,
    };

    // ── Gün sonu mutabakatı (PLAN-2 Adım 1) ──────────────────────────────
    private DateTime mutabakatGunu = DateTime.Today;
    private Mutabakat? mutabakat;

    /// <summary>PAKET GOC-D — ortak Tarih alanı: eksik/hatalı yazımda (null) istek atılmaz, alan altı söyler.</summary>
    private async Task MutabakatGunuDegisti(DateOnly? v)
    {
        if (v is not { } g) return;
        mutabakatGunu = g.ToDateTime(TimeOnly.MinValue);
        await MutabakatYukle();
    }

    // ═══ PAKET GOC-D — Raporlar ekranının listeleri ORTAK IZGARADA (hücre içerikleri eski tabloların AYNISI) ═══
    // Tam listeler (sunucu sınırına değmeyen) yerel sıralanır; sınıra değen ölü stok listesi ve sırası anlam
    // taşıyan özet tablosunda sıralama düğmesi çıkmaz. Cari yaşlandırma tablosu (yas-tablo) ve işlem defteri
    // yazdırma belgesi gerekçeli istisnadır (rapor § 2): alt toplam satırları sütunlara hizalı + başlıkta ⓘ.
    private IzgaraSiralama? skSira, madenSira, stokSira, reyonSira, oluSira, bagsizSira, faturasizSira;

    private IReadOnlyList<IzgaraKolonu<SatisKirilimiSatiri>> SkKolonlari =>
    [
        new() { Anahtar = "arac", Baslik = SK.Arac, ZorunluGorunur = true, SunucuSiralamaAdi = "arac",
                HucreSinif = _ => "hucre-vurgu", Deger = x => SatisAracAdi(x.Arac) },
        new() { Anahtar = "tutar", Baslik = SK.Tutar, ZorunluGorunur = true, SunucuSiralamaAdi = "tutar", BaslikSinif = "sayi",
                HucreSinif = _ => "sayi", Deger = x => x.TutarTl, Hucre = x => @<text>@Bicim.BelgePara(x.TutarTl, "TRY")</text> },
        new() { Anahtar = "fis", Baslik = SK.FisSayisi, SunucuSiralamaAdi = "fis", BaslikSinif = "sayi",
                HucreSinif = _ => "sayi", Deger = x => x.FisAdet },
        new() { Anahtar = "kasaya-girer", Baslik = SK.KasayaGirer, SunucuSiralamaAdi = "kasaya-girer",
                HucreSinif = _ => "metin-kucuk", Deger = x => x.KasayaGirer ? SK.KasayaGirer : SK.KasayaGirmez },
    ];

    private IReadOnlyList<IzgaraKolonu<Kuyumcu.Core.Sozlesmeler.MadenDagilimSatiri>> MadenKolonlari =>
    [
        new() { Anahtar = "maden", Baslik = Dil.T.Urun.Maden, ZorunluGorunur = true, SunucuSiralamaAdi = "maden",
                Deger = md => KurKaynakAdi.MadenAdi(md.Maden, md.MadenAdi) },
        // P-69: satırın has gramı O SATIRIN madenidir; "Toplam Has" DEMEZ. MADEN-2: değer düz metin (tıklanmaz).
        new() { Anahtar = "miktar", Baslik = KR.MiktarMadenineGore, ZorunluGorunur = true, BaslikId = "rapor-maden-has-baslik",
                BaslikSinif = "sayi", HucreSinif = _ => "sayi hucre-vurgu", Deger = md => md.ToplamHas,
                Hucre = md => @<text>@MadenMiktari(md.Maden, md.ToplamHas, null)</text> },
        new() { Anahtar = "hareket", Baslik = Dil.T.Rapor.HareketSayisi, SunucuSiralamaAdi = "hareket", BaslikSinif = "sayi",
                HucreSinif = _ => "sayi", Deger = md => md.SatirSayisi },
    ];

    private IReadOnlyList<IzgaraKolonu<StokUrun>> StokKolonlari =>
    [
        new() { Anahtar = "urun", Baslik = Dil.T.Islem.Urun, ZorunluGorunur = true, SunucuSiralamaAdi = "urun",
                HucreSinif = _ => "hucre-vurgu", Deger = x => x.Ad },
        // KESIF-P3 (#78): ham ayar kodu görünmez — tek kaynak KurKaynakAdi.AyarAdi; kod title'da.
        new() { Anahtar = "ayar", Baslik = Dil.T.Urun.Ayar, SunucuSiralamaAdi = "ayar", HucreSinif = _ => "metin-soluk",
                Deger = x => string.IsNullOrEmpty(x.AyarId) ? null : KurKaynakAdi.AyarAdi(x.AyarId),
                Hucre = x => @<span title="@x.AyarId">@(string.IsNullOrEmpty(x.AyarId) ? "—" : KurKaynakAdi.AyarAdi(x.AyarId))</span> },
        new() { Anahtar = "adet", Baslik = Dil.T.Rapor.ToplamAdet, SunucuSiralamaAdi = "adet", BaslikSinif = "sayi",
                HucreSinif = _ => "sayi hucre-vurgu", Deger = x => x.Adet, Hucre = x => @<text>@Bicim.Miktar(x.Adet, null)</text> },
        // MADEN-AYRIMI: altın "has", diğer madenler "72,00 g (saf 66,60 g)" — madenler tek sayı gibi sıralanmaz
        // (karşılaştırma yalnız sayısal değerle yapılır; görünen metin maden birimini taşır).
        new() { Anahtar = "miktar", Baslik = KR.MiktarMadenineGore, ZorunluGorunur = true, BaslikId = "rapor-stok-has-baslik",
                BaslikSinif = "sayi", HucreSinif = _ => "sayi hucre-vurgu", Hucre = x => @<text>@StokMiktari(x)</text> },
    ];

    private IReadOnlyList<ReyonStokIzgaraSatiri> ReyonSatirlari(ReyonStokYaniti r) =>
        [.. r.ReyonListesi.Select(x => new ReyonStokIzgaraSatiri(x.SubeId, x.SubeAdi, x.ReyonAdi, x.Adet, x.MadenListesi, false)),
         .. r.AtanmamisListesi.Select(x => new ReyonStokIzgaraSatiri(x.SubeId, x.SubeAdi, Dil.T.Yerlesim.Atanmamis, x.Adet, x.MadenListesi, true))];

    private IReadOnlyList<IzgaraKolonu<ReyonStokIzgaraSatiri>> ReyonKolonlari =>
