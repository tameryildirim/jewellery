    private List<Kuyumcu.Contracts.Sayfalar.Kasalar.KasaNakitAyrimiOzeti>? bugunAyrim;
    private string? bugunAyrimHata;
    private ParaDemo2Metinleri PD2 => ParaDemo2Sozlugu.Al(Dil.Dil);
    // RAPOR-4: Panel kasa kartıyla aynı etiket kaynağı (PanelTuvalSozlugu.Nakit).
