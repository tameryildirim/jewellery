                    @foreach (var m in AltinDisiMadenler(bugunOzet?.Hurda?.MadenDagilimi))
                    {
                        <span class="bugun-maden" id="@($"bugun-hurda-maden-{m.Maden}")">@BugunMadenMetni(m)</span>
                    }
                </p>
            }
        }
    </section>;

    // (3) Kasada ne var? — UX-S32: tutar para birimiyle, grup adı etikette.
    //     UX-S33: dönemden bağımsız "şu anki para" olduğunu yazar.
    private RenderFragment BugunKasaKarti => @<section class="panel-soru" id="bugun-kasa" aria-labelledby="bugun-kasa-baslik">
        <h2 class="panel-soru-baslik" id="bugun-kasa-baslik">@B.KasadaNeVar</h2>
        @if (bugunOzetYukleniyor)
        {
            <Yukleniyor />
        }
        else if (bugunOzetYetkiYok)
        {
            <p class="metin-soluk" id="bugun-kasa-yetki">@B.YetkiYok</p>
        }
        else if (bugunOzetHata is not null)
        {
            <HataBandi Mesaj="@bugunOzetHata" Id="bugun-kasa-hata" />
        }
        else if (BugunKasaGruplari.Count == 0)
        {
            <BosDurum Mesaj="@B.KasaYok" />
        }
        else
        {
            var gruplar = BugunKasaGruplari;
            var ana = gruplar[0];
            <a class="panel-soru-sayi" id="bugun-kasa-deger" href="/kasalar"
               title="@B.KasaBaglantiIpucu">@Bicim.BelgePara(ana.Toplam, ana.ParaBirimi)</a>
            @* PAKET RAPOR-4 (tasarım DÜŞÜK): Panel'deki aynı kartla AYNI düzen — "TL kasalar · Şu anki para" açıklama
               satırı tek para biriminde çizilmez (Panel ile aynı); kırılım iki AYRI öğe, satır sonunda
               tutar yalnız düşmez (.panel-sade .panel-soru-alt > * nowrap — Panel ile aynı kural). *@
            @if (gruplar.Count > 1)
            {
                @* Birden çok para birimi varken grup adı ayırt edicidir (UX-S32) — yalnız o zaman yazılır. *@
                <p class="panel-soru-alt" id="bugun-kasa-grup">
                    <span>@PanelSadeSozlugu.KasaGrubu(ana.ParaBirimi, Dil.Dil) · @B.SuAnkiPara</span>
                </p>
            }
            @* PARA-DEMO-2 (madde 4): kasaya yazılmış kart/havale çekmecede DURMAZ — alt satır "Nakit X · Kart/Havale Y"
               (aynı para birimindeki kasaların toplamı; sunucu KasaNakitAyrimi). Pay yoksa satır yok; okunamazsa kısa hata. *@
            @if (BugunAyrim(ana.ParaBirimi) is { } ay && ay.KartHavale != 0m)
            {
                <p class="panel-soru-alt" id="bugun-kasa-ayrim" aria-label="@string.Format(PD2.KasaAyrimSatiri, Bicim.BelgePara(ay.Nakit, ana.ParaBirimi), Bicim.BelgePara(ay.KartHavale, ana.ParaBirimi))">
                    <span class="panel-soru-alt-oge" id="bugun-kasa-nakit">@KasaNakitEtiketi @Bicim.BelgePara(ay.Nakit, ana.ParaBirimi)</span>
                    <span class="panel-soru-alt-oge" id="bugun-kasa-karthavale">@PD2.KartHavaleEtiket @Bicim.BelgePara(ay.KartHavale, ana.ParaBirimi)</span>
                </p>
            }
            else if (bugunAyrimHata is not null)
            {
                <p class="metin-kucuk metin-amber" id="bugun-kasa-ayrim-hata">@string.Format(PD2.KasaAyrimHata, bugunAyrimHata)</p>
            }
            <ul class="panel-liste" id="bugun-kasa-liste">
                @foreach (var (k, sira) in ana.Kasalar.Select((k, sira) => (k, sira)))
                {
                    <li class="panel-liste-satir panel-liste-satir--is" id="@($"bugun-kasa-{sira}")">
                        <span class="panel-liste-ad">@k.Ad</span>
                        <span class="panel-liste-tutar">@Bicim.BelgePara(k.Bakiye, k.ParaBirimi)</span>
                    </li>
                }
            </ul>
            @foreach (var g in gruplar.Skip(1))
            {
                <p class="panel-soru-alt" id="@($"bugun-kasa-grup-{g.Sira}")">
                    <span>@PanelSadeSozlugu.KasaGrubu(g.ParaBirimi, Dil.Dil)</span>
                    <strong>@Bicim.BelgePara(g.Toplam, g.ParaBirimi)</strong>
                </p>
            }
        }
    </section>;

    // (4) Bekleyen iş — sunucunun rol süzgecinden geçmiş açık bildirimler.
    private RenderFragment BugunBekleyenKarti => @<section class="panel-soru panel-soru--liste" id="bugun-bekleyen" aria-labelledby="bugun-bekleyen-baslik">
        <header class="panel-soru-bas">
            <h2 class="panel-soru-baslik panel-soru-baslik--liste" id="bugun-bekleyen-baslik">@B.BekleyenIs</h2>
            <a href="/bildirimler" id="bugun-bekleyen-tumu">@B.Tumu</a>
        </header>
        @* PAKET RAPOR-2 (tutarlılık, tasarım ORTA): Panel "Bekleyen 1 iş üstteki uyarıda" derken bu kart aynı anda
           "Bekleyen iş yok" diyordu — Panel bekleyen işi ÜÇ kaynaktan sayar (açık bildirimler + uyum sayaçları +
           yasal uyum bantları), bu kart yalnız bildirimlerden. Tek tanım (Bertan + Mustafa oyu): bekleyen iş =
           Panel'in tanımı. Yasal bantlar AYNI bileşenle (UyumYasalBantlari, /masak/uyum-ozet, yalnız SAHİP), uyum
           sayaçları AYNI uçlardan (UyumServisi, SAHİP/MÜDÜR/MUHASEBE) okunur; boş durum yalnız üçü de sıfırken. *@
        @* RAPOR-2 tur 2 (hasım DÜŞÜK): nakit sınırı aşımı da Panel'le AYNI kaynaktan — NakitSiniriPanelSatiri
           (/tevsik/ihlaller, yalnız SAHİP/MUHASEBE); TevsikIhlali bildirimi listede İKİNCİ kez sayılmaz. *@
        @* PAKET RAPOR-3 (hasım YÜKSEK): bantlar kartın İÇİNDE kutu olarak çiziliyor, altında yine boş simge duruyordu.
           Veri AYNI bileşenlerden okunur (Gorunmez: kutu çizilmez, hata bandı kalır); işler Panel ile AYNI satır
           bileşeniyle (BekleyenUyumSatirlari) — renkli nokta · metin · ilgili ekrana bağlantı. *@
        <NakitSiniriPanelSatiri SayiDegisti="@(n => bugunNakitSeritSayisi = n)" Gorunmez="true" />
        <Kuyumcu.Web.Bilesenler.Uyum.UyumYasalBantlari SayiDegisti="@(n => bugunYasalSayi = n)" OzetDegisti="@(o => bugunYasalOzet = o)" Gorunmez="true" />
        <BekleyenUyumSatirlari Onek="bugun-bekleyen" Yasal="bugunYasalOzet" NakitSayisi="BugunNakitIsSayisi" />
        @if (bugunUyumSayisi > 0)
        {
            <ul class="panel-liste" id="bugun-bekleyen-uyum">
                <li class="panel-liste-satir panel-liste-satir--is">
                    <span class="panel-nokta panel-nokta--dikkat" role="img"
                          aria-label="@PanelSadeSozlugu.Onem("UYARI", Dil.Dil)" title="@PanelSadeSozlugu.Onem("UYARI", Dil.Dil)"></span>
                    <a class="panel-liste-ad" href="/uyum" id="bugun-bekleyen-uyum-git">@string.Format(KR.BekleyenUyumSatiri, bugunUyumSayisi)</a>
                </li>
            </ul>
        }
        <HataBandi Mesaj="@bugunUyumHata" Id="bugun-bekleyen-uyum-hata" />
        <HataBandi Mesaj="@bugunStopajHata" Id="bugun-bekleyen-stopaj-hata" />
        @if (bugunBildirimYukleniyor)
        {
            <Yukleniyor />
        }
        else if (bugunBildirimYetkiYok)
        {
            <p class="metin-soluk" id="bugun-bekleyen-yetki">@B.YetkiYok</p>
        }
        else if (bugunBildirimHata is not null)
        {
            <HataBandi Mesaj="@bugunBildirimHata" Id="bugun-bekleyen-hata" />
        }
        else if (bugunBildirimler.Count == 0)
        {
            @if (bugunUyumSayisi == 0 && bugunUyumHata is null && BugunYasalIsSatiri == 0)
            {
                @* RAPOR-3: boş durum YALNIZ hiç iş yokken (Panel ile AYNI koşul ve metin). *@
                <BosDurum Mesaj="@B.BekleyenYok" />
            }
        }
        else
        {
            <ul class="panel-liste" id="bugun-bekleyen-liste">
                @foreach (var b in bugunBildirimler)
                {
                    <li class="panel-liste-satir panel-liste-satir--is" id="@($"bugun-is-{b.Id}")">
                        <span class="panel-nokta @BugunNokta(b.Onem)" role="img"
                              aria-label="@PanelSadeSozlugu.Onem(b.Onem, Dil.Dil)"
                              title="@PanelSadeSozlugu.Onem(b.Onem, Dil.Dil)"></span>
                        @if (BugunIcRota(b.HedefRota) is { } rota)
                        {
                            <a class="panel-liste-ad" href="@rota" id="@($"bugun-is-git-{b.Id}")">@b.Baslik</a>
                        }
                        else
                        {
                            <span class="panel-liste-ad">@b.Baslik</span>
                        }
                    </li>
                }
            </ul>
            @* UX-S29: sunucu sınırı söylenir, sınıra değdiyse "daha fazlası var". *@
            @if (bugunBildirimDahaFazla)
            {
                <div class="bant bant-uyari" id="bugun-bekleyen-sinir">@string.Format(B.BekleyenSinir, BugunBildirimSinir)</div>
            }
        }
    </section>;

    // (5) Gün sonu — FARK VAR ise düzeltme yoluna bağlantı (PLAN S-3).
    //     Fark = kasaya giren para − satış faturaları (sunucunun FarkTanimi).
    //     Doğru düzeltme: faturasız satışa fatura kesmek (/faturalar).
    private RenderFragment BugunGunSonuKarti => @<section class="panel-soru" id="bugun-gun-sonu" aria-labelledby="bugun-gun-sonu-baslik">
        <h2 class="panel-soru-baslik" id="bugun-gun-sonu-baslik">@B.GunSonu</h2>
        @if (bugunMutabakatYukleniyor)
        {
            <Yukleniyor />
        }
        else if (bugunMutabakatYetkiYok)
        {
            <p class="metin-soluk" id="bugun-gun-sonu-yetki">@B.YetkiYok</p>
        }
        else if (bugunMutabakatHata is not null)
        {
            <HataBandi Mesaj="@bugunMutabakatHata" Id="bugun-gun-sonu-hata" />
        }
        else if (bugunMutabakat is { } m)
        {
            @* PARA-DEMO-2 (madde 4): tahsilat kırılımı TEK satır (toplam = nakit + kart + havale [+ diğer]). *@
            @* TOPLU-5 (hakem ORTA "BASİT kartta kırılım iki satır" + "Havale 0 ₺"): sıfır kalem yazılmaz; her kalem
               BÖLÜNMEZ parça (satır kalem sınırında kırılır, tutarın ortasında değil); 14 px. Metin AYNI cümle. *@
            <p class="t5-kirilim" id="bugun-tahsilat-kirilim">@foreach (var (ayrac, parca) in TahsilatParcalari(m.Tahsilat)) {<text>@ayrac</text><span class="t5-kirilim-parca">@parca</span>}</p>
            @if (m.Mutabik)
            {
                <p class="panel-soru-alt" id="bugun-gun-sonu-tamam">
                    <Rozet Renk="yesil">@B.GunSonuTamam</Rozet>
                </p>
            }
            else
            {
                @* DEGISIM-GUNSONU (hakem YÜKSEK): tutar ADIYLA yazılır — "Faturası kesilmemiş satış: 27.389,71 ₺".
                   Tutar sunucunun m.Fark'ı (PRO kartıyla AYNI alan); fark tahsilatla ilgili değildir, cümle de öyle demez. *@
                @* PAKET RAPOR-3 (hasım DÜŞÜK): "Fark var" rozeti farkın ne olduğunu söylemiyordu; aynı bilgi satırın
                   kendisinde ve aşağıdaki eylem listesinde var → rozet kalktı. Faturasız satış brüttür (iade düşülmeden):
                   aynı ekrandaki "Bugün ne sattım" NET — iade varsa kapsam notu yazar. *@
                <p class="panel-soru-alt" id="bugun-fark-var">
                    <span class="dg-fark-satir" id="bugun-fark-satir"><span id="bugun-fark-etiket">@string.Format(DG.EtiketTutar, FarkEtiketi(m, DG), "")</span><strong id="bugun-fark-tutar">@Bicim.TlKurus(FarkGosterimi(m))</strong>@if (BugunIadeAdet > 0 && m.Satis.FaturasizSayisi > 0)
                    {<span class="metin-soluk metin-kucuk" id="bugun-fark-kapsam"> (@KR.GunSonuIadeDusulmeden)</span>}</span>
                </p>
                @* ZO-BELGE 29.09 (doğrulayıcı DÜŞÜK): açılışta SADE açıklama sözlükten
                   (TR+EN); hesap formülü kapalı katlanırda. Sunucunun ham Türkçe
                   FarkTanimi basit yüzde artık basılmaz (EN modda Türkçe kalıyordu).
                   DEGISIM-GUNSONU: açıklama farkın türüne göre ("kasaya giren para" DEMEZ — fark kasayla ilgili değil). *@
                <p class="metin-kucuk metin-soluk dg-fark-aciklama gorsel-gizli" id="bugun-fark-aciklama">@FarkAciklamasi(m, DG)</p>   @* DEGISIM-2 (K17): fark satırı + eylem satırı aynı bilgiyi veriyor — açıklama ekran okuyucuda *@
                <Katlanir Id="bugun-fark-formul" Baslik="@ZB.GunSonuHesapBaslik" Sinif="zo-gun-sonu-notlar">
                    <p class="metin-kucuk metin-soluk" id="bugun-fark-formul-metin">@ZB.GunSonuFormul</p>
                </Katlanir>
                <ul class="panel-liste" id="bugun-fark-duzelt">
                    @if (m.Satis.FaturasizSayisi > 0)
                    {
                        <li class="panel-liste-satir panel-liste-satir--is" id="bugun-faturasiz">
                            @* TOPLU-5 (hakem ORTA "gün sonunda aynı tutar iki ayrı biçimde"): faturasız tutar farkın KENDİSİYSE
                               (yukarıda kalın yazılı) ikinci kez küçük biçimde basılmaz; adet kalır. *@
                            <span class="panel-liste-ad">@string.Format(DG.FaturasizAdet, m.Satis.FaturasizSayisi)@(m.Satis.FaturasizTl == m.Fark ? "" : " · " + Bicim.TlKurus(m.Satis.FaturasizTl))</span>   @* DEGISIM-GUNSONU: fark satırı zaten "Faturası kesilmemiş satış" der — burada adet *@
                            <a class="dugme dugme-kucuk dugme-ikincil" href="/faturalar" id="bugun-fatura-kes">@B.FaturaKes</a>
                        </li>
                    }
                    @if (m.FaturaEslesme is { BagimsizSayisi: > 0 } fe)
                    {
                        <li class="panel-liste-satir panel-liste-satir--is" id="bugun-bagsiz-fatura">
                            <span class="panel-liste-ad">@string.Format(B.BagsizFatura, fe.BagimsizSayisi) · @Bicim.TlKurus(fe.BagimsizTl)</span>
                            <a class="dugme dugme-kucuk dugme-ikincil" href="/faturalar" id="bugun-faturalara-bak">@B.FaturalaraBak</a>
                        </li>
                    }
                    @if (m.Satis.FaturasizSayisi == 0 && (m.FaturaEslesme?.BagimsizSayisi ?? 0) == 0)
                    {
                        <li class="panel-liste-satir panel-liste-satir--is" id="bugun-fark-genel">
                            <a class="dugme dugme-kucuk dugme-ikincil" href="/faturalar" id="bugun-faturalari-kontrol">@B.FaturalariKontrolEt</a>
                        </li>
                    }
                </ul>
            }
            @* Anayasa md.1: sunucunun uyarıları basit modda da GİZLENMEZ.
               ZO-BELGE (27.09, 1440 ölçümü): uyarılar yukarıdaki düzeltme satırlarını
               ikinci kez anlatıyordu ve kartı 1 ekranın dışına itiyordu → SAYISI
               başlıkta yazan kapalı "Ayrıntı" katlanırına taşındı (silinmedi). *@
            @if (GunSonuUyarilari(m) is { Count: > 0 } notlar)
            {
                @* DEGISIM-2 (hakem DÜŞÜK "'Ayrıntı 1/2' neyi sayıyor"): sayı başlıkta ADIYLA ("Ayrıntı (2 uyarı)"), çıplak rozet yok. *@
                <Katlanir Id="bugun-gun-sonu-notlar" Baslik="@string.Format(DG.NotlarUyariSayili, notlar.Count)"
                          Sinif="zo-gun-sonu-notlar">
                    @foreach (var u in notlar)
                    {
                        <p class="metin-kucuk metin-soluk bugun-gun-sonu-uyari">@u</p>
                    }
                </Katlanir>
            }
        }
    </section>;

    // DEGISIM-GUNSONU: PRO tahsilat alt metni Raporlar.GunSonu.cs TahsilatAltMetni (sıfır kalem yok, kalem sınırında kırılır);
    // PARA-DEMO md.1 kuralı (alt kalemler toplamı = toplam, "Diğer" yalnız sıfır değilse) korunur.

    private async Task AylikYukle()
    {
        aylikYukleniyor = true;
        hata = null;
        try
        {
            await SubeliSorgu.HazirAsync(Oturum);   // ŞUBE-KAPSAM-B: seçili şube
            aylik = await Api.GetAsync<AylikYanit>(SubeliSorgu.Ekle($"/raporlar/aylik?yil={yil}&ay={ay}", Oturum));
        }
        catch (ApiHata ex) { aylik = null; hata = ex.Message; }
        aylikYukleniyor = false;
        // G-5: satış ödeme kırılımı aynı YIL/AY dönemini izler.
        await SatisKirilimiYukle();
    }

    // ── PAKET G-5 — SATIŞLAR NEYLE ÖDENDİ (sunucu hesabı) ─────────────────────
    private SatisKirilimi? satisKirilimi;
    private bool skYukleniyor;
    private string? skHata;
    private SatisKirilimiMetinleri SK => SatisKirilimiSozlugu.Al(Dil.Dil);

    private async Task SatisKirilimiYukle()
    {
        skYukleniyor = true;
        skHata = null;
        var bas = new DateOnly(yil, ay, 1);
        var bit = bas.AddMonths(1).AddDays(-1);
        try
        {
            var y = await Api.GetAsync<SatisOdemeKirilimiYaniti>(SubeliSorgu.Ekle(
                $"/raporlar/odeme-araci?baslangic={Bicim.Makine(bas)}&bitis={Bicim.Makine(bit)}", Oturum));
            satisKirilimi = y?.SatisKirilimi;
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            // UX-S28: hata "satış yok"a çevrilmez — bant görünür, kart boş durum basmaz.
            satisKirilimi = null;
            skHata = ex.Message;
        }
        skYukleniyor = false;
    }

    /// <summary>
    /// Ham araç kodu ekrana BASILMAZ (UX-S31). Nakit/Kart/Havale/Döviz/Veresiye
    /// mevcut ödeme adlarından (tek ad), eski altın ve kayıtsız G-5 sözlüğünden.
    /// </summary>
    private string SatisAracAdi(string arac) => arac switch
    {
        "NAKIT" => Dil.T.Islem.OdemeNakit,
        "KART" => Dil.T.Islem.OdemeKart,
        "HAVALE" => Dil.T.Islem.OdemeHavale,
        "DOVIZ" => Dil.T.Islem.OdemeDoviz,
        "VERESIYE" => Dil.T.Islem.OdemeVeresiye,
        "ALTIN" => SK.EskiAltinMahsup,
        "BILINMIYOR" => SK.Kayitsiz,
        _ => SK.Diger,
    };

    // ── P-25 / Y-16 — R15 STOK YAŞLANDIRMA (sunucu zarfıyla BİREBİR) ───────
    // Yanıt tipi Kuyumcu.Web/Servisler/RaporServisi.cs'tedir; sayfa içinde
    // istemci tipi TANIMLANMAZ (denetim.sh SAYFA_RECORD_TAVAN kapısı).
    private StokYaslandirmaYaniti? yaslandirma;

    /// <summary>KAR-RAPOR-2: kova alt satırı — adet + altın dışı madenlerin gramı (has toplamına katılmaz).
    /// MADEN-AYRIMI (hasım DÜŞÜK): "Gümüş: 138,750 g" (saf, 3 hane, birimi belirsiz) → "Gümüş: 150,00 g (saf 138,75 g)".</summary>
    private string KovaAlt(YasKovasiDto kv)
    {
        var adet = $"{Dil.T.RaporSeti.Adet}: {Bicim.Miktar(kv.Adet, null)}";
        var diger = (kv.MadenKirilimi ?? [])
            .Where(m => m.Maden != Kuyumcu.Core.Domain.Maden.Altin && m.ToplamGram != 0m)
            .Select(m => string.Format(KR.KovaDigerMaden, KurKaynakAdi.MadenAdi(m.Maden, m.MadenAdi), MadenMiktari(m.Maden, m.ToplamGram, m.FizikselGram)))
            .ToList();
        return diger.Count == 0 ? adet : $"{adet} · {string.Join(" · ", diger)}";
    }
    /// <summary>MADEN-AYRIMI — tek kural (Bicim.MadenMiktari): altın "has", diğer madenler kendi biriminde.</summary>
    private string MadenMiktari(string? maden, decimal saf, decimal? fiziksel) =>
        Bicim.MadenMiktari(maden, saf, fiziksel, KR.MadenGramFizikselSaf, KR.MadenGramSaf);

    // ── RAPOR-GORUNUM — Stok değeri tablosu ──
    /// <summary>Altın dışı madende tartı gramı biliniyorsa HER satır aynı kalıp "X g (saf Y g)" — stoğu 0 satır da
    /// ("0,00 g (saf 0,00 g)"); aynı sekmede gümüş için iki biçim olmaz. Altın Bicim.Has.</summary>
    private string MadenTamMiktari(string? maden, decimal saf, decimal? fiziksel) =>
        Bicim.MadenMiktariTam(maden, saf, fiziksel, KR.MadenGramFizikselSaf, KR.MadenGramSaf);
    private string StokMiktari(StokUrun s) => MadenTamMiktari(s.Maden, s.ToplamHas, s.FizikselGram);
    /// <summary>Sıra: altın önce, maden içinde miktara göre — SUNUCU sırası (tüm sayfalarda tutarlı).</summary>
    // Tur 2 (hasım DÜŞÜK): sıralama SUNUCUDA (RaporServisi.StokDegeri — sayfalamadan ÖNCE); istemci sayfayı yeniden
    // sıralamaz, yoksa 2. sayfa genel sırayla çelişirdi.
    private IEnumerable<StokUrun> StokSatirlari => stokUrunleri;
    private List<StokMadenToplami> StokDigerMadenToplamlari =>
        [.. stokMadenleri.Where(m => !MadenAltinMi(m.Maden))];
    private List<StokMadenToplami> stokMadenleri = [];
    /// <summary>Stok yaşı: oranlar 2 hane, gün tam sayı (tek kural).</summary>
    private static string Oran(decimal n) => Bicim.Oran(n);
    private static string GunSayi(decimal n) => Bicim.GunSayisi(n);
    private int syEsikGun = 180;
    private int syPencereGun = 90;
    private string? syHata;

    /// <summary>Eşik değişti — sayısal alan decimal? döner, gün TAM SAYIDIR.</summary>
    private Task EsikDegisti(decimal? v)
    {
        syEsikGun = v is { } d ? (int)d : 0;
        return StokYaslandirmaYukle();
    }

    /// <inheritdoc cref="EsikDegisti"/>
    private Task PencereDegisti(decimal? v)
    {
        syPencereGun = v is { } d ? (int)d : 0;
        return StokYaslandirmaYukle();
    }

    private async Task StokYaslandirmaYukle()
    {
        // UX-S30: geçersiz eşikte sunucuya gitmeden alan altı mesaj basılır;
        // sessiz etkisizlik YASAK.
        if (syEsikGun < 1 || syEsikGun > 3650 || syPencereGun < 1 || syPencereGun > 3650)
        {
            syHata = Dil.T.RaporSeti.SinirUyarisi;
            // B-64: geçersiz süzgeçte ESKİ TABLO GEÇERSİZLEŞTİRİLİR — eski
            // sonucu ekranda bırakmak, kullanıcıya yeni eşiğin sonucuymuş gibi
            // görünürdü (QA turu 5 bulgusu, rota /vezne ile aynı kusur).
            yaslandirma = null;
            return;
        }

        syHata = null;
        // B-64: yeni istek başlarken eski tablo geçersizleştirilir; yükleme
        // göstergesi çıkar, bayat satırlar ekranda kalmaz.
        yaslandirma = null;
        try
        {
            // ŞUBE-KAPSAM-B: stok yaşlandırma seçili şubenin rafı.
            yaslandirma = await RaporSetiServisi.StokYaslandirma(subeId: SubeliSorgu.Sube(Oturum),
                oluEsikGun: syEsikGun, devirPenceresiGun: syPencereGun);
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            // UX-S28: hata "kayıt yok"a ÇEVRİLMEZ.
            syHata = ex.Message;
        }
    }

    // ── PAKET 25 — reyon stok raporu (sunucu zarfıyla BİREBİR) ──────────────
    // Yanıt şekilleri ORTAK sözleşmededir (S-2 dersi):
    //   Kuyumcu.Core/Sozlesmeler/YerlesimSozlesmeleri.cs

    private ReyonStokYaniti? reyonStok;
    private List<SubeOzeti> rsSubeler = [];
    private List<ReyonSatiri> rsReyonlar = [];
    private string rsSubeId = "", rsReyonId = "";
    private string? rsHata;

    // ZO-BELGE 28.09 — reyon stok süzgeci ortak Secici ile (yerel <select> yerine).
    private IReadOnlyList<SecenekOgesi> RsSubeSecenekleri =>
        [.. rsSubeler.Select(s => new SecenekOgesi(s.Id, s.Ad))];
    private IReadOnlyList<SecenekOgesi> RsReyonSecenekleri =>
        [.. rsReyonlar.Where(x => string.IsNullOrEmpty(rsSubeId) || x.SubeId == rsSubeId)
                      .Select(r => new SecenekOgesi(r.Id, r.Ad))];

    /// <summary>Tur 3: reyon kartının şubesi sayfanın görünüm şubesinden farklı mı?</summary>
    private bool RsSubeFarkli =>
        (string.IsNullOrEmpty(rsSubeId) ? null : rsSubeId) != SubeliSorgu.Sube(Oturum);

    private async Task RsSubeDegisti(string? v)
    {
        rsSubeId = v ?? "";
        await ReyonStokYukle();
    }

    private async Task RsReyonDegisti(string? v)
    {
        rsReyonId = v ?? "";
        await ReyonStokYukle();
    }

    private async Task ReyonStokYukle()
    {
        rsHata = null;
        try
        {
            var sorgu = new List<string>();
            if (!string.IsNullOrEmpty(rsSubeId)) sorgu.Add($"subeId={rsSubeId}");
            if (!string.IsNullOrEmpty(rsReyonId)) sorgu.Add($"reyonId={rsReyonId}");
            var ek = sorgu.Count > 0 ? "?" + string.Join("&", sorgu) : "";
            reyonStok = await Api.GetAsync<ReyonStokYaniti>($"/raporlar/reyon-stok{ek}");
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            // UX-S28: hata boş sonuca çevrilmez.
            rsHata = ex.Message;
        }
    }

    private async Task DigerleriniYukle()
    {
        try
        {
            var yanit = await Api.GetAsync<YaslandirmaYaniti>("/raporlar/cari-yaslandirma");
            yaslananlar = yanit.YaslananCariler ?? [];
            yaslandirmaToplamSatir = yanit.ToplamSatir;
            yaslandirmaDahaFazlasiVar = yanit.DahaFazlasiVar;
            yasOzetDoviz = yanit.OzetDoviz ?? new();
        }
        catch (ApiHata ex) { hata = ex.Message; }

        try
        {
            var yanit = await Api.GetAsync<StokYaniti>(SubeliSorgu.Ekle("/raporlar/stok-degeri", Oturum));
            stokUrunleri = yanit.Urunler ?? [];
            stokToplamHas = yanit.ToplamHas;
            stokMadenleri = yanit.MadenDagilimi ?? [];
        }
        catch (ApiHata ex) { hata = ex.Message; }

        // Süzgeç verisi YARDIMCIDIR: alınamazsa rapor ekranı yine açılır, ama
        // hata yutulmaz — süzgecin yerinde bandda görünür (UX-S28).
        try
        {
            rsSubeler = await Api.GetAsync<List<SubeOzeti>>("/subeler");
            rsReyonlar = await Api.GetAsync<List<ReyonSatiri>>("/reyonlar");
        }
        catch (Exception ex) when (ex is ApiHata or JsonException) { rsHata = ex.Message; }

        await ReyonStokYukle();
    }

    // Cari, yalnızca kendi dilim sütununda bakiyesini gösterir; diğer sütunlar 0.
    private static decimal Dilim(YaslananCari y, string dilim) =>
        y.Dilim == dilim ? y.TlBakiye : 0m;

    // ── P-47 — has bakiyesi AYRI okunur ─────────────────────────────────────
    // Satır "boş" ancak TL, has VE döviz bakiyesinin ÜÇÜ de sıfırsa sayılır.
    // Eski hâl yalnız TL'ye bakıyordu: TL=0 / has=-16,946 g olan cari ekranda
    // "0,00 ₺" satırı olarak okunuyordu (gizli alacak).
    public static bool YasSatiriBos(YaslananCari y) =>
        y.TlBakiye == 0m && y.HasGramBakiye == 0m && !y.DovizBakiyesiVar;

    /// <summary>TL bakiyesi sıfır ama has bakiyesi dolu — satır vurgulanır, rozet basar.</summary>
    public static bool YalnizHasBakiyesi(YaslananCari y) =>
        y.TlBakiye == 0m && y.HasGramBakiye != 0m;

    // ── PAKET RAPOR-YASLANDIRMA ─────────────────────────────────────────────
    private RaporYaslandirmaMetinleri RY => RaporYaslandirmaSozlugu.Al(Dil.Dil);
    private Dictionary<string, decimal> yasOzetDoviz = new();

    // ── TOPLU-3 — yaşlandırma tablosu görünümü (hesap DEĞİŞMEDİ) ───────────
    private Toplu3Metinleri T3 => Toplu3Sozlugu.Al(Dil.Dil);

    /// <summary>TOPLU-3: listelenen satırlardan en az birinde has bakiyesi var mı. Yoksa dar
    /// ekranda (≤ 1365 px) has sütunu GİZLENİR (hakem YÜKSEK "8 sütun sıkışık" — ikincil sütun);
    /// has bakiyesi olan tabloda sütun HER genişlikte durur (P-47).</summary>
    private bool YasHasVar => GorunenYaslananlar.Any(y => y.HasGramBakiye != 0m);

    /// <summary>Tablo kolon sayısı: cari + 4 dilim + (tarihsiz) + TL toplam + has.</summary>
    private int YasKolonSayisi => 7 + (YasBelirsizVar ? 1 : 0);

    /// <summary>TL hücresi: sıfır tutar "yas-sifir" sınıfı alır (ekranda "—", ekran okuyucu "0 ₺" okur);
    /// data-etiket dar ekranda satır kartının hücre adıdır.</summary>
    private RenderFragment YasTlHucre(string sinif, string etiket, decimal tutar, string? id = null) =>
        @<td class="@($"sayi {sinif}{(YasSifirMi(tutar) ? " yas-sifir" : "")}{(tutar < 0m && !YasSifirMi(tutar) ? " yas-eksi" : "")}")" id="@id" data-etiket="@etiket"><span class="yas-deger">@Bicim.TlKurus(tutar)</span></td>;

    /// <summary>Saf kural (test edilebilir): hücre "—" ile mi çizilir.</summary>
    public static bool YasSifirMi(decimal tutar) => tutar == 0m;

    /// <summary>TOPLU-3 (hakem ORTA): döviz rozeti YÖN taşır — artı = cari bize borçlu
    /// (TL ile aynı işaret kuralı), eksi = biz cariye borçluyuz. Tutar mutlak değerle yazılır.</summary>
    public static string DovizYonMetni(IReadOnlyDictionary<string, decimal>? bakiyeler, Toplu3Metinleri m) =>
        string.Join(" · ", (bakiyeler ?? new Dictionary<string, decimal>())
            .Where(kv => kv.Value != 0m)
            .Select(kv => string.Format(kv.Value > 0m ? m.YasDovizBizeBorclu : m.YasDovizBizBorcluyuz,
                                        Bicim.BelgePara(Math.Abs(kv.Value), kv.Key))));

    /// <summary>"Tarihsiz" sütunu yalnız böyle bir satır varsa çizilir.</summary>
    private bool YasBelirsizVar => GorunenYaslananlar.Any(y => y.Dilim == "BELIRSIZ");

    /// <summary>Sunucunun TÜM cariler için topladığı döviz bakiyeleri — yalnız sıfır olmayanlar.</summary>
    private Dictionary<string, decimal> YasDovizOzeti =>
        yasOzetDoviz.Where(kv => kv.Value != 0m).ToDictionary(kv => kv.Key, kv => kv.Value);

    /// <summary>Döviz bakiyelerini "1.000,00 $ · 100,00 £" biçiminde yazar (birim sunucudan gelir).</summary>
    public static string DovizMetni(IReadOnlyDictionary<string, decimal>? bakiyeler) =>
        string.Join(" · ", (bakiyeler ?? new Dictionary<string, decimal>())
            .Where(kv => kv.Value != 0m)
            .Select(kv => Bicim.BelgePara(kv.Value, kv.Key)));

    private List<YaslananCari> GorunenYaslananlar =>
        yaslananlar.Where(y => !YasSatiriBos(y)).ToList();

    private decimal DilimToplami(string dilim) =>
        GorunenYaslananlar.Sum(y => Dilim(y, dilim));

    // ⚠ TL toplamı YALNIZ TL'dir; has bakiyesi buraya ÇEVRİLEREK ya da ham
    // olarak EKLENMEZ (P47_03). Has kendi kolonunda ayrı toplanır.
    private decimal YasTlToplami => GorunenYaslananlar.Sum(y => y.TlBakiye);
    private decimal YasHasToplami => GorunenYaslananlar.Sum(y => y.HasGramBakiye);

    private static string GunEtiketi(string? tarih) =>
        DateTime.TryParse(tarih, CultureInfo.InvariantCulture, DateTimeStyles.None, out var t)
            ? Bicim.GunBicim(t, "dd.MM")
            : tarih ?? "";

    private void Yenile() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Dil.Degisti -= Yenile;
        Mod.Degisti -= ModDegisti;
        Oturum.Degisti -= ModDegisti;
    }
}
