    // ── Rapor Merkezi (paket 34 Faz A) ───────────────────────────────────
    private List<RaporKartiDto> katalog = [];
    private string? katalogHatasi;

    private async Task KatalogYukle()
    {
        try
        {
            var y = await RaporSetiServisi.Katalog();
            katalog = y.Raporlar ?? [];
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            // UX-S28: hata boş listeye ÇEVRİLMEZ; bandda görünür.
            katalogHatasi = ex.Message;
        }
        catch (Exception ex) when (AgHatasi(ex)) { katalogHatasi = ZB.BaglantiHatasi; }
    }

    /// <summary>ZO-BELGE 29.09 (doğrulayıcı ORTA, KIYAS #3): ağ hatası ve zaman aşımı da
    /// hata bandına yazılır; yükleniyor bayrağı finally içinde iner (sonsuz gösterge yok).</summary>
    internal static bool AgHatasi(Exception ex) => ex is HttpRequestException or OperationCanceledException;

    protected override async Task OnInitializedAsync()
    {
        Dil.Degisti += Yenile;
        Mod.Degisti += ModDegisti;
        // ZO-BELGE 29.09 (doğrulayıcı KRİTİK, sert yükleme): F5/yeni sekmede profil (/auth/ben)
        // sayfadan SONRA gelir ve AnaYerlesim onu Oturum.KullaniciAta ile yazar — bu
        // Mod.Degisti tetiklemez. Etkin mod PRO→BASİT döndüğünde BASİT yükleyicileri
        // hiç başlamıyor, 5 kart "Yükleniyor"da donuyordu. Oturum olayında da yüze göre
        // yükle (bayraklarla tek sefer; aynı yüz iki kez istek atmaz).
        Oturum.Degisti += ModDegisti;
        await YuzeGoreYukle();
    }

    // ══ PAKET S3-4 — YÜZE GÖRE YÜKLEME ═══════════════════════════════════════
    // Her yüz YALNIZ kendi isteklerini atar; mod çalışırken değişirse eksik
    // yüzün yükleyicileri O AN (bir kez) açılır. Profesyonel yüzün sırası
    // DEĞİŞMEDİ (paket öncesi OnInitializedAsync gövdesi birebir).
    private bool bugunYuklendi, proYuklendi;

    private async Task YuzeGoreYukle()
    {
        if (Mod.BasitMi)
        {
            if (bugunYuklendi) return;
            bugunYuklendi = true;
            await Task.WhenAll(BugunOzetYukle(), BugunMutabakatYukle(), BugunBildirimYukle(), BugunAyrimYukle());
        }
        else
        {
            if (proYuklendi) return;
            proYuklendi = true;
            // ŞUBE-KAPSAM-B: reyon stoku süzgeci bakılan şubeyle açılır.
            await SubeliSorgu.HazirAsync(Oturum);
            rsSubeId = SubeliSorgu.Sube(Oturum) ?? "";
            await AylikYukle();
            await KatalogYukle();
            await StokYaslandirmaYukle();
            await DigerleriniYukle();
            await MutabakatYukle();
        }
    }

    /// <summary>
    /// ŞUBE-KAPSAM-B — görünüm şubesi değişti: açık yüzün ŞUBELİ verileri yeniden
    /// yüklenir. Kiracı geneli olanlar (cari yaşlandırma) şubeye bölünmez.
    /// </summary>
    private async Task GorunumDegisti()
    {
        if (Mod.BasitMi)
        {
            if (!bugunYuklendi) return;
            bugunOzetHata = null;
            bugunOzetYukleniyor = true;
            bugunMutabakatHata = null;
            bugunMutabakatYukleniyor = true;
            await Task.WhenAll(BugunOzetYukle(), BugunMutabakatYukle(), BugunAyrimYukle());
            return;
        }
        if (!proYuklendi) return;
        rsSubeId = SubeliSorgu.Sube(Oturum) ?? "";
        await AylikYukle();
        await StokYaslandirmaYukle();
        await DigerleriniYukle();
        await MutabakatYukle();
    }

    private void ModDegisti() => InvokeAsync(async () =>
    {
        StateHasChanged();
        await YuzeGoreYukle();
        StateHasChanged();
    });

    // ══ PAKET S3-4 — "BUGÜN" TEK SAYFA (basit yüz) ═══════════════════════════
    // Tuval: Panel.dc.html'in soru kartları (aynı görsel dil, aynı sınıflar —
    // .panel-sade / .panel-soru, S3-1'in belirteçli CSS'i; yeni CSS YAZILMADI).
    // ⚠ UX-S21: tarih İSTEMCİDEN gönderilmez — "bugün" sunucunun işletme
    //   gününe (Europe/Istanbul) göre çözülür (/raporlar/gunluk ve
    //   /raporlar/pos-fatura-mutabakati tarih verilmezse Zaman.YerelBugun()).
    // ⚠ UX-S28: hata "0 ₺"a / "kayıt yok"a çevrilmez; 403 ayrı yetki notudur.
