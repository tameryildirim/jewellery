    private Toplu5Metinleri T5 => Toplu5Sozlugu.Al(Dil.Dil);


    private async Task BugunMutabakatYukle()
    {
        try
        {
            // ŞUBE-KAPSAM-B: gün sonu seçili şubeye göre (yol, seçim yokken UyumServisi.BugunMutabakati ile AYNI).
            await SubeliSorgu.HazirAsync(Oturum);
            bugunMutabakat = await RaporSetiServisi.PosFaturaMutabakati(null, SubeliSorgu.Sube(Oturum));
        }
        catch (ApiHata ex) when (ex.StatusCode == 403) { bugunMutabakatYetkiYok = true; }
        catch (Exception ex) when (ex is ApiHata or JsonException) { bugunMutabakatHata = ex.Message; }
        catch (Exception ex) when (AgHatasi(ex)) { bugunMutabakatHata = ZB.BaglantiHatasi; }
        finally { bugunMutabakatYukleniyor = false; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task BugunBildirimYukle()
    {
        try
        {
            var y = await Api.GetAsync<BildirimSz.Yanit>($"/bildirimler?durum=ACIK&limit={BugunBildirimSinir}");
            // RAPOR-2 tur 2: Panel.razor ile AYNI süzgeç — nakit sınırı aşımı şeritte sayılır, listede değil.
            bugunBildirimler = y.Satirlar.Where(b => b.IlgiliVarlikTuru != "TevsikIhlali").ToList();
            bugunNakitAyrildi = y.Satirlar.Count - bugunBildirimler.Count;
            bugunBildirimDahaFazla = y.DahaFazlasiVar;
        }
        catch (ApiHata ex) when (ex.StatusCode == 403) { bugunBildirimYetkiYok = true; }
        catch (Exception ex) when (ex is ApiHata or JsonException) { bugunBildirimHata = ex.Message; }
        catch (Exception ex) when (AgHatasi(ex)) { bugunBildirimHata = ZB.BaglantiHatasi; }
        finally { bugunBildirimYukleniyor = false; }
        await BugunUyumYukle();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>PAKET RAPOR-2: Panel'in uyum sayaçlarıyla AYNI uçlar ve AYNI toplam (Panel.razor BekleyenYok /
    /// UyumSatiri). Yetkisiz rolde istek ATILMAZ; hata "iş yok"a çevrilmez (UX-S28).</summary>
    private async Task BugunUyumYukle()
    {
        if (!BugunUyumGorebilir) return;
        try
        {
            var m = await Uyum.Ozet();
            var s = await Uyum.SureTakibi();
            var r = await Uyum.RiskOzet();
            bugunUyumSayisi = m.SuresiGecmis + m.Yaklasan + s.GecikmisSayisi + s.YaklasanSayisi + r.Yuksek;
        }
        catch (Exception ex) when (ex is ApiHata or JsonException) { bugunUyumHata = ex.Message; }
        catch (Exception ex) when (AgHatasi(ex)) { bugunUyumHata = ZB.BaglantiHatasi; }
        // PAKET RAPOR-3 (hasım DÜŞÜK): stopaj AYRI denenir (Panel Y4-B deseni) — stopaj okunamazsa öbür sayaçlar
        // yine sayılır; stopajın hatası kendi bandında (UX-S28: "iş yok"a çevrilmez).
        try
        {
            var st = await Uyum.StopajOzeti();
            bugunUyumSayisi += (st.Gecikmis?.Count ?? 0) + (st.Yaklasan?.Count ?? 0);
        }
        catch (Exception ex) when (ex is ApiHata or JsonException) { bugunStopajHata = ex.Message; }
        catch (Exception ex) when (AgHatasi(ex)) { bugunStopajHata = ZB.BaglantiHatasi; }
    }

    private int BugunSatisAdet => bugunOzet?.Satis?.Adet ?? 0;
    // PAKET RAPOR-2 tur 2: NET (Panel ve Kâr-zarar ile aynı tanım); alan yoksa (eski yanıt) brüt.
    private int BugunIadeAdet => bugunOzet?.NetSatis?.IadeAdet ?? 0;
    private decimal BugunSatisTl => bugunOzet?.NetSatis?.ToplamTl ?? bugunOzet?.Satis?.ToplamTl ?? 0m;
    private decimal BugunSatisHas => bugunOzet?.NetSatis?.AltinToplamHas ?? bugunOzet?.Satis?.ToplamHas ?? 0m;
    private int BugunAlisAdet => bugunOzet?.Alis?.Adet ?? 0;
    private decimal BugunHurdaTl => bugunOzet?.Hurda?.OdenenTl ?? 0m;
    private decimal BugunHurdaHas => bugunOzet?.Hurda?.ToplamHas ?? 0m;

    /// <summary>PAKET RAPOR-2: sunucunun maden dağılımından ALTIN DIŞI (ve sıfır olmayan) madenler — altın önce
    /// gelen sunucu sırası korunur; gramlar TOPLANMAZ (K20-2).</summary>
    private static List<PanelSz.GunlukMadenPayi> AltinDisiMadenler(List<PanelSz.GunlukMadenPayi>? l) =>
        [.. (l ?? []).Where(m => !string.IsNullOrEmpty(m.Maden) && m.Maden != Kuyumcu.Core.Domain.Maden.Altin && Math.Abs(m.ToplamHas) >= GramGosterimEsigi)];

    /// <summary>RAPOR-2 tur 2 (hasım DÜŞÜK): saf gram 2 hanede gösterilir — 0,005 g altı "saf 0,00 g" satırı ÜRETMEZ
    /// (Panel.HasGosterimEsigi ile aynı ilke: görüntü hassasiyetinden küçük değer satır açmaz).</summary>
    internal const decimal GramGosterimEsigi = 0.005m;

    /// <summary>PAKET RAPOR-2: has (altın) satırı ancak altın varsa ya da başka maden YOKSA yazılır —
    /// yalnız gümüş alınan gün "0,0000 has" yazmaz.</summary>
    private static bool HasSatiriGerekli(decimal altinHas, List<PanelSz.GunlukMadenPayi>? l) =>
        altinHas != 0m || AltinDisiMadenler(l).Count == 0;

    private string BugunMadenMetni(PanelSz.GunlukMadenPayi m) =>
        string.Format(KR.BugunMadenSatiri, PozisyonSozlugu.MadenAdi(m.Maden!, Dil.Dil),
            Bicim.MadenMiktari(m.Maden, Math.Abs(m.ToplamHas), null, KR.MadenGramFizikselSaf, KR.MadenGramSaf));

    /// <summary>
    /// Kasalar para birimine göre gruplanır; TL önce gelir. Farklı para birimleri
    /// ASLA toplanmaz (UX-S32) — her grup kendi satırında, kendi birimiyle.
    /// </summary>
    internal List<PanelSz.PanelKasaGrubu> BugunKasaGruplari =>
    [
        .. (bugunOzet?.Kasalar ?? [])
            .GroupBy(k => string.IsNullOrEmpty(k.ParaBirimi) ? "TRY" : k.ParaBirimi)
            .OrderBy(g => g.Key == "TRY" ? 0 : 1).ThenBy(g => g.Key, StringComparer.Ordinal)
            .Select((g, i) => new PanelSz.PanelKasaGrubu(i, g.Key, g.Sum(k => k.Bakiye), [.. g])),
    ];

    /// <summary>
    /// PAKET ZO-BELGE — HAS MİKTARI 4 HANE (P-57; doğrulayıcı 27.09 KRİTİK: "0,0004"
    /// F3 ile "0,000" olup kayboluyordu). TEK merkez Bicim.Has → "13,8760 has";
    /// eksi işareti U+2212 (−) korunur. İşlem defteri özeti ve Has sütunu da
    /// AYNI biçimi kullanır.
    /// </summary>
    // RAPOR-GORUNUM (veri a): Panel ile TEK biçim kaynağı (Bicim.HasIsaretli) — iki ekran aynı sayı.
    private string BugunHas(decimal gram) => Bicim.HasIsaretli(gram, KR.HasBirimKisa);   // örnek metot: ZOBELGE sınır testleri yansıma ile çağırır

    /// <summary>ZO-BELGE 28.09 (UX-S31, doğrulayıcı ORTA): rapor merkezindeki İşlem defteri (R10) ve
    /// Kasa raporu (R11) düğmeleri, gittikleri sayfanın başlığıyla ve menü adıyla AYNI adı taşır —
    /// tek kaynak MenuAdlari (hub sözlüğüne dokunulmadan). Diğer raporlar katalog adıyla.</summary>
    private string KatalogDugmeAdi(string kod) => kod switch
    {
        "R10" => MenuAdlari.Icin(Dil.Dil).IslemDefteri.Ad,
        "R11" => MenuAdlari.Icin(Dil.Dil).KasaRaporu.Ad,
        _ => Dil.T.RaporSeti.Ad(kod),
    };

