        catch (ApiHata ex) when (ex.StatusCode == 403) { bugunOzetYetkiYok = true; }
        catch (Exception ex) when (ex is ApiHata or JsonException) { bugunOzetHata = ex.Message; }
        catch (Exception ex) when (AgHatasi(ex)) { bugunOzetHata = ZB.BaglantiHatasi; }
        finally { bugunOzetYukleniyor = false; }
        await InvokeAsync(StateHasChanged);
    }

