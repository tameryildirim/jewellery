    // P35 ay sınırı (01.10): "bugün" tek kaynaktan — DI'da TimeProvider varsa o
    // (testler saati sabitler; 1'inde "bu ay" = "bugün" olur), yoksa sistem saati.
    // Yerel gün (tarayıcı saat dilimi) — UTC DEĞİL; davranış DateTime.Today ile aynı.
    private DateTime BugunYerel => (Sp.GetService<TimeProvider>() ?? TimeProvider.System).GetLocalNow().Date;
    private DateTime baslangic;
    private DateTime bitis;
    private bool yukleniyor = true;
    private string? hata;

    protected override async Task OnInitializedAsync()
    {
        bitis = BugunYerel;
        baslangic = new(bitis.Year, bitis.Month, 1);
        Dil.Degisti += Yenile;
        await Yukle();
    }

    // ═════════════════════════════════════════════════════════════════════════
    // UX-4d madde 22 — AYNI İSTEK 2× GİDİYORDU.
    // `@bind` + `@bind:after` tarih girdilerinde tek kullanıcı eylemi için iki
    // kez tetiklenebiliyor (değer değişimi + yeniden çizim). Sunucuya aynı
    // sorgu iki kez gidiyor, geçersiz aralıkta iki kez 400 alınıyordu.
    // Çözüm: aynı sorgu dizesi ÜST ÜSTE çalıştırılmaz.
    //
    // UX-4d madde 23 — GEÇERSİZ ARALIK: bitiş < başlangıç olduğunda istek hiç
    // atılmaz; alan altına Türkçe mesaj yazılır (sessiz etkisizlik yasağı).
    // ═════════════════════════════════════════════════════════════════════════
    private string? sonSorgu;
    private string karsilastir = "";
    private bool karsilastirAcik;
    private void KarsilastirmayiAc() => karsilastirAcik = true;

    /// <summary>Karşılaştırma seçenekleri — boş değer "karşılaştırma yok" (varsayılan KAPALI).</summary>
    private IReadOnlyList<SecenekOgesi> KarsilastirSecenekleri =>
    [
        new("", Dil.T.KarZarar.KarsilastirmaYok),
        new("ONCEKI_DONEM", Dil.T.KarZarar.OncekiDonem),
        new("GECEN_YIL", Dil.T.KarZarar.GecenYil),
    ];

    private async Task KarsilastirDegisti(string? deger)
    {
        karsilastir = deger ?? "";
        await Yukle();
    }
    internal string? AralikHatasi { get; private set; }

    // PAKET GOC-D — ortak Tarih alanı DateOnly taşır; sayfa durumu DateTime kalır (hazır dönem düğmeleri aynı yol).
    // Eksik/hatalı yazımda (null) eski değer korunur ve istek atılmaz; alan altında bileşenin kendi hatası görünür.
    private async Task BaslangicDegisti(DateOnly? v)
    {
        if (v is not { } g) return;
        baslangic = g.ToDateTime(TimeOnly.MinValue);
        await Yukle();
    }

    private async Task BitisDegisti(DateOnly? v)
    {
        if (v is not { } g) return;
        bitis = g.ToDateTime(TimeOnly.MinValue);
        await Yukle();
    }

    private async Task Yukle()
    {
        AralikHatasi = null;
        // PAKET GOC-D: ters aralık + pencere + 400 gün — sunucunun 400 metniyle AYNI kural (Core RaporDonemKurali).
        if (RaporDonemKurali.Denetle(DateOnly.FromDateTime(baslangic), DateOnly.FromDateTime(bitis),
                                     DateOnly.FromDateTime(Bicim.IsletmeBugun), Dil.Dil) is { } donem)
        {
            // PAKET RAPOR-3 (hasım DÜŞÜK): hata hem alan altında hem bantta (iki kez) çıkıyor, kartlar eski dönemin
            // rakamını gösteriyordu. Hata TEK yerde (alanın altında), kartlar gizli (eski özet atılır).
            AralikHatasi = donem.Mesaj;
            hata = null;
            ozet = null;
            sonSorgu = null;
            yukleniyor = false;
            return;
        }

        // ŞUBE-KAPSAM-B: şube de sorgunun parçasıdır — seçim değişince aynı tarih
        // aralığı yeniden çekilir (anahtar şubesiz olsaydı yeni şube YOK SAYILIRDI).
        await SubeliSorgu.HazirAsync(Oturum);
        var sube = SubeliSorgu.Sube(Oturum);
        var sorguAnahtari = $"{Bicim.Makine(baslangic)}|{Bicim.Makine(bitis)}|{karsilastir}|{sube}";
        if (sorguAnahtari == sonSorgu && !yukleniyor) return;
        sonSorgu = sorguAnahtari;

        yukleniyor = true;
        hata = null;
        try
        {
            var q = $"baslangic={Bicim.Makine(baslangic)}&bitis={Bicim.Makine(bitis)}";
            var kz = string.IsNullOrEmpty(karsilastir) ? q : $"{q}&karsilastir={karsilastir}";
            ozet = await Api.GetAsync<OzetVeri>(SubeliSorgu.Ekle($"/raporlar/kar-zarar?{kz}", Oturum));
            var uy = await Api.GetAsync<UrunYanit>(SubeliSorgu.Ekle($"/raporlar/kar-zarar/urun?{q}", Oturum));
            urunler = uy.Satirlar;
            urunDahaVar = uy.DahaFazlasiVar;
            urunToplam = uy.ToplamUrunSayisi;
            urunGenisletildi = false;
            urunDahaHata = null;
            stok = await Api.GetAsync<StokVeri>(SubeliSorgu.Ekle("/raporlar/stok-degerlemesi", Oturum));
        }
        catch (ApiHata ex) { hata = ex.Message; sonSorgu = null; }
        yukleniyor = false;
    }

    /// <summary>PAKET OLCEK-YUK t2 (UX-S29): sonraki ürün sayfasını (ofset = gösterilen satır sayısı) aynı
    /// dönem ve şubeyle ister, listeye ekler. Hata listeyi boşaltmaz (UX-S28) — bant düğmenin altında.</summary>
    private async Task UrunDahaFazla()
    {
        if (urunDahaYukleniyor || !urunDahaVar) return;
        urunDahaYukleniyor = true;
        urunDahaHata = null;
        try
        {
            var q = $"baslangic={Bicim.Makine(baslangic)}&bitis={Bicim.Makine(bitis)}&ofset={Bicim.Makine(urunler.Count)}";
            var uy = await Api.GetAsync<UrunYanit>(SubeliSorgu.Ekle($"/raporlar/kar-zarar/urun?{q}", Oturum));
            urunler = [.. urunler, .. uy.Satirlar];
            urunDahaVar = uy.DahaFazlasiVar && uy.Satirlar.Count > 0;
            urunToplam = uy.ToplamUrunSayisi;
            urunGenisletildi = true;
        }
        catch (ApiHata ex) { urunDahaHata = ex.Message; }
        urunDahaYukleniyor = false;
    }

    private async Task Donem(int aySapmasi)
    {
        var bugun = BugunYerel;
        var ilk = new DateTime(bugun.Year, bugun.Month, 1).AddMonths(aySapmasi);
        baslangic = ilk;
        bitis = aySapmasi == 0 ? bugun : ilk.AddMonths(1).AddDays(-1);
        await Yukle();
    }

    /// <summary>PAKET RAPOR-2: seçili dönem hangi ön ayara denk geliyor (yoksa null — elle tarih).
    /// Ayın 1'inde "bu ay" = "bugün" olur; o gün "bu ay" vurgulanır.</summary>
    private string? SeciliOnAyar
    {
        get
        {
            var bugun = BugunYerel.Date;
            var ayBasi = new DateTime(bugun.Year, bugun.Month, 1);
            if (baslangic.Date == ayBasi && bitis.Date == bugun) return "bu-ay";
            if (baslangic.Date == bugun && bitis.Date == bugun) return "bugun";
            var gecenBasi = ayBasi.AddMonths(-1);
            if (baslangic.Date == gecenBasi && bitis.Date == ayBasi.AddDays(-1)) return "gecen-ay";
            return null;
        }
    }

    private async Task Bugun()
    {
        baslangic = bitis = BugunYerel;
        await Yukle();
    }

