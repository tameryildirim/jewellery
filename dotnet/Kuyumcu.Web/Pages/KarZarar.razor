    // ═════════════════════════════════════════════════════════════════════════
    // P-64 — DELTA BİÇİMİ
    // Eski DegisimMetni yüzde null iken HİÇBİR ŞEY basmıyordu: kullanıcı
    // "karşılaştırma çalışmadı" mı "önceki dönem sıfır" mı ayırt edemiyordu.
    // Artık: ▲/▼ + mutlak yüzde; null → "—" (0% UYDURULMAZ, Anayasa md.1).
    // ═════════════════════════════════════════════════════════════════════════
    private RaporGrafikMetinleri G => RaporGrafikSozlugu.Al(Dil.Dil);

    internal static string DeltaMetni(decimal? yuzde) => yuzde switch
    {
        null => "—",
        > 0m => $"▲ %{YuzdeSayisi(yuzde.Value)}",
        < 0m => $"▼ %{YuzdeSayisi(Math.Abs(yuzde.Value))}",
        _ => "%0",
    };

    /// <summary>Bicim.Tl ile aynı kültür (tr-TR): tarayıcı kültürüne göre değişmez.</summary>
    private static string YuzdeSayisi(decimal v)
        => v.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));

    private string DegisimMetni(decimal? yuzde) => $"{Dil.T.KarZarar.Degisim}: {DeltaMetni(yuzde)}";

    /// <summary>KPI kartı alt metni — YALNIZ karşılaştırma seçiliyken (önceki dolu) basılır.</summary>
    private string? KpiDelta(OzetVeri o, decimal? yuzde)
        => o.Onceki is null ? null : $"{DeltaMetni(yuzde)} {G.OncekiyeGore}";

    private static string? AltBirlestir(string? a, string? b)
        => string.IsNullOrEmpty(a) ? b : string.IsNullOrEmpty(b) ? a : $"{a} · {b}";

    private static bool YuzdeEksik(OzetVeri o)
        => o.DegisimYuzde is null
           || o.DegisimYuzde.HasilatTlYuzde is null
           || o.DegisimYuzde.DonemKariTlYuzde is null;

    /// <summary>KAR-RAPOR-2 tur 2: karşılaştırılan dönemde bilinmeyen (null) olup bu dönemde çizilen kalemler.
    /// Onların 2. seri çubuğu yüksekliği 0 olarak çizilmez; ekran altına "bilinmiyor" notu düşer.</summary>
    private List<string> OncekiBilinmeyenler(OzetVeri o)
    {
        var l = new List<string>();
        if (o.Onceki is not { } onc) return l;
        if (o.MaliyetTl is not null && onc.MaliyetTl is null) l.Add(Dil.T.KarZarar.Maliyet);
        if (o.KarTl is not null && onc.KarTl is null) l.Add(Dil.T.KarZarar.Kar);
        if (o.DonemKariTl is not null && onc.DonemKariTl is null) l.Add(Dil.T.KarZarar.DonemKari);
        return l;
    }

    /// <summary>RAPOR-GORUNUM (veri d): kâr bilinen kümeden hesaplanmışsa (KISMI) hasılat çubuğu da o kümedir;
    /// TAM'da iki küme aynıdır, kâr hesaplanamadıysa yalnız toplam hasılat çizilir (kâr çubuğu yok).</summary>
    /// <summary>Tur 2: satır altın dışı madende mi (boş/null ALTIN sayılır — sunucu kuralı).</summary>
    private static bool AltinDisiMi(string? maden) =>
        !string.IsNullOrEmpty(maden) && maden != Kuyumcu.Core.Domain.Maden.Altin;
    private static bool GrafikHasilatBilinenMi(OzetVeri o) => KismiMi(o) && o.BilinenHasilatTl != o.HasilatTl;
    /// <summary>Karşılaştırılan dönem de kendi kümesiyle çizilir (sunucu onceki.bilinenHasilatTl).</summary>
    private static bool OncekiHasilatBilinenMi(KarZararOnceki? on) =>
        on is { KarTl: not null, BilinenHasilatTl: { } obh } && obh != on.HasilatTl;

    /// <summary>Çubuk grafik: 1. seri seçilen dönem, 2. seri karşılaştırılan dönem (yoksa 0).</summary>
    private List<CiftNokta> GelirGiderNoktalari(OzetVeri o) =>
    [
        // RAPOR-GORUNUM (veri d): kâr hesaplanabiliyorsa hasılat çubuğu kârla AYNI kümedir (bilinen satış).
        // Eksen etiketi kısa ("Satış") — dar sütunda kırılmaz (ölçer K3); kümeyi altındaki not söyler.
        // Tur 2 (hasım DÜŞÜK): etiket 1. serinin DEĞERİYLE aynı koşula bağlı (bu dönem HESAPLANAMADI + önceki KISMI
        // iken etiket "Satış" ama değer toplam hasılattı). 2. serinin kümesi ayrıysa #kz-grafik-onceki-hasilat-notu söyler.
        // PAKET RAPOR-4 tur 2 (tasarım KRİTİK): kâr bilinen kümeden hesaplanınca tek "Satış" çubuğu maliyeti BİLİNEN
        // satışı gösteriyordu (89.900) — Özet/Panel'in toplam satışıyla (635.528) aynı adı taşıyordu. Artık iki çubuk:
        // önce TOPLAM satış (Özet kartının "Toplam satış" alt satırı / Panel ile aynı sayı), sonra Özet kartıyla AYNI
        // etiketli "Maliyeti bilinen satış" (satış − maliyet = kâr bu kümedir).
        .. (GrafikHasilatBilinenMi(o)
            ? [new CiftNokta(KR.GrafikToplamSatis, o.HasilatTl, o.Onceki?.HasilatTl ?? 0m)]
            : Array.Empty<CiftNokta>()),
        new(GrafikHasilatBilinenMi(o) ? KR.BilinenHasilat : Dil.T.KarZarar.Hasilat,
            GrafikHasilatBilinenMi(o) ? o.BilinenHasilatTl : o.HasilatTl,
            o.Onceki is { } on ? (on.KarTl is not null && on.BilinenHasilatTl is { } obh ? obh : on.HasilatTl) : 0m),
        // KAR-RAPOR-2: bilinmeyen maliyet 0 çubuğu olarak ÇİZİLMEZ.
        .. (o.MaliyetTl is { } mt ? [new CiftNokta(Dil.T.KarZarar.Maliyet, mt, o.Onceki?.MaliyetTl ?? 0m)] : Array.Empty<CiftNokta>()),
        // PAKET KAR-RAPOR: hesaplanamayan kâr 0 çubuğu olarak ÇİZİLMEZ — çubuk hiç konmaz.
        .. (o.KarTl is { } k ? [new CiftNokta(Dil.T.KarZarar.Kar, k, o.Onceki?.KarTl ?? 0m)] : Array.Empty<CiftNokta>()),
        .. (o.DonemKariTl is { } d ? [new CiftNokta(Dil.T.KarZarar.DonemKari, d, o.Onceki?.DonemKariTl ?? 0m)] : Array.Empty<CiftNokta>()),
    ];

    /// <summary>
    /// Pasta: ürün bazlı maliyet — en büyük 5 ürün + "Diğer ürünler". Maliyeti
    /// sıfır/negatif satır dilim OLMAZ (pasta negatif pay çizemez).
    /// </summary>
    private List<GrafikNokta> MaliyetDilimleri
    {
        get
        {
            var pozitif = urunler.Where(u => u.MaliyetTl is > 0m)
                .OrderByDescending(u => u.MaliyetTl).ToList();
            var sonuc = pozitif.Take(5).Select(u => new GrafikNokta(u.Ad ?? u.Kod ?? u.UrunId, u.MaliyetTl!.Value)).ToList();
            var kalan = pozitif.Skip(5).Sum(u => u.MaliyetTl!.Value);
            if (kalan > 0m) sonuc.Add(new GrafikNokta(G.DigerUrunler, kalan));
            return sonuc;
        }
    }

    private void Yenile() => InvokeAsync(StateHasChanged);

    public void Dispose() => Dil.Degisti -= Yenile;
