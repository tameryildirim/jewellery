    private async Task DekontKaydet()
    {
        if (sayiKapisi.OnekleVar("dekont-")) return;   // ORTAK-1: düğme pasif + sebep; ikinci kat koruma
        dekontRedIzi = null;   // YASAL-KAPI-2: her denemede iz yeniden kurulur (yalnız MASAK reddi yeni iz bırakır)
        dekontForm.Temizle();
        dekontForm.Pozitif("dekont-tutar", dekontTutar, Dil);
        GunGecerli(dekontForm, "dekont-tarih", dekontTarih);   // PAKET Q9-1
        if (!dekontForm.Gecerli) { modalHata = Dil.T.Kabuk.FormEksik; return; }

        modalHata = null;
        kaydediliyor = true;
        try
        {
            var dekontYanit = await Api.PostAsync<JsonElement>($"/bankalar/{AktifHesapId}/hareket", new
            {
                karsiIban = DekontIbanGovde, karsiKimlikNo = DekontKimlikGovde,   // M7a: müşteriyi bul / yoksa aç
                yon = dekontYon,
                tutar = DekontTutarTl,
                karsiTarafAd = string.IsNullOrWhiteSpace(dekontKarsiTaraf) ? null : dekontKarsiTaraf,
                aciklama = string.IsNullOrWhiteSpace(dekontAciklama) ? null : dekontAciklama,
                cariId = string.IsNullOrWhiteSpace(dekontCariId) ? null : dekontCariId,
                // PAKET Q9-1: bugün seçiliyse tarih GÖNDERİLMEZ (sunucu saati — davranış aynı);
                // geçmiş gün öğle UTC olarak gider (bkz. GunGovdesi).
                tarih = dekontTarih is { } dg && dg != Bugun ? GunGovdesi(dg) : null,
                // PAKET 41: alan adları sunucudaki MasakBilgiDto ile BİREBİR
                // (belgeTuru, belgeNo, adSoyad, dogumTarihi, uyruk, adres…).
                masak = MasakGerekli ? masak : null,
            });
            dekontModalAcik = false;
            BasariGoster(DekontSonucMetni(dekontYanit) ?? Dil.T.Banka.HareketEklendi);
            if (gelenKarar is not null) await gelenKarar.Yenile();
            await HesaplariYukle();
            await HareketleriYukle();
        }
        catch (ApiHata ex) when (ParaMasakKapisi.MasakReddi(ex))
        {
            // YASAL-KAPI-2: ham sunucu cümlesi (alan anahtarı) basılmaz; alanlar açılır, gereksinim yeniden sorulur.
            // Form eksikken neyin eksik olduğunu Kaydet kilidi söyler (tek yer); form TAMKEN sunucunun cümlesi sade yazılır.
            var tamamdi = masakGereksinim is { KimlikGerekli: true } g && MasakFormu.Eksiksiz(masak, g);
            dekontRedIzi = Kuyumcu.Web.Bilesenler.Fis.YasalKapiIzi.Al(DekontTutarTl, dekontCariId);
            gereksinimTutari = -1m;
            await GereksinimTazele();
            modalHata = tamamdi || !MasakGerekli || masakGereksinim is not { KimlikGerekli: true }
                ? string.Format(YasalKapi2Sozlugu.Al(Dil.Dil).MasakKabulEdilmedi, ParaMasakKapisi.SadeMetin(ex.Message.StartsWith("MASAK:", StringComparison.Ordinal) ? ex.Message[6..].TrimStart() : ex.Message))
                : null;
        }
        catch (ApiHata ex) { modalHata = FormDurumu.BantMesaji(ex, Dil, SunucuAlanDekont); dekontForm.Sunucudan(ex, SunucuAlanDekont); }
        kaydediliyor = false;
    }

    // ── faturaya dönüştür ──
    private async Task DonusturModalAc(HareketVeri hareket)
    {
        modalHata = null;
        donusturCariId = "";
        donusturKdv = "0.20";
        donusturHareket = hareket;
        await CarileriYukle();
    }

    private async Task Donustur()
    {
        if (donusturHareket is null) return;
        modalHata = null;
        kaydediliyor = true;
        try
        {
            await Api.PostAsync($"/bankalar/hareketler/{donusturHareket.Id}/faturaya-donustur", new
            {
                cariId = donusturCariId,
                kdvOran = DonusturKdvOran,
            });
            donusturHareket = null;
            BasariGoster(Dil.T.Banka.DonusturBasarili);
            await HareketleriYukle();
        }
        catch (ApiHata ex) { modalHata = FormDurumu.SunucuMesaji(ex, Dil); }
        kaydediliyor = false;
    }

    private static readonly Dictionary<string, string> SunucuAlanDekont = new()
    {
        ["Tutar"] = "dekont-tutar", ["Tarih"] = "dekont-tarih",
    };

    private static readonly Dictionary<string, string> SunucuAlanHesapYeni = new()
    {
        ["BankaAdi"] = "hesap-banka", ["HesapAdi"] = "hesap-ad", ["Iban"] = "hesap-iban",
        ["HesapSahibi"] = "hesap-sahibi", ["ParaBirimi"] = "hesap-doviz",
    };

    private static readonly Dictionary<string, string> SunucuAlanHesapDuzenle = new()
    {
        ["BankaAdi"] = "d-banka", ["HesapAdi"] = "d-hesapad", ["Iban"] = "d-iban",
        ["HesapSahibi"] = "d-sahibi", ["ParaBirimi"] = "d-doviz",
    };

    /// <summary>KESIF-P6 tur 2: karşı taraf ve açıklama ikisi de boş → tek satır (ZO-ISLEM-A).</summary>
    internal static bool IkisiBos(HareketVeri h) =>
        string.IsNullOrWhiteSpace(h.KarsiTarafAd) && string.IsNullOrWhiteSpace(h.Aciklama);

    // ── durum rozeti ──
    private static string DurumRenk(string durum) => durum switch
    {
        "FATURALANDI" => "yesil",
        "ESLESTI" => "mavi",
        _ => "sari",
    };

    private string DurumMetin(string durum) => durum switch
    {
        "FATURALANDI" => Dil.T.Banka.Faturalandi,
        "ESLESTI" => Dil.T.Banka.Eslesti,
        _ => Dil.T.Banka.Bekliyor,
    };

    private void Yenile() => InvokeAsync(StateHasChanged);
    public void Dispose() => Dil.Degisti -= Yenile;
}
