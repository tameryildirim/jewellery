    // ── hesap düzenle ──
    // ── SON-KALANLAR tur 2 — para birimi kilidi (sunucu BankaServisi.ParaBirimiKilidi ile AYNI ölçüt) ──
    /// <summary>null = serbest · BAKIYE · HAREKET · BILINMIYOR (okunamadı → fail-closed, kilitli).</summary>
    private string? dDovizKilitSebebi;
    private bool dDovizKilitYukleniyor;
    private bool DovizKilitli => dDovizKilitYukleniyor || dDovizKilitSebebi is not null;
    private SonKalanlarMetinleri SKL => SonKalanlarSozlugu.Al(Dil.Dil);
    private string DovizKilitGerekcesi => dDovizKilitSebebi switch
    {
        "BAKIYE" => SKL.BankaDovizKilitBakiye,
        "HAREKET" => SKL.BankaDovizKilitHareket,
        _ => SKL.BankaDovizKilitBilinmiyor,
    };

    /// <summary>
    /// Kilit KAYDETMEDEN önce okunur (UX-S30). Bakiye listeden bilinir; hareket var mı sorusu mevcut
    /// okuma ucuyla (<c>GET /bankalar/{id}/hareketler?limit=1</c>, durum süzgeçsiz) sorulur — yeni uç açılmaz.
    /// Okunamazsa ya da yanıt beklenen biçimde değilse kilitli kalır; hata "serbest"e çevrilmez (UX-S28).
    /// </summary>
    private async Task DovizKilidiniOku(HesapVeri h)
    {
        dDovizKilitSebebi = null;
        if (h.Bakiye != 0m) { dDovizKilitSebebi = "BAKIYE"; return; }
        dDovizKilitYukleniyor = true;
        try
        {
            var y = await Api.GetAsync<HareketYaniti>($"/bankalar/{h.Id}/hareketler?limit=1");
            dDovizKilitSebebi = y?.Hareketler is null ? "BILINMIYOR"
                : y.Hareketler.Count > 0 ? "HAREKET" : null;
        }
        catch (Exception ex) when (ex is ApiHata or JsonException) { dDovizKilitSebebi = "BILINMIYOR"; }
        dDovizKilitYukleniyor = false;
    }

