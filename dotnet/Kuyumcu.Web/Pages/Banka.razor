    /// <summary>
    /// Dekont detay bölümü görünür mü? Değer girilmişse, tarih bugün değilse,
    /// tarih hatalıysa ya da MASAK kapısı açıldıysa ZORUNLU açıktır — kapalı
    /// bölüm gövdeye varsayılanından başka değer taşımaz.
    /// </summary>
    private bool DekontDetayGorunur =>
        dekontDetayAcik || MasakGerekli
        || !string.IsNullOrEmpty(dekontCariId) || !string.IsNullOrEmpty(dekontKarsiTaraf)
        || !string.IsNullOrEmpty(dekontAciklama) || !string.IsNullOrEmpty(dekontKarsiIban) || !string.IsNullOrEmpty(dekontKimlikNo)
        || (dekontTarih is { } dt && dt != Bugun) || dekontTarih is null
        || dekontForm.Mesaj("dekont-tarih") is { Length: > 0 };

    // ── PAKET 41 — MASAK kapısı (POS ile AYNI bileşen ve AYNI uçlar) ─────────
    // ⚠ Sayfaya YENİ istemci tipi AÇILMADI: MasakFormu.MasakBilgi,
    //   Esikler ve Kuyumcu.Web.Servisler.MasakGereksinim yeniden
    //   kullanılır (denetim.sh sayfa tipi tavanı). Gövde anonim nesneyle gider.
    private MasakFormu.MasakBilgi masak = new();
    private Esikler? masakEsik;
    private MasakGereksinim? masakGereksinim;
    private decimal gereksinimTutari = -1m;

    /// <summary>Eşik karşılaştırması istemcide (tek sayı, SUNUCUDAN gelir).</summary>
    private string? gereksinimCari;

    /// <summary>
    /// Gereksinim sunucuya sorulmalı mı? Tutar eşikteyse ya da müşteri seçiliyse
    /// (29.09 tasarım hakemi KRİTİK: aynı gün aynı müşteriyle yapılmış işlemlerin toplamını
    /// yalnız sunucu bilir; kayıt o toplamla doğrulanır, ekran da onunla sorar).
    /// </summary>
    private bool MasakSorulmali =>
        masakEsik is not null && DekontTutarTl > 0m
        && (DekontTutarTl >= masakEsik.KimlikIstenenTutar() || !string.IsNullOrEmpty(dekontCariId) || DekontMasakRedGecerli);

    /// <summary>Eşik karşılaştırması istemcide (tek sayı, SUNUCUDAN gelir); eşik altında da
    /// müşterinin günlük toplamı kimlik gerektiriyorsa alanlar açılır.</summary>
    private bool MasakGerekli =>
        MasakSorulmali
        && (DekontTutarTl >= masakEsik!.KimlikIstenenTutar() || masakGereksinim?.KimlikGerekli == true || DekontMasakRedGecerli);

    // ── PAKET YASAL-KAPI-2 — sunucu MASAK reddi YasalKapiIzi deseniyle (Hurda/Kapora/Satış ile aynı kural):
    //    ret metni ham alan anahtarı ("masak.aciklama") taşımaz; tutar reddin altına inince ya da müşteri
    //    değişince ret cümlesi ve zorla açılan alanlar kalkar, tutar geri çıkınca geri gelir.
    private Kuyumcu.Web.Bilesenler.Fis.YasalKapiIzi? dekontRedIzi;
    private bool DekontMasakRedGecerli =>
        Kuyumcu.Web.Bilesenler.Fis.YasalKapiIzi.Gecerli(dekontRedIzi, DekontTutarTl, dekontCariId);
    /// <summary>Dekont penceresinin hata bandı: MASAK reddinin cümlesi yalnız izi geçerliyken görünür.</summary>
    private string? DekontModalHata => dekontRedIzi is null || DekontMasakRedGecerli ? modalHata : null;

    private async Task DekontCariDegisti(string? v)
    {
        dekontCariId = v ?? "";
        await GereksinimTazele();
    }

    /// <summary>
    /// UX-S30: Kaydet kilitliyse SEBEBİ yazılır. null = düğme açık.
    /// Sunucu her hâlükârda son sözü söyler; burası yalnız erken uyarır.
    /// </summary>
    private string? DekontKilitSebebi => sayiKapisi.Sebep(Dil.Dil, "dekont-") ?? DekontKuralKilidi;   // ORTAK-1: "1.500" → POST YOK
    private string? DekontKuralKilidi =>
        !MasakGerekli ? null
        : masakGereksinim is null ? Dil.T.Banka.MasakYukleniyorSebep
        : MasakFormu.Eksiksiz(masak, masakGereksinim) ? null
        : MasakFormu.TcknKilitMetni(masak, Dil.Dil) is { } tcknKilit ? tcknKilit   // TCKN-DOGRULAMA: alan altıyla aynı metin
        : Dil.BasitMi ? ZO.MasakKilitSebepBasit : Dil.T.Banka.MasakKilitSebep;

    /// <summary>
    /// MASAK alanlarındaki değişiklik bu sayfayı da yeniden çizer (Kaydet
    /// düğmesinin kilidi ve sebebi burada hesaplanır). Gövde boş: tek amaç
    /// olayın üst bileşene ulaşıp yeniden çizim tetiklemesidir.
    /// </summary>
    private void MasakAlaniDegisti() { }

    /// <summary>
    /// Tutar değişince sunucudan gereksinim çeker (Islemler.razor deseni).
    /// Aynı tutar için tekrar çağrılmaz.
    /// ⚠ UX-S28: hata "kayıt yok"a çevrilmez — gereksinim gelmezse Kaydet
    ///   KİLİTLİ kalır ve sebebini yazar (fail-closed).
    /// </summary>
    private async Task GereksinimTazele()
    {
        if (!MasakSorulmali) { masakGereksinim = null; gereksinimTutari = -1m; gereksinimCari = null; return; }
        var t = DekontTutarTl;
        var c = string.IsNullOrEmpty(dekontCariId) ? null : dekontCariId;
        if (t == gereksinimTutari && c == gereksinimCari && masakGereksinim is not null) return;
        // Eski tutarın/müşterinin gereksinimi yenisinde geçerli değildir: sorgudan ÖNCE düşer.
        masakGereksinim = null; gereksinimTutari = -1m; gereksinimCari = null;
        try
        {
            masakGereksinim = await Uyum.Gereksinim(t, c);
            gereksinimTutari = t;
            gereksinimCari = c;
        }
        catch { masakGereksinim = null; gereksinimTutari = -1m; gereksinimCari = null; }
    }

