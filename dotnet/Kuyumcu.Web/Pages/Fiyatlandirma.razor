    // ── PAKET P-65: onay kipi durumu ─────────────────────────────────────
    private OnayKilitMetinleri OnayM => OnayKilitSozlugu.Al(Dil.Dil);
    private Liste? pasifListe;
    private Kamp? pasifKampanya;

    /// <summary>Pasife alma onaya gider; aktifleştirme doğrudan çalışır.</summary>
    private Task ListeDurumIste(Liste l)
    {
        if (!l.Aktif) return ListeDurumDegistir(l);
        listeHata = null;
        pasifListe = l;
        return Task.CompletedTask;
    }

    private Task KampanyaDurumIste(Kamp k)
    {
        if (!k.Aktif) return KampanyaDurumDegistir(k);
        kampanyaHata = null;
        pasifKampanya = k;
        return Task.CompletedTask;
    }

    private async Task ListePasifOnayla()
    {
        if (pasifListe is not { } l) return;
        await ListeDurumDegistir(l);
        if (listeHata is null) pasifListe = null;
    }

    private async Task KampanyaPasifOnayla()
    {
        if (pasifKampanya is not { } k) return;
        await KampanyaDurumDegistir(k);
        if (kampanyaHata is null) pasifKampanya = null;
    }

    /// <summary>
    /// Form hem OLUŞTURMA hem DÜZENLEME için kullanılır (UX-S25/S26): <see cref="Id"/>
    /// doluysa PATCH, boşsa POST. Alan kümesi iki yolda birebir aynıdır.
    /// </summary>
    private sealed class ListeForm
    {
        public string? Id;
        public string Ad = ""; public string Tur = "PERAKENDE";
        public decimal HasMarjYuzde; public decimal IscilikCarpanYuzde = 100m;
        public bool Varsayilan; public bool Aktif = true;
        /// <summary>Rahat aralık dışı değerin bilinçli onayı (S-3c). Form her açılışta SIFIRLANIR.</summary>
        public bool RiskOnayi;
        /// <summary>Düzenlemeye BAŞLARKEN varsayılan mıydı — uyarı/kilit metinleri buna bakar.</summary>
        public bool BaslangictaVarsayilan;
    }

    private sealed class KampanyaForm
    {
        public string? Id;
        public string Ad = ""; public DateTime Baslangic = DateTime.Today; public DateTime Bitis = DateTime.Today.AddDays(6);
        public string HedefTur = "TUMU"; public string? HedefId; public string IndirimTuru = "ISCILIK_YUZDE";
        public decimal Deger; public bool Aktif = true;
    }

    private List<Liste> listeler = [];
    private List<Kamp> kampanyalar = [];
    private List<UrunOzet> urunler = [];
    private List<(string, string)> Kategoriler = [];
    private List<(string, string)> UrunSecenekleri => urunler.Select(u => (u.Id, u.Ad)).ToList();
    /// <summary>Panel ürünleri SUNUCUDAN (önizleme ucu) çeker; buradan yalnız süzgeç kaynağı olan kategoriler geçer.</summary>
    private IReadOnlyList<PanelKategori> PanelKategorileri =>
        Kategoriler.Select(k => new PanelKategori(k.Item1, k.Item2)).ToList();

    private ListeForm? yeniListe;
    private KampanyaForm? yeniKampanya;
    private Liste? seciliListe;
    private string? kurId;
    private string? hata, listeHata, kampanyaHata, listeBasari, kampanyaBasari;
    private bool kaydediliyor, yukleniyor, yuklendi;

    // ── UX-1-C2: sessiz etkisizlik YASAK — alan altı Türkçe mesaj defteri ────
    private readonly FormDurumu listeForm = new();
    private readonly FormDurumu kampanyaForm = new();
    private int listeJeton, kampanyaJeton;

    // ── UX-S31: ham veritabanı kodu ekrana basılmaz, sözlükten çevrilir ──────
    // PAKET Q10-5 (UX-S31 · UX-S26): liste türü seçicisi ham kodu ("PERAKENDE")
    // etiket olarak basıyordu; seçenekler artık tablo hücresiyle AYNI eşlemeden
    // (TurEtiketi) üretilir — tek dizi, tek ad.
    private static readonly string[] ListeTurleri = ["PERAKENDE", "TOPTAN", "OZEL"];
    private IReadOnlyList<SecenekOgesi> ListeTurSecenekleri =>
        [.. ListeTurleri.Select(t => new SecenekOgesi(t, TurEtiketi(t)))];

    // PAKET Q10-5 (QA 10): Secici girdi ailesinden değil; hedef seçilince o
    // alanın eski hata mesajı FormDurumu'ndan düşer (ortak kural, tek yer).
    private void HedefIdDegisti() => kampanyaForm.Sil("km-hedefid");

    private string TurEtiketi(string tur) => tur switch
    {
        "PERAKENDE" => Dil.T.Fiyat.TurPerakende,
        "TOPTAN" => Dil.T.Fiyat.TurToptan,
        "OZEL" => Dil.T.Fiyat.TurOzel,
        _ => tur,
    };

    private string HedefEtiketi(string hedef) => hedef switch
    {
        "TUMU" => Dil.T.Fiyat.HedefTumu,
        "KATEGORI" => Dil.T.Fiyat.HedefKategori,
        "URUN" => Dil.T.Fiyat.HedefUrun,
        _ => hedef,
    };

    private string IndirimEtiketi(string tur) => tur switch
    {
        "ISCILIK_YUZDE" => Dil.T.Fiyat.IscilikYuzde,
        "TUTAR_YUZDE" => Dil.T.Fiyat.TutarYuzde,
        "TUTAR_TL" => Dil.T.Fiyat.TutarTl,
        _ => tur,
    };

    private bool IlkListe => listeler.Count == 0;

    /// <summary>FEY md.11/3 — üç ay; sunucudaki Kampanya.EnFazlaGun (92) ile aynı.</summary>
    private static bool SureAsildi(KampanyaForm k) => (k.Bitis.Date - k.Baslangic.Date).TotalDays + 1 > 92;

    /// <summary>Kampanya hedefi gümüş (ayar G*) ürün mü — motor bu ürüne teklif üretmez.</summary>
    private bool GumusHedef =>
        yeniKampanya is { HedefTur: "URUN" } k && !string.IsNullOrEmpty(k.HedefId) &&
        urunler.FirstOrDefault(u => u.Id == k.HedefId) is { } u && u.AyarId.StartsWith("G", StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        Dil.Degisti += Yenile;
        await Yukle();
    }

    private async Task Yukle()
    {
        hata = null; yukleniyor = true;
        try
        {
            listeler = await Api.GetAsync<List<Liste>>("/fiyat/listeler");
            kampanyalar = await Api.GetAsync<List<Kamp>>("/fiyat/kampanyalar");
            urunler = await Api.GetAsync<List<UrunOzet>>("/urunler");
            Kategoriler = (await Api.GetAsync<List<KategoriOzet>>("/urun-kategorileri/duz")).Select(k => (k.Id, k.Ad)).ToList();
            yuklendi = true;
        }
        // ⚠ UX-S28 / Anayasa md.1: eski kod burada listeyi BOŞALTIYORDU; sunucu
        // hatası kullanıcıya "kayıt yok" gibi görünüyordu. Artık boş durum yalnız
        // yuklendi && hata yok iken çizilir; hata bandı ayrı durur.
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException) { hata = ex.Message; }
        // Kur kaydı fiyat panelinin ön koşuludur; yokluğu sayfayı düşürmez,
        // panel "kur yok" der (UX-S30 — kilidin sebebi yazılır).
        try { kurId = (await Api.GetAsync<KurOzet>("/kur/guncel")).Id; }
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException) { kurId = null; }
        yukleniyor = false;
    }

    // ── Liste formu ──────────────────────────────────────────────────────────

    private void ListeFormuAc()
    {
        // İlk liste zorunlu olarak varsayılandır (sunucu da böyle yazar) —
        // kullanıcıya sorulmaz, işaretli ve kilitli gösterilir (UX-S21).
        yeniListe = new ListeForm { Varsayilan = IlkListe };
        listeHata = null; listeBasari = null;
    }

    private void ListeFormuKapat() => yeniListe = null;

    private void ListeDuzenle(Liste l)
    {
        yeniListe = new ListeForm
        {
            Id = l.Id, Ad = l.Ad, Tur = l.Tur, HasMarjYuzde = l.HasMarjYuzde,
            IscilikCarpanYuzde = l.IscilikCarpanYuzde, Varsayilan = l.Varsayilan,
            Aktif = l.Aktif, BaslangictaVarsayilan = l.Varsayilan, RiskOnayi = false,
        };
        listeHata = null; listeBasari = null;
    }

    private object ListeGovde(ListeForm f) => new
    {
        ad = f.Ad.Trim(), tur = f.Tur, hasMarjYuzde = f.HasMarjYuzde,
        iscilikCarpanYuzde = f.IscilikCarpanYuzde, varsayilan = f.Varsayilan, aktif = f.Aktif,
        riskOnayi = f.RiskOnayi,
    };

    /// <summary>Formdaki değerler rahat aralık dışındaysa ekrana yazılacak Türkçe uyarı.</summary>
    private string? RiskMetni => yeniListe is not { } f ? null
        : Kuyumcu.Core.Sozlesmeler.FiyatAraliklari.RiskKodu(f.HasMarjYuzde, f.IscilikCarpanYuzde) switch
        {
            "MARJ_EKSI" => Dil.T.Fiyat.MarjEksiUyari,
            "MARJ_YUKSEK" => Dil.T.Fiyat.MarjYuksekUyari,
            "CARPAN_YUKSEK" => Dil.T.Fiyat.CarpanYuksekUyari,
            _ => null,
        };

    /// <summary>Riskli değer var ama onay kutusu işaretli değil — Kaydet kilitli kalır.</summary>
    private bool RiskOnayiBekliyor => RiskMetni is not null && yeniListe?.RiskOnayi != true;

    private async Task ListeKaydet()
    {
        if (yeniListe is not { } f || sayiKapisi.OnekleVar("fl-")) return;   // ORTAK-1: POST YOK
        // UX-1-C0/C2: "Kaydet'e bastım, hiçbir şey olmadı" YASAK.
        listeForm.Temizle();
        listeForm.Zorunlu("fl-ad", f.Ad, Dil);
        // ⚠ NEGATİF MARJ KURALI KONMADI: has marjı bilinçli olarak eksi olabilir
        // (indirimli/maliyetine liste) ve sunucu bunu kabul eder; istemcide
        // yasaklamak mevcut sözleşmeyi kırardı. İşçilik çarpanı ise ≥ 0'dır.
        listeForm.NegatifDegil("fl-carpan", f.IscilikCarpanYuzde, Dil);
        // Sert sınır: sunucuyla AYNI eşik (FiyatAraliklari) — kullanıcı 400'ü ekranda görür.
        switch (Kuyumcu.Core.Sozlesmeler.FiyatAraliklari.SertSinirDisi(f.HasMarjYuzde, f.IscilikCarpanYuzde))
        {
            case "MARJ": listeForm.Ekle("fl-marj", Dil.T.Fiyat.MarjAralikDisi); break;
            case "CARPAN": listeForm.Ekle("fl-carpan", Dil.T.Fiyat.CarpanAralikDisi); break;
        }
        // Rahat aralık dışı + onaysız: SESSİZ ETKİSİZLİK yasak, gerekçe alan altında.
        if (RiskOnayiBekliyor) listeForm.Ekle("fl-marj", Dil.T.Fiyat.RiskOnayiSart);
        if (!listeForm.Gecerli) { listeHata = Dil.T.Kabuk.FormEksik; return; }
        kaydediliyor = true; listeHata = null;
        try
        {
            if (string.IsNullOrEmpty(f.Id)) await Api.PostAsync("/fiyat/listeler", ListeGovde(f));
            else await Api.PatchAsync($"/fiyat/listeler/{f.Id}", ListeGovde(f));
            yeniListe = null;
            BasariListe(Dil.T.Fiyat.ListeKaydedildi);
            await Yukle();
        }
        catch (ApiHata ex) { listeHata = FormDurumu.SunucuMesaji(ex, Dil); listeForm.Sunucudan(ex, SunucuAlanListe); }
        kaydediliyor = false;
    }

    private async Task ListeDurumDegistir(Liste l)
    {
        kaydediliyor = true; listeHata = null;
        try
        {
            await Api.PatchAsync($"/fiyat/listeler/{l.Id}", new
            {
                ad = l.Ad, tur = l.Tur, hasMarjYuzde = l.HasMarjYuzde,
                iscilikCarpanYuzde = l.IscilikCarpanYuzde, varsayilan = l.Varsayilan, aktif = !l.Aktif,
            });
            // UX-S27 — her eylem KENDİ sonucunu yazar ("kaydedildi" yapıştırılmaz).
            BasariListe(l.Aktif ? Dil.T.Fiyat.ListePasifeAlindi : Dil.T.Fiyat.ListeAktiflestirildi);
            await Yukle();
        }
        catch (ApiHata ex) { listeHata = FormDurumu.SunucuMesaji(ex, Dil); }
        kaydediliyor = false;
    }

    // ── Ürün paneli (madde 3) ────────────────────────────────────────────────

    private void PaneliAc(Liste l) => seciliListe = seciliListe?.Id == l.Id ? null : l;
    private void PaneliKapat() => seciliListe = null;

    // ── Kampanya formu ───────────────────────────────────────────────────────

    private void KampanyaFormuAc() { yeniKampanya = new KampanyaForm(); kampanyaHata = null; kampanyaBasari = null; }
    private void KampanyaFormuKapat() => yeniKampanya = null;

    private void KampanyaDuzenle(Kamp k)
    {
        yeniKampanya = new KampanyaForm
        {
            Id = k.Id, Ad = k.Ad,
            Baslangic = k.Baslangic.ToDateTime(TimeOnly.MinValue),
            Bitis = k.Bitis.ToDateTime(TimeOnly.MinValue),
            HedefTur = k.HedefTur, HedefId = k.HedefId, IndirimTuru = k.IndirimTuru,
            Deger = k.Deger, Aktif = k.Aktif,
        };
        kampanyaHata = null; kampanyaBasari = null;
    }

    private static object KampanyaGovde(KampanyaForm f) => new
    {
        ad = f.Ad.Trim(),
        baslangic = Bicim.Makine(f.Baslangic),
        bitis = Bicim.Makine(f.Bitis),
        hedefTur = f.HedefTur, hedefId = f.HedefTur == "TUMU" ? null : f.HedefId,
        indirimTuru = f.IndirimTuru, deger = f.Deger, aktif = f.Aktif,
    };

    private async Task KampanyaKaydet()
    {
        if (yeniKampanya is not { } f || sayiKapisi.OnekleVar("km-")) return;   // ORTAK-1: POST YOK
        kampanyaForm.Temizle();
        kampanyaForm.Zorunlu("km-ad", f.Ad, Dil);
        kampanyaForm.Pozitif("km-deger", f.Deger, Dil);
        if (f.Bitis.Date < f.Baslangic.Date) kampanyaForm.Ekle("km-bit", Dil.T.Kabuk.TarihAraligi);
        if (f.HedefTur != "TUMU" && string.IsNullOrEmpty(f.HedefId))
            kampanyaForm.Ekle("km-hedefid", Dil.T.Kabuk.ZorunluAlan);
        if (!kampanyaForm.Gecerli) { kampanyaHata = Dil.T.Kabuk.FormEksik; return; }
        kaydediliyor = true; kampanyaHata = null;
        try
        {
            if (string.IsNullOrEmpty(f.Id)) await Api.PostAsync("/fiyat/kampanyalar", KampanyaGovde(f));
            else await Api.PatchAsync($"/fiyat/kampanyalar/{f.Id}", KampanyaGovde(f));
            yeniKampanya = null;
            BasariKampanya(Dil.T.Fiyat.KampanyaKaydedildi);
            await Yukle();
        }
        catch (ApiHata ex) { kampanyaHata = FormDurumu.SunucuMesaji(ex, Dil); kampanyaForm.Sunucudan(ex, SunucuAlanKampanya); }
        kaydediliyor = false;
    }

    private async Task KampanyaDurumDegistir(Kamp k)
    {
        kaydediliyor = true; kampanyaHata = null;
        try
        {
            await Api.PatchAsync($"/fiyat/kampanyalar/{k.Id}", new
            {
                ad = k.Ad,
                baslangic = Bicim.Makine(k.Baslangic),
                bitis = Bicim.Makine(k.Bitis),
                hedefTur = k.HedefTur, hedefId = k.HedefTur == "TUMU" ? null : k.HedefId,
                indirimTuru = k.IndirimTuru, deger = k.Deger, aktif = !k.Aktif,
            });
            BasariKampanya(k.Aktif ? Dil.T.Fiyat.KampanyaPasifeAlindi : Dil.T.Fiyat.KampanyaAktiflestirildi);
            await Yukle();
        }
        catch (ApiHata ex) { kampanyaHata = FormDurumu.SunucuMesaji(ex, Dil); }
        kaydediliyor = false;
    }

    private void BasariListe(string m) { listeBasari = m; listeJeton++; }
    private void BasariKampanya(string m) { kampanyaBasari = m; kampanyaJeton++; }

    /// <summary>Sunucunun PascalCase alan adı → ekran id'si (UX-4d alan sözlüğü).</summary>
    private static readonly Dictionary<string, string> SunucuAlanListe = new()
    {
        ["Ad"] = "fl-ad", ["HasMarjYuzde"] = "fl-marj", ["IscilikCarpanYuzde"] = "fl-carpan",
    };

    private static readonly Dictionary<string, string> SunucuAlanKampanya = new()
    {
        ["Ad"] = "km-ad", ["Deger"] = "km-deger", ["Bitis"] = "km-bit", ["HedefId"] = "km-hedefid",
    };

    private void Yenile() => InvokeAsync(StateHasChanged);
    public void Dispose() => Dil.Degisti -= Yenile;
}
