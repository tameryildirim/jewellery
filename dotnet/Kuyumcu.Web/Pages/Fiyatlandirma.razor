        new() { Anahtar = "hedef", Baslik = Dil.T.Fiyat.Hedef, SunucuSiralamaAdi = "hedef", HucreSinif = _ => "metin-kucuk", Deger = k => HedefEtiketi(k.HedefTur) },
        new() { Anahtar = "tur", Baslik = Dil.T.Fiyat.IndirimTuru, SunucuSiralamaAdi = "tur", HucreSinif = _ => "metin-kucuk", Deger = k => IndirimEtiketi(k.IndirimTuru) },
        new() { Anahtar = "deger", Baslik = Dil.T.Fiyat.Deger, ZorunluGorunur = true, SunucuSiralamaAdi = "deger", BaslikSinif = "sayi", HucreSinif = _ => "sayi",
                Deger = k => k.Deger, Hucre = k => @<text>@Bicim.Girdi(k.Deger, "0.##")</text> },
