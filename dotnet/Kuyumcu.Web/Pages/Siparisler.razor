                tur = fTur,
                cariId = fCariId,
                subeId = subeler.Count > 1 ? fSubeId : null,
                sozVerilenGun = fGun is { } sg ? Bicim.Makine(sg) : null,
                aciklama = string.IsNullOrWhiteSpace(fAciklama) ? null : fAciklama,
                tahminiTutarTl = fTahminiTutar,
                kurSnapshotId = fTahminiTutar is null ? null : kurId,
                kalemler = gecerliKalemler.Select(k => new
