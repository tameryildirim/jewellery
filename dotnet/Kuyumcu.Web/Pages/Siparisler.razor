        "ATOLYEDE" => Dil.T.Siparis.DurumAtolyede,
        "HAZIR" => Dil.T.Siparis.DurumHazir,
        "TESLIM_EDILDI" => Dil.T.Siparis.DurumTeslimEdildi,
        "IPTAL" => Dil.T.Siparis.DurumIptal,
        _ => d,
    };

    private static string DurumRengi(string d) => d switch
    {
        "TASLAK" => "gri",
        "ONAYLANDI" => "mavi",
        "ATOLYEDE" => "amber",
        "HAZIR" => "yesil",
        "TESLIM_EDILDI" => "yesil",
        _ => "kirmizi",
    };

    private void Yenile() => InvokeAsync(StateHasChanged);
    public void Dispose() => Dil.Degisti -= Yenile;
}
