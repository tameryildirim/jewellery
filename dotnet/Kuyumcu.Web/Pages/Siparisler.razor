            var cevap = await Api.PostAsync("/siparisler", govde);
            var no = cevap.TryGetProperty("no", out var n) &&
                     n.ValueKind == System.Text.Json.JsonValueKind.String ? n.GetString() : null;
            basari = no is null ? Dil.T.Siparis.Olusturuldu : $"{Dil.T.Siparis.Olusturuldu}: {no}";
            basariJeton++;
            formAcik = false;
            kalemler = [new FormKalemi()];
            fTahminiTutar = null;
            fAciklama = "";
            fGun = null;
            await Yukle();
        }
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException) { hata = ex.Message; }
