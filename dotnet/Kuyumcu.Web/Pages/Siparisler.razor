@page "/siparisler"
@using System.Globalization
@using Kuyumcu.Contracts.Sayfalar.Siparisler
@using Kuyumcu.Web.Bilesenler.Grid
@using Kuyumcu.Core.Domain.Girdi
@inject ApiIstemci Api
@inject DilServisi Dil
@inject OturumServisi Oturum
@inject NavigationManager Nav
@implements IDisposable

@* ═══════════════════════════════════════════════════════════════════════════
   SİPARİŞLER (paket 3 Faz A) — müşteri siparişi · dış atölye siparişi · tamir.

   GET  /siparisler?tur=&durum=&cariId=&geciken=&limit=
   POST /siparisler
   GET  /fiyat/teklif?urunId=&cariId=&kurSnapshotId=      (fiyat SUNUCUDAN)

   ⚠ UX-S21/S22: şube oturumdan gelir ve TEK şubede seçici HİÇ çizilmez —
     salt okunur satır olarak yazılır. Fiyat istemcide HESAPLANMAZ.
   ⚠ UX-S27: POST yanıtı OKUNUR; sunucunun ürettiği sipariş no banda yazılır.
   ⚠ UX-S28: sunucu hatası "kayıt yok"a çevrilmez; hata bandı ayrıdır.
   ⚠ UX-S29: sunucu sınırı (azami 200) ve "daha fazlası var" ekranda yazılır.
   ⚠ UX-S30: kilitli düğmenin yanında hangi koşulun eksik olduğu yazılır.
   ⚠ UX-3: atölye ve tamir sekmeleri ProAlan içindedir (basit modda gizli);
     müşteri siparişi her moddadır.
   ⚠ Sipariş DEFTERE YAZMAZ — bu ekranda para/stok hareketi doğmaz.
   ═══════════════════════════════════════════════════════════════════════════ *@

<PageTitle>@Marka.SayfaBasligi(Dil.T.Siparis.Baslik)</PageTitle>

@* PAKET YILDIZ-5A: Yıldız şemasında (BASİT + PRO) liste = tuval Y_Siparisvetamir (BİREBİR); özgün ekran yalnız "ayrıntı" görünümünde
   çizilir (data-yz-ozgun; Yıldız dışında öznitelik YAZILMAZ). Öteki 8 şemada aşağıdaki özgün ekran AYNEN. *@
@* YILDIZ-5A tur 2 (tasarım hakemi KRİTİK): "Yeni iş" Yıldız form kalıbında açılır (eski ekrana geçmez); alanlar özgün
   formun bileşenleri, aynı kimlik ve aynı kapıyla (formKapisi). *@
@if (YildizIsFormu)
    {
        var k0 = kalemler[0];
        <CascadingValue Value="formKapisi" IsFixed="true">
        <Kuyumcu.Web.Bilesenler.Yildiz.YildizForm B="@YildizIsBaglami">
            <div class="alan">
                <Secici ElemanId="sip-f-cari" Etiket="@(Dil.BasitMi ? P6.MusteriBasit : Dil.T.Siparis.Cari)" Zorunlu="true"
                        YerTutucu="@(Dil.BasitMi ? P6.MusteriSecinBasit : P6.MusteriSecinPro)"
                        Secenekler="@(CariUzakMi ? null : CariSecenekleri)"
                        UzakTur="@(CariUzakMi ? Kuyumcu.Contracts.Arama.AramaTurleri.Cari : null)"
                        Deger="@fCariId" DegerChanged="CariSec" Hata="@cariHatasi" />
            </div>
            @if (subeler.Count > 1)
            {
                <div class="alan">
                    <Secici ElemanId="sip-f-sube" Etiket="@Dil.T.Siparis.Sube" Zorunlu="true"
                            Secenekler="@SubeSecenekleri" Deger="@fSubeId" DegerChanged="SubeSec" />
                </div>
            }
            else if (subeler.Count == 1)
            {
                <SaltOkunur ElemanId="sip-f-sube-sabit" Etiket="@Dil.T.Siparis.Sube" Deger="@subeler[0].Ad" MakineDeger="@subeler[0].Id" />
            }
            <Metin ElemanId="sip-f-kalem-tanim-0" Etiket="@Dil.T.Siparis.Tanim"
                   EnFazla="@AlanSinirlari.SiparisKalemTanim" Deger="@k0.Tanim"
                   DegerChanged="@(v => TanimDegisti(0, v))" />
            @if (yildizSipEk || detayAcik)
            {
                <div class="alan">
                    <Secici ElemanId="sip-f-kalem-urun-0" Etiket="@Dil.T.Siparis.Urun"
                            YerTutucu="@P6.UrunSecin" BosSecenekMetni="—"
                            Secenekler="@UrunSecenekleri" Deger="@k0.UrunId"
                            DegerChanged="@(v => UrunSec(0, v))" />
                </div>
                <div class="alan">
                    <Secici ElemanId="sip-f-kalem-ayar-0" Etiket="@Dil.T.Siparis.Ayar"
                            YerTutucu="@P6.AyarSecin" BosSecenekMetni="—"
                            Secenekler="@AyarSecenekleri" Deger="@k0.AyarId"
                            DegerChanged="@(v => AyarSec(0, v))" />
                </div>
                <Gram ElemanId="sip-f-kalem-gram-0" Etiket="@Dil.T.Siparis.Gram"
                      Tur="Kuyumcu.Core.Domain.Girdi.AgirlikTuru.Gram" Deger="@k0.Gram"
                      DegerChanged="@(v => GramDegisti(0, v))" />
                <Adet ElemanId="sip-f-kalem-adet-0" Etiket="@Dil.T.Siparis.Adet"
                      Deger="@k0.Adet" DegerChanged="@(v => AdetDegisti(0, v))" />
                <Tarih ElemanId="sip-f-gun" Etiket="@Dil.T.Siparis.SozVerilenGun"
                       Tur="Kuyumcu.Core.Domain.Girdi.TarihTuru.Vade" EnGec="@SozEnGec"
                       Deger="@fGun" DegerChanged="GunDegisti" />
                <Metin ElemanId="sip-f-aciklama" Etiket="@Dil.T.Siparis.Aciklama"
                       EnFazla="@AlanSinirlari.SiparisAciklama" @bind-Deger="fAciklama" />
            }
            @if (kalemHatasi is { } kh)
            {
                <p class="hata-metni" id="sip-f-kalem-hata">@kh</p>
            }
        </Kuyumcu.Web.Bilesenler.Yildiz.YildizForm>
        </CascadingValue>
    }
    else
    {
        <Kuyumcu.Web.Bilesenler.Yildiz.YildizListe B="@YildizBaglami" />
    }
@if (YildizOzgunCiz) {
<div data-yz-ozgun="@YildizOzgunIsaret" class="dikey-bosluk">
    @* P-37c — ORTAK ARAÇ ŞERİDİ: durum süzgeci + geciken kutucuğu + yenile
       şeride taşındı; "Yeni sipariş" TEK birincil eylemdir. Tür sekmeleri
       gezinmedir, kendi kartında kalır. Kimlikler DEĞİŞMEDİ. *@
    <SayfaBasi Anahtar="siparisler" Baslik="@Dil.T.Siparis.Baslik" UstBardaGizle="true">
               @* KESIF-P6 (K17): sayfa başı açıklama satırı kaldırıldı (tuvalde yok); tur 2'de alttaki
                  #sip-defter-notu satırı da kaldırıldı (hakem 01.10). *@
        <Filtreler>
            @* TOPLU-2 (KESIF-P8 açık kalanı "/siparisler yerli select"): durum süzgeci ORTAK Secici
               (/cariler #cari-tur-filtre, /urunler #urun-durum-filtre ile aynı kalıp); kimlik AYNI. *@
            <Secici ElemanId="sip-durum-suzgec" Etiket="@Dil.T.Siparis.Durum"
                    Secenekler="@DurumSecenekleri()"
                    Deger="@durum" DegerChanged="@DurumSecildi"
                    BosSecenekMetni="@Dil.T.Siparis.TumDurumlar" />
            @* PAKET GOC-C: ham onay kutusu → ortak Onay (kimlik AYNI). *@
            <Onay ElemanId="sip-geciken" Etiket="@Dil.T.Siparis.GecikenSuzgeci" Deger="@geciken" DegerChanged="GecikenSecildi" />
            <button type="button" id="sip-yenile" class="dugme dugme-ikincil ikincil" disabled="@yukleniyor" @onclick="Yukle">
                @Dil.T.Bildirim.Yenile
            </button>
            @* TOPLU-4 (TOPLU-2 hakem ORTA "bölünmüş süzgeç"): tür seçimi ayrı kartta değil, durum süzgeciyle
               AYNI şeritte. BASİT yüzde gösterilmez (tek seçenek kalıyordu: "Müşteri siparişi"; liste
               her türü gösterir — UX-S22). Kimlikler AYNI. *@
            <ProAlan>
                <div class="rozet-satir" id="sip-tur-grubu" role="group" aria-label="@Dil.T.Siparis.Tur">
                    <button type="button" id="sip-sekme-tumu" class="@SekmeSinif(null)" @onclick="SekmeTumu">
                        @Dil.T.Siparis.TumTurler
                    </button>
                    <button type="button" id="sip-sekme-musteri" class="@SekmeSinif("MUSTERI_SIPARISI")" @onclick="SekmeMusteri">
                        @Dil.T.Siparis.TurMusteri
                    </button>
                    <button type="button" id="sip-sekme-atolye" class="@SekmeSinif("ATOLYE_SIPARISI")" @onclick="SekmeAtolye">
                        @Dil.T.Siparis.TurAtolye
                    </button>
                    <button type="button" id="sip-sekme-tamir" class="@SekmeSinif("TAMIR")" @onclick="SekmeTamir">
                        @Dil.T.Siparis.TurTamir
                    </button>
                </div>
            </ProAlan>
        </Filtreler>
        <Eylem>
            @* KESIF-P6 (TOPLU DUGME-2): form açıkken düğme "Düzenlemeyi bitir"e döner — vazgeçme eylemi
               birincil mavi KALMAZ (ekranda tek birincil: "Siparişi oluştur"). *@
            @* TOPLU-4 (TOPLU-2 hakem ORTA "iki vazgeç"): form açıkken üstteki düğme GİZLENİR (DOM'da kalır,
               id AYNI); vazgeçme formun kendi "İptal"idir — ekranda tek vazgeç. *@
            <button type="button" id="sip-yeni-ac" class="@(formAcik ? "dugme dugme-ikincil ikincil" : "dugme dugme-birincil")" @onclick="FormuAcKapat"
                    hidden="@formAcik">
                @* TOPLU-6 (TOPLU-4 hakemi DÜŞÜK "'Yeni X' düğme dili"): öteki ekranlarla tek kalıp "+ Yeni …". *@
                @(formAcik ? Dil.T.Siparis.DuzenlemeyiBitir : "+ " + Dil.T.Siparis.Yeni)
            </button>
        </Eylem>
    </SayfaBasi>

    <HataBandi Mesaj="@hata" Id="sip-hata-bandi" />
    <BasariBandi Mesaj="@basari" Jeton="@basariJeton" SureliMs="5000" Id="sip-basari-bandi" />


    @* ── Yeni sipariş formu ─────────────────────────────────────────────── *@
    @if (formAcik)
    {
        @* PAKET GOC-C — form ortak GecersizAlanKapisi taşır: Gram/Adet/Tarih/Metin bileşenlerinin kural
           hatası alan altında görünür ve "Siparişi oluştur" kilidinin sebebi AYNI metindir (kurucu 08.10). *@
        <CascadingValue Value="formKapisi" IsFixed="true">
        <div class="kart" id="sip-form">
            <div class="kart-baslik"><h3>@Dil.T.Siparis.Yeni</h3></div>
            <div class="kart-govde dikey-bosluk">
                @* KESIF-P6 (#35): formdaki her seçim ORTAK Secici'dir (yerli <select> 0). Müşteri
                   TEK arama seçicisiyle seçilir — ayrı "Ara" kutusu kaldırıldı (arama seçicinin
                   içinde); seçenekte ham cari tür kodu (MUSTERI) basılmaz (UX-S31). Kimlikler AYNI. *@
                <div class="alan">
                    <Secici ElemanId="sip-f-tur" Etiket="@Dil.T.Siparis.Tur" Zorunlu="true"
                            Secenekler="@TurSecenekleri" Deger="@fTur" DegerChanged="FormTurSec" />
                </div>

                <div class="alan">
                    <Secici ElemanId="sip-f-cari" Etiket="@(Dil.BasitMi ? P6.MusteriBasit : Dil.T.Siparis.Cari)" Zorunlu="true"
                            YerTutucu="@(Dil.BasitMi ? P6.MusteriSecinBasit : P6.MusteriSecinPro)"
                            Secenekler="@(CariUzakMi ? null : CariSecenekleri)"
                            UzakTur="@(CariUzakMi ? Kuyumcu.Contracts.Arama.AramaTurleri.Cari : null)"
                            Deger="@fCariId" DegerChanged="CariSec"
                            Hata="@cariHatasi" />
                </div>

                @* UX-S22: TEK şubede seçici ÇİZİLMEZ — değer salt okunur satırdır. *@
                @if (subeler.Count > 1)
                {
                    <div class="alan">
                        <Secici ElemanId="sip-f-sube" Etiket="@Dil.T.Siparis.Sube" Zorunlu="true"
                                Secenekler="@SubeSecenekleri" Deger="@fSubeId" DegerChanged="SubeSec" />
                    </div>
                }
                else if (subeler.Count == 1)
                {
                    <p class="metin-kucuk" id="sip-f-sube-sabit">
                        <strong>@Dil.T.Siparis.Sube:</strong> @subeler[0].Ad
                        @* TOPLU-6 (TOPLU-4 hakemi ORTA "PRO'daki rozeti de kaldırın"): tek şubede değer salt okunur
                           satırdır (UX-S22); "oturumdan" rozeti iki modda da çizilmez (kaynak: şube = oturum). *@
                    </p>
                }

                @* ── Kalemler ────────────────────────────────────────────── *@
                @* KESIF-P6 (#34): kalem TABLOSU 1440'ta 1269 px / kap 1074 px taşıyordu (ADET kesik).
                   Her kalem artık bir KART satırıdır (sip-kalem): alanlar kabın genişliğine göre
                   sarar (zo-islem.css .sip-kalem-izgara), 375'te alt alta; hiçbir alan silinmedi,
                   kimlikler AYNI. Ayar serbest metin değil, ortak Ayar seçicisi (#35, UX-S31). *@
                <div class="alan">
                    <span class="alan-etiket">@Dil.T.Siparis.Kalemler</span>
                    <div class="sip-kalemler" id="sip-f-kalemler">
                        @for (var i = 0; i < kalemler.Count; i++)
                        {
                            var sira = i;
                            var k = kalemler[i];
                            <div class="sip-kalem" id="@($"sip-f-kalem-{sira}")">
                                <div class="sip-kalem-bas">
                                    <span class="metin-kucuk metin-soluk">@string.Format(P6.KalemBasligi, sira + 1)</span>
                                    <button type="button" class="btn btn-ikincil btn-kucuk" id="@($"sip-f-kalem-sil-{sira}")"
                                            disabled="@(kalemler.Count <= 1)" title="@(kalemler.Count <= 1 ? Dil.T.Siparis.KalemGerekli : null)"
                                            @onclick="() => KalemSil(sira)">
                                        @Dil.T.Siparis.KalemSil
                                    </button>
                                </div>
                                <div class="sip-kalem-izgara">
                                    <div class="alan sip-kalem-genis">
                                        <Secici ElemanId="@($"sip-f-kalem-urun-{sira}")" Etiket="@Dil.T.Siparis.Urun"
                                                YerTutucu="@P6.UrunSecin" BosSecenekMetni="—"
                                                Secenekler="@UrunSecenekleri" Deger="@k.UrunId"
                                                DegerChanged="@(v => UrunSec(sira, v))" />
                                    </div>
                                    <Metin ElemanId="@($"sip-f-kalem-tanim-{sira}")" Etiket="@Dil.T.Siparis.Tanim"
                                           EnFazla="@AlanSinirlari.SiparisKalemTanim" Deger="@k.Tanim"
                                           DegerChanged="@(v => TanimDegisti(sira, v))" />
                                    <div class="alan">
                                        <Secici ElemanId="@($"sip-f-kalem-ayar-{sira}")" Etiket="@Dil.T.Siparis.Ayar"
                                                YerTutucu="@P6.AyarSecin" BosSecenekMetni="—"
                                                Secenekler="@AyarSecenekleri" Deger="@k.AyarId"
                                                DegerChanged="@(v => AyarSec(sira, v))" />
                                    </div>
                                    @* PAKET GOC-C: gram K10 (> 0, 3 ondalık, eksi tuşta engelli) · adet K14 (tam sayı ≥ 1). *@
                                    <Gram ElemanId="@($"sip-f-kalem-gram-{sira}")" Etiket="@Dil.T.Siparis.Gram"
                                          Tur="Kuyumcu.Core.Domain.Girdi.AgirlikTuru.Gram" Deger="@k.Gram"
                                          DegerChanged="@(v => GramDegisti(sira, v))" />
                                    <Adet ElemanId="@($"sip-f-kalem-adet-{sira}")" Etiket="@Dil.T.Siparis.Adet"
                                          Deger="@k.Adet" DegerChanged="@(v => AdetDegisti(sira, v))" />
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-ikincil" id="sip-f-kalem-ekle" @onclick="KalemEkle">
                        @Dil.T.Siparis.KalemEkle
                    </button>
                    @if (kalemHatasi is { } kh)
                    {
                        <p class="hata-metni" id="sip-f-kalem-hata">@kh</p>
                    }
                </div>

                @* KESIF-P6 tur 2 (hakem 01.10, K16 · kurucu 25.09 "zorunlu olanlar hariç ilk etapta
                   kullanıcı görmesin"): Söz verilen gün, Açıklama ve Tahmini tutar "Daha fazla"
                   bölümünde, açılışta KAPALI (Banka dekont formundaki zo-detay kalıbı). Kalemler
                   zorunlu olduğu için yukarıda kalır; bölüm içindeki kimlikler AYNI. *@
                @if (detayAcik)
                {
                @* TOPLU-6 (TOPLU-4 hakemi ORTA "'Daha fazla' kalıbı farklı"): Hurda'daki "+ … ekle" METİN BAĞLANTISI
                   kalıbı; açıkken "Daha az göster" tetiğin yerinde — yalnız bölümde değer YOKKEN (kapalı bölüm
                   gövdeye gizli değer taşımaz). *@
                @if (DetayKapatilabilir)
                {
                    <button type="button" class="zo-detay-ac" id="sip-f-detay-gizle" @onclick="DetayiKapat"
                            aria-expanded="true" aria-controls="sip-f-detay"><span>@T6.SiparisDetayGizle</span><Ikon Ad="@Ikonlar.KatlamaAcik" Sinif="zo-detay-ok" /></button>
                }
                <div class="zo-detay form-dikey" id="sip-f-detay">
                @* PAKET GOC-C (envanter #9): söz günü bugün..+2 yıl (K8c) — geçmiş gün yazılamaz; elle gg.aa.yyyy. *@
                <Tarih ElemanId="sip-f-gun" Etiket="@Dil.T.Siparis.SozVerilenGun"
                       Tur="Kuyumcu.Core.Domain.Girdi.TarihTuru.Vade" EnGec="@SozEnGec"
                       Deger="@fGun" DegerChanged="GunDegisti" />

                <Metin ElemanId="sip-f-aciklama" Etiket="@Dil.T.Siparis.Aciklama"
                       EnFazla="@AlanSinirlari.SiparisAciklama" @bind-Deger="fAciklama" />
                @* ── Tahmini tutar: SUNUCUDAN (UX-S21) — "Daha fazla" açıkken (tur 2, K16) ── *@
                <div class="alan" id="sip-f-tahmini-alan">
                    <label>@Dil.T.Siparis.TahminiTutar</label>
                    <p class="metin-kucuk" id="sip-f-tahmini">
                        @(fTahminiTutar is { } tt ? Bicim.Tl(tt) : "—")
                        @if (fTahminiTutar is not null)
                        {
                            <Rozet Renk="mavi">@Dil.T.Siparis.TeklifKaynak</Rozet>
                        }
                    </p>
                    <button type="button" class="btn btn-ikincil" id="sip-f-teklif"
                            disabled="@(!TeklifAlinabilir)" @onclick="TeklifAl">
                        @(Dil.BasitMi ? P6.TeklifAlBasit : Dil.T.Siparis.TeklifAl)
                    </button>
                    @if (!TeklifAlinabilir)
                    {
                        @* UX-S30: kilitli düğme sebebini söyler. *@
                        <p class="metin-kucuk metin-soluk" id="sip-f-teklif-sebep">@TeklifSebebi</p>
                    }
                </div>
                </div>
                }
                else
                {
                    <button type="button" class="zo-detay-ac" id="sip-f-detay-ac" aria-expanded="false" @onclick="DetayiAc"><span>@T6.SiparisDetayEkle</span><Ikon Ad="@Ikonlar.KatlamaAcik" Sinif="zo-detay-ok" /></button>
                }


                @if (fTur == "TAMIR")
                {
                    <div class="bant bant-uyari" role="status" id="sip-f-emanet-uyarisi">
                        @Dil.T.Siparis.EmanetUyarisi
                    </div>
                }

                @* ORTAK-1 (KEŞİF #4): kalem gram/adet kutusunda anlaşılamayan sayı ("1.500") varken Oluştur PASİF + sebep. *@
                @if (KalemSayiSebebi is { } kss)
                {
                    <p class="metin-kucuk metin-amber" id="sip-f-sayi-kilit" role="status">@kss</p>
                }
                @* KESIF-P6 (#13): "Siparişi oluştur" tasarım sisteminin birincil düğmesi (.btn .btn-birincil);
                   İptal aynı aileden ikincil — ikisi aynı boyda. *@
                <div class="rozet-satir">
                    <button type="button" class="btn btn-birincil" id="sip-f-kaydet" disabled="@(kaydediliyor || KalemSayiSebebi is not null)" @onclick="Olustur">
                        @Dil.T.Siparis.Olustur
                    </button>
                    <button type="button" class="btn btn-ikincil" id="sip-f-vazgec" @onclick="FormuAcKapat">
                        @Dil.T.Ortak.Iptal
                    </button>
                </div>
            </div>
        </div>
        </CascadingValue>
    }

    @* ── Liste ──────────────────────────────────────────────────────────── *@
    @if (yukleniyor)
    {
        <Yukleniyor />
    }
    else if (liste is { } l)
    {
        @if (l.DahaFazlasiVar)
        {
            <div class="bant bant-uyari" role="status" id="sip-sinir-uyarisi">
                @string.Format(CultureInfo.InvariantCulture, Dil.T.Siparis.SinirUyarisi, l.AzamiLimit)
            </div>
        }

        <div class="kart">
            <div class="kart-govde rozet-satir" id="sip-ozet">
                <span class="metin-kucuk">@Dil.T.Ortak.Tumu: <strong>@l.Toplam</strong></span>
                <span class="metin-kucuk">@Dil.T.Siparis.Geciken: <strong id="sip-ozet-geciken">@l.GecikenSayisi</strong></span>
                @foreach (var k in l.Kirilim)
                {
                    <span class="metin-kucuk">@DurumMetni(k.Durum): <strong>@k.Adet</strong></span>
                }
            </div>
        </div>

        @if (l.Satirlar.Count == 0)
        {
            <BosDurum Mesaj="@Dil.T.Siparis.BosDurum" />
        }
        else
        {
