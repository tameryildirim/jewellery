@page "/islemler"
@using Kuyumcu.Contracts.Bilesenler.MasakFormu
@using System.Globalization
@using Kuyumcu.Core.Sozlesmeler
@using Kuyumcu.Contracts.Sayfalar.Islemler
@using Kuyumcu.Web.Bilesenler.Fis
@using Kuyumcu.Contracts.Sayfalar.SaticiPersonel
@inject ApiIstemci Api
@inject UyumServisi Uyum
@inject DilServisi Dil
@inject CanliKurServisi Canli
@inject OturumServisi Oturum
@inject ArayuzModuServisi Modu
@inject IJSRuntime JS
@implements IDisposable

@* ═══════════════════════════════════════════════════════════════════════════
   İşlemler (Satış / Alış / Hurda Alış / İşçilik / Takas / Transfer)
   • Kur: /kur/guncel → id = kurSnapshotId; 60 sn'de bir tazelenir, her POST'ta
     zorunlu gönderilir.
   • SATIS/ALIS: API kalem başına tek işlem kaydeder — kalemler sırayla POST'lanır.
   • VERESIYE'de kasa seçimi devre dışıdır ve kasaId null gönderilir.
   • TAKAS: fark = yeni değer − eski değer; pozitif → müşteri öder (kasa
     kullanılır), negatif → müşteriye iade (cariye yazılır). Önizleme istemcide
     Kuyumcu.Core HasHesap ile hesaplanır, sunucu aynı formülü uygular.
   • TRANSFER: şubeler arası stok — cari/kasa gerekmez, MUDUR+ yetki ister.
   Kaynak: apps/web/src/pages/SatisPage.tsx + SatisModulu.cs sözleşmesi
   ═══════════════════════════════════════════════════════════════════════════ *@

<PageTitle>@Marka.SayfaBasligi(SayfaAdi)</PageTitle>

<CascadingValue Value="gecersizAlanlar" IsFixed="true"><div class="dikey-bosluk islem-sayfa@((Modu.BasitMi ? " tuval-tezgah" : " tuval-pro") + YildizSinif)" data-acilis="@(acilisBitti ? "bitti" : "suruyor")" @onkeydown="ProKisayol">   @* S1-i .islem-sayfa · T-S1: basit = Tezgah.dc.html · T-S2: pro = Profesyonel.dc.html (css/tuval-satis.css) + F-tuşları *@

    <SayfaBasi Anahtar="islemler" Baslik="@SayfaAdi" Aciklama="@SayfaAciklamasi" UstBardaGizle="true" /><Kuyumcu.Web.Layout.UstBarBasligi Baslik="@SayfaAdi" />   @* S1-i: üst bar ve menüyle AYNI ad (UX-S31) · DEGISIM-GUNSONU: üst bar seçili türün adını yazar (Değişim) — şerit tekrarı görsel gizli *@

    @* ── İşlem türü: pro modda sekmeler, basit modda düğme ızgarası (S2-2) · pro modda "Diğer ▾" (S2-6, Islemler.Diger.cs) ── *@
    @if (YildizTurYuzu) { @YildizTurUstParcasi }<FisIslemIzgarasi Turler="TurListesi" Secili="@(DigerAcik ? "" : tur)" Basit="Modu.BasitMi" TurSec="TurSecDiger"
                      CariId="@cariId" PesinCariId="@pesinCariId" IndirimAcik="indirimAcik" IndirimKullanilir="@(tur == "SATIS" && kalemler.Count > 0)" IndirimDegistir="IndirimDegistir" />
    <FisDigerIslemler Durum="diger" Baglam="DigerBaglami" Basit="Modu.BasitMi" Istek="DigerIstekIsle" EkTurler="ProEkTurler" SeciliTur="@tur" TurSec="TurSecDiger" />
    @if (DigerAcik) { @* S2-6: Diğer paneli fişin YERİNDE çizilir (FisDigerIslemler) — fiş gizli *@ } else if (yukleniyor)
    {
        @if (YildizTezgahYuklenirken) { <div class="yz yz-tezgah-yukleniyor"><Yukleniyor /></div> } else { <Yukleniyor /> }   @* O-15 *@
    }
    else
    {
        <div class="@(YildizTezgahMi ? "islem-fis-kart" : "kart islem-fis-kart")">   @* YILDIZ-4C tur 3: Yıldız'da eski .kart sınıfı yok (görünüm zaten şeffaftı) *@
            <div class="kart-baslik">
                <h2>@SeciliTurAdi @Dil.T.Islem.Formu</h2>@if (Modu.ProfesyonelMi && !YildizTezgahMi) { <Kuyumcu.Web.Bilesenler.Fis.FisKisayollari /> }   @* Y-02: kısayol yardımı (pro; Yıldız kendi çizer) *@
            </div>
            <div class="kart-govde form-dikey">
                @if (Modu.BasitMi) { <BasitSatisAkisi KapiAcik="@BasitBantKapiAcik" Mesaj="@BasitBantMesaji" /> }   @* t3: tetiklenen kural adıyla TEK bant; tezgâh satışında ALDIM durum satırı söyler *@   @* UX-3 Faz B yasal kapı bandı (T-S1: adım şeridi tuvalde yok) *@

                @* ── Cari seçimi (transferde gerekmez) — fiş üst satırı: müşteri + bakiye
                   rozeti + "gerçek müşteri seçin" bandı (PAKET S2-3, Bilesenler/Fis) ── *@
                @if (tur != "TRANSFER" && !(IadeKipi && iadeSecili?.CariId is { Length: > 0 }) && !YildizTezgahMi) { @MusteriSatiriParcasi }   @* t11: iadede müşteri kaynak fişten (FisIade, kilitli) · YILDIZ-4B tur 2: Yıldız'da "Değiştir" katmanında (aynı parça) *@

                @* ── Ödeme (FisOdemeKasa + bacaklar) — tezgâh fişinde ALDIM sütununda (S2-2) ── *@
                @if (!TezgahFisi && !ProSatis && !TakasTuvali)   @* T-S2: PRO satışta ödeme tablonun ALTINDA (#islem-pro-odeme) · DEGISIM-GUNSONU: BASİT Değişim'de fişin Aldım sütununda *@
                {
                    @OdemeParcasi
                }

                @* ── Kalem ekleme (SATIS / ALIS) — Bilesenler/Fis (PAKET S2-1): giriş satırı
                   + kalem tablosu. Barkod/teklif/ekle istekleri SAYFADA kalır. ── *@
                @if (tur is "SATIS" or "ALIS")
                {
                    @if (!ProSatis && !YildizTezgahMi) { @KalemGirisParcasi }   @* SATIS-2 (d+e): PRO satışta tek giriş kalem kartının İÇİNDE *@

                    @* PAKET S2-2 — tezgâh fişi (basit SATIŞ): VERDİM / ALDIM tek kartta + FARK *@
                    @if (YildizTezgahMi) { <Kuyumcu.Web.Bilesenler.Yildiz.YildizTezgah B="@YildizBaglami" /> } else if (TezgahFisi)   @* YILDIZ-4B: tuval Tezgah4/4a (Islemler.Yildiz.cs) *@
                    {
                        <FisVerdimAldim Verdim="KalemParcasi" Aldim="OdemeParcasi" KalemVar="@(kalemler.Count > 0)"
                                        Toplam="ToplamTl" Karma="karmaOdeme" Bacaklar="bacaklar" CariId="@cariId"
                                        PesinCariId="@pesinCariId" Kaydediliyor="kaydediliyor" OdemeyiBol="OdemeyiBol"
                                        TekOdemeyeDon="TekOdemeyeDonAracla" AcikHesap="AcikHesapKaydet" OdemeTuru="@odemeTuru" OdemeSecenekleri="@BasitOdemeSecenekleri" OdemeTuruSec="BasitOdemeSec"
                                        KasaAdi="@kasalar.FirstOrDefault(k => k.Id == kasaId)?.Ad" ToplamGram="@FisHesap.ToplamGram(kalemler, urunler)" KaydetKilitli="@(!Gonderilebilir)" />
                    }
                    else
                    {
                        <FisProKalemKarti Kalemler="kalemler" Urunler="urunler" Toplam="ToplamTl" FisIskontoYuzde="fisIskontoYuzde" Giris="@(ProSatis ? KalemGirisParcasi : null)">@if (kalemler.Count > 0) { @KalemParcasi }</FisProKalemKarti>   @* T-S2 *@
                    }
                }
                @if (ProSatis && ProOdemeSatirIci && !YildizTezgahMi) { <div class="fis-pro-odeme" id="islem-pro-odeme">@OdemeParcasi</div> }   @* SATIS-2 (f): tek ödemede alt çubuk özetinden açılan katmanda *@

                @* ── İade alanları — Bilesenler/Fis/FisIade (PAKET S2-1) ── *@
                @if (tur is "SATIS_IADE" or "ALIS_IADE")
                {
                    <FisIade Adaylar="iadeAdaylari" KaynakId="@iadeKaynakId" KaynakSecildi="IadeKaynakDegisti"
                             Secili="iadeSecili" @bind-Adet="iadeAdet" MusteriAdi="@cariler.FirstOrDefault(c => c.Id == iadeSecili?.CariId)?.Ad" />
                }

                @* ── Hurda alış alanları + satıcı kimliği (DP4-03) — Bilesenler/Fis/FisHurdaAlis (PAKET S2-1) ── *@
                @if (tur == "HURDA_ALIS")
                {
                    <FisHurdaAlis Hurda="hurda" Ayarlar="AyarSecenekleri" CariAdi="@SeciliCariAdi" Degisti="Cizim" Basit="Modu.BasitMi" KimlikMasakta="KimlikBirlesik" TcknMasakta="@(KimlikBirlesik && MasakBelgesiTckn)" />
                }

                @* ── İşçilik alanı ── *@
                @if (tur == "ISCILIK")
                {
                    <Para ElemanId="iscilik-tutar" Zorunlu="true" Etiket="@Dil.T.Islem.IscilikTutari"
                          Tur="Kuyumcu.Core.Domain.Girdi.TutarTuru.Pozitif" @bind-Deger="iscilikTutar" />
                }

                @* ── Takas alanları — Bilesenler/Fis/FisTakas (PAKET S2-1) ── *@
                @if (tur == "TAKAS")
                {
                    @if (TakasTuvali) { <FisTakasTuval Takas="takas" Verdim="TakasYeniParcasi" Aldim="TakasEskiParcasi" Odeme="OdemeParcasi" /> } else { @TakasTamParcasi }   @* DEGISIM-GUNSONU: BASİT Verdim/Aldım fişi (Islemler.Degisim.cs) · PRO aynen *@
                    @* S2-1: FisTakas alanları (tek arama kutusu t3) — parça Islemler.Degisim.cs'te; id/bağlama/gövde AYNEN *@
                    <FisTakasSatici Satici="takas.Satici" Basit="Modu.BasitMi" CariAdi="@SaticiOnDolumAdi" Degisti="Cizim" KimlikMasakta="KimlikBirlesik" TcknMasakta="@(KimlikBirlesik && MasakBelgesiTckn)" />   @* PARA-DEMO md.3: eski altının satıcı kimliği (VUK md.234) *@
                }

                @* ── Transfer alanları — Bilesenler/Fis/FisTransfer (PAKET S2-1) ── *@
                @if (tur == "TRANSFER")
                {
                    <FisTransfer Transfer="transfer" Subeler="subeler" UrunSecenekleri="UrunSecenekleri" Degisti="Cizim" />
                }

                @if (!YildizTezgahMi) { @MasakParcasi }   @* ── MASAK: tutar yasal eşiği aşınca kimlik/beyan formu (sunucu son sözü söyler) · YILDIZ-4B tur 2: Yıldız'da "+ Kimlik bilgisi" çekmecesinde (aynı parça, aynı kapı) ── *@

                @* ── REYON (PAKET 25 · DP4-01) — İSTEĞE BAĞLI; tek reyonda da seçici + "—" (UX-S25 > UX-S22;
                   eski otomatik atama boş reyonda satışı kilitliyordu), tek reyon rozetle korunur. ── *@
                @if (reyonHata is not null && tur is "SATIS" or "ALIS" or "TAKAS" or "TRANSFER")
                {
                    <div class="bant bant-uyari" id="islem-reyon-hata" role="status">@reyonHata</div>
                }
                @if (tur == "TRANSFER")
                {
                    <div class="form-grid-2">
                        <div class="alan">
                            <Secici ElemanId="transfer-kaynak-reyon"
                                    Etiket="@Dil.T.Yerlesim.KaynakReyon"
                                    Secenekler="@(reyonlar.Where(x => x.Aktif && x.SubeId == transfer.KaynakSubeId).Select(r => new SecenekOgesi(r.Id, r.Ad)).ToList())"
                                    @bind-Deger="reyonId"
                                    BosSecenekMetni="—" />
                        </div>
                        <div class="alan">
                            <Secici ElemanId="transfer-hedef-reyon"
                                    Etiket="@Dil.T.Yerlesim.HedefReyon"
                                    Secenekler="@(reyonlar.Where(x => x.Aktif && x.SubeId == transfer.HedefSubeId).Select(r => new SecenekOgesi(r.Id, r.Ad)).ToList())"
                                    @bind-Deger="hedefReyonId"
                                    BosSecenekMetni="—" />
                        </div>
                    </div>
                }

                @if (!YildizTezgahMi) { @OnayBandi }@if (!YildizTezgahMi) { <PesinArtArdaSoru Goster="pesinSoruAcik" Calisiyor="kaydediliyor" Evet="PesinSoruEvet" Hayir="PesinSoruHayir" /> }<HataBandi Mesaj="@hata" Id="hata-bandi" />@if (SunucuAyrinti is { } hamRed) { <details class="fis-bilgi" id="hata-ayrinti"><summary class="metin-kucuk">@Kuyumcu.Core.I18n.Satis3Sozlugu.Al(Dil.Dil).BilgiIpucu</summary><span class="metin-kucuk metin-soluk">@hamRed</span></details> }   @* t10: dayanak (i) içinde *@
                @* UX-4c md.13: 3 sn gizleme BasariBandi'nde. UX-S27: sunucunun FİŞ/HAREKET NO'su banda yazılır —
                   POST yanıtı okunmadan atılmaz (QA turu 2 KRİTİK). *@
                <BasariBandi Mesaj="@(basarili ? BasariMetni : null)"
                             Jeton="@basariJeton" SureliMs="3000" Id="basari-bandi" />
                <FisYazdirBaglantisi Idler="yazdirIdler" Hata="@yazdirHata" FisNo="@SonFisNoGorunen" OtomatikAcildi="otoYazdirAcildi" FotoSahipId="@(tur == "HURDA_ALIS" && yazdirIdler.Count == 1 ? yazdirIdler[0] : null)" />   @* PAKET S2-5 (PLAN 2.7): Kaydet → Yazdır *@@if (fisTaksitUyari is { } ftu) { <div class="bant bant-uyari" id="islem-taksit-uyari" role="status">@ftu</div> }<HataBandi Mesaj="@fisTaksitHata" Id="islem-taksit-hata" />@* YASAL-2 t3: kalan borç yalnız kart/havale (Islemler.Taksit.cs) *@
                @* PAKET 25 · UX-S28: sunucunun döndürdüğü yerleşim uyarısı
                   YUTULMAZ — süreli değildir, kullanıcı okuyana kadar durur. *@
                @if (yerlesimUyarisi is not null)
                {
                    <div class="bant bant-uyari" id="islem-yerlesim-uyari" role="status">
                        @yerlesimUyarisi
                    </div>
                }

                @if (!YildizTezgahMi) { <div class="islem-alt-satir" id="islem-alt-satir">   @* T-S1 tuval alt satırı: Açıklama · Vazgeç · Kaydet ve yazdır *@
                    <details class="fis-diger-ayrinti" id="islem-diger-ayrinti" open="@DigerAyrintiAcik">   @* SATIS-2 (g+h) + kurucu 11:35 · SATIS-3: TÜM türlerde reyon · açıklama (· PRO fiş iskontosu) "+ Ayrıntı ekle" altında KATLI, özellik silinmedi *@
                        <summary id="islem-diger-ayrinti-ac">@SS.DigerAyrintilar</summary>
                        @if (ProSatis && kalemler.Count > 0) { <FisIskontoSatiri @bind-Yuzde="fisIskontoYuzde" Onizleme="IskontoOnizleme" Net="ToplamTl" Form="form" /> }
                        @ReyonParcasi
                        @AciklamaParcasi
                    </details>
                @if (ProSatis) { <FisProOdemeHapi Karma="karmaOdeme" KarmaSec="ProKarmaSec" Bacaklar="bacaklar" Toplam="ToplamTl" OdemeTuru="@odemeTuru" KasaAdi="@kasalar.FirstOrDefault(k => k.Id == kasaId)?.Ad" Kaydediliyor="kaydediliyor" Katman="@(ProOdemeSatirIci ? null : OdemeParcasi)" KatmanAcik="proOdemeAcik" SeciciGorunur="ProOdemeSatirIci" KatmanDegistir="ProOdemeDegistir" /> }
                @if ((TezgahFisi || ProSatis) && FisDolu) { <button type="button" class="btn btn-ikincil" id="islem-vazgec" title="@ST.VazgecIpucu" disabled="@kaydediliyor" @onclick="Vazgec">@ST.Vazgec</button> } else if (TakasTuvali && TakasDolu) { <button type="button" class="btn btn-ikincil" id="islem-vazgec" title="@ST.VazgecIpucu" disabled="@kaydediliyor" @onclick="TakasVazgec">@ST.Vazgec</button> }   @* DEGISIM-GUNSONU: BASİT Değişim'de de Vazgeç *@
                @* UX-S30 — kilitli Kaydet SEBEBİNİ söyler (title + durum); SATIS-2 (i): boş fişte ayrı satır DEĞİL (ekran okuyucuda), dolu fişte Kaydet'in yanında. *@
                @if (!Gonderilebilir && KaydetKilitSebebi is { } kilit) { <span class="metin-kucuk metin-amber islem-kaydet-kilit@(KilitGorunur && !KilitMetniBantta(kilit) ? "" : " gorunmez")" id="islem-kaydet-kilit" role="status">@(KilitMetniBantta(kilit) ? null : kilit)</span> }
                <button class="btn btn-birincil btn-buyuk btn-tam" id="islem-kaydet" disabled="@(kaydediliyor || !Gonderilebilir)" title="@(Gonderilebilir ? null : KaydetKilitSebebi)"
                        @onclick="Kaydet">
                    @if (TezgahFisi && !kaydediliyor) { <Ikon Ad="@Ikonlar.Faturalar" /> }@(kaydediliyor ? Dil.T.Ortak.Yukleniyor : KaydetEtiketi)
                </button>
                </div> }   @* YILDIZ-4B: Yıldız tezgâhında Vazgeç/Kaydet tuvalin sağ sütununda *@
                @* PAKET S2-4 (B4-35): altın bacağı varken kaç belge doğacağı Kaydet'in yanında, KAYITTAN ÖNCE. *@
                @if (KarmaAcik && FisAltinBacagi.BelgeNotu(bacaklar, altinAyarlari, Dil.Dil) is { } belge)
                {
                    <span class="metin-kucuk metin-soluk gorsel-gizli" id="islem-kaydet-belgeler" role="status">@belge</span>   @* t6 (hakem KRİTİK md.7): iki modda da görünmez — aynı bilgi eski altın panelinin (i) Bilgi ipucunda; ekran okuyucuda kalır *@
                }
            </div>
        </div>

        @if (Modu.ProfesyonelMi && !YildizTezgahMi) { <FisProYanSutun YasalGoster="@(tur == "SATIS" || MasakGerekli)" NakitHad="ProNakitHad" NakitAsildi="ProNakitAsildi" NakitNot="@OdemeOtomatikPanelNotu" FisteSoylendi="@YasalMesajVar" KimlikEsigi="@(masakEsik?.KimlikIstenenTutar())" MasakKimlikEsigi="@(masakEsik?.KimlikEsigi)" AmacEsigi="@ProAmacEsigi" MasakOlcu="@ProMasakOlcu" KimlikAsildi="MasakGerekli" Toplam="ToplamTl" YasalHata="@proTevsikHata" Cari="ProCari" PesinSecili="@(!string.IsNullOrEmpty(pesinCariId) && cariId == pesinCariId)" SonIslem="kartSonIslem" KartHata="@kartHata" /> }   @* T-S2 sağ sütun *@
        @* ═══ SON SATIŞLAR — Bilesenler/Fis/FisSonSatislar (PAKET S2-1) ═══════════
           QA turu 1 ve 2 KRİTİK bulgusu. İstekler (liste, kırılım) SAYFADA kalır;
           bileşen yalnız çizer. ⚠ YENİ UÇ AÇILMADI (TB-09). ═══ *@
        <FisSonSatislar Satislar="sonSatislar" Yuklendi="sonSatisYuklendi" Hata="@sonSatisHata"
                        Kirilim="kirilim" Yenile="SonSatislariYukle" IadeyeGec="IadeyeGec"
                        KirilimiDegistir="KirilimiDegistir" Basit="Modu.BasitMi" Cariler="cariler" PesinCariId="@pesinCariId">
            @* Storno düğmesinin GERÇEK gerekçesi ve doğru düzeltme yolu (UX-S25/S31):
               düzeltme kalıbı SAYFADA beyan edilir (P-06 sayacı), kartın içinde çizilir. *@
            <DegismezIpucu Varlik="SatisFisi" Gerekce="@Dil.T.Duzeltme.StornoYokGerekce"
                           AlternatifYol="@Dil.T.Islem.SatisDuzeltmeYolu" />
        </FisSonSatislar>
        @if (TezgahFisi) { <FisNakitUyari Had="tevsikHaddi" Toplam="@TevsikTutar" BantVar="@NakitBandiVar" NakitVar="@NakitOdemede" /> }   @* T-S1: eşik SAYISI sunucudan (/tevsik/gunluk) — istemciye gömülmez *@
    }
</div></CascadingValue>   @* SATIS-3 t17: geçersiz sayı kapısı (Islemler.Gecerlilik.cs) *@

@code {

    // PAKET S2-1 — fiş modelleri (FisKalemi, KalemGirisi, FisBacagi, HurdaGirisi,
    // TakasGirisi, OdemeKirilimi) ve önizleme hesapları (FisHesap) Bilesenler/Fis/
    // FisModelleri.cs'e TAŞINDI. Durumun sahibi hâlâ bu sayfadır; bileşenler
    // POST etmez, tek POST yolu aşağıdaki Kaydet()'tir.
    private readonly KalemGirisi giris = new();

    /// <summary>
    /// TEK fiyat kaynağı sunucudur: GET /fiyat/teklif. Liste yoksa ya da ürün otomatik
    /// fiyatlanamıyorsa (gümüş, kur yok) alan BOŞ kalır ve sebep gösterilir; ekran
    /// kendi formülüyle rakam UYDURMAZ (Faz 0 §11: ham kotasyon deftere yazılmasın).
    /// Sahte/eski sunucu boş gövde döndürürse de "teklif yok" sayılır.
    /// </summary>
    private async Task<decimal?> TeklifAl(string urunId)
    {
        giris.SonTeklif = null;
        if (string.IsNullOrEmpty(kurId)) return null;
        try
        {
            var cariParam = string.IsNullOrEmpty(cariId) ? "" : $"&cariId={cariId}";
            giris.SonTeklif = await Api.GetAsync<Teklif>($"/fiyat/teklif?urunId={urunId}{cariParam}&kurSnapshotId={kurId}"); sonTeklifKurId = kurId;   // EKSIK-KUCUK B2-12: kalem izi (Islemler.ListeGuncelle.cs)
        }
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException) { giris.SonTeklif = new(false, "HATA", null, null, null, null, null, null, null, false, null); }
        return giris.SonTeklif is { TeklifVar: true } t ? t.SatisFiyati : null;
    }

    private bool HediyeVar => kalemler.Any(k => k.Hediye);

    // B-4 (B4-3): HediyeAltinCakismasi kalktı — tek ödemede ALTIN yok (G-1), fiş ALTIN bacağını tanır.
    /// <summary>Hediye işareti değişti (fiyatı FisKalemi.HediyeUygula ayarlar) — önizleme ateşle-unut.</summary>
    private void HediyeDegisti() => _ = TevsikOnizle();

    // UX-4c madde 10 / UX-S31 — ayar listesi TEK KAYNAKTAN gelir.
