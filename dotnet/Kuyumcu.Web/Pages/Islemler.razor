    private async Task TekOdemeyeDon() { await KarmaAnahtari(false); bacaklar.Clear(); }

    /// <summary>"Açık hesap olarak kaydet": FARK'ı VERESİYE bacağıyla kapatır, TEK POST yolu Kaydet()'i çağırır; kilitliyse sebep hata bandına.</summary>
    private async Task AcikHesapKaydet()
    {
        if (FisFark.AcikHesapKilidi(BacakKalan, cariId, pesinCariId, bacaklar,
                Kuyumcu.Core.I18n.TezgahFisiSozlugu.Al(Dil.Dil)) is { } kilit) { hata = kilit; return; }
        if (BelgeSorusuAc()) { belgeSonraAcikHesap = true; return; } bacaklar.Add(FisFark.AcikHesapBacagi(BacakKalan));   // 17.10: fatura sorusu veresiye satırı eklenmeden önce
        await Kaydet();
    }

    /// <summary>
    /// UX-4b madde 7(d) — karma anahtarı değişince: açılırken üst kasa seçicisi
    /// DOM'dan kalkar (tek gerçek bacak kasalarıdır); kapanırken üst seçici geri
    /// gelir ve SON bacağın kasası ön değer olur (kullanıcı aynı kasayı ikinci
    /// kez aramasın). Ön değer yalnız ana seçicide gerçekten bulunan bir TL
    /// kasasıysa uygulanır; aksi hâlde alan boş kalır (fail-closed).
    /// </summary>
    /// <summary>FisOdemeKasa karma anahtarı (Onay) — değer yazılır, sonra eski akış.</summary>
    private async Task KarmaAnahtari(bool acik) { karmaOdeme = acik; await KarmaDegisti(); }

    private async Task KarmaDegisti()
    {
        if (!karmaOdeme)
        {
            var sonKasa = bacaklar.LastOrDefault(b => !string.IsNullOrEmpty(b.KasaId))?.KasaId;
            if (!string.IsNullOrEmpty(sonKasa) && AnaKasalar.Any(k => k.Id == sonKasa))
                kasaId = sonKasa;
            else kasaId = VarsayilanKasaId ?? "";   // SATIS-3 t6: oturumun şubesindeki ilk TL kasası
        }
        await TevsikOnizle();
    }

    // TevsikOnizle → Islemler.Pro.cs (T-S2: PRO Yasal kapılar kartı ayrı durumla; 1400 satır tavanı).
    // İsteğin kendisi BURADA kalır: SozlesmeKapsamTestleri istemci tiplerini .razor'dan tarar (TevsikOnizleme görünür kalsın).
    private Task<TevsikOnizleme> TevsikGetir() => Api.GetAsync<TevsikOnizleme>(TevsikSorgusu());

    /// <summary>
    /// UX-4d madde 5 — tevsik haddi. Sunucunun TevsikKurali.Had varsayılanıyla
    /// aynı; önizleme ucu cevap verirse oradan tazelenir (tek kaynak sunucudur).
    /// </summary>
    private decimal TevsikHaddi => tevsikHaddi ?? 30_000m;
    private decimal? tevsikHaddi;

    /// <summary>Nakit seçiliyken tutar haddi aşıyorsa banka yolu önerilir.</summary>
    internal bool TevsikOnerisiGerekli =>
        TevsikOneri.Gerekli(odemeTuru, IadeKipi ? "ALIS" : tur == "TAKAS" ? "SATIS" : tur, TevsikTutar, TevsikHaddi);   // t15: takasın nakit farkı satış gibi denetlenir (sunucu tevsik.Dogrula)   // t10: işlemin kendi tutarı (hurda/iade kalemsiz)

    // ═══ UX-3 Faz B — BASİT MOD ════════════════════════════════════════════
    // ⚠ Buradaki hiçbir şey bir YETKİ DEĞİLDİR: sunucudaki kapıların hepsi
    //   arayüz modundan habersizdir (K-UX-6). Basit mod yalnız GÖRÜNÜRLÜK ve
    //   VARSAYILAN belirler; gizlenen alan gövdeye de KONMAZ (Mehmet K7).

    /// <summary>
    /// Sunucu son POST'u bir yasal kapıdan çevirdi (400) → basit modda gizlenen
    /// alanlar O AN açılır. Sessiz red YASAKTIR: tezgâhtar ne yapacağını görmeli.
    /// Taş kökeni (ADR-0013) için istemcide ön-kontrol YOKTUR; kapı yalnız
    /// buradan (catch dalından) öğrenilir — Aşkın K1.
    /// </summary>
    // kapiSunucudanAcildi: YASAL-KAPI-GERI — reddin izi (Islemler.YasalKapiGeri.cs); tutar reddin altına inince bant iner

    /// <summary>Basit moddaki adım şeridinde "yasal kapı açıldı" bandı çıkar mı?</summary>
    internal bool YasalKapiAcik => OdemeKapisiAcik || MasakGerekli;

    /// <summary>
    /// Ödeme türü seçicisi basit modda da açılır mı? Bayrakların HEPSİ SUNUCU
    /// KAYNAKLIDIR (tevsik önizlemesi /tevsik/gunluk ve POST'un 400'ü);
    /// eşik SAYISI ekrana gömülmez (Mehmet K2 · ADR-0005).
    /// </summary>
    internal bool OdemeKapisiAcik =>
        tevsikNakitKapali || TevsikOnerisiGerekli || kapiSunucudanAcildi;

    // ═══ PAKET T-S1 — tuval (Tezgah.dc.html): İndirim karosu · Vazgeç ═══
    private Kuyumcu.Core.I18n.SatisTuvalMetinleri ST => Kuyumcu.Core.I18n.SatisTuvalSozlugu.Al(Dil.Dil);
    private bool indirimAcik;
    private void IndirimDegistir() => indirimAcik = !indirimAcik;
    /// <summary>Fişte vazgeçilecek bir şey var mı (yoksa Vazgeç çizilmez — boşa tıklanan düğme doğmaz).</summary>
    internal bool FisDolu => kalemler.Count > 0 || karmaOdeme || !string.IsNullOrEmpty(aciklama);
    /// <summary>Vazgeç: kaydedilmemiş fişi boşaltır (istek ATMAZ; son fiş no/yazdır bağlantısı KALIR — QA-10).</summary>
    private async Task Vazgec()
    {
        kalemler.Clear(); fisIskontoYuzde = null; indirimAcik = false; aciklama = ""; hata = null; masakSunucudanGerekli = false;
        cariId = ""; PesinOnSec(); giris.Sifirla(); form.Temizle(); belgeTuru = null; belgeSorusuAcik = belgeSinirUyarisi = false; KilitBirak(); OnayBirak();   // 17.10: fatura cevabı fişe özgü
        if (karmaOdeme) await TekOdemeyeDon();
        await TevsikOnizle();
    }

    /// <summary>
    /// Basit modda EKRANDA ÇİZİLMEYEN alanı gövdeden ÇIKARIR (Bertan KOŞUL 3,
    /// Mehmet K7, Aşkın K3). Anonim tip alanı koşullu atlayamaz; bu yüzden gövde
    /// sözlüğe çevrilir ve gizli anahtar SİLİNİR — null olarak GÖNDERİLMEZ.
    /// "Gövdede olmayan alan korunur" sözleşmesi bu sayede çalışır; bu projede
    /// null gönderme iki kez veri sildi (cari vergi no/adres, §A11).
    /// Profesyonel modda sözlük anonim tipin birebir kopyasıdır — davranış aynı.
    /// </summary>
    private Dictionary<string, object?> Govde(object temel)
    {
        var d = new Dictionary<string, object?>();
        foreach (var p in temel.GetType().GetProperties())
            d[p.Name] = p.GetValue(temel);

        if (Modu.BasitMi)
            foreach (var alan in BasitPos.GovdedenCikan)
                d.Remove(alan);
        if (tur == "SATIS" && SaticiGovde is { } sp) d["personelId"] = sp; KilitGovdeye(d); OnayGovdeye(d);   // S2-5b · D1-04 kur kilidi

        return d;
    }

    /// <summary>
    /// Mod değişince (ya da basit modda açılışta) ekranın durumu daraltılmış
    /// yüze uyarlanır: görünmeyen sekmede kalınmaz, gizli alanların değerleri
    /// ekranda düzeltilemeyecekleri için temizlenir.
    /// </summary>
    private void BasitModuUygula()
    {
        if (Modu.ProfesyonelMi) return;
        if (!BasitPos.TurGorunur(tur)) { tur = "SATIS"; kalemler.Clear(); }
        TekOdemeyiBasitteKoru();   // SATIS-3 (Islemler.Odeme.cs): mod değişimi girilen ödemeyi silmez
        if (!karmaOdeme && !OdemeKapisiAcik && odemeTuru is not ("NAKIT" or "KART" or "HAVALE")) odemeTuru = "NAKIT";   // PARA-DEMO-2: BASİT tek satırda kart/havale seçilebilir
        vadeGun = null;
    }

    private void ModDegisti()
    {
        BasitModuUygula();   // T-S1: profil sayfadan SONRA yüklenirse (mod PRO→BASİT) nakit uyarısının eşiği o an sunucudan
        InvokeAsync(async () => { if ((TezgahFisi && tevsikHaddi is null) || ProSatis) await TevsikOnizle(yalnizHad: true); await FiyatListeleriYukle(); StateHasChanged(); });   // T-S2: PRO kartı + fiyat listesi
    }

    private List<IadeAdayi> iadeAdaylari = [];

    // ── UX-1-C0 ortak form altyapısı + "Son satışlar" listesi ─────────────
    private readonly FormDurumu form = new();
    /// <summary>Sunucunun POST yanıtından okunan fiş/hareket numarası (UX-S27).</summary>
    private string? sonFisNo, yazdirHata; private readonly List<string> yazdirIdler = [];   // S2-5: yazdırılacak HAREKETLER + hata (UX-S28)
    /// <summary>Son satışlar — AYNI record, AYNI uç (yeni Api.* çağrısı yok).</summary>
    private List<IadeAdayi> sonSatislar = [];
    private bool sonSatisYuklendi;
    private string? sonSatisHata;

    // ═══ PAKET P-23 FAZ 2 (R-17) — ÖDEME KIRILIMI ═══════════════════════════
    // Durum + ayrıştırma FisModelleri.OdemeKirilimi'dedir; istek burada kalır.
    // Hata "kayıt yok"a ÇEVRİLMEZ (UX-S28 / Anayasa md.1).
    private readonly OdemeKirilimi kirilim = new();

    private async Task KirilimiDegistir(string hareketId)
    {
        if (kirilim.AcikId == hareketId) { kirilim.AcikId = null; return; }   // ikinci tıklama kapatır
        kirilim.Ac(hareketId);
        try
        {
            // Uç hem fiş hem HAREKET kimliğini kabul eder (geçmiş satırların
            // fis_id'si yoktur — ölçüldü, varsayılmadı).
            kirilim.Oku(await Api.GetAsync<JsonElement>($"/islemler/fis/{hareketId}"));
        }
        catch (ApiHata ex) { kirilim.Hata = ex.Message; }   // "kayıt yok"a ÇEVRİLMEZ (UX-S28)
        finally { kirilim.Yukleniyor = false; }
    }

    // PAKET P-16 (UX-S27): banda fiş no'nun yanına SUNUCUNUN uyguladığı iskonto da yazılır.
    private string BasariMetni
    {
        get
        {
            var m = Dil.T.Islem.Basarili;
            if (FisYazdir.OkunurNo(sonFisNo) is { } no) m += $" · {Dil.T.Islem.FisNo}: {no}";   // S2-5: ham ULID basılmaz
            if (!string.IsNullOrEmpty(sonIskontoNotu)) m += $" · {sonIskontoNotu}";
            return m;
        }
    }

    /// <summary>
    /// UX-S30 — Kaydet neden kilitli? Görünmez kural olmaz. Sıra, Gonderilebilir
    /// koşullarının SIRASIYLA aynısıdır; ikinci bir kural yazılmaz.
    /// </summary>
    private string? KaydetKilitSebebi =>
        string.IsNullOrEmpty(kurId) ? Dil.T.Islem.BilgiKontrol : GecersizAlanSebebi is { } gas ? gas : IslemBant2Kilidi is { } ib2 ? ib2   // ISLEM-BANT-2: yetki/bant (Islemler.IslemBant2.cs) · t17: anlaşılamayan sayı kutusu ÖNCE söylenir (UX-S30)
        : IadeKipi && iadeSecili is null ? Kuyumcu.Core.I18n.Satis3Sozlugu.Al(Dil.Dil).IadeKaynakSecin   // t11: müşteri kaynaktan gelir — önce kaynak
        : CariGerekli && string.IsNullOrEmpty(cariId) ? CariSecinKilit : PesinVeresiyeVar ? PdKilit.PesinVeresiyeKilit : BelgeKilidi is { } belgeKilit ? belgeKilit   // PARA-DEMO md.4 · M6: fatura seçiliyken gerçek müşteri
        : tur == "TAKAS" && TakasBirlesikKilit is { } tskOnce ? tskOnce : YasalKilitSebebi is { } yasalKilit ? yasalKilit   // PARA-DEMO-2 t5 + PARA-DEMO-3: değişimde satıcı + kimlik tespiti eksikleri TEK cümlede, alan adıyla
        : KarmaAcik && !KarmaGonderilebilir ? KarmaKilitSebebi()   // S2-4: altının İLK eksiği; SATIS-3: tutarı boş ödeme satırı
        : !KarmaAcik && KasaGerekli && string.IsNullOrEmpty(kasaId) ? Dil.T.Islem.KasaSecin
        // DP4 YÜKSEK #2 (UX-S30) — kilit metni TAM CÜMLE: eski "Kimlik Tespitleri" başlığı kullanıcıya ne yapacağını söylemiyordu.
        : !MasakTamam ? (masakHata ? Kuyumcu.Core.I18n.Satis3Sozlugu.Al(Dil.Dil).MasakGereksinimHata : MasakFormu.TcknKilitMetni(masak, Dil.Dil) ?? MasakEksikMetniTekYer)   // t21 · YASAL-KAPI-2: BASİT'te eşik form başlığında TEK kez: kural alınamadıysa GERÇEK engel söylenir
        : (tur == "HURDA_ALIS" && hurda.Fiyat is not > 0) || (tur == "TAKAS" && takas.EskiFiyat is not > 0) ? Kuyumcu.Core.I18n.Satis3Sozlugu.Al(Dil.Dil).FiyatAlaniDuzeltin   // t16 (doğrulayıcı KRİTİK): boş/anlaşılamayan fiyat ("1.500")
        // DP4-03 — hurda alışta satıcı kimliği eksikse sebebi yazılır.
        : tur == "HURDA_ALIS" && !hurda.SaticiTamam(Dil.T.Islem) ? (hurda.TcknAlgoritmaHatasi ? KimlikNoSozlugu.Al(Dil.Dil).TcknGecersiz : Modu.BasitMi ? Kuyumcu.Core.I18n.Satis3Sozlugu.Al(Dil.Dil).SaticiKimligiSade : Dil.T.Islem.SaticiKimligiEksik)
        : tur == "TAKAS" && TakasPosEksik ? Kuyumcu.Core.I18n.Satis3Sozlugu.Al(Dil.Dil).PosCihaziSecin : TakasSaticiKilidi is { } tsk ? tsk   // PARA-DEMO md.3
        : tur is "SATIS" or "ALIS" && kalemler.Count == 0 ? Dil.T.Islem.UrunSecinUyari
        : IadeKipi && !IadeGonderilebilir ? Dil.T.Islem.IadeHakkiBitti
        : null;

    /// <summary>
    /// Son satışlar — bu ekranın ZATEN kullandığı iade-adayları ucundan.
    /// ⚠ UX-S28: hata "kayıt yok"a çevrilmez; liste boşaltılır AMA boş durum
    ///   yalnız istek BAŞARILI ve sonuç gerçekten boşken çizilir.
    /// </summary>
    private async Task SonSatislariYukle()
    {
        sonSatisHata = null; sonSatisIstendi = true;   // SATIS-2: yalnız Katlanir ilk açılınca (ya da Diğer paneli isteyince)
        try
        {
            sonSatislar = await Api.GetAsync<List<IadeAdayi>>("/islemler/iade-adaylari?tur=SATIS&limit=20");
            sonSatisYuklendi = true;
        }
        catch (ApiHata ex)
        {
            sonSatisHata = FormDurumu.SunucuMesaji(ex, Dil);
            sonSatisYuklendi = false;
        }
        catch (JsonException ex)
        {
            // Beklenmeyen yanıt ŞEKLİ de bir hatadır ve kullanıcıya SÖYLENİR
            // (UX-S28); listeyi sessizce boşaltıp "kayıt yok" demek YASAK.
            // Ayrıca bu yakalama, POS formunun geri kalanının açılmasını sağlar:
            // yardımcı bir liste bozuksa satış ekranı tümden kapanmaz.
            sonSatisHata = ex.Message;
            sonSatisYuklendi = false;
        }
    }

    /// <summary>Satırdan "İade et" → iade sekmesi açılır ve kaynak SEÇİLİ gelir (UX-S24).</summary>
    private async Task IadeyeGec(IadeAdayi h)
    {
        tur = "SATIS_IADE";
        kalemler.Clear();
        hata = null;
        form.Temizle();
        await IadeAdaylariYukle();
        iadeKaynakId = h.Id;
        IadeKaynakSecildi();
    }

    private async Task OdakIlkHataya()
    {
        if (form.IlkHatali is not { } ilk) return;
        try { await JS.InvokeVoidAsync("kuyumcuOdak.alana", ilk); }
        catch { /* JS yoksa alan altı mesaj yine görünür */ }
    }

    /// <summary>FisKalemTablosu satır içi düzeltmesi: fiş toplamı değiştiyse nakit kilidi yeniden hesaplanır.</summary>
    private async Task KalemDegisti(bool toplamDegisti)
    {
        if (toplamDegisti) { hata = null; await TevsikOnizle(); }   // t10: fiş değişti → eski sunucu reddi kalkar
    }

    private string iadeKaynakId = "";
    private decimal iadeAdet;
    private IadeAdayi? iadeSecili;

    private bool IadeKipi => tur is "SATIS_IADE" or "ALIS_IADE";

    private async Task IadeAdaylariYukle()
    {
        iadeAdaylari = [];
        iadeKaynakId = "";
        iadeSecili = null;
        iadeAdet = 0m;
        if (!IadeKipi) return;

        var kaynakTur = tur == "SATIS_IADE" ? "SATIS" : "ALIS";
        try { iadeAdaylari = await Api.GetAsync<List<IadeAdayi>>($"/islemler/iade-adaylari?tur={kaynakTur}"); }
        catch (ApiHata ex) { hata = ex.Message; }
    }

    /// <summary>FisIade kaynak seçicisi — değer yazılır, sonra eski akış.</summary>
    private void IadeKaynakDegisti(string? id) { iadeKaynakId = id ?? ""; IadeKaynakSecildi(); }

    private void IadeKaynakSecildi()
    {
        iadeSecili = iadeAdaylari.FirstOrDefault(x => x.Id == iadeKaynakId);
        // Varsayılan: kalanın TAMAMI. Kısmi iade isteyen aşağı çeker.
        iadeAdet = iadeSecili?.KalanAdet ?? 0m;
        if (iadeSecili?.CariId is { Length: > 0 } kc) cariId = kc;   // SATIS-3 · UX-S21/S24: müşteri KAYNAK fişten dolar, ikinci kez sorulmaz
    }

    private bool KarmaAcik => tur == "SATIS" && karmaOdeme;
    private bool KasaKilitli => tur == "SATIS" && odemeTuru == "VERESIYE";

    /// <summary>
    /// Vade girdisi YALNIZ borç doğuran işlemde görünür. Peşin satışta
    /// gösterilseydi kasiyer vade girer, hiçbir yere yazılmaz ve "girdim ama
    /// listede yok" derdi.
    /// </summary>
    private bool VadeGorunur =>
        (tur == "SATIS" && odemeTuru == "VERESIYE" && !string.IsNullOrEmpty(cariId))
        || (tur == "SATIS" && karmaOdeme && bacaklar.Any(b => b.Arac == "VERESIYE") && !string.IsNullOrEmpty(cariId))
        || (tur == "ALIS" && !string.IsNullOrEmpty(cariId));

    private int? vadeGun;
    private bool KasaGerekli => tur is "ALIS" or "HURDA_ALIS" || (tur == "SATIS" && !KasaKilitli);
    private bool CariGerekli => tur != "TRANSFER";

    // ═══ PAKET P-16 (Y-4) — SATIR / FİŞ İSKONTOSU: EKRAN YALNIZ ÖNİZLER ═══
    // ⚠ Buradaki hesap SUNUCUNUN hesabının AYNISI olmak zorundadır ama SON SÖZ
    //   SUNUCUNUNDUR: Kaydet sonrası banda sunucunun döndürdüğü rakam yazılır
    //   (UX-S27). Yuvarlama kuralı sunucuyla aynı: 2 hane, AwayFromZero.
    // Hesap FisHesap'tadır (Bilesenler/Fis/FisModelleri.cs — PAKET S2-1).
    private decimal IskontoOnizleme => FisHesap.IskontoOnizleme(kalemler, fisIskontoYuzde);

    // ⚠ TOPLAM ARTIK NET: ödeme bacakları, tevsik önizlemesi ve nakit kilidi
    //   hepsi bu değeri okur. İskonto düşülmemiş toplam gönderilirse bacak
    //   toplamı sunucunun hesapladığı fiş toplamını tutmaz ve fiş 400 döner.
    private decimal ToplamTl => FisHesap.Toplam(kalemler, fisIskontoYuzde);

    /// <summary>Fiş (genel) iskonto yüzdesi — boş = carinin kartındaki oran (UX-S21).</summary>
    private decimal? fisIskontoYuzde;

    /// <summary>
    /// MASAK'a verilen tutar — sunucunun kapıya verdiğiyle AYNI mantık:
    /// SATIS fiş toplamı (t19: satis-fisi ve tek kalemli uç fiş TOPLAMINA bakar); ALIS fiş toplamı (L-1b); HURDA has×fiyat;
    /// TAKAS Max(eski, yeni) — FARK DEĞİL (Bertan tuzağı); ISCILIK tutar; TRANSFER 0.
    /// </summary>
    private decimal MasakTutar => tur switch
    {
        "SATIS" => ToplamTl,   // t19 (hakem KRİTİK): en büyük kalem DEĞİL — 2×173 bin fiş "Altında" görünüp sunucuda reddediliyordu
        "ALIS" => kalemler.Sum(k => k.Adet * k.BirimFiyat),   // L-1b: alış fişi TEK işlem → sunucu fiş toplamına bakar
        "HURDA_ALIS" => hurda.Gram is > 0 && hurda.Fiyat is > 0 && Kuyumcu.Core.Domain.Ayarlar.Bul(hurda.Ayar) is { } ha
            ? HasHesap.ToHasGram(hurda.Gram.Value, ha) * hurda.Fiyat.Value : 0m,
        "TAKAS" => Math.Max(takas.EskiDeger, takas.YeniDeger),
        "ISCILIK" => iscilikTutar ?? 0m, "SATIS_IADE" or "ALIS_IADE" => IadeTutar,   // t10: sunucu iadede de MASAK'a iade tutarını verir
        _ => 0m,
    };
    // Formun AÇILIP açılmayacağı eşik karşılaştırması istemcide kalır (tek
    // sayı, sunucudan gelir). Hangi ALANLARIN gerektiği ise sunucuya sorulur.
    private bool MasakGerekli => masakEsik is not null && (MasakTutar >= masakEsik.KimlikIstenenTutar() || masakSunucudanGerekli || masakGereksinim is { KimlikGerekli: true });   // t19: kümülatifi sunucu söyler
    private bool MasakTamam =>
        !MasakGerekli || (masakGereksinim is not null && MasakFormu.Eksiksiz(masak, masakGereksinim));

    /// <summary>
    /// Karma fişin gönderilebilmesi için: en az bir bacak, bacak toplamı fiş
    /// toplamına TAM eşit, veresiye dışındaki her bacakta kasa seçili, ve
    /// §4.1.2 nakit kilidi devredeyse nakit bacak YOK.
    /// Sunucu hepsini yeniden doğrular; buradaki kapı kullanıcıyı 400'e
    /// sürüklememek içindir.
    /// </summary>
    private bool KarmaGonderilebilir =>
        bacaklar.Count > 0
        && FisFark.KaydetAcik(BacakKalan)
        && FisFark.Gonderilecek(bacaklar) is { Count: > 0 } gb && gb.All(b => b.TutarTl > 0m)   // k2: boş (0) satır kilitlemez, gönderilmez
        && gb.Count(b => b.Arac == "VERESIYE") <= 1   // t21: veresiye koşulları da GÖNDERİLEN satırlara bakar (boş satır kilitlemez)
        && gb.All(b => !FisAltinBacagi.KasaAlir(b) || !string.IsNullOrEmpty(b.KasaId))
        && !(gb.Any(b => b.Arac == "VERESIYE") && string.IsNullOrEmpty(cariId))
        && FisAltinBacagi.Tamam(bacaklar)   // B-4: tek ALTIN bacağı, satıcı kimliği, FARK 0 (B4-6/32/33)
        && !NakitKapali;

    /// <summary>
    /// İade gönderilebilir mi: kaynak işlem seçili, adet sıfırdan büyük ve
    /// kalan iade hakkını aşmıyor. Sunucu hepsini yeniden doğrular.
    /// </summary>
    private bool IadeGonderilebilir =>
        iadeSecili is not null && iadeAdet > 0m && iadeAdet <= iadeSecili.KalanAdet;

    private bool Gonderilebilir =>
        !gecersizAlanlar.Var && IslemBant2Kilidi is null && MasakTamam && YasalKilitSebebi is null && !PesinVeresiyeVar   // ISLEM-BANT-2 · PARA-DEMO md.4 · t17: anlaşılamayan sayı kutusu varken HİÇBİR gövde gitmez · t10: istemcinin (sunucu eşiğiyle) bildiği yasal engel
        && (!CariGerekli || !string.IsNullOrEmpty(cariId)) && BelgeKilidi is null   // M6
        && !string.IsNullOrEmpty(kurId)
        && (KarmaAcik ? KarmaGonderilebilir : !KasaGerekli || !string.IsNullOrEmpty(kasaId))
        && tur switch
        {
            "SATIS_IADE" or "ALIS_IADE" => IadeGonderilebilir,
            "SATIS" or "ALIS" => kalemler.Count > 0,
            // DP4-03 — satıcı kimliği sunucuda FAIL-CLOSED; ekran da kilitler.
            "HURDA_ALIS" => hurda.Gram is > 0 && hurda.Fiyat is > 0 && hurda.SaticiTamam(Dil.T.Islem),
            "TAKAS" => takas.Tamam && !TakasPosEksik && TakasSaticiKilidi is null,   // PARA-DEMO md.3: satıcı kimliği (sunucu fail-closed)   // t16: çok POS'ta kartlı farkın cihazı seçilmeli (sunucu fail-closed)
            "TRANSFER" => transfer.Tamam,
            _ => iscilikTutar is > 0,
        };

    // ── yaşam döngüsü ──
    /// <summary>
    /// Tutar her değiştiğinde sunucudan gereksinim çekilir. Her girdiye tek tek
    /// `@bind:after` koymak yerine burada toplanır: işlem türüne göre tutarı
    /// besleyen alan değişiyor (gram, fiyat, adet…), hepsini tek yerden yakalar.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool ilkRender)
    {
        await KimlikFormunaKaydir(); await DigerIcinSonSatislar(); if (Satis4Uygula() | YasalIzleriTazele() | await TevsikToplamTazele()) StateHasChanged();   // SATIS-2: Diğer paneli listeyi ister · SATIS-4 (a)(b): ödeme varsayılanı + tek kimlik (Islemler.Satis4.cs)
        if (MasakSorulur ? MasakSorguAnahtari == gereksinimAnahtari : masakGereksinim is null) return;   // t19: soru kalkınca eski cevap da düşer (kayıttan sonra boş form kilitliyordu)
        await GereksinimTazele();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        Dil.Degisti += Yenile; YildizAboneOl();   // YILDIZ-4B: şema değişince tezgâh yüzü yeniden çizilir
        Canli.Degisti += KurYansit;      // canlı kur push geldiğinde kurId/has tazele
        Modu.Degisti += ModDegisti;      // UX-3 Faz B: mod değişince ekran daralır/açılır
        SorgudanSuzgecOku(); BasitModuUygula();   // S1-i: ?tur= derin bağlantısı (Hurda alımı gir)
        try
        {
            // P-16 (B-31): YALNIZ aktif cariler (pasif cari POS'ta seçilebiliyordu — QA tur 5).
            await CarileriTazele(); await BelgeAyariYukle();   // aktif cari listesi — tek istek yeri (S2-3: kayıttan sonra da) · M6: Fiş/Fatura varsayılanı + kuyumcu haddi
            urunler = await Api.GetAsync<List<UrunVeri>>("/urunler?aktif=true&limit=200");
            subeler = (await Api.GetAsync<List<SubeVeri>>("/subeler")).Where(s => s.Aktif).ToList();
            masakEsik = await Api.GetAsync<Esikler>("/masak/esikler");   // kişisel veri yok, tüm roller
            await KasalariYukle(); await BekleyenleriYukle(); await KilitleriYukle();   // D1-03: bekleyenler yardımcı veri (kendi hatasını not satırına yazar)
            await Canli.BaslatAsync();   // SignalR push + ilk kur değeri
            KurYansit();
            if (TezgahFisi || ProSatis) await TevsikOnizle(yalnizHad: true); await FiyatListeleriYukle();   // T-S1: nakit uyarısının eşiği İLK AÇILIŞTA sunucudan (istemcide rakam yok)
        }
        catch (ApiHata ex) { hata = ex.Message; }

        // ── PAKET B-3 (D2) — PEŞİN MÜŞTERİ YARDIMCI VERİDİR ─────────────────
        // Kart okunamazsa POS KAPANMAZ (müşteri listeden seçilir) ama hata da
        // YUTULMAZ (UX-S28): seçicinin altında kendi bandı çıkar.
        try
        {
            var pesin = await Api.GetAsync<Kuyumcu.Contracts.Sayfalar.PesinMusteri.PesinMusteriKarti>("/cari/sistem-carisi");
            if (!string.IsNullOrEmpty(pesin?.Id))
            {
                pesinCariId = pesin.Id;
                if (!cariler.Any(c => c.Id == pesin.Id)) cariler.Insert(0, new CariVeri(pesin.Id, pesin.Ad, true));
                PesinOnSec();
            }
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            pesinHata = PesinMetin.YuklemeHatasi + " (" + ex.Message + ")";
        }

        // PAKET 25 + S2-5b — REYON ve SATICI LİSTESİ YARDIMCI VERİDİR: alınamazsa POS KAPANMAZ,
        // hata YUTULMAZ (UX-S28) — kendi bandı çıkar. Satıcı yoksa sunucu oturum kullanıcısını yazar.
        try { reyonlar = await Api.GetAsync<List<ReyonSatiri>>("/reyonlar"); }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            reyonlar = [];
            reyonHata = ex.Message;
        }
        try { saticilar = await Api.GetAsync<SaticiPersonelListesi>("/islemler/personeller"); }
        catch (Exception ex) when (ex is ApiHata or JsonException) { saticiHata = ex.Message; }

        yukleniyor = false; await HavaleYukle(); acilisBitti = true;   // 17.10 havaleden satış: EN SONDA — açılış adımlarını geciktirmez (Islemler.Havale.cs) · açılış işareti: Islemler.Havale.cs
    }

    private async Task KasalariYukle()
    {
        kasalar = (await Api.GetAsync<List<KasaVeri>>("/kasalar")).Where(k => k.Aktif).ToList();
        // UX-S22 — tek TL kasası varsa sorulmaz, atanır. SATIS-3 t3 (KAYNAK 5 "kasa otomatik"): birden çok TL
        // kasasında OTURUMUN ŞUBESİNDEKİ ilk aktif TL kasası (sunucu OrderBy Id = açılış sırası) varsayılan olur; şubede kasa
        // yoksa boş kalır ve seçici BASİT'te de görünür (fail-closed, t6). PRO'da değiştirilebilir.
        if (string.IsNullOrEmpty(kasaId)) kasaId = VarsayilanKasaId ?? "";
        await PosCihazlariniYukle();
    }

    /// <summary>
    /// PAKET P-10 (Y-3) — aktif POS cihazları. İSTEĞE BAĞLI kaynaktır: uç
    /// erişilemezse satış ekranı ÇÖKMEZ, yalnız kart bacağında "cihaz yok"
    /// yazar ve gövde cihazsız gider (sunucudaki mevcut davranış korunur).
    /// UX-S28: hata sessizce "kayıt yok"a çevrilmez, sebebi banda yazılır.
    /// </summary>
    private async Task PosCihazlariniYukle()
    {
        try { posCihazlari = await Api.GetAsync<List<PosCihazSatir>>("/pos/cihazlar?aktif=true"); }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            posCihazlari = [];
            posCihazHata = ex.Message;
        }
        foreach (var b in bacaklar) FisHesap.BacakPosSabitle(b, posCihazlari);
    }

    /// <summary>POS cihaz listesi alınamadıysa sebebi (UX-S28).</summary>
    private string? posCihazHata;

    /// <summary>
    /// UX-4b madde 7(c) — ANA kasa seçicisinin kaynağı: yalnız TRY kasaları.
    /// Bacak kasaları zaten para birimiyle süzülüyordu (BacakKasalari); ana seçici
    /// tüm kasaları listeliyor ve TL satış USD kasasına yazılabiliyordu. Sunucudaki
    /// K6 kapısı (IslemDogrulayici.KasaDogrula(..., "TRY", ...)) tek kapıdır;
    /// bu süzme onu TEKRARLAMAZ, yalnız imkânsız seçeneği ekrandan kaldırır.
    /// </summary>
    private List<KasaVeri> AnaKasalar => kasalar.Where(k => k.ParaBirimi == "TRY").ToList();

    private bool AnaKasaTek => AnaKasalar.Count == 1;

    /// <summary>SATIS-3 t6 — oturumun şubesine göre varsayılan TL kasası (FisHesap.VarsayilanKasa).</summary>
    private string? VarsayilanKasaId => FisHesap.VarsayilanKasa(AnaKasalar, Oturum.Kullanici?.SubeId, Oturum.Kullanici?.Id);   // D1-11: çalışanın kasası önce

    // Canlı kur servisinden kurSnapshotId + has fiyatını yansıt (push geldiğinde de çağrılır)
    private void KurYansit()
    {
        kurId = KilitliKurId is not null ? kurKilidi!.KurSnapshotId : Canli.Son?.Id;   // D1-04: kilitliyken kilidin kuru
        hasFiyati = KilitliKurId is not null ? kurKilidi!.AltinHasFiyati : Canli.Son?.AltinHasFiyati ?? 0m;
        // UX-S21 — sistemin bildiği has gram fiyatı boş bırakılmaz. Elle girilmiş
        // değerin ÜZERİNE YAZILMAZ: rozet hangi kaynağın geçerli olduğunu söyler.
        if (!hurda.FiyatElle && hasFiyati > 0m) hurda.Fiyat = hasFiyati;
        if (!takas.FiyatElle && hasFiyati > 0m) takas.EskiFiyat = hasFiyati;
        InvokeAsync(StateHasChanged);
    }

    // ── POS barkod okutma ────────────────────────────────────────────────────

    // Barkod metni ve hatası KalemGirisi'ndedir (Bilesenler/Fis/FisKalemGirisi — PAKET S2-1).

    /// <summary>
    /// Barkodu okur, ürünü bulur, fiyatını CANLI kurdan hesaplar ve kalemlere
    /// ekler. Ürün açılır listede olmasa bile (liste sayfalı) çalışır —
    /// bulunan ürün listeye de eklenir ki kullanıcı onu tekrar seçebilsin.
    /// </summary>
    private async Task PosBarkodOkut()
    {
        giris.BarkodHata = null;
        var kod = giris.Barkod.Trim();
        if (kod.Length == 0) return;
        var adla = BasitPos.AdlaBul(urunler.Select(x => (x.Id, x.Ad)), kod);   // T-S1 tuval "ya da ürün adı yaz": barkod 404 ise YÜKLÜ listede adla (istek yok)
        try
        {
            UrunVeri u;
            try { u = await Api.GetAsync<UrunVeri>($"/urunler/barkod/{Uri.EscapeDataString(kod)}"); }
            catch (ApiHata ex) when (ex.StatusCode == 404 && adla.Id is not null) { u = urunler.First(x => x.Id == adla.Id); }
            if (urunler.All(x => x.Id != u.Id)) urunler = [.. urunler, u];

            giris.UrunId = u.Id;
            giris.Adet = 1m;
            giris.BirimFiyat = await TeklifAl(u.Id);
            giris.Barkod = "";
            if (TakasUrunAta()) return;   // t3: Takas'ta okutulan ürün "Yeni ürün" olur

            // ⚠ Gümüşte fiyat BİLEREK hesaplanmaz (gram kotasyonu modelde yok).
            // Sessizce hiçbir şey olmaması, okutucuyu bozuk sandırırdı: ürün
            // seçili bırakılır ve fiyatın elle girilmesi gerektiği söylenir.
            if (giris.BirimFiyat is null or <= 0)
            {
                giris.BarkodHata = FiyatHesaplanamadiMetni(giris.SonTeklif);
                return;
            }
            await KalemEkle();
        }
        catch (ApiHata ex)
        {
            if (ex.StatusCode == 404 && await SetOkut(kod)) return; giris.BarkodHata = ex.StatusCode != 404 ? ex.Message : adla.Sayi > 1 ? string.Format(ST.AdlaCokEslesme, adla.Sayi) : Dil.T.Urun.BarkodBulunamadi;
        }
    }

    private async Task UrunSecildi()
    {
        var u = urunler.FirstOrDefault(x => x.Id == giris.UrunId);
        if (u is not null) giris.BirimFiyat = await TeklifAl(u.Id);
    }

    private async Task TakasYeniUrunSecildi()
    {
        var u = urunler.FirstOrDefault(x => x.Id == takas.YeniUrunId);
        if (u is not null) takas.YeniFiyat = await TeklifAl(u.Id);
    }

    // ── etkileşim ──
    private void TurSec(string yeni)
    {
        tur = yeni; if (!KilitTurunde) KilitBirak(); OnayBirak();   // D1-04: kilit yalnız satış/sipariş teslimi
        kalemler.Clear();
        // PAKET P-16: iskonto SATIŞA aittir; tür değişince taşınmaz.
        fisIskontoYuzde = null;
        hata = null; masakSunucudanGerekli = false;
        pesinKimlikGerekli = false;   // PAKET S2-3

        // ALTIN/VERESIYE yalnız satışta geçerlidir. Satıştan alışa geçerken
        // seçili kalırsa gövdede sunucunun reddedeceği bir değer gider (400).
        if (tur != "SATIS" && odemeTuru is not ("NAKIT" or "KART" or "HAVALE"))
            odemeTuru = "NAKIT";

        // Karma yalnız satışta geçerlidir; tür değişince bacaklar taşınmaz.
        if (tur != "SATIS") { karmaOdeme = false; bacaklar.Clear(); }
        tevsikKalan = null;
        tevsikNakitKapali = false; proTevsik = null; if (tur == "SATIS" && Modu.ProfesyonelMi) _ = InvokeAsync(async () => { await TevsikOnizle(yalnizHad: true); StateHasChanged(); });   // t13: sekme dönüşünde önceki fişin "Aşıldı"sı kalmaz
        PesinOnSec();   // PAKET B-3
        _ = IadeAdaylariYukleCiz();   // SATIS-3: yükleme bitince çizilir (aday listesi boş görünmesin)
    }

    private async Task KalemEkle()
    {
        // QA turu 1+2 YÜKSEK: "adet=0 / fiyat=-5 ile Ekle sessizce hiçbir şey
        // yapmıyor". Artık her eksik alan KENDİ ALTINDA sebebini söyler.
        form.Temizle(); hata = null;   // t10: fiş değişiyor → eski sunucu reddi kalkar
        if (string.IsNullOrEmpty(giris.UrunId)) form.Ekle("islem-adet", Dil.T.Islem.UrunSecinUyari);
        if (giris.Adet <= 0m) form.Ekle("islem-adet", Dil.T.Kabuk.SifirdanBuyuk);
        if (giris.BirimFiyat is null or <= 0m) form.Ekle("islem-birimfiyat", Dil.T.Kabuk.SifirdanBuyuk);
        if (!form.Gecerli)
        {
            await OdakIlkHataya();
            return;
        }

        var mevcut = kalemler.FirstOrDefault(k => k.UrunId == giris.UrunId);
        if (mevcut is not null)
        {
            mevcut.Adet += giris.Adet;
        }
        else
        {
            kalemler.Add(new FisKalemi
            {
                UrunId = giris.UrunId,
                UrunAdi = urunler.FirstOrDefault(u => u.Id == giris.UrunId)?.Ad ?? "",
                Adet = giris.Adet,
                BirimFiyat = giris.BirimFiyat!.Value,
                ListeFiyati = giris.SonTeklif is { TeklifVar: true } t ? t.ListeFiyati : null,
                IndirimOncesi = giris.SonTeklif is { TeklifVar: true } t2 ? t2.IndirimOncesiFiyat : null,
                IscilikTl = FisProKalemKarti.TeklifIscilik(giris.SonTeklif, giris.BirimFiyat),   // T-S2: yalnız teklif fiyatıyla eklenen kalemde
            });
            TeklifIziKaydet(kalemler[^1], giris.SonTeklif);   // EKSIK-KUCUK B2-12: teklif fiyatlı kalemin izi
        }
        giris.Sifirla();
        giris.BarkodHata = null;   // t7: kalem eklendi — "fiyat hesaplanamadı" bandı ekranda kalmaz
        // Fiş toplamı değişti: §4.1.2 nakit kilidi devreye girmiş olabilir.
        await TevsikOnizle();
    }

    private async Task KalemSil(FisKalemi k)
    {
        kalemler.Remove(k); hata = null;   // t10
        await TevsikOnizle();   // fiş toplamı düştü; nakit kilidi kalkmış olabilir
    }

    private async Task Kaydet()
    {   if (BelgeSorusuAc()) return;   // 17.10 kurucu: müşterili satışta "Fatura kesilsin mi?" önce sorulur (Islemler.Belge.cs)
        hata = null;
        pesinKimlikGerekli = false;   // PAKET S2-3: bant yalnız SON denemenin reddini gösterir
        // Kapı bayrağı her denemede SIFIRLANIR: bir önceki reddin açtığı alan,
        // sorun çözüldükten sonra kalıcı olarak açık kalmaz.
        kapiSunucudanAcildi = false;
        basarili = false;
        sonFisNo = null; yazdirHata = null; yazdirIdler.Clear(); otoYazdir = SatisTuvali && TekBelge && !FaturaSecili; otoYazdirAcildi = false;   // T-S1: etiket "ve yazdır" diyorsa yazdırma KAYITTAN SONRA açılır · 19.10 kurucu: faturalı satışta çıktı AÇILMAZ (fatura elektronik gider)
        sonIskontoNotu = null; sonFaturaNotu = null;   // M6
        yerlesimUyarisi = null; fisTaksitUyari = null; fisTaksitHata = null;   // YASAL-2 t3
        form.Temizle();
        if (string.IsNullOrEmpty(kurId)) { hata = Dil.T.Islem.BilgiKontrol; return; }

        // DP4-03 — SUNUCUYA GİTMEDEN ÖNCE son kapı. Düğme zaten kilitli ve sebebi
        // ekranda yazılı; burada sessizce dönmek yerine aynı sebep HATA BANDINA
        // da yazılır (DoD EK md.3: sessiz etkisizlik yasak).
        if (!Gonderilebilir) { hata = KaydetKilitSebebi ?? Dil.T.Islem.BilgiKontrol; return; }

        kaydediliyor = true;
        var kaydedildi = false;
        try
        {
            var kasa = string.IsNullOrEmpty(kasaId) ? null : kasaId;
            var acikl = string.IsNullOrWhiteSpace(aciklama) ? null : aciklama;

            if (IadeKipi)
            {
                var uc = tur == "SATIS_IADE" ? "satis-iade" : "alis-iade";
                YazdirEkle(await Api.PostAsync<JsonElement>($"/islemler/{uc}", new
                {
                    kaynakHareketId = iadeKaynakId,
                    adet = iadeAdet,
                    odemeTuru,
                    kasaId = odemeTuru == "VERESIYE" ? null : kasa,
                    kurSnapshotId = kurId,
                    aciklama = acikl,
                    masak = MasakGovdesi,
                }));
            }
            else if (tur == "SATIS" && karmaOdeme)
            {
                // ⚠ TEK POST. Çok bacaklı fiş bölünemez: kalemler ayrı ayrı
                // gönderilseydi ödeme bacakları hangi kaleme ait olurdu
                // belirsiz kalır, kısmi başarısızlıkta fişin yarısı yazılırdı.
                var fy = await Api.PostAsync<JsonElement>("/islemler/satis-fisi", Govde(new
                {
                    cariId = string.IsNullOrEmpty(cariId) ? null : cariId, bantOnay = FisAltinBacagi.Bant(bacaklar)?.GovdeOnay, bantGerekce = FisAltinBacagi.Bant(bacaklar)?.GovdeGerekce,   // ISLEM-BANT
                    kalemler = kalemler.Select(k => new
                    {
                        urunId = k.UrunId,
                        adet = k.Adet,
                        birimFiyatTl = k.BirimFiyat,
                        hediye = k.Hediye,
                        // PAKET P-16 (Y-4): YÜZDE gider, TUTAR gitmez.
                        satirIskontoYuzde = k.SatirIskontoYuzde,
                    }),
                    odemeler = FisFark.Gonderilecek(bacaklar).Select(b => FisAltinBacagi.Govde(b, altinAyarlari) ?? new   // B-4: ALTIN kendi sözleşmesiyle
                    {
                        arac = b.Arac,
                        tutarTl = b.TutarTl,
                        kasaId = b.Arac == "VERESIYE" || string.IsNullOrEmpty(b.KasaId) ? null : b.KasaId,
                        paraBirimi = b.Arac == "DOVIZ" ? b.ParaBirimi : null,
                        dovizTutar = b.Arac == "DOVIZ" ? (decimal?)b.DovizTutar : null,
                        // P-10 (Y-3): yalnız KART bacağında gönderilir; boş bırakılırsa
                        // sunucu TEK cihazı kendi seçer (OdemeSepeti sözleşmesi).
                        posCihazId = b.Arac == "KART" && !string.IsNullOrEmpty(b.PosCihazId) ? b.PosCihazId : null,
                        posTaksitAdedi = b.Arac == "KART" ? (int?)b.PosTaksitAdedi : null,
                    }),
                    vadeGun,
                    kurSnapshotId = kurId,
                    aciklama = acikl,
                    masak = MasakGovdesi,
                    // PAKET P-16 (Y-4 / UX-S21): boş gönderilirse sunucu carinin
                    // kartındaki oranı uygular; ekran onun yerine tahmin yapmaz.
                    fisIskontoYuzde, belgeTuru = BelgeGovde,   // M6: FATURA → satış + fatura aynı istekte
                }));
                fy = BelgeYaniti(fy); sonFisNo = FisYaniti.FisNo(fy);   // M6: faturalı yanıtın satış kısmı fiş okuyucularına AYNEN
                sonIskontoNotu = FisAltinBacagi.NotBirlestir(FisYaniti.IskontoNotu(fy, Dil.T.Islem), FisAltinBacagi.PusulaNotu(fy, Dil.Dil));   // UX-S27 (B-4): pusula no
            }
            else if (tur == "SATIS" && FisUcunaGider)
            {
                // HEDİYE/İSKONTO yalnız FİŞ ucunda tanımlıdır (P-16: /islemler/satis iskonto TANIMAZ, oran sessizce
                // yok sayılırdı). ⚠ PAKET L-1 (tevsik, KRİTİK): çok kalemli düz satış da TEK fiştir — kalem başına
                // POST fişi tevsik haddinin altına bölüyordu, kapı fiş toplamını görmüyordu (Islemler.Yazdir.cs).
                var hy = await Api.PostAsync<JsonElement>("/islemler/satis-fisi", Govde(new
                {
                    cariId = string.IsNullOrEmpty(cariId) ? null : cariId,
                    kalemler = kalemler.Select(k => new { urunId = k.UrunId, adet = k.Adet, birimFiyatTl = k.BirimFiyat, hediye = k.Hediye, satirIskontoYuzde = k.SatirIskontoYuzde }),
                    odemeler = TekOdeme(kasa),   // 17.10: havale modunda banka hareketine bağlı bacak (Islemler.Havale.cs)
                    vadeGun,
                    kurSnapshotId = kurId,
                    aciklama = acikl,
                    masak = MasakGovdesi,
                    personelId = SaticiGovde,   // S2-5b (null = oturum kullanıcısı)
                    fisIskontoYuzde = HediyeVar || IskontoVar ? fisIskontoYuzde : 0m,   // L-1: düz fişe carinin oranı sessizce girmez (bacak = ToplamTl)
                    reyonId = SecilenReyon, belgeTuru = BelgeGovde,   // L-1: tek kalemli uçla aynı reyon sözleşmesi · M6
                }));
                // UX-S27: POST yanıtı OKUNUR — fiş no, uygulanan iskonto ve reyon uyarısı banda yazılır.
                hy = BelgeYaniti(hy); sonFisNo = FisYaniti.FisNo(hy);   // M6
                sonIskontoNotu = FisYaniti.IskontoNotu(hy, Dil.T.Islem);
                yerlesimUyarisi = FisYaniti.YerlesimUyarisi(hy);
            }
            else if (AlisFisUcunaGider)
            {
                // ⚠ PAKET L-1b (tevsik, KRİTİK): ≥2 kalemli ALIS TEK POST — kalem başına POST fişi haddin altına bölüyordu.
                var af = await Api.PostAsync<JsonElement>("/islemler/alis-fisi", Govde(new
                {
                    cariId,
                    kalemler = kalemler.Select(k => new { urunId = k.UrunId, adet = k.Adet, birimFiyatTl = k.BirimFiyat }),
                    odemeTuru, kasaId = kasa, vadeGun, kurSnapshotId = kurId, aciklama = acikl,
                    masak = MasakGovdesi, reyonId = SecilenReyon,
                }));
                sonFisNo = FisYaniti.FisNo(af); yerlesimUyarisi = FisYaniti.YerlesimUyarisi(af); YazdirEkle(af);   // UX-S27
            }
            else if (tur is "SATIS" or "ALIS")
            {
                // SATIS ve ALIS buraya yalnız TEK kalemle düşer (L-1 / L-1b).
                foreach (var k in kalemler)
                {
                    if (tur == "SATIS")
                    {
                        // UX-S27: POST yanıtı ARTIK OKUNUYOR — sunucunun ürettiği
                        // hareket/fiş numarası başarı bandına yazılır.
                        var y = await Api.PostAsync<JsonElement>("/islemler/satis", Govde(new
                        {
                            cariId,
                            urunId = k.UrunId,
                            adet = k.Adet,
                            birimFiyatTl = k.BirimFiyat,
                            odemeTuru,
                            kasaId = odemeTuru == "VERESIYE" ? null : kasa,
                            vadeGun,
                            kurSnapshotId = kurId,
                            aciklama = acikl,
                            masak = MasakGovdesi,
                            reyonId = SecilenReyon,
                        }));
                        sonFisNo ??= FisYaniti.FisNo(y); YazdirEkle(y);
                        yerlesimUyarisi ??= FisYaniti.YerlesimUyarisi(y);
                    }
                    else
                    {
                        var ay = await Api.PostAsync<JsonElement>("/islemler/alis", Govde(new
                        {
                            cariId,
                            urunId = k.UrunId,
                            adet = k.Adet,
                            birimFiyatTl = k.BirimFiyat,
                            odemeTuru,
                            kasaId = kasa,
                            vadeGun,
                            kurSnapshotId = kurId,
                            aciklama = acikl,
                            masak = MasakGovdesi,
                            reyonId = SecilenReyon,
                        }));
                        yerlesimUyarisi ??= FisYaniti.YerlesimUyarisi(ay); YazdirEkle(ay);
                    }
                }
            }
            else if (tur == "HURDA_ALIS")
            {
                await Api.PostAsync("/islemler/hurda-alis", new
                {
                    cariId,
                    ayarId = hurda.Ayar,
                    gramAgirlik = hurda.Gram!.Value,
                    birimFiyatTlHasGram = hurda.Fiyat!.Value, bantOnay = hurda.Bant.GovdeOnay, bantGerekce = hurda.Bant.GovdeGerekce,   // ISLEM-BANT
                    odemeTuru,
                    kasaId = kasa,
                    kurSnapshotId = kurId,
                    aciklama = acikl,
                    masak = MasakGovdesi,
                    // DP4-03 — VUK md.234 satıcı kimliği. Sunucu bu blok olmadan
                    // 400 döner; eskiden gövdeye hiç konmuyordu.
                    satici = new
                    {
                        saticiTipi = hurda.SaticiTipi,
                        adSoyad = Bos(hurda.SaticiAd),
                        tckn = hurda.TcknRakam.Length == 0 ? null : hurda.TcknRakam,
                        adres = Bos(hurda.SaticiAdres),
                        tedarikciFaturaNo = Bos(hurda.TedarikciFaturaNo),
                    },
                });
            }
            else if (tur == "TAKAS")
            {
                var tky = await Api.PostAsync<JsonElement>("/islemler/takas", new {
                    cariId,
                    eskiUrunAyarId = takas.EskiAyar,
                    eskiUrunGram = takas.EskiGram!.Value,
                    eskiUrunBirimFiyatTlHasGram = takas.EskiFiyat!.Value, bantOnay = takas.Bant.GovdeOnay, bantGerekce = takas.Bant.GovdeGerekce,   // ISLEM-BANT
                    yeniUrunId = takas.YeniUrunId,
                    yeniUrunAdet = takas.YeniAdet,
                    yeniUrunBirimFiyatTl = takas.YeniFiyat!.Value, odemeTuru, posCihazId = TakasPosId,   // t15: farkın ödeme türü (TakasDto.OdemeTuru; varsayılan NAKIT sunucuyla aynı) · t16: TakasDto.PosCihazId
                    reyonId = SecilenReyon,
                    kasaId = kasa,
                    kurSnapshotId = kurId,
                    aciklama = acikl,
                    masak = MasakGovdesi, satici = TakasSaticiGovdesi(),   // PARA-DEMO md.3 — VUK md.234; sunucu bu blok olmadan 400
                }); sonIskontoNotu = TakasPusulaNotu(tky);   // UX-S27: düzenlenen gider pusulasının no'su bantta
            }
            else if (tur == "TRANSFER")
            {
                var ty = await Api.PostAsync<JsonElement>("/islemler/transfer", new
                {
                    kaynakSubeId = transfer.KaynakSubeId,
                    hedefSubeId = transfer.HedefSubeId,
                    urunId = transfer.UrunId,
                    adet = transfer.Adet,
                    kurSnapshotId = kurId,
                    aciklama = acikl,
                    reyonId = string.IsNullOrEmpty(reyonId) ? null : reyonId,
                    hedefReyonId = string.IsNullOrEmpty(hedefReyonId) ? null : hedefReyonId,
                });
                yerlesimUyarisi ??= FisYaniti.YerlesimUyarisi(ty);
            }
            else // ISCILIK
            {
                await Api.PostAsync("/islemler/iscilik", new
                {
                    cariId,
                    iscilikTl = iscilikTutar!.Value,
                    kasaId = kasa,
                    kurSnapshotId = kurId,
                    aciklama = acikl,
                    masak = MasakGovdesi,
                });
            }
            kaydedildi = true;
        }
        catch (ApiHata ex)
        {
            // UX-S28 / Aşkın K1 · K10 — HATA YUTULMAZ, "kayıt yok"a çevrilmez:
            // sunucunun mesajı OLDUĞU GİBİ banda yazılır. Basit modda ayrıca
            // gizlenen alanlar AÇILIR (ProAlan.ZorunluGorunur): taş kökeni
            // (ADR-0013) gibi yalnız sunucuda bilinen kapılarda tezgâhtar aksi
            // hâlde neyi düzelteceğini göremezdi.
            hata = SunucuMesaji(ex); masakSunucudanGerekli |= MasakReddi(ex);   // t10: BASİT'te kısa cümle · MASAK alanları açılır
            kapiSunucudanAcildi = true;
            pesinKimlikGerekli = ex.StatusCode == 400 && ex.Alanlar.ContainsKey("cariId") && cariId == pesinCariId; Yasal3Yakala(ex); MusteriKimlikYakala(ex); OnayYakala(ex);   // YASAL-3 · D1-05 · 18.10 eksik TC
        }
        kaydediliyor = false;
        if (!kaydedildi) return;
        masak = new(); masakSunucudanGerekli = false; Yasal3Sifirla(); KilitBirak(); OnayBirak();   // D1-04 · D1-05 · kişisel veri formda kalmaz · YASAL-3: beyan fişe özgü

        // başarı: formu sıfırla, kasa bakiyelerini tazele, bandı 3 sn göster
        var taksitSorgu = FisTaksitSorgusu(); SonKaydiTut(); kalemler.Clear();   // T-S1 (QA-10): kaydedilenin özeti bir sonraki Kaydet'e kadar görünür
        fisIskontoYuzde = null; indirimAcik = false;   // PAKET P-16: bir sonraki fişe iskonto sızmaz
        cariId = ""; belgeTuru = null;   // 17.10: sonraki satışta fatura yeniden sorulur
        PesinOnSec();             // PAKET B-3: yeni fiş yine Peşin Müşteri ile açılır
        aciklama = "";
        // DP4-03 — satıcı kimliği FİŞE ÖZGÜDÜR, sonraki alışa taşınmaz.
        // UX-4b madde 7(a): yeni fişte fiyat yeniden KURDAN gelir — elle giriş fişe özgüdür.
        hurda.Sifirla(hasFiyati);
        iscilikTutar = null;
        takas.Sifirla(hasFiyati);
        transfer.Sifirla();
        // t10 (tasarım hakemi KRİTİK): ödeme durumu da fişe özgüdür — karma satırlar, eski altın
        // satıcısının kimliği ve para üstü sıradaki müşterinin fişine TAŞINMAZ (Vazgeç ile aynı).
        odemeTuru = "NAKIT"; proOdemeAcik = false; if (karmaOdeme) await TekOdemeyeDon(); ProYasalBosFis();   /* PARA-DEMO-2 md.11: açık ödeme katmanı başarı bandını örtmez */   // KESIF-P5 t2 (hakem KRİTİK): boş fişte önceki fişin "Aşıldı"sı kalmaz
        try { await KasalariYukle(); } catch (ApiHata) { /* bakiye tazelenemedi, kritik değil */ }
        try { await CarileriTazele(); } catch (Exception ex) when (ex is ApiHata or JsonException) { hata = ex.Message; }

        await YazdirKalemiBul(); await OtomatikYazdir();   // S2-5: satis-fisi yalnız fisId döndürür · T-S1: tek belge → kendiliğinden yazdır
        basarili = true;
        basariJeton++; await FisTaksitUyariYukle(taksitSorgu);   // YASAL-2 t3: sunucu söylerse tek satır
        // Kaydedilen fiş AYNI EKRANDA görünür olmalı (QA turu 1+2 KRİTİK).
        await SonSatislariTazele();   // SATIS-2: liste açılmışsa tazelenir
    }

    /// <summary>
    /// PAKET 25 · DP4-01 — gövdeye konacak reyon. ARTIK OTOMATİK ATAMA YOK:
    /// kullanıcı ne seçtiyse o gider, boş bırakırsa sunucu sırası (önce atanmamış)
    /// işler. Tek reyon varken otomatik atama, reyon boşken satışı kilitliyordu
    /// (QA turu 4 KRİTİK — çıkmaz); bu yüzden kaldırıldı.
    /// </summary>
    private void YazdirEkle(JsonElement y) { if (FisYazdir.HareketId(y) is { } h) yazdirIdler.Add(h); }   // PAKET S2-5 (PLAN 2.7)
    private async Task YazdirKalemiBul()
    {
        if (yazdirIdler.Count > 0 || tur != "SATIS" || string.IsNullOrEmpty(sonFisNo)) return;
        try { if (FisYazdir.IlkKalem(await Api.GetAsync<JsonElement>($"/islemler/fis/{Uri.EscapeDataString(sonFisNo)}")) is { } h) yazdirIdler.Add(h); }
        catch (Exception ex) when (ex is ApiHata or JsonException) { yazdirHata = ex.Message; }   // UX-S28: yutulmaz
    }

    private string? SecilenReyon =>
        string.IsNullOrEmpty(reyonId) ? null : reyonId;

    // ═══ PAKET P-16 (Y-4 / UX-S27) — UYGULANAN İSKONTO BANDA YAZILIR ═══════
    // ⚠ Ekranın önizlemesi DEĞİL, SUNUCUNUN döndürdüğü rakam gösterilir.
    //   İkisi ayrışırsa kullanıcı sunucunun yazdığını görür; ekran kendi
    //   tahminini "olmuş" diye sunmaz (Anayasa md.1).
    private string? sonIskontoNotu;

    /// <summary>Satırlarda ya da fişte iskonto var mı — uç seçimini belirler.</summary>
    private bool IskontoVar => fisIskontoYuzde is > 0m || kalemler.Any(k => k.SatirIskontoYuzde > 0m);

    // Yanıt okuyucuları (fiş no, yerleşim uyarısı, uygulanan iskonto) → FisYaniti (PAKET S2-1).

    private void Yenile() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Dil.Degisti -= Yenile; YildizAboneliktenCik();
        Canli.Degisti -= KurYansit;
        Modu.Degisti -= ModDegisti; onayIptal?.Cancel();
    }
}
