    private async Task YeniKalemEkle()
    {
        if (duzenlenen is not { } f || kalemYanit is null) return;
        yeniKalemForm.Temizle();
        kalemHata = null;
        cekmeceKalemBasari = null;

        // Boş/geçersiz gönderimde SESSİZ etkisizlik yok (DoD EK md.3) — alan altı mesaj.
        // Sayı ayrıştırması (tr-TR, "1.250,50") ortak girdi ailesindedir (SayisalAlan).
        var miktar = ykMiktar;
        var fiyat = ykFiyat;
        var iscilik = ykIscilik;
        var indirim = ykIndirim;
        if (miktar is null) yeniKalemForm.Ekle("fd-kalem-yeni-miktar", Dil.T.Kabuk.ZorunluAlan);
        else yeniKalemForm.Pozitif("fd-kalem-yeni-miktar", miktar, Dil);
        if (fiyat is null) yeniKalemForm.Ekle("fd-kalem-yeni-fiyat", Dil.T.Kabuk.ZorunluAlan);
        else yeniKalemForm.NegatifDegil("fd-kalem-yeni-fiyat", fiyat, Dil);
        yeniKalemForm.NegatifDegil("fd-kalem-yeni-iscilik", iscilik, Dil);
        yeniKalemForm.NegatifDegil("fd-kalem-yeni-indirim", indirim, Dil);
        var urunId = string.IsNullOrWhiteSpace(ykUrunId) ? null : ykUrunId;
        if (f.KdvTuru == "KUYUM" && urunId is null)
            yeniKalemForm.Ekle("fd-kalem-yeni-urun", FT.KuyumUrunZorunlu);
        else if (urunId is null && string.IsNullOrWhiteSpace(ykAciklama))
            yeniKalemForm.Ekle("fd-kalem-yeni-aciklama", FT.AciklamaYaDaUrun);
        if (yeniKalemForm.Gecerli && YeniSatirOnizleme is <= 0m)
            yeniKalemForm.Ekle("fd-kalem-yeni-fiyat", FT.SatirToplamiSifir);
        if (!yeniKalemForm.Gecerli) { kalemHata = Dil.T.Kabuk.FormEksik; return; }

        kalemEkleniyor = true;
        try
        {
            var govde = new Dictionary<string, object?>
            {
                ["urunId"] = urunId,
                ["aciklama"] = string.IsNullOrWhiteSpace(ykAciklama) ? null : ykAciklama.Trim(),
                ["miktar"] = miktar,
                ["birimFiyat"] = fiyat,
                ["iscilikTl"] = iscilik,
                ["indirimTutari"] = indirim,
            };
            // UX-S27: POST yanıtı OKUNUR — yeni satır ve toplam sunucudan gelir.
            var yanit = await Api.PostAsync<KalemYaniti>($"/faturalar/{f.Id}/kalemler", govde);
            kalemYanit = yanit;
            var sira = yanit.Kalemler.Count == 0 ? 0 : yanit.Kalemler.Max(k => k.Sira);
            var mesaj = string.Format(FT.SatirEklendi, sira, Bicim.Tl(yanit.Toplam));
            CekmeceKalemSonucu(mesaj);
            BasariGoster(mesaj);
            YeniKalemFormunuSifirla();
            await Yukle();
        }
        catch (ApiHata ex)
        {
            yeniKalemForm.Sunucudan(ex, YeniKalemAlanEslemesi);
            if (yeniKalemForm.Gecerli)
            {
                foreach (var (anahtar, alan) in YeniKalemMesajEslemesi)
                {
                    if (ex.Message.Contains(anahtar, StringComparison.CurrentCultureIgnoreCase))
                    {
                        yeniKalemForm.Ekle(alan, ex.Message);
                        break;
                    }
                }
            }
            kalemHata = yeniKalemForm.Gecerli ? FormDurumu.SunucuMesaji(ex, Dil) : FT.KalemHatali;
        }
        catch (JsonException ex) { kalemHata = ex.Message; }
        finally { kalemEkleniyor = false; }
    }

    // ── Başlık düzenleme — TEK KALIP: Cekmece (çok alanlı) ──────────────────
    private FaturaVeri? duzenlenen;
    private string dCariId = "", dAciklama = "";
    private decimal? dToplam;
    private DateTime dTarih = DateTime.Today;
    // BELGE-KALAN: çekmece açılırken gösterilen gün — değişmediyse PATCH gövdesine girmez
    // (sözleşme: gövdede yoksa KORU → kaydın saati de korunur).
    private DateTime dTarihIlk = DateTime.Today;

    /// <summary>BELGE-KALAN — belgenin GÜNÜ: listeyle (Bicim.Tarih) aynı kural. Tur 2: tarayıcı yereli
    /// değil İŞLETME günü (Europe/Istanbul, Bicim.IsletmeZamani) — sunucunun PATCH gün kararıyla aynı.</summary>
    internal static DateTime BelgeGunu(DateTime t) => Bicim.IsletmeZamani(t).Date;
    private string? duzenleHata;
    private bool duzenleKaydediliyor;
    // P-53: çekmecenin alan→mesaj defteri (sunucu 400'ü ALANIN ALTINA yazılır).
    private readonly FormDurumu duzenleForm = new();
    // P-53: cari listesi yüklenemediyse dolu — Kaydet kilitlenir, sebebi yazılır.
    private string? cariYuklemeHatasi;
    private FaturaTaslakMetinleri FT => FaturaTaslakSozlugu.Al(Dil.Dil);

    /// <summary>
    /// Y4-D: ALTIN DIŞI kıymetli maden (gümüş/platin/paladyum) kuyum satırı — sunucu has
    /// bedelini düşmez (KDV tam). TEK KAYNAK: sunucunun kaleme yazdığı <c>Maden</c>
    /// (ayardan türetilmez; ürünsüz hurda gümüş satırında da dolu).
    /// </summary>
    private static bool GumusKuyumKalemi(KalemVeri k) =>
        k.KdvTuru == "KUYUM" && k.Maden is Kuyumcu.Core.Domain.Maden.Gumus
            or Kuyumcu.Core.Domain.Maden.Platin or Kuyumcu.Core.Domain.Maden.Paladyum;

    /// <summary>Madeni bilinmeyen kuyum satırı: sunucu özel matrah uygulamaz (fail-closed) — sebep yazılır.</summary>
    private static bool MadeniBilinmeyenKuyumKalemi(KalemVeri k) =>
        k.KdvTuru == "KUYUM" && string.IsNullOrEmpty(k.Maden);

    // ── P-61 — satır eylemleri TEK kaynaktan (SatirEylemleri bileşeni) ──
    private EventCallback Cb(Func<Task> f) => EventCallback.Factory.Create(this, f);
    private EventCallback Cb(Action f) => EventCallback.Factory.Create(this, f);

    private IReadOnlyList<SatirEylemleri.Eylem> FaturaEylemleri(FaturaVeri f)
    {
        // Sıra = ekran sırası. DAR SÜTUN (Birincil=1): ilk eylem satırda, gerisi "⋯"
        // penceresinde. İlk eylem durumun BİRİNCİL işidir: TASLAK → Düzenle,
        // KESİLDİ → Ödendi işaretle, diğerleri → Kalemleri göster.
        var goster = new SatirEylemleri.Eylem($"fk-goster-{faturalar.IndexOf(f)}", Dil.T.Fatura.KalemGoster,
                                              Cb(() => KalemleriAc(f)));
        var l = new List<SatirEylemleri.Eylem>();
        if (f.Durum == "TASLAK")
        {
            // P-22 / B-3: TASLAK belge DÜZENLENEBİLİR — tek kalıp Cekmece (DoD EK md.2).
            l.Add(new($"fk-duzenle-{f.Id}", Dil.T.Ortak.Duzenle, Cb(() => DuzenleAc(f)),
                      kilitli: guncelleniyor, kilitNedeni: Dil.T.Kabuk.Kaydediliyor));
            l.Add(goster);
            l.Add(new($"fk-kes-{f.Id}", Dil.T.Fatura.Kes, Cb(() => DurumIste(f, "KESILDI")),
                      kilitli: guncelleniyor, kilitNedeni: Dil.T.Kabuk.Kaydediliyor));
        }
        else if (f.Durum == "KESILDI")
        {
            l.Add(new($"fk-odendi-{f.Id}", Dil.T.Fatura.OdendiIsaretle, Cb(() => DurumIste(f, "ODENDI")),
                      kilitli: guncelleniyor, kilitNedeni: Dil.T.Kabuk.Kaydediliyor, ekSinif: "metin-yesil"));
            l.Add(goster);
        }
        else
        {
            l.Add(goster);
        }
        // ODENDI → IPTAL sunucuda İZİNLİDİR (GecerliGecisler) — QA turu 2 YÜKSEK: geri dönüş yolu.
        // Yıkıcı eylem pencerede; önce onay modalı (DoD EK 4).
        if (f.Durum is "TASLAK" or "KESILDI" or "ODENDI")
            l.Add(new($"fk-iptal-{f.Id}", Dil.T.Fatura.IptalEt, Cb(() => DurumIste(f, "IPTAL")),
                      kilitli: guncelleniyor, kilitNedeni: Dil.T.Kabuk.Kaydediliyor, ekSinif: "metin-kirmizi"));
        return l;
    }

    /// <summary>
    /// P-53: yeni-fatura modalı ile düzenleme çekmecesinin ORTAK cari yükleyicisi.
    /// Başarısızsa liste boşaltılır ve hata metni DÖNER — çağıran onu bandına
    /// yazar (UX-S28: hata 'kayıt yok'a çevrilmez, sessiz yutulmaz).
    /// </summary>
    private async Task<string?> CarileriGetir()
    {
        try
        {
            cariler = await Api.GetAsync<List<CariVeri>>("/cari?aktif=true&limit=200");
            return null;
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            cariler = [];
            return ex.Message;
        }
    }

    private async Task DuzenleAc(FaturaVeri f)
    {
        duzenleHata = null;
        cariYuklemeHatasi = null;
        duzenleForm.Temizle();
        duzenlenen = f;
        dCariId = f.CariId ?? "";
        dAciklama = f.Aciklama ?? "";
        // BELGE-KALAN (VERİ/YASAL): kayıt UTC anıdır; liste Bicim.Tarih ile YEREL günü basar.
        // Çekmece ham UTC tarihini alıyordu → 00:00–03:00 TSI kaydı listede 1.10, çekmecede
        // 30.09 görünüyor ve dokunmadan Kaydet belgeyi bir gün GERİ yazıyordu.
        dTarih = BelgeGunu(f.Tarih);
        dTarihIlk = dTarih;
        dToplam = f.Toplam;

        // QA tur 8 (P-53): cari listesi yalnız yeni-fatura modalında yükleniyordu;
        // sayfa açılıp doğrudan Düzenle'ye basılınca seçici BOŞ geliyordu.
        if (await CarileriGetir() is { } hata)
        {
            cariYuklemeHatasi = hata;
            duzenleHata = $"{FT.CariYuklenemedi} ({hata})";
        }
        // Belgenin mevcut carisi (ör. sonradan pasife alınmış) aktif listede yoksa
        // seçici yine ONU gösterir — sessizce ilk cariye kaymaz.
        if (!string.IsNullOrEmpty(f.CariId) && cariler.All(c => c.Id != f.CariId))
            cariler = [new CariVeri(f.CariId, f.CariAd), .. cariler];

        // Q9-2 (QA turu 9, KRİTİK): Düzenle kipinde satırlar da düzeltilir/eklenir.
        await CekmeceSatirlariniYukle(f);
    }

    /// <summary>Kalemli ya da kuyum belgede toplam BAŞLIKTAN değişmez (sunucu kuralının aynası).</summary>
    private bool ToplamDuzenlenebilir =>
        duzenlenen is { KalemKaynagi: not "KALEM" } && !ToplamKuyum;

    /// <summary>
    /// P-53: SUNUCU KURALININ AYNASI (FaturaModulu.TaslakGuncelle) — KdvTuru KUYUM
    /// ise toplam başlıktan DAİMA değişmez; has bedelinin kaynağı (ELLE/HAREKET/
    /// KALEM) belirleyici DEĞİLDİR. Eski koşul HasDegerKaynagi'na bakıyordu ve
    /// ELLE kuyum taslağında alanı açık bırakıp 400 yedirtiyordu.
    /// </summary>
    private bool ToplamKuyum => duzenlenen is { KdvTuru: "KUYUM" };

    /// <summary>
    /// P-53: PATCH 400 mesajını ilgili ALANA yerleştirir. Sunucu bu uçta alan
    /// sözlüğü (alanlar) dönmüyor; mesajın andığı alan eşlenir. Eşlenemeyen
    /// mesaj (ör. "Yalnız TASLAK fatura düzenlenebilir") çekmecenin bandına yazılır.
    /// </summary>
    private static readonly (string Anahtar, string Alan)[] DuzenleAlanEslemesi =
    [
        ("toplam", "fd-duzenle-toplam"),
        ("cari", "fd-duzenle-cari"),
        ("tarih", "fd-duzenle-tarih"),
        ("açıklama", "fd-duzenle-aciklama"),
    ];

    private void DuzenleSunucuHatasi(ApiHata ex)
    {
        duzenleForm.Sunucudan(ex, new Dictionary<string, string>
        {
            ["CariId"] = "fd-duzenle-cari", ["Tarih"] = "fd-duzenle-tarih",
            ["Aciklama"] = "fd-duzenle-aciklama", ["Toplam"] = "fd-duzenle-toplam",
        });
        var mesaj = FormDurumu.SunucuMesaji(ex, Dil);
        if (duzenleForm.Gecerli)
        {
            foreach (var (anahtar, alan) in DuzenleAlanEslemesi)
            {
                if (ex.Message.Contains(anahtar, StringComparison.CurrentCultureIgnoreCase))
                {
                    duzenleForm.Ekle(alan, mesaj);
                    break;
                }
            }
        }
        // Alana yerleştiyse bant yalnız "formda hata var" der; yerleşmediyse metnin kendisi.
        duzenleHata = duzenleForm.Gecerli ? mesaj : Dil.T.Kabuk.FormEksik;
    }

    private async Task DuzenleKaydet()
    {
        if (duzenlenen is not { } f) return;
        duzenleHata = null;
        duzenleForm.Temizle();
        // Boş/geçersiz gönderimde SESSİZ etkisizlik yok (DoD EK md.3).
        duzenleForm.Zorunlu("fd-duzenle-cari", dCariId, Dil);
        if (!duzenleForm.Gecerli) { duzenleHata = Dil.T.Kabuk.FormEksik; return; }
        duzenleKaydediliyor = true;
        try
        {
            var govde = new Dictionary<string, object?>
            {
                ["cariId"] = dCariId,
                ["aciklama"] = string.IsNullOrWhiteSpace(dAciklama) ? null : dAciklama.Trim(),
            };
            if (dTarih.Date != dTarihIlk.Date)
                govde["tarih"] = Bicim.Makine(dTarih);
            if (ToplamDuzenlenebilir)
            {
                // ZO-BELGE: girdi ailesi değeri decimal taşır; boş toplam SESSİZ
                // gönderilmez (eski FormatException yolunun karşılığı).
                if (dToplam is not { } dt) throw new FormatException();
                govde["toplam"] = dt;
            }

            await Api.PatchAsync($"/faturalar/{f.Id}", govde);
            BasariGoster(Dil.T.Fatura.TaslakGuncellendi);
            duzenlenen = null;
            await Yukle();
        }
        catch (FormatException)
        {
            duzenleForm.Ekle("fd-duzenle-toplam", Dil.T.Fatura.SayiGecersiz);
            duzenleHata = Dil.T.Kabuk.FormEksik;
        }
        // P-53: sunucu 400'ü ÇEKMECEDE, alan düzeyinde — çekmece KAPANMAZ.
        catch (ApiHata ex) { DuzenleSunucuHatasi(ex); }
        catch (JsonException ex) { duzenleHata = ex.Message; }
        finally { duzenleKaydediliyor = false; }
    }

    // ── PAKET P-26 (Y-40) — özel matrah beyanı alanları ────────────────────
    private string? ozelMatrahKod;
    private string? ozelMatrahKaynak;
    private bool ozelMatrahAralikta = true;
    private string? ozelMatrahHata;
    // PAKET YASAL-4 / Y4-C: rozet yalnız kiracıda KUYUM fatura varken (sunucu söyler).
    private bool kuyumFaturaVar;
    private Kuyumcu.Core.I18n.Yasal4Metinleri Y4F => Kuyumcu.Core.I18n.Yasal4Sozlugu.Al(Dil.Dil);

    protected override async Task OnInitializedAsync()
    {
        Dil.Degisti += Yenile;
        await OzelMatrahAyariYukle();
        await Yukle();
    }

    /// <summary>
    /// Y-40: kodu VE kaynağını sunucudan okur. Hata hâlinde beyan "yok"a
    /// çevrilmez — ayrı hata bandı basılır (UX-S28 · Anayasa md.1).
    /// </summary>
    private async Task OzelMatrahAyariYukle()
    {
        try
        {
            ozelMatrahHata = null;
            var a = await Api.GetAsync<JsonElement>("/faturalar/ozel-matrah-ayari");
            ozelMatrahKod = a.TryGetProperty("kod", out var k) && k.ValueKind == JsonValueKind.String
                ? k.GetString() : null;
            ozelMatrahKaynak = a.TryGetProperty("kaynakBeyani", out var kb) ? kb.GetString() : null;
            ozelMatrahAralikta = !a.TryGetProperty("aralikta", out var ar)
                || ar.ValueKind != JsonValueKind.False;
            kuyumFaturaVar = a.TryGetProperty("kuyumFaturaVar", out var kf) && kf.ValueKind == JsonValueKind.True;
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            // UX-S28 / P-11: hata "veri yok"a ÇEVRİLMEZ. Elde ne varsa durur,
            // yalnız hata bandı yazılır; kullanıcı beyanın okunamadığını görür.
            ozelMatrahHata = $"{Dil.T.Fatura.OzelMatrahOkunamadi} {ex.Message}";
        }
    }

    private async Task Yukle()
    {
        yukleniyor = true;
        try
        {
            listeHata = null;
            var yol = string.IsNullOrEmpty(durumFiltre) ? "/faturalar" : $"/faturalar?durum={durumFiltre}";
            faturalar = (await Api.GetAsync<FaturaYaniti>(yol)).Faturalar;
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            faturalar = [];
            listeHata = ex.Message;
        }
        yukleniyor = false;
    }

    private async Task YeniModalAc()
    {
        modalHata = null;
        modalBasari = null;
        formCariId = "";
        formTur = "SATIS";
        formKdv = "0.20";
        formKdvTuru = "STANDART";
        formHasDeger = 0;
        formHareketId = "";
        onizleme = null;
        islemHata = null;
        faturalanabilir = [];
        faturalanabilirDahaVar = false;
        formToplam = 0;
        formAciklama = "";
        formKalemler.Clear();
        yeniModalAcik = true;
        // P-53: düzenleme çekmecesiyle ORTAK yükleyici.
        if (await CarileriGetir() is { } cariHata) modalHata = cariHata;
        try { urunler = await Api.GetAsync<List<UrunVeri>>("/urunler?aktif=true&limit=200"); }
        catch (Exception ex) when (ex is ApiHata or JsonException) { urunler = []; }
    }

    private async Task OdakIlkHataya()
    {
        if (yeniForm.IlkHatali is not { } ilk) return;
        try { await JS.InvokeVoidAsync("kuyumcuOdak.alana", ilk); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            /* JS yoksa alan altı mesaj ve üstteki hata bandı yine görünür */
        }
    }

    private async Task FaturaOlustur()
    {
        // QA turu 2: "cari boş → Kaydet: istek yok, mesaj yok" (sessiz etkisizlik).
        yeniForm.Temizle();
        yeniForm.Zorunlu("fatura-cari", formCariId, Dil);
        yeniForm.Pozitif("fatura-toplam", formToplam, Dil);
        if (!yeniForm.Gecerli)
        {
            modalHata = Dil.T.Kabuk.FormEksik;
            // 29.09 devam 6 (tasarım hakemi): hata mesajı görünür alanın dışında kalmasın —
            // odak İLK hatalı alana taşınır (ortak kuyumcuOdak.alana; Cariler ile aynı yol).
            await OdakIlkHataya();
            return;
        }

        modalHata = null;
        kaydediliyor = true;
        try
        {
            var yanit = await Api.PostAsync("/faturalar", new
            {
                cariId = formCariId,
                tur = formTur,
                toplam = formToplam,
                kdvOran = FormKdvOran,
                kdvTuru = formKdvTuru,
                // KUYUM'da sunucu has bedelini DEFTERDEN türetir; ekran türetilen
                // değeri geri gönderir ve sunucu kuruşu kuruşuna doğrular
                // (tutarlılık kapısı — kasiyer matrahı seçemez).
                hasDeger = Kuyum ? onizleme?.HasDeger : null,
                // Fatura ↔ defter bağı: bu alan olmadan gün sonu mutabakatı her
                // satışı "faturasız" sayıyordu.
                hareketId = string.IsNullOrEmpty(formHareketId) ? null : formHareketId,
                aciklama = string.IsNullOrWhiteSpace(formAciklama) ? null : formAciklama,
                // Kalem YOKSA alan gönderilmez: sunucu bugünkü başlık yolunu kullanır.
                kalemler = formKalemler.Count == 0 ? null : formKalemler.Select(k => new
                {
                    urunId = string.IsNullOrEmpty(k.UrunId) ? null : k.UrunId,
                    miktar = k.Miktar,
                    birimFiyat = k.BirimFiyat,
                    iscilikTl = k.Iscilik,
                    indirimTutari = k.Indirim,
                }).ToList(),
            });
            // UX-S27: POST yanıtı OKUNUR; sunucunun verdiği fatura no banda yazılır.
            modalBasari = yanit.TryGetProperty("faturaNo", out var fn)
                ? $"{Dil.T.Ortak.Basarili} — {fn.GetString()}"
                : Dil.T.Ortak.Basarili;
            yeniModalAcik = false;
            BasariGoster(modalBasari);
            await Yukle();
        }
        catch (ApiHata ex)
        {
            // TOPLU-7B: aynı ret alan altında TAM, bantta kısa genel cümle (tek yazım).
            modalHata = yeniForm.SunucuHatasiTek(ex, Dil, new Dictionary<string, string>
            {
                ["CariId"] = "fatura-cari", ["Toplam"] = "fatura-toplam", ["HasDeger"] = "fatura-islem",
            });
        }
        kaydediliyor = false;
    }

    private async Task DurumGuncelle(string id, string durum)
    {
        listeHata = null;
        guncelleniyor = true;
        try
        {
            await Api.PatchAsync<JsonElement>($"/faturalar/{id}/durum", new { durum });
            // UX-S27 — sonuç banda yazılır; hangi faturanın hangi duruma geçtiği okunur.
            BasariGoster(string.Format(Dil.T.Fatura.DurumDegisti,
                durumFatura?.FaturaNo ?? id, DurumMetin(durum)));
            await Yukle();
        }
        catch (ApiHata ex) { durumHata = FormDurumu.SunucuMesaji(ex, Dil); listeHata = durumHata; }
        guncelleniyor = false;
    }

    // ── durum rozeti: TASLAK gri, KESILDI mavi, ODENDI yesil, IPTAL kirmizi ──
    private static string DurumRenk(string durum) => durum switch
    {
        "KESILDI" => "mavi",
        "ODENDI" => "yesil",
        "IPTAL" => "kirmizi",
        _ => "gri",
    };

    private string DurumMetin(string durum) => durum switch
    {
        "TASLAK" => Dil.T.Fatura.Taslak,
        "KESILDI" => Dil.T.Fatura.Kesildi,
        "ODENDI" => Dil.T.Fatura.Odendi,
        "IPTAL" => Dil.T.Fatura.Iptal,
        _ => durum,
    };

    private static string KdvYuzde(decimal oran) =>
        (oran * 100).ToString("0", CultureInfo.InvariantCulture);

    private void Yenile() => InvokeAsync(StateHasChanged);
    public void Dispose() => Dil.Degisti -= Yenile;
}
