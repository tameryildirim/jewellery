    // ── Satır kalemleri ──────────────────────────────────────────────────────
    private readonly List<KalemSatiri> formKalemler = [];
    private List<UrunVeri> urunler = [];
    private bool kalemModalAcik;
    private KalemYaniti? kalemYanit;
    private string? kalemHata;

    private static decimal Yuvarla2(decimal d) => Math.Round(d, 2, MidpointRounding.AwayFromZero);

    /// <summary>Sunucudaki değişmezin aynısı: miktar × birim fiyat + işçilik − indirim.</summary>
    private static decimal SatirToplam(KalemSatiri k) =>
        Yuvarla2(k.Miktar * k.BirimFiyat + k.Iscilik - k.Indirim);

    private decimal KalemToplami => formKalemler.Sum(SatirToplam);

    /// <summary>
    /// Kalem yoksa kural yoktur (başlık yolu). Kalem varsa TOLERANS YOKTUR:
    /// kalem toplamı fatura toplamına kuruşu kuruşuna eşit olmalıdır.
    /// </summary>
    private bool ToplamUyusuyor =>
        formKalemler.Count == 0 || KalemToplami == Yuvarla2(formToplam);

    private void KalemEkle() => formKalemler.Add(new KalemSatiri());

    private void KalemSil(int ix)
    {
        if (ix >= 0 && ix < formKalemler.Count) formKalemler.RemoveAt(ix);
    }

    private void UrunSec(int ix, string? urunId)
    {
        if (ix >= 0 && ix < formKalemler.Count) formKalemler[ix].UrunId = urunId ?? "";
    }

