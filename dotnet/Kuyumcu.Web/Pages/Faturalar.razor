    // ── TOPLU-1: fişsiz satışlar da fişten fatura kesilir (BELGE-KALAN 01.10) ──────────────
    private const int FistenGun = 30, FistenLimit = 50;
    private string fistenHareketId = "";
    private Kuyumcu.Core.I18n.Toplu1Metinleri T1 => Kuyumcu.Core.I18n.Toplu1Sozlugu.Al(Dil.Dil);

    /// <summary>Seçicideki değer: fişli kayıt "fis:{FisId}", fişsiz kayıt "har:{HareketId}".</summary>
    private string FistenIslemDegeri =>
        fistenHareketId.Length > 0 ? "har:" + fistenHareketId
        : fistenFisId.Length > 0 && faturalanabilir.Any(i => i.FisId == fistenFisId) ? "fis:" + fistenFisId : "";

    /// <summary>
    /// Fişli işlemler FİŞ başına bir seçenek (fatura fişin TÜM kalemlerini damgalar — sunucu kuralı),
    /// fişsiz işlem kendi seçeneği. Sıra sunucunun sırası (yeni → eski).
    /// </summary>
    private IReadOnlyList<Kuyumcu.Web.Bilesenler.SecenekOgesi> FistenIslemSecenekleri
    {
        get
        {
            var l = new List<Kuyumcu.Web.Bilesenler.SecenekOgesi>();
            var gorulen = new HashSet<string>();
            foreach (var i in faturalanabilir)
            {
                if (!string.IsNullOrEmpty(i.FisId))
                {
                    if (!gorulen.Add(i.FisId)) continue;
                    var grup = faturalanabilir.Where(x => x.FisId == i.FisId).ToList();
                    l.Add(new($"fis:{i.FisId}", FistenSecenekMetni(i, grup.Count, grup.Sum(x => x.TlTutari)),
                              CariAdi(i.CariId)));
                }
                else
                {
                    // TOPLU-1 tur 2 (tasarım hakemi KRİTİK): rozet işlem TÜRÜNDEN — alışa "Tek satış" denmez.
                    l.Add(new($"har:{i.Id}", FistenSecenekMetni(i, 1, i.TlTutari), CariAdi(i.CariId),
                              RozetMetni: FistenTekRozet(i.Tur)));
                }
            }
            return l;
        }
    }

    /// <summary>Fişsiz tek işlemin rozeti: alış türleri (ALIS, HURDA_ALIS) "Tek alış", diğerleri "Tek satış".</summary>
    private string FistenTekRozet(string tur) => tur is "ALIS" or "HURDA_ALIS" ? T1.FistenTekAlisRozet : T1.FistenFissizRozet;

    private string FistenSecenekMetni(FaturalanabilirIslem i, int kalem, decimal toplam) =>
        string.Join(" · ", new[]
        {
            Bicim.TarihSaat(i.Tarih),
            i.Tur == "SATIS" ? Dil.T.Fatura.Satis : Dil.T.Fatura.Alis,
            kalem > 1 ? string.Format(T1.FistenKalemSayisi, kalem) : (i.UrunAd ?? ZB.FistenKalemGenel),
            Bicim.Tl(toplam),
        });

    private string? CariAdi(string? cariId) =>
        string.IsNullOrEmpty(cariId) ? null : cariler.FirstOrDefault(c => c.Id == cariId)?.Ad;

    /// <summary>
    /// Listeden seçim: fişli → mevcut fiş önizlemesi (sunucunun fiş okuma ucu); fişsiz → önizleme
    /// sunucunun faturalanabilir satırından kurulur (ekran HESAPLAMAZ, yalnız gösterir) ve Kaydet
    /// gövdeye hareketId koyar. Seçim değişince eski önizleme düşer (UX-S24).
    /// </summary>
    private async Task FistenIslemSecildi(string? deger)
    {
        fisYanit = null;
        fistenHata = null;
        fistenBasari = null;
        fistenHareketId = "";
        fistenFisId = "";
        if (deger is null) return;
        if (deger.StartsWith("fis:", StringComparison.Ordinal))
        {
            fistenFisId = deger[4..];
            await FisOnizle();
            return;
        }
        if (!deger.StartsWith("har:", StringComparison.Ordinal)) return;
        var h = faturalanabilir.FirstOrDefault(x => x.Id == deger[4..]);
        if (h is null) return;
        fistenHareketId = h.Id;
        fisYanit = new FisYaniti("", h.CariId, CariAdi(h.CariId), null, 1, h.TlTutari, h.HasGrami,
            [new FisKalemVeri(h.Id, h.Tur, h.TlTutari, h.HasGrami, false, h.UrunAd, null)]);
    }

    /// <summary>
    /// ÖNİZLEME: fişin kalemleri okuma ucundan gelir (ikinci bir belge ucu
    /// AÇILMAZ). Fatura kesilmeden önce kullanıcı ne faturalanacağını görür.
    /// </summary>
    private async Task FisOnizle()
    {
        fistenHata = null;
        fistenBasari = null;
        fisYanit = null;
        onizleniyor = true;
        try { fisYanit = await Api.GetAsync<FisYaniti>($"/islemler/fis/{fistenFisId}"); }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            // Hata "kayıt yok"a çevrilmez (UX-S28): sebebi kullanıcı görür.
            fistenHata = ex.Message;
        }
        onizleniyor = false;
    }

    /// <summary>Fişten kesilecek faturanın türü: fişin BÜTÜN kalemleri alış hareketiyse (ALIS,
    /// HURDA_ALIS) alış faturası, aksi hâlde satış faturası (karışık fişte eski varsayılan korunur).
    /// Önizleme yoksa null — sunucu kendi varsayılanını uygular (düğme zaten kilitli).</summary>
    public static string? FistenTur(FisYaniti? fis) =>
        fis is null ? null
        : fis.Kalemler.Count > 0 && fis.Kalemler.All(k => k.Tur is "ALIS" or "HURDA_ALIS") ? "ALIS"
        : "SATIS";

    // ── Orkestratör 18:05: Fişten Fatura Kes penceresinin TAMAMI sözlükten geçer ──
    // Önizleme FATURAYI önizler: sunucu kalem fiyatını ve has gramını mutlak değerle yazar
    // (FaturaModulu.FistenOlustur, Math.Abs). Defterin yön işareti (alışta TL eksi, satışta
    // has eksi) burada basılmaz — yönü "Tür" rozeti söyler; fatura listesi de işaretsizdir.

    /// <summary>Kalem adı: ürün adı; ürünsüz kalemde (ör. eski altın bacağı HURDA_ALIS) hareket
    /// türünün sözlükteki adı. Sözlükte olmayan bir kod da ekrana çıkmaz (genel "Fiş kalemi").</summary>
    private string FisKalemAdi(FisKalemVeri fk)
    {
        if (!string.IsNullOrWhiteSpace(fk.UrunAd)) return fk.UrunAd;
        var ad = Kuyumcu.Core.I18n.KatalogSozlugu.HareketTuru(fk.Tur, Dil.Dil, Dil.BasitMi);
        return ad == fk.Tur || ad == "—" ? ZB.FistenKalemGenel : ad;
    }

    /// <summary>Fişin toplamı fatura yönünden (işaretsiz) — bkz. yukarıdaki not.</summary>
    public static decimal FistenToplam(FisYaniti fis) => Math.Abs(fis.ToplamTl);

    // 29.09 DEVAM 12: Fişten çekmecesinin Kaydet kilidi ve SEBEBİ (UX-S30) tek yerden.
    private bool FistenKaydetKapali => FistenKilitSebebi is not null;
    private string? FistenKilitSebebi =>
        kaydediliyor ? Dil.T.Kabuk.SunucuOnayiBekleniyor
        : fisYanit is null ? ZB.FistenKilitOnizle
        : fisYanit.KalemSayisi == 0 ? ZB.FistenKilitKalemYok
        : !string.IsNullOrEmpty(fisYanit.FaturaNo) ? ZB.FistenKilitFaturali
        : null;

    /// <summary>Fiş zaten faturalıysa bant cümlesi: taslak damgası (TASLAK:&lt;ULID&gt;) ekrana
    /// basılmaz — "taslak faturaya bağlı, numara kesimde verilir" (işlem defteriyle aynı kural);
    /// kesilmiş faturada numara cümlenin içinde.</summary>
    /// <summary>TOPLU-1 tur 2 (doğrulayıcı DÜŞÜK): aynı işlem iki sekmede/yarışta faturalanınca sunucunun
    /// "zaten … ile faturalandırılmış" reddi ham basılmaz — bant cümlesi FistenFaturaliMesaj kalıbıyla
    /// (taslak → "taslak faturaya bağlı", kesilmiş → numara cümlede). Diğer retler olduğu gibi.</summary>
    internal string FistenRetMetni(string mesaj)
    {
        var m = System.Text.RegularExpressions.Regex.Match(mesaj, @"zaten\s+(\S*)\s*ile faturalandırılmış");
        var islem = fistenHareketId.Length > 0;
        if (m.Success)
        {
            var no = m.Groups[1].Value;
            return string.IsNullOrEmpty(no) || IslemDefteri.TaslakIsaretiMi(no)
                ? (islem ? T1.FistenIslemTaslakBagli : ZB.FistenTaslakFaturali)
                : string.Format(islem ? T1.FistenIslemFaturali : ZB.FistenZatenFaturali, no);
        }
        if (mesaj.Contains("taslak bir faturayla faturalandırılmış", StringComparison.Ordinal))
            return islem ? T1.FistenIslemTaslakBagli : ZB.FistenTaslakFaturali;
        return mesaj;
    }

    private string FistenFaturaliMesaj(string? no) =>
        IslemDefteri.TaslakIsaretiMi(no) ? ZB.FistenTaslakFaturali : string.Format(ZB.FistenZatenFaturali, no);

    private async Task FistenFaturaKes()
    {
        fistenHata = null;
        fistenBasari = null;
        kaydediliyor = true;
        try
        {
            // TOPLU-1: fişsiz işlemde fisId yerine hareketId gider (sunucu ikisinden birini ister).
            var fistenYanit = await Api.PostAsync<JsonElement>("/faturalar/fisten", new
            {
                fisId = fistenHareketId.Length > 0 ? null : fistenFisId,
                hareketId = fistenHareketId.Length > 0 ? fistenHareketId : null,
                // Tür fişten (önizlemedeki kalemlerin hareket türü); ekranda ff-tur ile görünen değer.
                tur = FistenTur(fisYanit),
                kdvTuru = fistenKdvTuru,
                kdvOran = decimal.Parse(fistenKdv, CultureInfo.InvariantCulture),
            });
            fistenBasari = Dil.T.Ortak.Basarili;
            fistenModalAcik = false;
            // UX-S27: çekmece kapanınca içindeki bant görünmez — sonuç SAYFANIN bandına, sunucunun
            // döndürdüğü toplamla yazılır (POST yanıtı okunur).
            var olusanToplam = fistenYanit.ValueKind == JsonValueKind.Object
                && fistenYanit.TryGetProperty("toplam", out var ot) && ot.ValueKind == JsonValueKind.Number
                ? ot.GetDecimal() : FistenToplam(fisYanit!);
            BasariGoster(string.Format(T1.FistenOlustu, fisYanit?.CariAd ?? ZB.FistenCariYok, Bicim.Tl(olusanToplam)));
            await Yukle();
        }
        catch (ApiHata ex) { fistenHata = FistenRetMetni(ex.Message); }
        kaydediliyor = false;
    }

