    private bool KalemDuzenlenebilir => kalemFaturaDurumu == "TASLAK";
    private KesifP3Metinleri P3 => KesifP3Sozlugu.Al(Dil.Dil);

    /// <summary>
    /// K01 (30.09): satır içi düzenlenen PARA değeri tablo ile aynı dili konuşur —
    /// binlikli ve iki kuruş haneli ("1.095.125,00"; eskiden "1095125,00", kutuda
    /// kesik). Virgül her zaman bulunduğu için P-78 belirsizliği ("1.500") doğmaz;
    /// kaydette FormAlani.SayiCoz aynı metni çözer.
    /// </summary>
    private const string ParaKutuKalibi = "#,##0.00";

    // P-54: kalem hücrelerinin alan→mesaj defteri. Sunucu 400'ü (ör. "Miktar
    // sıfırdan büyük olmalıdır") DÜZELTİLEN HÜCRENİN ALTINA yazılır: satır içi
    // düzenleme tek alan gönderir, bu yüzden hata o alana aittir.
    private readonly FormDurumu kalemForm = new();

    private static string KalemAlanAnahtari(string alan, string kalemId) => $"fd-kalem-{alan}-{kalemId}";

    private async Task KalemKaydet(string kalemId, string alan, string deger)
    {
        if (kalemYanit is null) return;
        kalemHata = null;
        kalemForm.Temizle();
        // P-78: sayı alanı tr-TR TEK MERKEZDE çözülür. Eski yol virgülü noktaya
        // çevirip Invariant okuyordu: "45.000" = 45, "1.250,50" = FormatException.
        decimal? sayi = null;
        if (alan != "aciklama" && !string.IsNullOrWhiteSpace(deger))
        {
            var cozum = FormAlani.SayiCoz(deger);
            if (cozum.Deger is not { } d)
            {
                kalemForm.Ekle(KalemAlanAnahtari(alan, kalemId),
                    cozum.Mesaj(Dil.Dil) ?? Dil.T.Fatura.SayiGecersiz);
                kalemHata = FT.KalemHatali;
                return;
            }
            sayi = d;
        }
        kalemKaydediliyor = true;
        try
        {
            // İşçilik/indirim boş bırakılırsa null gider = alan silinir (PATCH
            // sözleşmesi: gövdede yoksa koru, null ise sil).
            object govde = alan == "aciklama"
                ? new Dictionary<string, object?> { ["aciklama"] = deger }
                : new Dictionary<string, object?>
                  {
                      [alan] = sayi,
                  };
            // UX-S27: PATCH yanıtı OKUNUR; toplam sunucudan gelir, ekran hesaplamaz.
            kalemYanit = await Api.PatchAsync<KalemYaniti>(
                $"/faturalar/{kalemYanit.FaturaId}/kalemler/{kalemId}", govde);
            BasariGoster(Dil.T.Fatura.KalemGuncellendi);
            // Q9-2: çekmecede de sonuç GÖRÜNÜR (sayfa bandı çekmecenin arkasında kalır).
            if (duzenlenen is not null) CekmeceKalemSonucu(Dil.T.Fatura.KalemGuncellendi);
            await Yukle();
        }
        catch (FormatException)
        {
            kalemForm.Ekle(KalemAlanAnahtari(alan, kalemId), Dil.T.Fatura.SayiGecersiz);
            kalemHata = FT.KalemHatali;
        }
        catch (ApiHata ex)
        {
            // Hata ALAN DÜZEYİNDE; bant yalnız "işaretli alana bakın" der.
            kalemForm.Ekle(KalemAlanAnahtari(alan, kalemId), ex.Message);
            kalemHata = FT.KalemHatali;
        }
        catch (JsonException ex) { kalemHata = ex.Message; }
        finally { kalemKaydediliyor = false; }
    }

