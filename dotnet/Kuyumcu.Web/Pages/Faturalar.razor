@page "/faturalar"
@using System.Globalization
@using System.Text.Json
@using Kuyumcu.Contracts.Sayfalar.Faturalar
@using Kuyumcu.Web.Bilesenler.Grid
@using Kuyumcu.Core.Domain.Girdi
@inject ApiIstemci Api
@inject DilServisi Dil
@inject IJSRuntime JS
@implements IDisposable

@* Kaynak: apps/web/src/pages/FaturaPage.tsx — Kasalar.razor desenini izler. *@

<PageTitle>@Marka.SayfaBasligi(Dil.T.Fatura.Baslik)</PageTitle>

<div class="dikey-bosluk zo-belge" id="fk-sayfa">
    @* ═══ PAKET ZO-BELGE — "ZORUNLU ÖNCE" (kurucu 25.09) ══════════════════════
       Açılış: başlık + açıklama · İKİ eylem (Fişten kes ikincil, Yeni fatura TEK
       birincil) · KAPALI "Süzgeç" · fatura tablosu. Kurucu görüntüsü (12:20):
       "Tümü" yerel <select> ve "Fişten Fatura Kes" dipte · "+ Yeni Fatura" dar
       pencerede kesik · özel matrah satırı ve "değiştirilemez" kutusu açılışta.
       • Durum süzgeci: yerel <select> → ortak Form/Secim, KAPALI katlanırın içinde
         (seçiliyse başlıkta adı + sayı rozeti). id AYNI: fk-durum-filtre.
       • Özel matrah beyanı: sayfa SONUNDA kapalı katlanır (hata varsa ÜSTTE açık —
         UX-S28). İçerik ve id'ler AYNI; beyan SİLİNMEDİ (P-26 sayacı).
       • "Bu kayıt değiştirilemez": açılışta değil, kesilmiş fatura AÇILINCA
         (Goster penceresi) — kayıt açılınca / değiştirme denenince. *@
    @* ZO-BELGE 29.09 devam 9 (tasarım hakemi k3 KRİTİK · K17 "açıklama metni satırı 0"): başlık altındaki
       açıklama satırı kaldırıldı — tuvalde (Profesyonel.png) başlık tek başına durur. *@
    <SayfaBasi Anahtar="faturalar" Baslik="@Dil.T.Fatura.Baslik">
        <Eylem>
            @* PAKET CUMA-J (K7): "Fişten fatura kes" bir EYLEMDİR, filtre değil; id aynı. *@
            <button class="btn btn-ikincil btn-kucuk" id="ff-ac" @onclick="FistenModalAc">@Dil.T.Fatura.FistenKes</button>
            <button class="btn btn-birincil btn-kucuk" id="fk-yeni" @onclick="YeniModalAc">+ @Dil.T.Fatura.YeniFatura</button>
        </Eylem>
    </SayfaBasi>

    @* PAKET P-26 (Y-40) — özel matrah beyanı OKUNAMADIYSA hata ÜSTTE ve açık
       (UX-S28: hata görünür yerde; katlanmaz). *@
    @if (ozelMatrahHata is not null)
    {
        <div class="kart" id="fk-ozel-matrah-beyani">
            <strong>@Dil.T.Fatura.OzelMatrahBaslik</strong>
            @OzelMatrahIcerik
        </div>
    }
    else if (ozelMatrahKod is null && kuyumFaturaVar)
    {
        @* PAKET YASAL-4 / Y4-C: sayfa sonundaki kapalı katlanır KALKTI. Kod KAPALI ve
           kiracıda KUYUM fatura varken başlık altında TEK satır rozet; uzun açıklama
           "Yasal sınırlar" sayfasındaki satırın "Neden?" ipucunda. Jargon yok (K-12). *@
        <a class="rozet rozet-amber" id="fk-ozel-matrah-rozet" href="/yasal-sinirlar#ys-satir-kdv-ozel-matrah-kodu"
           aria-label="@Y4F.FaturaKodRozetEtiket">@Y4F.FaturaKodRozet</a>
    }
    else if (ozelMatrahKod is not null)
    {
        @* Kod AÇIKKEN (mali müşavir imzasıyla) kod KAYNAĞIYLA birlikte yazılır (P-26 kuralı). *@
        @OzelMatrahIcerik
    }

    <Katlanir Id="fk-suzgec" Baslik="@SuzgecBasligi" Sayi="@(string.IsNullOrEmpty(durumFiltre) ? null : 1)"
              Sinif="zo-suzgec">
        <Secim ElemanId="fk-durum-filtre" Etiket="@Dil.T.Fatura.Durum"
               Secenekler="@DurumSecenekleri" Deger="@durumFiltre" DegerChanged="DurumFiltreDegisti" />
    </Katlanir>

    <HataBandi Mesaj="@listeHata" Id="hata-bandi" />
    <BasariBandi Mesaj="@basari" Jeton="@basariJeton" SureliMs="4000" Id="basari-bandi" />

    @* ── Liste ── *@
    <div class="kart">
        @if (yukleniyor)
        {
            <Yukleniyor />
        }
        else if (listeHata is null && faturalar.Count == 0)
        {
            <BosDurum Mesaj="@Dil.T.Fatura.FaturaBulunamadi" />
        }
        else
        {
            <p class="metin-kucuk metin-soluk zo-yana-kaydir zo-yigin-var" aria-hidden="true">@ZB.YanaKaydir</p>
            @* PAKET GOC-A — ORTAK IZGARA (grid:faturalar:fk). Tablo kimliği "fk-tablo" korunur; ZO-BELGE kart kalıbı
               (q10-yigin zo-yigin-dar) ve hücre içerikleri AYNEN. BASİT'te KDV sütunu yok (kolon kümesi moda göre).
               Liste sunucu sınırlı → sınıra değdiyse sıralama kapalı (UX-S29). *@
            <Izgara T="FaturaVeri" Ekran="faturalar" GridId="fk" Zo="golge" Kolonlar="@FaturaKolonlari"
                    Ogeler="@IzgaraYerelSiralama.Uygula(faturalar, FaturaListeTam ? faturaSira : null, FaturaKolonlari)"
                    TabloSinif="tablo-sik q10-th-tek q10-yigin zo-yigin-dar" Baslik="@Dil.T.Fatura.Baslik" YapiskanIlkSutun="false"
                    SiralamaDegisti="@FaturaSiralandi" GecerliSiralama="@faturaSira" TercihIstemcisi="@FkTercih" />
        }
    </div>

    @* ── PAKET P-26 (Y-40) — ÖZEL MATRAH BEYANI ─────────────────────────────
         UX-S21 / UX-S31: kod ("805") EKRANA TEK BAŞINA BASILMAZ; nereden geldiği
         ve mali müşavir imzası olmadığı AYNI YERDE yazılır. Metin SUNUCUDAN gelir
         (KdvAyarlari.KaynakBeyani). Sayaç: denetim.sh OZEL_MATRAH_BEYANSIZ_EKRAN.
         ZO-BELGE (göz #2, kurucu 12:20): uzun mevzuat metni açılışta tezgâhtarın
         önündeydi. Artık sayfa SONUNDA kapalı katlanır; açılınca içerik ve id'ler
         AYNEN (fk-ozel-matrah-haric/-kaynak/-kod/-aralik). Beyan SİLİNMEDİ.
         Hata varsa bu katlanır çizilmez, üstteki açık kart görünür (UX-S28). *@
    @* PAKET YASAL-4 / Y4-C: buradaki kapalı katlanır (#fk-ozel-matrah-beyani) KALDIRILDI —
       bilgi faturanın kendisinde ("Has altın bedeli — KDV'ye tabi değil") ve başlık
       altındaki rozette. Hata kartı (UX-S28) üstte aynen durur. *@
</div>

@* ── P-22 / B-3: TASLAK fatura başlığı — TEK DÜZENLEME KALIBI: Cekmece ──── *@
<Cekmece Acik="@(duzenlenen is not null)" Varlik="fatura"
         Baslik="@Dil.T.Fatura.TaslakDuzenle" Kapat="() => duzenlenen = null"
         Kaydet="DuzenleKaydet" Kaydediliyor="@duzenleKaydediliyor"
         KaydetAktif="@(cariYuklemeHatasi is null && !dTarihGecersiz)"
         KilitSebebi="@(cariYuklemeHatasi is not null ? FT.CariYuklenemedi : dTarihGecersiz ? Dil.T.Ortak.Tarih : null)">
    @if (duzenlenen is not null)
    {
        <div class="form-dikey">
            @* P-53: hata bandı ÜSTTE — cari listesi yüklenemezse kullanıcı ilk
               bunu görür (UX-S28: hata 'kayıt yok'a çevrilmez). *@
            <HataBandi Mesaj="@duzenleHata" />
            @* ZO-BELGE (tasarım hakemi t3, K22): yerel <select> → ortak Secici (id aynı). *@
            <div class="alan">
                <Secici ElemanId="fd-duzenle-cari" Etiket="@Dil.T.Cari.CariSecin" Zorunlu="true"
                        Secenekler="@CariSecenekleri" Deger="@dCariId"
                        DegerChanged="@(v => dCariId = v ?? "")" />
                <AlanHatasi Alan="fd-duzenle-cari" Durum="duzenleForm" />
            </div>
            @* PAKET GOC-A (envanter açık #9 · fd-duzenle-tarih "ham type=date; fatura tarihi ileri ya da çok eski"): ortak
               Tarih Tur=Islem (K8a: ileri gün yok, en çok 1 yıl geri; pencere dışı yıl YAZILAMAZ) — sunucu AYNI kuralla 400.
               Açıklama ham <input> → ortak Metin, sınır sunucuyla AYNI sabit. id'ler AYNI. *@
            <Tarih ElemanId="fd-duzenle-tarih" Etiket="@Dil.T.Ortak.Tarih" Zorunlu="true" Tur="TarihTuru.Islem"
                   Ipucu="@GocASozlugu.Al(Dil.Dil).FaturaTarihIpucu"
                   Deger="@(dTarihGecersiz ? null : DateOnly.FromDateTime(dTarih))" DegerChanged="FaturaTarihDegisti"
                   Durum="duzenleForm" HataAlani="fd-duzenle-tarih" />
            <Metin ElemanId="fd-duzenle-aciklama" Etiket="@Dil.T.Ortak.Aciklama" EnFazla="@AlanSinirlari.FaturaAciklama"
                   Deger="@dAciklama" DegerChanged="@(v => dAciklama = v ?? "")"
                   Durum="duzenleForm" HataAlani="fd-duzenle-aciklama" />
            <div class="alan">
                @* BICIM-2 / ZO-BELGE: ham type=number → girdi ailesi (Para). id ve
                   hata kimliği AYNI (fd-duzenle-toplam · alan-hata-fd-duzenle-toplam). *@
                @* TOPLU-1 (BELGE-KALAN 01.10, YÜKSEK · md.1): kilitli toplam DÜZENLENEBİLİR GÖRÜNMEZ. Eskiden devre dışı
                   Para kutusu beyaz zeminde "(isteğe bağlı)" etiketiyle duruyor, Kaydet toplamı göndermeden başarı bandı
                   basıyordu (değer değişmiyordu → sahte başarı). Kilitliyken SALT OKUNUR satır (id aynı); düzenlenebilirken
                   zorunlu Para kutusu (sunucu boş toplamı reddeder → "isteğe bağlı" değil). *@
                @if (ToplamDuzenlenebilir)
                {
                    <Para ElemanId="fd-duzenle-toplam" Etiket="@Dil.T.Ortak.Toplam" ParaBirimi="TRY" Tur="TutarTuru.Pozitif" Zorunlu="true"
                          Deger="@dToplam" DegerChanged="@(v => dToplam = v)"
                          Durum="duzenleForm" HataAlani="fd-duzenle-toplam" />
                }
                else
                {
                    <SaltOkunur ElemanId="fd-duzenle-toplam" Etiket="@Dil.T.Ortak.Toplam"
                                Deger="@(dToplam is { } dtp ? Bicim.TlKurus(dtp) : null)" BosMetin="—"
                                MakineDeger="@(dToplam is { } dtm ? Bicim.Makine(dtm) : null)" />
                }
                @if (ToplamKuyum)
                {
                    @* P-53 / UX-S25 + UX-S30: kuyum (özel matrah) taslağında toplam
                       DAİMA kilitli (sunucu kuralının aynası) — gerekçe + düzeltme yolu.
                       TOPLU-1 tur 2 (doğrulayıcı ORTA): düzenlenebilir taslakta KAYIT düzeyindeki amber
                       "Bu kayıt değiştirilemez" bandı (DegismezIpucu) yanlış söylüyordu — kayıt düzenleniyor,
                       yalnız ALAN kilitli. Alan düzeyinde nötr not: satırlı taslakta "Toplam satırlardan
                       hesaplanır" (satırlar aşağıda düzeltilir), satırsız kuyum taslağında gerekçe + yol. *@
                    <span class="metin-kucuk metin-soluk" id="fd-duzenle-toplam-sebep">
                        @(duzenlenen.KalemKaynagi == "KALEM" ? T1.ToplamSatirlardan : $"{FT.KuyumToplamGerekce} {FT.KuyumToplamYol}")
                    </span>
                }
                else if (!ToplamDuzenlenebilir)
                {
                    @* UX-S30: kilitli alan SEBEBİNİ söyler. *@
                    <span class="metin-kucuk metin-soluk" id="fd-duzenle-toplam-sebep">
                        @Dil.T.Fatura.ToplamKalemden
                    </span>
                }
            </div>
        </div>

        @* ── PAKET Q9-2 (QA turu 9, KRİTİK): Düzenle kipinde SATIRLAR ─────────
           Satırlar bu çekmecede düzeltilir (tek alanlı → SatirIciDuzenle, P-54
           ile aynı uç) ve yeni satır eklenir (POST /faturalar/{id}/kalemler).
           Toplam EKRANDA HESAPLANMAZ: sunucunun KalemYaniti'ndan okunur.
           Kalemsiz taslakta satır eklenmez — gerekçe + gerçek yol (UX-S25). *@
        <section class="kart kart-govde form-dikey" id="fd-kalem-bolumu" aria-labelledby="fd-kalem-bolumu-baslik">
            <strong id="fd-kalem-bolumu-baslik">@FT.SatirlarBaslik</strong>
            @if (duzenlenen.KalemKaynagi != "KALEM")
            {
                @* TOPLU-1 tur 3 (orkestratör 12:45): satırsız TASLAK düzenlenebilir bir kayıttır (Toplam yukarıda
                   düzeltilir) → amber "Bu kayıt değiştirilemez" bandı (DegismezIpucu) yanlış söylüyordu. O bant
                   yalnız KESİLDİ/İPTAL faturada çıkar; burada aynı id ile nötr alan notu (gerekçe + yol). *@
                <p class="metin-kucuk metin-soluk fatura-satirsiz-notu" id="degismez-ipucu-FaturaSatirsizTaslak" role="note">@FT.SatirsizGerekce @FT.SatirsizYol</p>
            }
            else
            {
                <HataBandi Mesaj="@kalemHata" />
                <BasariBandi Mesaj="@cekmeceKalemBasari" Id="fd-kalem-basari" Jeton="@cekmeceKalemJeton" />
                @if (kalemYanit is null)
                {
                    @if (kalemHata is null)
                    {
                        <Yukleniyor />
                    }
                }
                else
                {
                    <span class="metin-kucuk metin-soluk" id="fd-kalem-duzelt-ipucu">@T1.SatirDuzeltIpucu</span>
                    @foreach (var k in kalemYanit.Kalemler)
                    {
                        <div class="ozet-kutu form-dikey fd-cekmece-kalem" id="@($"fd-cekmece-kalem-{k.Id}")">
                            <div class="satir-arasi">
                                <strong class="sayi">@(k.Sira).</strong>
                                <span class="hucre-vurgu sayi" id="@($"fd-cekmece-kalem-toplam-{k.Id}")">@Bicim.Tl(k.SatirToplam)</span>
                            </div>
                            @if (GumusKuyumKalemi(k))
                            {
                                <span class="metin-kucuk metin-soluk" id="@($"fd-cekmece-kalem-gumus-{k.Id}")">@FT.GumusOzelMatrahYok</span>
                            }
                            else if (MadeniBilinmeyenKuyumKalemi(k))
                            {
                                <span class="metin-kucuk metin-soluk" id="@($"fd-cekmece-kalem-madenyok-{k.Id}")">@FT.MadenBilinmiyorOzelMatrahYok</span>
                            }
                            <div class="alan">
                                <span class="metin-kucuk metin-soluk">@Dil.T.Ortak.Aciklama</span>
                                <SatirIciDuzenle Varlik="fatura-kalem" Alan="aciklama" Id="@k.Id"
                                                 Etiket="@Dil.T.Ortak.Aciklama" Deger="@k.Aciklama"
                                                 Kaydediliyor="@kalemKaydediliyor"
                                                 Kaydedildi="@(v => KalemKaydet(k.Id, "aciklama", v))" />
                                <AlanHatasi Alan="@KalemAlanAnahtari("aciklama", k.Id)" Durum="kalemForm" />
                            </div>
                            <div class="alan">
                                <span class="metin-kucuk metin-soluk">@Dil.T.Fatura.Miktar</span>
                                @* BELGE-KALAN (hakem tur 2 YÜKSEK): Kalemler penceresindeki kural Düzenle
                                   çekmecesinde de geçerli — defter (satış fişi) bağlı kalemin ADEDİ sunucuda
                                   değişmez (400). Salt okunur + sebep + "Fişten değiştir" (UX-S25/S30). *@
                                @if (!string.IsNullOrEmpty(k.HareketId))
                                {
                                    @* TOPLU-1 tur 2 (tasarım hakemi KRİTİK): fişsiz satıştan gelen kalemde fiş YOK —
                                       metin ve bağlantı gerçek kaynağa göre (AdetKilit*). *@
                                    <span class="hucre-tek-satir" id="@($"fd-cekmece-kalem-adet-kilit-{k.Id}")" title="@AdetKilitMetni(k)">@Bicim.Miktar(k.Miktar, k.Birim)</span>
                                    <span class="metin-kucuk metin-soluk" id="@($"fd-cekmece-kalem-adet-sebep-{k.Id}")">
                                        @AdetKilitMetni(k)
                                        <a href="@AdetKilitBagi(k)" class="hucre-tek-satir" id="@($"fd-cekmece-kalem-adet-fis-{k.Id}")">@AdetKilitBagMetni(k)</a>
                                    </span>
                                }
                                else
                                {
                                    <SatirIciDuzenle Varlik="fatura-kalem" Alan="miktar" Id="@k.Id"
                                                     Etiket="@Dil.T.Fatura.Miktar" AsgariDeger="0.001m"
                                                     Deger="@Bicim.Girdi(k.Miktar, "0.###")"
                                                     Kaydediliyor="@kalemKaydediliyor"
                                                     Kaydedildi="@(v => KalemKaydet(k.Id, "miktar", v))" />
                                    <AlanHatasi Alan="@KalemAlanAnahtari("miktar", k.Id)" Durum="kalemForm" />
                                }
                            </div>
                            <div class="alan">
                                <span class="metin-kucuk metin-soluk">@Dil.T.Fatura.BirimFiyat</span>
                                <SatirIciDuzenle Varlik="fatura-kalem" Alan="birimFiyat" Id="@k.Id"
                                                 Etiket="@Dil.T.Fatura.BirimFiyat" AsgariDeger="0m"
                                                 Deger="@Bicim.Girdi(k.BirimFiyat, ParaKutuKalibi)"
                                                 Kaydediliyor="@kalemKaydediliyor"
                                                 Kaydedildi="@(v => KalemKaydet(k.Id, "birimFiyat", v))" />
                                <AlanHatasi Alan="@KalemAlanAnahtari("birimFiyat", k.Id)" Durum="kalemForm" />
                            </div>
                            <div class="alan">
                                <span class="metin-kucuk metin-soluk">@Dil.T.Fatura.Iscilik</span>
                                <SatirIciDuzenle Varlik="fatura-kalem" Alan="iscilikTl" Id="@k.Id"
                                                 Etiket="@Dil.T.Fatura.Iscilik" AsgariDeger="0m" BosOlabilir="true"
                                                 Deger="@(k.IscilikTl is { } isc ? Bicim.Girdi(isc, ParaKutuKalibi) : null)"
                                                 Kaydediliyor="@kalemKaydediliyor"
                                                 Kaydedildi="@(v => KalemKaydet(k.Id, "iscilikTl", v))" />
                                <AlanHatasi Alan="@KalemAlanAnahtari("iscilikTl", k.Id)" Durum="kalemForm" />
                            </div>
                            <div class="alan">
                                <span class="metin-kucuk metin-soluk">@Dil.T.Fatura.Indirim</span>
                                <SatirIciDuzenle Varlik="fatura-kalem" Alan="indirimTutari" Id="@k.Id"
                                                 Etiket="@Dil.T.Fatura.Indirim" AsgariDeger="0m" BosOlabilir="true"
                                                 Deger="@(k.IndirimTutari is { } ind ? Bicim.Girdi(ind, ParaKutuKalibi) : null)"
                                                 Kaydediliyor="@kalemKaydediliyor"
                                                 Kaydedildi="@(v => KalemKaydet(k.Id, "indirimTutari", v))" />
                                <AlanHatasi Alan="@KalemAlanAnahtari("indirimTutari", k.Id)" Durum="kalemForm" />
                            </div>
                        </div>
                    }
                    <div class="satir-arasi">
                        <span>@Dil.T.Ortak.Toplam</span>
                        <span class="hucre-vurgu sayi" id="fd-cekmece-kalem-genel-toplam">@Bicim.Tl(kalemYanit.Toplam)</span>
                    </div>
                    @* P-54 kuralı değişmedi: tek satır SİLİNMEZ — sebep ve gerçek yol. TOPLU-1: düzenlenebilir taslakta
                       amber "değiştirilemez" bandı değil, nötr bilgi notu (id aynı). *@
                    <p class="metin-kucuk metin-soluk fatura-kalem-silme-notu" id="degismez-ipucu-FaturaKalemSilme" role="note">@FT.KalemSilmeGerekce @FT.KalemSilmeYol</p>

                    @* ── Yeni satır — oluşturma formuyla AYNI alan kümesi (UX-S26) ── *@
                    <div class="ozet-kutu form-dikey" id="fd-kalem-yeni">
                        <strong>@FT.YeniSatirBaslik</strong>
                        <HataBandi Mesaj="@urunYuklemeHatasi" />
                        @* P-36: ORTAK girdi ailesi (Secici/Metin/Sayi/Para) — ham girdi etiketi yok. *@
                        <div class="alan">
                            <Secici ElemanId="fd-kalem-yeni-urun" Etiket="@Dil.T.Fatura.Urun"
                                    Secenekler="@UrunSecenekleri" Deger="@ykUrunId" BosSecenekMetni="—"
                                    DegerChanged="@(v => ykUrunId = v ?? "")" />
                            <span class="metin-kucuk metin-soluk">@FT.UrunAdindanGelir</span>
                            @if (urunler.Count >= UrunListeSiniri)
                            {
                                <span class="metin-kucuk metin-soluk" id="fd-kalem-yeni-urun-sinir">@string.Format(FT.UrunSiniri, UrunListeSiniri)</span>
                            }
                            <AlanHatasi Alan="fd-kalem-yeni-urun" Durum="yeniKalemForm" />
                        </div>
                        <Metin ElemanId="fd-kalem-yeni-aciklama" Etiket="@Dil.T.Ortak.Aciklama" EnFazla="@AlanSinirlari.FaturaKalemAciklama"
                               Deger="@ykAciklama" DegerChanged="@(v => ykAciklama = v ?? "")"
                               Durum="yeniKalemForm" HataAlani="fd-kalem-yeni-aciklama" />
                        <Gram ElemanId="fd-kalem-yeni-miktar" Etiket="@Dil.T.Fatura.Miktar" Zorunlu="true" Tur="AgirlikTuru.Gram"
                              Deger="@ykMiktar" DegerChanged="@(v => ykMiktar = v)"
                              Durum="yeniKalemForm" HataAlani="fd-kalem-yeni-miktar" />
                        <Para ElemanId="fd-kalem-yeni-fiyat" Etiket="@Dil.T.Fatura.BirimFiyat" Zorunlu="true" Tur="TutarTuru.SifirOlabilir"
                              ParaBirimi="@duzenlenen.ParaBirimi"
                              Deger="@ykFiyat" DegerChanged="@(v => ykFiyat = v)"
                              Durum="yeniKalemForm" HataAlani="fd-kalem-yeni-fiyat" />
                        <Para ElemanId="fd-kalem-yeni-iscilik" Etiket="@Dil.T.Fatura.Iscilik" Tur="TutarTuru.SifirOlabilir"
                              ParaBirimi="@duzenlenen.ParaBirimi"
                              Deger="@ykIscilik" DegerChanged="@(v => ykIscilik = v)"
                              Durum="yeniKalemForm" HataAlani="fd-kalem-yeni-iscilik" />
                        <Para ElemanId="fd-kalem-yeni-indirim" Etiket="@Dil.T.Fatura.Indirim" Tur="TutarTuru.SifirOlabilir"
                              ParaBirimi="@duzenlenen.ParaBirimi"
                              Deger="@ykIndirim" DegerChanged="@(v => ykIndirim = v)"
                              Durum="yeniKalemForm" HataAlani="fd-kalem-yeni-indirim" />
                        <div class="satir-arasi">
                            <span>@Dil.T.Fatura.SatirToplam</span>
                            <span class="hucre-vurgu sayi" id="fd-kalem-yeni-satir">@(YeniSatirOnizleme is { } on ? Bicim.Para(on, duzenlenen.ParaBirimi) : "—")</span>
                        </div>
                        <button type="button" class="btn btn-ikincil" id="fd-kalem-yeni-ekle"
                                disabled="@kalemEkleniyor" @onclick="YeniKalemEkle">
                            @(kalemEkleniyor ? Dil.T.Kabuk.Kaydediliyor : FT.SatirEkleDugme)
                        </button>
                        @if (kalemEkleniyor)
                        {
                            <span class="metin-kucuk metin-soluk" id="fd-kalem-yeni-ekle-kilit">@Dil.T.Kabuk.SunucuOnayiBekleniyor</span>
                        }
                    </div>
                }
            }
        </section>
    }
</Cekmece>

@* ── Durum geçişi onayı (Kes · Ödendi · İptal) ── *@
<ModalPencere Acik="durumFatura is not null" Baslik="@DurumOnayBaslik" Kapat="DurumOnayKapat">
    <div class="form-dikey">
        <p id="fk-durum-onay">@DurumOnayMetni</p>
        <p class="hucre-vurgu" id="fk-durum-fatura">@durumFatura?.FaturaNo — @durumFatura?.CariAd</p>
        <HataBandi Mesaj="@durumHata" />
        <div class="satir">
            <button class="btn btn-ikincil esnek" id="fk-durum-vazgec" @onclick="DurumOnayKapat"><Kuyumcu.Web.Bilesenler.Yildiz.YildizVazgec /></button>
            <button class="btn btn-tehlike esnek" id="fk-durum-onayla" disabled="@guncelleniyor"
                    @onclick="DurumOnayla">@Dil.T.Kabuk.Onayla</button>
        </div>
    </div>
</ModalPencere>

@* ── Yeni fatura — TEK DÜZENLEME KALIBI: Çekmece (29.09 devam 6, tasarım hakemi YÜKSEK:
      çok alanlı oluşturma formu ModalPencere'deydi; Evrak gir ve taslak düzenleme Çekmece).
      ModalPencere yalnız yıkıcı onayda kalır (DoD EK 2). Kaydet düğmesi formun sonunda,
      kimliği fk-kaydet AYNI (kilit sebebi fk-kaydet-kilit AYNI); Vazgeç çekmecenin altında. ── *@
<Cekmece Acik="yeniModalAcik" Varlik="fatura-yeni" Baslik="@Dil.T.Fatura.YeniFatura"
         Kapat="() => yeniModalAcik = false" KaydetGoster="false">
    <div class="form-dikey zo-yeni-fatura">
        @* ZO-BELGE (tasarım hakemi t3, K22): yerel <select>'ler ortak aileye geçti, id'ler
           AYNI. Uzun liste (cari, işlem, ürün) → Secici; 2-4 seçenek → Form/Secim (radyo). *@
        <div class="alan">
            <Secici ElemanId="fatura-cari" Etiket="@Dil.T.Rapor.CariBasligi" Zorunlu="true"
                    YerTutucu="@Dil.T.Cari.CariSecin"
                    Secenekler="@CariSecenekleri" Deger="@formCariId"
                    DegerChanged="@(v => formCariId = v ?? "")" />
            <AlanHatasi Alan="fatura-cari" Durum="yeniForm" />
        </div>
        @* Radyo grupları TAM satır: seçenekler tek satıra sığar (yarım sütunda 2×2 kırılıyordu).
           Üçü de sunucuda zorunludur ve hep bir değer taşır → "*" (isteğe bağlı değil). *@
        @* TOPLU-7B (GOC-A devri "açılışta ağır zorunlu blok"): üç grup da hazır seçili gelir (Satış · Standart · %20) —
           kullanıcının YAZACAĞI yalnız müşteri ve tutardır. Gruplar KAPALI "Fatura ayrıntıları" satırında (<details>: içerik DOM'da kalır, testler/ekran okuyucu); özet seçili
           değerleri söyler, değiştirmek isteyen açar. Durum değişkenleri, kimlikler ve gövde AYNEN. *@
        <details class="ayrinti-katli" id="fatura-ayrinti">
            <summary class="ayrinti-katli-ac" id="fatura-ayrinti-ac">
                <span class="ayrinti-katli-baslik" id="fatura-ayrinti-ozet">@Toplu7BSozlugu.Al(Dil.Dil).FaturaAyrintiBaslik: @AyrintiOzeti</span>
                <Ikon Ad="@Ikonlar.KatlamaKapali" Sinif="ayrinti-katli-ok" />
            </summary>
            <div class="form-dikey ayrinti-katli-govde">
                <Secim ElemanId="fatura-tur" Etiket="@Dil.T.Fatura.Tur" Zorunlu="true"
                       Secenekler="@TurSecenekleri" Deger="@formTur"
                       DegerChanged="@(v => formTur = v ?? "SATIS")" />
                <Secim ElemanId="fatura-kdvturu" Etiket="@Dil.T.Fatura.KdvTuru" Zorunlu="true"
                       Secenekler="@KdvTuruSecenekleri" Deger="@formKdvTuru"
                       DegerChanged="KdvTuruDegisti" />
                <Secim ElemanId="fatura-kdv" Etiket="@Dil.T.Fatura.KdvOran" Zorunlu="true"
                       Secenekler="@KdvSecenekleri" Deger="@formKdv"
                       DegerChanged="@(v => formKdv = v ?? "0.20")" />
            </div>
        </details>
        <div>
            @if (Kuyum)
            {
                @* ── UX-S21: has bedeli KULLANICIDAN İSTENMEZ, defterden türetilir ──
                   Girdi SALT OKUNUR; yerine "hangi işlem faturalanacak" sorulur. *@
                <div class="alan">
                    <Secici ElemanId="fatura-islem" Etiket="@Dil.T.Fatura.FaturalanacakIslem"
                            YerTutucu="@Dil.T.Fatura.IslemSecin"
                            Secenekler="@IslemSecenekleri" Deger="@formHareketId"
                            DegerChanged="IslemSec" />
                    <span class="metin-kucuk metin-soluk">@Dil.T.Fatura.HasDegerIpucu</span>
                    @* Y4-D: özel matrah yalnız ALTIN bacağına uygulanır. Not ZORUNLU-ÖNCE: yalnız seçilen
                       işlemde altın dışı (gümüş/platin/paladyum) has bacağı VARSA görünür (sunucu söyler). *@
                    @if (onizleme?.AltinDisiMadenVar == true)
                    {
                        <span class="metin-kucuk metin-soluk" id="fom-gumus-not">@FT.GumusOzelMatrahYok</span>
                    }
                </div>
            }
        </div>
        @if (Kuyum)
        {
            @* KESIF-P3 tasarım hakemi tur 2 (#57): kutunun iç boşluğu yoktu (metin ve düğme çerçeveye
               yapışık) → zo-onizleme-kutu belirteçli iç boşluk + aralık (zo-belge.css). *@
            <div class="kart zo-onizleme-kutu" id="fom-kutu">
                @if (islemlerYukleniyor)
                {
                    <Yukleniyor />
                }
                else if (!string.IsNullOrEmpty(islemHata))
                {
                    @* UX-S28: hata "kayıt yok"a çevrilmez; sebebi görünür. *@
                    <HataBandi Mesaj="@islemHata" />
                }
                else if (faturalanabilir.Count == 0)
                {
                    <BosDurum Mesaj="@Dil.T.Fatura.FaturalanabilirYok" />
                }
                @if (faturalanabilirDahaVar)
                {
                    @* UX-S29: sessiz kırpma yok — sınır ve daraltma yolu yazılır. *@
                    <span class="metin-kucuk metin-soluk" id="fom-sinir">@Dil.T.Fatura.FaturalanabilirSinir</span>
                }
                @if (onizleme is not null)
                {
                    <div class="satir-arasi">
                        <span>@Dil.T.Fatura.HasDeger</span>
                        <span class="hucre-vurgu sayi" id="fom-hasdeger">@Bicim.Tl(onizleme.HasDeger)</span>
                    </div>
                    <div class="satir-arasi">
                        <span>@Dil.T.Urun.HasGram</span>
                        <span class="sayi" id="fom-hasgram">@Bicim.Has(onizleme.HasGram)</span>
                    </div>
                    <div class="satir-arasi">
                        <span>@Dil.T.Fatura.HasDegerKaynagi</span>
                        <Rozet Renk="mavi">@Dil.T.Fatura.KaynakHareket</Rozet>
                    </div>
                    <ProAlan>
                        <div class="satir-arasi">
                            <span>@Dil.T.Fatura.HasKuru</span>
                            <span class="sayi" id="fom-haskur">@Bicim.Tl(onizleme.HasBirimFiyat ?? 0m)</span>
                        </div>
                        <div class="satir-arasi">
                            <span>@Dil.T.Fatura.KapsananIslem</span>
                            <span class="sayi" id="fom-kapsam">@onizleme.KapsananHareketSayisi</span>
                        </div>
                        <div class="satir-arasi">
                            <span>@Dil.T.Fatura.DefterToplami</span>
                            <span class="sayi" id="fom-defter">@Bicim.Tl(onizleme.DefterToplami)</span>
                        </div>
                    </ProAlan>
                    @if (!string.IsNullOrEmpty(onizleme.FaturaNo))
                    {
                        <HataBandi Mesaj="@onizleme.FaturaNo" />
                    }
                    @if (!string.IsNullOrEmpty(onizleme.Uyari))
                    {
                        <HataBandi Mesaj="@onizleme.Uyari" />
                    }
                }
                @* UX-S24: bağımlı alanın bağını ekran kurar — toplam/oran değişince
                   sessizce yenilenmez, kullanıcı "güncelle" der. *@
                @* KESIF-P3 (#57): kilit sebebi düğmenin YANINDA satır kutusu olarak başlayıp altına
                   kırılıyordu (K9) — artık düğmenin ÜSTÜNDE kendi satırında (blok). Aynı cümle
                   alt çubukta TEKRAR basılmaz (fk-kaydet-kilit kısa gösterme metni). *@
                @if (string.IsNullOrEmpty(formHareketId))
                {
                    @* UX-S30: kilitli düğme sebebini söyler. *@
                    <p class="metin-soluk zo-onizleme-kilit" id="fom-kilit"><Ikon Ad="@Ikonlar.Kilit" /> @Dil.T.Fatura.IslemSecilmedi</p>
                }
                <button class="btn btn-ikincil" id="fom-yenile"
                        disabled="@(string.IsNullOrEmpty(formHareketId) || onizleniyorMatrah)"
                        @onclick="OzelMatrahOnizle">@Dil.T.Fatura.OnizlemeyiGuncelle</button>
            </div>
        }
        <div class="alan">
            @* ZO-BELGE (tasarım hakemi t3, K18): toplam HER ZAMAN doğrulanır (Pozitif; kalem
               varsa kalem toplamına eşit olmalı) → etiket "(isteğe bağlı)" değil, "*". *@
            @* BICIM-2 / ZO-BELGE: ham type=number → Para (id + hata kimliği AYNI). *@
            <Para ElemanId="fatura-toplam" Etiket="@Dil.T.Fatura.Toplam" Zorunlu="true" ParaBirimi="TRY" Tur="TutarTuru.Pozitif"
                  Deger="@(formToplam == 0m ? null : formToplam)" DegerChanged="@(v => formToplam = v ?? 0m)"
                  Durum="yeniForm" HataAlani="fatura-toplam" />
        </div>
        @if (formToplam > 0)
        {
            @* KDV önizleme: girilen toplam KDV dahildir *@
            <div class="metin-kucuk metin-soluk ozet-kutu">
                @if (Kuyum)
                {
                    @* KUYUM kırılımı SUNUCUDAN gelir. İstemcideki ikiz KDV formülü
                       SİLİNDİ (TB-11 "ikizlenmiş kural" büyütülmez): matrahı ekran
                       hesaplasaydı sunucuyla saptığında hangisinin doğru olduğunun
                       cevabı olmazdı. *@
                    @if (onizleme?.Matrah is null)
                    {
                        <BosDurum Mesaj="@Dil.T.Fatura.OnizlemeYok" />
                    }
                    else
                    {
                        <div class="satir-arasi">
                            <span>@Dil.T.Fatura.Matrah</span>
                            <span class="sayi" id="fom-matrah">@Bicim.Tl(onizleme.Matrah.Value)</span>
                        </div>
                        <div class="satir-arasi">
                            <span>@Dil.T.Fatura.KdvTutar</span>
                            <span class="sayi" id="fom-kdv">@Bicim.Tl(onizleme.KdvTutar ?? 0m)</span>
                        </div>
                        <div class="satir-arasi">
                            <span>@Dil.T.Fatura.AraToplam</span>
                            <span class="sayi" id="fom-aratoplam">@Bicim.Tl(onizleme.AraToplam ?? 0m)</span>
                        </div>
                    }
                }
                else
                {
                    <div class="satir-arasi">
                        <span>@Dil.T.Fatura.AraToplam</span>
                        <span class="sayi">@Bicim.Tl(OnizlemeAraToplam)</span>
                    </div>
                    <div class="satir-arasi">
                        <span>@Dil.T.Fatura.KdvTutar</span>
                        <span class="sayi">@Bicim.Tl(OnizlemeKdvTutar)</span>
                    </div>
                }
            </div>
        }
        @* PAKET GOC-A: ham <input> → ortak Metin (sınır sunucuyla AYNI sabit; iki tarafta da sınır yoktu). id AYNI. *@
        <Metin ElemanId="fatura-aciklama" Etiket="@Dil.T.Ortak.Aciklama" EnFazla="@AlanSinirlari.FaturaAciklama"
               Deger="@formAciklama" DegerChanged="@(v => formAciklama = v ?? "")" />

        @* ── Satır kalemleri (opsiyonel) — boşsa sunucu bugünkü başlık yolunu kullanır ──
              29.09 devam 6 (tasarım hakemi YÜKSEK): açılışta ~230 px'lik boş kutu yoktu gereği;
              kalem yokken yalnız "+ Kalem ekle" düğmesi ve tek satır ipucu. İlk kalem
              eklenince iç boşluklu kart açılır. Kimlik fk-ekle AYNI. *@
        <div class="zo-kalem-bolum @(formKalemler.Count > 0 ? "kart zo-kalem-kart" : null)" id="fk-kalem-bolum">
            <div class="satir-arasi">
                <strong>@ZB.FaturaKalemlerIstegeBagli</strong>
                <button class="btn btn-ikincil btn-kucuk" id="fk-ekle" @onclick="KalemEkle">+ @Dil.T.Fatura.KalemEkle</button>
            </div>
            @if (formKalemler.Count == 0)
            {
                <p class="metin-kucuk metin-soluk" id="fk-kalem-yok">@ZB.FaturaKalemYokIpucu</p>
            }
            else
            {
                @* PAKET GOC-A — ORTAK IZGARA (grid:faturalar:fk-kalem): düzenlenebilir form satırları; id'ler AYNI (fk-*-{sıra}).
                   Sıra elle düzenlenen form olduğu için sıralanmaz (satır sırası = belge sırası). *@
                <Izgara T="KalemSatiri" Ekran="faturalar" GridId="fk-kalem" Zo="kalem" Kolonlar="@FormKalemKolonlari" Ogeler="@formKalemler"
                        Baslik="@Dil.T.Fatura.Kalemler" YapiskanIlkSutun="false" TercihIstemcisi="@FkTercih" />
                <div class="satir-arasi">
                    <span>@Dil.T.Fatura.KalemToplami</span>
                    <span class="hucre-vurgu sayi" id="fk-toplam">@Bicim.Tl(KalemToplami)</span>
                </div>
                @if (!ToplamUyusuyor)
                {
                    @* Sunucudaki "tolerans yok" kuralının ekran karşılığı — Kaydet kapalıdır. *@
                    <HataBandi Mesaj="@Dil.T.Fatura.ToplamUyusmuyor" />
                }
            }
        </div>

        <HataBandi Mesaj="@modalHata" />
        <BasariBandi Mesaj="@modalBasari" />
    </div>
    @* 29.09 DEVAM 12 (tasarım hakemi YÜKSEK): Kaydet gövdenin ortasında, İptal altlıkta tek
       başınaydı; Evrak gir'de ikisi altlıkta yan yana. Artık AYNI altlık: "İptal | Kaydet"
       (ikincil önce, birincil sonda — Cekmece P-36c sırası), aynı sınıflar (cekmece-alt,
       dugme). Ortak Cekmece'nin Kaydet'i fk-kaydet kimliğini taşıyamadığı için altlık burada
       çizilir, çekmecenin kendi altlığı yalnız bu çekmecede gizlenir (zo-belge.css; EMANET-1
       deseni). Kimlikler fk-kaydet / fk-kaydet-kilit AYNI. *@
    <div class="cekmece-alt zo-cekmece-alt" id="fk-eylem">
        <button type="button" class="dugme dugme-ikincil" id="fk-vazgec"
                @onclick="() => yeniModalAcik = false"><Kuyumcu.Web.Bilesenler.Yildiz.YildizVazgec /></button>
        <button type="button" class="dugme dugme-birincil" disabled="@(kaydediliyor || !ToplamUyusuyor || KuyumEngeli)"
                id="fk-kaydet"
                @onclick="FaturaOlustur">@Dil.T.Ortak.Kaydet</button>
        @* UX-S30 / 38-A devri: kilidin SEBEBİ yazılır. Kuyum KDV'sinde has
           bedeli defterden türetilir; işlem seçilmeden fatura kesilemez —
           sunucu da artık bunu 400 ile reddeder (sessiz 0 yazmaz). *@
        @if (KuyumEngeli || !ToplamUyusuyor)
        {
            <span class="cekmece-kilit-sebep" id="fk-kaydet-kilit">
                @(KuyumEngeli ? P3.KuyumKaydetKilitKisa : Dil.T.Fatura.ToplamUyusmuyor)
            </span>
        }
    </div>
</Cekmece>

@* ── Fişten fatura kes: fiş kimliği → ÖNİZLEME → Kaydet ──
      29.09 DEVAM 12 (tasarım hakemi YÜKSEK): çok alanlı oluşturma formu ModalPencere'deydi —
      Yeni Fatura ile aynı gerekçe: TEK DÜZENLEME KALIBI Çekmece (DoD EK 2: ModalPencere
      yalnız yıkıcı onay). Kimlikler (ff-*) AYNI; altlık Yeni Fatura / Evrak gir ile aynı. ── *@
<Cekmece Acik="fistenModalAcik" Varlik="fatura-fisten" Baslik="@Dil.T.Fatura.FistenKes"
         Kapat="() => fistenModalAcik = false" KaydetGoster="false">
    <div class="form-dikey zo-fisten-fatura">
        @* ZO-BELGE 29.09 (tasarım hakemi k3): ipucu pencerede İKİ kez basılıyordu (üstte ve boş
           durumda) ve "sunucuda" diyordu — tek kez, sade metinle (ZB.FistenIpucu) boş durumda. *@
        @* ── PAKET P-15 (B-25) — 26 HANELİ ULID YERİNE KAYIT SEÇİCİ ──────────
           ÖNCE: kullanıcı fiş kimliğini (26 haneli ULID) ELLE yazıyordu; ne
           kopyalanacak bir yer vardı ne de yanlış yazdığını anlamanın yolu.
           ŞİMDİ: sunucuda arar (cari adı ya da fiş kimliği), sonuçta AD + TÜR
           + tarih/kalem/tutar görür; ULID yalnız gövdeye gider.
           ⚠ Girdi kimliği `ff-fis` DEĞİŞMEDİ (mevcut id sözleşmesi). *@
        @* TOPLU-1 (BELGE-KALAN 01.10, YÜKSEK): fiş araması (/arama Fis) yalnız fiş numarası olan kayıtları
           bulur (FisId != null) — tek satırlık FİŞSİZ satışlar hiç bulunamıyordu. Faturası kesilmemiş son
           işlemler sunucunun faturalanabilir listesinden gelir: fişli kayıt FİŞ olarak (tüm kalemleri),
           fişsiz kayıt tek işlem olarak (hareketId) seçilir. Arama kutusu daha eski fişler için kalır. *@
        <div class="alan">
            <Secici ElemanId="ff-islem" Etiket="@T1.FistenSonIslemler" YerTutucu="@T1.FistenSonIslemlerYerTutucu"
                    Secenekler="@FistenIslemSecenekleri" Deger="@FistenIslemDegeri"
                    DegerChanged="FistenIslemSecildi" />
            @if (islemHata is { } fih)
            {
                <HataBandi Mesaj="@fih" Id="ff-islem-hata" />
            }
            else if (!islemlerYukleniyor && faturalanabilir.Count == 0)
            {
                <span class="metin-kucuk metin-soluk" id="ff-islem-bos">@string.Format(T1.FistenListeBos, FistenGun)</span>
            }
            else if (faturalanabilirDahaVar)
            {
                <span class="metin-kucuk metin-soluk" id="ff-islem-sinir">@string.Format(T1.FistenListeSinir, FistenGun, FistenLimit)</span>
            }
        </div>
        @* TOPLU-1 tur 2: listeden FİŞSİZ işlem seçilince önizleme hazırdır — eski fiş araması ve Önizle
           düğmesi gizlenir (boş "fiş yok" durumu ve sebepsiz kilitli düğme kafa karıştırıyordu, UX-S30). *@
        @if (fistenHareketId.Length == 0)
        {
        <div class="zo-fk-fis">
        @* Etiket "Fiş Kimliği" değil "Fiş" (hakem k3); sonuç satırının alt bilgisi HER satırda
           adın altında (zo-belge.css .zo-fk-fis) — satır düzeni tutarlı. id ff-fis AYNI. *@
        <KayitSecici Tur="@Kuyumcu.Contracts.Arama.AramaTurleri.Fis"
                     ElemanId="ff-fis"
                     Etiket="@ZB.FistenFisEtiket"
                     Deger="@fistenFisId"
                     BosMesaj="@ZB.FistenAramaYok"
                     DegerChanged="FisSecildi" />
        </div>
        }
        <div class="form-dikey">
            <Secim ElemanId="ff-kdvturu" Etiket="@Dil.T.Fatura.KdvTuru" Zorunlu="true"
                   Secenekler="@KdvTuruSecenekleri" Deger="@fistenKdvTuru"
                   DegerChanged="@(v => fistenKdvTuru = v ?? "STANDART")" />
            <Secim ElemanId="ff-kdv" Etiket="@Dil.T.Fatura.KdvOran" Zorunlu="true"
                   Secenekler="@KdvSecenekleri" Deger="@fistenKdv"
                   DegerChanged="@(v => fistenKdv = v ?? "0.20")" />
        </div>
        @if (fistenHareketId.Length == 0)
        {
        <button class="btn btn-ikincil" id="ff-onizle"
                disabled="@(string.IsNullOrWhiteSpace(fistenFisId) || onizleniyor)"
                @onclick="FisOnizle">@Dil.T.Fatura.Onizle</button>
        }

        @if (fisYanit is null)
        {
            @* Boş tablo yerine SEBEP: henüz önizlenmedi (bilinmeyen sıfır sayılmaz). *@
            <BosDurum Mesaj="@ZB.FistenIpucu" />
        }
        else
        {
            <div class="satir-arasi">
                <span>@Dil.T.Rapor.CariBasligi</span>
                <span class="hucre-vurgu" id="ff-cari">@(fisYanit.CariAd ?? ZB.FistenCariYok)</span>
            </div>
            <div class="satir-arasi">
                <span>@Dil.T.Fatura.FisKalemSayisi</span>
                <span class="sayi" id="ff-kalem-sayisi">@fisYanit.KalemSayisi</span>
            </div>
            @* Doğrulayıcı 29.09 (ORTA): faturanın türü FİŞTEN türetilir (UX-S21) ve gösterilir — alış fişi
               eskiden gövdede tür gönderilmediği için sunucu varsayılanıyla SATIŞ faturası oluyordu. *@
            <div class="satir-arasi">
                <span>@Dil.T.Fatura.Tur</span>
                <span id="ff-tur">
                    <Rozet Renk="@(FistenTur(fisYanit) == "SATIS" ? "yesil" : "amber")">@(FistenTur(fisYanit) == "SATIS" ? Dil.T.Fatura.Satis : Dil.T.Fatura.Alis)</Rozet>
                </span>
            </div>
            @* PAKET GOC-A — ORTAK IZGARA (grid:faturalar:ff-kalem; tablo kimliği "ff-kalem-tablosu" korunur). *@
            <Izgara T="FisKalemVeri" Ekran="faturalar" GridId="ff-kalem" TabloId="ff-kalem-tablosu" Kolonlar="@FisKalemKolonlari"
                    Ogeler="@fisYanit.Kalemler" SatirSinif="@(_ => "ff-kalem-satir")" Baslik="@Dil.T.Fatura.Kalemler"
                    YapiskanIlkSutun="false" TercihIstemcisi="@FkTercih" />
            <div class="satir-arasi">
                <span>@Dil.T.Ortak.Toplam</span>
                <span class="hucre-vurgu sayi" id="ff-toplam">@Bicim.Tl(FistenToplam(fisYanit))</span>
            </div>
            @if (!string.IsNullOrEmpty(fisYanit.FaturaNo))
            {
                @* Bir fiş yalnız bir faturaya bağlanır: sunucudaki kapının ekran karşılığı. *@
                @* Ham damga (TASLAK:<ULID>) ya da çıplak numara değil, cümle (orkestratör 18:05). *@
                <HataBandi Mesaj="@FistenFaturaliMesaj(fisYanit.FaturaNo)" />
            }
        }

        <HataBandi Mesaj="@fistenHata" />
        <BasariBandi Mesaj="@fistenBasari" />
    </div>
    <div class="cekmece-alt zo-cekmece-alt" id="ff-eylem">
        <button type="button" class="dugme dugme-ikincil" id="ff-vazgec"
                @onclick="() => fistenModalAcik = false"><Kuyumcu.Web.Bilesenler.Yildiz.YildizVazgec /></button>
        <button type="button" class="dugme dugme-birincil" id="ff-kaydet"
                disabled="@FistenKaydetKapali"
                @onclick="FistenFaturaKes">@Dil.T.Ortak.Kaydet</button>
        @* UX-S30: kilitli Kaydet sebebini söyler (önizlenmedi / kalem yok / zaten faturalı). *@
        @if (FistenKilitSebebi is { } fks)
        {
            <span class="cekmece-kilit-sebep" id="ff-kaydet-kilit">@fks</span>
        }
    </div>
</Cekmece>

@* ── Kalem detayı ── *@
<ModalPencere Acik="kalemModalAcik" Baslik="@Dil.T.Fatura.Kalemler" Kapat="() => kalemModalAcik = false">
    <div class="dikey-bosluk">
        <HataBandi Mesaj="@kalemHata" />
        @* UX-S25 — P-22 / B-3: TASLAK belge düzenlenebilir; KESİLMİŞ belge değişmez.
           ZO-BELGE: bu ipucu artık liste açılışında değil, KAYIT AÇILINCA (kurucu:
           "değiştirilemez" kutusu açılışta yok). id AYNI: degismez-ipucu-Fatura. *@
        @if (kalemFaturaDurumu is { } kd && kd != "TASLAK")
        {
            <DegismezIpucu Varlik="Fatura" Gerekce="@Dil.T.Fatura.KesilmisDegismez"
                           AlternatifYol="@Dil.T.Fatura.FaturaDegismezYolu" />
        }
        @if (kalemYanit is null)
        {
            <Yukleniyor />
        }
        else if (kalemYanit.KalemKaynagi != "KALEM")
        {
            @* Boş tablo yerine SEBEP yazılır: bilinmeyen sıfır sayılmaz. *@
            <BosDurum Mesaj="@Dil.T.Fatura.KalemsizFatura" />
        }
        else
        {
            @* KESIF-P3 (#23): PRO'da 10 sütun pencereye sığmıyor, KDV/Tutar kırpılıyordu (960 ölçümü
               tablo 1024 / kap 920). Pencere gövdesi dar (≤ 900 px) ise satır KART olur (zo-belge.css
               "zokalem" kabı); genişte tablo. *@
            @* PAKET GOC-A — ORTAK IZGARA (grid:faturalar:fd-kalem-liste — "fd-kalem-basari" sayfa bandıyla çakışmasın; tablo kimliği "fd-kalem-tablosu" korunur). BELGE-KALAN /
               KESIF-P3 kart sınıfları (q10-yigin zo-kalem-genis zo-kalem-duzenlenir) AYNEN; satır içi düzenleme ve
               defter bağlı adet kilidi hücrelerde aynen. GOC-A: satır içi sınırlar sunucuyla AYNI (açıklama 300 ·
               miktar 3 ondalık · tutar 2 ondalık — fazlası sessizce yuvarlanmaz, alan altında söylenir). *@
            <Izgara T="KalemVeri" Ekran="faturalar" GridId="fd-kalem-liste" Zo="kalem" TabloId="fd-kalem-tablosu" Kolonlar="@DetayKalemKolonlari"
                    Ogeler="@kalemYanit.Kalemler" SatirSinif="@(_ => "fd-kalem-satir")"
                    TabloSinif="@($"q10-yigin {(Dil.BasitMi ? null : "zo-kalem-genis")} {(!Dil.BasitMi && KalemDuzenlenebilir ? "zo-kalem-duzenlenir" : null)}")"
                    Baslik="@Dil.T.Fatura.Kalemler" YapiskanIlkSutun="false" TercihIstemcisi="@FkTercih" />
            <div class="satir-arasi">
                <span>@Dil.T.Ortak.Toplam</span>
                <span class="hucre-vurgu sayi" id="fd-toplam">@Bicim.TlKurus(kalemYanit.Toplam)</span>
            </div>
            @* PAKET YASAL-4 / Y4-C (K-10): KUYUM faturada has bedelinin KDV DIŞI olduğu
               faturanın KENDİSİNDE yazar. Değerler sunucunun kalem satırlarından
               (OzelMatrahMotoru'nun yazdığı has_deger / kdv_matrah) — yeni formül yok. *@
            @* Hasım bulgusu 01.10: "Has altın bedeli" gümüş kalemleri TOPLAMAZ — madene göre
               ayrı satır (Y4-D: gümüş has bedeli gümüş fiyatıyla; § 3.1 M-12). *@
            @if (kalemYanit.Kalemler.Any(k => k.KdvTuru == "KUYUM"))
            {
                if (kalemYanit.Kalemler.Any(k => k.KdvTuru == "KUYUM" && k.Maden != Kuyumcu.Core.Domain.Maden.Gumus))
                {
                <div class="satir-arasi" id="fd-has-kdv-disi">
                    <span>@Y4F.FaturaHasSatiri</span>
                    <span class="sayi" id="fd-has-kdv-disi-tutar">@Bicim.TlKurus(kalemYanit.Kalemler.Where(k => k.KdvTuru == "KUYUM" && k.Maden != Kuyumcu.Core.Domain.Maden.Gumus).Sum(k => k.HasDeger))</span>
                </div>
                }
                @* Gümüş has bedeli 0 ise (gümüş fiyatı yok → özel matrah uygulanmadı, fail-closed) satır
                   çizilmez: "KDV'ye tabi değil" iddiası yalnız gerçekten düşülen tutar için yazılır. *@
                if (kalemYanit.Kalemler.Where(k => k.KdvTuru == "KUYUM" && k.Maden == Kuyumcu.Core.Domain.Maden.Gumus).Sum(k => k.HasDeger) > 0m)
                {
                <div class="satir-arasi" id="fd-gumus-kdv-disi">
                    <span>@Y4F.FaturaGumusSatiri</span>
                    <span class="sayi" id="fd-gumus-kdv-disi-tutar">@Bicim.TlKurus(kalemYanit.Kalemler.Where(k => k.KdvTuru == "KUYUM" && k.Maden == Kuyumcu.Core.Domain.Maden.Gumus).Sum(k => k.HasDeger))</span>
                </div>
                }
                <div class="satir-arasi" id="fd-kdv-matrahi">
                    <span>@Y4F.FaturaKdvMatrahi</span>
                    <span class="sayi" id="fd-kdv-matrahi-tutar">@Bicim.TlKurus(kalemYanit.Kalemler.Sum(k => k.KdvMatrah))</span>
                </div>
            }
            @* P-22 / B-3: TASLAK kalemi DÜZENLENEBİLİR (tek alanlı → SatirIciDuzenle).
               Kesilmiş belgenin kalemi değişmez; ipucu yalnız o durumda çizilir. *@
            @if (!KalemDuzenlenebilir)
            {
                <DegismezIpucu Varlik="FaturaKalemi" Gerekce="@Dil.T.Fatura.KalemDegismez"
                               AlternatifYol="@Dil.T.Fatura.FaturaDegismezYolu" />
            }
            else
            {
                @* P-54: taslak kalemi için SİLME ucu YOK (ölçüldü: FaturaModulu'nda
                   HttpDelete yok; sunucu kuralı "kalem silinmez, taslak iptal edilir").
                   Düğme uydurulmaz — sebep ve doğru yol yazılır (UX-S25). *@
                @* TOPLU-1 (BELGE-KALAN 01.10, YÜKSEK): düzenlenebilir taslakta amber "Bu kayıt değiştirilemez" bandı
                   YANLIŞTI — kayıt düzenlenebilir, yalnız tek satır silinemez. Nötr bilgi notu (id aynı). *@
                <p class="metin-kucuk metin-soluk fatura-kalem-silme-notu" id="degismez-ipucu-FaturaKalemSilme" role="note">@FT.KalemSilmeGerekce @FT.KalemSilmeYol</p>
            }
        }
    </div>
</ModalPencere>

@code {
    // PAKET Q10-5 — özel matrah beyanının içeriği TEK yerde; basit modda katlanır
    // özetin içinde, profesyonel modda başlığın altında çizilir (ikinci kopya yok).
    private RenderFragment OzelMatrahIcerik => @<div class="q10-om-icerik">
        @if (ozelMatrahHata is not null)
        {
            @* UX-S28: hata "kayıt yok"a çevrilmez, ayrı bandda görünür. *@
            <HataBandi Mesaj="@ozelMatrahHata" Id="fk-ozel-matrah-hata" />
        }
        else if (ozelMatrahKod is null)
        {
            @* Y-40: KAPALI beyanı sade cümle — Basit ve Pro'da AYNI (Y4-C § 4.3). Sunucunun
               teknik kaynak beyanı (yapılandırma anahtarı) artık EKRANA basılmaz (K-12). *@
            <p class="ikincil-metin" id="fk-ozel-matrah-haric">@Q105Sozlugu.Al(Dil.Dil).OzelMatrahKapaliBasit</p>
        }
        else
        {
            <p><span class="rozet" id="fk-ozel-matrah-kod">@ozelMatrahKod</span></p>
            <p class="ikincil-metin" id="fk-ozel-matrah-kaynak">@ozelMatrahKaynak</p>
            @if (!ozelMatrahAralikta)
            {
                <p class="ikincil-metin" id="fk-ozel-matrah-aralik">@Dil.T.Fatura.OzelMatrahAralikDisi</p>
            }
        }
    </div>;




    /// <summary>Yeni fatura formundaki kalem satırı (ekran tarafı).</summary>
    private sealed class KalemSatiri
    {
        public string UrunId { get; set; } = "";
        public decimal Miktar { get; set; } = 1m;
        public decimal BirimFiyat { get; set; }
        public decimal Iscilik { get; set; }
        public decimal Indirim { get; set; }
    }




    private List<FaturaVeri> faturalar = [];

    // ── PAKET GOC-A — fatura tarihi (Tarih Tur=Islem; geçersiz yazımda Kaydet kilitli) ───────────
    private bool dTarihGecersiz;
    private void FaturaTarihDegisti(DateOnly? v)
    {
        dTarihGecersiz = v is null;
        if (v is { } g) dTarih = g.ToDateTime(TimeOnly.MinValue);
    }

    // ── PAKET GOC-A — ORTAK IZGARA (grid:faturalar:*) ─────────────────────────────
    private IzgaraTercihIstemcisi? fkTercih;
    private IzgaraTercihIstemcisi FkTercih => fkTercih ??= new IzgaraTercihIstemcisi(Api);
    private IzgaraSiralama? faturaSira;
    private void FaturaSiralandi(IzgaraSiralama? s) => faturaSira = s;
    /// <summary>Liste sunucu sınırına (100) değmediyse tam liste → yerel sıralama yanıltmaz.</summary>
    private bool FaturaListeTam => faturalar.Count < 100;
    private string? FaturaSiraAdi(string ad) => FaturaListeTam ? ad : null;

    private IReadOnlyList<IzgaraKolonu<FaturaVeri>> FaturaKolonlari
    {
        get
        {
            var l = new List<IzgaraKolonu<FaturaVeri>>
            {
                // P-22 / B-3: TASLAK belgenin numarası YOKTUR; SEBEBİ yazılır. PRO: kaynak numaranın ALT satırında.
                new() { Anahtar = "no", Baslik = Dil.T.Fatura.FaturaNo, ZorunluGorunur = true, SunucuSiralamaAdi = FaturaSiraAdi("no"),
                        HucreSinif = _ => "hucre-vurgu sayi metin-kucuk", Deger = f => f.FaturaNo, Hucre = f => @<text>@FaturaNoHucresi(f)</text> },
                new() { Anahtar = "tarih", Baslik = Dil.T.Ortak.Tarih, SunucuSiralamaAdi = FaturaSiraAdi("tarih"),
                        HucreSinif = _ => "metin-soluk hucre-tek-satir", Deger = f => f.Tarih, Hucre = f => @<text>@Bicim.Tarih(f.Tarih, Dil.Locale)</text> },
                new() { Anahtar = "cari", Baslik = Dil.T.Rapor.CariBasligi, ZorunluGorunur = true, SunucuSiralamaAdi = FaturaSiraAdi("cari"),
                        HucreSinif = _ => "hucre-vurgu zo-metin-sutun", Deger = f => f.CariAd,
                        Hucre = f => @<span class="zo-iki-satir" title="@f.CariAd">@f.CariAd</span> },
                new() { Anahtar = "tur", Baslik = Dil.T.Fatura.Tur, Tur = IzgaraHucreTuru.Rozet, Deger = f => f.Tur,
                        Hucre = f => @<Rozet Renk="@(f.Tur == "SATIS" ? "yesil" : "amber")">@(f.Tur == "SATIS" ? Dil.T.Fatura.Satis : Dil.T.Fatura.Alis)</Rozet> },
            };
            // ZO-BELGE: BASİT'te KDV sütunu yok (Toplam kalır; ayrıntı faturanın kendisinde).
            if (!Dil.BasitMi)
                l.Add(new() { Anahtar = "kdv", Baslik = Dil.T.Fatura.KdvTutar, SunucuSiralamaAdi = FaturaSiraAdi("kdv"),
                              HucreSinif = _ => "sayi hucre-tek-satir", Deger = f => f.KdvTutar,
                              Hucre = f => @<text>@Bicim.Tl(f.KdvTutar) <span class="metin-soluk">(%@KdvYuzde(f.KdvOran))</span></text> });
            l.Add(new() { Anahtar = "toplam", Baslik = Dil.T.Ortak.Toplam, ZorunluGorunur = true, SunucuSiralamaAdi = FaturaSiraAdi("toplam"),
                          HucreSinif = _ => "hucre-vurgu sayi", Deger = f => f.Toplam,
                          Hucre = f => @<span title="@(Dil.BasitMi ? null : $"{Dil.T.Fatura.AraToplam}: {Bicim.Tl(f.AraToplam)}")">@Bicim.Tl(f.Toplam)</span> });
            l.Add(new() { Anahtar = "durum", Baslik = Dil.T.Fatura.Durum, Tur = IzgaraHucreTuru.Rozet, Deger = f => DurumMetin(f.Durum),
                          Hucre = f => @<text><Rozet Renk="@DurumRenk(f.Durum)">@DurumMetin(f.Durum)</Rozet>@if (f.KalemKaynagi == "KALEM") {<Rozet Renk="mavi">@Dil.T.Fatura.Kalemler</Rozet>}</text> });
            // DoD EK 4 / P-61: DAR SÜTUN — durumun TEK birincil eylemi + "⋯"; id'ler FaturaEylemleri(f) içinde AYNEN.
            l.Add(new() { Anahtar = "eylem", Baslik = Dil.T.Ortak.Eylemler, BaslikGizli = true, ZorunluGorunur = true, Tasinamaz = true,
                          KartEtiketsiz = true, Tur = IzgaraHucreTuru.Eylem, HucreSinif = _ => "q10-yigin-eylem",
                          Hucre = f => @<SatirEylemleri Onek="fk" SatirId="@f.Id" Birincil="1" DarSutun="true"
                                                        SatirAdi="@(string.IsNullOrEmpty(f.FaturaNo) ? f.CariAd : f.FaturaNo)"
                                                        Eylemler="@FaturaEylemleri(f)" /> });
            return l;
        }
    }

    private RenderFragment FaturaNoHucresi(FaturaVeri f) => @<text>@if (string.IsNullOrEmpty(f.FaturaNo))
        {
            <span class="metin-soluk hucre-tek-satir" id="@($"fk-no-yok-{f.Id}")" title="@Dil.T.Fatura.NoKesimde">—</span>
        }
        else
        {
            <span class="hucre-tek-satir" id="@($"fk-no-{f.Id}")">@f.FaturaNo</span>
        }
        @if (!Dil.BasitMi)
        {
            @if (!string.IsNullOrEmpty(f.BankaHareketId))
            {
                <span class="zo-alt-satir metin-mavi" id="@($"fk-kaynak-{f.Id}")" title="@Dil.T.Fatura.Kaynak"><Ikon Ad="@Ikonlar.Banka" /> @Dil.T.Fatura.KaynakBanka</span>
            }
            else if (f.IslemdenGeldi)
            {
                <span class="zo-alt-satir metin-mavi" id="@($"fk-kaynak-{f.Id}")" title="@Dil.T.Fatura.Kaynak"><Ikon Ad="@Ikonlar.Islemler" /> @(f.Tur == "ALIS" ? T1.KaynakAlistan : T1.KaynakSatistan)</span>
            }
            else
            {
                <span class="zo-alt-satir metin-soluk" id="@($"fk-kaynak-{f.Id}")" title="@Dil.T.Fatura.Kaynak"><Ikon Ad="@Ikonlar.GiderPusulalari" /> @Dil.T.Fatura.Manuel</span>
            }
        }</text>;

    private IReadOnlyList<IzgaraKolonu<KalemSatiri>> FormKalemKolonlari =>
    [
        new() { Anahtar = "sira", Baslik = Dil.T.Fatura.Sira, HucreSinif = _ => "sayi", Hucre = k => @<text>@(formKalemler.IndexOf(k) + 1)</text> },
        new() { Anahtar = "urun", Baslik = Dil.T.Fatura.Urun, ZorunluGorunur = true,
                Hucre = k => @<Secici ElemanId="@($"fk-urun-{formKalemler.IndexOf(k)}")" Etiket="@Dil.T.Fatura.Urun"
                                      YerTutucu="@Dil.T.Fatura.Urun" Secenekler="@UrunSecenekleri" Deger="@k.UrunId"
                                      DegerChanged="@(v => UrunSec(formKalemler.IndexOf(k), v))" /> },
        // GOC-A: miktar ortak Gram (K10 — > 0, 3 ondalık, eksi/harf yazılamaz); tutarlar K9a (≥ 0, 2 ondalık).
        new() { Anahtar = "miktar", Baslik = Dil.T.Fatura.Miktar, ZorunluGorunur = true,
                Hucre = k => @<Gram ElemanId="@($"fk-miktar-{formKalemler.IndexOf(k)}")" Etiket="@Dil.T.Fatura.Miktar" Zorunlu="true" Tur="AgirlikTuru.Gram"
                                    Deger="@k.Miktar" DegerChanged="@(v => k.Miktar = v ?? 0m)" /> },
        new() { Anahtar = "fiyat", Baslik = Dil.T.Fatura.BirimFiyat, ZorunluGorunur = true,
                Hucre = k => @<Para ElemanId="@($"fk-fiyat-{formKalemler.IndexOf(k)}")" Etiket="@Dil.T.Fatura.BirimFiyat" Zorunlu="true" ParaBirimi="TRY" Tur="TutarTuru.SifirOlabilir"
                                    Deger="@k.BirimFiyat" DegerChanged="@(v => k.BirimFiyat = v ?? 0m)" /> },
        new() { Anahtar = "iscilik", Baslik = Dil.T.Fatura.Iscilik,
                Hucre = k => @<Para ElemanId="@($"fk-iscilik-{formKalemler.IndexOf(k)}")" Etiket="@Dil.T.Fatura.Iscilik" ParaBirimi="TRY" Tur="TutarTuru.SifirOlabilir"
                                    Deger="@k.Iscilik" DegerChanged="@(v => k.Iscilik = v ?? 0m)" /> },
        new() { Anahtar = "indirim", Baslik = Dil.T.Fatura.Indirim,
                Hucre = k => @<Para ElemanId="@($"fk-indirim-{formKalemler.IndexOf(k)}")" Etiket="@Dil.T.Fatura.Indirim" ParaBirimi="TRY" Tur="TutarTuru.SifirOlabilir"
                                    Deger="@k.Indirim" DegerChanged="@(v => k.Indirim = v ?? 0m)" /> },
        new() { Anahtar = "satir", Baslik = Dil.T.Fatura.SatirToplam, ZorunluGorunur = true, HucreSinif = _ => "hucre-vurgu sayi",
                Hucre = k => @<span id="@($"fk-satir-{formKalemler.IndexOf(k)}")">@Bicim.Tl(SatirToplam(k))</span> },
