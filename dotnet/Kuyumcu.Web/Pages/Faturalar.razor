    /// <summary>
    /// PAKET P-15 (B-25): kayıt seçici bir fiş seçti/temizledi. Seçim
    /// DEĞİŞİNCE önizleme DÜŞER — eski fişin kalemleriyle yeni fişe fatura
    /// kesilmesi mümkün olmamalıdır (UX-S24: bağımlı alanın bağını ekran kurar).
    /// </summary>
    private void FisSecildi(string? fisId)
    {
        fistenFisId = fisId ?? "";
        fistenHareketId = "";
