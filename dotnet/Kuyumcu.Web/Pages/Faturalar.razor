        {
            TurSecenekleri.FirstOrDefault(o => o.Deger == formTur)?.Ad ?? formTur,
            KdvTuruSecenekleri.FirstOrDefault(o => o.Deger == formKdvTuru)?.Ad ?? formKdvTuru,
            KdvSecenekleri.FirstOrDefault(o => o.Deger == formKdv)?.Ad ?? formKdv,
        });

    // ── KDV önizleme ──
    // STANDART → KDV tüm tutara (bugünkü formül, dokunulmadı).
    // KUYUM    → kırılım SUNUCUDAN (`onizleme`) gelir; ekran hesaplamaz.
    private decimal OnizlemeKdvTutar => formToplam - formToplam / (1m + FormKdvOran);
    private decimal OnizlemeAraToplam => formToplam - OnizlemeKdvTutar;

