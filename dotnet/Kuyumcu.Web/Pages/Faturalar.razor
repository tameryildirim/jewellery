    private List<FaturalanabilirIslem> faturalanabilir = [];
    private bool faturalanabilirDahaVar;
    private bool islemlerYukleniyor;
    private string? islemHata;
    private string formHareketId = "";
    private OzelMatrahOnizleme? onizleme;
    private bool onizleniyorMatrah;

    // TOPLU-1 (TARIH-TEK, BELGE-KALAN 01.10): tarih ham UTC basılıyordu (00:00–03:00 TSİ işlemleri bir gün
    // geri) → işletme saatiyle tarih + saat (Bicim.TarihSaat).
    private string IslemEtiketi(FaturalanabilirIslem i) =>
        $"{Bicim.TarihSaat(i.Tarih)} · {(i.Tur == "SATIS" ? Dil.T.Fatura.Satis : Dil.T.Fatura.Alis)} · " +
        $"{i.UrunAd ?? "—"} · {Bicim.Tl(i.TlTutari)}";

    /// <summary>
    /// KUYUM seçilince faturalanabilir işlemler YÜKLENİR. Tembel yükleme
    /// bilinçlidir: standart faturada bu uç hiç çağrılmaz.
    /// </summary>
    private async Task KdvTuruDegisti(string? deger)
    {
        formKdvTuru = deger ?? "STANDART";
        onizleme = null;
        formHareketId = "";
        formHasDeger = 0;
        if (!Kuyum) return;
        await FaturalanabilirYukle();
    }

    private async Task FaturalanabilirYukle()
    {
        islemHata = null;
        islemlerYukleniyor = true;
        try
        {
            var y = await Api.GetAsync<FaturalanabilirYanit>("/faturalar/faturalanabilir-islemler?gun=30&limit=50");
            // Sunucu alanı hiç göndermezse liste NULL gelir; boş liste ≠ null.
            faturalanabilir = y.Islemler ?? [];
            faturalanabilirDahaVar = y.DahaVar;
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            // UX-S28: boş listeye çevrilmez — liste boşaltılır AMA hata bandı çıkar.
            faturalanabilir = [];
            faturalanabilirDahaVar = false;
            islemHata = ex.Message;
        }
        islemlerYukleniyor = false;
    }

    private async Task IslemSec(string? hareketId)
    {
        formHareketId = hareketId ?? "";
        onizleme = null;
        formHasDeger = 0;
        if (string.IsNullOrEmpty(formHareketId)) return;
        await OzelMatrahOnizle();
    }

    /// <summary>
    /// Has bedeli ve matrah SUNUCUDA türetilir; ekran yalnız gösterir (UX-S21).
    /// </summary>
    private async Task OzelMatrahOnizle()
    {
        if (string.IsNullOrEmpty(formHareketId)) return;
        islemHata = null;
        onizleniyorMatrah = true;
        try
        {
            var toplamParam = formToplam > 0
                ? $"&toplam={formToplam.ToString(CultureInfo.InvariantCulture)}"
                : "";
            onizleme = await Api.GetAsync<OzelMatrahOnizleme>(
                $"/faturalar/ozel-matrah-onizleme?hareketId={Uri.EscapeDataString(formHareketId)}" +
                $"&kdvOran={FormKdvOran.ToString(CultureInfo.InvariantCulture)}{toplamParam}");
            formHasDeger = onizleme.HasDeger;
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            onizleme = null;
            islemHata = ex.Message;
        }
        onizleniyorMatrah = false;
    }

