    // TOPLU-1 tur 2 (tasarım hakemi KRİTİK): defter bağlı kalemin adet kilidi GERÇEK kaynağı söyler.
    // Fişli hareket → "satış fişinden gelir · Fişten değiştir" (/islemler); fişsiz tek işlem → "satış
    // (alış) kaydından gelir · İşlem kaydını gör" (işlem defteri). Kilidin kendisi sunucu kuralıdır (400).
    private string AdetKilitMetni(KalemVeri k) =>
        !k.HareketFissiz ? P3.AdetFistenGelir
        : kalemFaturaTuru == "ALIS" ? T1.AdetAlistanGelir : T1.AdetSatistanGelir;
    private static string AdetKilitBagi(KalemVeri k) => k.HareketFissiz ? "/raporlar/islem-defteri" : "/islemler";
    private string AdetKilitBagMetni(KalemVeri k) => k.HareketFissiz ? T1.IslemKaydiniGor : P3.AdetFistenDegistir;

