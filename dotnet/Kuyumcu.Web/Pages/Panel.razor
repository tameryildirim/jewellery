    /// <summary>Klavye yolu (erişilebilirlik): Alt + Yukarı / Alt + Aşağı.</summary>
    private Task KutucukTus(KeyboardEventArgs e, string kod)
    {
        if (!e.AltKey) return Task.CompletedTask;
        var gorunen = GorunenKutucuklar.Select(k => k.Kod).ToList();
        if (e.Key == "ArrowUp") return Tercih.KutucukTasiAsync(gorunen, kod, -1);
        if (e.Key == "ArrowDown") return Tercih.KutucukTasiAsync(gorunen, kod, 1);
        return Task.CompletedTask;
    }

