@page "/"
@using System.Globalization
@using Kuyumcu.Contracts.Sayfalar.Panel
@inject ApiIstemci Api
@inject DilServisi Dil
@inject CanliKurServisi Canli
@inject UyumServisi Uyum
@inject OturumServisi Oturum
@inject RaporServisi Rapor
@inject MenuTercihServisi Tercih
@inject HavaServisi HavaS
@inject IJSRuntime JS
@inject ArayuzModuServisi Mod
@inject IServiceProvider Hizmetler
@using YaslandirmaSz = Kuyumcu.Contracts.Sayfalar.Raporlar
@using VadeSz = Kuyumcu.Contracts.Sayfalar.VadeTakibi
@using BildirimSz = Kuyumcu.Contracts.Sayfalar.Bildirimler
@implements IDisposable

@* ═══════════════════════════════════════════════════════════════════════════
   PAKET P-37b — KARŞILAMA EKRANI ("pencere pencere")

   Kurucu (talimat 20): "ilk sayfa menü olarak pencere pencere olan bir ekran
   karşılamalı, en uygun yerlere hoş geldin kullanıcı ismi olmalı ve havanın
   kaç derece olduğu gibi, kullanıcıyı ekrana kilitleyecek … bir tasarım".

   "EKRANA KİLİTLEYEN" = HİS DEĞİL, DÖRT ÖLÇÜT:
    (1) İLK EKRANDA CEVAP — sabahın beş sorusu kaydırmadan görünür:
        bugün ne sattım (gun-ozeti) · kasada ne var (kasa) · kim borçlu
        (bekleyen) · altın kaç (kur) · bekleyen iş (bekleyen).
    (2) BEKLETME YOK — her kutucuk KENDİ isteğini açar; biri yavaşsa diğerleri
        beklemez. Sayfayı tümden kilitleyen `if (yukleniyor) { <Yukleniyor/> }`
        kapısı KALDIRILDI (denetim.sh: KARSILAMA_TEK_ISTEK_BEKLEME = 0).
        Yüklenirken boş ekran değil İSKELET (.karsilama-iskelet) çizilir.
    (3) CANLI — kur mevcut CanliKurServisi akışından kendiliğinden tazelenir;
        YENİ altyapı KURULMADI.
    (4) TEK TIK — en sık üç işlem (satış, alış, tahsilat) buradan tek tıkla.

   Kutucuklar sürükle-bırakla dizilir ve gizlenebilir; düzen KULLANICI bazında
   saklanır (MenuTercihServisi → /tercihler/benim, kiracı bazında DEĞİL).
   ⚠ Hata "kayıt yok"a çevrilmez (UX-S28): her kutucuğun kendi hata bandı var.
   ═══════════════════════════════════════════════════════════════════════════ *@

@* ═══ P-37c · SAYFA_BASI_MUAFIYETI (YAZILI GEREKÇE, sessiz istisna DEĞİL) ═══
   Karşılama ekranı 46 ekranın TEK'idir ki başlığı SABİT bir ekran adı değil,
   kişiye ve saate göre değişen SELAM'dır ("Günaydın Ramazan") ve yanında hava
   kutucuğu durur. SayfaBasi sözleşmesi iki yuva sunar: Filtreler ve Eylem.
   Hava ne süzgeçtir ne eylem; selam da ekran adı değildir. Bu ekranı SayfaBasi
   kabuğuna sokmak, ya havayı "süzgeç" diye yanlış yuvaya koymayı ya da
   P-37b'de mühürlenen karşılama tasarımını bozmayı gerektirirdi.
   KARAR: Panel.razor araç şeridi kapsamının DIŞINDADIR; karşılama başlığı
   (.karsilama-bas) kendi TEK yerinden (app.css) biçimlenir, ekran başına
   düzen CSS'i burada da YAZILMAZ (SAYFA_BASI_DISI_DUZEN = 0 geçerli).
   Sayaç: SAYFA_BASI_KAPSAM = 45/45 uygun ekran (46 ekran − 1 yazılı muafiyet).
   ═══════════════════════════════════════════════════════════════════════════ *@

@* ═══ PAKET S3-1 — İKİ YÜZ, TEK GÖVDE (PLAN § 5 · tuval Panel.dc.html) ═══════
   BASİT mod = "sabahın beş sorusu": selam + tarih + hava TEK küçük satırda,
   tek birincil düğme "Yeni satış", üç kart (Bugün ne sattım? · Kasada ne
   var? · Altın pozisyonum), altta "Kim borçlu?" (satırda TEK eylem) ve
   "Bekleyen iş". PROFESYONEL mod = P-37b kutucuk ızgarası AYNEN (id'ler,
   düzen modu, sürükle-bırak, kur kaynağı seçici, grafik, son işlemler).
   ⚠ Özellik silinmez: basit yüzde görünmeyen her şey profesyonel yüzde ve
     menüde durur (kur kaynağı → /kur, son işlemler → /raporlar/islem-defteri).
   ⚠ Yetki ≠ mod: basit yüz hiçbir kapıyı atlamaz; 403 "kayıt yok"a
     çevrilmez, "yalnız yönetici görür" notu çizilir (UX-S28).
   ⚠ Panel POST ETMEZ: "Tahsil et / Öde" müşterinin kartını açar
     (/cariler?cariId=…, P-15 derin bağlantısı); para hareketi orada yazılır.
   ═══════════════════════════════════════════════════════════════════════════ *@

<PageTitle>@Marka.SayfaBasligi(Dil.T.Nav.Panel)</PageTitle>

@* ═══ PAKET YILDIZ-4A — "Yıldız" şemasında Bugün TUVALİN KENDİSİDİR (Bugun4/Bugun4a, BİREBİR) ═══
   Selam/hava, kutucuk ızgarası, "Kutucukları düzenle" ve üstteki yasal bantlar bu şemada ÇİZİLMEZ
   (tuvalde yok). Yasal bilgi kaybolmaz: UyumYasalBantlari/NakitSiniriPanelSatiri veriyi yine yükler
   (Gorunmez) ve iş "Seni bekleyen" listesine SATIR olarak düşer; YasalDegisiklikBandi listenin başında
   satır kalıbıyla durur. BASİT ve PROFESYONEL aynı tuval düzenindedir. (Tema temizliği 17.10: tek
   şema Yıldız — eski karşılama + kutucuk ızgarası gövdesi kaldırıldı.) *@
    <GorunumRozeti Degisti="GorunumDegisti" />
    <NakitSiniriPanelSatiri SayiDegisti="@(n => nakitSeritSayisi = n)" Gorunmez="true" />
    <Kuyumcu.Web.Bilesenler.Uyum.UyumYasalBantlari SayiDegisti="@(n => yasalSeritSayisi = n)" OzetDegisti="@(o => yasalOzet = o)" Gorunmez="true" />
    <Kuyumcu.Web.Bilesenler.Yildiz.YildizBugun Veri="@YildizVerisi"><YasalDegisiklikBandi /></Kuyumcu.Web.Bilesenler.Yildiz.YildizBugun>

@code {

    // ── PAKET YILDIZ-4A — Yıldız Bugün verisi ───────────────────────────────────────────────
    // YENİ İSTEK YOK: hepsi bu sayfanın mevcut yükleyicilerinden (ozet, nakit ayrımı, yaşlandırma,
    // vade, bildirim, uyum, stopaj, kâr). Bilinmeyen parça yazılmaz; hata kendi bandında (UX-S28).
    private Kuyumcu.Web.Bilesenler.Yildiz.YildizBugunVerisi YildizVerisi
    {
        get
        {
            string? kasa = null;
            var nakit = false;
            if (!ozetYukleniyor && !ozetYetkiYok && hata is null
                && KasaGruplari.FirstOrDefault(g => g.ParaBirimi == "TRY") is { } tl)
            {
                // PARA-DEMO-2: kasaya yazılmış kart/havale "nakit" diye BASILMAZ — ayrım okunduysa nakit.
                if (PanelTlAyrim is { } ay) { kasa = Bicim.Tl(ay.Nakit); nakit = true; }
                else kasa = Bicim.Tl(tl.Toplam);
            }
            decimal? alacak = null, borc = null;
            // UX-S29: sunucu sınırına değdiyse toplam EKSİK olurdu → cümleye yazılmaz (not satırı söyler).
            if (!borcluYukleniyor && !borcluYetkiYok && borcluHata is null && !borcluDahaFazla)
            {
                var (a, b) = Kuyumcu.Web.Bilesenler.Yildiz.YildizBugunBicim.CariToplamlari(acikHesaplar.Select(c => c.TlBakiye));
                alacak = a;
                borc = b;
            }
            var notlar = new List<(string, string)>();
            if (borcluYetkiYok) notlar.Add(("yildiz-bugun-borclu-yetki", S.YetkiYok));
            if (borcluDahaFazla) notlar.Add(("yildiz-bugun-borclu-sinir", string.Format(S.BorcluSinir, BorcluSinir)));
            if (bildirimDahaFazla) notlar.Add(("yildiz-bugun-bekleyen-sinir", string.Format(S.BekleyenSinir, BildirimSinir)));
            if (SubeDaraltmali) notlar.Add(("yildiz-bugun-kapsam", SKB.KartTumSubelerNotu));
            if (yildizEmanetSinirda) notlar.Add(("yildiz-bugun-emanet-sinir", Kuyumcu.Core.I18n.YildizBugunSozlugu.EmanetSinir(Kuyumcu.Web.Bilesenler.Yildiz.YildizBugunBicim.EmanetOkumaSiniri, Dil.Dil)));   // YILDIZ-4C UX-S29
            return new()
            {
                SatisYukleniyor = ozetYukleniyor,
                SatisYetkiYok = ozetYetkiYok,
                SatisHata = hata,
                SatisTl = SatisGosterTl,
                SatisAdet = SatisAdet,
                KasaTutar = kasa,
                KasaNakit = nakit,
                AlacakTl = alacak,
                BorcTl = borc,
                Bekleyen = YildizBekleyenSatirlari(),
                BekleyenYukleniyor = borcluYukleniyor || bildirimYukleniyor || uyumYukleniyor,
                Notlar = notlar,
                Hatalar =
                [
                    ("yildiz-bugun-borclu-hata", borcluHata), ("yildiz-bugun-vade-hata", vadeHata),
                    ("yildiz-bugun-bekleyen-hata", bildirimHata), ("yildiz-bugun-uyum-hata", uyumHata),
                    ("yildiz-bugun-stopaj-hata", stopajHata), ("yildiz-bugun-kar-hata", karHata),
                    ("yildiz-bugun-kasa-ayrim-hata", panelAyrimHata is null ? null : string.Format(PD2Panel.KasaAyrimHata, panelAyrimHata)),
                    ("yildiz-bugun-gunsonu-hata", yildizGunSonuHata), ("yildiz-bugun-emanet-hata", yildizEmanetHata),   // YILDIZ-4C (UX-S28)
                ],
                KarMetni = YildizKarMetni,
            };
        }
    }

    /// <summary>Alt şerit "Kâr": maliyeti eksik satış/iade varsa ya da eski şekil yanıtta maliyetsiz adet varsa
    /// rakam BASILMAZ ("maliyet eksik" — fail-closed, kart ile AYNI kural); yetki/yanıt yoksa öğe yok.</summary>
    private string? YildizKarMetni =>
        karTl is null && karEksikSatis + karEksikIade > 0 ? Kuyumcu.Core.I18n.YildizBugunSozlugu.MaliyetEksik(Dil.Dil)
        : karTl is decimal && (karEksikSatis + karEksikIade > 0 || (karMaliyetiBilinmeyen > 0 && karDurumu is null))
            ? Kuyumcu.Core.I18n.YildizBugunSozlugu.MaliyetEksik(Dil.Dil)
        : karTl is decimal k ? Bicim.Tl(k) : null;

    /// <summary>
    /// "Seni bekleyen" satırları — Basit yüzün "Kim borçlu?" + "Bekleyen iş" kartlarının VERİSİ, tuvaldeki
    /// tek liste kalıbında: önce kritik işler, sonra müşteri hesapları (en çok 3 — aynı seçim), sonra kalan
    /// işler ve bildirimler. Koşullar BekleyenUyumSatirlari / BekleyenSorusu ile AYNI.
    /// </summary>
    private List<Kuyumcu.Web.Bilesenler.Yildiz.YildizBekleyenSatir> YildizBekleyenSatirlari()
    {
        var kritik = new List<Kuyumcu.Web.Bilesenler.Yildiz.YildizBekleyenSatir>();
        var diger = new List<Kuyumcu.Web.Bilesenler.Yildiz.YildizBekleyenSatir>();
        var ac = Kuyumcu.Core.I18n.YildizBugunSozlugu.Ac(Dil.Dil);
        void Is(string id, string onem, string metin, string rota, string kaynak) =>
            (onem == "KRITIK" ? kritik : diger).Add(new(id, metin, null, kaynak, onem == "KRITIK", ac, rota, PanelSadeSozlugu.Onem(onem, Dil.Dil)));

        // (1) Yasal / nakit sınırı (BekleyenUyumSatirlari ile aynı koşul ve metin).
        if (yasalOzet is { } v && v.AcikTam + v.AcikBenzerlik > 0)
            Is("yasal-eslesme", "KRITIK", string.Format(KR.IsYasalEslesme, v.AcikTam + v.AcikBenzerlik), "/uyum?sekme=risk", T.KaynakUyum);
        if (NakitIsSayisi > 0)
            Is("yasal-nakit", "KRITIK", string.Format(KR.IsNakitSiniri, NakitIsSayisi), "/uyum?sekme=nakit", T.KaynakUyum);
        if (yasalOzet is { ListeEski: true } l)
            Is("yasal-liste-eski", "UYARI", l.ListeYasiGun is { } g ? string.Format(KR.IsYasalListeEski, g) : KR.IsYasalListeYok, "/uyum?sekme=risk", T.KaynakUyum);
        if (yasalOzet is { SaklamaYaklasan: > 0 } sk)
            Is("yasal-saklama", "BILGI", string.Format(KR.IsSaklama, sk.SaklamaYaklasan), "/uyum?sekme=saklama", T.KaynakUyum);

        // (2) Uyum sayaçları (yetkili rol) — "Bekleyen iş" kartıyla aynı.
        if (UyumGorebilir)
        {
            if (masakOzet is { SuresiGecmis: > 0 })
                Is("masak-gecti", "KRITIK", $"{masakOzet.SuresiGecmis} {Dil.T.Panel.MasakSuresiGecti}", "/uyum", T.KaynakUyum);
            if (masakOzet is { Yaklasan: > 0 })
                Is("masak-yaklasan", "UYARI", $"{masakOzet.Yaklasan} {Dil.T.Panel.MasakSuresiYaklasiyor}", "/uyum", T.KaynakUyum);
            if (sureTakip is { YaklasanSayisi: > 0 })
                Is("pusula-yeniden", "UYARI", $"{sureTakip.YaklasanSayisi} {PusulaYenidenMetni}", "/gider-pusulalari", T.KaynakBelge);
            if (sureTakip is { GecikmisSayisi: > 0 })
                Is("pusula", "KRITIK", $"{sureTakip.GecikmisSayisi} {Y4.PanelBelgesiz}", "/gider-pusulalari", T.KaynakBelge);
            foreach (var d in stopajOzet?.Gecikmis ?? [])
                Is($"stopaj-gecti-{d.Donem}", "KRITIK", StopajGectiMetni(d), StopajOdeRota(d.Donem), T.KaynakBelge);
            foreach (var d in stopajOzet?.Yaklasan ?? [])
                Is($"stopaj-yaklasan-{d.Donem}", "UYARI", StopajYaklasanMetni(d), StopajOdeRota(d.Donem), T.KaynakBelge);
            if (riskOzet is { Yuksek: > 0 })
                Is("yuksek-risk", "UYARI", $"{riskOzet.Yuksek} {Dil.T.Panel.YuksekRiskliCari}", "/uyum", T.KaynakUyum);
        }

        // (3) Müşteri hesapları — "Kim borçlu?" ile aynı 3 satır; tutar Bicim.Tl (tuval "−3.840 ₺").
        var cari = new List<Kuyumcu.Web.Bilesenler.Yildiz.YildizBekleyenSatir>();
        if (!borcluYukleniyor && !borcluYetkiYok && borcluHata is null)
        {
            foreach (var c in BorcluSatirlari)
            {
                var tutar = Math.Abs(c.TlBakiye) > 0.01m ? Bicim.Tl(c.TlBakiye) : HasMetni(c.HasGramBakiye);
                var adres = $"/cariler?cariId={Uri.EscapeDataString(c.CariId)}";
                if (BizBorcluyuz(c))
                {
                    cari.Add(new($"cari-{c.CariId}", c.CariAd, Kuyumcu.Core.I18n.YildizBugunSozlugu.BizBorcluyuz(Dil.Dil),
                        tutar, true, S.Ode, adres, TutarMetni(c)));
                }
                else
                {
                    // Tuval: "15 gün" = vadeye kalan gün; geçmişse "N gün geçti"; vade bugün / vadesiz → mevcut metin.
                    var durum = DurumMetni(c);
                    if (vadeler.TryGetValue(c.CariId, out var vd))
                    {
                        if (vd.EnEskiGecikmeGun is int gg and > 0) durum = Kuyumcu.Core.I18n.YildizBugunSozlugu.GunGecti(gg, Dil.Dil);
                        else if (vd.EnYakinVade is DateOnly vade && vade.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber is int kalan and > 0)
                            durum = Kuyumcu.Core.I18n.YildizBugunSozlugu.Gun(kalan, Dil.Dil);
                    }
                    // SUNUM 14.10: "Tahsil et" doğrudan o müşterinin TAHSİLAT penceresini açar (önceden hesap dökümü açılıyordu).
                    cari.Add(new($"cari-{c.CariId}", c.CariAd, tutar, durum, false, S.TahsilEt, adres + "&islem=tahsilat", DurumIpucu(c) ?? TutarMetni(c)));
                }
            }
        }

        // (4) Bildirimler (sunucunun rol süzgecinden geçmiş açık işler).
        foreach (var b in bildirimler)
        {
            var ay = IsAyrintisi(b);
            var rota = IcRota(b.HedefRota);
            diger.Add(new($"is-{b.Id}", b.Baslik, ay is { } a1 ? $"{a1.Ad} · {a1.Tutar}" : null,
                ay?.Durum ?? PanelTuvalSozlugu.Kaynak(b.Tur, Dil.Dil), b.Onem == "KRITIK",
                rota is null ? null : ac, rota, PanelSadeSozlugu.Onem(b.Onem, Dil.Dil)));
        }
        return [.. kritik, .. YildizGunSonuSatiri(), .. cari, .. yildizEmanetSatirlari, .. diger];   // YILDIZ-4C: tuval sırası (gün sonu · cari · emanet)
    }
    // ── Kutucuk gövdeleri ────────────────────────────────────────────────────
    private RenderFragment KutucukGovde(string kod) => kod switch
    {
        PanelKutucuklari.GunOzeti     => GunOzetiGovde,
        PanelKutucuklari.Kur          => KurGovde,
        PanelKutucuklari.Bekleyen     => BekleyenGovde,
        PanelKutucuklari.Kasa         => KasaGovde,
        PanelKutucuklari.SonIslemler  => SonIslemlerGovde,
        PanelKutucuklari.HizliEylem   => HizliEylemGovde,
        _                             => GrafikGovde,
    };

    private RenderFragment GunOzetiGovde => @<div>
        <HataBandi Mesaj="@hata" Id="hata-bandi" />
        @if (ozetYukleniyor)
        {
            <div class="karsilama-iskelet" id="panel-iskelet-gun-ozeti"></div>
        }
        else
        {
            <div class="stat-izgara">
                <StatKart Renk="yesil" Etiket="@Dil.T.Panel.GunlukSatis" Deger="@Bicim.TlKurus(SatisGosterTl)" Alt="@IadeSatiri" />
                <StatKart Etiket="@Dil.T.Panel.GunlukAlis" Deger="@Bicim.TlKurus(AlisTl)" />
                @* PAKET RAPOR-3 (hasım ORTA ×2): "NET HAS GRAM · Paralel defter" günün TÜM has hareketiydi (sayım düzeltmesi,
                   emanet dâhil) — BASİT yüzle çelişiyor, jargon taşıyordu. Kart artık BASİT "Bugün ne sattım"ın has
                   sayısını (net satış, iade düşülmüş — /raporlar/gunluk netSatis) kapsamını söyleyen adla gösterir. *@
                <StatKart Renk="mavi" Etiket="@KR.BugunSatilanAltin" Deger="@Bicim.Has(SatisGosterHas)" />
                <StatKart Renk="@(NetKasaTl >= 0 ? "yesil" : "kirmizi")" Etiket="@Dil.T.Panel.NetKasa"
                          Deger="@Bicim.TlKurus(NetKasaTl)" Alt="@Dil.T.Panel.NetKasaFormul" />
            </div>
            <a class="metin-kucuk" href="/raporlar" id="panel-gun-ozeti-git">@Dil.T.Panel.BugunOzeti →</a>
        }
    </div>;

    private RenderFragment KurGovde => @<div>
        @* PAKET RAPOR-3 (hasım DÜŞÜK): "Kur (24K Altın)" kutucuk başlığında zaten yazılı — gövdede ikinci kez yok. *@
        <p class="karsilama-buyuk-sayi sayi metin-amber" id="panel-kur-deger">
            @(Canli.Son is null ? Dil.T.Panel.Canli : Bicim.TlKurus(Canli.Son.AltinHasFiyati))
        </p>
        <span class="metin-soluk metin-kucuk" id="panel-kur-sorgu">
            @if (Canli.SonSorgu is DateTime sorgu)
            {
                @($"{(Dil.Dil == "tr" ? "Son sorgu" : "Last query")}: {Bicim.IsletmeBicim(sorgu, "HH':'mm':'ss")}")
            }
            else
            {
                @Dil.T.Panel.KurTakip
            }
        </span>
        @* KESIF-P6 tur 2 (YETKİ — 30.09 18:10 ekip oyu): kur kaynağı YALNIZ SAHİP ve
           YALNIZ İşletme'deki onay kalıbıyla, TEK yerde değişir (PATCH /kur/kaynak
           [RolGerekli("SAHIP")]). Panel kartındaki onaysız seçici (#kur-kaynak) kaldırıldı:
           MÜDÜR'e yalnız 403 veren kontrol (DoD EK 1) ve SAHİP'e onaysız ikinci yol kapandı.
           Kaynak adı salt okunur; SAHİP'e İşletme bağlantısı, diğer rollere sebep (UX-S30). *@
        <div class="alan" id="panel-kur-kaynak-alan">
            <span class="metin-soluk metin-kucuk" id="panel-kur-kaynak-etiket">@P6.KaynakEtiket</span>
            <p class="hucre-vurgu" id="panel-kur-kaynak-ad">@SeciliKaynakAdi</p>
            @if (KaynakDegistirebilir)
            {
                <a class="btn btn-ikincil btn-kucuk" id="panel-kur-kaynak-isletme-bag" href="/isletme">@P6.KaynakIsletmeBaglanti</a>
            }
            else
            {
                <span class="metin-kucuk metin-soluk" id="panel-kur-kaynak-yalniz-sahip">@P6.KaynakYalnizSahip</span>
            }
        </div>
        <HataBandi Mesaj="@kaynakHata" />
    </div>;

    private RenderFragment BekleyenGovde => @<div>
        @KiraciGeneliNot("panel-bekleyen-kapsam")
        @if (uyumYukleniyor)
        {
            <div class="karsilama-iskelet" id="panel-iskelet-bekleyen"></div>
        }
        else if (!UyumGorebilir)
        {
            <p class="metin-kucuk metin-soluk" id="panel-bekleyen-rol">@Dil.T.Panel.BekleyenRolKapali</p>
        }
        else if (BekleyenYok)
        {
            @* PAKET RAPOR-3 (hasım YÜKSEK): yasal/nakit işi varken boş durum ÇİZİLMEZ — iş, renkli noktalı satır
               olarak ve ilgili ekrana bağlantıyla burada (Rapor merkezi ile AYNI bileşen). *@
            <BekleyenUyumSatirlari Onek="panel-bekleyen" Yasal="yasalOzet" NakitSayisi="NakitIsSayisi" />
            @if (YasalIsSatiri == 0)
            {
                <BosDurum Mesaj="@Dil.T.Panel.BekleyenYok" />
            }
        }
        else
        {
            <BekleyenUyumSatirlari Onek="panel-bekleyen" Yasal="yasalOzet" NakitSayisi="NakitIsSayisi" />
            <div class="uyari-kutu">
                @if (masakOzet is { SuresiGecmis: > 0 })
                {
                    <p><Ikon Ad="@Ikonlar.Uyari" /> <strong>@masakOzet.SuresiGecmis</strong> @Dil.T.Panel.MasakSuresiGecti
                       <a href="/uyum">@Dil.T.Panel.UyumaGit →</a></p>
                }
                @if (masakOzet is { Yaklasan: > 0 })
                {
                    <p><Ikon Ad="@Ikonlar.Uyari" /> <strong>@masakOzet.Yaklasan</strong> @Dil.T.Panel.MasakSuresiYaklasiyor
                       <a href="/uyum">@Dil.T.Panel.UyumaGit →</a></p>
                }
                @* PAKET YASAL-4 / Y4-A: eski satır 7 günden eski HER pusulayı "süresi DOLDU"
                   sayıyordu (yanlış alarm). Artık yalnız iptal edilip yerine yenisi
                   düzenlenmeyen belge; sayı 0 ise satır yok. *@
                @if (sureTakip is { YaklasanSayisi: > 0 })
                {
                    <p id="panel-pusula-yeniden"><Ikon Ad="@Ikonlar.Uyari" /> <strong>@sureTakip.YaklasanSayisi</strong> @PusulaYenidenMetni
                       <a class="hucre-tek-satir" href="/gider-pusulalari">@Dil.T.Panel.PusulalaraGit →</a></p>
                }
                @if (sureTakip is { GecikmisSayisi: > 0 })
                {
                    <p id="panel-pusula-belgesiz"><Ikon Ad="@Ikonlar.Uyari" /> <strong>@sureTakip.GecikmisSayisi</strong> @Y4.PanelBelgesiz
                       <a class="hucre-tek-satir" href="/gider-pusulalari">@Dil.T.Panel.PusulalaraGit →</a></p>
                }
                @* Y4-B: kalanı olan stopaj dönemi (son gün geçti → KRİTİK; yaklaşıyor → uyarı). *@
                @foreach (var d in stopajOzet?.Gecikmis ?? [])
                {
                    <p id="@($"panel-stopaj-gecti-{d.Donem}")"><Ikon Ad="@Ikonlar.Uyari" /> @StopajGectiMetni(d)
                       <a class="hucre-tek-satir" href="@StopajOdeRota(d.Donem)">@Y4.PanelStopajGit →</a></p>
                }
                @foreach (var d in stopajOzet?.Yaklasan ?? [])
                {
                    <p id="@($"panel-stopaj-yaklasan-{d.Donem}")"><Ikon Ad="@Ikonlar.Uyari" /> @StopajYaklasanMetni(d)
                       <a class="hucre-tek-satir" href="@StopajOdeRota(d.Donem)">@Y4.PanelStopajGit →</a></p>
                }
                @* PAKET 40-A — yüksek riskli cari sayısı. ⚠ UYARIDIR, engel değil.
                   Sayı gösteren yer o kayıtlara giden bağlantıdır (UX-S23). *@
                @if (riskOzet is { Yuksek: > 0 })
                {
                    <p id="panel-yuksek-risk"><Ikon Ad="@Ikonlar.Uyari" /> <strong>@riskOzet.Yuksek</strong> @Dil.T.Panel.YuksekRiskliCari
                       <a href="/uyum">@Dil.T.Panel.UyumaGit →</a></p>
                }
            </div>
        }
        <HataBandi Mesaj="@uyumHata" Id="panel-bekleyen-hata" />
        <HataBandi Mesaj="@stopajHata" Id="panel-stopaj-hata" />
    </div>;

    private RenderFragment KasaGovde => @<div>
        <p class="gorsel-gizli" id="panel-kasa-donem">@Dil.T.Panel.BugunItibariyla</p>@* RAPOR-3 (K17): Panel'de dönem seçici yok — not yalnız ekran okuyucuda *@
        @if (ozetYukleniyor)
        {
            <div class="karsilama-iskelet" id="panel-iskelet-kasa"></div>
        }
        else if (Kasalar.Count == 0)
        {
            <BosDurum Mesaj="@Dil.T.Panel.KasaKaydiYok" />
        }
        else
        {
            @foreach (var k in Kasalar)
            {
                <div class="satir-arasi">
                    <span class="metin-soluk">@k.Ad</span>
                    @* UX-S32: tutar "varsayılan TL" sayılmaz — para birimi Bicim.Para'ya verilir. *@
                    <span class="hucre-vurgu sayi">@Bicim.BelgePara(k.Bakiye, k.ParaBirimi)</span>
                </div>
            }
            <a class="metin-kucuk" href="/kasalar" id="panel-kasa-git">@Dil.T.Panel.KasaOzeti →</a>
        }
        @* Y4-B: kasa bakiyesi DEĞİŞMEZ; kesilen stopaj ayrıca söylenir ki harcanabilir sanılmasın. *@
        @if (StopajBuAyGoster)
        {
            <p class="metin-kucuk metin-soluk" id="panel-kasa-stopaj">@string.Format(Y4.PanelStopajBuAy, Bicim.BelgePara(stopajOzet!.BuAyKesilenTl, "TRY"))</p>
        }
    </div>;

    private RenderFragment SonIslemlerGovde => @<div>
        @if (defterYukleniyor)
        {
            <div class="karsilama-iskelet" id="panel-iskelet-son-islemler"></div>
        }
        else if (sonSatirlar.Count == 0 && defterHata is null)
        {
            <BosDurum Mesaj="@Dil.T.Panel.SonIslemYok" />
        }
        else
        {
            @foreach (var s in sonSatirlar)
            {
                <div class="satir-arasi">
                    <span class="metin-soluk">@Bicim.IsletmeSaati(s.Tarih) @(s.CariAd ?? s.UrunAd ?? "")</span>
                    <span class="hucre-vurgu sayi">@Bicim.BelgePara(s.TlTutari, s.ParaBirimi)</span>
                </div>
            }
            <a class="metin-kucuk" href="/raporlar/islem-defteri" id="panel-defter-git">@Dil.T.Panel.SonIslemler →</a>
        }
        @* UX-S28: hata "kayıt yok"a çevrilmez — bandı ayrı durur. *@
        <HataBandi Mesaj="@defterHata" Id="panel-defter-hata" />
    </div>;

    private RenderFragment HizliEylemGovde => @<div class="karsilama-araclar">
        @* TEK TIK ölçütü: en sık üç işlem buradan tek tıkla başlar. *@
        <a class="btn btn-birincil" id="panel-satis-yap" href="/islemler">@Dil.T.Panel.SatisYap</a>
        <a class="dugme dugme-ikincil" id="panel-alis-yap" href="/islemler">@Dil.T.Panel.AlisYap</a>
        <a class="dugme dugme-ikincil" id="panel-tahsilat" href="/vezne">@Dil.T.Panel.Tahsilat</a>
        <a class="dugme dugme-ikincil" id="panel-hurda" href="/hurda">@Dil.T.Islem.HurdaAlis</a>
    </div>;

    private RenderFragment GrafikGovde => @<div>
        <ProAlan>
            <BasitAlternatif>
                <p class="metin-kucuk metin-soluk" id="panel-basit-notu">@Dil.T.Panel.BasitModNotu</p>
            </BasitAlternatif>
            <ChildContent>
                <HataBandi Mesaj="@grafikHata" Id="panel-grafik-hata" />
                @if (grafikYukleniyor)
                {
                    <div class="karsilama-iskelet" id="panel-iskelet-grafik"></div>
                }
                else
                {
                    <AlanGrafik Noktalar="grafikNoktalari" Aciklama="@Dil.T.Panel.Son7Gun" />
