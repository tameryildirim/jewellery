    // ══ PAKET S3-1 — BASİT YÜZ: SABAHIN BEŞ SORUSU ══════════════════════════
    private PanelSadeMetinleri S => PanelSadeSozlugu.Al(Dil.Dil);

    private RenderFragment SadeGovde => @<div class="panel-sade" id="panel-sade">
        <div class="panel-sade-kartlar">
            @SatisSorusu
            @KasaSorusu
            @* B-2 kapıdan geçti: kart kendi verisini çeker (GET /pozisyon),
               403'ü kendi yetki notuyla söyler. T-P1: Sade = tuvaldeki kısa kart
               (+N g has · Vitrin · Alacak); kalanı kartın "Ayrıntı"sında. *@
            <AltinPozisyonuKarti Sade="true" />
        </div>
        <div class="panel-sade-alt">
            @BorcluSorusu
            @BekleyenSorusu
        </div>
    </div>;

    // (1) Bugün ne sattım?
    private RenderFragment SatisSorusu => @<section class="panel-soru" id="panel-soru-satis" aria-labelledby="panel-soru-satis-baslik">
        <h2 class="panel-soru-baslik" id="panel-soru-satis-baslik">@S.BugunNeSattim</h2>
        @if (ozetYukleniyor)
        {
            <div class="karsilama-iskelet" id="panel-iskelet-soru-satis"></div>
        }
        else if (ozetYetkiYok)
        {
            <p class="metin-soluk" id="panel-soru-satis-yetki">@S.YetkiYok</p>
        }
        else if (hata is not null)
        {
            @* UX-S28: hata "0 ₺"a çevrilmez — sayı çizilmez, bant durur. *@
            <HataBandi Mesaj="@hata" Id="panel-soru-satis-hata" />
        }
        else
        {
            @* UX-S23: sayı, onu oluşturan kayıtlara giden bağlantıdır. *@
            <a class="panel-soru-sayi" id="panel-soru-satis-deger" href="/raporlar/islem-defteri"
               data-deger-boy="@DegerBoyu.Kademe(Bicim.TlKurus(SatisGosterTl))"
               title="@S.SatisBaglantiIpucu">@Bicim.TlKurus(SatisGosterTl)</a>
            <p class="panel-soru-alt" id="panel-soru-satis-alt">
                @* PAKET RAPOR-2 tur 2 (tasarım hakemi KRİTİK): tutar ve has NET'tir (iade düşülmüş,
                   Kâr-zarar "Bugün" ile aynı tanım — /raporlar/gunluk netSatis); iade varsa kapsam satırı. *@
                @if (SatisAdet == 0 && IadeAdet == 0)
                {
                    <span id="panel-soru-satis-yok">@S.SatisYok</span>
                }
                else
                {
                    <span id="panel-soru-satis-adet">@string.Format(S.SatisAdet, SatisAdet)</span>
                    @if (IadeAdet > 0)
                    {
                        <span id="panel-soru-satis-iade">@IadeSatiri</span>
                    }
                    <span id="panel-soru-satis-has">@HasMetni(SatisGosterHas)</span>
                    @* T-P1: "Kâr 4.120 ₺" — sunucunun kâr-zarar ucundan (bugün..bugün).
                       Uç yoksa / yetki yoksa / hata varsa KÂR YAZILMAZ (uydurma yok). *@
                    @* PAKET KAR-RAPOR: sunucu artık maliyeti eksik satışı kâra KATMAZ.
                       Hiçbir satışın maliyeti bilinmiyorsa kâr null gelir → "hesaplanamadı";
                       bir kısmı biliniyorsa kâr (yalnız bilinenlerden) + eksik satış sayısı. *@
                    @* MADEN-2 (hasım ORTA): eksik yalnız iadeden geliyorsa da kâr satırı bunu söyler (karEksikIade). *@
                    @if (karTl is null && karEksikSatis + karEksikIade > 0)
                    {
                        <a class="panel-soru-kar panel-soru-kar--eksik" id="panel-soru-satis-kar"
                           href="/raporlar/kar-zarar" title="@KarIpucu">@KR.PanelKarHesaplanamadi</a>
                    }
                    else if (karTl is decimal kar && karEksikSatis + karEksikIade > 0)
                    {
                        @* PAKET RAPOR-3 (hasım ORTA): "eksik: 12 satış, 1 iade" neyin eksik olduğunu söylemiyordu, kâr günün
                           kârı gibi okunuyordu. Kapsam yazılır: "Kâr 1.082,68 ₺ (yalnız 1 satış) · 12 satışın maliyeti yok". *@
                        <a class="panel-soru-kar panel-soru-kar--eksik" id="panel-soru-satis-kar"
                           href="/raporlar/kar-zarar" title="@KarIpucu">@string.Format(KR.PanelKarKapsam, Bicim.TlKurus(kar), BilinenSatisAdedi, BolunmezMaliyetYok)</a>
                    }
                    else if (karTl is decimal && karMaliyetiBilinmeyen > 0 && karDurumu is null)
                    {
                        @* Eski şekil yanıt (eksik satış alanı yok) ama maliyetsiz adet var: rakam BASILMAZ (fail-closed). *@
                        <a class="panel-soru-kar panel-soru-kar--eksik" id="panel-soru-satis-kar"
                           href="/raporlar/kar-zarar" title="@KarIpucu">@T.KarMaliyetEksik</a>
                    }
                    else if (karTl is decimal kar2)
                    {
                        <a class="panel-soru-kar @(kar2 < 0m ? "panel-soru-kar--eksi" : null)" id="panel-soru-satis-kar"
                           href="/raporlar/kar-zarar" title="@KarIpucu">@T.Kar @Bicim.TlKurus(kar2)</a>
                    }
                }
            </p>
            @* Kâr yalnız ZENGİNLEŞTİRMEDİR: alınamazsa bant durur (UX-S28), satış kalır. *@
            <HataBandi Mesaj="@karHata" Id="panel-soru-satis-kar-hata" />
        }
    </section>;

    // (2) Kasada ne var? — UX-S32: tutar para birimiyle, grup adı etikette.
    private RenderFragment KasaSorusu => @<section class="panel-soru" id="panel-soru-kasa" aria-labelledby="panel-soru-kasa-baslik">
        <h2 class="panel-soru-baslik" id="panel-soru-kasa-baslik">@S.KasadaNeVar</h2>
        @if (ozetYukleniyor || bankaYukleniyor)
        {
            <div class="karsilama-iskelet" id="panel-iskelet-soru-kasa"></div>
        }
        else if (ozetYetkiYok)
        {
            <p class="metin-soluk" id="panel-soru-kasa-yetki">@S.YetkiYok</p>
        }
        else if (hata is not null)
        {
            <HataBandi Mesaj="@hata" Id="panel-soru-kasa-hata" />
        }
        else if (Kasalar.Count == 0 && BankaTl is null)
        {
            <BosDurum Mesaj="@Dil.T.Panel.KasaKaydiYok" />
        }
        else
        {
            @* T-P1 (tuval): büyük sayı = TL nakit + TL banka; alt TEK satır
               "Nakit X ₺ · Banka Y ₺". Farklı para birimleri ASLA toplanmaz
               (UX-S32): döviz kasaları aynı satırda KENDİ biriminde durur. *@
            var gruplar = KasaGruplari;
            var tl = gruplar.FirstOrDefault(g => g.ParaBirimi == "TRY");
            var digerleri = gruplar.Where(g => g.ParaBirimi != "TRY").ToList();
            if (tl is null && BankaTl is null)
            {
                var ana = digerleri[0];
                digerleri.RemoveAt(0);
                <a class="panel-soru-sayi" id="panel-soru-kasa-deger" href="/kasalar"
                   data-deger-boy="@DegerBoyu.Kademe(Bicim.BelgePara(ana.Toplam, ana.ParaBirimi))"
                   title="@S.KasaBaglantiIpucu">@Bicim.BelgePara(ana.Toplam, ana.ParaBirimi)</a>
                <p class="panel-soru-alt" id="panel-soru-kasa-alt">
                    <span id="panel-soru-kasa-grup" title="@KasaKirilimi(ana)">@PanelSadeSozlugu.KasaGrubu(ana.ParaBirimi, Dil.Dil)</span>
                    @DovizGruplari(digerleri)
                </p>
            }
            else
            {
                @* ORTAK-1 (B): data-deger-boy = uzunluk kademesi (css/ortak.css) — 960/1024
                   px'te 7 haneli tutar kartından taşıyordu. *@
                <a class="panel-soru-sayi" id="panel-soru-kasa-deger" href="/kasalar"
                   data-deger-boy="@(DegerBoyu.Kademe(Bicim.BelgePara((tl?.Toplam ?? 0m) + (BankaTl ?? 0m), "TRY")))"
                   title="@S.KasaBaglantiIpucu">@Bicim.BelgePara((tl?.Toplam ?? 0m) + (BankaTl ?? 0m), "TRY")</a>
                <p class="panel-soru-alt" id="panel-soru-kasa-alt">
                    @if (tl is not null)
                    {
                        @* PARA-DEMO-2 tur 5 (doğrulayıcı KRİTİK): kasaya yazılmış kart/havale çekmecede DURMAZ.
                           Alt satır Kasalar ve Rapor merkeziyle AYNI kaynaktan (GET /kasalar/nakit-ayrimi,
                           sunucu KasaNakitAyrimi): "Nakit X · Kart/Havale Y". Ayrım okunamadıysa toplam
                           "Nakit" diye BASILMAZ — kasa grubu adıyla yazılır, kısa hata alt satırda. *@
                        @if (PanelTlAyrim is { } ay)
                        {
                            <a class="panel-soru-alt-oge" id="panel-soru-kasa-grup" href="/kasalar"
                               title="@KasaKirilimi(tl)">@T.Nakit @Bicim.BelgePara(ay.Nakit, "TRY")</a>
                            @if (ay.KartHavale != 0m)
                            {
                                <a class="panel-soru-alt-oge" id="panel-soru-kasa-karthavale" href="/kasalar"
                                   title="@KasaKirilimi(tl)">@PD2Panel.KartHavaleEtiket @Bicim.BelgePara(ay.KartHavale, "TRY")</a>
                            }
                        }
                        else
                        {
                            <a class="panel-soru-alt-oge" id="panel-soru-kasa-grup" href="/kasalar"
                               title="@KasaKirilimi(tl)">@PanelSadeSozlugu.KasaGrubu("TRY", Dil.Dil) @Bicim.BelgePara(tl.Toplam, "TRY")</a>
                        }
                    }
                    @if (BankaTl is decimal banka)
                    {
                        <a class="panel-soru-alt-oge" id="panel-soru-kasa-banka" href="/banka">@T.Banka @Bicim.BelgePara(banka, "TRY")</a>
                        @* ŞUBE-KAPSAM-B tur 2: banka hesapları şubeye bölünmez — şube seçiliyken söylenir. *@
                        @if (SubeDaraltmali)
                        {
                            <span class="panel-soru-alt-oge metin-soluk" id="panel-soru-kasa-banka-kapsam">(@SKB.KartTumSubelerNotu)</span>
                        }
                    }
                    @DovizGruplari(digerleri)
                </p>
            }
            @if (tl is not null && panelAyrimHata is not null)
            {
                <p class="panel-soru-alt metin-kucuk metin-amber" id="panel-soru-kasa-ayrim-hata">@string.Format(PD2Panel.KasaAyrimHata, panelAyrimHata)</p>
            }
            <HataBandi Mesaj="@bankaHata" Id="panel-soru-kasa-banka-hata" />
            @* Y4-B: kesilen stopaj kasadadır ama vergi dairesine aittir (bakiye değişmez). *@
            @if (StopajBuAyGoster)
            {
                <p class="panel-soru-alt metin-soluk" id="panel-soru-kasa-stopaj">@string.Format(Y4.PanelStopajBuAy, Bicim.BelgePara(stopajOzet!.BuAyKesilenTl, "TRY"))</p>
            }
        }
    </section>;

    private RenderFragment DovizGruplari(List<PanelKasaGrubu> gruplar) => @<text>
        @foreach (var g in gruplar)
        {
            <a class="panel-soru-alt-oge" id="@($"panel-soru-kasa-grup-{g.Sira}")" href="/kasalar"
               title="@KasaKirilimi(g)">@PanelSadeSozlugu.KasaGrubu(g.ParaBirimi, Dil.Dil) @Bicim.BelgePara(g.Toplam, g.ParaBirimi)</a>
        }
    </text>;

    // (4) Kim borçlu? — satırda TEK eylem (PLAN § 5 "≤ 3"; taslak: 1).
    private RenderFragment BorcluSorusu => @<section class="panel-soru panel-soru--liste" id="panel-soru-borclu" aria-labelledby="panel-soru-borclu-baslik">
        <header class="panel-soru-bas">
            <h2 class="panel-soru-baslik panel-soru-baslik--liste" id="panel-soru-borclu-baslik">@S.KimBorclu</h2>
            @* T-P1 (tuval): başlıkta yalnız "Tümü". Açık hesap SAYISI silinmedi —
               bağlantının içinde ekran okuyucuya ve üzerine gelince okunur. *@
            <a href="/cariler" id="panel-soru-borclu-tumu" title="@BorcluSayiMetni">
                @S.Tumu
                @if (!borcluYukleniyor && !borcluYetkiYok && borcluHata is null && BorcluSatirlari.Count > 0)
                {
                    <span class="gorsel-gizli" id="panel-soru-borclu-sayi"> · @BorcluSayiMetni</span>
                }
            </a>
        </header>
        @KiraciGeneliNot("panel-soru-borclu-kapsam")
        @if (borcluYukleniyor)
        {
            <div class="karsilama-iskelet" id="panel-iskelet-soru-borclu"></div>
        }
        else if (borcluYetkiYok)
        {
            <p class="metin-soluk" id="panel-soru-borclu-yetki">@S.YetkiYok</p>
        }
        else if (borcluHata is not null)
        {
            <HataBandi Mesaj="@borcluHata" Id="panel-soru-borclu-hata" />
        }
        else if (BorcluSatirlari.Count == 0)
        {
            <BosDurum Mesaj="@S.BorcluYok" />
        }
        else
        {
            <ul class="panel-liste" id="panel-soru-borclu-liste">
                @foreach (var c in BorcluSatirlari)
                {
                    var bizBorclu = BizBorcluyuz(c);
                    <li class="panel-liste-satir" id="@($"panel-borclu-{c.CariId}")">
                        <span class="panel-liste-ad" title="@c.CariAd">@c.CariAd</span>
                        <span class="panel-liste-durum @(VadeGectiMi(c) ? "panel-liste-durum--gecti" : null)"
                              id="@($"panel-borclu-durum-{c.CariId}")" title="@DurumIpucu(c)">@DurumMetni(c)</span>
                        @* TOPLU-4 (KRİTİK): TL ve has AYRI satırda — tek satırlık "24.423,82 ₺ · 12,3 g has"
                           1440'ta eylem düğmesinin arkasına taşıyor, 375'te adı harf harf kırıyordu. *@
                        <span class="panel-liste-tutar @(bizBorclu ? "panel-liste-tutar--eksi" : null)"
                              id="@($"panel-borclu-tutar-{c.CariId}")" title="@TutarMetni(c)">@foreach (var parca in TutarParcalari(c))
                            {<span class="panel-tutar-parca">@parca</span>}</span>
                        @* Panel POST ETMEZ: eylem müşterinin kartını açar, para hareketi orada. *@
                        <a class="dugme dugme-kucuk dugme-ikincil" id="@($"panel-borclu-eylem-{c.CariId}")"
                           href="@($"/cariler?cariId={Uri.EscapeDataString(c.CariId)}{(bizBorclu ? "" : "&islem=tahsilat")}")">@(bizBorclu ? S.Ode : S.TahsilEt)</a>
                    </li>
                }
            </ul>
            @* UX-S29: sunucu sınırı söylenir, sınıra değdiyse "daha fazlası var". *@
            @if (borcluDahaFazla)
            {
                <div class="bant bant-uyari" id="panel-soru-borclu-sinir">@string.Format(S.BorcluSinir, BorcluSinir)</div>
            }
        }
        @* Vade bilgisi yalnız ZENGİNLEŞTİRMEDİR; alınamazsa bant durur, liste kalır. *@
        <HataBandi Mesaj="@vadeHata" Id="panel-soru-borclu-vade-hata" />
    </section>;

    // (5) Bekleyen iş — sunucunun rol süzgecinden geçmiş açık bildirimler
    //     + (yetkili rolde) uyum sayaçları. Sayılar kayıtlara giden bağlantıdır.
    private RenderFragment BekleyenSorusu => @<section class="panel-soru panel-soru--liste" id="panel-soru-bekleyen" aria-labelledby="panel-soru-bekleyen-baslik">
        <header class="panel-soru-bas">
            <h2 class="panel-soru-baslik panel-soru-baslik--liste" id="panel-soru-bekleyen-baslik">@S.BekleyenIs</h2>
            <a href="/bildirimler" id="panel-soru-bekleyen-tumu">@S.Tumu</a>
        </header>
        @KiraciGeneliNot("panel-soru-bekleyen-kapsam")
        @if (bildirimYukleniyor || uyumYukleniyor)
        {
            <div class="karsilama-iskelet" id="panel-iskelet-soru-bekleyen"></div>
        }
        else
        {
            @* PAKET RAPOR-3 (hasım YÜKSEK): yasal bant / nakit sınırı işleri SATIR olarak (tuval: noktalı liste,
               doğrudan ilgili ekrana bağlantı) — "Bekleyen 1 iş üstteki uyarıda" yönlendirmesi ve iş varken boş
               simge kalktı. Rapor merkezi aynı bileşeni çizer. *@
            <BekleyenUyumSatirlari Onek="panel-soru-bekleyen" Yasal="yasalOzet" NakitSayisi="NakitIsSayisi" />
            @if (UyumGorebilir && !BekleyenYok)
            {
                @* T-P1: uyum sayaçları (P-37b kutucuğunun VERİSİ, aynı bağlantılar)
                   tuvaldeki satır biçimiyle — renkli nokta · metin · sağda kaynak.
                   Emoji yok; önem noktanın rengi ve aria-label'ıdır. *@
                <ul class="panel-liste" id="panel-soru-uyum-liste">
                    @if (masakOzet is { SuresiGecmis: > 0 })
                    {
                        @UyumSatiri("panel-uyum-masak-gecti", "KRITIK", masakOzet.SuresiGecmis, Dil.T.Panel.MasakSuresiGecti, "/uyum", T.KaynakUyum)
                    }
                    @if (masakOzet is { Yaklasan: > 0 })
                    {
                        @UyumSatiri("panel-uyum-masak-yaklasan", "UYARI", masakOzet.Yaklasan, Dil.T.Panel.MasakSuresiYaklasiyor, "/uyum", T.KaynakUyum)
                    }
                    @* PAKET YASAL-4 / Y4-A + Y4-B: yalnız gerçek iş (bkz. BekleyenGovde). *@
                    @if (sureTakip is { YaklasanSayisi: > 0 })
                    {
                        @UyumSatiri("panel-uyum-pusula-yeniden", "UYARI", sureTakip.YaklasanSayisi, PusulaYenidenMetni, "/gider-pusulalari", T.KaynakBelge)
                    }
                    @if (sureTakip is { GecikmisSayisi: > 0 })
                    {
                        @UyumSatiri("panel-uyum-pusula", "KRITIK", sureTakip.GecikmisSayisi, Y4.PanelBelgesiz, "/gider-pusulalari", T.KaynakBelge)
                    }
                    @foreach (var d in stopajOzet?.Gecikmis ?? [])
                    {
                        @StopajSatiri($"panel-uyum-stopaj-gecti-{d.Donem}", "KRITIK", StopajGectiMetni(d), d.Donem)
                    }
                    @foreach (var d in stopajOzet?.Yaklasan ?? [])
                    {
                        @StopajSatiri($"panel-uyum-stopaj-yaklasan-{d.Donem}", "UYARI", StopajYaklasanMetni(d), d.Donem)
                    }
                    @if (riskOzet is { Yuksek: > 0 })
                    {
                        @UyumSatiri("panel-yuksek-risk", "UYARI", riskOzet.Yuksek, Dil.T.Panel.YuksekRiskliCari, "/uyum", T.KaynakUyum)
                    }
                </ul>
            }
            @if (bildirimYetkiYok)
            {
                <p class="metin-soluk" id="panel-soru-bekleyen-yetki">@S.YetkiYok</p>
            }
            else if (bildirimler.Count > 0)
            {
                <ul class="panel-liste" id="panel-soru-bekleyen-liste">
                    @foreach (var b in bildirimler)
                    {
                        <li class="panel-liste-satir panel-liste-satir--is" id="@($"panel-is-{b.Id}")">
                            <span class="panel-nokta @NoktaSinifi(b.Onem)" role="img"
                                  aria-label="@PanelSadeSozlugu.Onem(b.Onem, Dil.Dil)"
                                  title="@PanelSadeSozlugu.Onem(b.Onem, Dil.Dil)"></span>
                            @* KIYAS DEVRİ 28.09 (ORTAK-1): aynı başlıklı satırlar ("Vadesi yaklaşan
                               veresiye borcu" ×4) ayırt edilemiyordu. Bildirim bir müşteriye bağlıysa
                               (IlgiliVarlikTuru=Cari) alt satırda o müşterinin adı (kartına bağlantı),
                               tutarı ve gün durumu yazar — veri, aynı panelin zaten yüklediği vade
                               takibi raporundan gelir (yeni istek YOK; rapor yetkisi yoksa satır
                               eskisi gibi yalnız başlıktır → ad, yetkisi olmayana gösterilmez). *@
                            <span class="panel-is-govde">
                                @if (IcRota(b.HedefRota) is { } rota)
                                {
                                    <a class="panel-liste-ad" href="@rota" id="@($"panel-is-git-{b.Id}")">@b.Baslik</a>
                                }
                                else
                                {
                                    <span class="panel-liste-ad">@b.Baslik</span>
                                }
                                @if (IsAyrintisi(b) is { } ay)
                                {
                                    <span class="panel-is-ayrinti" id="@($"panel-is-ayrinti-{b.Id}")">
                                        <a href="@($"/cariler?cariId={Uri.EscapeDataString(ay.CariId)}")"
                                           id="@($"panel-is-cari-{b.Id}")">@ay.Ad</a>
                                        <span class="panel-is-ayrinti-tutar">@ay.Tutar</span>
                                        <span>@ay.Durum</span>
                                    </span>
                                }
                            </span>
                            <span class="panel-is-kaynak" id="@($"panel-is-kaynak-{b.Id}")">@PanelTuvalSozlugu.Kaynak(b.Tur, Dil.Dil)</span>
                        </li>
                    }
                </ul>
                @if (bildirimDahaFazla)
                {
                    <div class="bant bant-uyari" id="panel-soru-bekleyen-sinir">@string.Format(S.BekleyenSinir, BildirimSinir)</div>
                }
            }
            else if (bildirimHata is null && (!UyumGorebilir || BekleyenYok) && uyumHata is null && YasalIsSatiri == 0)
            {
                <BosDurum Mesaj="@S.BekleyenYok" />@* RAPOR-3: boş durum YALNIZ hiç iş yokken (yasal/nakit işi yukarıda satır) *@
            }
            <HataBandi Mesaj="@bildirimHata" Id="panel-soru-bekleyen-hata" />
            @if (!UyumGorebilir || BekleyenYok)
            {
                @* Uyum hatası BekleyenGovde çizilmediğinde de görünür kalır (UX-S28). *@
                <HataBandi Mesaj="@uyumHata" Id="panel-soru-uyum-hata" />
            }
            <HataBandi Mesaj="@stopajHata" Id="panel-soru-stopaj-hata" />
        }
    </section>;

    // ── T-P1 · tuval yardımcıları ────────────────────────────────────────────
    private PanelTuvalMetinleri T => PanelTuvalSozlugu.Al(Dil.Dil);

    /// <summary>"Bekleyen iş" uyum satırı — bildirim satırıyla AYNI biçim (nokta · metin · kaynak).</summary>
    // ── PAKET YASAL-4 ──────────────────────────────────────────────────────
    private Kuyumcu.Core.I18n.Yasal4Metinleri Y4 => Kuyumcu.Core.I18n.Yasal4Sozlugu.Al(Dil.Dil);
    private Kuyumcu.Contracts.Sayfalar.Stopaj.StopajOzeti? stopajOzet;
    private const string StopajRota = "/gider-pusulalari?sekme=stopaj";
    private string? stopajHata;
    private static string GunMetni(DateOnly? g) => g is { } d ? Bicim.Gun(d) : "—";   // TOPLU-1 TARIH-TEK
    private string PusulaYenidenMetni => string.Format(Y4.PanelYenidenDuzenle, GunMetni(sureTakip?.EnYakinSonGun));
    private string DonemAdi(string donem) =>
        DateTime.TryParseExact(donem + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var t)
            ? Bicim.GunBicim(t, "MMMM yyyy", new CultureInfo(Dil.Locale)) : donem;
    private string StopajGectiMetni(Kuyumcu.Contracts.Sayfalar.Stopaj.StopajDonemi d) =>
        string.Format(Y4.PanelStopajGecti, DonemAdi(d.Donem), Bicim.BelgePara(d.KalanTl, "TRY"), GunMetni(d.SonGun));
    private string StopajYaklasanMetni(Kuyumcu.Contracts.Sayfalar.Stopaj.StopajDonemi d) =>
        string.Format(Y4.PanelStopajYaklasan, DonemAdi(d.Donem), Bicim.BelgePara(d.KalanTl, "TRY"), GunMetni(d.SonGun));
    private bool StopajBuAyGoster => UyumGorebilir && stopajOzet is { BuAyKesilenTl: > 0m };

    // § 4.5 (hasım bulgusu 01.10): satırda TEK DOKUNUŞ "Ödendi olarak kaydet" — Panel POST
    // ETMEZ; ödeme çekmecesi o dönem için AÇIK gelir (kasa/tutar orada, sunucu kalanıyla).
    private static string StopajOdeRota(string donem) => $"{StopajRota}&ode={Uri.EscapeDataString(donem)}";

    private RenderFragment StopajSatiri(string id, string onem, string metin, string donem) =>
        @<li class="panel-liste-satir panel-liste-satir--is" id="@id">
            <span class="panel-nokta @NoktaSinifi(onem)" role="img"
                  aria-label="@PanelSadeSozlugu.Onem(onem, Dil.Dil)"
