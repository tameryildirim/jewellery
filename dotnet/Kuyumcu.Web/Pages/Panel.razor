    /// has dili konuşuyordu. Has artık TEK biçimdir: <see cref="Bicim.HasIsaretli"/> (Bicim.Has, N4 binlik,
    /// eksi "−") — Rapor merkezi Bugün kartı ve Altın pozisyonu kartı ile AYNI. Değer YALNIZ ALTINDIR
    /// (sunucu /raporlar/gunluk satis.toplamHas = altinToplamHas, P-69). Kim borçlu has satırı da aynı yardımcı.
    /// </summary>
    // Tur 2: birim sözlükten (TR "has", EN "fine" — eski EN "g fine gold" karşılığı kaybolmasın).
    private string HasMetni(decimal gram) => Bicim.HasIsaretli(gram, KR.HasBirimKisa);

    /// <summary>RAPOR-GORUNUM (tasarım DÜŞÜK): "maliyeti eksik: 9 satış ve 1 iade" dar kartta "iade"yi tek başına
    /// alt satıra düşürüyordu — sayı-birim öbeği bölünmez boşlukla tek parça (satır öbeğin ÖNÜNDEN kırılır).</summary>
    // PAKET RAPOR-2 (tasarım DÜŞÜK): satır hâlâ "maliyeti eksik:" sonrasında kırılıyordu → kısa metin
    // ("Kâr … · eksik: 9 satış, 1 iade"); "eksik:" ile sayı öbeği arasındaki boşluk da bölünmez (sözlük kalıbında U+00A0).
    private string BolunmezEksikSayi => KarRaporSozlugu.EksikSayiKisa(KR, karEksikSatis, karEksikIade).Replace(' ', '\u00A0');
    /// <summary>RAPOR-3: "12 satışın maliyeti yok" — satır içinde bölünmez öbek.</summary>
    private string BolunmezMaliyetYok => KarRaporSozlugu.MaliyetYok(KR, karEksikSatis, karEksikIade).Replace(' ', '\u00A0');
    /// <summary>RAPOR-3: kârın hesaplandığı (maliyeti bilinen) satış sayısı = kâr-zarar satış adedi − maliyeti eksik satış.
    /// Eski şekil yanıt (satisAdedi yok) → günün net satış adedi.</summary>
    private int BilinenSatisAdedi => Math.Max(0, (karSatisAdedi > 0 ? karSatisAdedi : SatisAdet) - karEksikSatis);
    /// <summary>RAPOR-3: "Bekleyen iş" kartında satır olarak çizilen yasal/nakit iş sayısı (BekleyenUyumSatirlari ile aynı sayım).</summary>
    private int YasalIsSatiri => BekleyenUyumSatirlari.SatirSayisi(yasalOzet, NakitIsSayisi);
    /// <summary>
    /// PAKET RAPOR-4 (tasarım DÜŞÜK, tuval): BASİT'te "Yasal liste henüz yüklenmedi" hem üst sarı bantta hem
    /// "Bekleyen iş" satırında çıkıyordu. BASİT'te bant YALNIZ kritik (açık yasal liste eşleşmesi) varken çizilir;
    /// liste eski/yok ve saklama işi Bekleyen iş satırında kalır (aynı özet, ikinci istek yok). PRO değişmedi.
    /// </summary>
    private bool BasitYasalBantGizli => Mod.BasitMi && (yasalOzet is null || yasalOzet.AcikTam + yasalOzet.AcikBenzerlik == 0);

    private int NakitIsSayisi => Math.Max(nakitSeritSayisi, nakitAyrildi);
