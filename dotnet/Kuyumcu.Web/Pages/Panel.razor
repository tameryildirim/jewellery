    private string BorcluSayiMetni => string.Format(S.AcikHesapSayisi, borcluToplamSatir);

    /// <summary>Kasa grubunun kasaları tek tek (üzerine gelince) — ekrandan kasa listesi silinmedi.</summary>
    private string KasaKirilimi(PanelKasaGrubu g) =>
        string.Join(" · ", g.Kasalar.Select(k => $"{k.Ad} {Bicim.BelgePara(k.Bakiye, k.ParaBirimi)}")) + " — " + T.KasaKirilimIpucu;

    // Kâr (bugün..bugün) — GET /raporlar/kar-zarar (SAHIP/MUDUR/MUHASEBE). 403 = yazılmaz.
    private decimal? karTl;
    private int karMaliyetiBilinmeyen;
    private int karEksikSatis;          // PAKET KAR-RAPOR: maliyeti eksik (kâra katılmayan) satış sayısı
    private int karEksikIade;           // MADEN-2: maliyeti eksik (kâra katılmayan) iade sayısı
    // KAR-RAPOR-2: sunucu karDurumu döndürüyorsa (yeni şekil) eski "Kâr: maliyet eksik" dalı KULLANILMAZ —
    // eksik bilgisi MaliyetiEksikSatisAdedi'nden okunur (TAM + yuvarlama artığı adet = çelişki çıkıyordu).
    private string? karDurumu;
    private string? karHata;
    private KarRaporMetinleri KR => KarRaporSozlugu.Al(Dil.Dil);

    // PAKET KAR-RAPOR: "kâr eksik olabilir" artık doğru değil — eksik satış kâra hiç girmez.
    private string KarIpucu => karEksikSatis + karEksikIade > 0
        ? $"{T.KarIpucu}. {(karTl is null ? KR.MaliyetNasilGirilir : KR.KarKismiNotu)}"
        : karMaliyetiBilinmeyen > 0 && karDurumu is null
        ? $"{T.KarIpucu}. {string.Format(T.KarEksikIpucu, karMaliyetiBilinmeyen)}"
        : T.KarIpucu;

    private async Task YukleKar()
    {
        var gun = Bicim.Makine(Bicim.IsletmeBugun);
        string? istenen = null;
        try
        {
            await SubeliSorgu.HazirAsync(Oturum);   // ŞUBE-KAPSAM-B: seçili şube
            istenen = SubeliSorgu.Sube(Oturum);
            var k = await Api.GetAsync<PanelKarOzeti>(SubeliSorgu.Ekle($"/raporlar/kar-zarar?baslangic={gun}&bitis={gun}", Oturum));
            if (Eskidi(istenen)) return;
            karTl = k.KarTl;
            karMaliyetiBilinmeyen = (int)Math.Ceiling(k.MaliyetiBilinmeyenAdet);
            karEksikSatis = k.MaliyetiEksikSatisAdedi;
            karEksikIade = k.MaliyetiEksikIadeAdedi;
            karSatisAdedi = k.SatisAdedi;
            karDurumu = k.KarDurumu;
        }
        // Yetkisiz rol kârı GÖRMEZ: yazı yok, bant yok (yetki notu satış kartında zaten var).
        catch (ApiHata ex) when (ex.StatusCode == 403) { }
        catch (Exception ex) when (YukleHatasi(ex)) { if (Eskidi(istenen)) return; karHata = HataMetni(ex); }
        await InvokeAsync(StateHasChanged);
    }

    // PARA-DEMO-2 tur 5 — "Kasada ne var?" alt satırı: nakit / kart+havale ayrımı (Kasalar ve Rapor merkeziyle
    // aynı uç ve aynı toplama: aynı para birimindeki kasaların Σnakit ve Σ(kart+havale)). Şubeli (kasa özetiyle aynı kapsam).
    private List<Kuyumcu.Contracts.Sayfalar.Kasalar.KasaNakitAyrimiOzeti>? panelAyrim;
    private string? panelAyrimHata;
    private ParaDemo2Metinleri PD2Panel => ParaDemo2Sozlugu.Al(Dil.Dil);
    private (decimal Nakit, decimal KartHavale)? PanelTlAyrim =>
        panelAyrim is null ? null
        : (panelAyrim.Where(a => a.ParaBirimi == "TRY").Sum(a => a.Nakit),
           panelAyrim.Where(a => a.ParaBirimi == "TRY").Sum(a => a.Kart + a.Havale));

    private async Task YukleNakitAyrimi()
    {
        string? istenen = null;
        try
        {
            await SubeliSorgu.HazirAsync(Oturum);
            istenen = SubeliSorgu.Sube(Oturum);
            var y = await Api.GetAsync<List<Kuyumcu.Contracts.Sayfalar.Kasalar.KasaNakitAyrimiOzeti>>(SubeliSorgu.Ekle("/kasalar/nakit-ayrimi", Oturum));
            if (Eskidi(istenen)) return;
            panelAyrim = y ?? [];
        }
        catch (ApiHata ex) when (ex.StatusCode == 403) { _ = ex; }   // kasa yetkisi yok: grup adıyla toplam yazılır
        catch (Exception ex) when (YukleHatasi(ex)) { if (Eskidi(istenen)) return; panelAyrimHata = HataMetni(ex); }
        await InvokeAsync(StateHasChanged);
    }

    // Banka (TL hesaplar) — GET /bankalar ("banka" modülü). 403 = banka bacağı yazılmaz.
    private bool bankaYukleniyor = true;
    private decimal? bankaTl;
    private string? bankaHata;
    private decimal? BankaTl => bankaTl;

    private async Task YukleBanka()
    {
        try
        {
            var y = await Api.GetAsync<Kuyumcu.Contracts.Sayfalar.Banka.HesapYaniti>("/bankalar");
            var tl = (y.Hesaplar ?? []).Where(h => h.Aktif && (h.ParaBirimi ?? "TRY") == "TRY").ToList();
            bankaTl = tl.Count == 0 ? null : tl.Sum(h => h.Bakiye);
        }
        catch (ApiHata ex) when (ex.StatusCode == 403) { }
        catch (Exception ex) when (YukleHatasi(ex)) { bankaHata = HataMetni(ex); }
        bankaYukleniyor = false;
        await InvokeAsync(StateHasChanged);
    }

    private string? DurumIpucu(YaslandirmaSz.YaslananCari c) =>
        !BizBorcluyuz(c) && vadeler.TryGetValue(c.CariId, out var v) && v.EnEskiGecikmeGun is int g and > 0
            ? string.Format(T.VadeGectiIpucu, g) : null;

    // ── Basit yüz verisi ─────────────────────────────────────────────────────
    /// <summary>"Kim borçlu?" listesi için sunucudan istenen sayfa boyu (UX-S29: ekranda yazılır).</summary>
    internal const int BorcluSinir = 500;
    /// <summary>"Bekleyen iş" listesinde gösterilen en çok bildirim.</summary>
    internal const int BildirimSinir = 5;
    /// <summary>Kartta gösterilen en çok borçlu satırı (T-P1 tuval: 3 satır + "Tümü").</summary>
    internal const int BorcluSatirSayisi = 3;

    private bool ozetYetkiYok;
    private bool borcluYukleniyor = true, borcluYetkiYok, borcluDahaFazla;
    private string? borcluHata, vadeHata;
    private int borcluToplamSatir;
    private List<YaslandirmaSz.YaslananCari> acikHesaplar = [];
    private Dictionary<string, VadeSz.CariSatir> vadeler = [];

    private bool bildirimYukleniyor = true, bildirimYetkiYok, bildirimDahaFazla;
    private string? bildirimHata;
    private List<BildirimSz.Satir> bildirimler = []; private int nakitAyrildi, nakitSeritSayisi, yasalSeritSayisi;   /* YASAL-3: uyum bantlarındaki iş */   // YASAL-2 t3: şeride devredilen nakit sınırı bildirimi

    private bool sadeYuklendi, proYuklendi;

    private int SatisAdet => ozet?.Satis?.Adet ?? 0;
    private decimal SatisHas => ozet?.Satis?.ToplamHas ?? 0m;
    // PAKET RAPOR-2 tur 2: "Bugün ne sattım" NET gösterir (Kâr-zarar ile aynı tanım); alan yoksa brüt.
    private NetSatisOzet? NetSatis => ozet?.NetSatis;
    private decimal SatisGosterTl => NetSatis?.ToplamTl ?? SatisTl;
    private decimal SatisGosterHas => NetSatis?.AltinToplamHas ?? SatisHas;
    private int IadeAdet => NetSatis?.IadeAdet ?? 0;
    private string? IadeSatiri => IadeAdet > 0
        ? string.Format(KR.BugunIadeSatiri, IadeAdet, Bicim.TlKurus(NetSatis!.IadeTl)) : null;

    /// <summary>
    /// Kasalar para birimine göre gruplanır; TL önce gelir. Farklı para birimleri
    /// ASLA toplanmaz (UX-S32) — her grup kendi satırında, kendi birimiyle.
    /// </summary>
    private List<PanelKasaGrubu> KasaGruplari =>
    [
        .. Kasalar
            .GroupBy(k => string.IsNullOrEmpty(k.ParaBirimi) ? "TRY" : k.ParaBirimi)
            .OrderBy(g => g.Key == "TRY" ? 0 : 1).ThenBy(g => g.Key, StringComparer.Ordinal)
            .Select((g, i) => new PanelKasaGrubu(i, g.Key, g.Sum(k => k.Bakiye), [.. g])),
    ];

    /// <summary>PAKET RAPOR-2 (RAPOR-GORUNUM açık kalanı, Panel/TOPLU-5): has eşiği görüntü hassasiyetine
    /// hizalı. Bicim.HasIsaretli 4 haneye (AwayFromZero) yuvarlar; |has| &lt; 0,00005 "0,0000 has" yazardı →
    /// böyle bir cari listeye GİRMEZ (eski eşik 0,000001 idi). TL eşiği (0,01) aynı mantıkta zaten kuruştu.</summary>
    public const decimal HasGosterimEsigi = 0.00005m;

    private static bool Alacak(YaslandirmaSz.YaslananCari c) =>
        c.TlBakiye > 0.01m || c.HasGramBakiye >= HasGosterimEsigi;

    private static bool BizBorcluyuz(YaslandirmaSz.YaslananCari c) =>
        !Alacak(c) && (c.TlBakiye < -0.01m || c.HasGramBakiye <= -HasGosterimEsigi);

    /// <summary>
    /// Kartta gösterilecek satırlar: önce bize borçlu olanlar (en büyük TL,
    /// sonra has), sonra bizim borçlu olduklarımız. En çok 3 satır (T-P1); iki yön
    /// de varsa borç yönüne en az 1 satır ayrılır (tuval: 2 "Tahsil et" + 1 "Öde").
    /// </summary>
    private List<YaslandirmaSz.YaslananCari> BorcluSatirlari
    {
        get
        {
            var alacak = acikHesaplar.Where(Alacak)
                .OrderByDescending(c => c.TlBakiye).ThenByDescending(c => c.HasGramBakiye).ToList();
            var borc = acikHesaplar.Where(BizBorcluyuz)
                .OrderBy(c => c.TlBakiye).ThenBy(c => c.HasGramBakiye).ToList();
            var borcPayi = Math.Min(borc.Count, Math.Max(1, BorcluSatirSayisi - alacak.Count));
            var alacakPayi = Math.Min(alacak.Count, BorcluSatirSayisi - borcPayi);
            return [.. alacak.Take(alacakPayi), .. borc.Take(BorcluSatirSayisi - alacakPayi)];
        }
    }

    private bool VadeGectiMi(YaslandirmaSz.YaslananCari c) =>
        !BizBorcluyuz(c) && vadeler.TryGetValue(c.CariId, out var v) && v.EnEskiGecikmeGun is > 0;

    private string DurumMetni(YaslandirmaSz.YaslananCari c)
    {
        if (BizBorcluyuz(c)) return S.BizBorcluyuz;
        if (vadeler.TryGetValue(c.CariId, out var v))
        {
            if (v.EnEskiGecikmeGun is > 0) return T.VadeGectiKisa;   // T-P1: gün sayısı title'da (DurumIpucu)
            if (v.EnYakinVade is DateOnly vade)
            {
                var kalan = vade.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
                return kalan <= 0 ? S.VadeBugun : string.Format(S.GunKaldi, kalan);
            }
        }
        return S.AcikHesap;
    }

    private string TutarMetni(YaslandirmaSz.YaslananCari c) => string.Join(" · ", TutarParcalari(c));

    /// <summary>TOPLU-4: tutarın parçaları (TL · has · döviz) — ekranda her biri kendi satırında.</summary>
    private List<string> TutarParcalari(YaslandirmaSz.YaslananCari c)
    {
        var parcalar = new List<string>();
        if (Math.Abs(c.TlBakiye) > 0.01m) parcalar.Add(Bicim.TlKurus(c.TlBakiye));
        if (Math.Abs(c.HasGramBakiye) >= HasGosterimEsigi) parcalar.Add(HasMetni(c.HasGramBakiye));
        if (c.DovizBakiyesiVar) parcalar.Add(S.DovizDeVar);
        return parcalar;
    }

