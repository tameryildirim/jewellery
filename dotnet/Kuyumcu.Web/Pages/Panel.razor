    private static string NoktaSinifi(string? onem) => onem switch
    {
        "KRITIK" => "panel-nokta--acil",
        "UYARI" => "panel-nokta--dikkat",
        _ => "panel-nokta--bilgi",
    };

    /// <summary>
    /// Bildirim bir müşteriye bağlıysa ve o müşteri vade takibi raporunda varsa alt satırı
    /// kurar; yoksa null (satır eskisi gibi yalnız başlık). Tutar ve gün BUGÜNKÜ durumdan
    /// gelir (bildirim dünkü "yaklaşıyor" olabilir, borç bugün gecikmiş olabilir):
    /// gecikmiş borç varsa gecikmiş tutar + gecikme günü; yoksa açık toplam + vadeye kalan gün.
    /// </summary>
    // (Razor @code içinde yeni kayıt tipi AÇILMAZ — SozlesmeYansima kuralı; adlı demet.)
    private (string CariId, string Ad, string Tutar, string Durum)? IsAyrintisi(BildirimSz.Satir b)
    {
        if (b.IlgiliVarlikTuru != "Cari" || string.IsNullOrEmpty(b.IlgiliVarlikId)) return null;
        if (!vadeler.TryGetValue(b.IlgiliVarlikId, out var v)) return null;
        if (v.GecikenTutar > 0 && v.EnEskiGecikmeGun is int g and > 0)
            return (v.CariId, v.CariAd, Bicim.TlKurus(v.GecikenTutar), string.Format(T.VadeGectiIpucu, g));
        var acik = v.Kalemler.Count > 0 ? v.Kalemler.Sum(k => k.AcikTutar) : v.GecikenTutar + v.YaklasanTutar + v.VadesizTutar;
        string durum = S.AcikHesap;
        if (v.EnYakinVade is DateOnly vade)
        {
            var kalan = vade.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
            durum = kalan <= 0 ? S.VadeBugun : string.Format(S.GunKaldi, kalan);
        }
        return (v.CariId, v.CariAd, Bicim.TlKurus(acik), durum);
    }

    // ── KIYAS DEVRİ 28.09 (ORTAK-1) — yükleyici hata yakalama boşluğu ──────────
    // ApiIstemci ağ hatasını (HttpRequestException) ve zaman aşımını
    // (TaskCanceledException) ApiHata'ya çevirmez; yalnız ApiHata/JsonException
    // yakalanınca istek düşerse "…Yukleniyor = false" satırına hiç gelinmiyor ve
    // kutucuk SONSUZA dek dönüyordu (UX-S28). Bu iki tür de yakalanır, kutucuğun
    // kendi bandına Türkçe bağlantı metni yazılır.
    internal static bool AgHatasi(Exception ex) => ex is HttpRequestException or TaskCanceledException;
    private static bool YukleHatasi(Exception ex) => ex is ApiHata or JsonException || AgHatasi(ex);
    private string HataMetni(Exception ex) => AgHatasi(ex) ? OrtakGorunumSozlugu.Al(Dil.Dil).PanelBaglantiHatasi : ex.Message;

    /// <summary>Yalnız uygulama içi rota bağlantı olur ("/…", "//…" değil).</summary>
    private static string? IcRota(string? rota) =>
        rota is { Length: > 1 } r && r[0] == '/' && r[1] != '/' ? r : rota == "/" ? "/" : null;

    private async Task YukleBorclu()
    {
        try
        {
            var y = await Api.GetAsync<YaslandirmaSz.YaslandirmaYaniti>(
                $"/raporlar/cari-yaslandirma?limit={BorcluSinir}");
            acikHesaplar = y.YaslananCariler ?? [];
            borcluToplamSatir = y.ToplamSatir;
            borcluDahaFazla = y.DahaFazlasiVar;
        }
        catch (ApiHata ex) when (ex.StatusCode == 403) { borcluYetkiYok = true; }
        catch (Exception ex) when (YukleHatasi(ex)) { borcluHata = HataMetni(ex); }
        borcluYukleniyor = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task YukleVade()
    {
        try
        {
            var y = await Api.GetAsync<VadeSz.Yanit>("/raporlar/vade-takibi");
            vadeler = (y.Cariler ?? []).ToDictionary(c => c.CariId);
        }
        // 403'ü borçlu listesi zaten söyler; burada ikinci kez yazılmaz.
        catch (ApiHata ex) when (ex.StatusCode == 403) { }
        catch (Exception ex) when (YukleHatasi(ex)) { vadeHata = HataMetni(ex); }
        await InvokeAsync(StateHasChanged);
    }

    private async Task YukleBildirim()
    {
        try
        {
            var y = await Api.GetAsync<BildirimSz.Yanit>($"/bildirimler?durum=ACIK&limit={BildirimSinir}");
            bildirimler = y.Satirlar.Where(b => b.IlgiliVarlikTuru != "TevsikIhlali").ToList(); nakitAyrildi = y.Satirlar.Count - bildirimler.Count;   // YASAL-2 tur 3: nakit sınırı aşımı TEK kaynaktan — üstteki kırmızı şerit (tevsik/ihlaller); burada ikinci kez sayılmaz
            bildirimDahaFazla = y.DahaFazlasiVar;
        }
        catch (ApiHata ex) when (ex.StatusCode == 403) { bildirimYetkiYok = true; }
        catch (Exception ex) when (YukleHatasi(ex)) { bildirimHata = HataMetni(ex); }
        bildirimYukleniyor = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
