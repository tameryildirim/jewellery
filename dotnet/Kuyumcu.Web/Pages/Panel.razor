    private void YuzeGoreYukle()
    {
        YildizEkYukleBaslat();   // YILDIZ-4C: Bugün'ün iki tuval satırı (dünkü gün sonu · uzun duran emanet) — yalnız Yıldız (Panel.Yildiz.cs)
        // YILDIZ-4A: Yıldız'da BASİT ve PRO aynı tuval yüzünü çizer → sade yükleyiciler iki modda da açılır.
        if (!sadeYuklendi)
        {
            sadeYuklendi = true;
            Yuklemeler.AddRange([YukleBorclu(), YukleVade(), YukleBildirim(), YukleKar(), YukleBanka(), YukleNakitAyrimi()]);
