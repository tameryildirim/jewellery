            <a class="dugme dugme-kucuk dugme-ikincil yasal-eylem" id="@($"{id}-ode")" href="@StopajOdeRota(donem)">@Y4.PanelStopajGit</a>
        </li>;

    private RenderFragment UyumSatiri(string id, string onem, int adet, string metin, string rota, string kaynak) =>
        @<li class="panel-liste-satir panel-liste-satir--is" id="@id">
            <span class="panel-nokta @NoktaSinifi(onem)" role="img"
                  aria-label="@PanelSadeSozlugu.Onem(onem, Dil.Dil)"
                  title="@PanelSadeSozlugu.Onem(onem, Dil.Dil)"></span>
