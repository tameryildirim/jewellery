    // ── BAĞIMSIZ YÜKLEYİCİLER — hiçbiri diğerini BEKLEMEZ ────────────────────
    // (denetim.sh: KARSILAMA_TEK_ISTEK_BEKLEME = 0)
    /// <summary>Testlerin bekleyebilmesi için açılan yükleme görevleri.</summary>
    internal List<Task> Yuklemeler { get; } = [];

    private async Task YukleOzet()
    {
        string? istenen = null;
        try
        {
            await SubeliSorgu.HazirAsync(Oturum);   // ŞUBE-KAPSAM-B: seçili şube
            istenen = SubeliSorgu.Sube(Oturum);
            var y = await Api.GetAsync<GunlukOzet>(SubeliSorgu.Ekle($"/raporlar/gunluk?tarih={Bicim.Makine(Bicim.IsletmeBugun)}", Oturum));
            if (Eskidi(istenen)) return;
            ozet = y;
        }
        catch (ApiHata ex)
        {
            if (Eskidi(istenen)) return;
            hata = ex.Message;
            // S3-1: basit yüz 403'ü "yalnız yönetici görür" notuyla söyler (UX-S28);
            // profesyonel yüz bugünkü gibi hata bandını gösterir.
            ozetYetkiYok = ex.StatusCode == 403;
        }
        catch (Exception ex) when (AgHatasi(ex)) { if (Eskidi(istenen)) return; hata = HataMetni(ex); }
        ozetYukleniyor = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task YukleGrafik()
    {
        string? istenen = null;
        try
        {
            var bugun = DateTime.Today;
            await SubeliSorgu.HazirAsync(Oturum);   // ŞUBE-KAPSAM-B: seçili şube
            istenen = SubeliSorgu.Sube(Oturum);
            var aylik = await Api.GetAsync<AylikYanit>(SubeliSorgu.Ekle($"/raporlar/aylik?yil={bugun.Year}&ay={bugun.Month}", Oturum));
            if (Eskidi(istenen)) return;
            if (aylik?.Gunler is { Count: > 0 } gunler)
            {
                // PAKET RAPOR-3 tur 2 (hasım DÜŞÜK "Son 7 günlük satış ayın tüm günlerini çiziyor"): başlık ne diyorsa
                // o çizilir — SON 7 GÜN. Ayın ilk 6 gününde önceki ayın son günleri de istenir (ay sınırını aşar).
                if (gunler.Count < SonGunSayisi)
                {
                    var once = bugun.AddMonths(-1);
                    var onceki = await Api.GetAsync<AylikYanit>(SubeliSorgu.Ekle($"/raporlar/aylik?yil={once.Year}&ay={once.Month}", Oturum));
                    if (Eskidi(istenen)) return;
                    gunler = [.. onceki?.Gunler ?? [], .. gunler];
                }
                grafikNoktalari = [.. gunler.TakeLast(SonGunSayisi)
                    .Select(g => new GrafikNokta(GunEtiketi(g.Tarih), g.NetSatisTl ?? g.SatisTl))];   // RAPOR-3: kartla aynı NET tanım
                grafikYukleniyor = false;
                await InvokeAsync(StateHasChanged);
                return;
            }
        }
        catch (Exception ex) when (YukleHatasi(ex))
        {
            // UX-S28: "rapor ucu cevap vermedi" ile "bu ay hiç satış olmadı" AYNI
            // grafiğe çizilmez. Dolgu çizilir ki eksenler kaybolmasın, üstünde bant durur.
            if (Eskidi(istenen)) return;
            grafikHata = HataMetni(ex);
        }

        grafikNoktalari = [.. Enumerable.Range(0, 7)
            .Select(i => new GrafikNokta(Bicim.GunBicim(Bicim.IsletmeBugun.AddDays(i - 6), "dd.MM", CultureInfo.CurrentCulture), 0m))];
        grafikYukleniyor = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// YASAL-4 tur 4 (orkestratör 01.10 12:35): tam sayfa yüklemede (F5, doğrudan /) ve oturum
    /// açılışından sonraki ilk Panel'de profil (rol) İLK çizimden SONRA gelir. Eskiden
    /// YukleUyum OnInitialized anında rolü null görüp hiç istek atmıyordu → stopaj KRİTİK
    /// satırı, pusula/MASAK sayaçları ve "bu ay kesilen stopaj" hiç gelmiyor, yerine
    /// "Başka iş yok" çıkıyordu. Artık rol yetkiliyse BİR KEZ yüklenir; oturum var ama
    /// profil henüz yoksa iskelet kalır ("iş yok" DENMEZ) ve OturumServisi.Degisti
    /// geldiğinde yükleme açılır (YasalDegisiklikBandi ile aynı desen).
    /// </summary>
    private bool uyumBasladi;

    private bool ProfilBekleniyor => Oturum.Kullanici is null && Oturum.GirisYapildi;

    private void OturumDegisti() => _ = InvokeAsync(() =>
    {
        if (uyumBasladi) return;
        if (UyumGorebilir)
        {
            uyumYukleniyor = true;
            Yuklemeler.Add(YukleUyum());
        }
        else if (!ProfilBekleniyor)
        {
            uyumYukleniyor = false;
        }
        StateHasChanged();
    });

    private async Task YukleUyum()
    {
        if (!UyumGorebilir)
        {
            // Rol henüz gelmediyse iskelet kalır; yetkisiz rolde (TEZGÂHTAR) istek YOK.
            uyumYukleniyor = ProfilBekleniyor;
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (uyumBasladi) return;
        uyumBasladi = true;
        {
            try
            {
                masakOzet = await Uyum.Ozet();
                sureTakip = await Uyum.SureTakibi();
                riskOzet = await Uyum.RiskOzet();
            }
            // UX-S28 / md.1: hata SESSİZCE yutulmaz, kutucuğun kendi bandına yazılır.
            catch (Exception ex) when (YukleHatasi(ex)) { uyumHata = HataMetni(ex); }
            // Y4-B: stopaj özeti AYRI denenir — okunamazsa kendi bandı (UX-S28), diğer
            // uyum sayaçları etkilenmez; sayılar uydurulmaz.
            try
            {
                var so = await Uyum.StopajOzeti();
                stopajOzet = so with { Gecikmis = so.Gecikmis ?? [], Yaklasan = so.Yaklasan ?? [] };
            }
            catch (Exception ex) when (YukleHatasi(ex)) { stopajHata = HataMetni(ex); }
        }
        uyumYukleniyor = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task YukleDefter()
    {
        string? istenen = null;
        try
        {
            var bugun = DateOnly.FromDateTime(DateTime.Today);
            await SubeliSorgu.HazirAsync(Oturum);   // ŞUBE-KAPSAM-B: seçili şube
            istenen = SubeliSorgu.Sube(Oturum);
            var y = await Rapor.IslemDefteri(bugun, bugun, subeId: istenen, limit: 5);
            if (Eskidi(istenen)) return;
            sonSatirlar = y.Satirlar ?? [];
        }
        catch (Exception ex) when (YukleHatasi(ex)) { if (Eskidi(istenen)) return; defterHata = HataMetni(ex); }
        defterYukleniyor = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task YukleHava()
    {
        // Zaman aşımı ve sessiz düşme HavaServisi'nin içindedir; burada BEKLEME yok.
        hava = await HavaS.GetirAsync();
        if (hava is not null) await InvokeAsync(StateHasChanged);
    }

    private async Task KaynaklariYukle()
    {
        try
        {
            var y = await Api.GetAsync<KaynakYaniti>("/kur/kaynaklar");
            kaynaklar = y.Kaynaklar ?? [];
            seciliKaynak = y.Secili;
            varsayilanKaynak = y.Varsayilan;
        }
        catch (Exception ex) when (YukleHatasi(ex)) { kaynakHata = HataMetni(ex); }
        await InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        Dil.Degisti += Yenile;
        Canli.Degisti += Yenile;      // (3) CANLI: kur kendiliğinden tazelenir
        Tercih.Degisti += Yenile;
        Mod.Degisti += ModDegisti;
        Oturum.Degisti += OturumDegisti;   // YASAL-4 tur 4: rol ilk çizimden sonra gelirse uyum/stopaj yüklenir
        // YILDIZ-4A: şema (Ayarlar › Görünüm ya da geç okunan kullanıcı görünümü) değişince gövde anında geçer.
        kiraciGorunumu = Hizmetler.GetService(typeof(GorunumServisi)) as GorunumServisi;
        benimGorunumu = Hizmetler.GetService(typeof(KullaniciGorunumServisi)) as KullaniciGorunumServisi;
        if (kiraciGorunumu is not null) kiraciGorunumu.Degisti += SemaDegisti;
        if (benimGorunumu is not null) benimGorunumu.Degisti += SemaDegisti;
        _ = Tercih.HazirlaAsync();
        _ = Canli.BaslatAsync();
        // (2) BEKLETME YOK: yükleyiciler PARALEL açılır, hiçbiri await ile zincirlenmez.
        // S3-1: ortak yükleyiciler (iki yüz de kullanır) + yüze özel olanlar.
        Yuklemeler.AddRange([YukleOzet(), YukleUyum(), YukleHava()]);
        YuzeGoreYukle();
    }

    protected override void OnAfterRender(bool ilk)
    {
        // Tema temizliği (17.10): tek şema Yıldız — kutucuk ızgarası ve sürükleme yok (YILDIZ-4A).
        // T-P1 (gerçek tarayıcıda bulundu): tam sayfa yenilemede oturum profili İLK
        // çizimden SONRA gelir → etkin mod PROFESYONEL→BASIT döner ama Mod.Degisti
        // tetiklenmez; basit yüzün yükleyicileri hiç açılmıyor, kartlar iskelette
        // kalıyordu. Çizilen yüzün yükleyicisi açılmadıysa burada (bir kez) açılır.
        if (!sadeYuklendi || (!Mod.BasitMi && !proYuklendi)) YuzeGoreYukle();
    }

    /// <summary>Panel grafiği "Son 7 günlük satış": çizilen gün sayısı başlıkla aynı.</summary>
    private const int SonGunSayisi = 7;

    private static string GunEtiketi(string? tarih) =>
        DateTime.TryParse(tarih, CultureInfo.InvariantCulture, DateTimeStyles.None, out var t)
            ? Bicim.GunBicim(t, "dd.MM", CultureInfo.CurrentCulture)
            : tarih ?? "";

    private void Yenile() => InvokeAsync(StateHasChanged);

    private GorunumServisi? kiraciGorunumu;
    private KullaniciGorunumServisi? benimGorunumu;
    /// <summary>YILDIZ-4A: şema değişti — Yıldız yüzünün yükleyicileri (gerekirse) açılır, gövde yeniden çizilir.</summary>
    private void SemaDegisti() => InvokeAsync(() => { YuzeGoreYukle(); StateHasChanged(); });

    /// <summary>
    /// ŞUBE-KAPSAM-B — görünüm şubesi değişti: şubeli kartlar YENİDEN yüklenir
    /// (paralel; açılmış yüzün yükleyicileri). Kiracı geneli kartlar (borçlu,
    /// vade, banka, bildirim, uyum) şubeye bölünmez — yeniden çekilmez.
    /// </summary>
    // ── ŞUBE-KAPSAM-B tur 2 (doğrulayıcı DÜŞÜK): kiracı geneli kartlar ──────
    // Borçlu müşteriler, vade, bekleyen işler ve banka şubeye BÖLÜNMEZ. Sayfa rozeti
    // "Gösterilen şube: X" derken bu kartlar tüm şubeleri gösterir → kartın kendisi söyler.
    private SubeKapsamBMetinleri SKB => SubeKapsamBSozlugu.Al(Dil.Dil);

    private bool SubeDaraltmali =>
        KabukServisi.Ortak.GorunumIcin(Oturum) is { CokluGorunum: true, SubeId: not null };

    private RenderFragment KiraciGeneliNot(string id) => @<text>
        @if (SubeDaraltmali)
        {
            <p class="panel-soru-alt metin-soluk" id="@id">@SKB.KartTumSubelerNotu</p>
        }
    </text>;

    /// <summary>
    /// ŞUBE-KAPSAM-B tur 2 (yarış): istek atıldıktan sonra seçim değiştiyse yanıt
    /// ESKİDİR — atılır; yeni seçimin yüklemesi (GorunumDegisti) kartı doldurur.
    /// </summary>
    private bool Eskidi(string? istenen) => !string.Equals(SubeliSorgu.Sube(Oturum), istenen, StringComparison.Ordinal);

    private Task GorunumDegisti()
    {
        hata = null;
        ozetYukleniyor = true;
        var yeni = new List<Task> { YukleOzet() };
        if (sadeYuklendi) { karHata = null; panelAyrimHata = null; panelAyrim = null; yeni.Add(YukleKar()); yeni.Add(YukleNakitAyrimi()); }
        if (proYuklendi)
        {
            defterHata = grafikHata = null;
            defterYukleniyor = grafikYukleniyor = true;
            yeni.Add(YukleGrafik());
            yeni.Add(YukleDefter());
        }
        Yuklemeler.AddRange(yeni);
        StateHasChanged();
        return Task.WhenAll(yeni);
    }

    public void Dispose()
    {
        Dil.Degisti -= Yenile;
        Canli.Degisti -= Yenile;
        Tercih.Degisti -= Yenile;
        Mod.Degisti -= ModDegisti;
        Oturum.Degisti -= OturumDegisti;
        if (kiraciGorunumu is not null) kiraciGorunumu.Degisti -= SemaDegisti;
        if (benimGorunumu is not null) benimGorunumu.Degisti -= SemaDegisti;
    }
}
