    public void Dispose() => Dil.Degisti -= Yenile;

    // ── ZO-BELGE 27.09 — satır eylemleri TEK kaynaktan (ortak SatirEylemleri) ──
    private EventCallback EvCb(Func<Task> f) => EventCallback.Factory.Create(this, f);
    private EventCallback EvCb(Action f) => EventCallback.Factory.Create(this, f);

    /// <summary>
    /// Sıra = ekran sırası; ilk eylem satırda, gerisi "⋯" penceresinde. Düzenlenebilir
    /// evrakta birincil iş Düzenle'dir; değilse ilk izinli geçiş öne gelir ve kilitli
    /// Düzenle SEBEBİYLE (title) pencerede kalır (UX-S30).
    /// </summary>
    internal IReadOnlyList<SatirEylemleri.Eylem> EvrakEylemleri(EvrakSatiri e)
    {
        var duzenle = new SatirEylemleri.Eylem($"evrak-duzenle-{e.Id}", Dil.T.Evrak.Duzenle, EvCb(() => DuzenleAc(e)),
                                               kilitli: !e.Duzenlenebilir,
                                               kilitNedeni: e.Duzenlenebilir ? null : Dil.T.Evrak.DegismezYol);
        var gecisler = new List<SatirEylemleri.Eylem>();
        if (e.IzinliGecisler.Contains("TAHSILE_VERILDI"))
            gecisler.Add(new($"evrak-tahsile-ver-{e.Id}", Dil.T.Evrak.TahsileVer, EvCb(() => TahsileVerAc(e))));
        if (e.IzinliGecisler.Contains("PORTFOYDE"))
            gecisler.Add(new($"evrak-portfoye-al-{e.Id}", Dil.T.Evrak.PortfoyeAl, EvCb(() => PortfoyeAl(e))));
        if (e.IzinliGecisler.Contains("TAHSIL_EDILDI"))
            gecisler.Add(new($"evrak-tahsil-{e.Id}", Dil.T.Evrak.TahsilEdildi, EvCb(() => TahsilAc(e))));
        if (e.IzinliGecisler.Contains("KARSILIKSIZ"))
            gecisler.Add(new($"evrak-karsiliksiz-{e.Id}", Dil.T.Evrak.Karsiliksiz, EvCb(() => KarsiliksizAc(e)),
                             ekSinif: "metin-kirmizi"));
        var l = new List<SatirEylemleri.Eylem>();
        if (e.Duzenlenebilir || gecisler.Count == 0) { l.Add(duzenle); l.AddRange(gecisler); }
        else { l.AddRange(gecisler); l.Add(duzenle); }
        return l;
    }
