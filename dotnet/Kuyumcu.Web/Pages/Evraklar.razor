    };

    private string DurumAdi(string durum) => durum switch
    {
        "PORTFOYDE" => Dil.T.Evrak.DurumPortfoyde,
        "TAHSILE_VERILDI" => Dil.T.Evrak.DurumTahsileVerildi,
        "TAHSIL_EDILDI" => Dil.T.Evrak.DurumTahsilEdildi,
        "KARSILIKSIZ" => Dil.T.Evrak.DurumKarsiliksiz,
        "CIRO_EDILDI" => Dil.T.Evrak.DurumCiroEdildi,
        _ => durum,
    };

