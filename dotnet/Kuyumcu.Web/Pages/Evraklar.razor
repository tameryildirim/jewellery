    private IReadOnlyList<SecenekOgesi> KimlikTuruSecenekleri =>
        [new("YERLI", GB.KimlikTuruYerli), new("YABANCI", GB.KimlikTuruYabanci)];
    /// <summary>Tür değişince yazılmış değer temizlenir (TCKN maskesi pasaportu, pasaport maskesi TCKN'yi bozmasın).</summary>
    private void KimlikTuruSecildi(string? v) { fKimlikYabanci = v == "YABANCI"; fBorcluKimlikNo = null; }
    /// <summary>Açık "kimlik no'yu kaldır": işaretlenince yazılmış yeni değer düşer (gövdede ikisi birden olmaz).</summary>
