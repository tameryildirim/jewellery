    /// <summary>UX-S26: düzenleme formu OLUŞTURMA formuyla aynı alan kümesini taşır.</summary>
    private void DuzenleAc(EvrakSatiri e)
    {
        cekmeceEvrakId = e.Id;
        formGonderildi = false;
        fTur = e.EvrakTuru; fEvrakNo = e.EvrakNo; fTutar = e.Tutar; fVade = e.VadeGunu;
        fKaynakCariId = e.KaynakCariId ?? "";
        fBankaAdi = e.BankaAdi; fBankaSube = e.BankaSube; fKesideYeri = e.KesideYeri;
        // PAKET GOC-B tur 2: kimlik değeri ekrana GELMEZ → kutu boş başlar; boş kalırsa PATCH'te alan YOKTUR (korunur).
        fKesideTarihi = e.KesideTarihi; fBorcluAd = e.BorcluAd; fBorcluKimlikNo = null;
        kimlikKayitli = e.BorcluKimlikKayitli; fKimlikYabanci = fKimlikKaldir = false;
        fNotlar = e.Notlar;
        formSurum++;
        formAcik = true;
    }

    private void FormKapat() => formAcik = false;

    // ── PAKET ZO-BELGE ──
    private ZoBelgeMetinleri ZB => ZoBelgeSozlugu.Al(Dil.Dil);
    /// <summary>ZO-BELGE 28.09 (UX-S31): sayfa başlığı MENÜ adıyla AYNI (MenuAdlari tek kaynak);
    /// eski "Çek / Senet Portföyü" menüdeki "Çek ve senet" ile çelişiyordu.</summary>
    private string SayfaAdi => MenuAdlari.Icin(Dil.Dil).CekSenet.Ad;

    /// <summary>Çekmece her açıldığında artar — "Ek bilgiler" katlanırı yeniden doğar.</summary>
    private int formSurum;

    /// <summary>Düzenlenen evrakta isteğe bağlı alanlardan biri doluysa katlanır açık başlar.</summary>
    private bool EkBilgiDolu =>
        new[] { fBankaAdi, fBankaSube, fKesideYeri, fBorcluAd, fBorcluKimlikNo, fNotlar }
            .Any(x => !string.IsNullOrWhiteSpace(x)) || fKesideTarihi is not null || kimlikKayitli;

    /// <summary>Katlanır süzgeçteki seçili değer sayısı (Tümü/Portföyde dışarıda).</summary>
    internal int AktifSuzgecSayisi =>
        // KESIF-P3: durum artık katlanırın DIŞINDA (görünür şeritte) — katlanır yalnız içindekileri sayar.
        (string.IsNullOrEmpty(turSuzgec) ? 0 : 1)
        + (vadeBas is null ? 0 : 1) + (vadeBit is null ? 0 : 1);

    private string SuzgecBasligi
    {
        get
        {
            var adlar = new List<string>();
            if (!string.IsNullOrEmpty(turSuzgec)) adlar.Add(TurAdi(turSuzgec));
            if (vadeBas is not null || vadeBit is not null) adlar.Add(Dil.T.Evrak.VadeGunu);
            return adlar.Count == 0 ? ZB.Suzgec : $"{ZB.Suzgec}: {string.Join(", ", adlar)}";
        }
    }

    private async Task Kaydet()
    {
        formGonderildi = true;
        if (!FormGecerli) return;

        kaydediliyor = true;
        hata = null;
        try
        {
            if (cekmeceEvrakId is null)
            {
                var yanit = await Api.PostAsync<EvrakSonucu>("/evraklar", new
                {
                    evrakTuru = fTur,
                    tutar = fTutar,
                    vadeGunu = Bicim.Makine(fVade!.Value),
                    evrakNo = fEvrakNo,
                    bankaAdi = fBankaAdi,
                    bankaSube = fBankaSube,
                    kesideYeri = fKesideYeri,
                    kesideTarihi = fKesideTarihi is { } kt ? Bicim.Makine(kt) : null,
                    borcluAd = fBorcluAd,
                    borcluKimlikNo = fBorcluKimlikNo,
                    kaynakCariId = fKaynakCariId,
                    kurSnapshotId = kur!.Id,
                    notlar = fNotlar,
                });
                // UX-S27: sunucunun DÖNDÜRDÜĞÜ sonuç banda yazılır.
                BasariYaz($"{Dil.T.Evrak.Kaydedildi} — " +
                    string.Format(Dil.T.Evrak.BakiyeSonrasi, Bicim.Para(yanit?.CariTlBakiye ?? 0m, "TRY")));
            }
            else
            {
                // ⚠ PATCH SÖZLEŞMESİ: yalnız DEĞİŞTİRİLEBİLİR alanlar gönderilir;
                //   gönderilmeyen alan sunucuda KORUNUR (null'lanmaz).
                var govde = new Dictionary<string, object?>
                {
                    ["vadeGunu"] = Bicim.Makine(fVade!.Value),
                    ["evrakNo"] = fEvrakNo,
                    ["bankaAdi"] = fBankaAdi,
                    ["bankaSube"] = fBankaSube,
                    ["kesideYeri"] = fKesideYeri,
                    ["kesideTarihi"] = fKesideTarihi is { } kt2 ? Bicim.Makine(kt2) : null,
                    ["borcluAd"] = fBorcluAd,
                    ["notlar"] = fNotlar,
                };
                // PAKET GOC-B tur 2 (doğrulayıcı KRİTİK — veri kaybı): kimlik YALNIZ kullanıcı yeni değer yazdıysa
                // gövdeye girer; dokunulmadıysa alan HİÇ YOKTUR (kayıtlı kimlik korunur). Silme yalnız AÇIK
                // "Kimlik no'yu kaldır" onayıyla (borcluKimlikSil). Sunucu null'u da "değişmez" sayar (iki kat koruma).
                if (!string.IsNullOrWhiteSpace(fBorcluKimlikNo)) govde["borcluKimlikNo"] = fBorcluKimlikNo.Trim();
                else if (fKimlikKaldir) govde["borcluKimlikSil"] = true;
                var yanit = await Api.PatchAsync<EvrakSonucu>($"/evraklar/{cekmeceEvrakId}", govde);
                // ⚠ Sunucu beklenmedik bir gövde döndürürse NRE ile render ağacı
                //   DÜŞMEZ (QA turu 3 dersi); alan yoksa yerel değere düşülür.
                BasariYaz($"{Dil.T.Evrak.Guncellendi} — {yanit?.Evrak?.EvrakNo ?? fEvrakNo}");
            }
            formAcik = false;
            await Yukle();
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            hata = ex.Message;
        }
        finally
        {
            kaydediliyor = false;
        }
    }

