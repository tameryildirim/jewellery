    /// <summary>ModalPencere her AÇILIŞTA durumu sıfırlar (DoD EK madde 2).</summary>
    private void KarsiliksizSifirla() => karsiliksizGerekce = "";

    private async Task Karsiliksiz()
    {
        // ⚠ 20 karakterden kısa gerekçeyle İSTEK GÖNDERİLMEZ (servis de reddeder).
        if (karsiliksizGerekce.Trim().Length < GerekceAsgari) return;
        await Gonder(
            $"/evraklar/{secilenEvrakId}/karsiliksiz",
            new { aciklama = karsiliksizGerekce.Trim(), kurSnapshotId = kur?.Id },
            () => karsiliksizAcik = false);
    }

    private async Task Gonder(string yol, object govde, Action kapat)
    {
        kaydediliyor = true;
        hata = null;
        try
        {
            var yanit = await Api.PostAsync<EvrakSonucu>(yol, govde);
            kapat();
            BasariYaz($"{DurumAdi(yanit?.Evrak?.Durum ?? "")} — " +
                string.Format(Dil.T.Evrak.BakiyeSonrasi, Bicim.Para(yanit?.CariTlBakiye ?? 0m, "TRY")));
            await Yukle();
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            // YASAL-KAPI-2: sunucu cümlesindeki ham alan anahtarları basılmaz (cümle aynen kalır — md.1).
            hata = ParaMasakKapisi.SadeMetin(ex.Message);
        }
        finally
        {
            kaydediliyor = false;
        }
    }

    private void BasariYaz(string mesaj)
    {
        basari = mesaj;
        basariJetonu++;
    }

    // ⚠ UX-S31: ham veritabanı kodu ekrana BASILMAZ, sözlükten çevrilir.
    private string TurAdi(string tur) => tur switch
    {
        "CEK" => Dil.T.Evrak.Cek,
        "SENET" => Dil.T.Evrak.Senet,
