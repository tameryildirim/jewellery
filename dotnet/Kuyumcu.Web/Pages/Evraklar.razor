@page "/evraklar"
@using System.Text.Json
@using Kuyumcu.Core.Sozlesmeler
@using Kuyumcu.Web.Bilesenler.Grid
@using Kuyumcu.Core.Domain.Girdi
@inject ApiIstemci Api
@inject DilServisi Dil
@inject NavigationManager Nav
@implements IDisposable

@* ═══════════════════════════════════════════════════════════════════════════
   ÇEK / SENET PORTFÖYÜ — paket 29 Faz A.

   ⚠ YANIT TİPLERİ BU DOSYADA TANIMLANMAZ: Kuyumcu.Core.Sozlesmeler'den gelir
     (S-2 / MÜHÜR 5 KOŞUL 3 — Pages içindeki istemci tipi tavanı DOLU). Sunucu
     decimal döndüren her alan orada da decimal'dir.

   ⚠ TEK DÜZENLEME KALIBI (DoD EK, kurul tur 1 madde 2): çok alanlı giriş ve
     düzeltme AYNI Cekmece bileşeninde, AYNI alan kümesiyle (UX-S26).
     ModalPencere YALNIZ yıkıcı onay (karşılıksız) içindir.

   ⚠ HER DÜĞME ya gerçek istek atar ya da disabled + sebep taşır (UX-S30).
   ═══════════════════════════════════════════════════════════════════════════ *@

<PageTitle>@Marka.SayfaBasligi(SayfaAdi)</PageTitle>

@* PAKET YILDIZ-5B: Yıldız şemasında (BASİT + PRO) ekran = tuval Y_Cekvesenet (BİREBİR); özgün ekran (durum/vade süzgeci,
   özet, tahsile ver, karşılıksız, takvim bağlantısı) yalnız "Tüm ayrıntılar"da (data-yz-ozgun). Çekmeceler ORTAK. *@
@if (YildizMi) { <Kuyumcu.Web.Bilesenler.Yildiz.YildizListe B="@YildizBaglami" /> }
@if (YildizOzgunCiz) {
<div data-yz-ozgun="@YildizOzgunIsaret" class="dikey-bosluk zo-belge" id="evrak-sayfa">
    @* ═══ PAKET ZO-BELGE — "ZORUNLU ÖNCE" (kurucu 25.09) ══════════════════════
       Açılış: başlık + açıklama · "Evrak gir" TEK birincil · İKİ hızlı süzgeç
       (Tümü / Portföyde) · KAPALI "Süzgeç" (diğer durumlar, tür, vade aralığı) ·
       TEK özet satırı · tablo. Karşılıksız/tahsil durumları ve düğmeleri
       SİLİNMEDİ (mali kayıt) — yalnız süzgeç arayüzü katlandı. "Değiştirilemez"
       ve ciro notu açılışta değil, evrak DÜZENLEME çekmecesinde (değiştirme
       denenince). "Faz B" iç terimi ekrandan çıktı (göz #8). *@
    @* ZO-BELGE 29.09 devam 9 (tasarım hakemi k3 KRİTİK · K17 "açıklama metni satırı 0"): başlık altındaki
       açıklama satırı kaldırıldı — tuvalde (Profesyonel.png) başlık tek başına durur. *@
    <SayfaBasi Anahtar="evraklar" Baslik="@SayfaAdi">
        @* PAKET CUMA-J (4. tur): durum süzgeçleri filtre yuvasından ÇIKTI — yuvanın
           ortak "etiket üstte, kontrol altta" sütun kuralı düğme metnini kutunun
           dibine itiyordu. Süzgeçler aşağıdaki süzgeç kartında sekme şerididir;
           takvim bağlantısı ve TEK birincil eylem (Yeni) eylem yuvasındadır. *@
        <Eylem>
            <a class="dugme dugme-kucuk dugme-ikincil" id="evrak-takvime-git" href="/evraklar/takvim">@Dil.T.Evrak.TakvimeGit</a>
            <button class="dugme dugme-kucuk dugme-birincil" id="evrak-yeni" @onclick="YeniAc">@Dil.T.Evrak.Yeni</button>
        </Eylem>
    </SayfaBasi>

    @* UX-S28: hata bandı boş duruma ÇEVRİLMEZ; ayrı ve görünür yerdedir. *@
    <HataBandi Mesaj="@hata" />
    <BasariBandi Id="evrak-basari" Mesaj="@basari" Jeton="@basariJetonu" />

    @* ── Hızlı süzgeç: dört durum tek şeritte (tuval "Hepsi · Borçlu" şeridi). ── *@
    <div class="zo-hizli-suzgec">
        <div class="sekmeler-serit" role="group" id="evrak-durum-seridi" aria-label="@Dil.T.Evrak.Durum">
            <button type="button" @onclick='() => DurumSec("")' id="evrak-suzgec-tumu" aria-pressed="@(durumSuzgec == "" ? "true" : "false")"
                    class="@(durumSuzgec == "" ? "sekmeler-sekme secili" : "sekmeler-sekme")">@Dil.T.Evrak.Tumu</button>
            <button type="button" @onclick='() => DurumSec("PORTFOYDE")' id="evrak-suzgec-portfoyde" aria-pressed="@(durumSuzgec == "PORTFOYDE" ? "true" : "false")"
                    class="@(durumSuzgec == "PORTFOYDE" ? "sekmeler-sekme secili" : "sekmeler-sekme")">@Dil.T.Evrak.DurumPortfoyde</button>
            @* KESIF-P3 (TOPLU ZO-BELGE ORTA): aynı türden seçim iki yere bölünmüştü (Tümü/Portföyde
               dışarıda, Tahsile verildi/Karşılıksız Süzgeç katlanırında). Dört durum artık TEK
               grupta, dışarıda. #evrak-durum-diger kimliği yaşar (display: contents — görsel
               kutu açmaz), id'ler AYNI. *@
            <span class="zo-grup-ic" id="evrak-durum-diger" aria-label="@ZB.EvrakDigerDurumlar">
                <button type="button" @onclick='() => DurumSec("TAHSILE_VERILDI")' id="evrak-suzgec-tahsile" aria-pressed="@(durumSuzgec == "TAHSILE_VERILDI" ? "true" : "false")"
                        class="@(durumSuzgec == "TAHSILE_VERILDI" ? "sekmeler-sekme secili" : "sekmeler-sekme")">@Dil.T.Evrak.DurumTahsileVerildi</button>
                <button type="button" @onclick='() => DurumSec("KARSILIKSIZ")' id="evrak-suzgec-karsiliksiz" aria-pressed="@(durumSuzgec == "KARSILIKSIZ" ? "true" : "false")"
                        class="@(durumSuzgec == "KARSILIKSIZ" ? "sekmeler-sekme secili" : "sekmeler-sekme")">@Dil.T.Evrak.DurumKarsiliksiz</button>
            </span>
        </div>
        @* QA turu 5 (YÜKSEK): takvimden gelen derin bağlantı sessizce yok sayılıyordu.
           Süzgeç bağlantıdan geldiyse ROZETLE söylenir ve temizleme yolu verilir —
           katlanırın DIŞINDA (gizli süzgeç sessiz kalmaz). *@
        @if (suzgecBaglantidan)
        {
            <span class="rozet rozet-mavi" id="evrak-suzgec-baglanti">@Dil.T.Evrak.SuzgecUygulandi</span>
            <button class="dugme dugme-kucuk dugme-ikincil" id="evrak-suzgec-temizle" @onclick="VadeSuzgeciTemizle">@Dil.T.Evrak.SuzgeciTemizle</button>
        }
    </div>

    @* ── Süzgeç (KAPALI): tür + vade aralığı (durumlar KESIF-P3'ten beri dışarıda). Seçili süzgeç varsa
          başlıkta adı + sayı rozeti. Id'ler AYNI. ── *@
    @* Takvimden derin bağlantıyla gelindiyse (vadeBas/vadeBit) katlanır AÇIK başlar:
       uygulanan süzgeç kullanıcının önünde durur (QA turu 5 dersi). *@
    <Katlanir Id="evrak-suzgec" Baslik="@SuzgecBasligi" Sayi="@(AktifSuzgecSayisi > 0 ? AktifSuzgecSayisi : null)"
              BaslangictaAcik="@suzgecBaglantidan" Sinif="zo-suzgec">
        <div class="form-grid-3">
            <div class="alan">
                <Secici ElemanId="evrak-tur-suzgec"
                        Etiket="@Dil.T.Evrak.EvrakTuru"
                        Secenekler="@(new List<SecenekOgesi> { new SecenekOgesi("CEK", Dil.T.Evrak.Cek), new SecenekOgesi("SENET", Dil.T.Evrak.Senet) })"
                        @bind-Deger="turSuzgec"
                        @bind-Deger:after="Yukle"
                        BosSecenekMetni="@(Dil.T.Evrak.Tumu)" />
            </div>
            <Tarih ElemanId="evrak-vade-bas" Etiket="@($"{Dil.T.Evrak.VadeGunu} ({Dil.T.Ortak.Baslangic})")"
                   Deger="@vadeBas" DegerChanged="@VadeBasDegisti" />
            <Tarih ElemanId="evrak-vade-bit" Etiket="@($"{Dil.T.Evrak.VadeGunu} ({Dil.T.Ortak.Bitis})")"
                   Deger="@vadeBit" DegerChanged="@VadeBitDegisti" Hata="@VadeAralikHatasi" />
        </div>
    </Katlanir>

    @if (yukleniyor)
    {
        <Yukleniyor />
    }
    else if (liste is { } l)
    {
        @* ZO-BELGE — TEK özet satırı (eski dört kart). Dört toplam da DURUR; sıfırdan
           büyük karşılıksız KIRMIZI, bu hafta vadesi gelen AMBER. UX-S33: süzgeçten
           BAĞIMSIZ oldukları satır sonunda yazılı. *@
        <div class="zo-ozet" id="evrak-ozet">
            <span id="evrak-ozet-portfoy">@Dil.T.Evrak.PortfoydeToplam: <strong class="sayi">@Bicim.Para(l.PortfoydeTutar, "TRY")</strong></span>
            <span class="zo-ozet-ayrac" aria-hidden="true">·</span>
            <span id="evrak-ozet-tahsile">@Dil.T.Evrak.TahsileVerilenToplam: <strong class="sayi">@Bicim.Para(l.TahsileVerilenTutar, "TRY")</strong></span>
            <span class="zo-ozet-ayrac" aria-hidden="true">·</span>
            <span id="evrak-ozet-hafta" class="@(l.BuHaftaVadeliTutar > 0 ? "zo-ozet-amber" : null)">@Dil.T.Evrak.BuHaftaVadeli: <strong class="sayi">@Bicim.Para(l.BuHaftaVadeliTutar, "TRY")</strong></span>
            <span class="zo-ozet-ayrac" aria-hidden="true">·</span>
            <span id="evrak-ozet-karsiliksiz" class="@(l.KarsiliksizTutar > 0 ? "zo-ozet-kirmizi" : null)">@Dil.T.Evrak.KarsiliksizToplam: <strong class="sayi">@Bicim.Para(l.KarsiliksizTutar, "TRY")</strong></span>
            @* 29.09 devam 9 (hakem k3): parantezli teknik alt metin satırda DEĞİL — UX-S33 notu (i) ipucunda. *@
            <details class="zo-ipucu" id="evrak-ozet-ipucu">
                <summary aria-label="@($"{ZB.Ipucu}: {Dil.T.Evrak.PortfoydeToplam}")">i</summary>
                <p>@Dil.T.Evrak.DonemdenBagimsiz.Trim('(', ')', ' ')</p>
            </details>
        </div>

        @* UX-S29: sunucu sınırı SESSİZ kırpılmaz, ekranda yazılır. *@
        @if (l.DahaFazlasiVar)
        {
            <p class="metin-kucuk metin-soluk" id="evrak-sinir-uyarisi">
                @string.Format(Dil.T.Evrak.SinirUyarisi, l.Limit)
            </p>
        }

        @if (l.Kalemler.Count == 0)
        {
            <div class="kart">
                <div class="kart-govde">
                    <BosDurum Mesaj="@Dil.T.Evrak.KayitYok" />
                    <p class="metin-kucuk metin-soluk" id="evrak-bos-aciklama">@Dil.T.Evrak.KayitYokAciklama</p>
                </div>
            </div>
        }
        else
        {
            <div class="kart">
                <p class="metin-kucuk metin-soluk zo-yana-kaydir zo-yigin-var" aria-hidden="true">@ZB.YanaKaydir</p>
                @* PAKET GOC-B — ORTAK IZGARA (grid:evraklar:evrak-liste): sütun sırası, göster/gizle, sıralama, kullanıcıya
                   kalıcı, "Varsayılana dön". Mevcut id/sınıf sözleşmesi korunur: #evrak-tablo (q10-th-tek q10-yigin
                   zo-yigin-dar), data-zo="golge", #evrak-th-tur/-veren/-vade (kısa ad, tam ad title'da), #evrak-satir-{id},
                   gecikmiş/yakında satır rengi. Sunucu sınırına (200) değdiyse sıralama KAPALI (UX-S29, uyarı yukarıda). *@
                <Izgara T="EvrakSatiri" Ekran="evraklar" GridId="evrak-liste" Kolonlar="@EvrakKolonlari"
                        Ogeler="@IzgaraYerelSiralama.Uygula(l.Kalemler, evrakSira, EvrakKolonlari)"
                        SatirId="@(e => $"evrak-satir-{e.Id}")"
                        SatirSinif="@(e => e.Gecikmis ? "satir-kirmizi" : e.YakindaVadeli ? "satir-amber" : null)"
                        TabloId="evrak-tablo" TabloSinif="q10-th-tek q10-yigin zo-yigin-dar" Zo="golge"
                        Baslik="@Dil.T.Evrak.Baslik" YapiskanIlkSutun="false"
                        SiralamaDegisti="@(x => evrakSira = x)" GecerliSiralama="@evrakSira" />
            </div>
        }
    }

</div>
}

@* PAKET GOC-B: ortak girdi bileşenlerinin (Para/Tarih/AdSoyad/TcknVeyaVkn) kural hatası Kaydet kilidine bu kapıdan
   düşer — kilit sebebi alan altı metniyle AYNI (GecersizAlanKapisi.Sebep). *@
<CascadingValue Value="formKapisi" IsFixed="true">
@* ── Giriş / düzeltme çekmecesi — TEK KALIP, AYNI ALAN KÜMESİ (UX-S26) ──── *@
<Cekmece Varlik="evrak" Acik="@formAcik" Baslik="@(cekmeceEvrakId is null ? Dil.T.Evrak.Yeni : Dil.T.Evrak.Duzenle)"
         Kapat="FormKapat" Kaydet="Kaydet" Kaydediliyor="@kaydediliyor"
         KaydetAktif="@FormGecerli" KilitSebebi="@FormKilitSebebi">
    <div class="form-grid-2">
        <div class="alan">
            <Secici ElemanId="evrak-form-tur"
                    Etiket="@Dil.T.Evrak.EvrakTuru"
                    Secenekler="@EvrakTurSecenekleri"
                    @bind-Deger="fTur"
                    Devredisi="@(cekmeceEvrakId is not null)"
                    DevredisiSebebi="@(cekmeceEvrakId is not null ? Dil.T.Evrak.TurDegismez : null)" />
        </div>
        @* PAKET P-65 (B48): kayıtlı evrakın türü kilitli — gerekçe ve DOĞRU düzeltme
           yolu (karşılıksız / giriş hareketini geri alma → yeniden giriş) yazılır.
           Eski "iptal edip yenisini açın" metni sunucuda olmayan bir iptal ucuna işaret ediyordu. *@
        @if (cekmeceEvrakId is not null)
        {
            <DegismezIpucu Varlik="EvrakTuru" Gerekce="@OnayM.EvrakTuruGerekce"
                           AlternatifYol="@Dil.T.Evrak.DegismezYol" />
        }
        <Metin ElemanId="evrak-form-no" Etiket="@Dil.T.Evrak.EvrakNo" Zorunlu="true" EnFazla="@AlanSinirlari.EvrakNo"
               Deger="@fEvrakNo" DegerChanged="@(v => fEvrakNo = v ?? "")"
               Hata="@(formGonderildi && string.IsNullOrWhiteSpace(fEvrakNo) ? Dil.T.Evrak.ZorunluAlan : null)" />
        @if (cekmeceEvrakId is null)
        {
                @* PAKET GOC-B (C satır 87): K9 Pozitif — eksi/0/3. ondalık alan altında Core metniyle (eskiden eksi tutar
                   "zorunlu alan" diyordu); sunucu aynı kural. Boş gönderimde "zorunlu alan" aynen. *@
                <Para ElemanId="evrak-form-tutar" Etiket="@Dil.T.Evrak.Tutar" Zorunlu="true" Tur="TutarTuru.Pozitif" ParaBirimi="TRY"
                      Deger="@(fTutar != 0m ? fTutar : null)" DegerChanged="@(v => fTutar = v ?? 0m)"
                      Hata="@(formGonderildi && fTutar == 0m ? Dil.T.Evrak.ZorunluAlan : null)" />
        }
        else
        {
                @* Defter satırı doğurdu — düzeltilemez, sebebi yazılı (UX-S25). *@
                <SaltOkunur ElemanId="evrak-form-tutar-salt" Etiket="@Dil.T.Evrak.Tutar"
                            Deger="@Bicim.Para(fTutar, "TRY")"
                            MakineDeger="@Bicim.Makine(fTutar)"
                            BosMetin="@Dil.T.Ortak.DegerYok"
                            Ipucu="@Dil.T.Evrak.DegismezGerekce" />
                <span class="metin-kucuk metin-soluk" id="evrak-form-tutar-degismez">@Dil.T.Evrak.DegismezGerekce</span>
        }
        @* PAKET GOC-B (C satır 41, K8c): vade bugün ya da sonrası, en çok 10 yıl (9999 yılı yazılamaz) — sunucu aynı.
           Düzenlemede kayıtlı geçmiş vade (portföyde gecikmiş evrak) açılışta kırmızı çizilmesin diye alt sınır yalnız yeni kayıtta. *@
        <Tarih ElemanId="evrak-form-vade" Etiket="@Dil.T.Evrak.VadeGunu" Zorunlu="true"
               Tur="@(cekmeceEvrakId is null ? TarihTuru.Vade : TarihTuru.Serbest)"
               EnGec="@(cekmeceEvrakId is null ? null : DateOnly.FromDateTime(Bicim.IsletmeBugun).AddYears(TarihPenceresi.VadeEnCokYil))"
               @bind-Deger="fVade"
               Hata="@(formGonderildi && fVade is null ? Dil.T.Evrak.ZorunluAlan : null)" />
        @* ZO-BELGE (tasarım hakemi t3, K18): iki etiket ("Evrakı veren müşteri" + "Müşteriler")
           ve yarım genişlik seçici vardı → TEK etiket (Secici'nin kendi etiketi), zorunlu
           işareti, satırın tamamı (zo-tam-satir). Düzenlemede salt okunur satır aynen. *@
        <div class="alan zo-tam-satir">
            @if (cekmeceEvrakId is null)
            {
                <Secici ElemanId="evrak-form-cari"
                        Etiket="@Dil.T.Evrak.KaynakCari" Zorunlu="true"
                        YerTutucu="@Dil.T.Cari.CariSecin"
                        Secenekler="@CariSecenekleri"
                        @bind-Deger="fKaynakCariId" />
                @if (formGonderildi && string.IsNullOrWhiteSpace(fKaynakCariId))
                {
                    <span class="alan-hata" id="evrak-form-cari-hata">@Dil.T.Evrak.ZorunluAlan</span>
                }
            }
            else
            {
                <label for="evrak-form-cari-salt">@Dil.T.Evrak.KaynakCari</label>
                <p class="girdi-salt" id="evrak-form-cari-salt">@(cariler.FirstOrDefault(x => x.Id == fKaynakCariId).Ad ?? "—")</p>
            }
        </div>
    </div>
    @* ZO-BELGE — "Ek bilgiler": 6 isteğe bağlı alan (+ PRO'da borçlu kimlik no)
       KAPALI katlanırda; hiçbiri zorunlu değil, eklenmese kayıp yok (kurucu 25.09).
       Düzenlemede alanlardan biri DOLUYSA açık başlar (dolu veri gizlenmez).
       @key: çekmece her açılışta yeni katlanır — önceki açık/kapalı durum taşınmaz. *@
    <Katlanir @key="@($"evrak-ek-{cekmeceEvrakId}-{formSurum}")" Id="evrak-form-ek" Baslik="@ZB.EvrakEkBilgiler"
              BaslangictaAcik="@EkBilgiDolu" Sinif="zo-form-ek">
        <div class="form-grid-2">
            <Metin ElemanId="evrak-form-banka" Etiket="@Dil.T.Evrak.BankaAdi" EnFazla="@AlanSinirlari.EvrakBanka"
                   @bind-Deger="fBankaAdi" />
            <Metin ElemanId="evrak-form-banka-sube" Etiket="@Dil.T.Evrak.BankaSube" EnFazla="@AlanSinirlari.EvrakBanka"
                   @bind-Deger="fBankaSube" />
            <Metin ElemanId="evrak-form-keside-yeri" Etiket="@Dil.T.Evrak.KesideYeri" EnFazla="@AlanSinirlari.EvrakBanka"
                   @bind-Deger="fKesideYeri" />
            @* PAKET GOC-B (C satır 40): keşide ≤ vade (vadeden sonra keşide edilmiş evrak olmaz) + yıl penceresi —
               sunucu EvrakServisi.TarihleriDenetle aynı kural/metin. İleri tarihli keşide TEYİTSİZ → serbest. *@
            <Tarih ElemanId="evrak-form-keside-tarihi" Etiket="@Dil.T.Evrak.KesideTarihi" Tur="TarihTuru.Keside" EnGec="@fVade"
                   @bind-Deger="fKesideTarihi" />
            @* PAKET GOC-B (C satır 42, K19): borçlu adı en az 2 karakter ve bir harf. *@
            <AdSoyad ElemanId="evrak-form-borclu-ad" Etiket="@Dil.T.Evrak.BorcluAd" EnFazla="@AlanSinirlari.EvrakBorcluAd"
                     Deger="@fBorcluAd" DegerChanged="@(v => fBorcluAd = v)" />
            <ProAlan>
                @* PAKET GOC-B tur 2 (doğrulayıcı DÜŞÜK): borçlu YABANCI olabilir → kimlik türü radyosu; yerli = TcknVeyaVkn
                   (K4/K5), yabancı = Pasaport (K7). Sunucu KimlikKurali.TcknVknVeyaPasaport ile AYNI kural; id aynı. *@
                @* Gerçek Chrome ölçümü (PRO 1280, K3): çekmecenin iki sütununda radyo etiketleri iki satıra kırılıyordu → tam satır. *@
                <div class="zo-tam-satir">
                    <Secim ElemanId="evrak-form-borclu-kimlik-turu" Etiket="@GB.KimlikTuru" Secenekler="@KimlikTuruSecenekleri"
                           Devredisi="@fKimlikKaldir" Deger="@(fKimlikYabanci ? "YABANCI" : "YERLI")"
                           DegerChanged="KimlikTuruSecildi" />
                </div>
                @* PAKET GOC-B tur 2 (doğrulayıcı KRİTİK — veri kaybı): kayıtlı kimlik no şifreli, ekrana GELMEZ. Kutu boş
                   bırakılırsa kimlik DEĞİŞMEZ (PATCH gövdesinde alan YOK); silmek yalnız aşağıdaki AÇIK onay kutusuyla. *@
                @if (fKimlikYabanci)
                {
                    <Pasaport ElemanId="evrak-form-borclu-kimlik" Etiket="@GB.BorcluPasaportNo" Devredisi="@fKimlikKaldir"
                              DevredisiSebebi="@GB.KimlikKaldirilacak"
                              Deger="@fBorcluKimlikNo" DegerChanged="@(v => fBorcluKimlikNo = v)" Ipucu="@KimlikIpucu"
                              HataKimligi="evrak-form-borclu-kimlik-hata" />
                }
                else
                {
                    @* PAKET GOC-B (envanter F1): genel Metin → TcknVeyaVkn (rakam dışı yazılamaz; 10/11 hane dolunca algoritma). *@
                    <TcknVeyaVkn ElemanId="evrak-form-borclu-kimlik" Etiket="@Dil.T.Evrak.BorcluKimlikNo" Devredisi="@fKimlikKaldir"
                                 DevredisiSebebi="@GB.KimlikKaldirilacak"
                                 Deger="@fBorcluKimlikNo" DegerChanged="@(v => fBorcluKimlikNo = v)" Ipucu="@KimlikIpucu"
                                 Hata="@BorcluTcknHata" HataKimligi="evrak-form-borclu-kimlik-hata" />
                }
                @if (cekmeceEvrakId is not null && kimlikKayitli)
                {
                    <Onay ElemanId="evrak-form-borclu-kimlik-kaldir" Etiket="@GB.KimlikKaldir"
                          Deger="@fKimlikKaldir" DegerChanged="KimlikKaldirSecildi" />
                }
            </ProAlan>
            @* PAKET GOC-B (C satır 128): 500 karakterlik not tek satır Metin'deydi → CokSatir. *@
            @* Gerçek Chrome ölçümü (1280 BASİT, K7): iki satırlık not kutusu yanındaki tek satırlık kutuyla 22 px kayıyordu → tam satır. *@
            <div class="zo-tam-satir">
                <CokSatir ElemanId="evrak-form-notlar" Etiket="@Dil.T.Evrak.Notlar" EnFazla="@AlanSinirlari.EvrakNot" Satir="2"
                          Deger="@fNotlar" DegerChanged="@(v => fNotlar = v)" />
            </div>
        </div>
    </Katlanir>
    @if (cekmeceEvrakId is not null)
    {
        @* UX-S25: değişmez alanların gerekçesi ve DOĞRU düzeltme yolu — değiştirme
           denenince (düzenleme çekmecesi). id AYNI: degismez-ipucu-KiymetliEvrakTutar. *@
        <DegismezIpucu Varlik="KiymetliEvrakTutar"
                       Gerekce="@Dil.T.Evrak.DegismezGerekce"
                       AlternatifYol="@Dil.T.Evrak.DegismezYol" />
        @* Ciro bu sürümde YOK — düğme ÇİZİLMEZ, sebebi sade dille yazılır (göz #8:
           "Faz B" iç terimi ekrandan çıktı). id AYNI. *@
        <p class="metin-kucuk metin-soluk" id="evrak-ciro-devredildi">@ZB.EvrakCiroNotu</p>
    }
    @if (kurYok)
    {
        <p class="alan-hata" id="evrak-form-kur-yok">@Dil.T.Evrak.KurYok</p>
    }
</Cekmece>
</CascadingValue>

@* ── Tahsile ver çekmecesi ──────────────────────────────────────────────── *@
<Cekmece Varlik="evrak-tahsile" Acik="@tahsileAcik" Baslik="@Dil.T.Evrak.TahsileVer"
         Kapat="() => tahsileAcik = false" Kaydet="TahsileVer" Kaydediliyor="@kaydediliyor"
         KaydetAktif="@(!string.IsNullOrEmpty(secilenBankaHesapId))"
         KilitSebebi="@Dil.T.Evrak.BankaSecilmedi">
    <div class="alan">
        <Secici ElemanId="evrak-tahsile-hesap"
                Etiket="@Dil.T.Evrak.BankaHesabi"
                Secenekler="@(hesaplar.Select(h => new SecenekOgesi(h.Id, h.Ad)).ToList())"
                @bind-Deger="secilenBankaHesapId"
                BosSecenekMetni="—" />
    </div>
</Cekmece>

@* ── Tahsil edildi çekmecesi ────────────────────────────────────────────── *@
<Cekmece Varlik="evrak-tahsil" Acik="@tahsilAcik" Baslik="@Dil.T.Evrak.TahsilEdildi"
         Kapat="() => tahsilAcik = false" Kaydet="TahsilEt" Kaydediliyor="@kaydediliyor"
         KaydetAktif="@TahsilGecerli" KilitSebebi="@TahsilKilitSebebi">
    <div class="alan">
        <Secici ElemanId="evrak-tahsil-hedef"
                Etiket="@Dil.T.Evrak.Hedef"
                Secenekler="@(new List<SecenekOgesi> { new SecenekOgesi("KASA", Dil.T.Evrak.HedefKasa), new SecenekOgesi("BANKA", Dil.T.Evrak.HedefBanka) })"
                @bind-Deger="tahsilHedef" @bind-Deger:after="TahsilHedefDegisti" />
    </div>
    @* UX-S24: hedef seçimi bağımlı alanı ekranın kendisi açar. *@
    @if (tahsilHedef == "KASA")
    {
        @if (kasalar.Count == 1)
        {
            @* UX-S22: tek kasa varsa seçici GÖSTERİLMEZ, salt okunur yazılır. *@
            <p class="girdi-salt" id="evrak-tahsil-kasa-tek">@kasalar[0].Ad</p>
        }
        else
        {
            <div class="alan">
                <Secici ElemanId="evrak-tahsil-kasa"
                        Etiket="@Dil.T.Evrak.Kasa"
                        Secenekler="@(kasalar.Select(k => new SecenekOgesi(k.Id, k.Ad)).ToList())"
                        @bind-Deger="secilenKasaId"
                        BosSecenekMetni="—" />
            </div>
        }
    }
    else
    {
        <div class="alan">
            <Secici ElemanId="evrak-tahsil-hesap"
                    Etiket="@Dil.T.Evrak.BankaHesabi"
                    Secenekler="@(hesaplar.Select(h => new SecenekOgesi(h.Id, h.Ad)).ToList())"
                    @bind-Deger="secilenBankaHesapId"
                    BosSecenekMetni="—" />
        </div>
    }
</Cekmece>

@* ── Karşılıksız: YIKICI EYLEM → onay modalı (tek meşru ModalPencere) ───── *@
<ModalPencere Acik="@karsiliksizAcik" Baslik="@Dil.T.Evrak.OnayBaslik"
              Kapat="() => karsiliksizAcik = false" Acildi="KarsiliksizSifirla">
    <p id="evrak-karsiliksiz-uyari">@Dil.T.Evrak.OnayMetin</p>
    <CokSatir ElemanId="evrak-karsiliksiz-gerekce" Etiket="@Dil.T.Evrak.Gerekce" Zorunlu="true"
              Satir="3" EnFazla="@AlanSinirlari.EvrakNot"
              Deger="@karsiliksizGerekce" DegerChanged="@(v => karsiliksizGerekce = v ?? "")"
              Ipucu="@($"{Dil.T.Evrak.GerekceIpucu} ({karsiliksizGerekce.Trim().Length}/{GerekceAsgari})")" />
    <div class="satir-eylemler">
        <button type="button" @onclick="Karsiliksiz" id="evrak-karsiliksiz-onayla"
                class="dugme dugme-tehlike"
                disabled="@(karsiliksizGerekce.Trim().Length < GerekceAsgari || kaydediliyor)">@Dil.T.Evrak.Onayla</button>
        <button type="button" @onclick="() => karsiliksizAcik = false"
                class="dugme dugme-ikincil" id="evrak-karsiliksiz-vazgec">@Dil.T.Evrak.Vazgec</button>
        @if (karsiliksizGerekce.Trim().Length < GerekceAsgari)
        {
            @* UX-S30: kilitli düğme hangi koşulun eksik olduğunu söyler. *@
            <span class="metin-kucuk metin-soluk" id="evrak-karsiliksiz-kilit">@Dil.T.Evrak.GerekceIpucu</span>
        }
    </div>
</ModalPencere>

@code {
    // ── P-36c GÖÇ YARDIMCILARI ──────────────────────────────────────────
