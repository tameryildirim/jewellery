        ? (fKimlikKaldir ? GB.KimlikKaldirilacak : GB.KimlikKayitliGizli)
        : Dil.T.Evrak.BorcluKimlikNoIpucu;
    private DateOnly? fKesideTarihi;

    private bool tahsileAcik, tahsilAcik, karsiliksizAcik;
    private string? secilenEvrakId;
    private string secilenBankaHesapId = "";
    private string secilenKasaId = "";
    private string tahsilHedef = "KASA";
    /// <summary>YASAL-KAPI-2: hedef (kasa ↔ banka) değişince önceki denemenin nakit (tevsik) reddi bayatlar — kalkar.</summary>
    private void TahsilHedefDegisti() => hata = null;
    private string karsiliksizGerekce = "";

    // ── PAKET GOC-B — ortak ızgara kolonları (başlıklar sözlükten; anahtarlar kalıcı; mevcut th id'leri korunur) ──
    private IzgaraSiralama? evrakSira;
    private bool EvrakTam => liste is { DahaFazlasiVar: false };

    private IReadOnlyList<IzgaraKolonu<EvrakSatiri>> EvrakKolonlari =>
    [
        new() { Anahtar = "tur", Baslik = EkranM.EvrakSutunTur, BaslikId = "evrak-th-tur", BaslikIpucu = Dil.T.Evrak.EvrakTuru,
                SunucuSiralamaAdi = EvrakTam ? "tur" : null, Deger = e => TurAdi(e.EvrakTuru) },
        new() { Anahtar = "no", Baslik = Dil.T.Evrak.EvrakNo, ZorunluGorunur = true, SunucuSiralamaAdi = EvrakTam ? "no" : null,
                HucreSinif = _ => "hucre-vurgu hucre-tek-satir", Deger = e => e.EvrakNo,
                Hucre = e => @<text><span>@e.EvrakNo</span>
                    @if (!Dil.BasitMi && !string.IsNullOrWhiteSpace(e.BankaAdi))
                    {
                        <span class="zo-alt-satir metin-soluk zo-iki-satir" id="@($"evrak-banka-{e.Id}")"
                              title="@($"{Dil.T.Evrak.BankaAdi}: {e.BankaAdi}")">@e.BankaAdi</span>
                    }</text> },
        new() { Anahtar = "veren", Baslik = EkranM.EvrakSutunVeren, BaslikId = "evrak-th-veren", BaslikIpucu = Dil.T.Evrak.KaynakCari,
                SunucuSiralamaAdi = EvrakTam ? "veren" : null, HucreSinif = _ => "zo-metin-sutun", Deger = e => e.KaynakCariAd,
                Hucre = e => @<span class="zo-iki-satir" title="@e.KaynakCariAd">@(e.KaynakCariAd ?? "—")</span> },
        new() { Anahtar = "vade", Baslik = EkranM.EvrakSutunVade, BaslikId = "evrak-th-vade", BaslikIpucu = Dil.T.Evrak.VadeGunu,
                ZorunluGorunur = true, SunucuSiralamaAdi = EvrakTam ? "vade" : null, Deger = e => e.VadeGunu,
                Hucre = e => @<text><span class="hucre-tek-satir" id="@($"evrak-vade-{e.Id}")">@VadeMetni(e.VadeGunu)</span>
                    @if (e.Gecikmis)
                    {
                        <Rozet Renk="kirmizi">@Dil.T.Evrak.Gecikmis (@e.GecikmeGun @Dil.T.Evrak.Gun)</Rozet>
                    }
                    else if (e.YakindaVadeli)
                    {
                        <Rozet Renk="amber">@Dil.T.Evrak.Yakinda</Rozet>
                    }</text> },
        // UX-S32: tutar kendi para birimiyle basılır.
        new() { Anahtar = "tutar", Baslik = Dil.T.Evrak.Tutar, ZorunluGorunur = true, SunucuSiralamaAdi = EvrakTam ? "tutar" : null,
                Tur = IzgaraHucreTuru.Para, ParaBirimi = e => e.ParaBirimi, BaslikSinif = "zo-sag", HucreSinif = _ => "sayi", Deger = e => e.Tutar },
        new() { Anahtar = "durum", Baslik = Dil.T.Evrak.Durum, SunucuSiralamaAdi = EvrakTam ? "durum" : null, Deger = e => DurumAdi(e.Durum),
                Hucre = e => @<Rozet Renk="@DurumRengi(e.Durum)">@DurumAdi(e.Durum)</Rozet> },
        new() { Anahtar = "eylem", Baslik = Dil.T.Evrak.Eylemler, ZorunluGorunur = true, Tasinamaz = true, KartEtiketsiz = true,
                Tur = IzgaraHucreTuru.Eylem, HucreSinif = _ => "q10-yigin-eylem",
                // ZO-BELGE: satırda TEK birincil + "⋯"; yıkıcı eylem pencerede ve onaydan geçer (DoD EK 4). id'ler AYNI.
                Hucre = e => @<text><SatirEylemleri Onek="evrak" SatirId="@e.Id" Birincil="1" DarSutun="true"
                                    SatirAdi="@e.EvrakNo" Eylemler="@EvrakEylemleri(e)" />
                    @if (e.IzinliGecisler.Length == 0)
                    {
                        <span class="metin-kucuk metin-soluk" id="@($"evrak-son-durum-{e.Id}")">@Dil.T.Evrak.SonDurum</span>
                    }</text> },
    ];

    private GecersizAlanKapisi? _formKapisi;
    private GecersizAlanKapisi formKapisi => _formKapisi ??= new(() => InvokeAsync(StateHasChanged));

    private bool FormGecerli =>
        !formKapisi.OnekleVar("evrak-form-") &&   // PAKET GOC-B: ortak bileşen kuralı
        BorcluTcknHata is null &&   // PAKET TCKN-DOGRULAMA
        !string.IsNullOrWhiteSpace(fEvrakNo) && fVade is not null && !kurYok &&
        (cekmeceEvrakId is not null || (fTutar > 0m && !string.IsNullOrWhiteSpace(fKaynakCariId)));

    // PAKET P-65 (E49 · UX-S30): Kaydet kilidi EKSİK ALANLARIN ADINI sayar —
    // eskiden yalnız "Bu alan zorunludur." diyordu, hangi alan olduğu yazmıyordu.
    // Kilit koşulu (FormGecerli) DEĞİŞMEDİ; yalnız sebep açıklandı.
    /// <summary>
    /// PAKET TCKN-DOGRULAMA — borçlu kimlik no 11 hane rakamsa TC kimlik no doğrulama kuralı (tek kaynak Core
    /// KimlikNoDogrulayici; sunucu EvrakServisi.BorcluKimlikDenetle ile aynı): anında alan altı + Kaydet kilidi sebebi.
    /// </summary>
    private string? BorcluTcknHata =>
        KimlikNoDogrulayici.TcknVeyaVknDenetle(fBorcluKimlikNo) == KimlikNoHatasi.TcknGecersiz
            ? KimlikNoSozlugu.Al(Dil.Dil).TcknGecersiz : null;

    private string FormKilitSebebi => formKapisi.Sebep(Dil.Dil, "evrak-form-") ?? BorcluTcknHata ?? (kurYok
        ? Dil.T.Evrak.KurYok
        : string.Format(OnayM.EvrakEksikAlanlar, string.Join(" · ", FormEksikAlanlar)));

    /// <summary>Kaydet kilidini doğuran eksik alanların ekrandaki etiketleri (FormGecerli ile aynı koşullar).</summary>
    private IEnumerable<string> FormEksikAlanlar
    {
        get
        {
            if (string.IsNullOrWhiteSpace(fEvrakNo)) yield return Dil.T.Evrak.EvrakNo;
            if (fVade is null) yield return Dil.T.Evrak.VadeGunu;
            if (cekmeceEvrakId is null && fTutar <= 0m) yield return Dil.T.Evrak.Tutar;
            if (cekmeceEvrakId is null && string.IsNullOrWhiteSpace(fKaynakCariId)) yield return Dil.T.Evrak.KaynakCari;
        }
    }

    private OnayKilitMetinleri OnayM => OnayKilitSozlugu.Al(Dil.Dil);
    /// <summary>PAKET CUMA-J: tablo başlıklarının kısa adları (tam ad title'da).</summary>
    private CumaJEkranMetinleri EkranM => CumaJSozlugu.Ekran(Dil.Dil, Dil.BasitMi);

    /// <summary>Vade günü ekran metni: Türkçede gg.aa.yyyy ("01.12.2026"), İngilizcede dilin kısa tarihi.</summary>
    private string VadeMetni(DateOnly g) => Dil.Dil == "en"
        ? Bicim.GunBicim(g, "d", System.Globalization.CultureInfo.GetCultureInfo(Dil.Locale))
        : Bicim.Gun(g);

    private bool TahsilGecerli => !kurYok && (tahsilHedef == "KASA"
        ? !string.IsNullOrEmpty(EtkinKasaId)
        : !string.IsNullOrEmpty(secilenBankaHesapId));

    private string TahsilKilitSebebi => kurYok
        ? Dil.T.Evrak.KurYok
        : tahsilHedef == "KASA" ? Dil.T.Evrak.KasaSecilmedi : Dil.T.Evrak.BankaSecilmedi;

    /// <summary>UX-S22: tek kasa varsa seçici yok; değer gövdeye OTOMATİK konur.</summary>
    private string EtkinKasaId => kasalar.Count == 1 ? kasalar[0].Id : secilenKasaId;

    /// <summary>
    /// QA turu 5 (YÜKSEK): /evraklar/takvim gün bağlantısı ?vadeBas=&vadeBit= ile
    /// geliyordu ama bu sayfa sorguyu HİÇ OKUMUYORDU — derin bağlantı sessizce
    /// yok sayılıyor, kullanıcı o güne ait 1 evrak yerine tüm listeyi görüyordu.
    /// Sorgu ilk yüklemede okunur, süzgeç kutularına YAZILIR (UX-S24) ve süzgecin
    /// bağlantıdan geldiği rozetle söylenir (UX-S29).
    /// </summary>
    private bool suzgecBaglantidan;

    protected override async Task OnInitializedAsync()
    {
        Dil.Degisti += Yenile;
        SorgudanSuzgecOku();
        await YardimcilariYukle();
        await Yukle();
    }

    private async Task VadeSuzgeciTemizle()
    {
        vadeBas = null;
        vadeBit = null;
        suzgecBaglantidan = false;
        await Yukle();
    }

    private void SorgudanSuzgecOku()
    {
        var sorgu = new Uri(Nav.Uri).Query;
        if (string.IsNullOrEmpty(sorgu)) return;
        foreach (var parca in sorgu.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var esit = parca.IndexOf('=');
            if (esit <= 0) continue;
            var ad = Uri.UnescapeDataString(parca[..esit]);
            var deger = Uri.UnescapeDataString(parca[(esit + 1)..]);
            // Geçersiz tarih SESSİZCE yok sayılmaz: kutu boş kalır, rozet de çıkmaz.
            if (!DateOnly.TryParse(deger, System.Globalization.CultureInfo.InvariantCulture, out var g))
                continue;
            if (string.Equals(ad, "vadeBas", StringComparison.OrdinalIgnoreCase))
            {
                vadeBas = g;
                suzgecBaglantidan = true;
            }
            else if (string.Equals(ad, "vadeBit", StringComparison.OrdinalIgnoreCase))
            {
                vadeBit = g;
                suzgecBaglantidan = true;
            }
        }
    }

    private async Task DurumSec(string d)
    {
        durumSuzgec = d;
        await Yukle();
    }

    // 29.09 doğrulayıcı DÜŞÜK: Razor özniteliğinde gövdeli lambda yerine adlandırılmış yöntem.
    private async Task VadeBasDegisti(DateOnly? v)
    {
        vadeBas = v;
        await Yukle();
    }

    private async Task VadeBitDegisti(DateOnly? v)
    {
        vadeBit = v;
        await Yukle();
    }

    /// <summary>
    /// PAKET GOC-B (envanter C satır 33/34, K8e): ters vade aralığı sessizce BOŞ liste dönüyordu ("kayıt yok"
    /// sanılıyordu) → bitişin altında Core metni ve İSTEK YOK; sunucu da aynı kuralla 400 (alan vadeBit).
    /// </summary>
    private string? VadeAralikHatasi =>
        TarihPenceresi.AralikDenetle(vadeBas, vadeBit, TarihPenceresi.VadeEnCokYil + 1) is { } h ? GirdiSozlugu.Mesaj(h, Dil.Dil) : null;

    private async Task Yukle()
    {
        if (VadeAralikHatasi is not null) return;   // PAKET GOC-B: bozuk aralıkta istek atılmaz
        yukleniyor = true;
        hata = null;
        try
        {
            var sorgu = new List<string> { "limit=200" };
            if (!string.IsNullOrEmpty(durumSuzgec)) sorgu.Add($"durum={durumSuzgec}");
            if (!string.IsNullOrEmpty(turSuzgec)) sorgu.Add($"evrakTuru={turSuzgec}");
            if (vadeBas is { } b) sorgu.Add($"vadeBas={Bicim.Makine(b)}");
            if (vadeBit is { } s) sorgu.Add($"vadeBit={Bicim.Makine(s)}");
            liste = await Api.GetAsync<EvrakListesi>($"/evraklar?{string.Join("&", sorgu)}");
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            // ⚠ UX-S28 / Anayasa md.1: hata "kayıt yok"a ÇEVRİLMEZ. Liste
            //   DOKUNULMAZ (eski veri kalır), hata bandı ayrıca gösterilir.
            hata = ex.Message;
        }
        finally
        {
            yukleniyor = false;
        }
    }

    private async Task YardimcilariYukle()
    {
        cariler = await AdListesiOku("/cari?aktif=true&limit=200", "ad");
        kasalar = await AdListesiOku("/kasalar", "ad");
        hesaplar = await AdListesiOku("/bankalar", "hesapAdi");
        try
        {
            kur = await Api.GetAsync<CanliKurServisi.KurAnlik>("/kur/guncel");
            kurYok = kur is null || string.IsNullOrEmpty(kur.Id);
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            kur = null;
            kurYok = true;
        }
    }

    /// <summary>
    /// Yardımcı listeleri JSON'dan okur. ⚠ Yeni istemci record'u AÇMAMAK için
    /// JsonElement üzerinden gidilir (S-2 tavanı); sunucu sözleşmesi
    /// değişirse liste boş kalır ve hata bandı yazılır, sessiz düşmez.
    /// </summary>
    private async Task<List<(string Id, string Ad)>> AdListesiOku(string yol, string adAlani)
    {
        try
        {
            var kok = await Api.GetAsync(yol);
            var dizi = kok.ValueKind == JsonValueKind.Array ? kok
                : kok.TryGetProperty("satirlar", out var s) ? s
                : kok.TryGetProperty("cariler", out var c) ? c
                : default;
            if (dizi.ValueKind != JsonValueKind.Array) return [];
            var sonuc = new List<(string, string)>();
            foreach (var o in dizi.EnumerateArray())
            {
                if (!o.TryGetProperty("id", out var id)) continue;
                var ad = o.TryGetProperty(adAlani, out var a) ? a.GetString() : null;
                sonuc.Add((id.GetString() ?? "", ad ?? "—"));
            }
            return sonuc;
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            hata = ex.Message;
            return [];
        }
    }

