    {
        cekmeceEvrakId = null;
        formGonderildi = false;
        fTur = "CEK"; fEvrakNo = ""; fTutar = 0m; fVade = null; fKaynakCariId = "";
        fBankaAdi = fBankaSube = fKesideYeri = fBorcluAd = fBorcluKimlikNo = fNotlar = null;
        fKesideTarihi = null;
        fKimlikYabanci = fKimlikKaldir = kimlikKayitli = false;
