    // ── Doğrulayıcı 28.09 (t30, KRİTİK): çözülemeyen/belirsiz sayı varken POST YOK ──
    /// <summary>Alan kimliği → kutuya son yazılan ham metin (HamMetinKabi doldurur).</summary>
    private readonly Dictionary<string, string> hamMetin = new();

    /// <summary>
    /// Kutuda çözülemeyen ya da belirsiz ("1.500") metin varsa Gram'ın Deger'i SON
    /// GEÇERLİ değerde kalır; o değer gönderilmez. Mesaj Gram'ın kendi alan altı
    /// mesajıyla AYNI metin (tek kaynak: SayiCozumu.Mesaj / Form.SayiAnlasilmadi).
    /// Sayfa yeniden çizilince ortak alan kutuyu eski değere döndürür; o eski değer
    /// (ör. "tümünü iade et" varsayılanı) bir sonraki Kaydet'te sessizce gitmesin
    /// diye alanın değeri SIFIRLANIR (fail-closed): kutu 0 gösterir, mesaj altında.
    /// </summary>
    private void HamDenetle(FormDurumu form, string alan, Action sifirla)
    {
        if (!hamMetin.TryGetValue(alan, out var ham)) return;
        var cozum = Kuyumcu.Web.Bilesenler.Form.FormAlani.SayiCoz(ham);
        string? mesaj = cozum.Sonuc switch
        {
            Kuyumcu.Web.Bilesenler.Form.FormAlani.SayiSonucu.Belirsiz => cozum.Mesaj(Dil.Dil),
            Kuyumcu.Web.Bilesenler.Form.FormAlani.SayiSonucu.Gecersiz => Dil.T.Form.SayiAnlasilmadi,
            _ => null,
        };
        if (mesaj is null) return;
        form.Ekle(alan, mesaj);
        sifirla();
        hamMetin.Remove(alan);
    }

    private async Task CikisKaydet()
    {
        if (IadeBirakildigi) { await CikisKaydetBirakildigi(); return; }
        cikisForm.Temizle();
        HamDenetle(cikisForm, "c-gram", () => cGram = null);
        HamDenetle(cikisForm, "c-has", () => cHas = 0);
        cikisForm.Pozitif("c-has", cHas, Dil);
        // Doğrulayıcı 28.09: sunucu 0 < has < 0,001'i 400 ile reddeder (EmanetModulu
        // [Range(0.001, …)]); aynı eşik istemcide alan altı mesaj olur, gereksiz tur yok.
        if (cHas > 0 && !IadeEdilebilir(cHas))
            cikisForm.Ekle("c-has", string.Format(S.IadeEnAz, Bicim.Has(IadeAltSinir)));
        if (cHas > SeciliMadenHas) cikisForm.Ekle("c-has", Dil.T.Emanet.IadeFazlaUyari);
        if (!cikisForm.Gecerli) { cikisHata = Dil.T.Kabuk.FormEksik; return; }

        cikisHata = null;
        kaydediliyor = true;
        try
        {
            await Api.PostAsync($"/emanet/{cariId}/cikis", new
            {
                hasGrami = cHas,
                maden = cMaden,      // K20-9: çıkış bu madenin netinden düşer
                aciklama = string.IsNullOrWhiteSpace(cAciklama) ? null : cAciklama.Trim(),
                kurSnapshotId = kur!.Id,
            });
            cikisAcik = false;
            BasariGoster(Dil.T.Emanet.CikisKaydedildi);
            await CariDegisti();
        }
        catch (ApiHata ex) { cikisHata = cikisForm.SunucuHatasiTek(ex, Dil, new Dictionary<string, string> { ["HasGrami"] = "c-has" }); }   // TOPLU-7B: tek yazım
        kaydediliyor = false;
    }

    /// <summary>
    /// P-DIL-BORC-KASA (Y18): iade bırakıldığı gibi — ayar + gram gider; has aynı Core fonksiyonuyla
    /// hesaplanmış olarak yanında gider (sunucu 0,001 g toleransla doğrular). Hata alan altında (c-gram).
    /// </summary>
    private async Task CikisKaydetBirakildigi()
    {
        cikisForm.Temizle();
        HamDenetle(cikisForm, "c-gram", () => cGram = null);
        cikisForm.Pozitif("c-gram", cGram ?? 0m, Dil);
        if (cGram > SeciliAyarGram) cikisForm.Ekle("c-gram", Dil.T.Emanet.IadeFazlaUyari);
        else if (cGram > 0 && !IadeEdilebilir(cHas))
            cikisForm.Ekle("c-gram", string.Format(S.IadeEnAz, Bicim.Has(IadeAltSinir)));
        if (!cikisForm.Gecerli) { cikisHata = Dil.T.Kabuk.FormEksik; return; }

        cikisHata = null;
        kaydediliyor = true;
        try
        {
            await Api.PostAsync($"/emanet/{cariId}/cikis", new
            {
                hasGrami = cHas,
                maden = cMaden,
                ayarId = cAyar,
                gramAgirlik = cGram,
                aciklama = string.IsNullOrWhiteSpace(cAciklama) ? null : cAciklama.Trim(),
                kurSnapshotId = kur!.Id,
            });
            cikisAcik = false;
            BasariGoster(Dil.T.Emanet.CikisKaydedildi);
            await CariDegisti();
        }
        catch (ApiHata ex) { cikisHata = cikisForm.SunucuHatasiTek(ex, Dil, new Dictionary<string, string> { ["GramAgirlik"] = "c-gram", ["HasGrami"] = "c-gram" }); }
        kaydediliyor = false;
    }

    // ── STORNO (48-A motoru) ────────────────────────────────────────────────

    private void StornoIste(HareketVeri h)
    {
        if (!StornoAcik(h)) return;
        stornoHata = null;
        stornoGerekce = "";
        stornoHareket = h;
    }

    private void StornoKapat() { stornoHareket = null; stornoGerekce = ""; }

    private async Task StornoUygula()
    {
        if (stornoHareket is not { } h || kur is null) return;
        stornoHata = null;
        kaydediliyor = true;
        try
        {
            // Emanetin kasa bacağı yoktur (tlTutari = 0) → kasaId gönderilmez.
            var yanit = await Api.PostAsync<JsonElement>($"/islemler/{h.Id}/storno", new
            {
                gerekce = stornoGerekce.Trim(),
                kurSnapshotId = kur.Id,
            });
            // 48-A motoru ters kaydın KİMLİĞİNİ (ULID) ve ters has gramını döndürür.
            // Doğrulayıcı 28.09 (DÜŞÜK): ham ULID tezgâhtar için anlamsızdır, banda
            // BASILMAZ. POST yanıtı yine okunur (UX-S27): ters has gramı banda yazılır;
            // yanıtta yoksa yalnız "Kayıt geri alındı."
            decimal? tersHas = yanit.ValueKind == JsonValueKind.Object
                               && yanit.TryGetProperty("hasGrami", out var hg)
                               && hg.ValueKind == JsonValueKind.Number
                ? hg.GetDecimal() : null;
            BasariGoster(tersHas is { } th
                ? string.Format(S.GeriAlYapildi, Bicim.Has(th))
                : S.GeriAlYapildiSade);
            stornoHareket = null;
            await CariDegisti();
        }
        catch (ApiHata ex) { stornoHata = FormDurumu.SunucuMesaji(ex, Dil); }
        kaydediliyor = false;
    }

    private void Yenile() => InvokeAsync(StateHasChanged);
    public void Dispose() => Dil.Degisti -= Yenile;
