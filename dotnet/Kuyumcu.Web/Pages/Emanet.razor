    private async Task GirisKaydet()
    {
        // QA turu 2: "gram 0 → Kaydet: istek yok, mesaj yok".
        girisForm.Temizle();
        HamDenetle(girisForm, "e-gram", () => gGram = 0);
        HamDenetle(girisForm, "e-tas", () => gTas = 0);
        girisForm.Pozitif("e-gram", gGram, Dil);
        if (gTas >= gGram && gGram > 0) girisForm.Ekle("e-tas", Dil.T.Emanet.TasGramdanKucuk);
        if (!girisForm.Gecerli) { girisHata = Dil.T.Kabuk.FormEksik; return; }

        girisHata = null;
        kaydediliyor = true;
        try
        {
            await Api.PostAsync("/emanet/giris", new
            {
                cariId,
                ayarId = gAyar,
                gramAgirlik = gGram,
                tasAgirlik = gTas > 0 ? gTas : (decimal?)null,
                aciklama = string.IsNullOrWhiteSpace(gAciklama) ? null : gAciklama.Trim(),
                kurSnapshotId = kur!.Id,
            });
            girisAcik = false;
            BasariGoster(Dil.T.Emanet.GirisKaydedildi);
            await CariDegisti();
        }
        catch (ApiHata ex) { girisHata = girisForm.SunucuHatasiTek(ex, Dil, new Dictionary<string, string> { ["GramAgirlik"] = "e-gram", ["TasAgirlik"] = "e-tas" }); }   // TOPLU-7B: tek yazım
        kaydediliyor = false;
    }

