        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            // UX-S28: sessiz kalmaz — stok penceresinde AYRI hata bandı (stok tablosu
            // yine görünür); ad yerine "Tanımsız şube" yazar, kimlik basılmaz.
            subeHata = ex.Message;
        }
    }

