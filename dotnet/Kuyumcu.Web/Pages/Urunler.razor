    private void KatliHataVarsaAc(bool yeni)
    {
        if (Modu.ProfesyonelMi || form.Gecerli) return;
        var cekirdek = yeni ? YeniCekirdek : DuzCekirdek;
        var satisAlani = yeni ? "u-satis-fiyati" : "d-satis";
        var satisGorunur = !MadenKiymetli(yeni ? yeniAyar : dAyar);
        var gorunenHata = cekirdek.Count(form.Var) + (satisGorunur && form.Var(satisAlani) ? 1 : 0);
        if (form.HataSayisi > gorunenHata)
        {
            if (yeni) yeniDahaFazla = true; else duzDahaFazla = true;
        }
    }

    // ── Stok adedi sütunu ──────────────────────────────────────────────────
    // ⚠ Liste ucu (GET /urunler) stok taşımaz ve sunucu modülleri bu şeridin
    //   dosya alanı DEĞİL (S-B). Adet, görünen satırlar için mevcut
    //   GET /urunler/{id}/stok ucundan okunur (herkese açık, kiracı süzgeçli);
    //   satır sayısı ListeSiniri ile sınırlı. Toplu uç önerisi raporda.
    private Dictionary<string, decimal?> stokAdetleri = [];
    private string? stokAdetHata;
    private int stokAdetJeton;

    private string StokAdetMetni(UrunVeri u) =>
        !stokAdetleri.TryGetValue(u.Id, out var a) ? L.StokYukleniyor
        : a is { } adet ? Bicim.Miktar(adet, u.Birim) : "?";

    private async Task StokAdetleriniYukle()
    {
        var jeton = ++stokAdetJeton;
        stokAdetHata = null;
        var urunler = UrunListesi.ToList();
        if (urunler.Count == 0) { stokAdetleri = []; return; }
        // PAKET ISTEK-1: satır başına GET /urunler/{id}/stok (N+1) yerine TEK
        // toplu istek. 12 ürünlük listede 12 istek → 1; 200 ürünlük dükkânda
        // ekran açılışı artık genel istek sınırını tek başına yemez.
        // Liste ListeSiniri (≤500) ile sınırlı; uç da en fazla 500 kimlik alır.
        // Önceki adetler yeni yanıt gelene dek EKRANDA KALIR (boşalma yok).
        try
        {
            var kimlikler = string.Join(",", urunler.Select(u => u.Id));
            await SubeliSorgu.HazirAsync(Oturum);   // ŞUBE-KAPSAM-B: seçili şubenin adetleri
            var y = await Api.GetAsync<StokAdetleriYaniti>(SubeliSorgu.Ekle($"/urunler/stok-adetleri?ids={Uri.EscapeDataString(kimlikler)}", Oturum));
            // Süzgeç bu arada değiştiyse eski yanıt yeni listeye YAZILMAZ.
            if (jeton != stokAdetJeton) return;
            var gelen = (y?.Urunler ?? []).ToDictionary(x => x.UrunId, x => (decimal?)x.ToplamAdet);
            // Yanıtta olmayan ürün "?" olur (tahmin yok) ve sebep bantta yazar.
            stokAdetleri = urunler.ToDictionary(u => u.Id, u => gelen.TryGetValue(u.Id, out var a) ? a : null);
            if (urunler.Any(u => !gelen.ContainsKey(u.Id)))
                stokAdetHata = L.StokAlinamadi;
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            if (jeton != stokAdetJeton) return;
            // Bilinen adet korunur; bilinmeyen hücre "?" olur, sebep bantta.
            var onceki = stokAdetleri;
            stokAdetleri = urunler.ToDictionary(u => u.Id, u => onceki.TryGetValue(u.Id, out var a) ? a : null);
            stokAdetHata = $"{L.StokAlinamadi} ({ex.Message})";
        }
    }

