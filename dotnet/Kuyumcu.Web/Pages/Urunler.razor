@page "/urunler"
@using Kuyumcu.Core.Sozlesmeler
@using Kuyumcu.Contracts.Sayfalar.Urunler
@using Kuyumcu.Core.Domain.Girdi
@using Kuyumcu.Web.Bilesenler.Grid
@inject ApiIstemci Api
@inject DilServisi Dil
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ArayuzModuServisi Modu
@inject OturumServisi Oturum
@implements IDisposable

@* Kaynak: apps/web/src/pages/UrunPage.tsx — React'teki "kategori" kavramı .NET API'de "tip". *@

<PageTitle>@Marka.SayfaBasligi(Dil.T.Urun.Baslik)</PageTitle>
@* ORTAK-1 (KEŞİF #4): sayfadaki HER Sayi/Para/Gram kutusu ortak geçersiz sayı kapısına yazılır — "1.500" gibi
   anlaşılamayan metin varken ilgili formun Kaydet'i PASİF (sebep alanın etiketi) ve gövdeye 0/eski değer GİTMEZ. *@
<CascadingValue Value="sayiKapisi" IsFixed="true">

@* PAKET YILDIZ-5A: Yıldız şemasında (BASİT + PRO) liste = tuval Y_Urunler (BİREBİR); özgün ekran yalnız "ayrıntı" görünümünde
   çizilir (data-yz-ozgun; Yıldız dışında öznitelik YAZILMAZ). Öteki 8 şemada aşağıdaki özgün ekran AYNEN. *@
@if (YildizMi) { <Kuyumcu.Web.Bilesenler.Yildiz.YildizListe B="@YildizBaglami" /> }
@if (YildizOzgunCiz) {
<div data-yz-ozgun="@YildizOzgunIsaret" class="dikey-bosluk">
    @* ── Sayfa başı: başlık + arama/ayar süzgeci yuvası + TEK birincil eylem ──
       Mevcut denetimler KALDIRILMADI, SayfaBasi yuvasına taşındı. *@
    <SayfaBasi Anahtar="urunler" Baslik="@Dil.T.Urun.Baslik" Aciklama="@Dil.T.Urun.Aciklama">
        <Filtreler>
            @* ── P-37 · TEK ARAMA YÜZEYİ (kurucu 21 Eylül 16:30) ─────────────
               ÖNCE: bu ekranda ÜÇ ayrı arama/süzme yüzeyi vardı — sağ üstte
               "Ürün adı veya barkod ara…", altında ayar seçicisi, bir de TAM
               GENİŞLİKTE ayrı bir "Barkodu okutun…" satırı + düğmesi. Kurucu
               "inputlar seçme yerleri dengesiz" derken bunu görüyordu.
               ŞİMDİ: barkod okutma bu kutunun İÇİNE indi — okutucu Enter basar,
               Enter doğrudan /urunler/barkod/{kod} ucuna gider ve kartı açar.
               Mükerrer arama yüzeyi 0. *@
            @* GOC-C-2 (tasarım hakemi KRİTİK "/urunler PRO 1280 filtre yer tutucusu kesik 'barl'"): 55 karakterlik yer tutucu
               altı süzgeçli satırda ~260 px kutuya sığmıyordu → kısa yer tutucu (okutucu Enter'ı kendisi basar; Enter yolu aynen). *@
            <Arama ElemanId="urun-arama" Etiket="@Dil.T.Urun.AraPlaceholder"
                   YerTutucu="@Kuyumcu.Core.I18n.GocC2Sozlugu.Al(Dil.Dil).UrunAraKisa"
                   Deger="@arama" DegerChanged="@(async v => { arama = v ?? ""; await Yukle(); })"
                   Enter="BarkodBul" />
            @* ═══ PAKET S3-3 — SÜZGEÇ SATIRI: TEK SEÇİCİ + "Süzgeç ▾" ═══
               Görünen: arama + DURUM seçicisi (QA tur 8: "durum süzgeci yok").
               Basit modda maden/ayar/kategori/reyon dört seçicisi "Süzgeç ▾"
               arkasında KATLIDIR (375 px kırpılması bu yüzden kapanır); DEĞERLERİ
               korunur, etkin süzgeç sayısı düğmede yazar — görünmez süzgeç yok.
               Profesyonel modda dört seçici bugünkü gibi hep açıktır. *@
            <Secici ElemanId="urun-durum-filtre"
                    Etiket="@L.Durum"
                    Secenekler="@DurumSecenekleri"
                    @bind-Deger="durumFil"
                    @bind-Deger:after="Yukle"
                    BosSecenekMetni="@L.DurumHepsi" />
            @if (Modu.BasitMi)
            {
                <button @onclick="SuzgecDegistir" type="button" class="dugme dugme-ikincil dugme-kucuk" id="urun-suzgec-ac"
                        aria-expanded="@(suzgecAcik ? "true" : "false")">
                    @(EtkinSuzgecSayisi > 0 ? string.Format(L.SuzgecSayili, EtkinSuzgecSayisi) : L.Suzgec) @(suzgecAcik ? "▴" : "▾")
                </button>
            }
            @if (SuzgecGorunur)
            {
            @* PAKET 20 — maden filtresi: "hangi madenden kaç ürün var" sorusu
               ayar ayar süzmeden cevaplanabilsin. *@
               <Secici ElemanId="urun-maden-filtre"
                       Etiket="@Dil.T.Urun.Maden"
                       Secenekler="@(Madenler.Select(m => new SecenekOgesi(m, KurKaynakAdi.MadenAdi(m))).ToList())"
                       @bind-Deger="madenFil"
                       @bind-Deger:after="Yukle"
                       BosSecenekMetni="@Dil.T.Urun.TumMadenler" />
            <Secici ElemanId="urun-ayar-filtre"
                       Etiket="@Dil.T.Urun.Ayar"
                       Secenekler="@(Ayarlar.Select(a => new SecenekOgesi(a, KurKaynakAdi.AyarAdi(a))).ToList())"
                       @bind-Deger="ayarFil"
                       @bind-Deger:after="Yukle"
                       BosSecenekMetni="@Dil.T.Urun.TumAyarlar" />
            @* P-37: kategori ve reyon süzgeçleri ayrı bir satırdan ŞERİDE alındı. *@
            <Secici ElemanId="urun-kategori-filtre"
                    Etiket="@Dil.T.Urun.Kategori"
                    Secenekler="@(DuzKategoriler.Select(k => new SecenekOgesi(k.Id, k.Etiket)).ToList())"
                    @bind-Deger="kategoriFil"
                    @bind-Deger:after="Yukle"
                    BosSecenekMetni="@Dil.T.Urun.TumKategoriler" />
            <Secici ElemanId="urun-reyon-filtre"
                    Etiket="@Dil.T.Urun.Reyon"
                    Secenekler="@(reyonlar.Select(r => new SecenekOgesi(r.Id, r.Ad)).ToList())"
                    @bind-Deger="reyonFil"
                    @bind-Deger:after="Yukle"
                    BosSecenekMetni="@Dil.T.Urun.TumReyonlar" />
            }
            @* ── PAKET P-15 (B-29) — DERİN BAĞLANTI SÖZLEŞMESİ ───────────────
               Kabuk aramasından ya da başka bir ekrandan gelen sorgu dizesi
               süzgeci KUTULARA yazılır ve buradan geldiği söylenir; sessizce
               yok sayılmaz (Anayasa md.1). *@
            @if (suzgecBaglantidan)
            {
                <span class="metin-kucuk" id="urun-suzgec-baglanti">
                    <Rozet Renk="mavi">@Dil.T.Kabuk.BaglantidanSuzgec</Rozet>
                    <button type="button" @onclick="BaglantiSuzgeciniTemizle"
                            class="dugme dugme-kucuk dugme-ikincil" id="urun-suzgec-temizle"
                            >@Dil.T.Kabuk.BaglantiSuzgeciniTemizle</button>
                </span>
            }
        </Filtreler>
        <Eylem>
            <button class="btn btn-birincil" id="urun-yeni-ac" @onclick="YeniModalAc">+ @Dil.T.Urun.YeniUrun</button>
        </Eylem>
    </SayfaBasi>
    @* ŞUBE-KAPSAM-B: ürün listesi kiracı genelidir; STOK ADETLERİ seçili şubenin. *@
    <GorunumRozeti Degisti="StokAdetleriniYukle" />
    <BasariBandi Mesaj="@basari" Jeton="@basariJeton" SureliMs="3000" Id="basari-bandi" />

    @if (barkodHata is not null)
    {
        <HataBandi Mesaj="@barkodHata" />
    }
    <HataBandi Mesaj="@yanKaynakHata" Id="yan-kaynak-hata" />
    @* S3-3 / UX-S28: stok adedi alınamazsa hücre "?" olur ve SEBEP burada yazar. *@
    <HataBandi Mesaj="@stokAdetHata" Id="urun-stok-hata" />

    @* ── Ürün tablosu ── *@
    <div class="kart">
        @* PAKET ISTEK-1 (GOZ #45, UX-S28): hata ya da yeniden yükleme ELDEKİ
           LİSTEYİ SİLMEZ. Bekleme halkası yalnız henüz hiç liste yokken çıkar;
           hata bandı tablonun ÜSTÜNDE durur, tablo yerinde kalır. Boş durum
           yalnız istek BAŞARILI ve sonuç gerçekten boşken görünür. *@
        @if (listeHata is not null)
        {
            <div class="kart-govde"><HataBandi Mesaj="@listeHata" Id="hata-bandi" /></div>
        }
        @if (yukleniyor && UrunListesi.Count == 0)
        {
            <Yukleniyor />
        }
        else if (UrunListesi.Count == 0)
        {
            @if (listeHata is null)
            {
                <BosDurum Mesaj="@Dil.T.Urun.UrunBulunamadi" />
            }
        }
        else
        {
            @* UX-S29 — sunucu sınırı ekranda söylenir; sınıra değdiyse uyarı basar. *@
            @* TOPLU-4 (TOPLU-2 hakem ORTA): ayrı 12 px "En çok 50 kayıt…" paragrafı yerine SAYAÇ satırı
               ("12 kayıt gösteriliyor · en çok 50" — sınır yine yazılı, UX-S29); daraltma cümlesi YALNIZ
               sınıra ulaşınca, aynı satırda. *@
            <p class="metin-soluk kart-govde t4-sayac" id="urun-sinir">
                @* TOPLU-6 (TOPLU-4 hakemi ORTA "sınırın altında da 'en çok 50'"): sınırın altında yalnız sayı (sınır
                   title'da yazılı kalır); "en çok N" ve daraltma cümlesi sınıra ulaşınca (UX-S29: o an söylenir). *@
                @if (UrunListesi.Count >= ListeSiniri)
                {
                    @string.Format(Toplu4Sozlugu.Al(Dil.Dil).ListeSayac, UrunListesi.Count, ListeSiniri)
                }
                else
                {
                    <span title="@string.Format(Toplu6Sozlugu.Al(Dil.Dil).ListeSiniriBilgi, ListeSiniri)">@string.Format(Toplu6Sozlugu.Al(Dil.Dil).ListeSayacSade, UrunListesi.Count)</span>
                }
                @if (UrunListesi.Count >= ListeSiniri)
                {
                    <span class="metin-amber" id="urun-sinir-asildi" role="status">@Dil.T.Kabuk.SinirAsildi @string.Format(Dil.T.Kabuk.SinirUyarisi, ListeSiniri)</span>
                }
            </p>
            @* PAKET GOC-C — ORTAK IZGARA (grid:urunler:urun-liste). Sunucu en çok ListeSiniri ürün döndürür:
               sınıra değdiyse sıralama KAPALI (üstteki sayaç + daraltma cümlesi UX-S29 zaten yazılı); değmediyse
               tam liste yerel sıralanır. Mod sütunları AYNEN: barkod/ürün grubu/durum yalnız PRO (S3-3).
               Gram binlik gruplu (devir). KartListe kimliği (urun-liste) korunur. *@
            <Izgara T="UrunVeri" Ekran="urunler" GridId="urun-liste" KartListeId="urun-liste" TabloSinif="tablo-sik"
                    Kolonlar="@UrunKolonlari" Ogeler="@IzgaraYerelSiralama.Uygula(UrunListesi, urunSira, UrunKolonlari)"
                    SatirId="@(u => $"u-satir-{u.Id}")" Baslik="@Dil.T.Urun.Baslik"
                    SiralamaDegisti="@(x => urunSira = x)" GecerliSiralama="@urunSira" />
        }
    </div>
</div>
}

@* ── Yeni ürün modalı ── *@
<ModalPencere Acik="yeniModalAcik" Baslik="@Dil.T.Urun.YeniUrun" Kapat="() => yeniModalAcik = false">
    <ChildContent>
    <div class="form-dikey">
        <Metin ElemanId="u-ad" Etiket="@Dil.T.Urun.UrunAdi" Zorunlu="true" EnFazla="@AlanSinirlari.UrunAd"
               Deger="@yeniAd" DegerChanged="@(v => yeniAd = v ?? "")"
               Durum="form" HataAlani="u-ad" />
        @* PAKET P-URUN (Y19): ZORUNLULAR İLK EKRANDA — denetimde 1366×768 Yıldız penceresinde gram ve
           açılış stoğu iç kaydırmada kalıyordu. Sıra: ad / maden+ayar / kod+gram / barkod+açılış stoğu /
           ürün grubu. Telefonda (tek sütun) ilk beş kutu: ad · maden · ayar · kod · gram. Maden yine
           ayardan ÖNCE (PAKET 20 bağı); ürün grubu bir maden dayatırsa maden kilitlenir. *@
        <div class="form-grid-2">
            @* ── PAKET 20 — ÖNCE MADEN, SONRA O MADENİN AYARLARI ─────────────
                 UX-S24: bağımlı alanın bağını ekran kurar. Maden seçilince ayar
                 listesi o madenin SAFLIK TABLOSUNA döner (milyemiyle birlikte);
                 ürün grubu bir maden dayatıyorsa (PLATIN, CELIK…) maden seçici
                 KİLİTLENİR ve sebebi yazılır (UX-S22/UX-S30). ── *@
            <div class="alan">
                <Secici ElemanId="u-maden"
                        Etiket="@Dil.T.Urun.Maden"
                        Secenekler="@(Madenler.Select(m => new SecenekOgesi(m, KurKaynakAdi.MadenAdi(m))).ToList())"
                        @bind-Deger="yeniMaden"
                        @bind-Deger:after="YeniMadenDegisti"
                        Devredisi="@(TipinMadeni(yeniTip) is not null)" />
                @* KESIF-P4 #84: sebep EKRANDA TEK KEZ — aşağıdaki u-maden-kilit satırı.
                   Seçiciye DevredisiSebebi de verilince aynı cümle iki kez basılıyordu. *@
                @if (TipinMadeni(yeniTip) is { } zorunlu)
                {
                    <span class="metin-soluk metin-kucuk" id="u-maden-kilit">
                        @MadenKilitSebebi(yeniTip)
                    </span>
                }
            </div>
            <div class="alan">
                @* PAKET P-URUN (K6): ayarın VARSAYILANI YOK — "Ayar seçin" ile açılır, seçilmeden
                   Kaydet kilitli (sebep altlıkta). Ad ile seçim çelişirse tek satır uyarı;
                   kaydı engellemez. Sunucu reddi (alan ayarId) bu kutunun altına yazılır. *@
                <Secici ElemanId="u-ayar"
                        Etiket="@Dil.T.Urun.Ayar"
                        Zorunlu="true"
                        Secenekler="@AyarSecenekleri(yeniMaden)"
                        BosSecenekMetni="@PU.AyarSecin"
                        Hata="@form.Mesaj("u-ayar")"
                        @bind-Deger="yeniAyar" />
                @if (YeniAdAyarUyarisi is { } celiski)
                {
                    <span class="metin-kucuk metin-amber" id="u-ayar-celiski" role="status">@celiski</span>
                }
            </div>
        </div>
        <div class="form-grid-2">
            <Metin ElemanId="u-kod" Etiket="@Dil.T.Urun.Kod" Zorunlu="true" EnFazla="@AlanSinirlari.UrunKod"
                   Deger="@yeniKod" DegerChanged="@(v => yeniKod = v ?? "")"
                   Durum="form" HataAlani="u-kod" />
            @* GRAM üründe gram ağırlık sunucuda 1'e zorlanır; girdi kilitli. *@
            <Gram ElemanId="u-gram" Etiket="@Dil.T.Urun.GramAgirlik" Tur="@(yeniBirim == "GRAM" ? (AgirlikTuru?)null : AgirlikTuru.Gram)"
                  Zorunlu="@(yeniBirim != "GRAM")"
                  Deger="@yeniGram" DegerChanged="@(v => yeniGram = v ?? 0m)"
                  Devredisi="@(yeniBirim == "GRAM")"
                  DevredisiSebebi="@Dil.T.Urun.BirimGramIpucu"
                  Durum="form" HataAlani="u-gram" />
        </div>
        <div class="form-grid-2">
            <BarkodAlani ElemanId="u-barkod" Etiket="@Dil.T.Urun.Barkod"
                   Deger="@yeniBarkod" DegerChanged="@(v => yeniBarkod = v ?? "")"
                   Durum="form" HataAlani="u-barkod" />
            @* ═══ UX-4d madde 1: AÇILIŞ STOĞU ═══
               Ürün kartının stok açma yolu yoktu: POST /urunler ürünü 0 stokla
               açıyor, hemen ardından satış 400 "Bu şubede ürün stoğu bulunamadı"
               veriyordu. Şube SORULMAZ (UX-S22): oturumun/işletmenin şubesi
               sunucuda çözülür. *@
            @* PAKET GOC-C (#6 · K14): ADET birimde ortak Adet (sunucu UrunAdetKapisi ile aynı ileti; boş = açılış yok),
               GRAM birimde 3 ondalıklı miktar. Eksi değer artık SESSİZCE yok sayılmaz: alan altı hata + Kaydet kilidi. *@
            @if (yeniBirim == "GRAM")
            {
                <Sayi ElemanId="u-acilis-stok" Etiket="@Dil.T.Urun.AcilisStogu" EnAz="0" EnCokOndalik="3" EnCok="@AlanSinirlari.AcilisStokEnCok"
                      Deger="@yeniAcilisStok" DegerChanged="@(v => yeniAcilisStok = v ?? 0m)"
                      Ipucu="@Dil.T.Urun.AcilisStoguIpucu" Durum="form" HataAlani="u-acilis-stok" />
            }
            else
            {
                @* GOC-C-2 VERI-2: tavan sunucunun [AcilisAdedi] sabitiyle AYNI (99999999 artık yazarken reddedilir). *@
                <Adet ElemanId="u-acilis-stok" Etiket="@Dil.T.Urun.AcilisStogu" EnCok="@AlanSinirlari.AcilisStokEnCok"
                      Deger="@(yeniAcilisStok == 0m ? null : yeniAcilisStok)" DegerChanged="@(v => yeniAcilisStok = v ?? 0m)"
                      Ipucu="@Dil.T.Urun.AcilisStoguIpucu" Durum="form" HataAlani="u-acilis-stok" />
            }
        </div>
        <div class="form-grid-2">
            <div class="alan">
                @* UX-S31 / QA turu 2 ORTA: aynı enum yeni formda "Kategori",
                   düzenlemede "Tip" diye adlandırılıyordu ve ağaç kategorisiyle
                   karışıyordu. Tek ad: "Ürün grubu". *@
                   <Secici ElemanId="u-tip"
                           Etiket="@Dil.T.Urun.UrunGrubu"
                           Secenekler="@GrupSecenekleri"
                           @bind-Deger="yeniTip"
                           @bind-Deger:after="YeniTipDegisti" />
            </div>
        </div>
        <div class="form-grid-2">
            @* S3-3: basit modda "Daha fazla ▾" arkasında (değer korunur). *@
            @if (YeniTumAlanlar)
            {
            <div class="alan">
                <Onay ElemanId="u-rodyum" Etiket="@Dil.T.Urun.RodyumKaplama"
                      @bind-Deger="yeniRodyum"
                      Devredisi="@(!RodyumKaplanabilir(yeniMaden))"
                      DevredisiSebebi="@Dil.T.Urun.RodyumKaplanmaz"
                      Ipucu="@(RodyumKaplanabilir(yeniMaden) ? Dil.T.Urun.RodyumKaplamaIpucu : null)" />
            </div>
            }
            @if (!MadenKiymetli(yeniAyar))
            {
                @* UX-S21/UX-S30: sistemin bildiği kural ekranda yazılır —
                   çelikte has gramı hesaplanmaz, o yüzden satış fiyatı zorunludur. *@
                <div class="alan" id="u-kiymetsiz-uyari" role="note">
                    <strong class="metin-kucuk">@Dil.T.Urun.HasHesaplanmaz</strong>
                    <span class="metin-soluk metin-kucuk">@Dil.T.Urun.HasHesaplanmazIpucu</span>
                </div>
            }
        </div>
        @if (YeniTumAlanlar)
        {
        <Milyem ElemanId="u-gercek-milyem" Etiket="@Dil.T.Urun.GercekMilyem"
              @bind-Deger="yeniGercekMilyem" Ipucu="@Dil.T.Urun.GercekMilyemIpucu" Durum="form" HataAlani="u-gercek-milyem" />
        }
        @if (yeniTip == "PIRLANTA")
        {
            <fieldset class="form-grid-2" id="u-4c">
                <legend class="metin-kucuk">@Dil.T.Urun.DortC</legend>
                <Sayi ElemanId="u-karat" Etiket="@Dil.T.Urun.Karat" EnAz="0.001m" EnCok="999" EnCokOndalik="3" @bind-Deger="yeniKarat" Durum="form" HataAlani="u-karat" />
                <div class="alan"><Secici ElemanId="u-renk"
        Etiket="@Dil.T.Urun.Renk"
        Secenekler="@(Renkler.Select(r => new SecenekOgesi(r, r)).ToList())"
        @bind-Deger="yeniRenk"
        BosSecenekMetni="—" /></div>
                <div class="alan"><Secici ElemanId="u-berraklik"
        Etiket="@Dil.T.Urun.Berraklik"
        Secenekler="@(Berrakliklar.Select(b => new SecenekOgesi(b, b)).ToList())"
        @bind-Deger="yeniBerraklik"
        BosSecenekMetni="—" /></div>
                <div class="alan"><Secici ElemanId="u-kesim"
        Etiket="@Dil.T.Urun.Kesim"
        Secenekler="@(Kesimler.Select(k => new SecenekOgesi(k, k)).ToList())"
        @bind-Deger="yeniKesim"
        BosSecenekMetni="—" /></div>
                <div class="alan"><Secici ElemanId="u-sert-kurum"
        Etiket="@Dil.T.Urun.SertifikaKurumu"
        Secenekler="@(Kurumlar.Select(k => new SecenekOgesi(k, k)).ToList())"
        @bind-Deger="yeniSertKurum"
        BosSecenekMetni="—" /></div>
                <Metin ElemanId="u-sert-no" Etiket="@Dil.T.Urun.SertifikaNo" EnFazla="@AlanSinirlari.UrunSertifikaNo"
                       Deger="@yeniSertNo" DegerChanged="@(v => yeniSertNo = v ?? "")" Durum="form" HataAlani="u-sert-no" />
            </fieldset>
        }
        @if (YeniTumAlanlar)
        {
        <div class="alan">
            <Secici ElemanId="u-birim"
                    Etiket="@Dil.T.Urun.Birim"
                    Secenekler="@(new List<SecenekOgesi> { new SecenekOgesi("ADET", Dil.T.Urun.BirimAdet), new SecenekOgesi("GRAM", Dil.T.Urun.BirimGram) })"
                    @bind-Deger="yeniBirim"
                    @bind-Deger:after="BirimDegisti" />
            @if (yeniBirim == "GRAM") { <span class="metin-soluk metin-kucuk" id="u-birim-ipucu">@Dil.T.Urun.BirimGramIpucu</span> }
        </div>
        }
        @if (YeniTumAlanlar)
        {
        <div class="form-grid-2">
            <Gram ElemanId="u-tas" Etiket="@Dil.T.Urun.TasAgirlik" Tur="AgirlikTuru.Tas" Brut="@yeniGram"
                  Deger="@yeniTas" DegerChanged="@(v => yeniTas = v ?? 0m)"
                  Durum="form" HataAlani="u-tas" />
        </div>
        }
        @* Kuyum Ticareti Yönetmeliği md.11/(e) — taş varsa köken ZORUNLU.
           Alanlar yalnız taş ağırlığı girildiğinde görünür; sunucu her hâlükârda
           doğrular (UI gizlemesi güvenlik değildir). *@
        @if (yeniTas > 0)
        {
            <div class="form-grid-2">
                <div class="alan">
                    <Secici ElemanId="u-tas-koken"
                            Etiket="@Dil.T.Urun.TasKokeni"
                            Secenekler="@(new List<SecenekOgesi> { new SecenekOgesi("DOGAL", Dil.T.Urun.TasKokenDogal), new SecenekOgesi("SENTETIK", Dil.T.Urun.TasKokenSentetik), new SecenekOgesi("LABORATUVAR_URETIMI", Dil.T.Urun.TasKokenLaboratuvar), new SecenekOgesi("YAPAY_URETIM", Dil.T.Urun.TasKokenYapay) })"
                            @bind-Deger="yeniTasKokeni"
                            BosSecenekMetni="—" />
                    <span class="metin-soluk metin-kucuk">@Dil.T.Urun.TasKokeniIpucu</span>
                </div>
                @if (YapayTas)
                {
                    <div class="alan">
                        <Secici ElemanId="u-tas-ibare"
                                Etiket="@Dil.T.Urun.TasIbaresi"
                                Secenekler="@(new List<SecenekOgesi> { new SecenekOgesi("sentetik", "sentetik"), new SecenekOgesi("laboratuvar üretimi", "laboratuvar üretimi"), new SecenekOgesi("yapay üretim", "yapay üretim") })"
                                @bind-Deger="yeniTasIbaresi"
                                BosSecenekMetni="@(Dil.T.Urun.TasIbaresiIpucu)" />
                    </div>
                }
            </div>
        }
        <div class="form-grid-2">
            @if (YeniTumAlanlar)
            {
            <Para ElemanId="u-iscilik" Etiket="@Dil.T.Islem.IscilikTutari" Tur="TutarTuru.SifirOlabilir"
                  Deger="@yeniIscilik" DegerChanged="@(v => yeniIscilik = v ?? 0m)"
                  Durum="form" HataAlani="u-iscilik" />
            }
            @* M1 (müşteri 16.10: "milyemi, çarpanı burada olacak, elimle müdahale edebileceğim") — yalnız altın. *@
            @if (YeniTumAlanlar && MadenAltin(yeniAyar))
            {
            <SatisMilyemiAlani ElemanId="u-satis-milyemi" Etiket="@Dil.T.Urun.SatisMilyemi"
                  @bind-Deger="yeniSatisMilyemi" Ipucu="@Dil.T.Urun.SatisMilyemiIpucu" Durum="form" HataAlani="u-satis-milyemi" />
            <Para ElemanId="u-fiyat-ofset" Etiket="@Dil.T.Urun.FiyatOfset" Tur="TutarTuru.Isaretli"
                  @bind-Deger="yeniFiyatOfset" Ipucu="@Dil.T.Urun.FiyatOfsetIpucu" Durum="form" HataAlani="u-fiyat-ofset" />
            <SatisMilyemiAlani ElemanId="u-alis-milyemi" Etiket="@Dil.T.Urun.AlisMilyemi"
                  @bind-Deger="yeniAlisMilyemi" Ipucu="@Dil.T.Urun.AlisMilyemiIpucu" Durum="form" HataAlani="u-alis-milyemi" />
            <KdvMatrahPayiAlani ElemanId="u-kdv-binde" Etiket="@Dil.T.Urun.KdvMatrahBinde" Birim="‰"
                  @bind-Deger="yeniKdvMatrahBinde" Ipucu="@Dil.T.Urun.KdvMatrahBindeIpucu" Durum="form" HataAlani="u-kdv-binde" />
            }
            @* Kıymetsiz madende (çelik) satış fiyatı ZORUNLU → basit modda da görünür. *@
            @if (YeniTumAlanlar || !MadenKiymetli(yeniAyar))
            {
            <Para ElemanId="u-satis-fiyati" Etiket="@Dil.T.Urun.SatisFiyati" Tur="TutarTuru.SifirOlabilir"
                  Zorunlu="@(!MadenKiymetli(yeniAyar))"
                  @bind-Deger="yeniSatisFiyati" Durum="form" HataAlani="u-satis-fiyati"
                  Ipucu="@Dil.T.Urun.SatisFiyatiIpucu" />
            }
        </div>
        @if (YeniTumAlanlar)
        {
        @* Kategori ve reyon API'de vardı ama ekranda hiç sorulmuyordu — kullanıcı
           ağacı kurabiliyor, ürünü ağaca BAĞLAYAMIYORDU. *@
        <div class="form-grid-2">
            <div class="alan">
                <Secici ElemanId="u-kategori"
                        Etiket="@KategoriEtiketi"
                        Secenekler="@(DuzKategoriler.Select(k => new SecenekOgesi(k.Id, k.Etiket)).ToList())"
                        @bind-Deger="yeniKategoriId"
                        BosSecenekMetni="—" />
            </div>
            <div class="alan">
                <Secici ElemanId="u-reyon"
                        Etiket="@ReyonEtiketi"
                        Secenekler="@(reyonlar.Select(r => new SecenekOgesi(r.Id, r.Ad)).ToList())"
                        @bind-Deger="yeniReyonId"
                        BosSecenekMetni="—" />
            </div>
        </div>
        <div class="alan">
            @* id VERİLDİ (paket 20): ekran testleri konsinye kutusunu "ilk
               checkbox" diye buluyordu; forma rodyum kutusu eklenince o varsayım
               kırıldı. Sıraya değil KİMLİĞE bağlanır (mevcut id'ler değişmez,
               yeni id "<önek>-<alan>" kalıbındadır). *@
            <Onay ElemanId="u-konsinye" Etiket="@Dil.T.Urun.Konsinye"
                  @bind-Deger="yeniKonsinye" Ipucu="@Dil.T.Urun.KonsinyeIpucu" />
        </div>
        @* Konsinye kapısı: sahibi ve birim bedeli olmadan KAYDEDİLEMEZ.
           Sunucu da reddeder; buradaki alanlar kullanıcıyı hataya düşürmemek için. *@
        @if (yeniKonsinye)
        {
            <div class="form-grid-2">
                <div class="alan">
                    <Secici ElemanId="u-kons-cari"
                            Etiket="@Dil.T.Urun.KonsinyeSahibi"
                            Secenekler="@CariSecenekleri"
                            @bind-Deger="yeniKonsinyeCariId"
                            BosSecenekMetni="—" />
                </div>
                <Para ElemanId="u-kons-bedel" Etiket="@Dil.T.Urun.KonsinyeBirimBedel" Tur="TutarTuru.Pozitif"
                      @bind-Deger="yeniKonsinyeBedel" Durum="form" HataAlani="u-kons-bedel" />
            </div>
        }
        @* ═══ PAKET P-10 (Y-3) — SUNUCUNUN KABUL ETTİĞİ AMA FORMDA OLMAYAN ALANLAR ═══
           UrunOlusturDto bu beş alanı BAŞINDAN BERİ kabul ediyordu; ekran hiç
           göndermiyordu, yani kullanıcı ürünü açarken giremiyor, "sonra
           düzenlemeden gir" bile diyemiyordu (UX-S26 ihlali). *@
        <Metin ElemanId="u-aciklama" Etiket="@P4.AciklamaEtiketi" EnFazla="@AlanSinirlari.UrunAciklama"
               Deger="@yeniAciklama" DegerChanged="@(v => yeniAciklama = v ?? "")" Durum="form" HataAlani="u-aciklama" />
        <div class="form-grid-2">
            <div class="alan">
                <Secici ElemanId="u-parite"
                        Etiket="@P4.PariteEtiketi"
                        Secenekler="@PariteSecenekOgeleri"
                        @bind-Deger="yeniPariteKodu"
                        BosSecenekMetni="—" />
                <span class="metin-soluk metin-kucuk" id="u-parite-ipucu">@P4.PariteIpucu</span>
            </div>
        </div>
        @* PAKET YASAL-4 / Y4-C: KMTS alanı varsayılan GİZLİ (kiracı ayarı kmtsKullanimi
           kapalı). Açıkken yalnız PRO'da, kapalı "Ek bilgiler" katlanırında; BASİT'te hiç. *@
        @if (KmtsGorunur)
        {
            <Katlanir Id="u-ek-bilgiler" Baslik="@Y4U.KmtsEkBilgiler">
                <Metin ElemanId="u-kmts" Etiket="@Dil.T.Urun.KmtsKodu" EnFazla="@AlanSinirlari.UrunKmts"
                       Deger="@yeniKmtsKodu" DegerChanged="@(v => yeniKmtsKodu = v ?? "")"
                       Ipucu="@Y4U.KmtsIpucu" Durum="form" HataAlani="u-kmts" />
            </Katlanir>
        }
        <div class="form-grid-2">
            @* RİSK BEYANI (plan § 2 P-10, kurucu kalemi K-21): alan donanım İMA EDER. *@
            <Metin ElemanId="u-rfid" Etiket="@Dil.T.Urun.Rfid" EnFazla="@AlanSinirlari.UrunRfid"
                   Deger="@yeniRfid" DegerChanged="@(v => yeniRfid = v ?? "")"
                   Ipucu="@Dil.T.Urun.RfidIpucu" Durum="form" HataAlani="u-rfid" />
            <Metin ElemanId="u-gorsel-url" Etiket="@Dil.T.Urun.GorselUrl" EnFazla="@AlanSinirlari.UrunGorselUrl"
                   Deger="@yeniGorselUrl" DegerChanged="@(v => yeniGorselUrl = v ?? "")"
                   Durum="form" HataAlani="u-gorsel-url"
                   Ipucu="@Dil.T.Urun.GorselUrlIpucu" />
        </div>
        @* ═══ PAKET P-16 (Y-26) — TEDARİK / MALİYET / STOK ALANLARI ═══════════
           UX-S26: sunucunun OLUŞTURMADA kabul ettiği yedi alan "sonra düzenle"
           diye ertelenmez; düzenleme çekmecesinde de AYNI küme vardır.
           UX-S21: KDV oranı boş bırakılırsa üründen türetilir — ekran oran UYDURMAZ. *@
        <fieldset class="form-grid-2" id="u-p16">
            <legend>@Dil.T.Urun.KartBolumu</legend>
            <div class="alan">
                <Secici ElemanId="u-tedarikci"
                        Etiket="@Dil.T.Urun.Tedarikci"
                        Secenekler="@CariSecenekleri"
                        @bind-Deger="yeniTedarikciId"
                        BosSecenekMetni="—" />
                <span class="metin-soluk metin-kucuk" id="u-tedarikci-ipucu">@Dil.T.Urun.TedarikciIpucu</span>
            </div>
            <div class="alan">
                <Para ElemanId="u-alis-maliyeti" Etiket="@Dil.T.Urun.AlisMaliyeti" Tur="TutarTuru.SifirOlabilir"
                      @bind-Deger="yeniAlisMaliyeti" Durum="form" HataAlani="u-alis-maliyeti"
                      Ipucu="@Dil.T.Urun.AlisMaliyetiIpucu" />
                @if (yeniAlisMaliyeti is null)
                {
                    <span class="metin-amber metin-kucuk" id="u-alis-maliyeti-uyari">@Dil.T.Urun.AlisMaliyetiYok</span>
                }
            </div>
            <Yuzde ElemanId="u-hedef-marj" Etiket="@Dil.T.Urun.HedefMarj" Marj="true" Birim="%"
                  @bind-Deger="yeniHedefMarj" Durum="form" HataAlani="u-hedef-marj"
                  Ipucu="@Dil.T.Urun.HedefMarjIpucu" />
            <Yuzde ElemanId="u-kdv-orani" Etiket="@Dil.T.Urun.KdvOrani" Birim="%"
                  @bind-Deger="yeniKdvOrani" Durum="form" HataAlani="u-kdv-orani"
                  Ipucu="@Dil.T.Urun.KdvOraniIpucu" />
            <Metin ElemanId="u-seri-no" Etiket="@Dil.T.Urun.SeriNo" EnFazla="@AlanSinirlari.UrunSeriNo"
                   Deger="@yeniSeriNo" DegerChanged="@(v => yeniSeriNo = v ?? "")" Durum="form" HataAlani="u-seri-no" />
            <Metin ElemanId="u-olcu" Etiket="@Dil.T.Urun.Olcu" EnFazla="@AlanSinirlari.UrunOlcu"
                   Deger="@yeniOlcu" DegerChanged="@(v => yeniOlcu = v ?? "")"
                   Ipucu="@Dil.T.Urun.OlcuIpucu" Durum="form" HataAlani="u-olcu" />
            <Sayi ElemanId="u-min-stok" Etiket="@Dil.T.Urun.MinStok" EnAz="0" TamSayi="@(yeniBirim != "GRAM")" EnCokOndalik="3"
                  @bind-Deger="yeniMinStok" Durum="form" HataAlani="u-min-stok"
                  Ipucu="@Dil.T.Urun.MinStokIpucu" />
        </fieldset>
        }
        @* ═══ S3-3 — BASİT MODDA FORM ≤ 8 ALAN (taslak n3, S3-2 şablonu) ═══
           Görünen: ad · kod · barkod · ürün grubu · maden · ayar · gram · açılış stoğu.
           Kural kapısı olan alanlar HİÇ katlanmaz: taş varsa köken (md.11/e),
           pırlantada 4C (karat zorunlu), çelikte satış fiyatı. Gizlemek silmek
           değildir: katlı alanın değeri korunur, hata düşerse grup kendiliğinden açılır. *@
        @* PAKET GOC-C: "Daha fazla" iki modda da (PRO da zorunlularla açılır). *@
        <button @onclick="() => yeniDahaFazla = !yeniDahaFazla" type="button" class="dugme dugme-ikincil dugme-kucuk form-daha-fazla" id="u-daha-fazla"
                aria-expanded="@(yeniDahaFazla ? "true" : "false")">
            @(yeniDahaFazla ? $"{L.DahaAz} ▴" : $"{L.DahaFazla} ({L.DahaFazlaIcerik}) ▾")
        </button>

    </div>
    </ChildContent>
    <Altlik>
        @* URUN-ACILIS-ATOMIK tur 2 (tasarım hakemi KRİTİK): BASİT modda Kaydet'e basınca
           form uzuyor, hata bandı ve Kaydet ekran DIŞINDA kalıyordu (sessiz etkisizlik).
           Bant, kilit sebebi ve düğmeler ortak ModalPencere'nin SABİT altlığına (P-36)
           taşındı — Banka dekont penceresiyle aynı kalıp: gövde kayar, sonuç her zaman
           görünür. Kimlikler (u-kaydet, u-kaydet-kilit) AYNI; bant yeni kimlik u-urun-hata. *@
        <HataBandi Mesaj="@modalHata" Id="u-urun-hata" />
        @if (UrunKilitSebebi is { } kilit)
        {
            <span class="metin-kucuk metin-amber zo-alt-sebep" id="u-kaydet-kilit">@kilit</span>
        }
        <div class="satir zo-alt-dugmeler">
            <button class="btn btn-ikincil esnek" @onclick="() => yeniModalAcik = false"><Kuyumcu.Web.Bilesenler.Yildiz.YildizVazgec /></button>
            @* DoD EK md.3 / QA turu 2 YÜKSEK ("boş ve gram=-5 kayıt sessizce etkisiz"):
               ad · kod · gram artık düğmeyi KİLİTLEMEZ — tıklanır ve alan altında
               Türkçe mesaj çıkar. Kilit YALNIZ mevzuat/iş kuralı kapılarında kalır
               (4C karat, taş kökeni, konsinye üçlüsü) ve sebebi altında YAZAR. *@
            <button id="u-kaydet" class="btn btn-birincil esnek" disabled="@(kaydediliyor || UrunKilitSebebi is not null)"
                    @onclick="UrunOlustur">@Dil.T.Ortak.Kaydet</button>
        </div>
    </Altlik>
</ModalPencere>

@* ── Şube stokları modalı ── *@
<ModalPencere Acik="stokUrunId is not null" Baslik="@Dil.T.Urun.SubeStoklari" Kapat="() => stokUrunId = null">
    <HataBandi Mesaj="@subeHata" Id="urun-sube-hata" />
    @if (stokHata is not null)
    {
        <HataBandi Mesaj="@stokHata" />
    }
    else if (stoklar.Count == 0)
    {
        <BosDurum Mesaj="@Dil.T.Urun.StokYok" />
        @* UX-S25/S30: "düğme yok" yetmez, NEDEN yok ve DOĞRU YOL ne, yazılır.
           Stok bu ekrandan elle yazılamaz; her stok değişikliği deftere ve
           maliyet partisine düşmek zorundadır (HareketFabrikasi tek kapı). *@
        <DegismezIpucu Varlik="UrunStok" Gerekce="@Dil.T.Duzeltme.SistemGerekce"
                       AlternatifYol="@Dil.T.Urun.StokGirisiYolu" />
    }
    else
    {
        @* PAKET GOC-C — ORTAK IZGARA (grid:urunler:urun-stok). Ürünün TÜM şube stokları → yerel sıralama.
           Adet tr-TR (eskiden kültürsüz "0.###"). KartListe kimliği (urun-hareket-liste) korunur. *@
        <Izgara T="StokVeri" Ekran="urunler" GridId="urun-stok" KartListeId="urun-hareket-liste"
                Kolonlar="@StokKolonlari" Ogeler="@IzgaraYerelSiralama.Uygula(stoklar, stokSira, StokKolonlari)"
                Baslik="@Dil.T.Urun.SubeStoklari"
                SiralamaDegisti="@(x => stokSira = x)" GecerliSiralama="@stokSira" />
    }

    @* ── YERLEŞİM (PAKET 25) ─────────────────────────────────────────────────
       Şube toplamı `stoklar`dan gelir, reyon kırılımı yerleşimden; ATANMAMIŞ
       satırı VURGULU ve ayrıdır — gizlenmez (geçiş verisi dürüstlüğü). *@
    <div class="dikey-bosluk" id="urun-yerlesim">
        <h3>@Dil.T.Yerlesim.Baslik</h3>
        <p class="metin-kucuk metin-soluk">@Dil.T.Yerlesim.Aciklama</p>
        @if (yerlesimHata is not null)
        {
            <HataBandi Mesaj="@yerlesimHata" Id="yerlesim-hata" />
        }
        else if (yerlesimSubeler.Count == 0)
        {
            <BosDurum Mesaj="@Dil.T.Yerlesim.YerlesimYok" />
        }
        else
        {
            @foreach (var sb in yerlesimSubeler)
            {
                <div class="kart" id="@($"yerlesim-sube-{sb.SubeId}")">
                    <div class="kart-baslik satir-arasi">
                        <h4>@sb.SubeAdi</h4>
                        <span class="metin-kucuk metin-soluk">
                            @Dil.T.Yerlesim.StokAdedi: @Bicim.Miktar(sb.StokAdedi, null)
                        </span>
                    </div>
                    <div class="kart-govde">
                        @* KESIF-P4 tur 2 (#14): iki sütunlu veri tablosu 375 px'te `min-width:
                           max-content` yüzünden genişliyor, ADET sütunu ekran dışına düşüyor ve
                           uzun reyon adı kesiliyordu. Ad + adet LİSTE SATIRI: ad kalan yere
                           SARAR, adet sağda sabit (panel-liste-satir--is · ad + tutar). *@
                        <ul class="panel-liste" id="urun-tas-liste" aria-label="@Dil.T.Yerlesim.Baslik">
                            <li class="panel-liste-satir panel-liste-satir--is metin-kucuk metin-soluk" aria-hidden="true">
                                <span class="panel-liste-ad">@Dil.T.Yerlesim.Reyon</span>
                                <span class="panel-liste-tutar">@Dil.T.Yerlesim.Adet</span>
                            </li>
                            @foreach (var ry in sb.Reyonlar ?? [])
                            {
                                <li class="panel-liste-satir panel-liste-satir--is">
                                    <span class="panel-liste-ad">@ry.ReyonAdi</span>
                                    <span class="panel-liste-tutar sayi">@Bicim.Miktar(ry.Adet, null)</span>
                                </li>
                            }
                            <li class="panel-liste-satir panel-liste-satir--is hucre-vurgu" id="@($"yerlesim-atanmamis-{sb.SubeId}")">
                                <span class="panel-liste-ad">@Dil.T.Yerlesim.Atanmamis</span>
                                <span class="panel-liste-tutar sayi">@Bicim.Miktar(sb.Atanmamis, null)</span>
                            </li>
                        </ul>
                        @* KESIF-P4 #14: uzun açıklama tablo hücresinde kırılmadan sütunu
                           genişletiyor, pencere kenarında kesiliyor ve Adet sütununu
                           görünmez kılıyordu. Açıklama tablonun ALTINDA, sarılan paragraf. *@
                        <p class="metin-kucuk metin-soluk" id="@($"yerlesim-atanmamis-ipucu-{sb.SubeId}")">@Dil.T.Yerlesim.AtanmamisIpucu</p>

                        @* DoD: düğme ya istek atar ya DISABLED + sebep. *@
                        @* KESIF-P4 #14: Reyon ve Adet kutuları ızgaranın DOĞRUDAN çocuğu —
                           ara .alan sarmalayıcısı alt ızgara raylarını bozup Adet kutusunu
                           23 px aşağı itiyordu. Aşım uyarısı ızgaranın altına alındı. *@
                        <div class="form-grid-2">
                                <Secici ElemanId="@($"yer-reyon-{sb.SubeId}")"
                                        Etiket="@Dil.T.Yerlesim.Reyon"
                                        Secenekler="@(reyonSecenekleri.Where(x => x.SubeId == sb.SubeId && x.Aktif).Select(ar => new SecenekOgesi(ar.Id, ar.Ad)).ToList())"
                                        Deger="@YerReyonSecimi(sb.SubeId)"
                                        DegerChanged="@((string? _v) => YerReyonYaz(sb.SubeId, _v))"
                                        BosSecenekMetni="—" />
                                <Sayi ElemanId="@($"yer-adet-{sb.SubeId}")" Etiket="@Dil.T.Yerlesim.Adet" EnAz="0" TamSayi="@(!StokUrunuGramli)" EnCokOndalik="3"
                                      Deger="@YerAdetSecimi(sb.SubeId)"
                                      DegerChanged="@((decimal? _v) => YerAdetYaz(sb.SubeId, _v?.ToString(System.Globalization.CultureInfo.InvariantCulture)))" />
                        </div>
                        @if (YerAdetSecimi(sb.SubeId) > sb.Atanmamis)
                        {
                            <span class="metin-kucuk metin-hata" id="@($"yer-adet-asim-{sb.SubeId}")">
                                @Dil.T.Yerlesim.AdetAtanmamisiAsiyor
                            </span>
                        }
                        <button class="btn btn-birincil btn-kucuk" id="@($"yer-yerlestir-{sb.SubeId}")"
                                disabled="@(!YerlestirGecerli(sb))"
                                @onclick="() => Yerlestir(sb)">@Dil.T.Yerlesim.Yerlestir</button>
                        @if (!YerlestirGecerli(sb))
                        {
                            <span class="metin-kucuk metin-soluk" id="@($"yer-kilit-{sb.SubeId}")">
                                @YerlestirKilitSebebi(sb)
                            </span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</ModalPencere>

@* ── Ürün düzenleme modalı ──
   ⚠ Liste yalnız ÖZET taşır (açıklama, kategori, reyon, konsinye, KMTS kodu
   listede yok). Kartın tamamı çekilmeden kaydedilirse görünmeyen alanlar
   silinirdi — cari ekranında bu hata bizzat yaşandı. Bu yüzden düzenleme
   GET /urunler/{id} ile TAM KARTI çeker. *@
@* KESIF-P4 (#15/#16/#38 · TOPLU KATMAN-1b YÜKSEK): çekmece 480 px ve yazısı
   18 px; yarım sütuna düşen seçici değeri/etiketi kırılıyor, kutular hizadan
   kayıyordu. Çözüm SAYFA İŞARETLEMESİYLE: çekmecede her alan TAM GENİŞLİK
   (form-grid-2 → form-dikey). Ortak katman.css'e dokunulmadı (P7'nin). *@
<Cekmece Acik="duzenleAcik" Varlik="urun" Baslik="@Dil.T.Urun.UrunDuzenle"
         Kapat="() => duzenleAcik = false" Kaydet="UrunGuncelle"
         Kaydediliyor="@kaydediliyor"
         KaydetAktif="@(DuzenleKilitSebebi is null)"
         KilitSebebi="@DuzenleKilitSebebi">
    @if (duzenleYukleniyor)
    {
        <Yukleniyor />
    }
    else
    {
        <div class="form-dikey">
            <Metin ElemanId="d-ad" Etiket="@Dil.T.Urun.UrunAdi" Zorunlu="true" EnFazla="@AlanSinirlari.UrunAd"
                   Deger="@dAd" DegerChanged="@(v => dAd = v ?? "")"
                   Durum="form" HataAlani="d-ad" />
            <div class="form-dikey">
                @* PATCH-3 tur 2 (hakem KRİTİK): kod sunucuda ZORUNLU — etiket "(isteğe bağlı)"
                   basıp boş Kaydet'i sessizce reddetmek DoD EK (3) ihlaliydi. Yeni ürün
                   formundaki u-kod ile AYNI işaret (UX-S26). *@
                <Metin ElemanId="d-kod" Etiket="@Dil.T.Urun.Kod" Zorunlu="true" EnFazla="@AlanSinirlari.UrunKod"
                       Deger="@dKod" DegerChanged="@(v => dKod = v ?? "")"
                       Durum="form" HataAlani="d-kod" />
                <BarkodAlani ElemanId="d-barkod" Etiket="@Dil.T.Urun.Barkod"
                       Deger="@dBarkod" DegerChanged="@(v => dBarkod = v ?? "")" Durum="form" HataAlani="d-barkod" />
            </div>
            <div class="form-dikey">
                <div class="alan">
                    <Secici ElemanId="d-tip"
                            Etiket="@Dil.T.Urun.UrunGrubu"
                            Secenekler="@GrupSecenekleri"
                            @bind-Deger="dTip"
                            @bind-Deger:after="DuzenleTipDegisti" />
                </div>
                @* UX-S26 — düzenleme formu oluşturma formuyla AYNI alan kümesini
                   taşır: maden, saflık tablosu ve rodyum işareti burada da var. *@
                <div class="alan">
                    <Secici ElemanId="d-maden"
                            Etiket="@Dil.T.Urun.Maden"
                            Secenekler="@(Madenler.Select(m => new SecenekOgesi(m, KurKaynakAdi.MadenAdi(m))).ToList())"
                            @bind-Deger="dMaden"
                            @bind-Deger:after="DuzenleMadenDegisti"
                            Devredisi="@(TipinMadeni(dTip) is not null)"
                            DevredisiSebebi="@MadenKilitSebebi(dTip)" />
                </div>
                <div class="alan">
                    <Secici ElemanId="d-ayar"
                            Etiket="@Dil.T.Urun.Ayar"
                            Secenekler="@AyarSecenekleri(dMaden)"
                            @bind-Deger="dAyar"
                            @bind-Deger:after="DuzenleAyarDegisti" />
                    @if (DuzAdAyarUyarisi is { } dCeliski)
                    {
                        <span class="metin-kucuk metin-amber" id="d-ayar-celiski" role="status">@dCeliski</span>
                    }
                </div>
                @if (DuzTumAlanlar)
                {
                <Onay ElemanId="d-rodyum" Etiket="@Dil.T.Urun.RodyumKaplama"
                      @bind-Deger="dRodyum"
                      Devredisi="@(!RodyumKaplanabilir(dMaden))"
                      DevredisiSebebi="@Dil.T.Urun.RodyumKaplanmaz"
                      Ipucu="@Dil.T.Urun.RodyumKaplamaIpucu" />
                }
            </div>
            @* ── QA turu 1 ve 2 YÜKSEK: "Düzenle formu Gerçek Milyem ve Birim
                 alanlarını içermiyor" (UX-S26: oluşturma formu ile düzenleme formu
                 AYNI alan kümesini taşır). Sunucu ikisini de BAŞINDAN BERİ kabul
                 ediyordu (UrunGuncelleDto.GercekMilyem / .Birim) — eksik olan
                 yalnız giriş alanıydı. ── *@
            @if (DuzTumAlanlar)
            {
            <Milyem ElemanId="d-gercek-milyem" Etiket="@Dil.T.Urun.GercekMilyem"
                  @bind-Deger="dGercekMilyem" Durum="form" HataAlani="d-gercek-milyem"
                  Ipucu="@Dil.T.Urun.GercekMilyemIpucu" />
            <div class="alan">
                <Secici ElemanId="d-birim"
                        Etiket="@Dil.T.Urun.Birim"
                        Secenekler="@(new List<SecenekOgesi> { new SecenekOgesi("ADET", Dil.T.Urun.BirimAdet), new SecenekOgesi("GRAM", Dil.T.Urun.BirimGram) })"
                        @bind-Deger="dBirim"
                        @bind-Deger:after="DuzenleBirimDegisti" />
                @if (dBirim == "GRAM")
                {
                    <span class="metin-soluk metin-kucuk" id="d-birim-ipucu">@Dil.T.Urun.BirimGramIpucu</span>
                }
            </div>
            }
            <div class="form-dikey">
                @* PATCH-3 tur 2 (hakem KRİTİK, K18): ADET biriminde gram ZORUNLU (UrunGuncelle
                   form.Pozitif) — etiket birime göre değişir, "isteğe bağlı" çelişkisi yok. *@
                <Gram ElemanId="d-gram" Etiket="@Dil.T.Urun.GramAgirlik" Tur="@(dBirim == "GRAM" ? (AgirlikTuru?)null : AgirlikTuru.Gram)"
                      Zorunlu="@(dBirim != "GRAM")"
                      Deger="@(dGramBos ? (decimal?)null : dGram)" DegerChanged="DGramDegisti"
                      Devredisi="@(dBirim == "GRAM")" DevredisiSebebi="@Dil.T.Urun.BirimGramIpucu"
                      Durum="form" HataAlani="d-gram" />
                @if (DuzTumAlanlar)
                {
                <Gram ElemanId="d-tas" Etiket="@Dil.T.Urun.TasAgirlik" Tur="AgirlikTuru.Tas" Brut="@(dGramBos ? null : dGram)"
                      Deger="@dTas" DegerChanged="@(v => dTas = v ?? 0m)" Durum="form" HataAlani="d-tas" />
                }
            </div>
            @if (dTas > 0)
            {
                <div class="form-dikey">
                    <div class="alan">
                        <Secici ElemanId="d-tas-koken"
                                Etiket="@Dil.T.Urun.TasKokeni"
                                Secenekler="@(new List<SecenekOgesi> { new SecenekOgesi("DOGAL", Dil.T.Urun.TasKokenDogal), new SecenekOgesi("SENTETIK", Dil.T.Urun.TasKokenSentetik), new SecenekOgesi("LABORATUVAR_URETIMI", Dil.T.Urun.TasKokenLaboratuvar), new SecenekOgesi("YAPAY_URETIM", Dil.T.Urun.TasKokenYapay) })"
                                @bind-Deger="dTasKokeni"
                                BosSecenekMetni="—" />
                    </div>
                    <Metin ElemanId="d-tas-ibare" Etiket="@Dil.T.Urun.TasIbaresi" EnFazla="@AlanSinirlari.UrunTasIbaresi"
                           Deger="@dTasIbaresi" DegerChanged="@(v => dTasIbaresi = v ?? "")" Durum="form" HataAlani="d-tas-ibare" />
                </div>
            }
            @if (DuzTumAlanlar)
            {
            <div class="form-dikey">
                <div class="alan">
                    <Secici ElemanId="d-kategori"
                            Etiket="@Dil.T.Urun.Kategori"
                            Secenekler="@(DuzKategoriler.Select(k => new SecenekOgesi(k.Id, k.Etiket)).ToList())"
                            @bind-Deger="dKategoriId"
                            BosSecenekMetni="—" />
                </div>
                <div class="alan">
                    <Secici ElemanId="d-reyon"
                            Etiket="@Dil.T.Urun.Reyon"
                            Secenekler="@(reyonlar.Select(r => new SecenekOgesi(r.Id, r.Ad)).ToList())"
                            @bind-Deger="dReyonId"
                            BosSecenekMetni="—" />
                </div>
            </div>
            }
            <div class="form-dikey">
                @if (DuzTumAlanlar)
                {
                <Para ElemanId="d-iscilik" Etiket="@Dil.T.Islem.IscilikTutari" Tur="TutarTuru.SifirOlabilir"
                      Deger="@dIscilik" DegerChanged="@(v => dIscilik = v ?? 0m)" Durum="form" HataAlani="d-iscilik" />
                }
                @if (DuzTumAlanlar && MadenAltin(dAyar))
                {
                <SatisMilyemiAlani ElemanId="d-satis-milyemi" Etiket="@Dil.T.Urun.SatisMilyemi"
                      @bind-Deger="dSatisMilyemi" Ipucu="@Dil.T.Urun.SatisMilyemiIpucu" Durum="form" HataAlani="d-satis-milyemi" />
                <Para ElemanId="d-fiyat-ofset" Etiket="@Dil.T.Urun.FiyatOfset" Tur="TutarTuru.Isaretli"
                      @bind-Deger="dFiyatOfset" Ipucu="@Dil.T.Urun.FiyatOfsetIpucu" Durum="form" HataAlani="d-fiyat-ofset" />
                <SatisMilyemiAlani ElemanId="d-alis-milyemi" Etiket="@Dil.T.Urun.AlisMilyemi"
                      @bind-Deger="dAlisMilyemi" Ipucu="@Dil.T.Urun.AlisMilyemiIpucu" Durum="form" HataAlani="d-alis-milyemi" />
                <KdvMatrahPayiAlani ElemanId="d-kdv-binde" Etiket="@Dil.T.Urun.KdvMatrahBinde" Birim="‰"
                      @bind-Deger="dKdvMatrahBinde" Ipucu="@Dil.T.Urun.KdvMatrahBindeIpucu" Durum="form" HataAlani="d-kdv-binde" />
                }
                @* Kıymetsiz madende satış fiyatı ZORUNLU → basit modda da görünür. *@
                @if (DuzTumAlanlar || !MadenKiymetli(dAyar))
                {
                <Para ElemanId="d-satis" Etiket="@Dil.T.Urun.SatisFiyati" Tur="TutarTuru.SifirOlabilir"
                      Zorunlu="@(!MadenKiymetli(dAyar))"
                      @bind-Deger="dSatisFiyati" Durum="form" HataAlani="d-satis" />
                }
            </div>
            @* ── 4C / sertifika (paket 4) — A16 kalan açığı: uç (PATCH /urunler/{id})
                 4C alanlarını zaten kabul ediyordu, düzenleme ekranında GİRİŞİ YOKTU.
                 ⚠ PATCH sözleşmesi: boş bırakılan alan NULL gider = "dokunma"
                 (UrunModulu.Guncelle satır ~515). Değer SİLMEK bu ekrandan yapılamaz. ── *@
            @if (dTip == "PIRLANTA")
            {
                <div class="form-dikey">
                    <Sayi ElemanId="d-karat" Etiket="@Dil.T.Urun.Karat" EnAz="0.001m" EnCok="999" EnCokOndalik="3" @bind-Deger="dKarat" Durum="form" HataAlani="d-karat" />
                    <div class="alan">
                        <Secici ElemanId="d-renk"
                                Etiket="@Dil.T.Urun.Renk"
                                Secenekler="@(Renkler.Select(r => new SecenekOgesi(r, r)).ToList())"
                                @bind-Deger="dRenk"
                                BosSecenekMetni="—" />
                    </div>
                </div>
                <div class="form-dikey">
                    <div class="alan">
                        <Secici ElemanId="d-berraklik"
                                Etiket="@Dil.T.Urun.Berraklik"
                                Secenekler="@(Berrakliklar.Select(b => new SecenekOgesi(b, b)).ToList())"
                                @bind-Deger="dBerraklik"
                                BosSecenekMetni="—" />
                    </div>
                    <div class="alan">
                        <Secici ElemanId="d-kesim"
                                Etiket="@Dil.T.Urun.Kesim"
                                Secenekler="@(Kesimler.Select(s => new SecenekOgesi(s, s)).ToList())"
                                @bind-Deger="dKesim"
                                BosSecenekMetni="—" />
                    </div>
                </div>
                <div class="form-dikey">
                    <div class="alan">
                        <Secici ElemanId="d-sert-kurum"
                                Etiket="@Dil.T.Urun.SertifikaKurumu"
                                Secenekler="@(Kurumlar.Select(s => new SecenekOgesi(s, s)).ToList())"
                                @bind-Deger="dSertKurum"
                                BosSecenekMetni="—" />
                    </div>
                    <Metin ElemanId="d-sert-no" Etiket="@Dil.T.Urun.SertifikaNo" EnFazla="@AlanSinirlari.UrunSertifikaNo"
                           Deger="@dSertNo" DegerChanged="@(v => dSertNo = v ?? "")" Durum="form" HataAlani="d-sert-no" />
                </div>
            }

            @if (DuzTumAlanlar)
            {
            @* ═══ PAKET P-10 (Y-3) — OLUŞTURMA FORMUYLA AYNI ALAN KÜMESİ (UX-S26) ═══ *@
            <Metin ElemanId="d-aciklama" Etiket="@P4.AciklamaEtiketi" EnFazla="@AlanSinirlari.UrunAciklama"
                   Deger="@dAciklama" DegerChanged="@(v => dAciklama = v ?? "")" Durum="form" HataAlani="d-aciklama" />
            <div class="form-dikey">
                <div class="alan">
                    <Secici ElemanId="d-parite"
                            Etiket="@P4.PariteEtiketi"
                            Secenekler="@PariteSecenekOgeleri"
                            @bind-Deger="dPariteKodu"
                            BosSecenekMetni="—" />
                    <span class="metin-soluk metin-kucuk" id="d-parite-ipucu">@P4.PariteIpucu</span>
                </div>
            </div>
            @* PAKET YASAL-4 / Y4-C: yeni formla AYNI kural (UX-S26) — ayar kapalıyken alan yok,
               PATCH'te kmtsKodu GÖNDERİLMEZ (null = koru; kayıtlı kod silinmez). *@
            @if (KmtsGorunur)
            {
                <Katlanir Id="d-ek-bilgiler" Baslik="@Y4U.KmtsEkBilgiler">
                    <Metin ElemanId="d-kmts" Etiket="@Dil.T.Urun.KmtsKodu" EnFazla="@AlanSinirlari.UrunKmts"
                           Deger="@dKmtsKodu" DegerChanged="@(v => dKmtsKodu = v ?? "")"
                           Ipucu="@Y4U.KmtsIpucu" Durum="form" HataAlani="d-kmts" />
                </Katlanir>
            }
            <div class="form-dikey">
                <Metin ElemanId="d-rfid" Etiket="@Dil.T.Urun.Rfid" EnFazla="@AlanSinirlari.UrunRfid"
                       Deger="@dRfid" DegerChanged="@(v => dRfid = v ?? "")"
                       Ipucu="@Dil.T.Urun.RfidIpucu" Durum="form" HataAlani="d-rfid" />
                <Metin ElemanId="d-gorsel-url" Etiket="@Dil.T.Urun.GorselUrl" EnFazla="@AlanSinirlari.UrunGorselUrl"
                       Deger="@dGorselUrl" DegerChanged="@(v => dGorselUrl = v ?? "")"
                       Durum="form" HataAlani="d-gorsel-url"
                       Ipucu="@Dil.T.Urun.GorselUrlIpucu" />
            </div>
            }

            @* S3-3: konsinye kartında (sahip + bedel kural kapısı) alan basit modda da açık. *@
            @if (DuzTumAlanlar || dKonsinye)
            {
            @* ── Konsinye (paket UX-4b madde 6) ──────────────────────────────
                 Bu alanlar düzenleme modalında YOKTU: gövdede gitmedikleri için
                 sunucu konsinye=false alıyor, sahibi ve bedeli SESSİZCE
                 siliniyordu. Artık hem gösterilir hem gönderilir. ── *@
            <Onay ElemanId="d-konsinye" Etiket="@Dil.T.Urun.Konsinye"
                  @bind-Deger="dKonsinye" Ipucu="@Dil.T.Urun.KonsinyeIpucu" />
            @if (dKonsinye)
            {
                <div class="form-dikey">
                    <div class="alan">
                        <Secici ElemanId="d-kons-cari"
                                Etiket="@Dil.T.Urun.KonsinyeSahibi"
                                Secenekler="@CariSecenekleri"
                                @bind-Deger="dKonsinyeCariId"
                                BosSecenekMetni="—" />
                    </div>
                    <Para ElemanId="d-kons-bedel" Etiket="@Dil.T.Urun.KonsinyeBirimBedel" Tur="TutarTuru.Pozitif"
                          @bind-Deger="dKonsinyeBedel" Durum="form" HataAlani="d-kons-bedel" />
                </div>
            }
            }

            @* ═══ PAKET P-16 (Y-26) — OLUŞTURMA FORMUYLA AYNI ALAN KÜMESİ (UX-S26) ═══
               Seçenek listeleri TEK diziden (cariler) üretilir; iki formda iki
               farklı küme olamaz. *@
            @if (DuzTumAlanlar)
            {
            <fieldset class="form-dikey" id="d-p16">
                <legend>@Dil.T.Urun.KartBolumu</legend>
                <div class="alan">
                    <Secici ElemanId="d-tedarikci"
                            Etiket="@Dil.T.Urun.Tedarikci"
                            Secenekler="@CariSecenekleri"
                            @bind-Deger="dTedarikciId"
                            BosSecenekMetni="—" />
                    <span class="metin-soluk metin-kucuk" id="d-tedarikci-ipucu">@Dil.T.Urun.TedarikciIpucu</span>
                </div>
                <div class="alan">
                    <Para ElemanId="d-alis-maliyeti" Etiket="@Dil.T.Urun.AlisMaliyeti" Tur="TutarTuru.SifirOlabilir"
                          @bind-Deger="dAlisMaliyeti" Durum="form" HataAlani="d-alis-maliyeti"
                          Ipucu="@Dil.T.Urun.AlisMaliyetiIpucu" />
                    @if (dAlisMaliyeti is null)
                    {
                        <span class="metin-amber metin-kucuk" id="d-alis-maliyeti-uyari">@Dil.T.Urun.AlisMaliyetiYok</span>
                    }
                </div>
                <Yuzde ElemanId="d-hedef-marj" Etiket="@Dil.T.Urun.HedefMarj" Marj="true" Birim="%"
                      @bind-Deger="dHedefMarj" Durum="form" HataAlani="d-hedef-marj"
                      Ipucu="@Dil.T.Urun.HedefMarjIpucu" />
                <Yuzde ElemanId="d-kdv-orani" Etiket="@Dil.T.Urun.KdvOrani" Birim="%"
                      @bind-Deger="dKdvOrani" Durum="form" HataAlani="d-kdv-orani"
                      Ipucu="@Dil.T.Urun.KdvOraniIpucu" />
                <Metin ElemanId="d-seri-no" Etiket="@Dil.T.Urun.SeriNo" EnFazla="@AlanSinirlari.UrunSeriNo"
                       Deger="@dSeriNo" DegerChanged="@(v => dSeriNo = v ?? "")" Durum="form" HataAlani="d-seri-no" />
                <Metin ElemanId="d-olcu" Etiket="@Dil.T.Urun.Olcu" EnFazla="@AlanSinirlari.UrunOlcu"
                       Deger="@dOlcu" DegerChanged="@(v => dOlcu = v ?? "")"
                       Ipucu="@Dil.T.Urun.OlcuIpucu" Durum="form" HataAlani="d-olcu" />
                <Sayi ElemanId="d-min-stok" Etiket="@Dil.T.Urun.MinStok" EnAz="0" TamSayi="@(dBirim != "GRAM")" EnCokOndalik="3"
                      @bind-Deger="dMinStok" Durum="form" HataAlani="d-min-stok"
                      Ipucu="@Dil.T.Urun.MinStokIpucu" />
            </fieldset>
            }
            @if (Modu.BasitMi)
            {
                <button @onclick="() => duzDahaFazla = !duzDahaFazla" type="button" class="dugme dugme-ikincil dugme-kucuk form-daha-fazla" id="d-daha-fazla"
                        aria-expanded="@(duzDahaFazla ? "true" : "false")">
                    @(duzDahaFazla ? $"{L.DahaAz} ▴" : $"{L.DahaFazla} ({L.DahaFazlaIcerik}) ▾")
                </button>
            }

            @* ── Belge deposu (paket 4) — A16'nın "ürün düzenleme modalında
                 yükleme ekranı yok" açığını kapatır. Ürünün sertifikası artık
                 ekrandan yüklenip indirilebiliyor. ── *@
            @* S3-3: basit modda galeri + belge yükleyici de "Daha fazla ▾" arkasında
               (çekmecede görünen girdi ≤ 8; canlı ölçümde yükleyici 9. ve 10. girdiydi). *@
            @if (!string.IsNullOrEmpty(dId) && DuzTumAlanlar)
            {
                @* PAKET P-10 (Y-8): yüklenen GORSEL/FOTOGRAF belgeleri ve kart
                   adresi burada GÖRÜNÜR — depoda duruyor ama ekranda yoktu. *@
                <UrunGorselGalerisi UrunId="@dId" GorselUrl="@dGorselUrl" Onek="d-urun" />
                <BelgeYukleyici SahipTuru="URUN" SahipId="@dId" Onek="d-belge"
                                Turler="@UrunBelgeTurleri" />
            }
            <HataBandi Mesaj="@duzenleHata" Id="d-urun-hata" />
            @* Kaydet/İptal çekmecenin alt çubuğunda (#cekmece-urun-kaydet/-iptal);
               kilitliyse sebebi orada YAZAR (UX-S30). *@
        </div>
    }
</Cekmece>

@* ── Etiket modalı — md.11/(e) ── *@
<ModalPencere Acik="etiket is not null" Baslik="@Dil.T.Urun.Etiket" Kapat="() => etiket = null">
    @if (etiket is not null)
    {
        <div class="form-dikey">
            <div class="alan">
                <label>@Dil.T.Urun.EtiketMetni</label>
                <p class="hucre-vurgu">@etiket.EtiketMetni</p>
                @if (etiket.IbareZorunlu)
                {
                    <Rozet Renk="amber">@Dil.T.Urun.IbareZorunlu: @etiket.Ibare</Rozet>
                }
            </div>
            <div class="form-grid-2">
                <div class="alan"><label>@Dil.T.Urun.Barkod</label><p>@(etiket.Barkod ?? "—")</p></div>
                <div class="alan"><label>@Dil.T.Urun.Ayar</label><p id="u-etiket-ayar">@KurKaynakAdi.AyarAdi(etiket.AyarId)</p></div>
                <div class="alan"><label>@Dil.T.Urun.Milyem</label><p>@etiket.Milyem</p></div>
                <div class="alan"><label>@Dil.T.Urun.HasGram</label><p class="metin-amber">@Bicim.Has(etiket.HasGrami)</p></div>
            </div>
            <p class="metin-soluk metin-kucuk">@Dil.T.Urun.Dayanak: @etiket.Dayanak</p>
        </div>
    }
</ModalPencere>

@* ── Sayım düzeltme modalı ── *@
<ModalPencere Acik="sayimSube is not null" Baslik="@Dil.T.Urun.SayimDuzelt" Kapat="() => sayimSube = null">
    <div class="form-dikey">
        <div class="alan">
            <label>@Dil.T.Urun.Sube</label>
            <p class="metin-soluk metin-kucuk" id="s-sube">@SubeAdi(sayimSube)</p>
        </div>
        <div class="form-grid-2">
            <div class="alan">
                <label>@DilEkranSozlugu.KayitliAdet(Dil.Dil)</label>
                <p class="hucre-vurgu sayi">@sayimKayitli.ToString("0.###")</p>
            </div>
            @* GRAM üründe 1 adet = 1 gram (Entities.cs:206) → adet ondalık olabilir. *@
            <Sayi ElemanId="s-adet" Etiket="@Dil.T.Urun.SayilanAdet" EnAz="0" TamSayi="@(!StokUrunuGramli)" EnCokOndalik="3"
                  Deger="@sayimAdet" DegerChanged="@(v => sayimAdet = v ?? 0m)" />
        </div>
        <p class="metin-soluk metin-kucuk">@Dil.T.Urun.Fark: @((sayimAdet - sayimKayitli).ToString("+0.###;-0.###;0"))</p>
        <p class="metin-soluk metin-kucuk">@Dil.T.Urun.SayimIpucu</p>
        <HataBandi Mesaj="@sayimHata" />
        @if (sayiKapisi.Sebep(Dil.Dil, "s-") is { } sayimKilit)
        {
            <span class="metin-kucuk metin-amber" id="s-kaydet-kilit">@sayimKilit</span>
        }
        <div class="satir">
            <button class="btn btn-ikincil" style="flex:1" @onclick="() => sayimSube = null"><Kuyumcu.Web.Bilesenler.Yildiz.YildizVazgec /></button>
            <button class="btn btn-birincil" style="flex:1" disabled="@(kaydediliyor || sayiKapisi.OnekleVar("s-"))"
                    @onclick="SayimKaydet">@Dil.T.Ortak.Kaydet</button>
        </div>
    </div>
</ModalPencere>

@* ── Pasife alma onayı ──
   Silme DEĞİL: geçmiş hareketler duruyor, ürün yalnız yeni satışa kapanıyor. *@
