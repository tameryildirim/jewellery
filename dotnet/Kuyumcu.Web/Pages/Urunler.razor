@code {
    /// <summary>ORTAK-1 (KEŞİF #4): ortak geçersiz sayı kapısı — ön ekler: u- yeni · d- düzenle · s- sayım · yer-adet- yerleşim.</summary>
    private GecersizAlanKapisi? _sayiKapisi;
    private GecersizAlanKapisi sayiKapisi => _sayiKapisi ??= new(() => InvokeAsync(StateHasChanged));


    // ── PAKET 25 — yanıt şekilleri ORTAK sözleşmededir (S-2 dersi):
    //   Kuyumcu.Core/Sozlesmeler/YerlesimSozlesmeleri.cs

    private List<UrunYerlesimSubesi> yerlesimSubeler = [];
    private List<ReyonSatiri> reyonSecenekleri = [];
    private string? yerlesimHata;
    private readonly Dictionary<string, string> yerReyonId = [];
    private readonly Dictionary<string, decimal> yerAdet = [];

    private string YerReyonSecimi(string subeId) => yerReyonId.GetValueOrDefault(subeId, "");

    private void YerReyonYaz(string subeId, string? ham) => yerReyonId[subeId] = ham ?? "";
    private decimal YerAdetSecimi(string subeId) => yerAdet.GetValueOrDefault(subeId, 0m);

    private void YerAdetYaz(string subeId, string? ham) =>
        yerAdet[subeId] = decimal.TryParse(ham,
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0m;

    private bool YerlestirGecerli(UrunYerlesimSubesi sb) =>
        !kaydediliyor && !sayiKapisi.OnekleVar($"yer-adet-{sb.SubeId}") && !string.IsNullOrEmpty(YerReyonSecimi(sb.SubeId))
        && YerAdetSecimi(sb.SubeId) > 0m && YerAdetSecimi(sb.SubeId) <= sb.Atanmamis;

    /// <summary>UX-S30 — kilitli düğme eksik koşulu SÖYLER.</summary>
    private string YerlestirKilitSebebi(UrunYerlesimSubesi sb) =>
        sayiKapisi.Sebep(Dil.Dil, $"yer-adet-{sb.SubeId}") is { } sayiSebep ? sayiSebep :
        string.IsNullOrEmpty(YerReyonSecimi(sb.SubeId)) ? Dil.T.Yerlesim.HedefSecilmeli
        : YerAdetSecimi(sb.SubeId) <= 0m ? Dil.T.Yerlesim.AdetGecersiz
        : Dil.T.Yerlesim.AdetAtanmamisiAsiyor;

    // PAKET 20 / UX-S31 — ürün grubu listesi TEK KAYNAKTAN gelir.
    // Eskiden burada elle yazılı 7 elemanlı bir dizi vardı; API ise 11 grup
    // kabul ediyordu: PLATIN, PALADYUM, CELIK ve DEGERLI_TAS ürünleri ekrandan
    // HİÇ kaydedilemiyordu (vitrindeki platin alyans sisteme giremiyordu).
    private static readonly string[] Tipler = Kuyumcu.Core.Domain.UrunTipleri.Hepsi;

    // Maden listesi ve her madenin saflık (milyem) tablosu — aynı Core kaynağı;
    // sunucu da GET /urunler/madenler ucunda BUNU döner (K20-8).
    private static readonly string[] Madenler = Kuyumcu.Core.Domain.Maden.Hepsi;

    private static IReadOnlyList<Kuyumcu.Core.Domain.Ayar> MadenAyarlari(string maden) =>
        [.. Kuyumcu.Core.Domain.Ayarlar.MadeninAyarlari(maden)];

    private string KategoriEtiketi => $"{Dil.T.Urun.Kategori} ({Dil.T.Ortak.Opsiyonel})";
    private string ReyonEtiketi => $"{Dil.T.Urun.Reyon} ({Dil.T.Ortak.Opsiyonel})";

    // ── P-36c GÖÇ YARDIMCILARI ──────────────────────────────────────────
    // Razor ÖZNİTELİK DEĞERİ içinde iç içe çift tırnak ve `{ }` deseni
    // ayrıştırıcıyı bozar; seçenek/sebep üretimi bu yüzden @code tarafında
    // durur (tek yer kuralı: iki form da AYNI diziyi kullanır — UX-S26).
    // KESIF-P4 #79/#84: ham ayar kodu (K22) ekrana basılmaz — ad TEK kaynaktan
    // (KurKaynakAdi.AyarAdi → Core Ayarlar). Milyem yalnız PRO'da parantez içinde.
    // Seçenek DEĞERİ kod kalır: gövdedeki ayarId sözleşmesi değişmez.
    private IReadOnlyList<SecenekOgesi> AyarSecenekleri(string maden) =>
        [.. MadenAyarlari(maden).Select(a => new SecenekOgesi(a.Id, AyarSecenekMetni(a)))];

    private string AyarSecenekMetni(Kuyumcu.Core.Domain.Ayar a) =>
        Modu.ProfesyonelMi
            ? string.Format(P4.AyarMilyemKalibi, KurKaynakAdi.AyarAdi(a.Id),
                a.Milyem.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))
            : KurKaynakAdi.AyarAdi(a.Id);

    private KesifP4Metinleri P4 => KesifP4Sozlugu.Al(Dil.Dil);

    /// <summary>KESIF-P4 tur 2: barkod okutucunun ürettiği değer tek parçadır (boşluksuz).</summary>
    public static bool BarkodBicimindeMi(string s) => s.Length > 0 && !s.Any(char.IsWhiteSpace);

    /// <summary>
    /// KESIF-P4 tur 2 (#15): uzun cari unvanı (tedarikçi / konsinye sahibi) seçici
    /// kutusunda 2-3 satıra kırılıp kutu kenarlarına değiyordu. Seçenek ADI kısa
    /// unvandır (A.Ş., Ltd. Şti., San. ve Tic.; gerekirse sözcük sınırında "…"); TAM
    /// unvan alt bilgide görünür ve aranır. Değer (cari kimliği) DEĞİŞMEZ.
    /// Dört cari seçicisi TEK diziden beslenir (UX-S26).
    /// </summary>
    private List<SecenekOgesi> CariSecenekleri =>
        [.. cariler.Select(c => KisaUnvan(c.Ad) is var k && k != c.Ad
            ? new SecenekOgesi(c.Id, k, c.Ad)
            : new SecenekOgesi(c.Id, c.Ad))];

    public const int KisaUnvanTavan = 26;

    public static string KisaUnvan(string? ad)
    {
        var s = System.Text.RegularExpressions.Regex.Replace((ad ?? "").Trim(), @"\s+", " ");
        foreach (var (uzun, kisa) in UnvanKisaltmalari)
            s = System.Text.RegularExpressions.Regex.Replace(s, $@"(?<!\S){uzun}(?!\S)", kisa,
                System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);
        if (s.Length <= KisaUnvanTavan) return s;
        var kes = s.LastIndexOf(' ', KisaUnvanTavan - 1);
        return (kes > 0 ? s[..kes] : s[..(KisaUnvanTavan - 1)]).TrimEnd(' ', ',', '.') + "…";
    }

    // Ticaret unvanlarının yerleşik kısaltmaları (sıra önemli: uzun kalıp önce).
    private static readonly (string Uzun, string Kisa)[] UnvanKisaltmalari =
    [
        ("Anonim Şirketi", "A.Ş."), ("Limited Şirketi", "Ltd. Şti."),
        ("Sanayi ve Ticaret", "San. ve Tic."), ("Sanayi", "San."), ("Ticaret", "Tic."),
    ];

    /// <summary>UX-S30 — kilitli maden seçicisinin SEBEBİ; kilitli değilse null.</summary>
    /// S3-3: ham grup kodu ('PLATIN') ekrana basılmaz — grup adı sözlükten (UX-S31).
    private string? MadenKilitSebebi(string tip) =>
        TipinMadeni(tip) is { } m
            ? string.Format(L.MadenKilit, Grup.Ad(tip), KurKaynakAdi.MadenAdi(m).ToLowerInvariant())
            : null;

    private static bool RodyumKaplanabilir(string maden) =>
        Array.IndexOf(Kuyumcu.Core.Domain.Maden.RodyumKaplanabilir, maden) >= 0;

    private static bool MadenKiymetli(string ayarId) =>
        Kuyumcu.Core.Domain.Ayarlar.Bul(ayarId)?.Kiymetli ?? true;

    /// <summary>M1 — satış milyemi yalnız altında (sunucu SatisMilyemiKapisi ile aynı kural, K20-4).</summary>
    private static bool MadenAltin(string ayarId) =>
        (Kuyumcu.Core.Domain.Ayarlar.MadenBul(ayarId) ?? Kuyumcu.Core.Domain.Maden.Altin) == Kuyumcu.Core.Domain.Maden.Altin;

    /// <summary>Ürün grubunun dayattığı maden; yoksa null (grup serbest).</summary>
    private static string? TipinMadeni(string tip) => tip switch
    {
        "GUMUS" => Kuyumcu.Core.Domain.Maden.Gumus,
        "PLATIN" => Kuyumcu.Core.Domain.Maden.Platin,
        "PALADYUM" => Kuyumcu.Core.Domain.Maden.Paladyum,
        "CELIK" => Kuyumcu.Core.Domain.Maden.Celik,
        "ZIYNET" or "KULCE" or "HURDA" or "SIKKE" => Kuyumcu.Core.Domain.Maden.Altin,
        _ => null,
    };
    // UX-4c madde 10 / UX-S31 — ayar listesi TEK KAYNAKTAN gelir.
    // Eskiden bu dizi üç ekranda elle yazılıyordu ve içerikleri farklıydı
    // (emanette K995/G999 vardı, burada yoktu). Artık Kuyumcu.Core sabiti.
    private static readonly string[] Ayarlar = Kuyumcu.Core.Domain.Ayarlar.EkranSecenekleri;

    private List<UrunVeri> UrunListesi = [];

    // ── PAKET GOC-C — ortak ızgara kolonları (başlıklar sözlükten; anahtarlar kalıcı) ──
    private IzgaraSiralama? urunSira, stokSira;
    private bool UrunListesiTam => UrunListesi.Count < ListeSiniri;
    private IReadOnlyList<IzgaraKolonu<UrunVeri>> UrunKolonlari
    {
        get
        {
            var tam = UrunListesiTam;
            var k = new List<IzgaraKolonu<UrunVeri>>
            {
                // PAKET P-10 (Y-8): kapak görseli listede — "kuyumda mal görselle satılır".
                new() { Anahtar = "gorsel", Baslik = Dil.T.Urun.Gorsel, KartEtiketsiz = true,
                        Hucre = u => @<text>@if (!string.IsNullOrWhiteSpace(u.GorselUrl))
                            {
                                <img class="gorsel-kucuk" id="@($"u-gorsel-{u.Id}")" src="@u.GorselUrl" alt="@u.Ad" loading="lazy" />
                            }
                            else
                            {
                                <span class="metin-soluk katalog-tek-satir" id="@($"u-gorsel-yok-{u.Id}")" title="@Dil.T.Urun.GorselYok"><Ikon Ad="@Ikonlar.Urunler" Etiket="@Dil.T.Urun.GorselYok" /></span>
                            }</text> },
                new() { Anahtar = "ad", Baslik = Dil.T.Urun.UrunAdi, ZorunluGorunur = true, SunucuSiralamaAdi = tam ? "ad" : null,
                        HucreSinif = _ => "hucre-vurgu", Deger = u => u.Ad,
                        Hucre = u => @<text>@u.Ad
                            @* md.11/(e): ibare listede de AÇIKÇA görünür *@
                            @if (Ibare(u).Length > 0)
                            {
                                <Rozet Renk="mavi">@Ibare(u)</Rozet>
                            }
                            @if (Modu.BasitMi && !u.Aktif)
                            {
                                <span id="@($"u-pasif-rozet-{u.Id}")"><Rozet Renk="gri">@Dil.T.Ortak.Pasif</Rozet></span>
                            }</text> },
            };
            if (Modu.ProfesyonelMi)
            {
                // S3-3: basit modda barkod ve ürün grubu sütunu yok (barkod aramada ve etikette durur).
                k.Add(new() { Anahtar = "barkod", Baslik = Dil.T.Urun.Barkod, SunucuSiralamaAdi = tam ? "barkod" : null,
                              HucreSinif = _ => "metin-soluk metin-kucuk", Deger = u => string.IsNullOrEmpty(u.Barkod) ? "—" : u.Barkod });
                // UX-S31: bu sütun ÜRÜN GRUBU'dur (tip); TOPLU-2: kısa başlık, tam ad title'da.
                k.Add(new() { Anahtar = "grup", Baslik = Toplu2Sozlugu.Al(Dil.Dil).UrunGrubuKisa, BaslikIpucu = Dil.T.Urun.UrunGrubu,
                              SunucuSiralamaAdi = tam ? "grup" : null, HucreSinif = _ => "metin-soluk", Deger = u => Grup.Ad(u.Tip),
                              Hucre = u => @<span id="@($"u-grup-{u.Id}")">@Grup.Ad(u.Tip)</span> });
            }
            k.Add(new() { Anahtar = "ayar", Baslik = Dil.T.Urun.Ayar, SunucuSiralamaAdi = tam ? "ayar" : null,
                          Deger = u => KurKaynakAdi.AyarAdi(u.AyarId),
                          Hucre = u => @<span id="@($"u-ayar-{u.Id}")"><Rozet Renk="amber">@KurKaynakAdi.AyarAdi(u.AyarId)</Rozet></span> });
            k.Add(new() { Anahtar = "gram", Baslik = Dil.T.Urun.Gram, SunucuSiralamaAdi = tam ? "gram" : null, BaslikSinif = "sayi",
                          HucreSinif = _ => "sayi hucre-tek-satir", Deger = u => u.GramAgirlik,
                          Hucre = u => @<text>@Bicim.GramGruplu(u.GramAgirlik)</text> });
            k.Add(new() { Anahtar = "has", Baslik = Dil.T.Urun.HasGram, SunucuSiralamaAdi = tam ? "has" : null, BaslikSinif = "sayi",
                          HucreSinif = _ => "sayi hucre-vurgu metin-amber hucre-tek-satir", Deger = u => u.HasGrami,
                          Hucre = u => @<text>@Bicim.Has(u.HasGrami)</text> });
            // S3-3 — STOK ADEDİ SÜTUNU; UX-S23: sayı bağlantıdır (şube stokları penceresi).
            k.Add(new() { Anahtar = "stok", Baslik = L.StokSutunu, ZorunluGorunur = true, BaslikSinif = "sayi", HucreSinif = _ => "sayi",
                          Hucre = u => @<button @onclick="() => StokAc(u.Id)" type="button" class="dugme dugme-kucuk dugme-ikincil sayi" id="@($"u-stok-adet-{u.Id}")"
                                                aria-label="@string.Format(L.StokAdetIpucu, u.Ad)">@StokAdetMetni(u)</button> });
            if (Modu.ProfesyonelMi)
                k.Add(new() { Anahtar = "durum", Baslik = Dil.T.Urun.Durum, SunucuSiralamaAdi = tam ? "durum" : null,
                              HucreSinif = _ => "hucre-tek-satir", Deger = u => u.Aktif ? Dil.T.Ortak.Aktif : Dil.T.Ortak.Pasif,
                              Hucre = u => @<Rozet Renk="@(u.Aktif ? "yesil" : "gri")">@(u.Aktif ? Dil.T.Ortak.Aktif : Dil.T.Ortak.Pasif)</Rozet> });
            // P-61 — SATIRDA EN ÇOK 3 EYLEM + "⋯" (ortak SatirEylemleri; id'ler UrunEylemleri(u) içinde AYNEN).
            k.Add(new() { Anahtar = "eylem", Baslik = Dil.T.Ortak.Eylemler, BaslikGizli = true, ZorunluGorunur = true, Tasinamaz = true,
                          KartEtiketsiz = true, Tur = IzgaraHucreTuru.Eylem,
                          Hucre = u => @<SatirEylemleri Onek="u" SatirId="@u.Id" SatirAdi="@u.Ad"
                                                        Eylemler="@UrunEylemleri(u)"
                                                        MenuBaslik="@string.Format(L.MenuBaslik, u.Ad)"
                                                        MenuIpucu="@L.MenuIpucu" DigerIslemler="@L.DigerIslemler" /> });
            return k;
        }
    }

    private IReadOnlyList<IzgaraKolonu<StokVeri>> StokKolonlari =>
    [
        // S3-3 / QA tur 8: ham şube kimliği (ULID) ekrana basılmaz — şube ADI.
        new() { Anahtar = "sube", Baslik = Dil.T.Urun.Sube, ZorunluGorunur = true, SunucuSiralamaAdi = "sube",
                HucreSinif = _ => "metin-kucuk", Deger = x => SubeAdi(x.SubeId),
                Hucre = x => @<span id="@($"u-stok-sube-{x.SubeId}")">@SubeAdi(x.SubeId)</span> },
        new() { Anahtar = "adet", Baslik = Dil.T.Ortak.Adet, ZorunluGorunur = true, SunucuSiralamaAdi = "adet", BaslikSinif = "sayi",
                HucreSinif = _ => "hucre-vurgu sayi", Deger = x => x.Adet, Hucre = x => @<text>@Bicim.Miktar(x.Adet, null)</text> },
        new() { Anahtar = "has", Baslik = Dil.T.Urun.ToplamHas, SunucuSiralamaAdi = "has", BaslikSinif = "sayi",
                HucreSinif = _ => "sayi metin-amber", Deger = x => x.ToplamHasGram, Hucre = x => @<text>@Bicim.Has(x.ToplamHasGram)</text> },
        // Fiziksel sayım düzeltmesi — fark deftere SAYIM_DUZELTME hareketi olarak yazılır (TB-18).
        new() { Anahtar = "eylem", Baslik = Dil.T.Ortak.Eylemler, BaslikGizli = true, ZorunluGorunur = true, Tasinamaz = true,
                KartEtiketsiz = true, Tur = IzgaraHucreTuru.Eylem,
                Hucre = x => @<button class="btn btn-ikincil btn-kucuk" @onclick="() => SayimAc(x)"><Ikon Ad="@Ikonlar.Sayim" /> @Dil.T.Urun.SayimDuzelt</button> },
    ];
    private bool yukleniyor = true;
    private string? listeHata;
    // UX-4c madde 13: kategori/reyon/cari (yan kaynak) hataları için ayrı alan.
    private string? yanKaynakHata;

    private string arama = "";
    private string ayarFil = "";
    private string madenFil = "";

    // ═══ PAKET S3-3 — liste + çekmece yüzü ═══════════════════════════════════
    private UrunListeMetinleri L => UrunListeSozlugu.Al(Dil.Dil);

    // ── P-61 — satır eylemleri TEK kaynaktan (SatirEylemleri bileşeni) ──
    private EventCallback Cb(Func<Task> f) => EventCallback.Factory.Create(this, f);
    private EventCallback Cb(Action f) => EventCallback.Factory.Create(this, f);

    private IReadOnlyList<SatirEylemleri.Eylem> UrunEylemleri(UrunVeri u)
    {
        var stok = new SatirEylemleri.Eylem($"u-stok-{u.Id}", Dil.T.Urun.Stok, Cb(() => StokAc(u.Id)));
        var l = new List<SatirEylemleri.Eylem>();
        // QA turu 1+2 YÜKSEK: pasif ürünü aktife alma yolu (UX-S25) — pasif satırda GÖRÜNEN ilk eylem.
        if (u.Aktif)
            l.Add(stok);
        else
            l.Add(new($"u-aktife-al-{u.Id}", Dil.T.Kabuk.AktifeAl, Cb(() => UrunAktifeAl(u)),
                      kilitli: kaydediliyor, kilitNedeni: Dil.T.Kabuk.Kaydediliyor));
        l.Add(new($"u-duzenle-{u.Id}", Dil.T.Ortak.Duzenle, Cb(() => DuzenleAc(u.Id))));
        // Pasif satırda stok yolu KAYBOLMAZ: "⋯" penceresinde.
        if (!u.Aktif) l.Add(stok);
        l.Add(new($"u-etiket-{u.Id}", Dil.T.Urun.Etiket, Cb(() => EtiketAc(u.Id))));
        // Yıkıcı eylem: onay modalı AYNEN; geri dönüş = pasif satırdaki "Aktife al".
        if (u.Aktif)
            l.Add(new($"u-pasife-al-{u.Id}", Dil.T.Urun.PasifeAl, Cb(() => PasifeAlAc(u)), tehlike: true));
        return l;
