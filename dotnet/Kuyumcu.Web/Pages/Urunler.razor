    /// <summary>Okunamazsa alan GİZLİ kalır (varsayılan kapalı) — kayıtlı veri etkilenmez.</summary>
    private async Task KmtsAyariYukle()
    {
        try
        {
            var a = await Api.GetAsync<System.Text.Json.JsonElement>("/kmts/ayar");
            kmtsAcik = a.ValueKind == System.Text.Json.JsonValueKind.Object
                       && a.TryGetProperty("acik", out var v) && v.ValueKind == System.Text.Json.JsonValueKind.True;
        }
        catch (Exception ex) when (ex is ApiHata or System.Text.Json.JsonException) { kmtsAcik = false; }
