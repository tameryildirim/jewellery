    // ── PAKET 20 — maden ↔ ayar ↔ tip bağı (UX-S24) ─────────────────────────
    // Bir alanın değeri diğerini GEÇERSİZ kılabiliyorsa bağı ekran kurar:
    // maden değişince o madenin İLK ayarı seçilir (yoksa ayar boşta kalır ve
    // sunucu 400 döndürürdü), rodyum işareti anlamsızlaşmışsa kaldırılır.

    private static string MadeninIlkAyari(string ayar, string maden)
    {
        var ayarlar = MadenAyarlari(maden);
        if (ayarlar.Count == 0) return ayar;
        foreach (var a in ayarlar) if (a.Id == ayar) return ayar;
        return ayarlar[0].Id;
    }

    private void YeniMadenDegisti()
    {
        yeniAyar = MadeninAyariVarsayilansiz(yeniAyar, yeniMaden);   // P-URUN (K6)
        if (!RodyumKaplanabilir(yeniMaden)) yeniRodyum = false;
    }

    private void YeniTipDegisti()
    {
        if (TipinMadeni(yeniTip) is { } m) { yeniMaden = m; YeniMadenDegisti(); }
    }

    private void DuzenleMadenDegisti()
    {
        dAyar = MadeninIlkAyari(dAyar, dMaden);
        if (!RodyumKaplanabilir(dMaden)) dRodyum = false;
        DuzenleAyarDegisti();
    }

    /// <summary>
    /// PAKET PATCH-4 (UX-S24 — bağımlı alanın bağını ekran kurar): ayar değişince eski
    /// ayarın gerçek milyemi (ör. 22 ayarın 920'si) yeni ayara TAŞINMAZ; kullanıcı elle
    /// değiştirmediyse kutu boşalır ve yeni ayarın standardı kullanılır (ipucu bunu yazar).
    /// Ayar ilk değerine dönerse kayıtlı değer geri gelir.
    /// </summary>
    private void DuzenleAyarDegisti()
    {
        if (dAyar != dAyarIlk && dGercekMilyem == dGercekMilyemIlk) dGercekMilyem = null;
        else if (dAyar == dAyarIlk && dGercekMilyem is null) dGercekMilyem = dGercekMilyemIlk;
    }

    private void DuzenleTipDegisti()
    {
        if (TipinMadeni(dTip) is { } m) { dMaden = m; DuzenleMadenDegisti(); }
    }

    private async Task UrunOlustur()
    {
        modalHata = null;
        // QA turu 2 YÜKSEK: "ad boş / gram -5 ile Kaydet sessizce etkisiz".
        form.Temizle();
        form.Zorunlu("u-ad", yeniAd, Dil);
        form.Zorunlu("u-kod", yeniKod, Dil);
        if (string.IsNullOrEmpty(yeniAyar)) form.Ekle("u-ayar", PU.AyarSecilmedi);   // P-URUN (K6)
        if (yeniBirim != "GRAM") form.Pozitif("u-gram", yeniGram, Dil);
        form.NegatifDegil("u-tas", yeniTas, Dil);
        // K20-5 — kıymetsiz madende (çelik) fiyat has kurundan türetilemez:
        // satış fiyatı boş bırakılırsa sunucu 400 döner. Sessiz etkisizlik
        // yasaktır: alanın ALTINA Türkçe mesaj yazılır (UX-S30).
        if (!MadenKiymetli(yeniAyar) && (yeniSatisFiyati is null or <= 0m))
            form.Ekle("u-satis-fiyati", Dil.T.Urun.HasHesaplanmazIpucu);
        // P-10 (Y-3, UX-S30): geçersiz şema sunucuda 400 olur; kullanıcı alan
        // altında sebebini önce burada görür. Son sözü sunucu söyler.
        if (GorselUrlGecersiz(yeniGorselUrl)) form.Ekle("u-gorsel-url", Dil.T.Urun.GorselUrlGecersiz);
        sayiKapisi.FormaIsle(form, "u-", Dil.T.Form.SayiAnlasilmadi);   // ORTAK-1: "1.500" → POST YOK
        KatliHataVarsaAc(yeni: true);
        if (!form.Gecerli)
        {
            modalHata = Dil.T.Kabuk.FormEksik;
            await OdakIlkHataya();
            return;
        }
        kaydediliyor = true;
        try
        {
            await Api.PostAsync("/urunler", new
            {
                tip = yeniTip,
                kod = yeniKod.Trim(),
                ad = yeniAd.Trim(),
                ayarId = yeniAyar,
                rodyumKaplama = yeniRodyum,
                gramAgirlik = yeniBirim == "GRAM" ? 1m : yeniGram,
                birim = yeniBirim,
                pirlantaKarat = yeniTip == "PIRLANTA" ? yeniKarat : null, pirlantaRenk = Bos(yeniRenk), pirlantaBerraklik = Bos(yeniBerraklik), pirlantaKesim = Bos(yeniKesim), sertifikaKurumu = Bos(yeniSertKurum), sertifikaNo = Bos(yeniSertNo),
                tasAgirlik = yeniTas,
                // Taşsızda TAS_YOK; taşlıda seçim zorunlu (sunucu da doğrular).
                tasKokeni = yeniTas > 0
                    ? (string.IsNullOrEmpty(yeniTasKokeni) ? null : yeniTasKokeni)
                    : "TAS_YOK",
                tasIbaresi = string.IsNullOrEmpty(yeniTasIbaresi) ? null : yeniTasIbaresi,
                iscilikTl = yeniIscilik,
                satisFiyati = yeniSatisFiyati,
                satisMilyemi = MadenAltin(yeniAyar) ? yeniSatisMilyemi : null,   // M1
                fiyatOfsetTl = MadenAltin(yeniAyar) ? yeniFiyatOfset : null,
                alisMilyemi = MadenAltin(yeniAyar) ? yeniAlisMilyemi : null,           // M1b
                kdvMatrahBinde = MadenAltin(yeniAyar) ? yeniKdvMatrahBinde : null,     // M2b
                barkod = string.IsNullOrWhiteSpace(yeniBarkod) ? null : yeniBarkod.Trim(),
                gercekMilyem = yeniGercekMilyem,
                kategoriId = string.IsNullOrEmpty(yeniKategoriId) ? null : yeniKategoriId,
                reyonId = string.IsNullOrEmpty(yeniReyonId) ? null : yeniReyonId,
                konsinye = yeniKonsinye,
                konsinyeCariId = yeniKonsinye ? yeniKonsinyeCariId : null,
                konsinyeBirimBedel = yeniKonsinye ? yeniKonsinyeBedel : null,
                // UX-4d madde 1: sıfır/boşsa gönderilmez — davranış aynen korunur.
                // ═══ PAKET P-10 (Y-3) — sunucunun kabul ettiği alanlar artık GÖNDERİLİYOR ═══
                aciklama = Bos(yeniAciklama),
                pariteKodu = Bos(yeniPariteKodu),
                kmtsKodu = KmtsGorunur ? Bos(yeniKmtsKodu) : null,
                rfid = Bos(yeniRfid),
                gorselUrl = Bos(yeniGorselUrl),
                // ═══ PAKET P-16 (Y-26) ═══
                tedarikciId = Bos(yeniTedarikciId),
                alisMaliyeti = yeniAlisMaliyeti,
                hedefMarj = yeniHedefMarj,
                kdvOrani = yeniKdvOrani,
                seriNo = Bos(yeniSeriNo),
                olcu = Bos(yeniOlcu),
                minStok = yeniMinStok,
                acilisStogu = yeniAcilisStok > 0m ? new { adet = yeniAcilisStok } : null,
            });
            yeniModalAcik = false;
            Basarili(Dil.T.Kabuk.Kaydedildi);
            await Yukle();
        }
        catch (ApiHata ex)
        {
            form.Sunucudan(ex, YeniEsleme);
            KatliHataVarsaAc(yeni: true);
            // URUN-FORM-2: alana bağlı ret alan altında TAM yazılır; bant yalnız kısa genel cümle taşır
            // (aynı cümle iki kez yazılmaz). Alan dışı hata bantta tam kalır (UX-S28).
            modalHata = FormDurumu.BantMesaji(ex, Dil, YeniEsleme) is { } bant
                ? bant
                : Dil.T.Urun.FormAlanHatasiGenel;
            await OdakIlkHataya();
        }
        kaydediliyor = false;
    }

    /// <summary>
    /// Etikette/listede gösterilecek zorunlu taş ibaresi — md.11/(e).
    /// Doğal taş ve taşsız üründe boştur.
    /// </summary>
    /// <summary>
    /// P-10 (Y-3) — sunucudaki <c>GorselKapisi.Dogrula</c> kapısının EKRAN ÖN
    /// GÖSTERİMİ (kopyası değil): kapalı liste http/https. Sessiz etkisizlik
    /// yasaktır; geçersiz adres alan altında Türkçe mesaj üretir.
    /// </summary>
    private static bool GorselUrlGecersiz(string ham)
        => !string.IsNullOrWhiteSpace(ham)
           && (!Uri.TryCreate(ham.Trim(), UriKind.Absolute, out var u)
               || (u.Scheme != "http" && u.Scheme != "https"));

    private static string Ibare(UrunVeri u) => u.TasKokeni switch
    {
        "SENTETIK"            => string.IsNullOrWhiteSpace(u.TasIbaresi) ? "sentetik" : u.TasIbaresi!,
        "LABORATUVAR_URETIMI" => string.IsNullOrWhiteSpace(u.TasIbaresi) ? "laboratuvar üretimi" : u.TasIbaresi!,
        "YAPAY_URETIM"        => string.IsNullOrWhiteSpace(u.TasIbaresi) ? "yapay üretim" : u.TasIbaresi!,
        _ => "",
    };

    private async Task StokAc(string urunId)
    {
        stokHata = null;
        stoklar = [];
        stokUrunId = urunId;
        try
        {
            var yanit = await Api.GetAsync<StokYaniti>($"/urunler/{urunId}/stok");
            stoklar = yanit.SubeStoklar ?? [];
        }
        catch (ApiHata ex) { stokHata = ex.Message; }
        subeHata = null;
        await SubeAdlariniYukle();

        await YerlesimYukle(urunId);
    }

    /// <summary>PAKET 25 — şube × reyon dağılımı ve reyon seçenekleri.</summary>
    private async Task YerlesimYukle(string urunId)
    {
        yerlesimHata = null;
        yerlesimSubeler = [];
        try
        {
            var y = await Api.GetAsync<UrunYerlesimYaniti>($"/urunler/{urunId}/yerlesim");
            yerlesimSubeler = y.Subeler ?? [];
            reyonSecenekleri = await Api.GetAsync<List<ReyonSatiri>>("/reyonlar");
        }
        catch (Exception ex) when (ex is ApiHata or JsonException)
        {
            // UX-S28: hata boş listeye çevrilmez; ayrı bandda görünür.
            // Yerleşim YARDIMCI bilgidir: alınamazsa stok modalı yine açılır.
            yerlesimHata = ex.Message;
        }
    }

    private async Task Yerlestir(UrunYerlesimSubesi sb)
    {
        if (!YerlestirGecerli(sb) || stokUrunId is null) return;
        kaydediliyor = true;
        yerlesimHata = null;
        try
        {
            await Api.PostAsync("/reyonlar/yerlesim", new
            {
                subeId = sb.SubeId,
                urunId = stokUrunId,
                reyonId = YerReyonSecimi(sb.SubeId),
                adet = YerAdetSecimi(sb.SubeId),
            });
            yerAdet[sb.SubeId] = 0m;
            await YerlesimYukle(stokUrunId);
        }
        catch (ApiHata ex) { yerlesimHata = ex.Message; }
        kaydediliyor = false;
    }

    // ── Barkod okutma ────────────────────────────────────────────────────────

    /// <summary>
    /// P-37 — TEK arama yüzeyi: Enter'a basılınca (barkod okutucu Enter basar)
    /// ANA arama kutusundaki değer barkod olarak denenir. Bulunmazsa metin
    /// araması zaten listeyi süzmüş durumdadır; hata bandı ayrıca yazar.
    /// </summary>
    private async Task BarkodBul()
    {
        barkodHata = null;
        var kod = arama.Trim();
        // KESIF-P4 tur 2: barkod boşluk içermez; "burma bilezik" gibi AD araması
        // barkod ucuna gitmez (metin araması listeyi zaten süzdü).
        if (kod.Length == 0 || !BarkodBicimindeMi(kod)) return;
        try
        {
            var urun = await Api.GetAsync<UrunVeri>($"/urunler/barkod/{Uri.EscapeDataString(kod)}");
            arama = "";
            // Bulunan ürün tek başına listelenir; kullanıcı doğrudan kartını açar.
            UrunListesi = [urun];
            await DuzenleAc(urun.Id);
            await StokAdetleriniYukle();
        }
        catch (ApiHata ex) when (ex.StatusCode == 404)
        {
            // KESIF-P4 tur 2: ad aramasında Enter "barkod bulunamadı" bandı basıyordu,
            // oysa metin araması listeyi zaten süzmüştü (3 eşleşme görünürken hata).
            // Bant yalnız hiçbir ürün eşleşmediğinde çıkar.
            barkodHata = UrunListesi.Count == 0 ? Dil.T.Urun.BarkodBulunamadi : null;
        }
        catch (ApiHata ex)
        {
            barkodHata = ex.Message;
        }
    }

    // ── Düzenleme ────────────────────────────────────────────────────────────

    private async Task DuzenleAc(string id)
    {
        duzenleHata = null;
        form.Temizle();
        duzDahaFazla = false;   // S3-3: basit modda çekmece KATLI açılır
        duzenleAcik = true;
        duzenleYukleniyor = true;
        try
        {
            // ⚠ TAM KART. Liste özeti ile kaydedilirse açıklama/kategori/reyon
            // gibi listede olmayan alanlar boş gönderilip SİLİNİRDİ.
            var u = await Api.GetAsync<UrunTamKart>($"/urunler/{id}");
            dId = u.Id;
            dAd = u.Ad;
            dKod = u.Kod;
            dBarkod = u.Barkod ?? "";
            dTip = u.Tip;
            dAyar = u.AyarId;
            dMaden = Kuyumcu.Core.Domain.Ayarlar.MadenBul(u.AyarId) ?? Kuyumcu.Core.Domain.Maden.Altin;
            dRodyum = u.RodyumKaplama;
            dGram = u.GramAgirlik;
            dGramBos = false;
            dTas = u.TasAgirlik;
            dGercekMilyem = u.GercekMilyem;   // PATCH-4: sunucu artık gercekMilyem döndürür (standarttan farklıysa)
            dGercekMilyemIlk = u.GercekMilyem;
            dAyarIlk = u.AyarId;
            dBirim = string.IsNullOrEmpty(u.Birim) ? "ADET" : u.Birim;
            dTasKokeni = u.TasKokeni ?? "";
            dTasIbaresi = u.TasIbaresi ?? "";
            dKategoriId = u.KategoriId ?? "";
            dReyonId = u.ReyonId ?? "";
            dIscilik = u.IscilikTl;
            dSatisFiyati = u.SatisFiyati;
            dSatisMilyemi = u.SatisMilyemi; dFiyatOfset = u.FiyatOfsetTl;   // M1
            dAlisMilyemi = u.AlisMilyemi; dKdvMatrahBinde = u.KdvMatrahBinde;   // M1b · M2b
            dKarat = u.PirlantaKarat;
            dRenk = u.PirlantaRenk ?? "";
            dBerraklik = u.PirlantaBerraklik ?? "";
            dKesim = u.PirlantaKesim ?? "";
            dSertKurum = u.SertifikaKurumu ?? "";
            dSertNo = u.SertifikaNo ?? "";
            dKonsinye = u.Konsinye;
            dKonsinyeCariId = u.KonsinyeCariId ?? "";
            dKonsinyeBedel = u.KonsinyeBirimBedel;
            // P-10 (Y-3): tam kart bunları ZATEN döndürüyordu, istemci okumuyordu.
            dAciklama = u.Aciklama ?? "";
            dPariteKodu = u.PariteKodu ?? "";
            dKmtsKodu = u.KmtsKodu ?? "";
            // ── PAKET P-16 (Y-26) ──
            dTedarikciId = u.TedarikciId ?? "";
            dAlisMaliyeti = u.AlisMaliyeti;
            dHedefMarj = u.HedefMarj;
            dKdvOrani = u.KdvOrani;
            dSeriNo = u.SeriNo ?? "";
            dOlcu = u.Olcu ?? "";
            dMinStok = u.MinStok;
            dRfid = u.Rfid ?? "";
            dGorselUrl = u.GorselUrl ?? "";
            // Konsinye sahibi seçicisi için cari listesi: yeni ürün modalıyla AYNI
            // kaynak (UX-S26 — oluşturma ve düzenleme aynı alan kümesi).
            await FormKaynaklariniYukle();
        }
        catch (ApiHata ex) { duzenleHata = ex.Message; }
        duzenleYukleniyor = false;
    }

    private async Task UrunGuncelle()
    {
        duzenleHata = null;
        form.Temizle();
        form.Zorunlu("d-ad", dAd, Dil);
        form.Zorunlu("d-kod", dKod, Dil);
        if (dBirim != "GRAM") form.Pozitif("d-gram", dGram, Dil);
        form.NegatifDegil("d-tas", dTas, Dil);
        if (dGercekMilyem is < 1m or > 1000m) form.Ekle("d-gercek-milyem", Dil.T.Urun.GercekMilyemIpucu);
        if (!MadenKiymetli(dAyar) && (dSatisFiyati is null or <= 0m))
            form.Ekle("d-satis", Dil.T.Urun.HasHesaplanmazIpucu);
        if (GorselUrlGecersiz(dGorselUrl)) form.Ekle("d-gorsel-url", Dil.T.Urun.GorselUrlGecersiz);
        sayiKapisi.FormaIsle(form, "d-", Dil.T.Form.SayiAnlasilmadi);   // ORTAK-1: "1.500" → PATCH YOK
        KatliHataVarsaAc(yeni: false);
        if (!form.Gecerli)
        {
            duzenleHata = Dil.T.Kabuk.FormEksik;
            await OdakIlkHataya();
            return;
        }
        kaydediliyor = true;
        try
        {
            // ═══ PAKET PATCH-3 — İSTEĞE BAĞLI ALAN SÖZLEŞMESİ (sunucu UrunGuncelleDto) ═══
            //   gövdede YOK → sunucu KORUR · null → SİLER · değer → yazar.
            //   Ekran GÖSTERDİĞİ isteğe bağlı alanı HER ZAMAN gönderir; boşaltılan alan null
            //   gider (eskiden "" giderdi — sunucu bir sürüm boyunca "" ile silmeyi de kabul eder).
            //   ⚠ Eskiden barkod/taş ibaresi/4C/satış fiyatı boşaltılınca null gidiyor ve
            //   sunucu "null = koru" diye SİLMİYORDU (sessiz etkisizlik) — bu sözleşmeyle düzeldi.
            //   Ekranda GÖRÜNMEYEN alan (BASİT'te KMTS) gövdeye HİÇ konmaz → sunucu korur.
            //   Anonim nesne alanı koşullu atlayamaz → sözlük; anahtarlar camelCase yazılır.
            var govde = new Dictionary<string, object?>
            {
                ["tip"] = dTip,
                ["kod"] = dKod.Trim(),
                ["ad"] = dAd.Trim(),
                ["ayarId"] = dAyar,
                ["rodyumKaplama"] = dRodyum,
                // UX-S26 paritesi: birim ekranda GÖRÜNÜR ve gönderilir. Gerçek milyem
                // AŞAĞIDA koşullu eklenir (PATCH-4).
                ["birim"] = dBirim,
                ["gramAgirlik"] = dBirim == "GRAM" ? 1m : dGram,
                ["tasAgirlik"] = dTas,
                ["tasKokeni"] = dTas > 0
                    ? (string.IsNullOrEmpty(dTasKokeni) ? null : dTasKokeni)
                    : "TAS_YOK",
                ["tasIbaresi"] = Bos(dTasIbaresi.Trim()),
                ["kategoriId"] = Bos(dKategoriId),
                ["reyonId"] = Bos(dReyonId),
                ["iscilikTl"] = dIscilik,
                // null = sabit fiyatı SİL (satışta hesaplamaya dön) — boşaltılan alanın anlamı.
                ["satisFiyati"] = dSatisFiyati,
                // M1 — null = temizle (liste kuralına dön). Altın dışı ayarda gönderilmez → sunucu reddetmez.
                ["satisMilyemi"] = MadenAltin(dAyar) ? dSatisMilyemi : null,
                ["fiyatOfsetTl"] = MadenAltin(dAyar) ? dFiyatOfset : null,
                ["alisMilyemi"] = MadenAltin(dAyar) ? dAlisMilyemi : null,
                ["kdvMatrahBinde"] = MadenAltin(dAyar) ? dKdvMatrahBinde : null,
                ["barkod"] = Bos(dBarkod.Trim()),
                // PIRLANTA dışı tipte 4C null gider = SİLİNİR (4C yalnız PIRLANTA tipinde
                // girilir — PirlantaKapisi; tip değişince eski 4C kalıp kapıya takılmaz).
                ["pirlantaKarat"] = dTip == "PIRLANTA" ? dKarat : null,
                ["pirlantaRenk"] = dTip == "PIRLANTA" ? Bos(dRenk) : null,
                ["pirlantaBerraklik"] = dTip == "PIRLANTA" ? Bos(dBerraklik) : null,
                ["pirlantaKesim"] = dTip == "PIRLANTA" ? Bos(dKesim) : null,
                ["sertifikaKurumu"] = dTip == "PIRLANTA" ? Bos(dSertKurum) : null,
                ["sertifikaNo"] = dTip == "PIRLANTA" ? Bos(dSertNo.Trim()) : null,
                // Konsinye üçlüsü HER ZAMAN gönderilir: ekran alanı gösterdiği için
                // kullanıcının kararını taşımak zorundadır (sunucu bool? okur).
                ["konsinye"] = dKonsinye,
                ["konsinyeCariId"] = dKonsinye ? Bos(dKonsinyeCariId) : null,
                // ═══ PAKET P-10 (Y-3) ═══ ekranın gösterdiği alanlar HER ZAMAN gider;
                // boş = null = SİL (PATCH-3 sözleşmesi).
                ["aciklama"] = Bos(dAciklama.Trim()),
                ["pariteKodu"] = Bos(dPariteKodu.Trim()),
                ["rfid"] = Bos(dRfid.Trim()),
                ["gorselUrl"] = Bos(dGorselUrl.Trim()),
                // ═══ PAKET P-16 (Y-26) ═══ üç durumlu PATCH: boş = null = SİL.
                ["tedarikciId"] = Bos(dTedarikciId.Trim()),
                ["alisMaliyeti"] = dAlisMaliyeti,
                ["hedefMarj"] = dHedefMarj,
                ["kdvOrani"] = dKdvOrani,
                ["seriNo"] = Bos(dSeriNo.Trim()),
                ["olcu"] = Bos(dOlcu.Trim()),
                ["minStok"] = dMinStok,
                ["konsinyeBirimBedel"] = dKonsinye ? dKonsinyeBedel : null,
            };
            // ═══ PAKET PATCH-4 (VERİ KRİTİK) ═══ gerçek milyem YALNIZ değiştiyse gider:
            //   değer → yaz · boşaltıldı (null) → ayarın standardına dön · aynı → anahtar YOK, sunucu korur.
            //   ESKİ: her kayıtta null gidiyordu (çekmece kayıtlı değeri hiç okumuyordu) ve
            //   barkodu düzeltilen 920 milyemli ürün sessizce 916'ya dönüyordu.
            if (dGercekMilyem != dGercekMilyemIlk) govde["gercekMilyem"] = dGercekMilyem;
            // Y4-C: KMTS alanı görünmüyorsa (BASİT) anahtar HİÇ konmaz → sunucu KORUR.
            if (KmtsGorunur) govde["kmtsKodu"] = Bos(dKmtsKodu.Trim());
            await Api.PatchAsync($"/urunler/{dId}", govde);
            duzenleAcik = false;
            Basarili(Dil.T.Kabuk.Kaydedildi);
            await Yukle();
        }
        catch (ApiHata ex)
        {
            form.Sunucudan(ex, DuzEsleme);
            KatliHataVarsaAc(yeni: false);
            duzenleHata = FormDurumu.SunucuMesaji(ex, Dil);
            await OdakIlkHataya();
        }
        kaydediliyor = false;
    }

    /// <summary>
    /// QA turu 1+2 YÜKSEK: "pasife alınan ürünü aktife alma yolu yok".
    /// ⚠ Yalnız `aktif` gönderilir — PATCH sözleşmesi "gövdede yoksa koru".
    /// </summary>
    private async Task UrunAktifeAl(UrunVeri u)
    {
        listeHata = null;
        kaydediliyor = true;
        try
        {
            await Api.PatchAsync<object>($"/urunler/{u.Id}", new { aktif = true });
            Basarili(Dil.T.Kabuk.AktifeAlindi);
            await Yukle();
        }
        catch (ApiHata ex) { listeHata = FormDurumu.SunucuMesaji(ex, Dil); }
        kaydediliyor = false;
    }

    // ── Etiket ───────────────────────────────────────────────────────────────

    private async Task EtiketAc(string id)
    {
        etiket = null;
        try { etiket = await Api.GetAsync<EtiketVeri>($"/urunler/{id}/etiket"); }
        catch (ApiHata ex) { listeHata = ex.Message; }
    }

    // ── Sayım düzeltme ───────────────────────────────────────────────────────

    private void SayimAc(StokVeri s)
    {
        sayimHata = null;
        sayimSube = s.SubeId;
        sayimKayitli = s.Adet;
        sayimAdet = s.Adet;
    }

    private async Task SayimKaydet()
    {
        sayimHata = null;
        if (sayiKapisi.Sebep(Dil.Dil, "s-") is { } sk) { sayimHata = sk; return; }   // ORTAK-1: POST YOK
        kaydediliyor = true;
        try
        {
            await Api.PatchAsync($"/urunler/{stokUrunId}/stok/{sayimSube}", new { adet = sayimAdet });
            sayimSube = null;
            if (stokUrunId is not null) await StokAc(stokUrunId);
        }
        catch (ApiHata ex) { sayimHata = ex.Message; }
        kaydediliyor = false;
    }

    // ── Pasife alma ──────────────────────────────────────────────────────────

    private void PasifeAlAc(UrunVeri u)
    {
        pasifHata = null;
        pasifUrun = u;
    }

    private async Task PasifeAlOnayla()
    {
        pasifHata = null;
        kaydediliyor = true;
        try
        {
            await Api.DeleteAsync<object>($"/urunler/{pasifUrun!.Id}");
            pasifUrun = null;
            Basarili(Dil.T.Urun.PasifeAlOnay);
            await Yukle();
        }
        catch (ApiHata ex) { pasifHata = ex.Message; }
        kaydediliyor = false;
    }


    private void Yenile() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Dil.Degisti -= Yenile;
        Modu.Degisti -= Yenile;
    }
}
