    /// <summary>Süzgeç adres çubuğundan mı geldi? (rozet + temizleme yolu)</summary>
    private bool suzgecBaglantidan;

    /// <summary>
    /// Sorgu dizesindeki süzgeçleri KUTULARA yazar. Tanınmayan seçenek
    /// (listede olmayan ayar/maden) UYGULANMAZ ve rozet de çıkmaz —
    /// kullanıcı süzgecin geçmediğini görür (Anayasa md.1).
    /// </summary>
    private void SorgudanSuzgecOku()
    {
        var suzgecler = DerinBaglanti.Suzgecler(Nav.Uri);
        if (suzgecler.Count == 0) return;

        if (suzgecler.TryGetValue("q", out var q))
        {
            arama = q;
            suzgecBaglantidan = true;
        }
        if (suzgecler.TryGetValue("ayarId", out var ayar) && Ayarlar.Contains(ayar))
        {
            ayarFil = ayar;
            suzgecBaglantidan = true;
        }
        if (suzgecler.TryGetValue("maden", out var maden) && Madenler.Contains(maden))
        {
            madenFil = maden;
            suzgecBaglantidan = true;
        }
        // kategoriId / reyonId seçenekleri YanKaynaklariYukle'den sonra bilinir;
        // doğrulanamayan bir kimlik uygulanmaz ama sunucu süzgeci yine geçerlidir.
        if (suzgecler.TryGetValue("kategoriId", out var kategori))
        {
            kategoriFil = kategori;
            suzgecBaglantidan = true;
        }
        if (suzgecler.TryGetValue("reyonId", out var reyon))
        {
            reyonFil = reyon;
            suzgecBaglantidan = true;
        }
    }

