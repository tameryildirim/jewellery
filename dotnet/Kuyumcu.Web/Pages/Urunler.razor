    /// <summary>
    /// Kategori ağacı, reyonlar ve cari listesi. Bunlar olmadan ürün ağaca
    /// bağlanamaz; hata olursa ekranın geri kalanı çalışmaya devam eder.
    /// </summary>
    private async Task YanKaynaklariYukle()
    {
        // UX-4c madde 13 / UX-S28: yan kaynak hatası SESSİZCE yutulmaz; ekranın
        // geri kalanı çalışmaya devam eder ama kullanıcı "kategori listesi boş"
        // ile "kategori ucu cevap vermedi" durumlarını ayırt edebilir.
        yanKaynakHata = null;
        try { kategoriAgaci = await Api.GetAsync<List<KategoriDugum>>("/urun-kategorileri"); }
        catch (Exception ex) when (ex is ApiHata or JsonException) { kategoriAgaci = []; yanKaynakHata = ex.Message; }
        try { reyonlar = await Api.GetAsync<List<ReyonVeri>>("/reyonlar"); }
        catch (Exception ex) when (ex is ApiHata or JsonException) { reyonlar = []; yanKaynakHata ??= ex.Message; }
        // PAKET ISTEK-1: cari listesi ve parite kodları YALNIZ ürün formunda
        // (yeni/düzenle) kullanılır; liste ekranı her açılışta bunları çekmez,
        // form ilk açıldığında FormKaynaklariniYukle bir kez çeker.
    }

    private bool formKaynaklariYuklendi;

    /// <summary>
    /// PAKET ISTEK-1 — ürün formunun seçenek kaynakları (cari · parite) form İLK
    /// açıldığında bir kez yüklenir (UX-S26: iki form aynı diziden beslenir).
    /// Hata SESSİZ kalmaz (UX-S28): yan kaynak bandına yazılır.
    /// </summary>
    private async Task FormKaynaklariniYukle()
    {
        if (formKaynaklariYuklendi) return;
        formKaynaklariYuklendi = true;
        if (cariler.Count == 0) await CarileriYukle();
        // P-10 (Y-3, UX-S31): parite kodu listesi TEK KAYNAKTAN. İsteğe bağlıdır;
        // hata ekranı çökertmez ama SESSİZ de kalmaz (UX-S28).
        try { pariteSecenekleri = (await Api.GetAsync<Kuyumcu.Contracts.Sayfalar.Kur.PariteYaniti>("/kur/pariteler")).Pariteler ?? []; }
        catch (Exception ex) when (ex is ApiHata or JsonException) { pariteSecenekleri = []; yanKaynakHata ??= ex.Message; formKaynaklariYuklendi = false; }
    }

    private async Task CarileriYukle()
    {
        try { cariler = await Api.GetAsync<List<CariOzet>>("/cari?aktif=true&limit=200"); }
        catch (Exception ex) when (ex is ApiHata or JsonException) { cariler = []; yanKaynakHata ??= ex.Message; }
    }

    private async Task Yukle()
    {
        yukleniyor = true;
        listeHata = null;
        try
        {
            var sorgu = new List<string>();
            if (!string.IsNullOrWhiteSpace(arama)) sorgu.Add($"q={Uri.EscapeDataString(arama.Trim())}");
            if (!string.IsNullOrEmpty(ayarFil)) sorgu.Add($"ayarId={Uri.EscapeDataString(ayarFil)}");
            if (!string.IsNullOrEmpty(madenFil)) sorgu.Add($"maden={Uri.EscapeDataString(madenFil)}");
            if (!string.IsNullOrEmpty(kategoriFil)) sorgu.Add($"kategoriId={Uri.EscapeDataString(kategoriFil)}");
            if (!string.IsNullOrEmpty(reyonFil)) sorgu.Add($"reyonId={Uri.EscapeDataString(reyonFil)}");
            // S3-3: durum süzgeci ve AÇIK liste sınırı (UX-S29).
            if (durumFil is "true" or "false") sorgu.Add($"aktif={durumFil}");
            sorgu.Add($"limit={ListeSiniri}");
            var yol = $"/urunler?{string.Join("&", sorgu)}";
            UrunListesi = await Api.GetAsync<List<UrunVeri>>(yol);
        }
        // PAKET ISTEK-1 (UX-S28): hata listeyi BOŞALTMAZ — son başarılı liste ve
        // stok adetleri ekranda kalır, üstte hata bandı söyler.
        catch (ApiHata ex) { listeHata = ex.Message; }
        yukleniyor = false;
        if (listeHata is null) await StokAdetleriniYukle();
    }

